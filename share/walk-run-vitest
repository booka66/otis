#!/bin/sh
# walk-run-vitest <spec...>: git-trace's runner for a repo tested by Vitest
# from its top, when git config otis.walkRunner names none. In a pnpm
# workspace a slot's packages link to each other, and a package's tests
# import the others' builds, so the slot gets its own install (again when the
# lockfile changes) in place of the checkout's node_modules, and turbo builds
# what the specs' packages depend on (its cache is shared between worktrees,
# so that is cheap). Then the specs through Vitest, the tracer preloaded, as
# walk-run-jest does.
# OTIS_TEST_NAME: that one test alone (the tracer names it describe > test,
# -t matches the names joined by spaces).
nice=; [ -n "$OTIS_WALK_AHEAD" ] && nice="nice -n 15"
lock=$(shasum pnpm-lock.yaml 2>/dev/null | cut -d' ' -f1)
if [ -n "$lock" ] && [ "$(cat node_modules/.otis-lock 2>/dev/null)" != "$lock" ]; then
  echo "otis: installing the slot's packages"
  [ -L node_modules ] && rm node_modules
  $nice pnpm install --offline --frozen-lockfile >&2 || $nice pnpm install --frozen-lockfile >&2 || exit 2
  echo "$lock" > node_modules/.otis-lock
fi
if [ -f turbo.json ]; then
  filters=$(for spec in "$@"; do
    d=$(dirname "$spec")
    while [ "$d" != . ] && [ ! -f "$d/package.json" ]; do d=$(dirname "$d"); done
    [ "$d" != . ] && printf -- "--filter=%s^... " "$(jq -r .name "$d/package.json")"
  done | tr ' ' '\n' | sort -u | tr '\n' ' ')
  if [ -n "$filters" ]; then
    echo "otis: building what the specs import"
    $nice node_modules/.bin/turbo run build $filters --output-logs=errors-only >&2 || exit 2
  fi
fi
NODE_OPTIONS="${NODE_OPTIONS:+$NODE_OPTIONS }--require $OTIS_TRACE_REQUIRE" exec $nice node_modules/.bin/vitest run --pool=forks \
  ${OTIS_TEST_NAME:+-t "$(printf '%s' "$OTIS_TEST_NAME" | sed 's/[][\\.^$*+?(){}|/]/\\&/g; s/ > / /g')"} "$@"
