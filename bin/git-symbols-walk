#!/bin/sh
# git-symbols-walk <rev> <table>          the cache file once walked; else "running", having started
#                                         the walk in the background unless it already runs; nothing
#                                         when it is off or no agent is here
# git-symbols-walk --file <rev> <table>   the cache file for this change, if it has been walked
# git-symbols-walk --state <rev> <table>  running, done, failed or none
# git-symbols-walk --prompt <rev> <table> the prompt, for the eye and the tests
# git-symbols-walk --check <rev> <table>  a walk on stdin, back with what can be known of it
#                                         without a model (check, below)
# git-symbols-walk --types <rev> <table>  the declared type of each value, from tsgo (types, below)
# git-symbols-walk --run <rev> <table>    the call itself
# git-symbols-walk --note <row id>         y on a walk's row: the step, or the walk, as a note for Claude
# git-symbols-walk --step <1|-1|0>        > and <: the next step, or the one before; 0, the one it
#                                         is on; fzf actions
# git-symbols-walk --rows <rev>           the list while walking, once it has landed: each walk's
#                                         steps as a call tree; nothing, and exit 1, before
# git-symbols-walk --show <rev> [row id]  the preview while walking: the step (the row's, else the
#                                         one it is on), then its code
#
# The symbol view says what changed; this shows what it does. Opus picks
# two or three concrete inputs, the one the change was written for and then
# ones whose behavior it changes without saying so, and follows each through
# the code in the order it runs, a stop a step: the values that matter there,
# now and before the change, and where control goes next, stepping into
# calls and back out of them as a debugger does. A value Claude traced
# through code it read is plain; one it took on trust (a caller it could not
# read, the database) says so.
#
# A walk is a run, like V's and C's (git-walk: P in gmr and gb), which this
# reports into (OTIS_WALK_DIR) as it goes, and which has a screen of its own
# once it has landed (git-walk --view): --rows is its list, each walk an
# overview and then a row a step, as a call tree, and --show its preview,
# the step pinned over its code. A minute or a few of Opus and a few dollars
# at most, where the gloss is seconds of Haiku. otis.walkModel names the
# model (claude-opus-5-5); off turns it off. Cached by the change's shas, as
# the gloss is.
#
# What it reads: a snapshot of the change's head, the packages it touches and
# the files its callers are in, tests left out, with the base's copy of each
# file it touches under _base/, through Read, Grep and Glob alone. The change's own words are
# in the prompt, so it gets no shell.
share=$(cd "$(dirname "$0")/../share" && pwd)
. "$share/palette.sh"
mode=
case $1 in --file|--state|--prompt|--check|--types|--run|--step|--rows|--show|--note) mode=$1; shift ;; esac
st=$GIT_FZF_STATE
model=$(git config --get otis.walkModel || echo claude-opus-5-5)
# What the walks are written to: a cache from before is walked again the
# next time P asks for it (git-walk), since its shas will never change.
version=6

# The key and the cache root: the picker's (git-symbols --rows leaves both in
# its state), else git-symbols' when it is the caller, else worked out here
# as the gloss works them out.
key= croot=
if [ -n "$st" ]; then read -r key 2>/dev/null < "$st/key"; read -r croot 2>/dev/null < "$st/cache-root"; fi
[ -n "$key" ] || key=$OTIS_SYMBOLS_KEY
[ -n "$croot" ] || croot=${OTIS_CACHE_ROOT:-$(git rev-parse --path-format=absolute --git-common-dir)/git-alias-cache}
dir=$croot/symbols-walk

# --note <row id>: y on a walk's row, the step (walk>k) or the walk (its
# heading), on the clipboard as what Claude needs to go and look: the
# change, the input, the step with its values and where it goes, and where
# the whole walk and the code are.
if [ "$mode" = --note ]; then
  rid=$1 file=$dir/$key.json
  [ -s "$file" ] || { git-fzf-note "no walk here to copy"; exit 0; }
  read -r base head 2>/dev/null < "$st/symbols.tsv.rev"
  top=$(git rev-parse --show-toplevel)
  case $rid in
    walk\>*) k=${rid#walk>} ;;
    gk-walk-[0-9]*) k=-$(( ${rid#gk-walk-} )) ;;
    *) git-fzf-note "nothing to copy on this row"; exit 0 ;;
  esac
  jq -r --argjson k "$k" --arg file "$file" --arg base "$base" --arg head "$head" --arg top "$top" '
    [.walks | to_entries[] | .key as $wi | .value.steps | to_entries[] | {wi: $wi, si: .key, s: .value}] as $all
    | (if $k >= 0 then $all[$k].wi else (-$k - 1) end) as $wi | .walks[$wi] as $w
    | def val: "\(.name) = \(.now)" + (if .was then " (before the change: \(.was))" else "" end) + (if .from then "  [from \(.from)\(if .confidence == "assumed" then ", assumed" else "" end)]" else "" end);
      def step($s; $n): "Step \($n) of \($w.steps | length): \($s.symbol) at \($s.path):\($s.line)\(if $s.side == "old" then " (in the base)" else "" end), depth \($s.depth // 0)",
        (if $s.does then "  does: \($s.does)" else empty end),
        ($s.values[]? | "  " + val),
        (if $s.returns then "  returns: \($s.returns)" else empty end),
        "  next: \($s.next)" + (if $s.was_next then " (before the change: \($s.was_next))" else "" end),
        (if $s.note then "  note: \($s.note)" else empty end),
        (if $s.check then "  otis checked: \($s.check.hop)\(if $s.check.note != "" then ", \($s.check.note)" else "" end); \(if $s.check.change == "line" then "the change made this line" elif $s.check.change == "definition" then "in code the change made" else "code the change did not touch" end)" else empty end);
    "A walk otis made of a code change: an input followed through the code, step by step, before and after the change. Check it against the code; the values are the model'"'"'s, the checks are otis'"'"'s.",
    "",
    "The change: \($base)..\($head) in \($top) (git diff \($base) \($head); read a file at the change with git show \($head):<path>).",
    "Walk \($wi + 1): \($w.title) (\($w.kind))",
    "Point: \($w.point // $w.verdict)",
    "Verdict: \($w.verdict)",
    (if $w.trigger then "What makes it happen\(if $w.reachable == false then " (nothing does, today)" else "" end): \($w.trigger)" else empty end),
    "Input: " + (if ($w.fields // []) | length > 0 then ([$w.fields[] | "\(.name) = \(.value)"] | join("; ")) else $w.input end),
    "",
    (if $k >= 0 then step($all[$k].s; $all[$k].si + 1)
     else ($w.steps | to_entries[] | "\(.key + 1). \(.value.symbol) at \(.value.path):\(.value.line): \(.value.does // .value.next)") end),
    "",
    "The whole walk, every step as JSON: \($file) (.walks[\($wi)])"' "$file" | otis-copy &&
    { git-fzf-note "copied the $( [ "$k" -ge 0 ] && echo step || echo walk ) for Claude: the change, the input, $( [ "$k" -ge 0 ] && echo "the step and where it goes" || echo "every step" ), and where the walk is"; exit 0; }
  git-fzf-note "no clipboard tool (pbcopy, wl-copy, xclip or xsel)"
  exit 0
fi

# What the picker's keys do, before any change is resolved: they come on
# every n, and the state has what they need.
if [ "$mode" = --step ]; then
  d=${1:-1}
  # 0 is P putting the cursor where the walk is; it says nothing of its own.
  [ -e "$st/walk" ] || { [ "$d" = 0 ] || git-fzf-note "no walk here: P in gmr or gb walks a change"; exit 0; }
  file=$dir/$key.json
  [ -s "$file" ] || { [ "$d" = 0 ] || git-fzf-note "Claude is still walking it"; exit 0; }
  read -r k 2>/dev/null < "$st/walk"
  n=$(jq '[.walks[].steps[]] | length' "$file")
  k=$(( ${k:-0} + d ))
  if [ "$k" -ge "$n" ]; then
    k=$((n - 1))
    if [ "$(jq '.pending // 0' "$file")" -gt 0 ]; then git-fzf-note "the next walk is still on its way" >/dev/null
    else git-fzf-note "that was the last step; < goes back" >/dev/null; fi
  elif [ "$k" -lt 0 ]; then k=0; [ "$d" = 0 ] || git-fzf-note "that was the first step" >/dev/null; fi
  echo "$k" > "$st/walk"
  # The step's row, when the list is the walk; else the row the step is in,
  # if one is shown: a symbol's row whose lines on the step's side hold its
  # line, the tightest, else its file's row.
  at=
  [ "$d" = 0 ] && [ "$k" = 0 ] && at=$(awk -F'\t' '$12 == "walk-o>0" { print NR; exit }' "$st/rows.last" 2>/dev/null)
  [ -n "$at" ] || at=$(awk -F'\t' -v id="walk>$k" '$12 == id { print NR; exit }' "$st/rows.last" 2>/dev/null)
  [ -n "$at" ] || at=$(jq -r --argjson k "$k" '[.walks[].steps[]][$k] | [.path, .line, .side] | @tsv' "$file" |
    { IFS='	' read -r p l sd; awk -F'\t' -v p="$p" -v l="$l" -v sd="$sd" '
      $2 != p { next }
      $5 == "" { if (!file) file = NR; next }
      { a = $5; z = $6; if (sd == "old") { if ($4 == "new") { a = $7; z = $8 } } else if ($4 == "old") next }
      a != "" && a <= l && l <= z && (!best || z - a < width) { best = NR; width = z - a }
      END { print best ? best : file }' "$st/rows.last" 2>/dev/null; })
  if [ -n "$at" ]; then echo "pos($at)+refresh-preview"; else echo refresh-preview; fi
  exit 0
fi

rev=$1 table=$2
[ -n "$rev" ] || exit 2
# --show's second is the row, not a table: the picker's table is the one.
[ "$mode" = --show ] && table=
[ -n "$table" ] || table=$st/symbols.tsv
empty() { git hash-object -t tree /dev/null; }
base= head=
[ -n "$st" ] && [ "$rev" != worktree ] && read -r base head 2>/dev/null < "$st/symbols.tsv.rev"
[ -n "$base" ] && [ -n "$head" ] ||
case $rev in
  worktree) base=$(git rev-parse -q --verify HEAD || empty); head= ;;
  *...*)    l=${rev%%...*} r=${rev##*...}
            base=$(git merge-base "${l:-HEAD}" "${r:-HEAD}"); head=$(git rev-parse "${r:-HEAD}") ;;
  *..*)     l=${rev%%..*} r=${rev##*..}; base=$(git rev-parse "${l:-HEAD}"); head=$(git rev-parse "${r:-HEAD}") ;;
  *)        head=$(git rev-parse "$rev"); base=$(git rev-parse -q --verify "$rev^" 2>/dev/null || empty) ;;
esac
if [ -z "$key" ]; then
  case $rev in
    worktree) key=$(cut -f1-13 "$table" | git hash-object --stdin) ;;
    *..*) key=$base-$head ;;
    *) key=$head ;;
  esac
fi
file=$dir/$key.json running=$dir/$key.running err=$dir/$key.err
alive() { [ -s "$running" ] && kill -0 "$(cat "$running")" 2>/dev/null; }
top=$(git rev-parse --show-toplevel)

case $mode in
  --file) [ -s "$file" ] && printf '%s\n' "$file"; exit 0 ;;
  --state)
    if alive; then echo running; elif [ -s "$file" ]; then echo done; elif [ -s "$err" ]; then echo failed; else echo none; fi
    exit 0 ;;
esac

# The diff, the worktree's against HEAD, with every git option a caller's
# config could turn into something else pinned.
gdiff() { git diff --no-color --no-ext-diff --no-renames $base $head "$@"; }

# lines <rev> <path> <first> <last> <label>: those lines of the file at rev
# (the disk's, for the worktree's missing head), numbered as the file is,
# 150 at most.
lines() {
  printf '%s, lines %s-%s:\n' "$5" "$3" "$4"
  { if [ -n "$1" ]; then git show "$1:$2"; else cat "$top/$2"; fi; } 2>/dev/null |
    awk -v s="$3" -v e="$4" 'NR >= s && NR <= e { if (NR == s + 150) { print "  ... (cut at 150 lines; the rest is in the file)"; exit } printf "%5d  %s\n", NR, $0 }'
}
# code: what seam knows of the change, as text: every definition it touches
# (tests, config and generated files aside), whole, as it is at head and as it
# was, numbered as the files are, then the lines around each call to one from
# code the change did not touch. So a walk traces from here rather than
# opening files a turn at a time, which was most of its time.
code() {
  t=$(mktemp)
  awk -F'\t' '$2 != "file" && $4 == ""' "$table" > "$t"
  cut -f1 "$t" | sort -u | git-test-files kinds > "$t.kinds"
  awk -F'\t' 'FILENAME == ARGV[1] { k[$1] = $2; next } k[$1] == "" { print $1 "\t" $3 "\t" $6 "\t" $7 "\t" $8 "\t" $9 "\t" $14 "\t" $15 }' "$t.kinds" "$t" |
    while IFS='	' read -r p name ch side s e os oe; do
      printf '\n### %s#%s (%s)\n' "$p" "$name" "$ch"
      if [ "$side" = old ]; then lines "$base" "$p" "$s" "$e" "before the change, removed by it"
      else
        lines "$head" "$p" "$s" "$e" "at head"
        [ -n "$os" ] && lines "$base" "$p" "$os" "$oe" "before the change"
      fi
    done
  echo
  echo "## Calls to it from code the change did not touch"
  SEAM_KINDS="git-test-files kinds" seam --table "$table" "$rev" --md 2>/dev/null |
    sed -n 's/^  · \(.*\) (\([^ ()]*\):\([0-9]*\)) — .*/\2	\3	\1/p' | head -30 |
    while IFS='	' read -r p l who; do
      case $p in *.spec.*|*.test.*) continue ;; esac
      printf '\n### %s, in %s\n' "$who" "$p"
      lines "$head" "$p" $((l > 12 ? l - 12 : 1)) $((l + 12)) "at head"
    done
  rm -f "$t" "$t.kinds"
}

# budget <lines> <what>: stdin up to so many lines, then a line saying what
# was cut. Every call reads the whole context, so a big change was minutes
# and hundreds of thousands of tokens a call before these.
budget() { awk -v n="$1" -v what="$2" 'NR <= n { print; next } END { if (NR > n) printf "(... %d more lines of %s cut; open the files for them)\n", NR - n, what }'; }

# context: what every call is given. The change's words (the MR's, in a
# review, else its commits'), seam's reading of it by definition, the code
# (above), and the diff less what no one reads: generated files, and any file
# whose diff is past 400 lines, named so the model knows they are there;
# each part to a budget.
context() {
  about=
  if [ -n "$GMR_IID" ]; then
    about=$(glab api "projects/:fullpath/merge_requests/$GMR_IID" 2>/dev/null | jq -r '"# !\(.iid) \(.title)\n\n\(.description // "")"' 2>/dev/null)
  fi
  [ -n "$about" ] || about=$(if [ -n "$head" ]; then git log --no-color --format='# %s%n%n%b' "$base..$head"; else echo "Uncommitted changes, with no words of their own."; fi)
  cat <<EOF
<description>
$about
</description>

<symbols>
$(SEAM_KINDS="git-test-files kinds" seam --table "$table" "$rev" --md 2>/dev/null | budget 700 "the list of definitions")
</symbols>

<code>
$(code 2>/dev/null | budget 1600 "code")
</code>

<diff>
EOF
  gdiff --name-only | git-test-files kinds | while IFS='	' read -r f kind; do
    if [ "$kind" = gen ]; then printf '(%s: generated, left out)\n' "$f"; continue; fi
    d=$(gdiff -U3 -- "$f")
    n=$(printf '%s\n' "$d" | wc -l)
    if [ "$n" -gt 400 ]; then printf '(%s: %s lines of diff, left out)\n' "$f" "$((n))"; else printf '%s\n' "$d"; fi
  done | budget 1600 "diff"
  echo '</diff>'
}

# pick: the first call, which only chooses the inputs, reading nothing.
pick() {
  cat <<'EOF'
You are helping someone review a code change. They want to watch concrete inputs move through the code, before the change and after it, one stop at a time. Your part is to choose the inputs; another pass traces each one. The change is below: its description, every definition it touches before and after, the calls to them from elsewhere, and the diff.

Choose 2 or 3 inputs. An input is concrete: a request, a record, an event, a click, with real-looking field values.
- First, kind "intended": the input the change was written for.
- Then, kind "unmentioned": an input whose behavior differs before and after in a way the description does not say. Look for a branch taken differently; a field now written, or no longer written; a default that moved; a record written before the change, or an old caller, meeting the new code; null, missing or empty values; a key or name whose value changed. If the new behavior looks wrong, that input matters most: put it first among these.
- A gap the author left on purpose (a comment in the code, the description or a commit message says so) is not worth an input.
- Never invent a difference. If the change does nothing else, choose one input, or add one of kind "same": a nearby input that behaves as it did, to show where the change stops.
Check that each input can happen. In "trigger", name what produces it at head: the caller, request or condition, with its file and line (from the code below). If nothing in the code can produce it today (a branch no caller reaches, a type no one builds), set "reachable" to false and say why in "trigger"; choose such an input only when the gap would matter the day something does reach it, and prefer inputs that happen.
The fields of an input must agree with each other and with the code that makes them: a record that went through a path has what that path writes, and nothing it could not have.
Say in "why" what the input should show, in one sentence. Answer from what is below; there are no files to open.

EOF
}

# trace <kind> <title> <input> <why> <trigger> <reachable>: a later call, one
# an input, in parallel.
trace() {
  cat <<EOF
You are helping someone review a code change. They do not want a summary. They want to watch one concrete input move through the code, before the change and after it, one stop at a time, so they can see what the code did and what it does now.

The input (kind "$1"): $2
$3
Why it was chosen: $4
What makes it happen: $5 (reachable: $6)

Follow it through the code in the order it runs. A step is one stop on the path:
- symbol, path and line: where control is. The line is the file's line at head, and side "new"; side "both" for code the change did not touch; side "old" only for code that exists only before the change, with its line in the base copy.
- values: the few variables or fields that matter here, each with its concrete value now, and "was" when it was different before the change. A value is code, what a debugger would print: 'approved', 3, true, null, undefined, ['A', 'B'], { id: 'conv_1', type: 'recover' }. Never words: a field that did not exist is undefined, a value you cannot know is written as the call or field it comes from (getFlag('x')), and anything you want to explain goes in the note. Keep each under 60 characters; show only the fields that matter of an object. Keep before and after in the same step: one step for a place, its values with "was", and was_next where control went before. Never write one step for the old code and another for the new at the same place. Walk the old code in steps of its own only where its path goes somewhere the new one does not, and give those steps side "old" with the base line.
- next: where control goes from here, and was_next when it went elsewhere before.
- A note only when the values cannot speak for themselves, in one sentence.
Steps follow the call stack, the way a debugger steps, and skip no function on the path: a step's caller is the function that literally calls it, so a dispatcher between them (decide() calling decideByConversation) is a step of its own. A closure or callback built in one place and run in another (send: () => reply(...), run later as decision.send()) is stepped into where it is run, and the note says where it was built. When one line makes several calls, as when a call is an argument to another (f(await g(x))), step through them in the order they run: g first, back out with what it returned, then f with it. "next" names the call control goes into and the line it is on ("calls startSend(args) on line 92, whose result goes to runDraftSendsInline"), or says it returns and to where. depth is 0 where the input enters and one more for each call you step into; the step that enters a call has the arguments it was called with as its values. When a function returns, put what it returns in "returns" on its last step, then add a step back in its caller (depth one less), at the line of the call, holding what the call gave back, before stepping into the next call. 3 to 14 steps. Skip plumbing that passes values along unchanged.

Every value must make sense at that point in time. Give each its "from": "input", "step N" (a value an earlier step held), "returned by <function>", "line N" (computed there from values already shown), or where it was read ("database", "config", "environment"). A value must equal what its source held at that moment: an argument is exactly what the caller passed, a returned value is exactly what the callee returned, a field read from a record is what that record was given earlier in this walk. Before you answer, go back over every step and check each value against its source; fix any that do not follow, and do not keep a step you cannot make follow. A value from outside the code (database, config) is "assumed", and its from says which. The verdict is one sentence on what this input shows about the change; a gap the code, the description or a commit message says is deliberate ("ignoring legacy per-trigger overrides") is "deliberate: <where it says so>", not a finding; read them for that before you call anything unmentioned.

A wrong value is worse than none. Trace from the code below: every definition the change touches, before and after, numbered as the files are, and the lines around each call to one from elsewhere. Open a file only for code that is not below: your working directory is the change at head (the packages it touches, tests left out), with the base copy of each changed file under _base/. For each value, confidence "read" when you traced it through code you read, "assumed" when it rests on something you did not read (a database, config, a caller not here).

Check the trigger yourself before you trace: "trigger" names what produces this input at head, with file and line, and "reachable" is false when nothing does today, with why. Correct both if they are wrong; a walk of an input nothing can produce is still worth writing when the gap would matter, but it must say so. The verdict states the point for a reviewer in one plain sentence: what goes wrong or right, for whom.

Write for someone who has not read this code. "point" is the takeaway in at most 12 plain words ("a failed send still marks its links approved"). Each step's "does" says what happens there in at most 15 plain words ("shortens the reply's links, and now also hands back the codes it minted"). A value is what the variable holds, short: an object shows only the fields that matter here.

"fields" is the input as its few fields that matter, each a name and a concrete value, the way a reviewer would set up a test. Use kind "$1" and title "$2" in your answer.

EOF
}
[ "$mode" = --prompt ] && { pick; context; exit 0; }

# snapshot <dir>: the files the walk may read. Each changed file's package
# (the nearest directory up with a package.json, else its own directory, and
# its own directory too when the package is past 3000 files), each file seam
# names a caller in, at head (the worktree: as the disk has them), and under
# _base/ the base's copy of each changed file.
snapshot() {
  s=$1
  at() { if [ -n "$head" ]; then git cat-file -e "$head:$1" 2>/dev/null; else [ -e "$top/$1" ]; fi; }
  size() { if [ -n "$head" ]; then git ls-tree -r --name-only "$head" -- "$1" | wc -l; else git ls-files -- "$1" | wc -l; fi; }
  gdiff --name-only > "$s.changed"
  { while IFS= read -r f; do
      at "$f" || continue
      d=$(dirname "$f")
      while [ "$d" != . ] && ! at "$d/package.json"; do d=$(dirname "$d"); done
      if [ "$d" = . ] || [ "$(size "$d")" -gt 3000 ]; then dirname "$f"; else echo "$d"; fi
    done < "$s.changed"
    SEAM_KINDS="git-test-files kinds" seam --table "$table" "$rev" --md 2>/dev/null |
      sed -n 's/^  · .* (\([^ ()]*\):[0-9]*) — .*/\1/p' | while IFS= read -r f; do at "$f" && echo "$f"; done
  } | sort -u > "$s.paths"
  if [ -n "$head" ]; then
    tr '\n' '\0' < "$s.paths" | xargs -0 git archive --format=tar "$head" -- | tar -x -C "$s"
  else
    (cd "$top" && tr '\n' '\0' < "$s.paths" | xargs -0 git ls-files -co --exclude-standard -z -- | tar -c --null -T - -f -) | tar -x -C "$s"
  fi
  # No tests: a walk follows the code the change runs, and what its tests
  # show is in the diff already. Reading them was most of a walk's time.
  find "$s" -type f \( -name '*.spec.*' -o -name '*.test.*' -o -name '*_test.*' -o -path '*/__tests__/*' \) -delete 2>/dev/null
  while IFS= read -r f; do
    case $f in *.spec.*|*.test.*|*_test.*|*/__tests__/*) continue ;; esac
    git cat-file -e "$base:$f" 2>/dev/null || continue
    mkdir -p "$s/_base/$(dirname "$f")" && git show "$base:$f" > "$s/_base/$f"
  done < "$s.changed"
  rm -f "$s.changed" "$s.paths"
}

# check: a walk on stdin, back with what can be known of it without a model.
# Each step gets .check: its hop from the step before (called at a line of
# the caller, passed along to be called inside another, back into the right
# caller at the call, or none of these), and whether its line is one the
# change made or sits in a definition it changed. The walk gets .entry: the
# callers tsgo found of its first step elsewhere, when git-callers has run.
# The source is read as text: a call is the name followed by (, a caller's
# body is the definition seam says holds its line, or 150 lines either way.
check() {
  c=$(mktemp -d)
  cat > "$c/walk"
  jq -r '.steps | to_entries[] | [.key, (.value.symbol | gsub("[\t\n]"; " ")), .value.path, .value.line, .value.side, (.value.depth // 0)] | @tsv' "$c/walk" > "$c/steps"
  mkdir "$c/h" "$c/b"
  cut -f3 "$c/steps" | sort -u | while IFS= read -r f; do
    e=$(printf '%s' "$f" | tr '/' '%')
    { if [ -n "$head" ]; then git show "$head:$f"; else cat "$top/$f"; fi; } > "$c/h/$e" 2>/dev/null
    git show "$base:$f" > "$c/b/$e" 2>/dev/null
  done
  awk -F'\t' 'BEGIN { OFS = "\t" } $2 != "file" { print $1, $3, $4, $7, $8, $9, $14, $15 }' "$table" > "$c/syms"
  gdiff -U0 2>/dev/null | awk 'BEGIN { OFS = "\t" }
    /^\+\+\+ b\// { p = substr($0, 7); next }
    /^@@/ { split($2, a, ","); o = substr(a[1], 2) + 0; oc = a[2] == "" ? 1 : a[2] + 0; split($3, b, ","); n = substr(b[1], 2) + 0; nc = b[2] == "" ? 1 : b[2] + 0
      for (i = 0; i < oc; i++) print p, "old", o + i; for (i = 0; i < nc; i++) print p, "new", n + i }' > "$c/changed"
  awk -F'\t' -v dir="$c" '
    function enc(p) { gsub("/", "%", p); return p }
    function load(p, sd,   f, ln, n) {
      if ((sd, p) in NL) return
      f = dir "/" (sd == "old" ? "b" : "h") "/" enc(p); n = 0
      while ((getline ln < f) > 0) T[sd, p, ++n] = ln
      close(f); NL[sd, p] = n
    }
    # short: the name a call would use, from what the model called the step.
    function short(x,   a, n) { sub(/ \/ .*/, "", x); sub(/[ (,].*/, "", x); n = split(x, a, "."); x = a[n]; return x ~ /^[A-Za-z_$][A-Za-z0-9_$]*$/ ? x : "" }
    # span: the tightest changed definition holding line l of p on side sd,
    # as "first last", else 150 lines either way.
    function span(p, sd, l,   i, lo, hi, best) {
      best = ""
      for (i = 1; i <= ns; i++) {
        if (SP[i] != p) continue
        if (sd == "old") { if (SS[i] == "old") { lo = SA[i]; hi = SZ[i] } else if (SO[i] != "") { lo = SO[i]; hi = SE[i] } else continue }
        else { if (SS[i] != "new") continue; lo = SA[i]; hi = SZ[i] }
        if (lo <= l && l <= hi && (best == "" || hi - lo < bw)) { best = lo " " hi; bw = hi - lo }
      }
      return best != "" ? best : (l > 150 ? l - 150 : 1) " " (l + 150)
    }
    # find: the line nearest l, within the span, where name is called (call)
    # or only named (bare), else 0.
    function find(p, sd, name, l, how,   r, lo, hi, i, re, d, best, bd) {
      load(p, sd); split(span(p, sd, l), r, " "); lo = r[1]; hi = r[2]; if (hi > NL[sd, p]) hi = NL[sd, p]
      re = how == "call" ? "(^|[^A-Za-z0-9_$])" name "[ \t]*(<[^()]*>)?[ \t]*[(]" : "(^|[^A-Za-z0-9_$])" name "([^A-Za-z0-9_$]|$)"
      best = 0
      for (i = lo; i <= hi; i++) if (T[sd, p, i] ~ re) { d = i - l; if (d < 0) d = -d; if (!best || d < bd) { best = i; bd = d } }
      return best
    }
    # owner: the function around line i of p (on side sd): the nearest
    # declaration above it, a function, an arrow held by a name, or a method.
    function owner(p, sd, i,   x, t, m) {
      for (x = i; x >= 1 && x > i - 300; x--) {
        t = T[sd, p, x]
        if (match(t, /function[ \t*]+[A-Za-z_$][A-Za-z0-9_$]*/)) { m = substr(t, RSTART, RLENGTH); sub(/function[ \t*]+/, "", m); return m }
        if (match(t, /(const|let|var)[ \t]+[A-Za-z_$][A-Za-z0-9_$]*[ \t]*(:[^=]*)?=[ \t]*(async[ \t]*)?(\(|function|[A-Za-z_$][A-Za-z0-9_$]*[ \t]*=>)/)) { m = substr(t, RSTART, RLENGTH); sub(/^(const|let|var)[ \t]+/, "", m); sub(/[^A-Za-z0-9_$].*/, "", m); return m }
        if (match(t, /^[ \t]*(public |private |protected |static |async )*[A-Za-z_$][A-Za-z0-9_$]*[ \t]*(<[^()]*>)?\([^;]*$/) && t !~ /^[ \t]*(if|for|while|switch|catch|return|await|new|else)[ \t(]/ && t ~ /[{][ \t]*$|\)[ \t]*:[^;]*$|,[ \t]*$|\([ \t]*$/) { m = t; sub(/^[ \t]*(public |private |protected |static |async )*/, "", m); sub(/[^A-Za-z0-9_$].*/, "", m); return m }
      }
      return ""
    }
    # through: a hop the walk made through a function it left out.
    function through(k,   f, files, nf, p, i, via, at2) {
      files[1] = pth[k - 1]; files[2] = pth[k]; nf = files[1] == files[2] ? 1 : 2
      for (f = 1; f <= nf && hop == "missing"; f++) {
        p = files[f]; load(p, "new")
        for (i = 1; i <= NL["new", p] && hop == "missing"; i++) {
          if (T["new", p, i] !~ ("(^|[^A-Za-z0-9_$])" me "[ \t]*(<[^()]*>)?[ \t]*[(]")) continue
          via = owner(p, "new", i)
          if (via == "" || via == me || via == prev) continue
          if ((at2 = find(pth[k - 1], sd[k - 1], via, lin[k - 1], "call"))) { hop = "via"; note = "through " via " (line " i "), which " prev " calls on line " at2; callat = at2 }
        }
      }
    }
    # range: where a changed definition by that name sits in p, "first last".
    function range(p, sd, name,   i) { for (i = 1; i <= ns; i++) if (SP[i] == p && SS[i] == sd && (SN[i] == name)) return SA[i] " " SZ[i]; return "" }
    FILENAME == ARGV[1] { ns++; SP[ns] = $1; SN[ns] = $2; SS[ns] = $4; SA[ns] = $5 + 0; SZ[ns] = $6 + 0; SO[ns] = $7; SE[ns] = $8; next }
    FILENAME == ARGV[2] { C[$1, $2, $3 + 0] = 1; next }
    { k = $1; sym[k] = $2; pth[k] = $3; lin[k] = $4 + 0; sd[k] = $5 == "old" ? "old" : "new"; dep[k] = $6 + 0; n = k }
    END {
      for (k = 0; k <= n; k++) {
        hop = "entry"; note = ""; callat = ""
        if (k > 0) {
          me = short(sym[k]); prev = short(sym[k - 1])
          if (dep[k] == dep[k - 1] + 1) {
            if (me == "") { hop = "na" }
            else if ((at = find(pth[k - 1], sd[k - 1], me, lin[k - 1], "call"))) { hop = "call"; note = "called at line " at " of " prev; callat = at }
            else {
              hop = "missing"; note = "no call to " me " in " prev ", directly or through one function (over the network, an event or a callback?)"
              # Through one function the walk left out: a function in either
              # file that calls it, and that prev calls.
              through(k)
              # Passed along: named, not called, by a step on the stack.
              for (j = k - 1; j >= 0 && hop == "missing"; j--) if (dep[j] < dep[k] && short(sym[j]) != me && (at = find(pth[j], sd[j], me, lin[j], "bare"))) { hop = "passed"; note = me " is passed along at line " at " of " short(sym[j]) ", and called inside " prev; if (j == k - 1) callat = at }
              # Built earlier and run here: a closure an earlier step made
              # (send: () => f(...)), run by prev.
              for (j = k - 2; j >= 0 && hop == "missing"; j--) if (short(sym[j]) != me && (at = find(pth[j], sd[j], me, lin[j], "call"))) { hop = "built"; note = "built in " short(sym[j]) " on line " at ", and run here by " prev }
            }
            if (me != "" && (r = range(pth[k], sd[k], me)) != "") { split(r, rr, " "); if (lin[k] < rr[1] || lin[k] > rr[2]) { hop = "line"; note = "line " lin[k] " is not in " me " (lines " rr[1] "-" rr[2] ")" } }
          } else if (dep[k] < dep[k - 1]) {
            # Back out: into the function that made the call at this depth.
            for (j = k - 1; j >= 0 && dep[j] != dep[k]; j--) ;
            for (i = k - 1; i >= 0 && dep[i] != dep[k] + 1; i--) ;
            if (j < 0 || short(sym[j]) != me) { hop = "return"; note = "comes back into " me (j >= 0 ? ", but " short(sym[j]) " made the call" : "") }
            else { hop = "back"; cal = i >= 0 ? short(sym[i]) : ""; note = cal != "" && (at = find(pth[k], sd[k], cal, lin[k], "call")) ? "back at the call to " cal " on line " at : "back in " me }
          } else if (dep[k] == dep[k - 1]) { hop = me == prev ? "same" : "jump"; if (hop == "jump") note = "goes from " prev " to " me " with no call or return between" }
          else { hop = "jump"; note = "goes " (dep[k] - dep[k - 1]) " calls deeper at once" }
        }
        chg = ((pth[k], sd[k], lin[k]) in C) ? "line" : ""
        if (chg == "") { for (i = 1; i <= ns; i++) if (SP[i] == pth[k] && (SS[i] == sd[k] ? SA[i] <= lin[k] && lin[k] <= SZ[i] : sd[k] == "old" && SO[i] != "" && SO[i] <= lin[k] && lin[k] <= SE[i])) { chg = "definition"; break } }
        print k "\t" hop "\t" note "\t" (chg == "" ? "none" : chg) "\t" callat
      }
    }' "$c/syms" "$c/changed" "$c/steps" > "$c/checks"
  # The first step's callers elsewhere, from git-callers' cache: only for a
  # symbol it looked for, an exported one the change touches. For any other
  # (a closure, a method, code the change did not touch) none found says
  # nothing, so nothing is said.
  entry=null
  cf=$croot/callers/$key.tsv
  e=$(head -1 "$c/steps" | cut -f2 | sed 's/ \/ .*//; s/[ (,].*//; s/.*\.//')
  if [ -f "$cf" ] && [ -n "$e" ] && awk -F'\t' -v n="$e" '$2 != "file" && $3 == n && $5 == 1 { f = 1 } END { exit !f }' "$table"; then
    entry=$(awk -F'\t' -v n="$e" '$1 ~ ("#" n "$") { c++; if (!w) w = $2 ":" $3 } END { printf "{\"name\":\"%s\",\"callers\":%d,\"first\":\"%s\"}", n, c, w }' "$cf")
  fi
  jq --rawfile checks "$c/checks" --argjson entry "$entry" '
    ($checks | split("\n") | map(select(. != "") | split("\t") | {k: (.[0] | tonumber), hop: .[1], note: .[2], change: .[3], at: ((.[4] // "") | if . == "" then null else tonumber end)})) as $cs
    | .steps |= [to_entries[] | .key as $i | .value + {check: (first($cs[] | select(.k == $i)) // null)}] | .entry = $entry | .checked = 3' "$c/walk" 2>/dev/null ||
    cat "$c/walk"
  rm -rf "$c"
}

# types: the declared type of each value at its step, from tsgo's hover
# (share/lsp-hover.mjs), into $key.types, a line a value: step:value, the
# type. The files are opened as the change leaves them; what they import is
# read from the checkout. A step on the old side has none. Without tsgo or
# node, or with git config otis.callers off, nothing.
types() {
  command -v tsgo >/dev/null 2>&1 && command -v node >/dev/null 2>&1 || return 0
  [ "$(git config --get otis.callers)" = off ] && return 0
  [ -s "$file" ] || return 0
  c=$(mktemp -d)
  jq -r '[.walks[].steps[]] | to_entries[] | .key as $k | .value as $s | select($s.side != "old")
    | $s.values | to_entries[] | ["\($k):\(.key)", $s.path, $s.line, .value.name] | @tsv' "$file" > "$c/q"
  cut -f2 "$c/q" | sort -u | while IFS= read -r f; do
    e=$(printf '%s' "$f" | tr '/' '%')
    { if [ -n "$head" ]; then git show "$head:$f"; else cat "$top/$f"; fi; } > "$c/$e" 2>/dev/null
  done
  jq -Rn --arg root "$top" --arg c "$c" '[inputs | split("\t")] as $q
    | {root: $root,
       open: ($q | map(.[1]) | unique | map({path: ., from: ($c + "/" + gsub("/"; "%"))})),
       queries: ($q | map({id: .[0], path: .[1], line: (.[2] | tonumber), name: .[3]}))}' "$c/q" |
    node "$share/lsp-hover.mjs" > "$dir/$key.types.new" 2>/dev/null && mv "$dir/$key.types.new" "$dir/$key.types"
  rm -rf "$c" "$dir/$key.types.new"
}

# report <text>: a line in the run's progress, when it is a run (git-walk).
report() { [ -n "$OTIS_WALK_DIR" ] && jq -nc --arg t "$*" '{type: "otis", text: $t, at: (now | floor)}' >> "$OTIS_WALK_DIR/events.jsonl"; return 0; }

# agent <events> <tools> <schema> <prompt file> <name>: one call, from the snapshot, in a
# process group of its own (set -m) so the stop takes claude with it; its
# events as they come, for the preview, into <events>. Its pid in $!.
agent() {
  set -m
  (cd "$snap" && otis-agent-run -p --model "$model" ${effort:+--effort "$effort"} --restricted --tools "$2" --strict-mcp-config --disable-slash-commands \
    --no-session-persistence --permission-prompts none --output-format stream-json --verbose --json-schema "$3" < "$4" 2>>"$err" |
    # In a run, its steps into the progress too, under the call's name.
    if [ -n "$OTIS_WALK_DIR" ]; then tee "$1" | git-claude-view --events "$5" >> "$OTIS_WALK_DIR/events.jsonl"; else cat > "$1"; fi) &
  set +m
}
# landed <events>: the call's answer, if it gave one.
landed() { jq -c 'select(.type == "result") | select(.is_error | not) | .structured_output // empty' "$1" 2>/dev/null | tail -1; }
# merge: the walks that have landed into the cache, in the order they were
# chosen, and how many are still coming; under a lock, since they land
# together.
merge() {
  until mkdir "$dir/$key.merging" 2>/dev/null; do sleep 0.1; done
  n=$(jq '.inputs | length' "$dir/$key.inputs")
  gone=$(ls "$dir/$key".w.*.fail 2>/dev/null | wc -l)
  ls "$dir/$key".w.*.json >/dev/null 2>&1 &&
    jq -s --argjson n "$n" --argjson gone "$gone" --argjson v "$version" '{version: $v, walks: ., pending: ($n - length - $gone)}' $(ls "$dir/$key".w.*.json | sort) > "$file.new" && mv "$file.new" "$file"
  rmdir "$dir/$key.merging"
}

[ "$mode" = --check ] && { check; exit 0; }
[ "$mode" = --types ] && { types; exit 0; }

if [ "$mode" = --run ]; then
  mkdir -p "$dir" || exit 0
  # One run at a time per change. The lock is a directory, made or not in one
  # step; its holder's pid is in it, so a lock a killed run left is taken.
  lock=$dir/$key.lock
  if ! mkdir "$lock" 2>/dev/null; then
    kill -0 "$(cat "$lock/pid" 2>/dev/null)" 2>/dev/null && exit 0
    rm -rf "$lock"; mkdir "$lock" || exit 0
  fi
  echo $$ > "$lock/pid"
  echo $$ > "$running"
  snap=$(mktemp -d) p=$(mktemp)
  trap 'rm -rf "$running" "$lock" "$file.new" "$snap" "$p" "$p".* "$dir/$key.table" "$dir/$key".events.* "$dir/$key.eta" "$dir/$key.inputs" "$dir/$key".w.* "$dir/$key.merging"' EXIT
  rm -f "$dir/$key".w.* "$dir/$key".events.*
  walk='{"type":"object","additionalProperties":false,"required":["kind","title","input","fields","trigger","reachable","steps","verdict","point"],"properties":{
      "kind":{"type":"string","enum":["intended","unmentioned","same"]},
      "title":{"type":"string","description":"the input, in a few words"},
      "input":{"type":"string","description":"the concrete input, with its values"},
      "fields":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["name","value"],"properties":{"name":{"type":"string"},"value":{"type":"string"}}}},
      "trigger":{"type":"string","description":"what produces this input at head, with file and line; or why nothing does"},
      "reachable":{"type":"boolean"},
      "verdict":{"type":"string","description":"one sentence: what this input shows about the change"},
      "point":{"type":"string","description":"the takeaway for a reviewer in at most 12 plain words"},
      "steps":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["symbol","path","line","side","depth","does","values","next"],"properties":{
        "does":{"type":"string","description":"what happens at this step, in at most 15 plain words"},
        "symbol":{"type":"string"},"path":{"type":"string"},"line":{"type":"integer"},
        "depth":{"type":"integer","description":"0 where the input enters, one more for each call stepped into"},
        "returns":{"type":"string","description":"on the step where the function returns: what it returns to its caller"},
        "side":{"type":"string","enum":["new","old","both"]},
        "values":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["name","now","confidence","from"],"properties":{
          "name":{"type":"string"},"now":{"type":"string"},
          "from":{"type":"string","description":"where the value comes from, in at most four words: input, step 2, line 192, returned by f, database, config"},
          "was":{"type":"string","description":"only when it was different before the change"},
          "confidence":{"type":"string","enum":["read","assumed"]}}}},
        "next":{"type":"string"},
        "was_next":{"type":"string","description":"only when control went elsewhere before"},
        "note":{"type":"string"}}}}}}'
  inputs='{"type":"object","additionalProperties":false,"required":["inputs"],"properties":{"inputs":{"type":"array","items":{
    "type":"object","additionalProperties":false,"required":["kind","title","input","why","trigger","reachable"],"properties":{
      "trigger":{"type":"string","description":"what produces this input at head, with file and line; or why nothing does"},
      "reachable":{"type":"boolean"},
      "kind":{"type":"string","enum":["intended","unmentioned","same"]},
      "title":{"type":"string","description":"the input, in a few words"},
      "input":{"type":"string","description":"the concrete input, with its values"},
      "why":{"type":"string","description":"what it should show, in a sentence"}}}}}}'
  # Eight minutes at most for the lot, from the start: a call that has not
  # answered by then is not going to, and the preview would say it is
  # walking for good.
  : > "$dir/$key.groups"
  (sleep 480; for g in $(cat "$dir/$key.groups" 2>/dev/null); do kill -- "-$g" 2>/dev/null; done
    echo "no answer in eight minutes, so it was stopped" >> "$err") &
  wpid=$!
  report "gathering the change: its words, what seam knows of it, the code and the diff"
  context > "$p.ctx"
  # The bar's guess, for the first walk to land: a minute and a half.
  echo 90 > "$dir/$key.eta"
  # Choosing reads nothing, so it goes while the snapshot is made.
  { pick; cat "$p.ctx"; } > "$p.pick"
  # Choosing is a judgment over what it is given, not a trace: low effort,
  # or it spent minutes thinking on it.
  effort=low
  report "choosing the inputs"
  agent "$dir/$key.events.0" "" "$inputs" "$p.pick" choosing
  effort=
  ppid_=$!
  snapshot "$snap"
  echo "$ppid_" >> "$dir/$key.groups"
  wait "$ppid_"
  landed "$dir/$key.events.0" > "$dir/$key.inputs"
  if ! jq -e '.inputs | length > 0' "$dir/$key.inputs" >/dev/null 2>&1; then
    { jq -r 'select(.type == "result") | .result // empty' "$dir/$key.events.0" 2>/dev/null; echo "no inputs came back"; } >> "$err"
    { kill "$wpid"; wait "$wpid"; } 2>/dev/null; rm -f "$dir/$key.groups"; exit 0
  fi
  # Then a call an input, all at once, each merged into the cache as it lands.
  n=$(jq '.inputs | length' "$dir/$key.inputs")
  report "$(jq -r '"walking \(.inputs | length) inputs: " + ([.inputs | to_entries[] | "\(.key + 1). \(.value.title)\(if .value.reachable == false then " (latent)" else "" end)"] | join("  "))' "$dir/$key.inputs")"
  i=0 tp=
  while [ "$i" -lt "$n" ]; do
    jq -r --argjson i "$i" '.inputs[$i] | .kind, .title, (.input | gsub("\n"; " ")), (.why | gsub("\n"; " ")), (.trigger | gsub("\n"; " ")), .reachable' "$dir/$key.inputs" |
      { IFS= read -r k; IFS= read -r ti; IFS= read -r in; IFS= read -r why; IFS= read -r tr; IFS= read -r re; trace "$k" "$ti" "$in" "$why" "$tr" "$re"; } > "$p.$i"
    cat "$p.ctx" >> "$p.$i"
    ( agent "$dir/$key.events.$((i + 1))" "Read,Grep,Glob" "$walk" "$p.$i" "walk $((i + 1))"
      echo "$!" >> "$dir/$key.groups"
      wait "$!"
      w=$(landed "$dir/$key.events.$((i + 1))")
      if printf '%s' "$w" | jq -e '.steps | length > 0' >/dev/null 2>&1; then printf '%s\n' "$w" | check > "$dir/$key.w.$i.json"
        report "walk $((i + 1)) landed: $(jq -r '(.point // .title) + " (\(.steps | length) steps)"' "$dir/$key.w.$i.json")"
      else { jq -r 'select(.type == "result") | .result // empty' "$dir/$key.events.$((i + 1))" 2>/dev/null; echo "walk $((i + 1)) did not come back"; } >> "$err"; : > "$dir/$key.w.$i.fail"; report "walk $((i + 1)) did not come back"; fi
      merge ) &
    tp="$tp $!"
    i=$((i + 1))
  done
  wait $tp
  { kill "$wpid"; wait "$wpid"; } 2>/dev/null
  rm -f "$dir/$key.groups" "$dir/$key.types"
  [ -s "$file" ] && rm -f "$err"
  # The walks are up; their types come after, and draw in when they land.
  types
  exit 0
fi

# start: the walk asked for, once: not when off, not without an agent.
start() {
  [ "$model" != off ] && otis-agent-run --ready >/dev/null 2>&1 || return 1
  mkdir -p "$dir" || return 1
  rm -f "$err"
  # The picker's table is rebuilt under it; the run reads its own copy.
  cp "$table" "$dir/$key.table"
  # The shas, not the names: a range ending in HEAD is the checkout's HEAD by
  # the time the run reads it, which need not be the change's.
  case $rev in worktree) r=worktree ;; *..*) r=$base..$head ;; *) r=$head ;; esac
  otis-detach git-symbols-walk --run "$r" "$dir/$key.table" </dev/null >/dev/null 2>>"$err" &
  echo $! > "$running"
}

# recheck: a walk checked before the checks it has now (check, .checked)
# checked again, which is a second, not a walk.
recheck() {
  [ -s "$file" ] && ! alive && jq -e '[.walks[].checked] | any(. != 3)' "$file" >/dev/null 2>&1 || return 0
  n=$(jq '.walks | length' "$file") i=0
  cp "$file" "$file.old"
  while [ "$i" -lt "$n" ]; do jq ".walks[$i]" "$file.old" | check > "$file.w$i"; i=$((i + 1)); done
  jq -s --slurpfile old "$file.old" '$old[0] + {walks: .}' "$file".w* > "$file.new" && mv "$file.new" "$file"
  rm -f "$file.old" "$file".w*
}

if [ "$mode" = --rows ]; then
  [ -s "$file" ] || exit 1
  recheck
  # Each walk under a heading, then a row a step, a level in for each call
  # it is in and ↩ where it comes back out of one; the fields are the
  # picker's (path, line, side, start, end, kind, id), the id walk>k for
  # the k-th step of them all.
  jq -r '
    def t: tostring | gsub("[\t\n]"; " ");
    (.walks | to_entries) as $ws
    | [$ws[] | .key as $wi | .value.steps | to_entries[] | {wi: $wi, si: .key, s: .value}] as $all
    | ($all | to_entries[] | .key as $k | .value as $x
        | (if $x.si == 0 then (["H", ($x.wi + 1), ($ws[$x.wi].value.title | t)] | @tsv), (["O", $x.wi, (($ws[$x.wi].value.point // $ws[$x.wi].value.verdict) | t)] | @tsv) else empty end),
          (["S", $k, ($x.si + 1), ($x.s.depth // 0),
            (if $x.si > 0 and (($x.s.depth // 0) < ($all[$k - 1].s.depth // 0)) then 1 else 0 end),
            ($x.s.symbol | t), $x.s.path, $x.s.line, (if $x.s.side == "old" then "old" else "new" end),
            ($x.s.check.hop // ""), ($x.s.check.change // "")] | @tsv)),
      (if (.pending // 0) > 0 then ["M", .pending] | @tsv else empty end)' "$file" |
    awk -F'\t' "$(cat "$share/rowfmt.awk")"'
      function base(p,   n, a) { n = split(p, a, "/"); return a[n] }
      $1 == "H" { print "walk " $2 " \302\267 " $3 "\t\t\t\t\t\t\t\t\t\t\tgk-walk-" $2 }
      # Its overview, a row of its own: what it shows, in a line.
      $1 == "O" { print GK_FAINT "\342\227\207 " GK_R GK_TEXT $3 GK_R "\t\t\t\t\t\t\t\t\t\twalk\twalk-o>" $2 }
      $1 == "S" {
        # A step the source does not bear out is marked, and the number of one
        # on a line or in a definition the change made is lit.
        print gk_rep("  ", $4) ($5 ? GK_ATTENTION "\342\206\251 " GK_R : "") ($10 ~ /^(missing|return|jump|line)$/ ? GK_ATTENTION "\342\232\240 " GK_R : "") \
          ($11 == "line" || $11 == "definition" ? GK_ATTENTION : GK_CONTEXT) $3 " " GK_R GK_TEXT $6 GK_R "  " GK_FAINT base($7) ":" $8 GK_R \
          "\t" $7 "\t" $8 "\t" $9 "\t" $8 "\t" $8 "\t\t\t\t\twalk\twalk>" $2
      }
      $1 == "M" { print $2 " more on the way \302\267 they join the list as they land\t\t\t\t\t\t\t\t\t\t\tgk-walk-more" }
    '
  exit 0
fi

if [ "$mode" = --show ]; then
  w=${FZF_PREVIEW_COLUMNS:-100}
  if [ ! -s "$file" ]; then
    if alive; then
      # The picker draws this again each second while it is here (otis-symbols).
      [ -n "$st" ] && : > "$st/walk.pending"
      since=$(( $(date +%s) - $(stat -f %m "$running" 2>/dev/null || stat -c %Y "$running" 2>/dev/null || date +%s) ))
      eta=$(cat "$dir/$key.eta" 2>/dev/null)
      printf "${GK_ATTENTION}%s is walking inputs through this change${GK_R}\n\n" "$(otis-agent-run --name)"
      # A bar against the time it should take, from the size of the diff: a
      # guess, said as one, and past it the bar holds full and says so.
      awk -v t="$since" -v eta="${eta:-0}" -v w="$w" "$(cat "$share/rowfmt.awk")"'
        function mmss(x) { return int(x / 60) "m " sprintf("%02d", x % 60) "s" }
        BEGIN {
          if (eta <= 0) { print GK_CONTEXT mmss(t) " · reading the change" GK_R; exit }
          bw = w - 30; if (bw > 50) bw = 50; if (bw < 10) bw = 10
          f = int(bw * t / eta); if (f > bw) f = bw
          print GK_ATTENTION gk_rep("\342\226\210", f) GK_FAINT gk_rep("\342\226\221", bw - f) GK_R "  " GK_TEXT mmss(t) GK_R GK_CONTEXT \
            (t <= eta ? " of about " mmss(eta) : " · longer than most; big changes take up to five minutes") GK_R
        }' 2>/dev/null
      # What it is doing: the files it has read, and the last thing it did.
      [ -s "$dir/$key.events" ] && jq -r 'select(.type == "assistant") | .message.content[]? | select(.type == "tool_use")
          | [.name, (.input.file_path // .input.pattern // .input.path // "" | tostring | sub("^.*/tmp\\.[^/]*/"; ""))] | @tsv' "$dir/$key.events" 2>/dev/null |
        awk -F'\t' "$(cat "$share/rowfmt.awk")"'
          $1 == "Read" { if (!($2 in seen)) { seen[$2] = 1; nr++ } }
          { n++; last = ($1 == "Read" ? "reading " : $1 == "Grep" ? "searching for " : "looking for ") $2 }
          END { if (n) print GK_CONTEXT nr " file" (nr == 1 ? "" : "s") " read, " n " look" (n == 1 ? "" : "s") " in all \302\267 " GK_R GK_TEXT last GK_R }'
      echo
      printf "${GK_CONTEXT}%s${GK_R}\n" "It picks the input the change was written for and ones whose behavior it changes without saying so, and follows each through the code."
    else
      rm -f "$st/walk.pending"
      printf "${GK_BAD}%s${GK_R}\n\n" "The walk did not come back."
      [ -s "$err" ] && printf "${GK_CONTEXT}%s${GK_R}\n\n" "$(tail -3 "$err")"
      printf "${GK_CONTEXT}%s${GK_R}\n" "R walks it again."
    fi
    exit 0
  fi
  rm -f "$st/walk.pending"
  # The cursor's step, when it is on one of the walk's rows; else the one
  # the walk is on (> and <, or a list not reloaded yet).
  rid=$2 ov=
  case $rid in
    walk\>*) k=${rid#walk>}; echo "$k" > "$st/walk" ;;
    walk-o\>*) ov=${rid#walk-o>}; k=0 ;;
    *) read -r k 2>/dev/null < "$st/walk" ;;
  esac
  [ "${k:--1}" -ge 0 ] || k=0
  # Drawn to a file, so it can say where the step's line is (below).
  exec 3>&1 > "$st/show.$$"
  if [ -n "$ov" ]; then
    # A walk's overview, its first row: the input, what it shows, what makes
    # it happen, and its steps as a story, each in a line.
    jq -r --argjson wi "$ov" '
      def t: tostring | gsub("[\t\n]"; " ");
      .walks[$wi] as $w
      | (["O", ($wi + 1), (.walks | length), ($w.title | t), $w.kind, (.pending // 0)] | @tsv),
        (["P", (($w.point // $w.verdict) | t)] | @tsv),
        (if ($w.point // "") != "" then ["D", ($w.verdict | t)] | @tsv else empty end),
        (if ($w.trigger // "") != "" then ["G", (if $w.reachable == false then "latent" else "yes" end), ($w.trigger | t)] | @tsv else empty end),
        (if $w.entry != null and $w.entry.callers > 0 then ["E", ($w.entry.name | t), $w.entry.callers, ($w.entry.first | t)] | @tsv else empty end),
        (if ($w.fields // []) | length > 0 then ($w.fields[] | ["F", (.name | t), (.value | t)] | @tsv) else ["I", ($w.input | t)] | @tsv end),
        ($w.steps | to_entries[] | ["A", (.key + 1), (.value.depth // 0), (.value.symbol | t), ((.value.does // .value.next) | t), (.value.check.hop // ""), (.value.check.change // "")] | @tsv),
        (["K"] | @tsv)' "$file" > "$st/walk.$$"
  else
  # A step: where it is in the walk, the calls it is in with where it goes
  # next under them and what otis checked of it, what happens here, its
  # values, where control went before the change when that differs, and the
  # lines of its own file it points at, for the code under the card.
  jq -r --argjson k "$k" '
    def t: tostring | gsub("[\t\n]"; " ");
    [.walks | to_entries[] | .key as $wi | .value as $w | $w.steps | to_entries[] | {wi: $wi, si: .key, s: .value, w: $w}] as $all
    | $all[$k] as $x | ($x.w.steps | length) as $ns
    | (["H", ($x.wi + 1), (.walks | length), ($x.w.title | t), ($x.si + 1), $ns, (.pending // 0), (($x.w.point // $x.w.verdict) | t)] | @tsv),
      (["L", ($x.s.symbol | t), $x.s.path, $x.s.line, $x.s.side, ($x.si + 1)] | @tsv),
      # The calls it is in: for each depth above it, the last step at that
      # depth before it in this walk.
      (($x.s.depth // 0) as $d | [range(0; $d) as $dd | [$all[0:$k][] | select(.wi == $x.wi and (.s.depth // 0) == $dd)] | last | .s // empty]
        | (.[] | ["S", (.symbol | t), .path, .line] | @tsv),
          (["C", ($x.s.symbol | t), $x.s.path, $x.s.line, length, ($x.s.check.hop // ""), (($x.s.check.note // "") | t), ($x.s.check.change // "")] | @tsv)),
      # Back out of a call: what it was, and what it gave back.
      (if $x.si > 0 and (($x.s.depth // 0) < ($all[$k - 1].s.depth // 0)) then ["B", ($all[$k - 1].s.symbol | t), (($all[$k - 1].s.returns // "") | t)] | @tsv else empty end),
      # Where control goes from here: into a call, back out, or on.
      (if $x.si + 1 < $ns then $all[$k + 1].s as $nx | ($x.s.depth // 0) as $d0 | ($nx.depth // 0) as $d1
         | if $d1 > $d0 then ["Y", "call", ($nx.symbol | t), $nx.path, ($nx.check.at // $x.s.line), $nx.line] | @tsv
           elif $d1 < $d0 then ["Y", "return", ($nx.symbol | t), $nx.path, $nx.line, ""] | @tsv
           elif ($nx.symbol | t) != ($x.s.symbol | t) then ["Y", "then", ($nx.symbol | t), $nx.path, $nx.line, ""] | @tsv
           else ["Y", "stay", "", "", "", ""] | @tsv end
       else ["Y", "end", "", "", "", ""] | @tsv end),
      (if ($x.s.does // "") != "" then ["W", ($x.s.does | t)] | @tsv else empty end),
      ($x.s.values | to_entries[] | .key as $vi | .value | ["V", (.name | t), (.now | t), ((.was // "") | t), .confidence, ((.from // "") | t), "\($k):\($vi)"] | @tsv),
      (if ($x.s.returns // "") != "" then ["R", ($x.s.returns | t)] | @tsv else empty end),
      (if ($x.s.was_next // "") != "" then ["N", ($x.s.was_next | t)] | @tsv else empty end),
      (if ($x.s.note // "") != "" then ["T", ($x.s.note | t)] | @tsv else empty end),
      # The lines of its own file the step points at: where each value came
      # from, the note and where it goes next, each with what points there.
      (def lines: [scan("lines? ([0-9]+)(?:[-–]([0-9]+))?")] | map([(.[0] | tonumber), ((.[1] // .[0]) | tonumber)]);
       ($x.s.values[] | .name as $n | .now as $v | ((.from // "") | lines) as $ls
         | if ($ls | length) > 0 then ($ls[] | ["M", .[0], .[1], ($n | t), ($v | t)] | @tsv) else ["U", ($n | t), ($v | t)] | @tsv end),
       (($x.s.note // "") | lines[] | ["M", .[0], .[1], "", ""] | @tsv),
       (($x.s.next // "") | lines[] | ["M", .[0], .[1], "", ""] | @tsv)),
      # The call this step makes next, where the step after says it is made.
      (if $x.si + 1 < $ns and ($all[$k + 1].s.check.at // null) != null and (($all[$k + 1].s.depth // 0) > ($x.s.depth // 0))
       then ["Z", $all[$k + 1].s.check.at, ($all[$k + 1].s.symbol | t)] | @tsv else empty end)' "$file" > "$st/walk.$$"
  fi
  # An input from before walks had fields is a sentence: "a=1, b=[2, 3], c
  # does d". Its "name=value" parts become fields, the rest stays words.
  awk -F'\t' 'BEGIN { OFS = "\t" }
    function part(t,   m) {
      sub(/^ +/, "", t); sub(/ +$/, "", t)
      if (t == "") return
      if (match(t, /^[^=!<>"\047]+=/) && substr(t, RLENGTH + 1, 1) != "=") print "F", substr(t, 1, RLENGTH - 1), substr(t, RLENGTH + 1)
      else print "Q", t
    }
    $1 != "I" { print; next }
    {
      t = $2; cur = ""; d = 0; q = ""
      for (i = 1; i <= length(t); i++) {
        c = substr(t, i, 1)
        if (q != "") { if (c == q) q = ""; cur = cur c; continue }
        if (c == "\"" || c == "\047") q = c
        else if (c ~ /[[({]/) d++
        else if (c ~ /[])}]/) d--
        else if (c == "," && d == 0) { part(cur); cur = ""; continue }
        cur = cur c
      }
      part(cur)
    }' "$st/walk.$$" > "$st/walk.$$.2"
  # The values are code, so they read as code: each written to a file of its
  # own (one bat over them all, each starting clean), in the language of the
  # step's file, and read back in the order the card uses them.
  lang=$(awk -F'\t' '$1 == "L" { n = split($3, a, "."); print a[n]; exit }' "$st/walk.$$.2")
  awk -F'\t' -v d="$st/hl.$$" '
    function out(v) { f = sprintf("%s.%04d", d, ++n); print v > f; close(f) }
    $1 == "F" { out($3) } $1 == "B" && $3 != "" { out($3) } $1 == "V" { out($3); if ($4 != "") out($4) } $1 == "R" { out($2) }' "$st/walk.$$.2"
  set -- "$st/hl.$$".[0-9]*
  if [ -e "$1" ]; then
    BAT_THEME=${OTIS_T_BAT:-ansi} bat --color=always --style=plain --paging=never -l "$lang" "$@" > "$st/hl.$$" 2>/dev/null ||
      BAT_THEME=${OTIS_T_BAT:-ansi} bat --color=always --style=plain --paging=never -l ts "$@" > "$st/hl.$$" 2>/dev/null ||
      cat "$@" > "$st/hl.$$"
    rm -f "$@"
  else : > "$st/hl.$$"; fi
  ty=$dir/$key.types; [ -s "$ty" ] || ty=/dev/null
  cat > "$st/card.$$" <<'EOF'
    function dw(s) { gsub(/\033\[[0-9;]*m/, "", s); gsub(/[\200-\277]/, "", s); return length(s) }
    FILENAME == ARGV[1] { hl[++nh] = $0; next }
    FILENAME == ARGV[2] { if (length($2) <= 40 && gsub(/\|/, "|", $2) <= 2) TY[$1] = $2; next }
    # code: the next value, as bat colored it.
    function code(v) { return ++uh <= nh ? hl[uh] GK_R : v }
    # wrap: t in color c, words to the pane, lead on the first line and ind
    # spaces before the rest.
    function wrap(t, c, lead, ind,   nw, wd, x, ln, first) {
      nw = split(t, wd, " "); ln = ""; first = 1
      for (x = 1; x <= nw; x++) {
        if (ln != "" && dw((first ? lead : gk_rep(" ", ind)) ln " " wd[x]) > w) { print (first ? lead : gk_rep(" ", ind)) c ln GK_R; ln = ""; first = 0 }
        ln = (ln == "" ? "" : ln " ") wd[x]
      }
      if (ln != "") print (first ? lead : gk_rep(" ", ind)) c ln GK_R
    }
    function base(p,   n, a) { n = split(p, a, "/"); return a[n] }
    # right: l, and r at the pane's right edge.
    function right(l, r,   pad) { pad = w - dw(l) - dw(r); if (pad < 2) pad = 2; return l gk_rep(" ", pad) r }
    # A value that is code is colored as code; one the model wrote as words
    # is plain, not colored as code.
    function prose(v) { return v ~ /[A-Za-z]{2,} [A-Za-z]{2,} [A-Za-z]{2,}/ && v !~ /^[[{\047"`]/ }
    function val(v, c) { return prose(v) ? GK_CONTEXT "\033[3m" v GK_R : c }
    # Where it came from, short: "line 192", "step 2", "input", "database".
    function src(f) { sub(/[ ]*[(,;].*/, "", f); sub(/^(the|a) /, "", f); if (length(f) > 20) f = substr(f, 1, 19) "\342\200\246"; return f }
    function kind(k) { return k == "intended" ? GK_GOOD "what it was written for" GK_R : k == "same" ? GK_CONTEXT "behaves as before" GK_R : GK_ATTENTION "not in its description" GK_R }
    # The values, a table: the name, the value (before \342\206\222 after when the
    # change moved it), and at the right, quietly, whether the change moved
    # it and where it came from. A type only where the value is empty.
    function rows(   i, name, lead, v, tag, from) {
      if (nl > 26) nl = 26
      for (i = 1; i <= nr; i++) {
        name = length(rn[i]) > nl ? "\342\200\246" substr(rn[i], length(rn[i]) - nl + 2) : rn[i]
        lead = "   " GK_CONTEXT gk_padr(name, nl) GK_R "   "
        v = (rw[i] != "" ? rw[i] GK_FAINT "  \342\206\222  " GK_R : "") rv[i] (rt[i] != "" ? GK_FAINT "  " rt[i] GK_R : "")
        from = ra[i] ? "assumed" : rf[i]
        tag = (rw[i] != "" ? GK_ATTENTION "changed" GK_R : "") (rw[i] != "" && from != "" ? GK_FAINT " \302\267 " GK_R : "") (from != "" ? GK_FAINT from GK_R : "")
        if (dw(lead v) + dw(tag) + 4 <= w) print (tag != "" ? right(lead v, tag) : lead v)
        else { wrap(v, "", lead, nl + 6); if (tag != "") print right("", tag) }
      }
      nr = 0; nl = 0
    }
    function row(n, v, was, assumed, from, type) { nr++; rn[nr] = n; rv[nr] = v; rw[nr] = was; ra[nr] = assumed; rf[nr] = from; rt[nr] = type; if (length(n) > nl) nl = length(n) }
    $1 != "F" && $1 != "V" && $1 != "Q" && $1 != "R" && nr { rows() }

    # --- a walk's overview -----------------------------------------------------
    $1 == "O" {
      print right("\033[1m" GK_TEXT $4 GK_R, GK_FAINT "walk " $2 " of " ($3 + $6) GK_R)
      print kind($5)
    }
    $1 == "P" { print ""; wrap($2, "\033[1m" GK_TEXT, "", 0) }
    $1 == "D" { wrap($2, GK_CONTEXT, "", 0) }
    $1 == "G" {
      print ""
      if ($2 == "latent") wrap($3, GK_TEXT, GK_BAD "\342\232\240 Nothing triggers this today.  " GK_R, 2)
      else wrap($3, GK_CONTEXT, GK_FAINT "When   " GK_R, 7)
    }
    $1 == "E" { wrap($2 " has " $3 " caller" ($3 == 1 ? "" : "s") " outside the change; the first is " $4, GK_FAINT, "       ", 7) }
    $1 == "F" || $1 == "Q" { if (!inp) { print ""; print GK_FAINT "Input" GK_R; inp = 1 } }
    $1 == "F" { row($2, code($3), "", 0, "", "") }
    $1 == "Q" { if (nr) rows(); wrap($2, GK_TEXT, "   ", 3) }
    $1 == "A" {
      if (!steps++) { print ""; print GK_FAINT "Steps" GK_R }
      ind = 3 + 2 * $3
      lead = "   " GK_FAINT gk_padl($2, 2) GK_R "  " gk_rep("  ", $3) (($6 ~ /^(missing|return|jump|line)$/) ? GK_BAD "\342\232\240 " GK_R : "") \
        (($7 == "line" || $7 == "definition") ? GK_TEXT : GK_CONTEXT) $4 GK_R "   "
      print lead GK_FAINT gk_cut($5, w - dw(lead)) GK_R
    }
    $1 == "K" {
      print ""
      print GK_FAINT "j and k, or > and <, step through it  \302\267  P goes back to the symbols  \302\267  y copies it for Claude" GK_R
      print GK_FAINT "in the code: " GK_R GK_ATTENTION "\342\226\266" GK_R GK_FAINT " where the step is   " GK_R GK_ATTENTION "\342\236\234" GK_R GK_FAINT " the call it makes next   " GK_R GK_ATTENTION "\342\200\242" GK_R GK_FAINT " a line it points at, its value beside it" GK_R
    }

    # --- a step -----------------------------------------------------------------
    $1 == "H" {
      print right("\033[1m" GK_TEXT $4 GK_R, GK_FAINT "step " $5 " of " $6 ($7 > 0 ? "  \302\267  " $7 " more walk" ($7 == 1 ? "" : "s") " coming" : "") GK_R)
      strip = ""
      if ($6 <= 30) for (i = 1; i <= $6; i++) strip = strip (i == $5 ? GK_ATTENTION "\342\227\217" : i < $5 ? GK_CONTEXT "\342\227\217" : GK_FAINT "\342\227\213") GK_R (i < $6 ? " " : "")
      print right(GK_CONTEXT gk_cut($8, w - dw(strip) - 4) GK_R, strip)
    }
    # The calls it is in, a line each, then this one, lit, with what otis
    # checked of it and where control goes next under it.
    function stk(l) { return "   " (l > 0 ? gk_rep("  ", l - 1) GK_FAINT "\342\224\224 " GK_R : "") }
    $1 == "S" { if (!ns++) print ""; print right(stk(ns - 1) GK_CONTEXT $2 GK_R, GK_FAINT base($3) ":" $4 GK_R) }
    $1 == "C" {
      if (!ns) print ""
      depthc = $5; ci = 3 + 2 * $5
      print right(stk($5) "\033[1m" GK_ATTENTION $2 GK_R, GK_CONTEXT base($3) ":" $4 GK_R)
      chg = $8 == "line" ? GK_ATTENTION "the change made this line" GK_R : $8 == "definition" ? GK_ATTENTION "in code the change made" GK_R : GK_FAINT "code the change did not touch" GK_R
      if ($6 ~ /^(missing|return|jump|line)$/) { wrap($7, GK_BAD, gk_rep(" ", ci) GK_BAD "\342\232\240 " GK_R, ci + 2); print gk_rep(" ", ci) chg }
      else if ($6 ~ /^(call|back)$/ && $7 != "") wrap($7 GK_R GK_FAINT "  \302\267  " GK_R chg, GK_FAINT, gk_rep(" ", ci) GK_GOOD "\342\234\223 " GK_R, ci + 2)
      else if ($6 ~ /^(via|passed|built)$/) wrap($7 GK_R GK_FAINT "  \302\267  " GK_R chg, GK_CONTEXT, gk_rep(" ", ci) GK_CONTEXT "\342\206\252 " GK_R, ci + 2)
      else print gk_rep(" ", ci) chg
    }
    $1 == "B" { wrap(($3 != "" ? "with " code($3) : ""), "", gk_rep(" ", 3 + 2 * depthc) GK_CONTEXT "\342\206\251 back from " $2 " " GK_R, 5 + 2 * depthc) }
    $1 == "Y" && $2 == "call" { print right(stk(depthc + 1) GK_CONTEXT "\342\236\234 " $3 GK_R, GK_FAINT base($4) ":" $6 GK_R) }
    $1 == "Y" && $2 == "return" { print gk_rep(" ", 3 + 2 * depthc) GK_FAINT "\342\206\251 then back out to " GK_R GK_CONTEXT $3 GK_R }
    $1 == "Y" && $2 == "then" { print gk_rep(" ", 3 + 2 * depthc) GK_FAINT "\342\236\234 then on to " GK_R GK_CONTEXT $3 GK_R }
    $1 == "Y" && $2 == "end" { print gk_rep(" ", 3 + 2 * depthc) GK_FAINT "\342\226\240 the walk ends here" GK_R }
    $1 == "W" { print ""; wrap($2, GK_TEXT, "   ", 3) }
    $1 == "V" { if (!vs++) print ""; row($2, val($3, code($3)), $4 != "" ? val($4, code($4)) : "", $5 == "assumed", src($6), $3 ~ /^(undefined|null)$/ ? TY[$7] : "") }
    $1 == "R" { if (!vs++) print ""; row("returns", code($2), "", 0, "", "") }
    $1 == "N" { print ""; wrap($2, GK_CONTEXT, "   " GK_BAD "before the change  " GK_R, 21) }
    $1 == "T" { print ""; wrap($2, "\033[3m" GK_CONTEXT, "   ", 3) }
    END { if (nr) rows() }
EOF
  if [ -n "$ov" ]; then
    # The overview: read, not pinned, and no code under it.
    LC_ALL=C awk -F'\t' -v w="$w" -f "$share/rowfmt.awk" -f "$st/card.$$" "$st/hl.$$" "$ty" "$st/walk.$$.2"
    rm -f "$st/card.$$" "$st/walk.$$" "$st/walk.$$.2" "$st/hl.$$"
    exec >&3 3>&-
    cat "$st/show.$$"; rm -f "$st/show.$$"
    exit 0
  fi
  # The card, pinned above the pane's scroll (otis-symbols), the code
  # scrolling under it: what the step holds stays in sight while you read
  # the diff. The pane pins what it has room for and scrolls the rest.
  LC_ALL=C awk -F'\t' -v w="$w" -f "$share/rowfmt.awk" -f "$st/card.$$" "$st/hl.$$" "$ty" "$st/walk.$$.2" > "$st/pinned.$$"
  { echo; LC_ALL=C awk -v w="$w" "$(cat "$share/rowfmt.awk")"'BEGIN { s = ""; for (i = 0; i < w; i++) s = s "\342\224\200"; print GK_FAINT s GK_R }' </dev/null; } >> "$st/pinned.$$"
  printf '\036pin %d\n' "$(wc -l < "$st/pinned.$$")"
  cat "$st/pinned.$$"
  rm -f "$st/card.$$" "$st/pinned.$$"
  # Its code: the step's line and what is around it, as the change leaves
  # the file (before it, for a step on the old side), the line marked in the
  # gutter. A file the change did not touch is all context. Each side is
  # colored whole by bat and the diff laid over it here: delta's grammar
  # loses its place in some TypeScript and leaves the added lines plain.
  IFS='	' read -r _ sym path line side <<EOF2
$(grep '^L	' "$st/walk.$$")
EOF2
  # The call it makes next: its line gets ➜, and the window reaches it; one
  # far off is a window of its own.
  IFS='	' read -r _ callat callee <<EOF2
$(grep '^Z	' "$st/walk.$$")
EOF2
  # The lines the step points at, "first last what" a line (M, from the
  # card): marked in the gutter with what points there, and shown.
  grep '^M	' "$st/walk.$$" | cut -f2- > "$st/refs.$$"
  grep '^U	' "$st/walk.$$" > "$st/walk.$$.u"
  rm -f "$st/walk.$$" "$st/walk.$$.2" "$st/hl.$$"
  cs=old; [ "$side" = old ] || cs=new
  # What is shown: the whole changed definition the step is in, as the
  # symbol view shows it (else 15 lines before it and 40 after), the call it
  # makes next and every line it points at with a few around each, merged
  # where they touch, in order.
  whole=$(awk -F'\t' -v p="$path" -v sd="$cs" -v l="$line" '
    $1 != p || $2 == "file" { next }
    { if (sd == "old") { if ($7 == "old") { a = $8; z = $9 } else if ($14 != "") { a = $14; z = $15 } else next } else { if ($7 != "new") next; a = $8; z = $9 } }
    a <= l && l <= z && (!b || z - a < bz - b) { b = a; bz = z }
    END { if (b) print b, bz }' "$table" 2>/dev/null)
  [ -n "$whole" ] || whole="$((line - 15)) $((line + 40))"
  ranges=$({
    printf '%s\n' "$whole"
    [ -n "$callat" ] && [ "$side" != old ] && printf '%s %s\n' $((callat - 2)) $((callat + 3))
    [ "$side" != old ] && awk -F'\t' '{ printf "%d %d\n", $1 - 2, $2 + 2 }' "$st/refs.$$"
  } | sort -n | awk '{ if ($1 < 1) $1 = 1 } n && $1 <= e + 4 { if ($2 > e) e = $2; next } { if (n) print s, e; s = $1; e = $2; n = 1 } END { if (n) print s, e }' |
    awk '{ printf "%s%d-%d", (NR > 1 ? "," : ""), $1, $2 }')
  # The marks, a line each: the line and what to say at its end, the
  # value there as a debugger shows it ("isShopperAgentStep = true"). A
  # value from no line in particular goes where the step itself uses it: in
  # its statement, from its line to the next blank one (20 lines at most),
  # on the line that declares or sets its name, else names it; not there,
  # it goes nowhere, rather than on some line that happens to name it.
  : > "$st/marks.$$"
  if [ "$side" != old ]; then
    # A line the model cites is kept only where it names the value: its
    # line numbers are sometimes the base's, or off by a few. Else the line
    # within 15 of it that declares or sets the name, else one naming it;
    # else no mark. The note's and next's lines get none: a dot says where
    # a value is.
    { if [ -n "$head" ]; then git show "$head:$path"; else cat "$top/$path"; fi; } 2>/dev/null > "$st/text.$$"
    awk -F'\t' '
      FILENAME == ARGV[1] { T[FNR] = $0; nt = FNR; next }
      $3 == "" { next }
      {
        n = $3; sub(/.*\./, "", n); if (n !~ /^[A-Za-z_$][A-Za-z0-9_$]*$/) next
        say = $4 != "" ? $3 " = " $4 : $3
        bare = "(^|[^A-Za-z0-9_$])" n "([^A-Za-z0-9_$]|$)"
        decl = "(const|let|var)[ \t]+" n "([^A-Za-z0-9_$]|$)|(^|[^A-Za-z0-9_$.])" n "[ \t]*(=[^=>]|:[^:])"
        hit = 0
        for (i = $1; i <= $2 && i <= nt; i++) if (T[i] ~ bare) { print i "\t" say; hit = 1 }
        if (hit) next
        best = 0
        for (i = $1 - 15; i <= $2 + 15; i++) if (i >= 1 && i <= nt && T[i] ~ decl) { d = i < $1 ? $1 - i : i - $2; if (!best || d < bd) { best = i; bd = d } }
        if (!best) for (i = $1 - 15; i <= $2 + 15; i++) if (i >= 1 && i <= nt && T[i] ~ bare) { d = i < $1 ? $1 - i : i - $2; if (!best || d < bd) { best = i; bd = d } }
        if (best) print best "\t" say
      }' "$st/text.$$" "$st/refs.$$" >> "$st/marks.$$"
    rm -f "$st/text.$$"
    cut -f2- "$st/walk.$$.u" 2>/dev/null |
      while IFS='	' read -r name val; do
        { if [ -n "$head" ]; then git show "$head:$path"; else cat "$top/$path"; fi; } 2>/dev/null |
          awk -v n="${name##*.}" -v l="$line" -v say="$name = $val" '
            BEGIN { if (n !~ /^[A-Za-z_$][A-Za-z0-9_$]*$/) exit }
            NR < l { next }
            NR > l + 20 || (NR > l && $0 ~ /^[ \t]*$/) { exit }
            { d = NR - l }
            $0 ~ ("(const|let|var)[ \t]+" n "([^A-Za-z0-9_$]|$)|(^|[^A-Za-z0-9_$.])" n "[ \t]*(=[^=>]|:[^:])") { if (!dl || d < dd) { dl = NR; dd = d } }
            $0 ~ ("(^|[^A-Za-z0-9_$])" n "([^A-Za-z0-9_$]|$)") { if (!al || d < ad) { al = NR; ad = d } }
            END { x = dl ? dl : al; if (x) print x "\t" say }'
      done >> "$st/marks.$$"
  fi
  rm -f "$st/refs.$$" "$st/walk.$$.u"
  lang=${path##*.}
  paint() { BAT_THEME=${OTIS_T_BAT:-ansi} bat --color=always --style=plain --paging=never -l "$lang" 2>/dev/null || cat; }
  { if [ -n "$head" ]; then git show "$head:$path"; else cat "$top/$path"; fi; } 2>/dev/null | paint > "$st/wn.$$"
  git show "$base:$path" 2>/dev/null | paint > "$st/wo.$$"
  echo
  { d=$(gdiff -U999999 -- "$path" 2>/dev/null)
    if [ -n "$d" ]; then printf '%s\n' "$d"
    else
      # Untouched: every line context, from the side the step is on.
      n=$(if [ "$cs" = old ]; then wc -l < "$st/wo.$$"; else wc -l < "$st/wn.$$"; fi)
      printf '@@ -1,%d +1,%d @@\n' "$n" "$n"; awk -v n="$n" 'BEGIN { for (i = 1; i <= n; i++) print " " }'
    fi; } > "$st/wd.$$"
  LC_ALL=C awk -v l="$line" -v cs="$cs" -v ranges="$ranges" -v mf="$st/marks.$$" -v call="$callat" -v callee="$callee" -v plus="$OTIS_T_PLUS" -v minus="$OTIS_T_MINUS" \
    "$(cat "$share/rowfmt.awk")"'
      function hex(x,   i, v) { v = 0; x = tolower(x); for (i = 1; i <= 2; i++) v = v * 16 + index("0123456789abcdef", substr(x, i, 1)) - 1; return v }
      function bg(h, dflt) {
        if (h !~ /^#[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]$/) return "\033[" dflt "m"
        return sprintf("\033[48;2;%d;%d;%dm", hex(substr(h, 2, 2)), hex(substr(h, 4, 2)), hex(substr(h, 6, 2)))
      }
      # A line on a ground: the ground put back after every reset in it, and
      # carried to the edge of the pane.
      function ground(t, g) { gsub(/\033\[0m/, "\033[0m" g, t); return g t "\033[0K" GK_R }
      BEGIN {
        PG = bg(plus, "48;5;22"); MG = bg(minus, "48;5;52")
        nw = split(ranges, rg, ","); for (i = 1; i <= nw; i++) { split(rg[i], ab, "-"); WA[i] = ab[1] + 0; WZ[i] = ab[2] + 0 }
      }
      function win(x,   i) { for (i = 1; i <= nw; i++) if (x >= WA[i] && x <= WZ[i]) return i; return 0 }
      FILENAME == mf { split($0, f, "\t"); m = f[1] + 0; if (!(m in MW)) MW[m] = ""; if (f[2] != "" && index(",  " MW[m] ",  ", ",  " f[2] ",  ") == 0) MW[m] = MW[m] (MW[m] == "" ? "" : ",  ") f[2]; next }
      FILENAME == ARGV[2] { H[FNR] = $0; next }
      FILENAME == ARGV[3] { B[FNR] = $0; next }
      !inh && /^@@/ { inh = 1; split($2, a, ","); o = substr(a[1], 2) + 0; split($3, b, ","); n = substr(b[1], 2) + 0; next }
      !inh { next }
      {
        c = substr($0, 1, 1)
        if (c == " ") { at = cs == "new" ? n : o; last = at; oo = o; nn = n; o++; n++ }
        else if (c == "-") { at = cs == "old" ? o : ""; if (at != "") last = at; oo = o; nn = ""; o++ }
        else if (c == "+") { at = cs == "new" ? n : ""; if (at != "") last = at; oo = ""; nn = n; n++ }
        else next
        wi = win(last)
        if (!wi) next
        # A window after the first, after a gap.
        if (wi != lastw && lastw) print GK_FAINT "          \342\213\256" GK_R
        lastw = wi
        here = !done && at != "" && at + 0 == l
        if (here) done = 1
        callhere = !cdone && call != "" && c != "-" && at != "" && at + 0 == call + 0
        # The step on the line it calls from: still here, and saying so.
        if (callhere) cdone = 1
        col = c == "-" ? GK_BAD : c == "+" ? GK_GOOD : GK_FAINT
        ref = c != "-" && at != "" && (at + 0 in MW) && !here && !callhere
        gut = col sprintf("%4s", oo) GK_FAINT " \342\213\256 " GK_R col sprintf("%-4s", nn) GK_R (here ? GK_ATTENTION "\342\226\266" GK_R : callhere ? GK_ATTENTION "\342\236\234" GK_R : ref ? GK_ATTENTION "\342\200\242" GK_R : GK_FAINT "\342\224\202" GK_R)
        tail = callhere ? "   " GK_ATTENTION "\342\206\220 calls " callee " next" GK_R : ""
        if (c != "-" && at != "" && (at + 0 in MW) && MW[at + 0] != "" && !refdone[at + 0]++) tail = tail "   " GK_CONTEXT "\033[3m" gk_cut(MW[at + 0], 70) GK_R
        if (c == "+") print gut ground(H[nn], PG) tail
        else if (c == "-") print gut ground(B[oo], MG)
        else print gut (cs == "new" ? H[nn] : B[oo]) GK_R tail
      }' "$st/marks.$$" "$st/wn.$$" "$st/wo.$$" "$st/wd.$$"
  rm -f "$st/wn.$$" "$st/wo.$$" "$st/wd.$$" "$st/marks.$$"
  # The preview opens with the step's line near the top, unless the row has
  # been scrolled already: where it is goes where otis-symbols keeps a
  # row's scroll (off.<row>), for its first showing.
  exec >&3 3>&-
  if [ -n "$rid" ]; then
    r=$(printf '%s' "$rid" | tr '/' '%'); while [ ${#r} -gt 200 ]; do r=${r#?}; done
    [ -e "$st/off.$r" ] || LC_ALL=C awk 'NR == 1 && /^\036pin / { skip = $2 + 1 } /\342\226\266/ { n = NR - skip; print (n > 4 ? n - 4 : 1); exit }' "$st/show.$$" > "$st/off.$r"
    [ -s "$st/off.$r" ] || rm -f "$st/off.$r"
  fi
  cat "$st/show.$$"; rm -f "$st/show.$$"
  exit 0
fi

# Asked for: the cache once walked, else started.
[ -s "$file" ] && { printf '%s\n' "$file"; exit 0; }
alive && { echo running; exit 0; }
start && echo running
exit 0
