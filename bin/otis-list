#!/bin/sh
# otis-list [--refresh]
# What the dashboard is made from. It fetches what GitLab knows (your merge
# requests with their pipelines, the ones you were asked to review, what
# merged, the deploys) into the state, with what Claude's runs have left
# (the marks), and prints the rows for everything that is not an open merge
# request's own state. That is otis-board's to decide, in one place, from
# the JSON left here: what its pipeline, its review and its verification
# say, and so which lane it is in.
#
#   waiting on you  what wants you and is not a light of an open MR, most
#                   costly delay first:
#                     1  prod: likely this      production is unhappy
#                     2  rolled back            yours went out and came back
#                     3  prod: possibly this
#                     4  verified: failed       a branch with no MR does not work
#                     4½ verify failed          one of Claude's runs broke, until
#                                               you have seen it (d)
#                     5  main build failed      a push of yours broke main
#                     6  review its diff        a thread's turn is over: Claude
#                        answer Claude          brought commits back, or only
#                                               words (otis-thread)
#                     8  fold in N fixes        Claude has left you work, on a
#                                               branch with no MR
#                    10  verified: passed       news, not a blockage
#   going           what is moving without you, newest first: Claude's
#                   background runs (git-agent-list) and your pushes to main,
#                   then, last, your merged MRs that production has not taken
#                   yet, each with where it has got to. A deploy of its own
#                   shows only when it is carrying none of yours.
#   here            one row, always: the branch you are on, what is
#                   uncommitted, unpushed and behind, and its MR.
#
# A row is what you see, then tab-separated the same fields a gmr row carries
# (iid, target, url, source, kind, head, base, pipeline id, pipeline url, the
# row's identity, start sha), so the MR keys shared by every picker act on it
# unchanged (git-mr-do). Then two of its own: the run's directory for a row
# about one of Claude's runs (the branch, for here), and what enter should do
# (otis-do). Then the row in parts, for the dashboard to lay out (otis-dash):
# its glyph and the glyph's color, the verb, what it is about (the MR's
# title), who (a review's author), how long ago, a note (a run's branch,
# the here row's state), a pipeline's jobs done/total, 1 if it is the
# branch you are on, and what enter does, in a few words (otis-do's enter).
#
# Nothing here fetches anything gmr does not: the same three caches under the
# same names (git-cached-json, share/mr-query.sh), so opening one warms the
# other, and the JSON lands in the picker's state where the MR previews expect
# it (git-mr-preview). --refresh (u) asks the forge again now, and does not
# wait for it: the rows are printed at once from what the caches hold, each
# cache is fetched behind them, and each that lands says so (told), for the
# rows to be made again from what it brought. So what GitLab is slow to say
# (your MRs with their pipelines, four seconds) never holds up what is on
# this machine, nor what it was quicker to say.
st=$GIT_FZF_STATE
[ -n "$st" ] || { st=$(mktemp -d) || exit 1; trap 'rm -rf "$st"' EXIT; }
share=$(cd "$(dirname "$0")/../share" && pwd)
. "$share/palette.sh"
# Claude's runs that a closed laptop killed go on from where they stopped, as
# gmr and gb do when they draw. First, so a run that comes back is already
# running when the scans below look.
( . "$share/claude-run.sh" && resume_all )

# The dashboard has no picker to reload, so it names a file to be told by
# when a fetch lands behind it (told, git-cached-json's OTIS_FETCHED), and
# its caches are kept fresh without u: the merge requests a minute apart,
# what merged and the deploys two, while it is open.
age=60 merged_age=120
[ "$1" = --refresh ] && age=0 merged_age=0
reload="execute-silent(git-fzf-bg --then refresh-preview otis-list)"
. "$share/repo.sh" || exit 1
common=$OTIS_GITDIR
told=$st/fetched
# What Claude is doing and what it has left you, and every background run.
# None of it needs a setting, so it starts before they are read.
git-mr-watch --marks  > "$st/m.watch"  2>/dev/null &
git-mr-claude --marks > "$st/m.claude" 2>/dev/null &
git-mr-fix --marks    > "$st/m.fixes"  2>/dev/null &
git-verify --marks    > "$st/m.verify" 2>/dev/null &
# Usually there are none, and jq started to say [] was a process a draw.
{
  runs=$(git-agent-list --data 2>/dev/null)
  if [ -n "$runs" ]; then
    printf '%s\n' "$runs" | jq -Rn '[inputs | split("\t") |
      {state: .[0], started: ((.[1] | tonumber?) // 0), ended: ((.[2] | tonumber?) // 0),
       kind: .[3], dir: .[4], last: (.[5] // ""), doing: (.[6] // ""), dots: (.[7] // ""),
       label: (.[8] // "run"), came: ((.[9] | tonumber?) // 0)}]'
  else
    echo '[]'
  fi
} > "$st/runs.json" &
# Worktrees otis moved to the trash and you have not emptied yet
# (git-worktree-trash keeps the note; it prunes what is gone).
git-worktree-trash --list > "$st/trash.tsv" 2>/dev/null &
# Verdicts and failed runs you have told the dashboard you have seen (d,
# otis-do): the run's key and what you saw, so it comes back when that
# changes. gmr and gag keep showing them either way; this is the dashboard's
# own note, not the run's.
{
  . "$share/claude-run.sh"
  for kind in $run_kinds; do
    for run in "$common/$kind"/*/; do
      [ -s "$run/seen" ] || continue
      run=${run%/}
      printf '%s/%s\t%s\n' "$kind" "${run##*/}" "$(cat "$run/seen")"
    done
  done
  # And what has no run to keep it in (a rollback with no watch), in a note
  # of its own, the same shape.
  cat "$common/otis-dismissed" 2>/dev/null
} > "$st/seen.tsv" 2>/dev/null &

# Where you are. Git's own answers, not a cache: this is the one part of the
# dashboard about the checkout under you, and it has to be right. Five git
# processes, and this was the slowest thing a draw waited on when they ran one
# after another; each that needs nothing from the others runs beside them, so
# the row costs its status, the slow one, and no more. It asks for the base
# itself, so it starts before the settings below are read rather than after.
# A line of fields, for the render to read: a jq to write it as JSON was a
# process of its own.
(
  git --no-optional-locks status --porcelain 2>/dev/null | grep -c . > "$st/here.dirty" &
  git rev-parse --short HEAD > "$st/here.sha" 2>/dev/null &
  { git rev-list --left-right --count "$(otis-config base)...HEAD" > "$st/here.counts"; } 2>/dev/null &
  branch=$(git branch --show-current)
  unpushed=
  # No copy on origin, or none it could count against: as far past the base
  # as it is, below.
  [ -n "$branch" ] && unpushed=$(git rev-list --count "origin/$branch..HEAD" 2>/dev/null)
  wait
  ahead=0 behind=0
  if [ -n "$branch" ]; then
    read -r behind ahead < "$st/here.counts" || :
    [ -n "$behind" ] || behind=0
    [ -n "$ahead" ] || ahead=0
    [ -n "$unpushed" ] || unpushed=$ahead
  fi
  printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$branch" "$(cat "$st/here.sha")" "$(cat "$st/here.dirty")" "$ahead" "$behind" "${unpushed:-0}"
) > "$st/here.tsv" &

# One process for every setting this draw needs, rather than one each.
{ read -r repo; read -r base; read -r url; read -r gates; read -r main; } <<EOF
$(otis-config project base url gateJobs main)
EOF

# Only the first time: a redraw keeps the last ones, which the previews read
# while the fetch is still going.
[ -s "$st/mrs.json" ] || echo '{}' > "$st/mrs.json"
[ -s "$st/ci.json" ] || echo '{}' > "$st/ci.json"
[ -s "$st/ci-merged.json" ] || echo '{"mrs": []}' > "$st/ci-merged.json"
[ -s "$st/deploys.json" ] || echo '{"deploys": []}' > "$st/deploys.json"
[ -s "$st/main.json" ] || echo '[]' > "$st/main.json"

# fetch <cache name> <stale seconds> <saved as> <review|mine|all>: the JSON into the
# picker's state. A lookup that fails leaves the last one that worked, and
# git-fzf-stale has already told the footer.
fetch() {
  json=$(OTIS_FETCHED=$told git-cached-json --no-wait "$1" "$2" "$reload" -- git-forge mrs "$4" 2>/dev/null) &&
    cp "$json" "$st/$3"
}

# Everything left is independent too, so it is all gathered at once and waited
# for: a draw costs its slowest part rather than the sum of its parts, which is
# what you feel when otis opens. Each writes a file of its own, so there is
# nothing for them to race over, and the caches are already safe to run beside
# each other (git-cached-json).

# Whether there is a GitLab or GitHub to ask runs here, in the time those take.
note=
if otis-config gitlab >/dev/null 2>&1 || [ "$(otis-config forge)" = github ]; then
  fetch mrs-review $age mrs.json review &
  fetch ci-mine $age ci.json mine &
  # Your pushes to main, where a forge has no MR for them (git-forge
  # main-builds): their checks, as a pipeline of yours.
  if git-forge can main-builds; then
    { mb=$(OTIS_FETCHED=$told git-cached-json --no-wait main-builds $age "$reload" -- git-forge main-builds 2>/dev/null) &&
        cp "$mb" "$st/main.json"; } &
  fi
  if git-forge can deploys; then
    # Where each merged MR has got to is shown at once from the last answer
    # while a new one is fetched, and that fetch is slow. An answer older than
    # five minutes may say "not out yet" of an MR that went out since, so its
    # rows wait for the new one (ci-merged.old) rather than say that.
    { merged=$(OTIS_FETCHED=$told git-cached-json --no-wait ci-merged $merged_age "$reload" -- git-forge merged 2>/dev/null) &&
        cp "$merged" "$st/ci-merged.json" &&
        if [ $(( $(date +%s) - $(stat -c %Y "$merged" 2>/dev/null || stat -f %m "$merged") )) -gt 300 ]; then
          : > "$st/ci-merged.old"
        else rm -f "$st/ci-merged.old"; fi; } &
    { deploys=$(OTIS_FETCHED=$told git-cached-json --no-wait deploys $merged_age "$reload" -- git-deploy-list --fetch 2>/dev/null) &&
        cp "$deploys" "$st/deploys.json"; } &
  fi
elif git remote get-url origin >/dev/null 2>&1; then
  note="origin is on neither GitLab nor GitHub, so this is your work here alone"
else
  note="no origin remote, so this is your work here alone"
fi
wait

# One jq for all of it. Its first line is the marks, saved as the previews
# expect them, exactly as gmr leaves them (git-mr-preview and git-ci-preview
# read them from there on every cursor move); then the rows; and last the
# counts the footer says. Each was a process of its own before, and the
# marks one read the same four files this one does.
out=$(jq -nr -L "$share" \
  --slurpfile review "$st/mrs.json" --slurpfile mine "$st/ci.json" \
  --slurpfile merged "$st/ci-merged.json" --slurpfile deployed "$st/deploys.json" --slurpfile mainb "$st/main.json" \
  --slurpfile runsf "$st/runs.json" --rawfile heretsv "$st/here.tsv" \
  --argjson gates "$gates" \
  --slurpfile watch "$st/m.watch" --slurpfile claude "$st/m.claude" \
  --slurpfile fixes "$st/m.fixes" --slurpfile verify "$st/m.verify" \
  --rawfile trash "$st/trash.tsv" --rawfile seen "$st/seen.tsv" \
  --arg common "$common" --arg base "$base" --arg url "$url" --arg main "$main" \
  --arg merged_old "$([ -e "$st/ci-merged.old" ] && echo 1)" '
  include "otis";
  (now | floor) as $NOW |
  ($runsf[0] // []) as $runs |
  ($heretsv | rtrimstr("\n") | split("\t") |
    {branch: (.[0] // ""), sha: (.[1] // ""), dirty: ((.[2] // "") | tonumber? // 0),
     ahead: ((.[3] // "") | tonumber? // 0), behind: ((.[4] // "") | tonumber? // 0),
     unpushed: ((.[5] // "") | tonumber? // 0)}) as $here |
  $here.branch as $current |
  {gates: $gates, watch: ($watch[0] // {}), claude: ($claude[0] // {}),
    fixes: ($fixes[0] // {}), verify: ($verify[0] // {})} as $marks |
  $marks as {gates: $gates, watch: $watch, claude: $claude, fixes: $fixes, verify: $verify} |

  # otis.jq pads to ten columns; these columns are wider than that.
  def pad($n): tostring | . as $s |
    if ($s | length) >= $n then $s else $s + ("                                  "[0:$n - ($s | length)]) end;
  def fit($n): tostring | if (length) > $n then .[0:$n - 1] + "…" else . end;
  def clean: tostring | gsub("\t"; " ");
  # A time GitLab may not have sent: a cache written before a field was asked
  # for has none, and one bad timestamp must not cost the whole list.
  def at: if type == "string" then epoch else 0 end;
  def since($t): ($NOW - $t) | span;

  # The fixed zone, which the pane never cuts: whether the row is the branch
  # you are on, the glyph, the merge request, and the verb. Everything after
  # it is context.
  # What enter does on the row, in the words the dashboard shows it in.
  def does:
    if .does then .does
    else {mr: (if .kind == "review" then "review it" elif .kind == "merged" then "see its deploy" else "open it" end),
          pipeline: "see its jobs", merge: "merge it", run: "open the run", rollback: "see what happened",
          deploy: "see the deploy", trash: "open the trash"}[.verb_key // ""] // "" end;
  def render:
    . as $x |
    [ (if $x.mark then elsewhere + "▶" + r else " " end) + " "
        + ($x.gc // context) + (($x.g // "") | pad(3)) + r + " "
        + attention + ((if ($x.iid // "") == "" then "" else "!\($x.iid)" end) | pad(6)) + r + " "
        + text + (($x.verb // "") | pad(21)) + r + "  "
        + ($x.tail // ""),
      (($x.iid // "") | tostring), ($x.target // ""), ($x.url // ""), ($x.source // ""),
      $x.kind, ($x.head // ""), ($x.base // ""), (($x.pipeline // "") | tostring), ($x.purl // ""),
      $x.id, ($x.start // ""), ($x.extra // ""), ($x.verb_key // ""),
      ($x.g // ""), ($x.gc // ""), ($x.verb // ""), (($x.title // "") | clean), ($x.who // ""),
      ($x.when // ""), (($x.note // "") | clean), ($x.prog // ""), (if $x.mark then "1" else "" end),
      ($x | does), (($x.sub // "") | clean), ($x.dots // "")
    ] | join("\t");

  # A heading is a row with no merge request on it, so a key that acts on one
  # says there is none rather than acting on the row below.
  def sep($text; $id):
    ([ faint + "── " + $text + " "
         + (if (56 - ($text | length)) > 0 then "─" * (56 - ($text | length)) else "" end) + r,
       "", "", "", "", "sep", "", "", "", "", $id, "", "", "", "", "", $text, "", "", "", "", "", "", "", "", "" ] | join("\t"));

  ($review[0].data.currentUser.reviewRequestedMergeRequests.nodes // []) as $asked_all |
  ($mine[0].data.currentUser.authoredMergeRequests.nodes // []) as $mine_mrs |
  ($review[0].data.currentUser.username // $mine[0].data.currentUser.username // "") as $me |
  ($merged[0].mrs // []) as $merged_mrs |
  ($deployed[0].deploys // []) as $deploys |
  # What you have dismissed, and what you saw when you did: a verdict that
  # changes since is news again, so the row comes back.
  ($seen | split("\n") | map(select(. != "") | split("\t")) | map({key: .[0], value: (.[1] // "")}) | from_entries) as $dismissed |
  def seen($kind; $key; $now): ($dismissed["\($kind)/\($key)"] // null) == $now;
  # When each run ended, by kind and key, so a verdict is news for a day and
  # then stops taking up a row: the MR keeps showing it in gmr either way.
  ([$runs[] | {key: "\(.kind)/\(.dir | split("/") | last)", value: .ended}] | from_entries) as $ended |
  def fresh_run($kind; $key): ($ended["\($kind)/\($key)"] // 0) > ($NOW - 86400);

  # One of yours that has merged, and has something left to say: production is
  # unhappy about it, or took it out again.
  def merged_row:
    ($watch[.iid] // {}) as $w |
    (seen("gmr-watch"; .iid; ($w.verdict // ""))) as $wseen |
    (if $w.verdict == "likely" and ($wseen | not) then { rank: 1, g: "✗", gc: bad, verb: "prod: likely this" }
     elif .state == "rolledback" and $merged_old == "" and (seen("rollback"; .iid; "rolledback") | not) then
       { rank: 2, g: "▼", gc: bad, verb: "rolled back", rb: true }
     elif $w.verdict == "possible" and ($wseen | not) then { rank: 3, g: "⚠", gc: yours, verb: "prod: possibly this" }
     else empty end) as $row
    | $row + { kind: "merged", iid: .iid, target: .targetBranch, url: .webUrl, source: .sourceBranch,
        head: "", base: "", start: "",
        pipeline: ((.deploy.pipeline // (.pipeline.id | gid)) // ""), purl: (.deploy.url // .webUrl),
        id: "w-mr-\(.iid)", mark: false,
        # A rollback is its own thing to dismiss; enter shows the watch when
        # there was one, else opens the MR as gmr does.
        extra: (if $w == {} then "" else "\($common)/gmr-watch/\(.iid)" end),
        verb_key: (if $row.rb then "rollback" else "run" end),
        tail: (context + (.title | clean) + r), title: .title,
        when: (if .mergedAt then since(.mergedAt | at) else "" end) } | del(.rb);

  # Fixes Claude proposed where there is no MR to hang them on: a branch of
  # your own (gb'"'"'s C), a verification'"'"'s retrospective, or the fix a
  # failed verification'"'"'s judge accepted.
  def loose_fix_rows:
    $fixes | to_entries[] | select(.key | test("^[bvf]-")) |
    . as $e | ($e.value.fixes // 0) as $n |
    select($n > 0 and ($e.value.fixing | not)) |
    (if ($e.key | startswith("v-")) then "what !\($e.key[2:])'"'"'s verification asked for"
     elif ($e.key | startswith("f-")) then "the fix from verifying " + ($e.key[2:] | if startswith("b-") then .[2:] | gsub("%"; "/") else "!" + . end)
     else ($e.key[2:] | gsub("%"; "/")) end) as $about |
    { rank: 8, g: "✎\($n)", gc: yours, verb: "fold in \($n) \(plural($n; "fix"; "fixes"))",
      kind: "run", extra: "\($common)/gmr-fix/\($e.key)", verb_key: "run",
      id: "w-fix-\($e.key)", mark: (($e.key | startswith("b-")) and ($e.key[2:] | gsub("%"; "/")) == $current),
      tail: (context + $about + r), title: $about };

  # A verification of a branch with no MR: its verdict, as mine_row gives an
  # MR'"'"'s.
  def branch_verify_rows:
    $verify | to_entries[] | select(.key | startswith("b-")) |
    .key as $key | .value as $v | ($key[2:] | gsub("%"; "/")) as $branch |
    select($v.status == "done" and (seen("otis-verify"; $key; ($v.head // "")) | not)) |
    (if $v.verdict == "fail" then { rank: 4, gc: bad, verb: "verified: failed\(if $v.fixed then ", fix verified" else "" end)" }
     elif ($v.verdict | IN("pass", "inconclusive")) and fresh_run("otis-verify"; $key) then
       { rank: 10, gc: (if $v.verdict == "pass" then good else context end),
         verb: "verified: \(if $v.verdict == "pass" then "passed" else "unclear" end)" }
     else empty end)
    + { g: "●", kind: "run", extra: "\($common)/otis-verify/\($key)", verb_key: "run",
        id: "w-verify-\($key)", mark: ($branch == $current), tail: (context + $branch + r), title: $branch };

  # One of Claude'"'"'s runs that broke rather than finishing (or died and could
  # not pick up again), of any kind, until you have seen it: otherwise it
  # leaves the going section and nothing says it never got anywhere.
  def failed_rows:
    $runs[] | select(.state | IN("failed", "died")) |
    . as $run | ($run.dir | split("/") | last) as $key |
    (if $run.ended > 0 then $run.ended else $run.started end) as $at |
    select(seen($run.kind; $key; "\($at)") | not) |
    $run.label as $label |
    # Not red: what broke is the run, not your change, which a red row would say.
    { rank: 4.5, g: "✗", gc: yours, verb: "\($label) never finished", kind: "run", extra: $run.dir, verb_key: "run",
      id: "w-failed-\($run.kind)-\($key)",
      mark: (($key | startswith("b-")) and ($key[2:] | gsub("%"; "/")) == $current),
      iid: (if ($key | test("^[0-9]+$")) then $key elif ($key | test("^v-[0-9]+$")) then $key[2:] else "" end),
      tail: (faint + since($at) + r
            + (if ($key | startswith("b-")) then context + "  " + ($key[2:] | gsub("%"; "/")) + r else "" end)
            + (if $run.last == "" then "" else context + "  " + ($run.last | clean) + r end)),
      title: $run.last, when: since($at),
      note: (if ($key | startswith("b-")) then $key[2:] | gsub("%"; "/") else "" end) };

  # A thread whose turn is over (otis-thread): commits Claude brought back,
  # to read, or only words, to answer, with the first of them; until you
  # have seen it (x) or its next turn ends.
  def thread_rows:
    $runs[] | select(.kind == "otis-thread" and .state == "done") |
    . as $run | ($run.dir | split("/") | last) as $key | ($key[2:] | gsub("%"; "/")) as $branch |
    select(seen("otis-thread"; $key; "\($run.ended)") | not) |
    (if $run.came > 0 then { verb: "review its diff", does: "read it" } else { verb: "answer Claude", does: "answer it" } end)
    + { rank: 6, g: "✻", gc: yours, kind: "run", extra: $run.dir, verb_key: "run",
        id: "w-thread-\($key)", mark: ($branch == $current), source: $branch,
        tail: (context + $branch + r + (if $run.last == "" then "" else context + "  " + ($run.last | clean) + r end)),
        title: $run.last, when: since($run.ended), note: $branch };

  # Claude'"'"'s background runs that are going now (git-agent-list --data).
  def run_row:
    . as $run | ($run.dir | split("/") | last) as $key |
    (if $run.kind == "gmr-claude" then { verb: "reviewing", g: "◌" }
     elif $run.kind == "gmr-fix" then { verb: "proposing fixes", g: "◌" }
     elif $run.kind == "gmr-watch" then { verb: "watching production", g: "◌" }
     elif $run.kind == "otis-walk" then { verb: "walking", g: "◌" }
     elif $run.kind == "otis-thread" then { verb: "Claude working", g: "◌" }
     else { verb: "verifying", g: "◎" } end)
    + { rank: (0 - $run.started), gc: attention, kind: "run", extra: $run.dir, verb_key: "run",
        id: "g-\($run.kind)-\($key)", mark: false,
        iid: (if ($key | test("^[0-9]+$")) then $key elif ($key | test("^v-[0-9]+$")) then $key[2:] else "" end),
        tail: (faint + since($run.started) + r
              + (if ($key | startswith("b-")) then context + "  " + ($key[2:] | gsub("%"; "/")) + r else "" end)
              + (if $run.last == "" then "" else context + "  " + ($run.last | clean) + r end)),
        title: $run.last, when: since($run.started),
        note: (if ($key | startswith("b-")) then $key[2:] | gsub("%"; "/") else "" end),
        sub: $run.doing, dots: $run.dots };

  # Your pushes to main, while their checks run: the newest few, each as a
  # pipeline of yours with no MR (git-forge main-builds).
  def main_fields: . as $b |
    { kind: "main", iid: "", target: $main, url: ($url + $b.pipeline.path), source: $main,
      head: $b.sha, base: "", start: "", pipeline: ($b.pipeline.id // ""), purl: ($url + $b.pipeline.path),
      extra: $b.sha, verb_key: "pipeline", mark: false,
      tail: (faint + since($b.at | at) + r + context + "  " + $b.sha[0:8] + "  " + ($b.title | clean) + r),
      title: $b.title, when: since($b.at | at) };
  def main_run_rows:
    ($mainb[0] // [])[0:5][] | select(.author == $me and .pipeline != null) |
    (.pipeline | effective($gates)) as $p | select($p | IN("RUNNING", "PENDING", "CREATED")) |
    (.pipeline.jobs.nodes // []) as $jobs | ([$jobs[] | select(.status == "SUCCESS")] | length) as $done |
    (if $p == "RUNNING" then { g: "◐", verb: "\($main) build running" | fit(21) } else { g: "○", verb: "\($main) build queued" | fit(21) } end)
    + main_fields
    + { rank: (0 - (.at | at)), gc: attention, id: "g-main-\(.sha)",
        prog: (if ($jobs | length) > 0 then "\($done)/\($jobs | length)" else "" end) };
  # Main broken by a push of yours: its newest finished build failed.
  def main_failed_rows:
    ([($mainb[0] // [])[] | select(.pipeline != null) | select(.pipeline | effective($gates) | IN("SUCCESS", "FAILED", "APPROVAL"))][0] // null) as $b |
    if $b != null and $b.author == $me and ($b.pipeline | effective($gates)) == "FAILED" then
      $b | { rank: 5, g: "✗", gc: bad, verb: "\($main) build failed" | fit(21), id: "w-main-\(.sha)" } + main_fields
    else empty end;

  # Yours that have merged and are not out yet: where each has got to on its
  # way to production. Nothing here wants you; it is the answer to whether your
  # change has shipped, which until now the dashboard could not give at all.
  def shipping_rows:
    $merged_mrs[] | select($merged_old == "") | select(.state | IN("deploying", "queued", "waiting", "branch")) |
    (if .state == "deploying" then { g: "◐", gc: attention, verb: "deploying" }
     elif .state == "queued" then { g: "○", gc: attention, verb: "queued to deploy" }
     elif .state == "branch" then { g: "·", gc: context, verb: "merged, not on main" }
     else { g: "·", gc: context, verb: "merged, not out yet" } end)
    + { rank: (0 - (.mergedAt | at)), kind: "merged", iid: .iid, target: .targetBranch,
        url: .webUrl, source: .sourceBranch, head: "", base: "", start: "",
        pipeline: ((.deploy.pipeline // (.pipeline.id | gid)) // ""), purl: (.deploy.url // .webUrl),
        id: "g-merged-\(.iid)", mark: false, extra: "", verb_key: "mr",
        tail: (faint + "merged " + since(.mergedAt | at) + " ago" + r
               + context + "  " + (.title | clean) + r),
        title: .title, when: since(.mergedAt | at) };

  # A production deploy on its way, and what it is carrying. Only while it is
  # carrying none of yours: when it has yours in it, their own rows above say
  # so, with the change each one is, which is what you wanted to know.
  def deploy_rows:
    if any($merged_mrs[]; .state | IN("deploying", "queued")) then empty else
    # Not one a finished deploy started after: GitLab leaves a deploy job
    # created and never run when a later pipeline deploys first, and that
    # one is not on its way anywhere. (The at of a finished deploy is when it
    # ended; started is when it began.)
    ([$deploys[] | select(.status | IN("success", "failed", "canceled")) | (.started // .at) | at] | max // 0) as $done |
    [$deploys[] | select(.status | IN("running", "created", "pending")) | select((.at | at) > $done)][0:1][] |
    { rank: (0 - (.at | at)), g: "◐", gc: attention,
      verb: (if .kind == "rollback" then "rolling production back" | fit(21) else "deploying" end),
      kind: "deploy", pipeline: (.pipeline | tostring), purl: .url, verb_key: "deploy",
      extra: (.id | tostring),
      id: "g-deploy-\(.pipeline)", mark: false,
      tail: (faint + since(.at | at) + r + context + "  "
            + (if (.mrs | length) > 0 then (.mrs | map("!" + .) | join(" ")) else "no merge requests" end) + r),
      # How many it carries: which ones is said under the board, where
      # there is room for them, not in three lines of numbers on its row.
      title: "carrying \(.mrs | length) \(plural(.mrs | length; "merge request"; "merge requests"))",
      when: since(.at | at) }
    end;

  # Where you are. Always drawn, so the dashboard is never an empty screen.
  def here_row:
    ($mine_mrs + $asked_all | map(select(.sourceBranch == $here.branch)) | .[0]) as $mr |
    ([ (if $here.dirty > 0 then "\($here.dirty) uncommitted" else empty end),
       (if $here.unpushed > 0 then "\($here.unpushed) unpushed" else empty end),
       (if $here.ahead > $here.unpushed then "\($here.ahead) past \($base)" else empty end),
       (if $here.behind > 0 then "\($here.behind) behind \($base)" else empty end) ]) as $bits |
    { kind: "here", rank: 0, g: "", gc: context, mark: true, id: "here",
      verb: (if $here.branch == "" then "detached at \($here.sha)" else $here.branch | fit(21) end),
      iid: ($mr.iid // ""), target: ($mr.targetBranch // ""), url: ($mr.webUrl // ""),
      source: $here.branch, head: ($mr.diffRefs.headSha // ""), base: ($mr.diffRefs.baseSha // ""),
      start: ($mr.diffRefs.startSha // ""),
      extra: $here.branch, verb_key: "here",
      does: (if $here.dirty > 0 then "stage it" elif $here.ahead > 0 then "read the branch" else "" end),
      tail: ((if ($bits | length) > 0 then yours + ($bits | join(context + " · " + yours)) + r
             else good + "nothing to commit or push" + r end)
           ),
      title: ($mr.title // ""), note: ($bits | join(" · ")) };

  ([ ($merged_mrs[] | merged_row), loose_fix_rows, branch_verify_rows, thread_rows, failed_rows, main_failed_rows ]
    | sort_by(.rank)) as $waiting |
  # Worktrees otis moved to the trash and you have not emptied yet. Not
  # waiting on you and not going: it sits under here, with the rest of what
  # this checkout is carrying, and only when there is something in it.
  def trash_row:
    ($trash | split("\n") | map(select(. != "")) | map(split("\t"))) as $t |
    if ($t | length) == 0 then empty
    else
      { kind: "trash", rank: 1, g: "\uf1f8", gc: context, mark: false, id: "trash",
        verb: "\($t | length) in the trash", verb_key: "trash",
        extra: ($t[0][1] | sub("/[^/]*$"; "")),
        tail: (context + plural($t | length; "a worktree you removed, "; "worktrees you removed, oldest ")
               + since($t | map(.[0] | tonumber) | min) + " ago" + r),
        title: plural($t | length; "a worktree you removed"; "worktrees you removed"),
        when: since($t | map(.[0] | tonumber) | min) }
    end;

  # Production last: runs and pipelines are still yours to watch, while a
  # deploy is the end of the line, whenever it started.
  (([ ($runs[] | select(.state == "running") | run_row), main_run_rows ] | sort_by(.rank))
   + ([ shipping_rows, deploy_rows ] | sort_by(.rank))) as $going |

  ($marks | tojson),
  (if ($waiting | length) > 0 then sep("waiting on you"; "sep-waiting"), ($waiting[] | render) else empty end),
  (if ($going | length) > 0 then sep("going"; "sep-going"), ($going[] | render) else empty end),
  sep("here"; "sep-here"), (here_row | render), (trash_row | render),
  "\($waiting | length)\t\($going | length)"')
nl='
'
printf '%s\n' "${out%%"$nl"*}" > "$st/marks.json"
rows=${out#*"$nl"}
counts=${rows##*"$nl"}
rows=${rows%"$nl"*}
printf '%s\n' "$rows"

# The footer is where the count lives, so an empty morning is an empty list
# rather than a row saying there is nothing.
w=${counts%%	*} g=${counts#*	}
{
  if [ "$w" -eq 0 ]; then printf "${GK_GOOD}nothing waiting on you${GK_R}"
  elif [ "$w" -eq 1 ]; then printf "${GK_YOURS}1 thing waiting on you${GK_R}"
  else printf "${GK_YOURS}%s things waiting on you${GK_R}" "$w"
  fi
  [ "$g" -gt 0 ] && printf "${GK_CONTEXT} · %s going${GK_R}" "$g"
  [ -n "$note" ] && printf "${GK_CONTEXT} · %s${GK_R}" "$note"
  printf '\n'
} > "$st/footer"
# The commits of the MRs here, fetched ahead, so enter on one opens it
# without the network (git-mr-prefetch), as gmr's list does.
[ -s "$st/mrs.json" ] && git-mr-prefetch "$st/mrs.json" "$st/ci.json" </dev/null >/dev/null 2>&1 &
# Walks of MRs you have approved, or that merged, stopped (git-walk --settle),
# from the same lists.
git-walk --settle "$st/mrs.json" "$st/ci.json" </dev/null >/dev/null 2>&1 &
# Your local main kept up with origin's, as lazygit does (git-main-forward).
git-main-forward </dev/null >/dev/null 2>&1 &
exit 0
