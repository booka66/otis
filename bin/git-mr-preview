#!/bin/sh
# git-mr-preview <iid> <kind> [row id]: a gmr row at a glance, from the JSON
# git-mr-list saved, so moving through the list never waits on GitLab. Yours and
# merged ones show what gci did (git-ci-preview): approvals, threads, reviewers,
# labels and the pipeline, or where a merged one is on its way to production.
# One to review shows its summary and description. Open ones end with their
# unresolved threads on the MR itself (git-mr-threads), which no file shows.
#
# A section heading gets the section: what is in it, and which of it is waiting
# on you. The row is a heading rather than an MR, so without this the pane would
# just be empty while the cursor passed over it.
iid=$1 kind=$2 row=$3
st=$GIT_FZF_STATE
share=$(cd "$(dirname "$0")/../share" && pwd)
. "$share/palette.sh"

if [ "$kind" = sep ]; then
  case $row in
    sep-to-review|sep-reviewed*) src=$st/mrs.json ;;
    sep-yours)                   src=$st/ci.json ;;
    sep-merged*)                 src=$st/ci-merged.json ;;
    *) exit 0 ;;
  esac
  [ -s "$src" ] || exit 0
  # Claude's marks and the gate jobs, as git-mr-list worked them out for this draw.
  [ -s "$st/marks.json" ] || echo '{"gates": [], "watch": {}, "claude": {}, "fixes": {}, "verify": {}}' > "$st/marks.json"
  # In the previews' three parts (share/pane.sh), drawn here in jq: what
  # the section holds, split into bars by how each stands, oldest first
  # with a word on each, and what Claude is doing and has left on them.
  jq -r -L "$share" --arg row "$row" --argjson w "${FZF_PREVIEW_COLUMNS:-80}" --slurpfile marks "$st/marks.json" '
    include "otis";
    $marks[0] as {gates: $gates, watch: $watch, claude: $claude, fixes: $fixes, verify: $verify} |
    def days: (now - (sub("\\.[0-9]+"; "") | fromdateiso8601)) / 86400 | floor;
    def age: (now - (sub("\\.[0-9]+"; "") | fromdateiso8601)) as $s |
      if $s < 3600 then "\($s / 60 | floor)m" elif $s < 86400 then "\($s / 3600 | floor)h" else "\($s / 86400 | floor)d" end;
    def cut($n): if length > $n then .[0:$n - 1] + "…" else . end;
    def rep($n): if $n > 0 then [range($n)] | map("━") | join("") else "" end;
    def spaces($n): if $n > 0 then [range($n)] | map(" ") | join("") else "" end;
    def cap: ascii_upcase;
    ([$w - 1, 20] | max) as $pw |
    def section($name): "", context + ($name | cap) + r, "";
    def head($name; $n; $noun; $color):
      context + ($name | cap) + r + "  " + $color + "\($n) \(plural($n; $noun; $noun + "s"))" + r, "";
    # A category as a bar of the whole: its label, the bar, the count.
    def split($rows; $total):
      ([$pw - 30, 36] | min) as $bw |
      $rows[] | select(.n > 0) |
      (if $total > 0 then ([(.n * $bw / $total + 0.5 | floor), 1] | max) else 0 end) as $k |
      "  " + context + (.what | cut(22)) + spaces(22 - (.what | cut(22) | length)) + r + " "
        + .color + rep($k) + r + spaces($bw - $k) + "  " + .color + (.n | tostring) + r;
    # A merge request a line: its glyph, id, title, and a word, the word right.
    def mr_line($glyph; $word; $wcolor):
      ($word | length) as $wl |
      ($pw - 12 - $wl) as $tw |
      "  " + $glyph + " " + attention + "!\(.iid)" + r + " "
        + text + ((.title // "") | cut($tw)) + r
        + spaces($tw - ((.title // "") | cut($tw) | length) + 1) + $wcolor + $word + r;
    def oldest($these; $when; glyph; word):
      if ($these | length) > 0 then
        section("oldest first"),
        ($these | sort_by(.[$when] // "") | .[0:5][] | (glyph) as $g | (word) as $wd | mr_line($g; $wd[0]; $wd[1])),
        (if ($these | length) > 5 then "  " + faint + "+ \(($these | length) - 5) more" + r else empty end)
      else empty end;
    # Claude on them: a merge request a line, with what is most pressing
    # on it, five at most.
    def claude_lines($these; $kind):
      [ $these[] |
        ($claude[.iid] // {}) as $cl | ($fixes[.iid] // {}) as $fx | ($verify[.iid] // {}) as $vf |
        ($vf.status == "done" and $vf.verdict != "" and $vf.head == .diffRefs.headSha) as $verified |
        (if ($cl.drafts // 0) > 0 then [yours + "✎", "\($cl.drafts) \(plural($cl.drafts; "draft"; "drafts")) to read", yours]
         elif $kind == "mine" and ($fx.fixes // 0) > 0 and ($fx.fixing | not) then [yours + "✎", "\($fx.fixes) \(plural($fx.fixes; "fix"; "fixes")) to fold in", yours]
         elif $verified and $vf.verdict == "fail" then [bad + "●", "verified: failed", bad]
         elif $cl.reviewing then [attention + "◐", "reviewing", attention]
         elif $kind == "mine" and $fx.fixing then [attention + "◐", "fixing", attention]
         elif $vf.verifying then [attention + "◎", "verifying", attention]
         elif $verified then [(if $vf.verdict == "pass" then good else context end) + "●", "verified: " + (if $vf.verdict == "pass" then "passed" else $vf.verdict end), (if $vf.verdict == "pass" then good else context end)]
         elif $cl.clean != null and $cl.clean == .diffRefs.headSha then [good + "⇢", "nothing to say", good]
         else empty end) as $s |
        mr_line($s[0] + r; $s[1]; $s[2]) ] as $l |
      if ($l | length) > 0 then section("claude"), $l[0:5][],
        (if ($l | length) > 5 then "  " + faint + "+ \(($l | length) - 5) more" + r else empty end)
      else empty end;
    def threads($these): ([$these[] | (.resolvableDiscussionsCount // 0) - (.resolvedDiscussionsCount // 0)] | add // 0);

    (.data.currentUser.username // "") as $me |
    if $row == "sep-merged-this-week" then
      (.mrs // []) as $all | ($all | length) as $n |
      head("merged this week"; $n; "merge request"; text),
      split([
        {what: "live in production", n: ([$all[] | select(.state == "live")] | length), color: good},
        {what: "deploying now", n: ([$all[] | select(.state == "deploying")] | length), color: attention},
        {what: "queued behind a deploy", n: ([$all[] | select(.state == "queued")] | length), color: attention},
        {what: "rolled back", n: ([$all[] | select(.state == "rolledback")] | length), color: bad},
        {what: "merged, not out yet", n: ([$all[] | select(.state == "merged")] | length), color: elsewhere}]; $n),
      oldest($all; "mergedAt";
        (if .state == "live" then good + "▲" elif .state == "rolledback" then bad + "▼" elif .state | IN("deploying", "queued") then attention + "◐" else elsewhere + "·" end) + r;
        (if .state == "live" then ["live", good] elif .state == "rolledback" then ["rolled back", bad]
         elif .state == "deploying" then ["deploying", attention] elif .state == "queued" then ["queued", attention]
         else ["not out yet", elsewhere] end)),
      ([$all[] | select($watch[.iid].verdict | IN("likely", "possible"))] as $bad |
       ([$all[] | select($watch[.iid].watching)] | length) as $wn |
       if ($bad | length) > 0 or $wn > 0 then
         section("claude"),
         ($bad[0:5][] | mr_line(yours + "⚠" + r; "watch: " + $watch[.iid].verdict; yours)),
         (if ($bad | length) > 5 then "  " + faint + "+ \(($bad | length) - 5) more" + r else empty end),
         (if $wn > 0 then "  " + attention + "◐ " + r + context + "watching production for \($wn) of them" + r else empty end)
       else empty end)

    elif $row == "sep-yours" then
      (.data.currentUser.authoredMergeRequests.nodes // []) as $all | ($all | length) as $n |
      def waits: (.headPipeline | effective($gates)) == "FAILED" or ((.draft | not) and (.reviewers.nodes | length) == 0) or (($fixes[.iid].fixes // 0) > 0);
      head("yours"; $n; "open merge request"; (if ([$all[] | select(waits)] | length) > 0 then yours else text end)),
      split([
        {what: "approved", n: ([$all[] | select(.approved)] | length), color: good},
        {what: "need approvals", n: ([$all[] | select((.approved | not) and ((.approvalsLeft // 0) > 0))] | length), color: context},
        {what: "nobody asked to review", n: ([$all[] | select((.draft | not) and (.reviewers.nodes | length) == 0)] | length), color: attention},
        {what: "failing pipeline", n: ([$all[] | select((.headPipeline | effective($gates)) == "FAILED")] | length), color: bad},
        {what: "only approval gates", n: ([$all[] | select((.headPipeline | effective($gates)) == "APPROVAL")] | length), color: elsewhere},
        {what: "still a draft", n: ([$all[] | select(.draft)] | length), color: context},
        {what: "merge when green", n: ([$all[] | select(.autoMergeEnabled)] | length), color: good}]; $n),
      (threads($all) as $t | if $t > 0 then "", "  " + yours + "\($t) unresolved " + plural($t; "thread"; "threads") + r + context + " across them" + r else empty end),
      oldest($all; "updatedAt";
        (if (.headPipeline | effective($gates)) == "FAILED" then bad + "✗" elif .approved then good + "✓" elif waits then yours + "!" else faint + "·" end) + r;
        (if (.headPipeline | effective($gates)) == "FAILED" then ["pipeline failed", bad]
         elif .autoMergeEnabled then ["merges when green", good]
         elif .approved then ["approved", good]
         elif .draft then ["draft", context]
         elif (.reviewers.nodes | length) == 0 then ["nobody asked", attention]
         else [(.updatedAt | age) + " quiet", context] end)),
      claude_lines($all; "mine")

    else
      (.data.currentUser.reviewRequestedMergeRequests.nodes // []) as $all |
      def mine_state: [.reviewers.nodes[]? | select(.username == $me) | .mergeRequestInteraction.reviewState][0] // "UNREVIEWED";
      ($all | map(select(mine_state | IN("APPROVED", "REVIEWED", "REQUESTED_CHANGES") | not))) as $todo |
      ($all | map(select(mine_state | IN("APPROVED", "REVIEWED", "REQUESTED_CHANGES")))) as $done |
      ($row == "sep-to-review") as $to |
      (if $to then $todo else $done end) as $these | ($these | length) as $n |
      head(if $to then "to review" else "reviewed, waiting on them" end; $n; "merge request"; (if $to and $n > 0 then yours else text end)),
      split([
        {what: "waiting on you", n: ($todo | length), color: yours},
        {what: "reviewed", n: ($done | length), color: faint}]; ($all | length)),
      (if ([$these[] | select(.headPipeline.status == "FAILED")] | length) as $f | $f > 0 then "  " + context + "of these, " + r + bad + "\([$these[] | select(.headPipeline.status == "FAILED")] | length) with a failing pipeline" + r else empty end),
      (if ([$these[] | select(.headPipeline.status == null)] | length) as $f | $f > 0 then "  " + context + "of these, \([$these[] | select(.headPipeline.status == null)] | length) with no pipeline yet" + r else empty end),
      (threads($these) as $t | if $t > 0 then "  " + context + "of these, " + r + yours + "\($t) unresolved " + plural($t; "thread"; "threads") + r else empty end),
      oldest($these; "updatedAt";
        (if .headPipeline.status == "FAILED" then bad + "✗" elif $to then yours + "!" else faint + "·" end) + r;
        (.updatedAt | days) as $d |
        (if .headPipeline.status == "FAILED" then ["pipeline failed", bad]
         elif $to then [(.updatedAt | age) + " waiting", (if $d > 0 then yours else context end)]
         else [(.updatedAt | age) + " quiet", context] end)),
      claude_lines($these; "review")
    end' "$src" 2>/dev/null
  exit 0
fi

[ -n "$iid" ] || exit 0
# An open one is drawn as the dashboard draws it (otis-preview): the
# pipeline as a bar a stage, the threads, where the review stands. Only
# when it is in the JSON that preview reads; one listed from every open MR
# (f) may not be.
case $kind in
  mine|review)
    if jq -e --arg iid "$iid" '[.data.currentUser.authoredMergeRequests.nodes[]?, .data.currentUser.reviewRequestedMergeRequests.nodes[]? | select(.iid == $iid)] | length > 0' \
        "$st/ci.json" "$st/mrs.json" 2>/dev/null | grep -q true; then
      exec otis-preview "$kind" "$iid" "" ""
    fi ;;
esac
[ "$kind" = merged ] && exec git-ci-preview --merged "$iid"
# One from every open MR (f), not in the JSON the dashboard's preview reads:
# the MR, a line a fact, its description's opening lines, its threads.
mr='first((.data.currentUser.reviewRequestedMergeRequests, .data.project.mergeRequests) | .nodes[]? | select(.iid == $iid))'
jq -r -L "$share" --arg iid "$iid" --argjson w "$(( ${FZF_PREVIEW_COLUMNS:-80} - 1 ))" '
  include "otis";
  def cut($n): if length > $n then .[0:$n - 1] + "…" else . end;
  '"$mr"' | (.iid | length) as $il |
  attention + "\u001b[1m!\(.iid)" + r + "  " + text + (.title | cut($w - $il - 3)) + r,
  context + ("\(.author.username)  ·  \(.sourceBranch) → \(.targetBranch)" | cut($w)) + r,
  context + ("\(.detailedMergeStatus | ascii_downcase | gsub("_"; " "))  ·  updated \(.updatedAt | ago) ago" | cut($w)) + r
' "$st/mrs.json"
git-verify --preview "$iid"
desc=$(jq -r --arg iid "$iid" "$mr"' | .description // ""' "$st/mrs.json" |
  glow -s "${OTIS_T_GLOW:-dark}" -w "${FZF_PREVIEW_COLUMNS:-100}" - 2>/dev/null | perl -ne 'my $p = $_; $p =~ s/\e\[[0-9;]*m//g; print if $p =~ /\S/')
if [ -n "$desc" ]; then
  # Its opening lines, not the whole of it: the rest is in the MR.
  printf "\n${GK_CONTEXT}DESCRIPTION${GK_R}\n\n"
  printf '%s\n' "$desc" | head -5
  more=$(printf '%s\n' "$desc" | sed 1,5d | grep -c .)
  [ "$more" -gt 0 ] && printf "${GK_FAINT}  + %s more lines: w opens the MR${GK_R}\n" "$more"
fi
git-mr-threads --overview "$iid"
