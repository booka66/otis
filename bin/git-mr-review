#!/bin/sh
# git-mr-review [--claude] <iid> <target branch> <url> <source branch> [head sha] [base sha] [start sha]
# Review an MR without touching your own worktree. One reusable worktree,
# .claude/worktrees/review under the main checkout, is moved to the MR's head;
# moving it only rewrites the files that differ, where a fresh worktree per MR
# would check out the whole repo each time. The MR's commits come from its head
# ref (git-forge head-ref), which also covers forks.
#
# Fast by doing only what the picker needs before it opens. gmr passes the
# MR's head and base as GitLab reports them, and prefetches the commits
# (git-mr-prefetch), so usually nothing is fetched here at all. The file list
# and previews read commits, not the worktree, so the worktree moves in the
# background while the picker is already up; git-mr-wait holds nvim for the
# moment it takes, if you are quicker. Edits left in the worktree are asked
# about first, since that cannot wait.
#
# Then the MR's file picker (git-mr-files) in the review worktree, so nvim
# opens the MR's version of each file. The worktree is always detached at the
# MR's head: nothing of yours is ever checked out or moved.
#
# --ready <iid> <head> <base> <start> moves the worktree to the MR the same
# way and no more, as P's screen opens (git-walk --view); --open <iid> <head>
# <base> <start> <path> <line>, enter there, then only opens that line in it,
# moving it first only when it is at another head and not on its way.
#
# --claude (gmr's C) has Claude review it instead (git-mr-claude), straight
# from the list: the same commits, no worktree, since Claude takes its own.
claude= open= ready=
[ "$1" = --claude ] && { claude=1; shift; }
if [ "$1" = --open ]; then
  open=1 iid=$2 head=$3 base=$4 start=$5 path=$6 line=$7 target=$(otis-config main)
elif [ "$1" = --ready ]; then
  ready=1 iid=$2 head=$3 base=$4 start=$5 target=$(otis-config main)
else
  iid=$1 target=${2:-$(otis-config main)} url=$3 head=$5 base=$6 start=$7
fi
[ -n "$iid" ] || exit 0

pause() { otis-popup say "$1"; }
have() { [ -n "$1" ] && git cat-file -e "$1^{commit}" 2>/dev/null; }

dir=$(git-worktree-path named review)
mr="refs/mr/$iid"
common=$(git rev-parse --git-common-dir)
# The branch an older gmr created for a review, and the commit it left it on:
# deleted below if it is still there, untouched.
record="$common/gmr-review-branch"
moving="$common/gmr-review-moving"

# open_it: the line, in the worktree, as the file picker's enter opens it:
# the review's diff base (what merging would change now, git-mr-base) and
# its comments; nvim waits on a move still going (git-mr-wait).
open_it() {
  cd "$dir" || exit 1
  [ -n "$start" ] || start=$(git rev-parse -q --verify "origin/$target")
  base=$(git-mr-base "$base" "$head" "$start")
  export NVIM_DIFF_BASE=$base GMR_IID=$iid GMR_RANGE=$base..$head GMR_KIND=review GMR_MOVING=$moving
  exec git-commit-open "$base..$head" "$path" "$line"
}
[ -n "$open" ] && { [ "$(git -C "$dir" rev-parse -q --verify HEAD 2>/dev/null)" = "$head" ] || [ -s "$moving" ]; } && open_it

if have "$head" && have "$base" && { [ -z "$start" ] || have "$start"; }; then
  git update-ref "$mr" "$head"
else
  printf 'fetching !%s ...\n' "$iid"
  GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND='ssh -o BatchMode=yes' git fetch --quiet --no-tags origin "+$(git-forge head-ref "$iid"):$mr" \
    "+refs/heads/$target:refs/remotes/origin/$target" || { pause "fetch failed"; exit 1; }
  head=$(git rev-parse "$mr")
  base=$(git merge-base "origin/$target" "$mr") || { pause "no merge base with origin/$target"; exit 1; }
fi

if [ -n "$claude" ]; then
  [ -n "$start" ] || start=$(git rev-parse -q --verify "origin/$target")
  exec git-mr-claude "$iid" "$(git-mr-base "$base" "$head" "$start")..$head"
fi

# A move still running from the MR before has to land before this one starts.
GMR_MOVING=$moving git-mr-wait quiet

if [ ! -e "$dir" ]; then
  printf 'creating the review worktree, first time only ...\n'
  git-worktree-add review --quiet --detach "$mr" || { pause "could not create $dir"; exit 1; }
else
  # Only ever reset a registered worktree at this exact path.
  git worktree list --porcelain | grep -qxF "worktree $dir" ||
    { pause "$dir exists but is not a git worktree, so it was left alone"; exit 1; }
  if [ -n "$(git -C "$dir" status --porcelain)" ]; then
    git-confirm "the review worktree has edits:
$(git -C "$dir" status --short | head -20)

discard them and continue?" || exit 0
    git -C "$dir" reset --quiet --hard && git -C "$dir" clean -fdq
  fi
fi

# The move, in the background. $moving holds its pid while it runs, and
# $moving.err its error if it failed; git-mr-wait reads both.
rm -f "$moving.err"
(
  git -C "$dir" switch --quiet --detach "$mr" 2> "$moving.err" || { rm -f "$moving"; exit 1; }
  # Reviews used to check out a branch named for the MR, for gitlab.nvim.
  # One still here and where gmr left it goes, once nothing has it checked out.
  if [ -r "$record" ] && read -r prev prevsha < "$record" && [ -n "$prev" ] &&
    [ "$(git rev-parse -q --verify "refs/heads/$prev")" = "$prevsha" ] &&
    ! git worktree list --porcelain | grep -qxF "branch refs/heads/$prev"; then
    git branch -q -D "$prev"
  fi
  rm -f "$record" "$moving" "$moving.err"
) </dev/null >/dev/null 2>&1 &
echo $! > "$moving"
[ -n "$ready" ] && exit 0
[ -n "$open" ] && open_it

cd "$dir" || exit 1
# The diff shows what merging would change now, not what GitLab's merge base
# says, when the target already has part of this branch (git-mr-base).
[ -n "$start" ] || start=$(git rev-parse -q --verify "origin/$target")
base=$(git-mr-base "$base" "$head" "$start")
GMR_MOVING=$moving exec git-mr-files "$iid" "$base..$head" "$url" review
