#!/bin/sh
# git-mr-review [--claude] <iid> <target branch> <url> <source branch> [head sha] [base sha] [start sha]
# Review an MR without touching your own worktree. One reusable worktree,
# .claude/worktrees/review under the main checkout, is moved to the MR's head;
# moving it only rewrites the files that differ, where a fresh worktree per MR
# would check out the whole repo each time. The MR's commits come from GitLab's
# refs/merge-requests/<iid>/head, which also covers forks.
#
# Fast by doing only what the picker needs before it opens. gmr passes the
# MR's head and base as GitLab reports them, and prefetches the commits
# (git-mr-prefetch), so usually nothing is fetched here at all. The file list
# and previews read commits, not the worktree, so the worktree moves in the
# background while the picker is already up; git-mr-wait holds nvim (and
# gitlab.nvim) for the moment it takes, if you are quicker. Edits left in the
# worktree are asked about first, since that cannot wait.
#
# Then the MR's file picker (git-mr-files) in the review worktree, so nvim
# opens the MR's version of each file. Its r opens gitlab.nvim there
# (git-mr-comment), which finds the MR by the checked-out branch.
#
# --claude (gmr's C) has Claude review it instead (git-mr-claude), straight
# from the list: the same commits, no worktree, since Claude takes its own.
claude=
[ "$1" = --claude ] && { claude=1; shift; }
iid=$1 target=${2:-$(otis-config main)} url=$3 source=$4 head=$5 base=$6 start=$7
[ -n "$iid" ] || exit 0

pause() { printf '%s. press enter\n' "$1"; read -r _; }
have() { [ -n "$1" ] && git cat-file -e "$1^{commit}" 2>/dev/null; }

dir=$(git-worktree-path named review)
mr="refs/mr/$iid"
common=$(git rev-parse --git-common-dir)
# The branch gmr last created for a review, and the commit it left it on. Only a
# branch recorded here, and still on that commit, is ever moved or deleted.
record="$common/gmr-review-branch"
moving="$common/gmr-review-moving"

if have "$head" && have "$base" && { [ -z "$start" ] || have "$start"; }; then
  git update-ref "$mr" "$head"
else
  printf 'fetching !%s ...\n' "$iid"
  GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND='ssh -o BatchMode=yes' git fetch --quiet --no-tags origin "+refs/merge-requests/$iid/head:$mr" \
    "+refs/heads/$target:refs/remotes/origin/$target" || { pause "fetch failed"; exit 1; }
  head=$(git rev-parse "$mr")
  base=$(git merge-base "origin/$target" "$mr") || { pause "no merge base with origin/$target"; exit 1; }
fi

if [ -n "$claude" ]; then
  [ -n "$start" ] || start=$(git rev-parse -q --verify "origin/$target")
  exec git-mr-claude "$iid" "$(git-mr-base "$base" "$head" "$start")..$head"
fi

# A move still running from the MR before has to land before this one starts.
GMR_MOVING=$moving git-mr-wait quiet

if [ ! -e "$dir" ]; then
  printf 'creating the review worktree, first time only ...\n'
  git-worktree-add review --quiet --detach "$mr" || { pause "could not create $dir"; exit 1; }
else
  # Only ever reset a registered worktree at this exact path.
  git worktree list --porcelain | grep -qxF "worktree $dir" ||
    { pause "$dir exists but is not a git worktree, so it was left alone"; exit 1; }
  if [ -n "$(git -C "$dir" status --porcelain)" ]; then
    printf 'the review worktree has edits:\n'
    git -C "$dir" status --short | head -20
    git-confirm "discard them and continue?" || exit 0
    git -C "$dir" reset --quiet --hard && git -C "$dir" clean -fdq
  fi
fi

# The move, in the background. $moving holds its pid while it runs, and
# $moving.err its error if it failed; git-mr-wait reads both.
rm -f "$moving.err"
(
  checked_out() { git worktree list --porcelain | grep -qxF "branch refs/heads/$1"; }
  prev='' prevsha=''
  [ -r "$record" ] && read -r prev prevsha < "$record"
  # How to put the worktree on this MR:
  #   create    no local branch by that name, so make one (gitlab.nvim can review)
  #   reuse     gmr made it last time and nothing has moved it since
  #   detached  a branch of yours by that name exists; never touch it
  mode=detached
  if [ -n "$source" ]; then
    if ! git show-ref --verify --quiet "refs/heads/$source"; then
      mode=create
    elif [ "$source" = "$prev" ] && [ "$(git rev-parse "refs/heads/$source")" = "$prevsha" ]; then
      mode=reuse
    fi
  fi
  # One checkout: straight onto the branch when gmr may own it, else detached.
  if { [ "$mode" = create ] || [ "$mode" = reuse ]; } && git -C "$dir" switch --quiet -C "$source" "$mr" 2>/dev/null; then
    printf '%s %s\n' "$source" "$head" > "$record.new"
  else
    git -C "$dir" switch --quiet --detach "$mr" 2> "$moving.err" || { rm -f "$moving"; exit 1; }
    : > "$record.new"
  fi
  # The previous review's branch is free to go once nothing has it checked out.
  if [ -n "$prev" ] && [ "$prev" != "$source" ] &&
    [ "$(git rev-parse -q --verify "refs/heads/$prev")" = "$prevsha" ] && ! checked_out "$prev"; then
    git branch -q -D "$prev"
  fi
  mv "$record.new" "$record"
  [ -s "$record" ] || rm -f "$record"
  rm -f "$moving" "$moving.err"
  # Same-project MRs also have the branch on origin, which gitlab.nvim compares
  # against; a fork's does not, and that is fine. Nothing waits on this.
  # The branch is named: by now the next review may have the worktree on its own.
  if [ -s "$record" ] && git fetch --quiet --no-tags origin "+refs/heads/$source:refs/remotes/origin/$source" 2>/dev/null; then
    git branch --quiet --set-upstream-to="origin/$source" "$source" 2>/dev/null
  fi
) </dev/null >/dev/null 2>&1 &
echo $! > "$moving"

cd "$dir" || exit 1
# The diff shows what merging would change now, not what GitLab's merge base
# says, when the target already has part of this branch (git-mr-base).
[ -n "$start" ] || start=$(git rev-parse -q --verify "origin/$target")
base=$(git-mr-base "$base" "$head" "$start")
GMR_MOVING=$moving exec git-mr-files "$iid" "$base..$head" "$url" review
