#!/bin/sh
# otis-preview <kind> <iid> <row id> <extra> [<light>]: the dashboard's
# preview pane, and what space reads in a pager.
#
# A change (a merge request, or a branch with none) is drawn here, a gate
# of the board (otis-board) at a time: what the change is in a line, how
# each of its gates stands in words with this one lit (OTIS_STATES, which
# otis-dash writes), then only what that gate has to say: local (the branch,
# as gb previews it), verify (git-verify's account), pipeline, review, ship.
# The gate "all", and an open merge request with no gate named, is its title
# and every one of them in turn under its name: there is one account of a
# merge request, said in parts or whole.
# Everything about the MR comes from the JSON otis-list left in the state, so
# moving never waits on GitLab.
#
# Any other row hands over to the script that owns it, which says what wants
# you itself (share/pane.sh): one of Claude's runs (git-agent-preview), a
# deploy (git-deploy-preview), a merged MR (git-ci-preview), a worktree
# (git-worktree-preview). A push to main, the here row and the trash are this
# script's own, under a callout.
kind=$1 iid=$2 row=$3 extra=$4 gate=$5
st=$GIT_FZF_STATE
share=$(cd "$(dirname "$0")/../share" && pwd)
. "$share/palette.sh"
w=${FZF_PREVIEW_COLUMNS:-80}

# The row as otis-list drew it: its glyph's color, its verb, what enter does.
IFS='	' read -r gc verb does <<EOF
$(awk -F'\t' -v id="$row" '$11 == id { print $16 "\t" $17 "\t" $24; exit }' "$st/rows" 2>/dev/null)
EOF

# callout <why>: the row's verb in its color, why it wants you, and the key.
callout() {
  # Read from the board (space), there is no row of otis-list's to speak for it.
  [ -n "$verb$1" ] || return 0
  bar="${gc:-$GK_YOURS}┃$GK_R"
  printf '%b %b%s\033[22m%b\n' "$bar" "\033[1m${gc:-$GK_YOURS}" "$verb" "$GK_R"
  [ -n "$1" ] && printf '%b %b%s%b\n' "$bar" "$GK_TEXT" "$1" "$GK_R"
  [ -n "$does" ] && printf '%b %b⏎ %s%b\n' "$bar" "$GK_ATTENTION" "$does" "$GK_R"
  printf '\n'
}
heading() { printf "${GK_CONTEXT}%s${GK_R}\n" "$(printf '%s' "$1" | tr '[:lower:]' '[:upper:]')"; }

# branch_part: the branch as gb previews it, from gb's own row for it, which
# the dashboard keeps (branches.tsv): what wants you there, where it is
# checked out, how it stands against the base, its commits.
branch_part() {
  us=$(printf '\037')
  line=$(awk -F'\t' -v b="$OTIS_BRANCH" -v us="$us" '$2 == b { print $2 us $3 us $6 us $4 us $5 us $7 us $8 us $9; exit }' "$st/branches.tsv" 2>/dev/null)
  if [ -z "$line" ]; then
    printf "${GK_CONTEXT}Not on this machine.${GK_R}\n"
  else
    IFS=$us read -r b bkind place wt biid ahead behind claude <<EOF
$line
EOF
    git-branch-preview "$b" "$bkind" "$place" "$wt" "$biid" "$ahead" "$behind" "$claude" 2>/dev/null
  fi
}
# One light of the board, or all of them in turn (gate all). In a pane a few
# lines high (OTIS_BRIEF) a light says only its own part: no line spent on
# what the change is, or on air.
light() {
  [ -s "$st/marks.json" ] || echo '{"gates": [], "watch": {}, "claude": {}, "fixes": {}, "verify": {}}' > "$st/marks.json"
  threads=/dev/null
  if { [ "$gate" = review ] || [ "$gate" = all ]; } && [ -n "$iid" ]; then
    git-mr-threads --kick "$iid" "" "" >/dev/null 2>&1
    threads=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)/git-alias-cache/mr-$iid-threads.json
    [ -s "$threads" ] || threads=/dev/null
  fi
  jq -nr -L "$share" --arg iid "$iid" --arg gate "$gate" --arg row "$row" --arg states "$OTIS_STATES" --argjson w "$w" \
    --arg brief "$OTIS_BRIEF" \
    --arg main "${OTIS_C_main:-$(otis-config main 2>/dev/null)}" \
    --slurpfile mine "$st/ci.json" --slurpfile asked "$st/mrs.json" --slurpfile marks "$st/marks.json" \
    --slurpfile disc "$threads" '
    include "otis";
    def B: "\u001b[1m"; def UB: "\u001b[22m";
    def dot: context + "  ·  " + r;
    def bar($n; $total; $parts): ([$total, ($parts | map(.[0]) | add)] | max) as $t |
      (reduce $parts[] as $p ({s: "", used: 0};
        (if $p[0] == 0 then 0 else ([(($p[0] * $n / $t) + 0.5 | floor), 1] | max) end) as $k |
        ([$k, $n - .used] | min) as $k |
        .s += (if $k > 0 then $p[1] + ("━" * $k) else "" end) | .used += $k)) as $b |
      $b.s + (if $b.used < $n then faint + ("─" * ($n - $b.used)) else "" end) + r;
    def who: .;
    def joblines($js; $c; $g):
      ($js[0:6][] | $c + $g + r + " " + text + .name + r + (if (.stage.name // "") != "" then context + "  " + .stage.name + r else "" end)),
      (if ($js | length) > 6 then context + "+ \($js | length - 6) more" + r else empty end);

    ($marks[0]) as {gates: $gates, claude: $claude, fixes: $fixes} |
    ($asked[0].data.currentUser.username // $mine[0].data.currentUser.username // "") as $me |
    (($mine[0].data.currentUser.authoredMergeRequests.nodes // []) | map(select(.iid == $iid)) | .[0]) as $m |
    (($asked[0].data.currentUser.reviewRequestedMergeRequests.nodes // []) | map(select(.iid == $iid)) | .[0]) as $a |
    ($m // $a) as $mr |

    # What it is, in a line: its number, whose it is, its size, and what it
    # is built on: the MR under it in a stack by its number, as the board
    # shows that one, else the branch. Its title is on its row, whole, so it
    # is said here only when all of it is read at once (the gate all). A
    # branch with no merge request says that. Then how each of its gates
    # stands, in a line.
    (if $mr then
       (if $gate == "all" then ($mr.title | sub("^(draft:|\\[draft\\]|wip:)\\s*"; ""; "i") | wrapl($w; 9)[] | B + text + . + UB + r) else empty end),
       (($mr.iid | iid(attention))
         + (if $mr.draft then dot + yours + "draft" + r else "" end)
         + (if ($m | not) and $mr.author then dot + context + $mr.author.username + r else "" end)
         + ($mr.diffStatsSummary | if . then dot + good + "+\(.additions)" + r + " " + bad + "−\(.deletions)" + r
              + dot + context + "\(.fileCount) \(plural(.fileCount; "file"; "files"))" + r else "" end)
         + (if $mr.targetBranch != $main then
              (($mine[0].data.currentUser.authoredMergeRequests.nodes // []) + ($asked[0].data.currentUser.reviewRequestedMergeRequests.nodes // [])
               | map(select(.sourceBranch == $mr.targetBranch)) | .[0]) as $under |
              dot + context + "on top of " + (if $under then "!\($under.iid)" else $mr.targetBranch end) + r
            else "" end))
     else
       (if $gate == "all" then (B + elsewhere + ($row | ltrimstr("c-b-")) + UB + r) else empty end),
       (context + "a branch with no merge request yet" + r)
     end),
    (if $states != "" then $states else empty end),
    (if $brief != "" then empty else "" end),

    (select($mr != null) |
     ($mr.headPipeline.jobs.nodes // []) as $jobs |
     [$jobs[] | select(.status == "FAILED" and (.allowFailure | not))] as $failed |
     [$jobs[] | select(.status == "RUNNING")] as $running |
     ([$jobs[] | select(.status == "SUCCESS")] | length) as $done |
     ($claude[$iid] // {}) as $cl | ($fixes[$iid] // {}) as $fx |

     def pipeline_part: (
       ($mr.headPipeline | if . then effective($gates) else null end) as $eff |
       (if $eff == "SUCCESS" then good + "Passed" elif $eff == "FAILED" then bad + "Failed"
        elif $eff == "RUNNING" then attention + "Running" elif $eff == "APPROVAL" then elsewhere + "Waiting on approval gates"
        elif $eff == null then context + "No pipeline yet" else context + ($eff | ascii_downcase) end) as $state |
       $state + r
         + (if ($jobs | length) == 0 then "" elif $done == ($jobs | length) then dot + context + "\($done) jobs" + r
            else dot + context + "\($done) of \($jobs | length) jobs" + r end)
         + (if $mr.headPipeline.createdAt then dot + context + "started \($mr.headPipeline.createdAt | ago) ago" + r else "" end),
       # How far it has got, while it is going.
       (if ($jobs | length) > 0 and ($eff | IN("RUNNING", "PENDING", "CREATED")) then
          bar([$w, 40] | min; ($jobs | length); [[$done, good], [($failed | length), bad], [($running | length), attention]]) else empty end),
       (if ($failed | length) + ($running | length) > 0 then "" else empty end),
       joblines($failed; bad; "✗"), joblines($running; attention; "◐")
     );
     def review_part: (
       (($mr.resolvableDiscussionsCount // 0) - ($mr.resolvedDiscussionsCount // 0)) as $th |
       (if $m then
          (if $mr.approved then good + "Approved" + r
           else ($mr.approvalsLeft // 1) as $n | text + "Needs \($n) more \(plural($n; "approval"; "approvals"))" + r end)
        else
          ([$mr.reviewers.nodes[]? | select(.username == $me) | .mergeRequestInteraction.reviewState][0] // "UNREVIEWED") as $mys |
          (if $mys == "APPROVED" then good + "You approved it" + r
           elif ($mys | IN("REVIEWED", "REQUESTED_CHANGES")) then text + "You reviewed it: \($mr.author.username // "its author") has the next move" + r
           else text + "\($mr.author.username // "Someone") is waiting on your review" + r end)
          + (if $mr.updatedAt then dot + context + "updated \($mr.updatedAt | ago) ago" + r else "" end) end),
       "",
       # Who was asked, a line each; you by that name.
       (($mr.reviewers.nodes // []) | if length == 0 then
          (if $mr.draft then context else attention end) + "Nobody has been asked." + r + context + "  a asks someone" + r
        else .[] | (.mergeRequestInteraction.reviewState // "UNREVIEWED") as $s |
          (if $s == "APPROVED" then good + "✓" elif $s == "REQUESTED_CHANGES" then bad + "✗"
           elif $s == "REVIEWED" then context + "●" elif .username == $me then yours + "○" else context + "○" end) + r + " "
          + text + (if .username == $me then "you" else (.username | who) end) + r
          + (if $s == "REQUESTED_CHANGES" then context + "  wants changes" + r elif $s == "REVIEWED" then context + "  commented" + r else "" end) end),
       # What Claude has on it.
       ([ (if $cl.reviewing then attention + "◌ Claude is reviewing it now" + r else empty end),
          (if ($cl.drafts // 0) > 0 then yours + "✎ \($cl.drafts) draft \(plural($cl.drafts; "comment"; "comments")) to look over" + r else empty end),
          (if $cl.clean != null and $cl.clean == $mr.diffRefs.headSha then good + "✓ Claude found nothing to comment on" + r else empty end),
          (if $fx.fixing then attention + "◌ Claude is proposing fixes now" + r else empty end),
          (if ($fx.fixes // 0) > 0 and ($fx.fixing | not) then yours + "✎ \($fx.fixes) \(plural($fx.fixes; "fix"; "fixes")) to fold in" + r + context + "  ·  f" + r else empty end) ]
        | if length > 0 then "", .[] else empty end),
       # The threads still open: where, what it says first, who.
       ([($disc[0] // [])[] | select(.resolvable and ((.notes | map(select(.resolvable)) | all(.resolved)) | not))] as $open |
        if ($open | length) > 0 then
          ($open[] | .notes[0] as $n | (.notes | last) as $last | ($n.position // {}) as $p |
            (if $p.new_path // $p.old_path then "\($p.new_path // $p.old_path):\($p.new_line // $p.old_line // "")" else "on the MR" end) as $where |
            "",
            yours + "┃" + r + " " + elsewhere + $where + r,
            (($n.body // "") | gsub("<!--[^>]*-->"; "") | gsub("!?\\[(?<t>[^\\]]*)\\]\\([^)]*\\)"; "\(.t)") | gsub("\\*\\*|`"; "") | gsub("\\\\(?<c>[^A-Za-z0-9\\s])"; "\(.c)")
              | split("\n") | map(select(test("\\S")) | gsub("^[#>\\s]+"; "")) | (if length > 1 and (.[0] | test("^[^.]{0,30}$")) then .[1:] else . end) | join(" ")
              # Its first sentences, whole (wrapl never cuts one); that there is more, said rather than trailed off.
              | gsub("\\s+"; " ") as $body | ($body | wrapl($w - 2; 2)) as $ls |
              ($ls[] | yours + "┃" + r + " " + text + . + r),
              (if ($ls | join(" ") | length) < ($body | length) then yours + "┃" + r + " " + context + "and more: ⏎ opens the thread" + r else empty end)),
            (yours + "┃" + r + " " + context + ([($n.author.username | who), ($n.created_at | ago) + " ago",
               (if (.notes | length) > 1 then "\(.notes | length - 1) \(plural(.notes | length - 1; "reply"; "replies"))"
                  + (if $last.author.username == $me then ", yours last" else ", last from \($last.author.username | who)" end) else empty end)]
               | join("  ·  ")) + r))
        elif $th > 0 then "", yours + "\($th) unresolved \(plural($th; "thread"; "threads"))" + r
        else empty end)
     );
     def ship_part: (
       (($mr.detailedMergeStatus // "MERGEABLE") | ascii_upcase) as $ms |
       (if $mr.autoMergeEnabled then good + "Merges itself once approved and green" + r
          + (if $mr.mergeUser then dot + context + "set by \($mr.mergeUser.username)" + r else "" end)
        elif $mr.draft then context + "A draft: not trying to merge yet" + r
        elif ($ms | IN("MERGEABLE", "UNCHECKED", "CHECKING")) then
          (if $mr.approved then good + "Nothing in the way" + r else context + "Nothing in the way but its review" + r end)
        else (if ($ms | IN("CONFLICT", "NEED_REBASE")) then bad else context end)
          + "Not yet: " + ($ms | ascii_downcase | gsub("_"; " ")) + r end),
       (($mr.labels.nodes // []) | if length > 0 then "", context + (map(.title) | join(", ")) + r else empty end)
     );
     def part($t): context + ($t | ascii_upcase) + r;
     if $gate == "pipeline" then pipeline_part
     elif $gate == "review" then review_part
     elif $gate == "ship" then ship_part
     elif $gate == "all" then part("pipeline"), pipeline_part, "", part("review"), review_part, "", part("ship"), ship_part
     else empty end)
  ' 2>/dev/null
  [ "$gate" = local ] && branch_part
  if [ "$gate" = verify ]; then
    key=${extra##*/}
    if [ -z "$extra" ]; then
      printf "${GK_CONTEXT}Not verified yet.  V verifies it.${GK_R}\n"
    else
      # git-verify's own account, less its heading: the lit light says that.
      case $key in
        b-*) git-verify --preview "" "$(printf '%s' "${key#b-}" | tr '%' '/')" 2>/dev/null ;;
        *) git-verify --preview "$key" 2>/dev/null ;;
      esac | perl -ne 'next if $. == 1 && /^\s*$/; s/^(?:\e\[[0-9;]*m)*VERIFICATION(?:\e\[[0-9;]*m)*\s+((?:\e\[[0-9;]*m)*)(\w)/$1\u$2/ if $. <= 2; print'
    fi
    [ -n "$OTIS_FIX" ] && printf "\n${GK_YOURS}✎ %s to fold in${GK_R}${GK_CONTEXT}  ·  f${GK_R}\n" \
      "$(n=${OTIS_FIX#✎}; [ "$n" = 1 ] && echo "1 fix" || echo "$n fixes")"
  fi
  # All of it: after the lights the MR's JSON speaks for, what a
  # verification made of it (by the MR, else by its branch), under
  # git-verify's own heading; what its author says it is, for one to
  # review; and last the branch, whose diff runs on.
  if [ "$gate" = all ]; then
    v=; [ -n "$iid" ] && v=$(git-verify --preview "$iid" 2>/dev/null)
    [ -n "$v" ] || { [ -n "$OTIS_BRANCH" ] && v=$(git-verify --preview "" "$OTIS_BRANCH" 2>/dev/null); }
    [ -n "$v" ] && printf '%s\n' "$v"
    if [ "$kind" = review ]; then
      desc=$(jq -r --arg iid "$iid" '.data.currentUser.reviewRequestedMergeRequests.nodes[]? | select(.iid == $iid) | .description // ""' "$st/mrs.json" 2>/dev/null)
      if [ -n "$desc" ]; then
        printf '\n'; heading "description"
        printf '%s\n' "$desc" | glow -s "${OTIS_T_GLOW:-dark}" -w "$w" - 2>/dev/null | sed '/[^[:space:]]/,$!d' | grep -v '^[[:space:]]*$'
      fi
    fi
    [ -n "$OTIS_BRANCH" ] && { printf '\n'; heading "local"; branch_part; }
  fi
}
if [ -n "$gate" ]; then
  if [ -n "$OTIS_BRIEF" ]; then light | grep -v '^[[:space:]]*$'; else light; fi
  exit 0
fi

case $kind in
  # These say what wants you themselves (share/pane.sh's callout), so
  # nothing is said over them here.
  run) exec git-agent-preview "$extra" ;;
  deploy) exec git-deploy-preview "$extra" ;;
  merged) exec git-ci-preview "$iid" ;;
  place)
    # A worktree, as gw previews it, from gw's own row for it.
    us=$(printf '\037')
    line=$(awk -F'\t' -v p="$extra" -v us="$us" '$2 == p { print $2 us $3 us $4 us $6 us $7 us $8; exit }' "$st/worktrees.tsv" 2>/dev/null)
    [ -n "$line" ] || exit 0
    IFS=$us read -r wtp b bkind biid ahead behind <<EOF
$line
EOF
    exec git-worktree-preview "$wtp" "$b" "$bkind" "$biid" "$ahead" "$behind" ;;
  trash)
    callout "Worktrees otis took out of your way instead of deleting."
    printf "${GK_CONTEXT}So what git would have dropped along with the directory, an .env, a\n"
    printf "local database, a build, is still in there. Its .git went with it, so\n"
    printf "each is a directory of files now and not a worktree: W on the branch in\n"
    printf "gb makes a fresh one, and what you wanted kept is here to copy across.\n"
    printf "Empty it when you are sure.${GK_R}\n\n"
    git-worktree-trash --list | while IFS='	' read -r at dst src branch; do
      was=$src; case $src in "$HOME"/*) was="~${src#"$HOME"}" ;; esac
      printf "${GK_TEXT}%s${GK_R}${GK_CONTEXT}  %s${GK_R}\n" "${dst##*/}" \
        "$(date -r "$at" '+%a %-d %b %H:%M' 2>/dev/null || date -d "@$at" '+%a %-d %b %H:%M' 2>/dev/null)"
      printf "${GK_FAINT}  was %s${GK_R}\n" "$was"
      [ -n "$branch" ] && printf "${GK_FAINT}  on %s${GK_R}\n" "$branch"
    done
    exit 0 ;;
  main)
    # A push to main, and its checks: what failed or runs, one a line.
    callout "A push to main, and what its checks say."
    jq -r -L "$share" --arg sha "$extra" 'include "otis";
      .[] | select(.sha == $sha) |
      attention + .sha[0:8] + r + "  " + text + .title + r,
      context + (.author // "") + " · " + (.at | ago) + " ago" + r, "",
      ((.pipeline.jobs.nodes // []) | sort_by({FAILED: 0, RUNNING: 1, PENDING: 2}[.status] // 3)[] |
        ({FAILED: (bad + "✗"), RUNNING: (attention + "◐"), PENDING: (attention + "○"), SUCCESS: (good + "✓")}[.status] // (context + "·"))
        + r + " " + text + .name + r + context + "  " + .stage.name + r)' "$st/main.json" 2>/dev/null
    exit 0 ;;
  here)
    # The checkout under you, git's own answers rather than a cache: what is
    # uncommitted by what state it is in, then what the branch carries.
    b=$extra base=$(otis-config base)
    status=$(git --no-optional-locks status --porcelain 2>/dev/null)
    ahead=0; [ -n "$b" ] && ahead=$(git rev-list --count "$base..HEAD" 2>/dev/null || echo 0)
    if [ -n "$status" ]; then why="Uncommitted work: enter opens the stage panel to commit it."
    elif [ "$ahead" != 0 ]; then why="Nothing uncommitted. The branch is $ahead past $base."
    else why="Nothing here yet: no changes, nothing past $base."; fi
    # The list cuts the branch to fit its column; here it has the room.
    verb="${b:-detached HEAD}"
    callout "$why"
    [ -z "$b" ] && printf "${GK_ATTENTION}at %s${GK_R}\n\n" "$(git rev-parse --short HEAD 2>/dev/null)"
    [ -n "$iid" ] && printf "${GK_FAINT}!%s${GK_R}${GK_ATTENTION}%s${GK_R}${GK_CONTEXT}  its merge request${GK_R}\n\n" "${iid%???}" "${iid#"${iid%???}"}"
    if [ -n "$status" ]; then
      heading "uncommitted"
      printf '%s\n' "$status" | awk -v g="$GK_GOOD" -v y="$GK_YOURS" -v x="$GK_BAD" -v c="$GK_CONTEXT" -v t="$GK_TEXT" -v R="$GK_R" '
        { s = substr($0, 1, 2); p = substr($0, 4)
          if (s == "??") { u[++nu] = "? " p; next }
          if (substr(s, 1, 1) != " ") st[++ns] = substr(s, 1, 1) " " p
          if (substr(s, 2, 1) != " ") wt[++nw] = substr(s, 2, 1) " " p }
        function show(title, a, n, col,   i) {
          if (!n) return
          printf "  %s%s %d%s\n", c, title, n, R
          for (i = 1; i <= n && i <= 15; i++) printf "    %s%s%s %s%s%s\n", col, substr(a[i], 1, 1), R, t, substr(a[i], 3), R
          if (n > 15) printf "    %s%d more%s\n", c, n - 15, R
        }
        END { show("staged", st, ns, g); show("not staged", wt, nw, y); show("untracked", u, nu, x) }'
      printf '\n'
    fi
    if [ -n "$b" ] && [ "$ahead" != 0 ]; then
      heading "past $base"
      git -c color.ui=always log --format="  %C(yellow)%h%C(reset)  %s  %C(dim)%cr%C(reset)" "$base..HEAD" 2>/dev/null | head -20
      printf '\n'
    fi
    behind=$(git rev-list --count "HEAD..$base" 2>/dev/null || echo 0)
    [ "$behind" != 0 ] && printf "${GK_CONTEXT}%s behind %s: gup brings it up to date.${GK_R}\n" "$behind" "$base"
    exit 0 ;;
esac

# An open merge request with no light asked for, as gmr previews one: all of
# it. Only a merge request's number: a section heading's row has none.
case $iid in ''|*[!0-9]*) exit 0 ;; esac
gate=all
light
exit 0
