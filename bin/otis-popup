#!/usr/bin/env -S zsh -f
# otis-popup confirm <question>         y is yes (exit 0), any other key no
# otis-popup note <question>            the same, and a is yes with a line of
#                                       your own, printed (git-confirm --note)
# otis-popup text <prompt> [<default>]  a line typed, printed; esc exits 130
# otis-popup say <message>              shown until a key
# otis-popup busy <message> <log>       shown while a command goes on, with
#                                       the last line it wrote to <log>
#
# A question asked in a box over the screen whose key started it, so answering
# never drops you to the terminal under otis. A screen keeps its frame up for
# what its execute runs and names a file it drew it into (OTIS_FRAME,
# share/screen.zsh's run_tty); the box goes over that, and the frame is drawn
# again without it once it is answered. Yes leaves "…" in the box while the
# command goes on; one that can take minutes puts busy's box up for that. With
# no screen under it, text and say ask on the terminal's line as ever;
# git-confirm, which sends its questions here, asks there itself.
setopt extendedglob no_nomatch
mode=$1 msg=$2 text=$3

if [[ -z $OTIS_FRAME || ! -e $OTIS_FRAME ]]; then
  case $mode in
    say) print -r -- "$msg. press enter"; read -r _; exit 0 ;;
    text) vared -p "$msg " text </dev/tty >/dev/tty || exit 130; print -r -- "$text"; exit 0 ;;
    *) exit 1 ;;
  esac
fi

[[ -n $OTIS_T_NAME && $OTIS_THEME == "$OTIS_T_WANT" ]] || eval "$(otis-theme --env)"
st=${TMPDIR:-/tmp}/otis-popup.$$.$RANDOM
mkdir -m 700 $st || exit 1
. ${0:A:h:h}/share/screen.zsh
exec {tty}<>/dev/tty
saved=$(stty -g <&$tty)
# busy reads no key: the terminal stays the command's, and ctrl-c with it.
if [[ $mode != busy ]]; then
  at_leave() { stty $saved <&$tty; }
  stty -icanon -echo -isig min 1 time 0 <&$tty
fi
loader_stop
size

# --- the box ------------------------------------------------------------------
# The message wrapped to the box, line by line, its colors dropped and each
# line's indent kept on what wraps from it; a word too long for a line goes
# on under it (whole).
integer bw iw at=$#text
(( bw = W - 4 < 64 ? W - 4 : 64, iw = bw - 4 ))
typeset -a body
for l in "${(@f)msg}"; do
  plain "$l"; l=$REPLY
  local ind=${(M)l##[[:space:]]#}
  whole "$l" $(( iw - $#ind ))
  for s in "${reply[@]}"; do body+=("$ind$s"); done
done
(( $#body > H - 8 )) && body=("${(@)body[1,H-9]}" "…")

# box <hint> [<input line>]: the frame again, then the box over it, the
# terminal's cursor in the input line when there is one.
box() {
  local hint=$1 input=$2 l out
  integer i top left h y cy=0 cx=0
  typeset -a lines
  for l in "${body[@]}"; do lines+=("$T$l$R"); done
  if [[ -n $input ]]; then
    # The text wrapped at its spaces, every character of it on some row so
    # the cursor has a place; a word too long for a row broken. As many rows
    # as the screen has room for, those with the cursor, … in the margin of
    # the first when some above are out of sight.
    integer room=$(( iw - 2 )) s=1 k p r cr=1 max=$(( H - 9 - $#body ))
    typeset -a starts=(1)
    while (( ${(m)#${text[s,-1]}} > room )); do
      for (( k = 1; ${(m)#${text[s,s+k]}} <= room; k++ )); do :; done
      p=$(( s + k - 1 ))
      while (( p > s )) && [[ $text[p] != ' ' ]]; do (( p-- )); done
      (( s = p > s ? p + 1 : s + k ))
      starts+=($s)
    done
    for (( r = 1; r <= $#starts; r++ )); do (( at + 1 >= starts[r] )) && cr=$r; done
    (( max < 1 )) && max=1
    integer first=$(( cr > max ? cr - max + 1 : 1 ))
    lines+=("")
    for (( r = first; r <= $#starts && r < first + max; r++ )); do
      local mark="  "
      (( r == 1 )) && mark="$A›$R "
      (( r == first && r > 1 )) && mark="$C…$R "
      lines+=("$mark$T${text[starts[r],(r < $#starts ? starts[r+1] - 1 : -1)]}$R")
      (( r == cr )) && (( cy = $#lines, cx = 3 + ${(m)#${text[starts[r],at]}} ))
    done
  fi
  lines+=("" "$hint")
  (( h = $#lines + 2, top = (H - h) / 2 + 1, left = (W - bw) / 2 + 1 ))
  # The first box has the frame drawn whole under it, which wipes what the
  # command printed over it and any box an earlier question left (its "…"),
  # in one synchronized update so the clear in it does not blink. After that
  # the frame is drawn again only where a box of another size leaves some of
  # the last one showing. busy draws under a command that may ask on the
  # terminal itself (a hook): the cursor is put back where that left it.
  out=$e'[?2026h'$e'[?25l'
  [[ $mode == busy ]] && out=$e'7'$out
  (( btop )) || out+=$(<$OTIS_FRAME)
  (( btop && (top != btop || h != bh) )) && { unbox; out=$REPLY$out; }
  (( btop = top, bh = h ))
  out+=$e"[$top;${left}H"$F"╭"${(l:bw-2::─:)}"╮"$R
  for (( i = 1; i <= $#lines; i++ )); do
    vw "$lines[i]"
    out+=$e"[$(( top + i ));${left}H"$F"│"$R" "$lines[i]${(l:iw-REPLY:: :)}" "$F"│"$R
  done
  out+=$e"[$(( top + h - 1 ));${left}H"$F"╰"${(l:bw-2::─:)}"╯"$R
  if (( cy )); then out+=$e"[$(( top + cy ));$(( left + 1 + cx ))H"$e'[?25h'
  elif [[ $mode == busy ]]; then out+=$e'8'
  else out+=$e"[$H;1H"; fi
  print -rnu $tty -- $out$e'[?2026l'
}
# unbox: the last box gone, in REPLY: blanked, then the frame over it, each
# of its lines in place, never the whole screen cleared first, which blinks.
integer btop=0 bh=0
unbox() {
  local f=$(<$OTIS_FRAME)
  integer y
  REPLY=
  for (( y = btop; y < btop + bh; y++ )); do REPLY+=$e"[$y;$(( (W - bw) / 2 + 1 ))H"${(l:bw:: :)}; done
  REPLY+=${f//$e\[2J/}
}
# done_ <code> [<busy>]: the box gone, or left saying the command goes on.
done_() {
  if [[ -n $2 ]]; then box "$F…$R"; else unbox; print -rnu $tty -- $REPLY$e"[$H;1H"; fi
  quit $1
}
keys() { local s= k l; for k l in "$@"; do s+="$A$k$R $C$l$R   "; done; REPLY=${s%   }; }
# tick <hint>: the box's last line alone drawn again, the cursor put back.
tick() {
  vw "$1"
  print -rnu $tty -- $e'7'$e"[$(( btop + bh - 2 ));$(( (W - bw) / 2 + 1 ))H"$F"│"$R" "$1${(l:iw-REPLY:: :)}" "$F"│"$R$e'8'
}

# ask: a line typed into the box, in text; 0 for enter, 1 for esc.
ask() {
  local k n hint=$1
  while :; do
    box "$hint" input
    readkey; k=$REPLY
    [[ $k == $e'[<'* ]] && continue
    keyname "$k"; n=$REPLY
    case $k in
      $e'[C'|$e'OC') n=right ;; $e'[D'|$e'OD') n=left ;;
      $e'[H'|$e'[1~'|$'\x01') n=home ;; $e'[F'|$e'[4~') n=end ;;
      $'\x17') n=ctrl-w ;;
    esac
    case $n in
      enter) return 0 ;;
      esc|ctrl-c) return 1 ;;
      left) (( at > 0 )) && (( at-- )) ;;
      right) (( at < $#text )) && (( at++ )) ;;
      home) at=0 ;;
      end|ctrl-e) at=$#text ;;
      bspace) (( at > 0 )) && { text=${text[1,at-1]}${text[at+1,-1]}; (( at-- )); } ;;
      ctrl-u) text=${text[at+1,-1]} at=0 ;;
      ctrl-w)
        local head=${text[1,at]}
        head=${head%%[[:space:]]#}; head=${head%%[^[:space:]]#}
        text=$head${text[at+1,-1]} at=$#head ;;
      *) [[ $k == [[:print:]]* && $k != $e* ]] && { text=${text[1,at]}$k${text[at+1,-1]}; (( at += $#k )); } ;;
    esac
  done
}

case $mode in
  confirm)
    keys y yes n no; box "$REPLY"
    readkey; [[ $REPLY == y ]] && done_ 0 busy; done_ 1 ;;
  note)
    keys y yes a "yes, with a note" n no; box "$REPLY"
    readkey
    [[ $REPLY == y ]] && done_ 0 busy
    [[ $REPLY == a ]] || done_ 1
    body+=("" "${C}a note for it; none is a plain yes$R")
    keys ⏎ go esc "back out"
    if ask "$REPLY"; then print -r -- "$text"; done_ 0 busy; fi
    done_ 1 ;;
  text)
    keys ⏎ done esc cancel
    if ask "$REPLY"; then print -r -- "$text"; done_ 0 busy; fi
    done_ 130 ;;
  say)
    keys "any key" close; box "$REPLY"
    readkey; done_ 0 ;;
  busy)
    # A command that can take minutes (a push, under its hook): what it is,
    # the last line it wrote to the log, whole, and how long it has been, so
    # a slow one reads as slow and not as stuck. It only draws, ten times a
    # second, and the box never shrinks: two lines are kept for what the
    # command says, more once a line of it needs more. It goes when it is
    # stopped (loader_stop: the next box or screen, or the command done),
    # when what started it has gone, or when something else takes the
    # terminal (a passphrase asked for). Stopped, it draws nothing more and
    # leaves the terminal as it is: no trap, and nothing kept to clear up.
    rm -rf -- $st; trap - TERM HUP EXIT; trap '' INT
    typeset -a head=("${body[@]}") said
    integer t0=$EPOCHSECONDS secs room=2 max=$(( H - 7 - $#body ))
    local line last=$'\0' took hint
    while kill -0 $PPID 2>/dev/null && [[ $(stty -g <&$tty 2>/dev/null) == $saved ]]; do
      line=
      for l in ${(Oa)${(f)"$(tail -c 4096 -- $text 2>/dev/null)"}}; do
        l=${l%%$'\r'#}; plain "${l##*$'\r'}"; l=${REPLY//[[:cntrl:]]/ }
        l=${${l##[[:space:]]#}%%[[:space:]]#}
        [[ -n $l ]] && { line=$l; break; }
      done
      (( secs = EPOCHSECONDS - t0 ))
      took=${secs}s; (( secs >= 60 )) && took="$(( secs / 60 ))m ${(l:2::0:)$(( secs % 60 ))}s"
      spin_frame; hint=$A$REPLY$R" "$T$took$R"   "; keys ctrl-c stop; hint+=$REPLY
      if [[ $line != $last ]]; then
        last=$line
        whole "${line:-nothing from it yet}" $iw; said=("${reply[@]}")
        (( $#said > max )) && said=("${(@)said[1,max]}")
        (( $#said > room )) && room=$#said
        body=("${head[@]}" "")
        for l in "${said[@]}"; do body+=("$C$l"); done
        repeat $(( room - $#said )) body+=("")
        box "$hint"
      else
        tick "$hint"
      fi
      zselect -t 10
    done
    exit 0 ;;
esac
done_ 2
