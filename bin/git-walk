#!/bin/sh
# git-walk <iid> [<head> <base> <start>]  gmr's P: an MR's walk: its progress while it runs; once
#                                         it has landed, asked whether to walk it again (y) or
#                                         else the walk itself; or, after a confirm, started
# git-walk --branch <branch>              gb's P: the same for a branch, as gdm reads it
# git-walk --check <kind> <iid> [<head> <base>]
#                                         gmr's P, as fzf actions: only open MRs have it. With
#                                         its head and base (the board's), whether its tests
#                                         can be traced is worked out here, behind the screen,
#                                         and handed on (OTIS_WALK_CAN)
# git-walk --check-branch <branch>        the same for --branch
# git-walk --marks                        {iid or branch: {walking, status, head}} of every walk,
#                                         for gmr's and gb's rows
# git-walk --settle <review> <mine>       the MR walks there is no more point in, stopped: the
#                                         board's lists (otis-list) say which
# git-walk --run <key>                    the walk itself, in the background (what resume runs)
# git-walk --view <key>                   the walk, on a screen of its own: its steps the list, the
#                                         step the preview, its code under it
# git-walk --list <key>                   that screen's list, the picker's state set up for its previews
# git-walk --again <key>                  R there: walked again, after a confirm, its progress shown
# git-walk --ahead <iid> <head> <base> <start>
#                                         an MR you review or wrote, traced before you open it
#                                         (git-mr-prefetch)
# git-walk --ahead-branches               your last branches the same (git-branch-list)
# git-walk --ahead-since                  when ahead tracing began: only what is newer is traced
# git-walk --open <dir> <side> <path> <line>
#                                         enter on a line in P: opened as the symbol view opens it
# git-walk --comment <dir> <side> <path> <line>
#                                         c there: comment on it, as the review's c does
#
# The walk is git-symbols-walk's: Opus picks the inputs a change was written
# for and ones whose behavior it changes without saying so, and follows each
# through the code, a stop a step. This makes it a run like V's and C's: it
# goes in the background with a progress of its own (git-claude-view, where q
# leaves it going and x stops it), it is in gag and on the dashboard while it
# runs, a notification says when it lands, and opening it then (P again, or
# enter in gag or on the dashboard) opens the walk on a screen of its own
# (--view): its steps the list, j and k through them, the step the preview
# with its code under it, enter the step's line in your editor, y the step
# for Claude, r walked again.
#
# A run keeps its state in <git dir>/otis-walk/<key>, the key an MR's iid or
# b-<branch> with slashes as %: what the progress view reads (title, pid,
# started, ended, status, events.jsonl), what resume runs (cmd, cwd), and what
# it walked (rev, head, the walk's cache key in key). The walk itself is in
# git-symbols-walk's cache, keyed as a review keys the change, so the review
# and gdm find it too.
share=$(cd "$(dirname "$0")/../share" && pwd)
. "$share/claude-run.sh"
. "$share/repo.sh" || exit 1
top=$OTIS_GITDIR/otis-walk
pause() { otis-popup say "$1"; exit 0; }
# base_of <dir>: an MR walk's base sha. A walk traced before git-trace kept
# the base's traces in before/ has them in base/ instead, over the sha: the
# diff's base (shas) stands in, which is here, so nothing is fetched for it.
base_of() { if [ -f "$1/base" ]; then cat "$1/base"; else cut -d' ' -f1 "$1/shas" 2>/dev/null; fi; }

case $1 in
  --check)
    # can: whether the change's tests can be traced (git-trace --can), which
    # for one with no tests of its own searches the repository for those that
    # import what it changed: ten seconds a screen was held for, with only a
    # spinner to show. Worked out here it is behind the screen, which goes on
    # working until the walk is ready to open.
    kind=$2 iid=$3 head=$4 base=$5
    case $kind in
      review|mine)
        can=
        if [ -n "$head" ]; then
          if [ "$(cat "$top/$iid/engine" 2>/dev/null)" = trace ] && [ "$(cat "$top/$iid/head" 2>/dev/null)" = "$head" ]; then can=1
          elif git-trace --can "$base" "$head"; then can=1
          else can=0; fi
        fi
        echo "execute(${can:+OTIS_WALK_CAN=$can }git-walk $iid {7} {8} {12})" ;;
      sep) exec git-fzf-note "that row is a section heading" ;;
      *) exec git-fzf-note "P walks open MRs, and !$iid has merged" ;;
    esac
    exit 0 ;;
  --check-branch)
    br=$2 can=
    head=$(git rev-parse -q --verify "$br^{commit}" 2>/dev/null)
    if [ -n "$head" ]; then
      d=$top/b-$(printf '%s' "$br" | tr '/' '%')
      if [ "$(cat "$d/engine" 2>/dev/null)" = trace ] && [ "$(cat "$d/head" 2>/dev/null)" = "$head" ]; then can=1
      elif git-trace --can "$(git merge-base "$(otis-config base)" "$br" 2>/dev/null)" "$head"; then can=1
      else can=0; fi
    fi
    echo "execute(${can:+OTIS_WALK_CAN=$can }git-walk --branch {5})"
    exit 0 ;;
  --marks)
    # Going, how the last one ended, and the head it walked, so a row marks
    # it walked only while that is still the head.
    printf '{'
    n=0
    for d in "$top"/*/; do
      d=${d%/}
      [ -s "$d/started" ] || continue
      k=${d##*/}; case $k in b-*) k=$(printf '%s' "${k#b-}" | tr '%' '/') ;; esac
      w=false; running "$d" && w=true
      [ "$n" -gt 0 ] && printf ','
      printf '"%s":{"walking":%s,"status":"%s","head":"%s"}' "$k" "$w" "$(cat "$d/status" 2>/dev/null)" "$(cat "$d/head" 2>/dev/null)"
      n=$((n + 1))
    done
    printf '}\n'
    exit 0 ;;
  --settle)
    # A walk is for reading a change before you decide on it, so one goes on
    # only while there is still that to decide. Someone else's MR you have
    # approved is decided, and any MR that has merged, yours or not, is past
    # deciding: those walks are stopped as x stops one (git-claude-view
    # --halt), saying why. Your own open MR goes on whoever has approved it,
    # and a branch's walk has no MR to say so.
    # The board's lists, which it has just drawn from (the review and mine
    # JSON, share/mr-query.sh), say it for an open MR. One in neither may have
    # merged, so the forge is asked, at most every two minutes a walk.
    review=$2 mine=$3
    for d in "$top"/*/; do
      d=${d%/}
      [ -s "$d/iid" ] && running "$d" || continue
      iid=$(cat "$d/iid")
      said=$(jq -nr --slurpfile r "$review" --slurpfile m "$mine" --arg iid "$iid" '
        ($r[0].data.currentUser // {}) as $ru | ($m[0].data.currentUser // {}) as $mu |
        ($ru.username // $mu.username // "") as $me |
        [$ru.reviewRequestedMergeRequests.nodes[]? | select((.iid | tostring) == $iid)][0] as $rv |
        if $rv and $rv.author.username != $me and any($rv.approvedBy.nodes[]?; .username == $me) then "stop\tyou approved !\($iid)"
        elif $rv or any($mu.authoredMergeRequests.nodes[]?; (.iid | tostring) == $iid) then "open"
        else "ask\t\($me)" end' 2>/dev/null)
      why=
      case $said in
        stop*) why=${said#*	} ;;
        ask*)
          me=${said#*	}
          [ -n "$(find "$d/settled" -mmin -2 2>/dev/null)" ] && continue
          : > "$d/settled"
          mr=$(git-forge api "projects/:fullpath/merge_requests/$iid" 2>/dev/null) || continue
          case $(printf '%s' "$mr" | jq -r .state) in
            merged) why="!$iid merged" ;;
            opened)
              [ -n "$me" ] && [ "$(printf '%s' "$mr" | jq -r .author.username)" != "$me" ] &&
                git-forge api "projects/:fullpath/merge_requests/$iid/approvals" 2>/dev/null |
                  jq -e --arg me "$me" 'any(.approved_by[]?; .user.username == $me)' >/dev/null &&
                why="you approved !$iid" ;;
          esac ;;
      esac
      [ -n "$why" ] && git-claude-view --halt "$d" "stopped: $why"
    done
    exit 0 ;;
  --open)
    # enter on a line in P, as the symbol view's enter: in a checkout of
    # yours at the head it walked, where an edit is yours to commit; else,
    # for an MR, in the review worktree, moved to it, with the review's diff
    # base and comments (git-mr-review --open); else as the commit has it.
    # A line on the base's side (old, or b in a test's walk) is the base's.
    d=$2 side=$3 p=$4 l=$5
    k=$(cat "$d/key") b=${k%-*} h=${k#*-}
    case $side in base|old) exec git-commit-open "$b" "$p" "$l" ;; esac
    review=$(git-worktree-path named review)
    wt=$(git worktree list --porcelain | awk -v h="$h" -v r="$review" '/^worktree / { w = substr($0, 10) } $0 == "HEAD " h && w != r { print w; exit }')
    [ -n "$wt" ] && { cd "$wt" && NVIM_DIFF_BASE=$b exec git-commit-open "$b..$h" "$p" "$l"; }
    [ -s "$d/iid" ] && exec git-mr-review --open "$(cat "$d/iid")" "$h" "$(base_of "$d")" "$(cat "$d/start" 2>/dev/null)" "$p" "$l"
    NVIM_DIFF_BASE=$b exec git-commit-open "$h" "$p" "$l" ;;
  --comment)
    # c on a line in P, as the review's c: the file's diff a line a row with
    # its threads (git-mr-lines), on this line, where c starts a thread or
    # replies, a draft until S, and enter opens the line as the review does,
    # in its worktree when that is at the head. An MR's lines only.
    d=$2 side=$3 p=$4 l=$5
    [ -s "$d/iid" ] || pause "c comments on an MR, and $(cat "$d/what") has none"
    k=$(cat "$d/key") iid=$(cat "$d/iid")
    case $side in base|old) l= ;; esac
    review=$(git-worktree-path named review)
    [ "$(git -C "$review" rev-parse -q --verify HEAD 2>/dev/null)" = "${k#*-}" ] && cd "$review"
    NVIM_DIFF_BASE=${k%-*} GMR_IID=$iid GMR_RANGE=${k%-*}..${k#*-} GMR_KIND=review exec git-mr-lines "$iid" "${k%-*}..${k#*-}" "$p" $l ;;
  --run)
    d=$top/$2
    finish() {
      printf '%s\n' "$1" > "$d/status"
      date +%s > "$d/ended"
      say "$2"
      [ "$1" != stopped ] && alert "Walked $(cat "$d/what")" "$2" "$1"
      exit 0
    }
    note_signal
    read -r rev < "$d/rev" 2>/dev/null
    what=$(cat "$d/what")
    # An MR's commits, fetched if they are not here (git-mr-prefetch does
    # this ahead for the MRs you review), and its base as its review reads
    # it (git-mr-base), so the walk is keyed as the review keys the change.
    if [ -s "$d/iid" ]; then
      iid=$(cat "$d/iid") head=$(cat "$d/head") base=$(base_of "$d") start=$(cat "$d/start" 2>/dev/null)
      git cat-file -e "$head^{commit}" 2>/dev/null ||
        GIT_TERMINAL_PROMPT=0 git fetch --quiet --no-tags origin "+$(git-forge head-ref "$iid"):refs/mr/$iid" 2>>"$d/log"
      git cat-file -e "$base^{commit}" 2>/dev/null || GIT_TERMINAL_PROMPT=0 git fetch --quiet --no-tags origin 2>>"$d/log"
      git cat-file -e "$head^{commit}" 2>/dev/null || finish failed "could not fetch $what's commits"
      [ -n "$start" ] && ! git cat-file -e "$start^{commit}" 2>/dev/null && start=
      b=$(git rev-parse "$(git-mr-base "$base" "$head" "$start")" 2>/dev/null) || finish failed "could not work out $what's base"
      rev=$b..$head key=$b-$head
    else
      l=${rev%%...*} r=${rev##*...}
      key=$(git merge-base "$l" "$r")-$(git rev-parse "$r")
    fi
    printf '%s\n' "$rev" > "$d/rev"; printf '%s\n' "$key" > "$d/key"
    # Traced rather than told: the change's own tests, run (git-trace).
    if [ "$(cat "$d/engine" 2>/dev/null)" = trace ]; then
      printf '%s %s\n' "${key%-*}" "${key#*-}" > "$d/shas"
      exec git-trace --phase "$d" run
    fi
    say "reading $what by symbol"
    t=$(git-symbols --table "$rev" 2>>"$d/log") || finish failed "seam could not read $what"
    # The walk reports here as it goes (OTIS_WALK_DIR): its own lines, and
    # each call's steps under its name.
    OTIS_WALK_DIR=$d OTIS_SYMBOLS_KEY=$key git-symbols-walk --run "$rev" "$t" 2>>"$d/log"
    stopping
    f=$(OTIS_SYMBOLS_KEY=$key git-symbols-walk --file "$rev" "$t")
    if [ -n "$f" ]; then
      finish done "$(jq -r '"\(.walks | length) walks: " + ([.walks[] | (.point // .title)] | join(" · "))' "$f" 2>/dev/null | cut -c1-300)"
    else
      finish failed "no walk came back: $(OTIS_SYMBOLS_KEY=$key git-symbols-walk --state "$rev" "$t")"
    fi ;;
esac

# traced <head>: a run that traced this head, under any key (an MR's and its
# branch's are one change), going or walked, so it is traced the once.
traced() {
  for t in "$top"/*/; do
    t=${t%/}
    [ "$(cat "$t/engine" 2>/dev/null)" = trace ] && [ "$(cat "$t/head" 2>/dev/null)" = "$1" ] || continue
    { running "$t" || [ "$(cat "$t/status" 2>/dev/null)" = done ]; } && { printf '%s\n' "$t"; return 0; }
  done
  return 1
}

# --ahead: an MR you review or wrote, or a branch of yours (--ahead-branches),
# traced before you open it (git-mr-prefetch, git-branch-list), so P finds it
# walked. Only a change whose own tests can run (git-trace --can), once a push,
# one at a time, and never while a build or test of yours runs; it leaves you
# a slot (git-trace), and says nothing when it lands. git config
# otis.walkAhead off stops it.
ahead() {
  [ "$(git config --get otis.walkAhead)" != off ] || exit 0
  [ "$(cat "$d/head" 2>/dev/null)" = "$head" ] && return 1
  traced "$head" >/dev/null && return 1
  running "$d" && return 1
  # Run here, only on a machine with nothing else to do: no build or test of
  # yours going, on power, and the last five minutes' load under a quarter of
  # its cores. On a workspace (otis.walkRemote), whenever.
  if [ -z "$(git config --get otis.walkRemote)" ]; then
    pgrep -f "(^|/)(bazel|jest|vitest|yarn|npm) (build|test|run|query|coverage|install)( |$)" >/dev/null 2>&1 && exit 0
    pmset -g batt 2>/dev/null | grep -q "AC Power" || exit 0
    awk -v l="$(sysctl -n vm.loadavg 2>/dev/null | awk '{ print $3 }')" -v c="$(sysctl -n hw.ncpu 2>/dev/null)" 'BEGIN { exit !(l != "" && c > 0 && l < c / 4) }' || exit 0
  fi
  mkdir -p "$top"
  lk=$top/.ahead
  if ! mkdir "$lk" 2>/dev/null; then
    kill -0 "$(cat "$lk/pid" 2>/dev/null)" 2>/dev/null && exit 0
    rm -rf "$lk"; mkdir "$lk" 2>/dev/null || exit 0
  fi
  git-trace --can "$base" "$head" || { rm -rf "$lk"; return 1; }
  rm -rf "$d"; mkdir -p "$d"
  echo trace > "$d/engine"; : > "$d/ahead"
  printf '%s\n' "$what" > "$d/what"
  printf 'Walking %s ahead\n' "$what" > "$d/title"
  printf '%s\n' "$head" > "$d/head"
  if [ -n "$rev" ]; then printf '%s\n' "$rev" > "$d/rev"
  else printf '%s\n' "$key" > "$d/iid"; printf '%s\n' "$base" > "$d/base"; printf '%s\n' "$start" > "$d/start"; fi
  date +%s > "$d/started"
  : > "$d/events.jsonl"
  printf '%s\n' git-walk --run "$key" > "$d/cmd"
  pwd > "$d/cwd"
  otis-detach git-walk --run "$key" </dev/null > "$d/log" 2>&1 &
  echo $! > "$d/pid"; echo $! > "$lk/pid"
  exit 0
}
# --ahead-since: when ahead tracing began here (git config otis.walkAheadSince,
# seconds), set to now the first time it is asked: what was open then is
# yours to walk by hand, and only what comes after is traced ahead.
if [ "$1" = --ahead-since ]; then
  s=$(git config --get otis.walkAheadSince) || { s=$(date +%s); git config otis.walkAheadSince "$s"; }
  printf '%s\n' "$s"; exit 0
fi
if [ "$1" = --ahead ]; then
  key=$2 head=$3 base=$4 start=$5 d=$top/$2 what="!$2" rev=
  ahead; exit 0
fi
# Your branches: the few you committed to last since ahead tracing began, each once it has sat five
# minutes (a branch mid-work moves on before its trace lands), that have
# something since the base. The first that needs it is traced.
if [ "$1" = --ahead-branches ]; then
  main=$(otis-config base) now=$(date +%s) since=$(git-walk --ahead-since)
  git for-each-ref --sort=-committerdate --count=5 --format='%(refname:short)%09%(objectname)%09%(committerdate:unix)' refs/heads |
    while IFS="$(printf '\t')" read -r br head when; do
      [ $((now - when)) -ge 300 ] && [ $((now - when)) -le 604800 ] && [ "$when" -ge "$since" ] || continue
      [ "$br" = "$main" ] && continue
      base=$(git merge-base "$main" "$br" 2>/dev/null) || continue
      [ "$base" = "$head" ] && continue
      key=b-$(printf '%s' "$br" | tr '/' '%') d=$top/b-$(printf '%s' "$br" | tr '/' '%') what=$br rev=$main...$br
      ahead
    done
  exit 0
fi

# The walk's screen, and its list: the state git-symbols-walk's previews
# read (the key and cache root, the change's shas and its table), then its
# rows, kept for > and < to find their rows in.
if [ "$1" = --list ]; then
  d=$top/$2 st=$GIT_FZF_STATE
  rev=$(cat "$d/rev") k=$(cat "$d/key")
  printf '%s\n' "$k" > "$st/key"
  printf '%s\n' "$(git rev-parse --path-format=absolute --git-common-dir)/git-alias-cache" > "$st/cache-root"
  if [ ! -s "$st/symbols.tsv" ]; then
    t=$(git-symbols --table "$rev" 2>/dev/null) && cp "$t" "$st/symbols.tsv"
    printf '%s %s\n' "${k%-*}" "${k#*-}" > "$st/symbols.tsv.rev"
  fi
  [ -e "$st/walk" ] || echo 0 > "$st/walk"
  git-symbols-walk --rows "$rev" | tee "$st/rows.last"
  exit 0
fi
if [ "$1" = --view ]; then
  d=$top/$2
  # An MR's review worktree moved to the head it walked, once, as the screen
  # opens: enter on a line then only opens it there (--open).
  [ -s "$d/iid" ] && git-mr-review --ready "$(cat "$d/iid")" "$(cat "$d/head")" "$(base_of "$d")" "$(cat "$d/start" 2>/dev/null)"
  [ "$(cat "$d/engine" 2>/dev/null)" = trace ] && exec git-trace --view "$d"
  rev=$(cat "$d/rev")
  otis-symbols "walk $(cat "$d/what") " 'enter=open the step in your editor,c=comment on its line,>=next step,<=step back,y=copy it for Claude,r=walk it again,q=back' \
    --header-from-state --ansi --delimiter='\t' --with-nth=1 --id-nth=12 \
    --bind "start:reload(git-walk --list '$2')" \
    --bind ">:transform(git-symbols-walk --step 1)" \
    --bind "<:transform(git-symbols-walk --step -1)" \
    --bind "y:transform(git-symbols-walk --note {12})" \
    --bind "enter:execute(git-walk --open '$d' {4} {2} {3})+reload(git-walk --list '$2')" \
    --bind "c:execute(git-walk --comment '$d' {4} {2} {3})+reload(git-walk --list '$2')" \
    --bind "r:execute(git-walk --again '$2')+reload(git-walk --list '$2')" \
    --preview "git-symbols-walk --show '$rev' {12}" </dev/null >/dev/null
  exit 0
fi

# P: the key, what it is called, and what it walks.
if [ "$1" = --branch ]; then
  br=$2
  [ -n "$br" ] && git rev-parse -q --verify "$br^{commit}" >/dev/null || pause "no such branch: $br"
  key=b-$(printf '%s' "$br" | tr '/' '%') what=$br
  main=$(otis-config base)
  [ -n "$(git diff --name-only "$main...$br" 2>/dev/null)" ] || pause "$br has nothing since it left $main"
  rev=$main...$br head=$(git rev-parse "$br")
else
  [ "$1" = --again ] && shift && set -- "$1" --again
  key=$1 what="!$1" head=$2 base=$3 start=$4
  [ "$head" = --again ] && { head= again=1; }
  [ -n "$key" ] || exit 0
  case $key in b-*) br=$(printf '%s' "${key#b-}" | tr '%' '/'); what=$br; main=$(otis-config base); rev=$main...$br; head=$(git rev-parse -q --verify "$br") ;; esac
fi
d=$top/$key
# Traced when the change's own tests can run (git-trace): nothing to pay for,
# and no model to have. Else the same run with no tests in it: the tour,
# written from the diff alone, on the same screen, which needs an agent.
trace=
case $OTIS_WALK_CAN in
  # Worked out already, behind the screen that opened this (--check).
  1) trace=1 ;;
  0) ;;
  *)
    # A walk of this very head that traced says so: nothing to ask again.
    if [ -n "$head" ] && [ "$(cat "$d/engine" 2>/dev/null)" = trace ] && [ "$(cat "$d/head" 2>/dev/null)" = "$head" ]; then trace=1
    elif [ -n "$br" ]; then git-trace --can "$(git merge-base "$main" "$br" 2>/dev/null)" "$head" && trace=1
    elif [ -n "$head" ]; then git-trace --can "$base" "$head" && trace=1
    else [ "$(cat "$d/engine" 2>/dev/null)" = trace ] && trace=1; fi ;;
esac
if [ -z "$trace" ]; then
  missing=$(otis-agent-run --ready) || pause "no test runs $what, so P tours it from the diff, which needs $missing"
  [ "$(git config --get otis.walkModel)" != off ] || pause "no test runs $what, and its tour is off (otis.walkModel)"
fi

start() {
  # From gag or the dashboard, an MR's shas are the last run's.
  if [ -z "$br" ] && [ -z "$head" ]; then
    head=$(cat "$d/head" 2>/dev/null) base=$(base_of "$d") start=$(cat "$d/start" 2>/dev/null)
    [ -n "$head" ] || pause "P on the board walks $what"
  fi
  rm -rf "$d"
  mkdir -p "$d" || return 1
  echo trace > "$d/engine"
  printf '%s\n' "$what" > "$d/what"
  printf 'Walking %s\n' "$what" > "$d/title"
  printf '%s\n' "$head" > "$d/head"
  if [ -n "$br" ]; then printf '%s\n' "$rev" > "$d/rev"
  else printf '%s\n' "$key" > "$d/iid"; printf '%s\n' "$base" > "$d/base"; printf '%s\n' "$start" > "$d/start"; fi
  otis-config agent > "$d/agent-cli"
  date +%s > "$d/started"
  : > "$d/events.jsonl"
  # What resume runs, and where, if the laptop kills it (share/claude-run.sh).
  printf '%s\n' git-walk --run "$key" > "$d/cmd"
  pwd > "$d/cwd"
  otis-detach git-walk --run "$key" </dev/null > "$d/log" 2>&1 &
  echo $! > "$d/pid"
}

# progress: the run's progress while it goes (git-claude-view: q leaves it
# going, x stops it, r once over walks again); walked, the walk. A traced
# run's tour is written from the diff while its tests run: the screen goes
# to it once it lands, and the values fill in under its stops.
progress() {
  while :; do
    OTIS_AGENT_UNTIL=$d/tour.json git-claude-view "$d"
    case $? in 4) exec git-walk --view "$key" ;; 3) ;; *) break ;; esac
    start || return 0
  done
  [ "$(cat "$d/status" 2>/dev/null)" = done ] && ! running "$d" && exec git-walk --view "$key"
  return 0
}

# R in the walk's screen: walked again, and its progress shown.
[ -n "$again" ] && { start && progress; exit 0; }

# The same head traced under its MR's key or its branch's: that run.
if [ -n "$head" ] && [ "$(cat "$d/head" 2>/dev/null)" != "$head" ] && t=$(traced "$head"); then
  d=$t key=${t##*/}
fi
if [ ! -d "$d" ]; then
  start || exit 0
elif orphaned "$d"; then
  resume "$d"
elif [ "$(cat "$d/engine" 2>/dev/null)" = trace ] && [ -n "$head" ] && [ "$(cat "$d/head" 2>/dev/null)" != "$head" ] && ! running "$d"; then
  # Traced at an older push. A walk that finished is yours until you say to
  # walk the new push: a bot's push (a CI auto-fix) threw one away the moment
  # its notification was followed. One that did not finish is walked again.
  if [ "$(cat "$d/status" 2>/dev/null)" = done ]; then
    pushed=$(git log -1 --format=%s "$head" 2>/dev/null)
    git-confirm "$what has a new push since this walk${pushed:+ ($pushed)}. Walk it again? (any other key opens this walk)" || exec git-walk --view "$key"
  fi
  start || exit 0
# Traced, or still tracing with its tour already there: the tour.
elif [ "$(cat "$d/engine" 2>/dev/null)" = trace ] && { [ "$(cat "$d/status" 2>/dev/null)" = done ] || { running "$d" && [ -s "$d/tour.json" ]; }; }; then
  exec git-walk --view "$key"
elif [ "$(cat "$d/status" 2>/dev/null)" = done ]; then
  # Claude's walk, from before a change no test runs was toured: toured now,
  # if you say so, else that walk (git-symbols-walk keeps it either way).
  git-confirm "$what has Claude's older walk, not a tour. Tour it now? (any other key opens the old walk)" || exec git-walk --view "$key"
  start || exit 0
fi
progress
