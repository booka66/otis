#!/usr/bin/env -S zsh -f
# otis-usage [days]: what you use and what you don't, from the key log
# (share/screen.zsh's keys_open and keys_used, and otis-run's line a
# command). Each screen you opened in the last [days] (14 unless given), most
# opened first, and under it its keys: how often you pressed each in those
# days, as a heat bar, and how long ago you last did, so a key you stopped
# using reads as one gone quiet. The keys it offers now that you never
# pressed are a line under them. Then what came before each u, since a
# refresh is the screen not showing what you expected, and the commands you
# ran and the ones you didn't. It is for deciding what to cut and what to
# fix: what nobody presses is weight.
zmodload zsh/datetime
[[ -n $OTIS_T_NAME && $OTIS_THEME == "$OTIS_T_WANT" ]] || eval "$(otis-theme --env)"
e=$'\e'
log=${OTIS_KEY_LOG:-${XDG_CACHE_HOME:-$HOME/.cache}/otis/keys.tsv}
[[ $log == off ]] && { print -u2 "otis-usage: OTIS_KEY_LOG is off, so nothing is logged"; exit 1; }
[[ -s $log ]] || { print "Nothing logged yet: it starts with the next key you press in otis."; exit 0; }
integer days=14
[[ $1 == <-> ]] && days=$1
integer cols=${COLUMNS:-$({ stty size </dev/tty } 2>/dev/null | cut -d' ' -f2)}
(( cols > 40 )) || cols=100

# The commands gg lists that otis-run runs (a link to it in bin/), which is
# what logs a run. gs is an alias, and setup, update and the tour log
# nothing, so they are not asked about.
local -a cmds
local n
for n in ${(f)"$(awk -F'\t' '!/^#/ && NF >= 3 { print $3 }' ${0:A:h:h}/share/commands.tsv)"}; do
  [[ -L ${0:A:h}/$n ]] && cmds+=($n)
done

report() {
  # Bytes, the same on any awk: width() counts what the terminal draws.
  LC_ALL=C awk -F'\t' -v now=$EPOCHSECONDS -v since=$(( EPOCHSECONDS - days * 86400 )) -v cols=$cols \
    -v head="what you use, the last $days days (since $(strftime '%a %b %-d' $(( EPOCHSECONDS - days * 86400 ))))" \
    -v cmds="$cmds" -v A=$e"[${OTIS_T_ATTENTION}m" -v C=$e"[${OTIS_T_CONTEXT}m" -v F=$e"[${OTIS_T_FAINT}m" \
    -v T=$e"[${OTIS_T_TEXT}m" -v B=$e'[1m' -v R=$e'[0m' '
  # tally counts x in the group g, and ranked puts the group in out, most
  # counted first, ties in the order they came; it returns how many.
  function note(g, x) { if (!((g, x) in tal)) { seen[g] = seen[g] SUBSEP x; tal[g, x] = 0 } }
  function tally(g, x) { note(g, x); tal[g, x]++ }
  function ranked(g, out,  n, i, j, t) {
    n = split(substr(seen[g], 2), out, SUBSEP)
    for (i = 2; i <= n; i++) for (j = i; j > 1 && tal[g, out[j]] > tal[g, out[j - 1]]; j--) { t = out[j]; out[j] = out[j - 1]; out[j - 1] = t }
    return n
  }
  function width(s,  t) { t = s; gsub(/\033\[[0-9;]*m/, "", t); gsub(/[\200-\277]/, "", t); return length(t) }
  function rep(c, n,  s) { s = ""; while (n-- > 0) s = s c; return s }
  function ago(t,  s) {
    s = now - t
    if (s < 3600) return int(s / 60) "m"
    if (s < 86400) return int(s / 3600) "h"
    if (s < 14 * 86400) return int(s / 86400) "d"
    return int(s / 604800) "w"
  }
  # What a key is for on a screen: what it offered it as when it last
  # opened, else what the press said.
  function lab(n, k) { return ((n, k) in off) ? off[n, k] : label[n, k] }
  # Items after a lead, a dot between them, wrapped whole under the first;
  # an item longer than a line wraps at its words. Each is "<key>\t<what>".
  function flow(lead, n, items,  lw, i, j, out, x, wd, nw, at, room) {
    out = lead; lw = at = width(lead); room = cols - 1
    for (i = 1; i <= n; i++) {
      split(items[i], x, "\t")
      if (at > lw && at + 3 + width(x[1] " " x[2]) > room) { out = out "\n" sprintf("%" lw "s", ""); at = lw }
      else if (at > lw) { out = out F " · " R; at += 3 }
      out = out T x[1] R C; at += width(x[1])
      nw = split(x[2], wd, " ")
      for (j = 1; j <= nw; j++) {
        if (at + 1 + width(wd[j]) > room && at > lw) { out = out "\n" sprintf("%" lw "s", ""); at = lw - 1 }
        out = out " " wd[j]; at += 1 + width(wd[j])
      }
      out = out R
    }
    print out
  }
  {
    t = $1 + 0; n = $2; k = $3
    if (k == ":run") { if (t >= since) tally("runs", n); lastrun[n] = t; next }
    if (k == ":open") {
      if (t >= since) tally("screens", n)
      # What it offers is what it offered the last time it opened: a key
      # renamed or taken out since is not asked about.
      for (i = 1; i <= offers[n]; i++) delete off[n, offered[n, i]]
      offers[n] = 0
      np = split($4, pairs, ",")
      for (i = 1; i <= np; i++) {
        p = index(pairs[i], "=")
        if (p < 2 || p == length(pairs[i]) || ((n, substr(pairs[i], 1, p - 1)) in off)) continue
        x = substr(pairs[i], 1, p - 1); off[n, x] = substr(pairs[i], p + 1); offered[n, ++offers[n]] = x
      }
    } else {
      if ($4 != "") label[n, k] = $4
      last[n, k] = t
      if (t >= since) {
        # A screen opened before these days and still open counts too.
        note("screens", n); tally("keys" n, k)
        # What came before a refresh, on any screen, if it was in the last
        # two minutes: where the screen did not show what you had done, or
        # what you were waiting for.
        if (k == "u") tally("u" n, t - pt > 120 ? n "\t:idle" : pn "\t" pk)
      }
    }
    pt = t; pn = n; pk = k
  }
  # What came before a refresh on n, its screen and key, in words.
  function why(n, r,  x) {
    split(r, x, "\t")
    if (x[2] == ":idle") return "nothing for 2 minutes"
    if (x[2] == ":open") return x[1] == n ? "the screen opening" : x[1] " opening"
    if (x[2] == "u" && x[1] == n) return "another u"
    return x[2] " " lab(x[1], x[2]) (x[1] != n ? " (" x[1] ")" : "")
  }
  END {
    print B T head R
    ns = ranked("screens", sc)
    for (s = 1; s <= ns; s++) {
      n = sc[s]
      printf "\n%s%s%s%s  opened %d×%s\n", A, B, n, R C, tal["screens", n], R
      nk = ranked("keys" n, ks); max = nk ? tal["keys" n, ks[1]] : 1
      for (i = 1; i <= nk; i++) {
        k = ks[i]; c = tal["keys" n, k]; w = int((c * 14 + max - 1) / max)
        delete row; row[1] = "\t" lab(n, k)
        flow(sprintf("  %s%s%s%s%s %5d %4s  %s%-9s%s", A, rep("█", w), F, rep("░", 14 - w), R, c, ago(last[n, k]), T, k, R), 1, row)
      }
      # Offered now and not pressed in these days: the ones you used to
      # press, with how long ago, then the ones you never have.
      q = nv = 0; delete quiet; delete never
      for (i = 1; i <= offers[n]; i++) {
        k = offered[n, i]
        if (("keys" n, k) in tal) continue
        if ((n, k) in last) quiet[++q] = k "\t" off[n, k] " " ago(last[n, k])
        else never[++nv] = k "\t" off[n, k]
      }
      if (q) flow("  " F "quiet" R "  ", q, quiet)
      if (nv) flow("  " F "never" R "  ", nv, never)
    }
    first = 1
    for (s = 1; s <= ns; s++) {
      n = sc[s]
      if (tal["keys" n, "u"] < 5) continue
      if (first) { print "\n" A B "what came before u" R; first = 0 }
      printf "  %s%s%s %s%d×%s\n", T, n, R, C, tal["keys" n, "u"], R
      nw = ranked("u" n, ws); delete items
      for (i = 1; i <= nw && i <= 8; i++) items[i] = tal["u" n, ws[i]] "\t" why(n, ws[i])
      flow("    ", i - 1, items)
    }
    # Commands: the ones you ran, most first, and the ones you did not.
    print ""
    nr = ranked("runs", rn); delete items
    for (i = 1; i <= nr; i++) items[i] = rn[i] "\t" tal["runs", rn[i]]
    if (nr) flow(A B "ran" R "      ", nr, items)
    nc = split(cmds, cs, " "); u = 0; delete items
    for (i = 1; i <= nc; i++) {
      n = cs[i]
      if (("runs", n) in tal || ("screens", n) in tal) continue
      items[++u] = n "\t" ((n in lastrun) ? ago(lastrun[n]) : "never")
    }
    if (u) flow(A B "not run" R "  ", u, items)
  }' $log
}

# Longer than the screen, it opens in a pager, which leaves when it fits.
if [[ -t 1 ]]; then report | LESSSECURE=1 less -RFX; else report; fi
