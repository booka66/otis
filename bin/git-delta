#!/bin/sh
# git-delta [<delta options>]: a diff on stdin through delta, the way every
# otis preview shows one. The work is share/delta.sh's gk_delta, which the
# previews that run on every cursor move source rather than start; this is it
# as a command, for zsh, lua and anything else that cannot.
. "$(cd "$(dirname "$0")/../share" && pwd)/delta.sh"
gk_delta "$@"
