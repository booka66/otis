#!/bin/sh
# git-agent-list --open <dir> <back>  the fzf actions that open a run, and what to do on the way back
# git-agent-list --forget <dir>       a finished run's directory removed, after a confirm (d on the board)
# git-agent-list --data               every run of Claude's in this repo as raw fields, for otis-list
#
# Every run keeps its state in a directory (share/claude-run.sh, git-claude-view):
# reviews under gmr-claude, fix runs under gmr-fix, production watches under
# gmr-watch, verifications under otis-verify and threads under otis-thread,
# each named by what it is about, an MR's iid or b-<branch> with slashes as %.
share=$(cd "$(dirname "$0")/../share" && pwd)
. "$share/claude-run.sh"
. "$share/repo.sh" || exit 1
common=$OTIS_GITDIR

# git-agent-list --open <dir> <back>: enter on a run's row, as fzf actions. Each
# run opens through the command that starts its kind, as V, C and D do: a fix run
# as its proposals (git-mr-fix, which shows the run itself while it is going),
# the rest as their steps (git-claude-view), and r there starts it again, which
# git-claude-view leaves to its caller (exit 3). Straight into git-claude-view,
# r would do nothing. One with nothing to start it from opens as its steps.
#
# <back> is what the board does once you leave what was opened.
if [ "$1" = --open ]; then
  dir=$2 back=$3
  key=${dir##*/}
  case ${dir%/*} in
    */gmr-fix) echo "execute(git-mr-fix '$key' '$(cat "$dir/range" 2>/dev/null)')+$back" ;;
    */otis-verify)
      case $key in
        b-*) echo "execute(git-verify --branch '$(printf '%s' "${key#b-}" | tr '%' '/')')+$back" ;;
        *) echo "execute(git-verify '$key')+$back" ;;
      esac ;;
    */gmr-watch) echo "execute(git-mr-watch '$key')+$back" ;;
    */otis-thread) echo "execute(otis-thread '$(printf '%s' "${key#b-}" | tr '%' '/')')+$back" ;;
    */gmr-claude)
      # The range it reviewed, from what resume would run: git-mr-claude --run <iid> <range>.
      range=$(sed -n 4p "$dir/cmd" 2>/dev/null)
      if [ -n "$range" ]; then echo "execute(git-mr-claude '$key' '$range')+$back"
      else echo "execute(git-claude-view '$dir')+$back"; fi ;;
    *) echo "execute(git-claude-view '$dir')+$back" ;;
  esac
  exit 0
fi
if [ "$1" = --forget ]; then
  dir=$2
  [ -d "$dir" ] || exit 0
  running "$dir" && { otis-popup say 'it is still running; x in its progress stops it'; exit 0; }
  git-confirm "forget $(cat "$dir/title" 2>/dev/null || basename "$dir")? its progress and what it brought back go" || exit 0
  rm -rf "$dir"
  exit 0
fi

# scan: every run, one tab-separated line each, unsorted and unformatted:
# state, started, ended, kind, directory, its last word, then for one that
# runs what it is doing now (Claude's last words to itself; a verification's
# tester's last command, with the criterion it is for) and a verification's
# criteria as glyphs (● verified, ✗ not, ◌ the tester on it, ● in, ○ to
# come), for the dashboard's row; then what otis calls its kind (run_label),
# and how many commits a thread's last turn brought back (otis-thread's
# came). It is what --data prints, for otis-list, which shows the running
# ones on the dashboard and has no business knowing where a run keeps itself.
doing() {
  tail -n 300 "$1/events.jsonl" 2>/dev/null | jq -rs --arg kind "$2" '
    def crit: capture("(^|[^a-zA-Z0-9_])(?<c>c[0-9]+)([^a-zA-Z0-9_]|$)"; "g") | .c;
    if $kind == "otis-verify" then
      ([.[] | select(.who == "tester" and .type == "tool")] | last) as $t
      | ([.[] | select(.type == "otis")] | last | .text // "") as $last
      | if $t and ($last | test("^(tester|judge steps|judge looked|got )")) then
          ([.[] | select(.who == "tester") | (.input.detail // .text // "") | crit] | last // "") as $c
          | ($c | if . == "" then "" else . + " · " end)
            + ($t.input.detail // $t.name | split("\n")[0] | if $t.name == "run_terminal_cmd" then "$ " + . else . end)
        else $last end
    else ([.[] | select(.type == "text")] | last | .text // "" | split("\n")[0]) end
    | gsub("[\t\n]"; " ") | .[0:200]' 2>/dev/null
}
dots() {
  [ -s "$1/plan.json" ] || return 0
  now=$(tail -n 300 "$1/events.jsonl" 2>/dev/null | jq -rs '[.[] | select(.who == "tester") | (.input.detail // .text // "") | capture("(^|[^a-zA-Z0-9_])(?<c>c[0-9]+)([^a-zA-Z0-9_]|$)"; "g") | .c] | last // ""' 2>/dev/null)
  for c in $(jq -r '.criteria[].id' "$1/plan.json" 2>/dev/null); do
    r=$(jq -r --arg c "$c" '.criteria[]? | select(.id == $c) | .result' "$1/verdict.json" 2>/dev/null)
    if [ "$r" = verified ]; then printf '●'
    elif [ "$r" = changed ]; then printf '?'
    elif [ -n "$r" ]; then printf '✗'
    elif [ "$c" = "$now" ]; then printf '◌'
    elif ls "$1/artifacts/$c"* >/dev/null 2>&1; then printf '●'
    else printf '○'; fi
  done
}
scan() {
  now=$(date +%s)
  for kind in $run_kinds; do
    label=$(run_label "$kind")
    for dir in "$common/$kind"/*/; do
      [ -d "$dir" ] || continue
      dir=${dir%/}
      [ -s "$dir/started" ] || continue
      # read, not cat: this runs for every run on every dashboard draw, and
      # a process a file a run was most of what the dashboard waited on.
      status= started= ended= last= came=
      read -r status 2>/dev/null < "$dir/status"
      read -r came 2>/dev/null < "$dir/came"
      read -r started 2>/dev/null < "$dir/started"
      read -r ended 2>/dev/null < "$dir/ended"
      state=$status
      if [ -z "$state" ]; then
        if running "$dir"; then state=running; else state=died; fi
      fi
      # Its last word: the run's own lines, not the agents', and never its
      # (long) final result. A run over for more than a few seconds (finish
      # says its last line just after writing its status) has its kept in
      # last-word, so it is read once rather than on every draw; any other
      # is read each time. Written aside and moved into place, as two boards
      # may scan at once.
      final=; [ -n "$status" ] && [ "${ended:-$now}" -lt $((now - 5)) ] 2>/dev/null && final=1
      if [ -z "$final" ] || [ ! "$dir/last-word" -nt "$dir/events.jsonl" ]; then
        tail -n 300 "$dir/events.jsonl" 2>/dev/null | jq -r 'select(.type == "otis") | .text' 2>/dev/null | tail -1 > "$dir/last-word.$$"
        IFS= read -r last < "$dir/last-word.$$"
        if [ -n "$final" ]; then mv "$dir/last-word.$$" "$dir/last-word"; else rm -f "$dir/last-word.$$"; fi
      else
        IFS= read -r last < "$dir/last-word"
      fi
      sub= dot=
      [ "$state" = running ] && { sub=$(doing "$dir" "$kind"); dot=$(dots "$dir"); }
      printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$state" "$started" "$ended" "$kind" "$dir" "$last" "$sub" "$dot" "$label" "$came"
    done
  done
}
# A read, so it never starts anything: otis-list resumes killed runs before
# it asks.
[ "$1" = --data ] || { echo "usage: git-agent-list --open <dir> <back> | --forget <dir> | --data" >&2; exit 2; }
scan
