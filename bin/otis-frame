#!/bin/sh
# otis-frame [-S <file>] <command...>: run a picker inside nvim, so the code
# it opens shows beside it (share/frame.lua). The picker fills the window
# until it opens a file, which otis-edit opens in this nvim rather than a
# new one; from then on the list keeps the left 40% and the code the rest.
# Enter puts the code on the symbol and you in it, ctrl-h comes back to the
# list and ctrl-l from the list goes to the code. q in the list quits nvim
# with it, unless a file has changes to save. -S has nvim source <file> as it
# starts: a review's comments (share/mr-comments.lua) for every file it opens.
# The command's output and exit status are its own, as if it had run alone.
#
# The command runs as it is where the editor is not nvim, or inside a frame
# already (a picker opened from a framed one), whose nvim opens its files.
# OTIS_FRAME says so to everything the picker runs.
src=
[ "$1" = -S ] && { src=$2; shift 2; }
ed=$(otis-config editor)
name=${ed%% *}
[ "${name##*/}" = nvim ] && [ -z "$OTIS_FRAME" ] || exec "$@"
share=$(cd "$(dirname "$0")/../share" && pwd)
d=$(mktemp -d) || exec "$@"
trap 'rm -rf "$d"' EXIT
# The command as a script for the terminal to run: its words quoted, and
# its output to a file, since the terminal's is the screen.
{
  printf exec
  for a; do printf " '%s'" "$(printf '%s' "$a" | sed "s/'/'\\\\''/g")"; done
  printf " > '%s'\n" "$d/out"
} > "$d/run"
set -- -c "lua dofile('$share/frame.lua').start()"
[ -n "$src" ] && set -- -c "source $src" "$@"
set -f
OTIS_FRAME=1 OTIS_FRAME_RUN=$d/run OTIS_FRAME_STATUS=$d/status $ed "$@" </dev/tty >/dev/tty
cat "$d/out" 2>/dev/null
exit "$(cat "$d/status" 2>/dev/null || echo 1)"
