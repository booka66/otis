#!/bin/sh
# otis-frame [-S <file>] <command...>: run a picker inside nvim, its list on
# the left and nvim where its preview was (share/frame.lua). The row you
# settle on shows there, a symbol's file at the symbol (the picker's --show,
# the open enter runs) and any other row its preview; enter opens it and
# takes you into it (--focus), ctrl-h back to the list and ctrl-l from the
# list to the code. q in the list quits nvim with it,
# unless a file has changes to save. -S has nvim source <file> as it starts:
# a review's comments (share/mr-comments.lua) for every file it shows. The
# command's output and exit status are its own, as if it had run alone.
#
# With otis.frame neovide (otis-config frame), or Neovide as the editor, the
# frame is a Neovide window, its own nvim's terminal running the picker, and
# everything else still opens in your editor. The command runs as it is where
# the editor is neither nvim nor Neovide, or inside a frame already (a picker
# opened from a framed one). OTIS_NVIM_FRAME, the frame's own
# directory, says to everything the picker runs that it is in one.
#
# otis-frame --open <path> <line> <col> <true|false>  the file on the right
#                                                     (otis-edit), read only;
#                                                     OTIS_FRAME_UNDERLINE,
#                                                     "<first> <last> <name>...",
#                                                     the names underlined
#                                                     between those lines there
# otis-frame --text <file> [<key>]                    a preview on the right,
#                                                     where <key> was left
# otis-frame --run <ex command> <arg>                 a command on the right
#                                                     (a review's :GmrDeleted)
# otis-frame --focus                                  into the code
# otis-frame --key <ctrl-d|ctrl-u|ctrl-e|ctrl-y|]|[>  a key of the picker's
#                                                     pane, pressed in the
#                                                     list, done in the code
# Each does nothing outside a frame, and the keys stay with the list.
# otis-frame --enter <path> -- <open command...>      enter's action, for a
#   picker's transform: in a frame, the open beside the list and then into
#   the code, the list never giving up the terminal (which redrew it whole,
#   and asked the terminal a question nvim's answered late, as keys), and
#   nothing on a row with no path; elsewhere the open, taking the terminal.
share=$(cd "$(dirname "$0")/../share" && pwd)
vs() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/''/g")"; }
remote() {
  [ -n "$OTIS_NVIM_FRAME" ] || exit 0
  exec nvim --server "$NVIM" --remote-expr "luaeval('dofile(_A[1]).$1', [$(vs "$share/frame.lua")$2])" >/dev/null
}
case $1 in
  --open) remote "open(_A[2], _A[3], _A[4], _A[5], _A[6])" ", $(vs "$2"), $3, $4, v:$5, $(vs "$OTIS_FRAME_UNDERLINE")" ;;
  --text) remote "text(_A[2], _A[3])" ", $(vs "$2")${3+, $(vs "$3")}" ;;
  --run) remote "run(_A[2], _A[3])" ", $(vs "$2"), $(vs "$3")" ;;
  --focus) remote "focus()" ;;
  --key) remote "key(_A[2])" ", $(vs "$2")" ;;
  --enter)
    p=$2; shift 3
    w=; for a; do w="$w '$(printf '%s' "$a" | sed "s/'/'\\\\''/g")'"; done
    if [ -z "$OTIS_NVIM_FRAME" ]; then printf 'execute(%s)\n' "${w# }"
    elif [ -n "$p" ]; then printf 'execute-silent(%s; otis-frame --focus)\n' "${w# }"; fi
    exit 0 ;;
esac
src=
[ "$1" = -S ] && { src=$2; shift 2; }
ed=$(otis-config editor)
name=${ed%% *}
name=${name##*/}
case $name in nvim|neovide) ;; *) exec "$@" ;; esac
[ -z "$OTIS_NVIM_FRAME" ] || exec "$@"
gui=
{ [ "$name" = neovide ] || [ "$(otis-config frame)" = neovide ]; } && command -v neovide >/dev/null 2>&1 && gui=1
d=$(mktemp -d) || exec "$@"
trap 'rm -rf "$d"' EXIT
# The command as a script for the terminal to run: its words quoted, and
# its output to a file, since the terminal's is the screen.
{
  printf exec
  for a; do printf " '%s'" "$(printf '%s' "$a" | sed "s/'/'\\\\''/g")"; done
  printf " > '%s'\n" "$d/out"
} > "$d/run"
set -- -c "lua dofile('$share/frame.lua').start()"
[ -n "$src" ] && set -- -c "source $src" "$@"
set -f
export OTIS_NVIM_FRAME=$d OTIS_NVIM_FRAME_RUN=$d/run OTIS_NVIM_FRAME_STATUS=$d/status
# Neovide's window waits here until it is closed (--no-fork), nvim's own
# arguments after its --.
if [ -n "$gui" ]; then neovide --no-fork -- "$@"
else $ed "$@" </dev/tty >/dev/tty; fi
cat "$d/out" 2>/dev/null
exit "$(cat "$d/status" 2>/dev/null || echo 1)"
