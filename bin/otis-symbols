#!/usr/bin/env -S zsh -f
# otis-symbols <prompt> <keys> [fzf options...]
# A change by symbol, drawn by hand rather than as an fzf list: git-symbols'
# picker and a review's (git-mr-files) open here. It takes what git-fzf takes,
# the keys as "key=label" pairs and fzf's --bind, --preview and
# --header-from-state, and does what those bindings say: execute,
# execute-silent, reload, transform, refresh-preview, pos, first, abort,
# accept and print, with a row's fields for {n}. So every key of the two
# pickers works as it did, from the same bindings, and the pickers stay the
# ones that say what a key does.
#
# The screen is laid out for reading a change: Claude's one sentence on it
# first, then how much of it is viewed, as a bar, and what is still coming
# in (the gloss, tsgo's callers); then the tree, drawn as one, with guides
# from each row to what it opens to, what the change did to a symbol as a
# glyph before its signature (~ its signature changed, + added, - removed,
# · its body alone), and on the right a row's threads, viewed and lines in
# columns of their own. The row under the cursor is the only one lit. The
# rows' parts come from git-symbols --rows, which lays them out for this
# list's width (OTIS_SYMBOLS_WIDTH); a row with none (a review read by file)
# is drawn as fzf would have drawn it.
#
# On a wide terminal the row's preview sits to the right, under a line
# saying where the row is (its file and line, and the rows it is under); on
# a narrow one, under the list. Previews are drawn in the background, the
# cursor's first and then the rows around it, and kept per row and width,
# so moving onto a row finds its preview drawn; a preview being drawn again
# shows the one before until it lands, never a blank pane. Each row keeps
# where its preview was scrolled, in the files git-fzf keeps them in
# (off.<row>), so enter opens where you are reading, as it did.
#
# Background work lands by itself: Claude's gloss, tsgo's callers, Claude's
# fixes for them and a review's threads each leave a file in the cache, and
# a change in one reloads the rows (under fzf they posted a reload to its
# port, which this has none of).
#
# / searches the rows, as fzf did: each word of it in a row's name or path.
# ? puts the keys and what the glyphs mean in the pane. The mouse is this
# screen's: a click picks a row, the wheel scrolls the preview or moves
# through the rows, and a drag in the preview selects its text and copies
# it; a then asks Claude about the lines, and c in a review comments on
# them. Each frame's timing goes to ~/.cache/otis/symbols.log
# (OTIS_SYMBOLS_TRACE).
#
# Where the picker's a asks Claude (git-symbols-ask), a opens a panel over
# the lower part of the list rather than leaving the screen: the row you are
# on and the diff stay in sight, and Claude's answers stream into the panel
# as they come. With OTIS_SYMBOLS_ASK set, the screen opens with the panel
# up and typing in it: a thread's change (otis-thread), where what you came
# to do is answer Claude. OTIS_SYMBOLS_WATCH names a file whose change
# means the change itself moved (a thread's turn that ended, its commits
# home), and the list is read again, as for --watch.
setopt extendedglob no_nomatch

[[ -n $OTIS_T_NAME && $OTIS_THEME == "$OTIS_T_WANT" ]] || eval "$(otis-theme --env)"
. ${0:A:h:h}/share/in-root.sh
in_root || eval "$(otis-config --env)"
export OTIS_ROWFMT=$(<${0:A:h:h}/share/rowfmt.awk)
wrap_awk=$(<${0:A:h:h}/share/pane-wrap.awk)
# Not under a picker: a script that would post to one must not find the one
# this was opened from.
unset FZF_PORT FZF_API_KEY
export GIT_FZF_STATE=${TMPDIR:-/tmp}/git-fzf.$$.$RANDOM$RANDOM
mkdir -m 700 $GIT_FZF_STATE || exit 1
st=$GIT_FZF_STATE
: > $st/lock; : > $st/by-id
mkdir $st/pv
trace=${OTIS_SYMBOLS_TRACE:-${XDG_CACHE_HOME:-$HOME/.cache}/otis/symbols.log}
mkdir -p ${trace:h} 2>/dev/null; : > $trace

# --- what it was asked to be -------------------------------------------------
# The keys: labels for the footer and ?, those after a lone | for ? alone.
title=${1% } spec=$2; shift 2
typeset -a hk hv hm
typeset -A bind
integer more=0
for pair in ${(s:,:)spec}; do
  [[ -z $pair ]] && continue
  [[ $pair == '|' ]] && { more=1; continue }
  [[ -n ${pair#*=} ]] && { hk+=("${pair%%=*}"); hv+=("${pair#*=}"); hm+=($more); }
done
preview= show= startacts= hdr=0 searching=0 watchfiles=()
# Your note on a selected word (a in a case's pane): typed in the footer, then saved with it (otis-words).
noting=0 nword= ntext= njson= ncase=
while (( $# )); do
  case $1 in
    --bind) if [[ $2 == start:* ]]; then startacts+=${startacts:++}${2#start:}; else bind[${2%%:*}]=${2#*:}; fi; shift 2 ;;
    --preview) preview=$2; shift 2 ;;
    # In a frame (otis-frame), what shows a row with a file beside the list.
    --show) show=$2; shift 2 ;;
    --header-from-state) hdr=1; shift ;;
    # A file whose change reloads the rows and previews, as the cache's do.
    --watch) watchfiles+=($2); shift 2 ;;
    --search) searching=1; shift ;;
    *) shift ;;
  esac
done

. ${0:A:h:h}/share/screen.zsh
keys_caller; keys_open "${REPLY:-${${title//\!<-> /}%% *}}" "$spec"
screen_start
# What an accept hands back, printed once the screen is given back.
typeset -a outq
at_quit() { (( $#outq )) && print -rl -- $outq; }

# --- the layout ------------------------------------------------------------------
# Side by side from 120 columns, as git-fzf had them (the preview's 55% at 66
# or more), the list 42% of it; under that the preview under the list. lw
# the list's width, lh its height; the pane at column px, row py, pw wide
# and ph high, its first two rows where the row is (phd). beside: the pane
# is right of the list in this terminal, so a row clears up to it and no more.
integer lw lh px py pw ph side beside phd=2
# In otis-frame's nvim, whose window beside this terminal is the pane.
integer framed=0
[[ -n $OTIS_NVIM_FRAME ]] && framed=1
typeset -a PH HB
# The pinned head whole (HB) when it is taller than its share of the pane
# (hroom rows), and how far it is scrolled (hoff): J and K, or the wheel
# over it, scroll it; the code under it keeps the rest of the pane.
integer hoff=0 hroom=0 ctw=0
layout() {
  if (( framed )); then
    # In a frame the list is this whole terminal, and the pane is nvim's
    # window beside it (otis-frame), as wide as the frame says. A row clears
    # to its end, or what one cut for a wider list left in the last column stayed.
    side=1 beside=0 lw=$(( W - 1 )) lh=$(( H - 2 )) px=$(( W + 2 )) py=1 ph=$(( H - 2 )) pw=0
    [[ -r $OTIS_NVIM_FRAME/cols ]] && pw=$(<$OTIS_NVIM_FRAME/cols)
    (( pw > 0 )) || pw=80
  elif (( W >= 120 )); then
    side=1 beside=1; (( lw = W * 30 / 100, lw < 44 ? (lw = 44) : 0 ))
    (( lh = H - 2, px = lw + 6, py = 1, pw = W - px, ph = H - 2 ))
  else
    side=0 beside=0 lw=$W; (( lh = (H - 2) * 45 / 100, py = lh + 2, ph = H - 2 - lh - 1, px = 1, pw = W - 1 ))
  fi
  # What you type in Claude's panel is this wide, from column 5: draw's
  # margin and the › before it (chat_frame).
  (( ctw = lw - 6 ))
  # What the rows and the previews are drawn for, for every command run
  # from here: --rows fits the signatures to the list, and a preview's
  # position (git-symbols --at, --peeks) is worked out at the pane's width.
  export OTIS_SYMBOLS_WIDTH=$lw FZF_COLUMNS=$W FZF_LINES=$H FZF_PREVIEW_COLUMNS=$pw FZF_PREVIEW_LINES=$(( ph - phd ))
  print -rn -- $pw > $st/cols; print -rn -- $(( ph - phd )) > $st/plines
}
float settle=0
resize() {
  local oh=$H ow=$W olw=$lw
  size
  (( H != oh || W != ow )) || return 1
  print -r -- "$EPOCHREALTIME resize ${ow}x$oh -> ${W}x$H" >> $trace
  layout; dirty=1 shown_rows=(); draw
  # The rows are cut to the list's width by --rows, so a new width reloads
  # them, once the size has held for 0.3s: a drag reloads once, not at
  # every width it passes through. The previews at the new width with them.
  (( settle = EPOCHREALTIME + 0.3 ))
  (( lw != olw )) && rewidth=1
}

# --- the rows --------------------------------------------------------------------
# raw: each row as the list printed it; rid its id (field 12, or a heading's
# last field); typ what it is (sym, callers, package, caller, file from
# --rows' parts; head for a heading; plain for a row with no parts); the
# parts, dep through err; hay what / searches in.
typeset -a raw rid typ dep fold kids chg add del vwd nop ndr nedge dim lab err cm hay gd gdw
integer loaded=0 wa=1 wd=1 wt=0 mr=0 bycase=0
load() {
  local line i
  local -a f
  bycase=0
  raw=() rid=() typ=() dep=() fold=() kids=() chg=() add=() del=() vwd=() nop=() ndr=() nedge=() dim=() lab=() err=() cm=() hay=()
  for line in ${(f)"$(<$1)"}; do
    f=("${(@ps:\t:)line}")
    raw+=("$line")
    rid+=("${f[12]:-$f[-1]}")
    if [[ -n $f[13] ]]; then typ+=("$f[13]")
    elif [[ -z $f[2] && ( -z $f[12] || $f[12] == gk-* ) ]]; then typ+=(head)
    else typ+=(plain); fi
    [[ $f[13] == sent && $f[26] == (case|also) ]] && bycase=1
    dep+=("${f[14]:-0}") fold+=("$f[15]") kids+=("$f[16]") chg+=("$f[17]") add+=("$f[18]") del+=("$f[19]")
    vwd+=("$f[20]") nop+=("$f[21]") ndr+=("$f[22]") nedge+=("$f[23]") dim+=("$f[24]") lab+=("$f[25]") err+=("$f[26]") cm+=("$f[27]")
  done
  # What / searches is worked out on the first search, not on every load:
  # it was a third of what a reload of a big change cost.
  hayok=0
  # What this list said beside its rows, in a directory of its own
  # (OTIS_SAID, reload): its widths, how much is viewed, Claude's sentence
  # and its footer. A list that says none of one says nothing of it.
  local d=$1.d
  [[ -s $d/layout ]] && read -r wa wd wt mr < $d/layout
  hdone=0 hall=0 hhead= hfoot=
  [[ -s $d/progress ]] && read -r hdone hall < $d/progress
  (( hdr )) && [[ -s $d/header ]] && hhead=$(<$d/header)
  [[ -s $d/footer ]] && hfoot=$(<$d/footer)
  guides
  loaded=1 dirty=1 rlw=0
}
# The views: a change read by case (a review's first), by symbol or by file.
# Which one a list is, is the state's (git-mr-files --toggle, git-symbols
# --files), read as the list is asked for (viewnow, kept in rview by the
# reload's number) and taken up with its rows (view). Each view keeps its
# last list (view.<name>), which lands again at once on coming back to it,
# and where you were in it (vat, vtop, vofs).
typeset -A rview vat vtop vofs
viewnow() {
  if [[ -e $st/by-file ]]; then REPLY=files
  elif [[ -n $GMR_IID && ! -e $st/by-symbol ]]; then REPLY=cases
  else REPLY=symbols; fi
}
viewnow; view=$REPLY
# The row's fields as fzf numbers them, for {n}.
typeset -a fld
fields() { fld=("${(@ps:\t:)raw[${1:-$cur}]}"); }

# guides: the tree's lines, for each row at a depth, from the rows after it:
# whether a sibling comes after it (├ or └), and for each level above, whether
# the row it is under at that level has one (│ or nothing).
guides() {
  local -A seen
  local i d k s
  gd=() gdw=()
  for (( i = $#raw; i >= 1; i-- )); do
    if [[ $typ[i] == (head|plain|sent|more) || ( $typ[i] == file && $dep[i] == 0 ) ]]; then seen=(); gd[i]= gdw[i]=0; continue; fi
    d=$dep[i] s=
    for (( k = 1; k < d; k++ )); do [[ -n $seen[$k] ]] && s+="│  " || s+="   "; done
    if (( d > 0 )); then
      if [[ -n $seen[$d] ]]; then s+="├"; else s+="└"; fi
      # A call new to the change: ⇢ where the branch meets the row.
      if [[ -n $nedge[i] ]]; then s+=$A"⇢"$R$F" "; else s+="─ "; fi
    fi
    # Its width, three columns a level, kept: the colors in it would
    # otherwise have to be measured out of it on every row drawn.
    gd[i]=$s gdw[i]=$(( d > 0 ? 3 * d : 0 ))
    seen[$d]=1
    for k in ${(k)seen}; do (( k > d )) && unset "seen[$k]"; done
  done
}

# --- a row ---------------------------------------------------------------------
# RL: each row's line as drawn without the cursor, RU its width, both for
# the list's width; built once a load (or a resize), since a frame is then
# the lines in view and the cursor's lit. RX: the lines a row too long for
# the list goes on to under itself, a line each, never cut.
typeset -a RL RU RX
# wrapc <text> <room> <more room>: colored text in lines, the first room
# columns wide and each after it more room, broken after the last space, /
# or comma that fits, so a word goes down whole; a word longer than the room
# after its last _ or - that fits, or before a capital that starts a word in
# a name (replyModel|Test), else where the room ends. Each line opens with
# the colors in force where it starts. In reply.
wrapc() {
  local s=$1 tok st= bst= bst2= pv=
  integer lim=$2 more=$3 w=0 cw bk=0 bkw=0 bk2=0 bkw2=0
  local -a lt rest
  reply=()
  while [[ -n $s ]]; do
    if [[ $s == $e\[* && $s == (#b)($e\[[0-9\;:?]#[a-zA-Z])* ]]; then tok=$match[1]
    else tok=${s[1]}; fi
    s=${s[$#tok+1,-1]}
    if [[ $tok == $e* ]]; then
      lt+=("$tok")
      if [[ $tok == $e\[(0|)m ]]; then st=; else st+=$tok; fi
      continue
    fi
    cw=${(m)#tok}
    (( w )) && [[ $tok == [[:upper:]] && $pv == [[:lower:][:digit:]] ]] && bk2=$#lt bkw2=$w bst2=$st
    if (( w + cw > lim )); then
      (( ! bk && bk2 )) && bk=$bk2 bkw=$bkw2 bst=$bst2
      lim=$more
      if (( bk )); then
        reply+=("${(j::)lt[1,bk]}$R")
        rest=("${(@)lt[bk+1,-1]}"); lt=("$bst" "${(@)rest}"); (( w -= bkw ))
        # A break in what goes down after the one taken is still there to take.
        if (( bk2 > bk )); then (( bk2 -= bk - 1, bkw2 -= bkw )); else bk2=0; fi
        bk=0
      else
        reply+=("${(j::)lt}$R"); lt=("$st"); w=0 bk2=0
        [[ $tok == ' ' ]] && continue
      fi
    fi
    lt+=("$tok"); (( w += cw )); pv=$tok
    [[ $tok == [\ /,] ]] && bk=$#lt bkw=$w bst=$st
    [[ $tok == [_-] ]] && bk2=$#lt bkw2=$w bst2=$st
  done
  reply+=("${(j::)lt}")
}
# wrapon <indent> <room> <lines...>: RX for the row being drawn (rowline's
# i), each line under the indent, padded to the room so the cursor's light
# is as wide as the row's.
wrapon() {
  local x
  integer ind=$1 room=$2
  shift 2
  RX[i]=
  for x in "$@"; do vw "$x"; RX[i]+=${RX[i]:+$'\n'}${(l:ind:: :)}$x${(l:room - ind - REPLY:: :)}; done
}
cells() {
  local x=M
  [[ $chg[$1] == added ]] && x=A; [[ $chg[$1] == removed ]] && x=D
  fields $1
  if [[ $fld[9] == 1 ]]; then put "$G" $x; else put "$F" .; fi
  if [[ $fld[10] == 1 ]]; then [[ $fld[9] == 1 ]] && put "$A" $x || put "$Y" $x; else put "$F" .; fi
  put "" " "
}
# num <count>: the count as every screen shows one, a comma every three
# digits (share/rowfmt.awk's gk_num), in REPLY.
num() { local n=$1 s=; while (( $#n > 3 )); do s=,${n[-3,-1]}$s n=${n[1,-4]}; done; REPLY=$n$s; }
# rcells <row>: its cells on the right, in REPLY: threads, viewed, the
# lines. Each a cell, so they stay in their columns down the list, each
# count at the right of its column (gk_stat).
rcells() {
  local i=$1 line= dm=${dim[$1]:+$C}
  integer used=0
  if (( mr )); then
    # What Claude's review did with it, beyond the diff: opened its file, searched for it.
    case $cm[i] in read) put "$G" "● " ;; grep) put "$EL" "◐ " ;; *) put "" "  " ;; esac
    put "" "  "
    if (( nop[i] > 0 )); then put "$EL" "${(r:3:: :)${:-${nop[i]}}}"; else put "" "   "; fi
    if (( ndr[i] > 0 )); then put "$Y" "✎${(r:2:: :)ndr[i]}"; else put "" "   "; fi
  fi
  case $vwd[i] in
    all) put "" "    "; put "$G" "✓ " ;;
    */*) put "" "${(l:6-$#vwd[i]:: :)}"; put "$C" "$vwd[i]" ;;
    *) put "" "      " ;;
  esac
  put "" " "
  if (( add[i] > 0 )); then num $add[i]; put "${dm:-$G}" "${(l:wa+1:: :)${:-+$REPLY}}"; else put "" "${(l:wa+1:: :)}"; fi
  put "" " "
  if (( del[i] > 0 )); then num $del[i]; put "${dm:-$RM}" "${(l:wd+1:: :)${:-−$REPLY}}"; else put "" "${(l:wd+1:: :)}"; fi
  REPLY=$line
}
rowline() {
  local i=$1 t lc lcs cont rs
  integer w=$(( lw - 2 )) rz room ind lent
  line= used=0 RX[i]=
  case $typ[i] in
    head)
      # A heading of the list's own, or git-test-files': its words, the rule
      # it was drawn in dropped, the count first and what t does after it.
      fields $i; plain "$fld[1]"; t=${${REPLY//─/}## #}; t=${t%% #}
      if [[ $t == *' · '* ]]; then put "$C" "${(U)${t%% · *}}"; put "$F" "  ${t#* · }"
      else put "$C" "${(U)t}"; fi
      ;;
    plain)
      # Too long for the list, it goes on under itself where its last column
      # starts (a file's path, after its counts).
      fields $i; vw "$fld[1]"
      if (( REPLY <= w )); then line=$fld[1] used=$REPLY
      else
        plain "$fld[1]"; t=${REPLY[1,w]} ind=2
        [[ $t == (#b)(*\ \ ##)[^\ ]* ]] && ind=$#match[1]
        (( ind > w - 20 )) && ind=2
        wrapc "$fld[1]" $w $(( w - ind ))
        line=$reply[1]; vw "$line"; used=$REPLY
        wrapon $ind $w "${(@)reply[2,-1]}"
      fi
      ;;
    sent)
      # A part of the story: its number and its title's first line; the rest and its counts are the lines after (more).
      [[ $fold[i] == open ]] && put "$A" "▾ " || put "$A" "▸ "
      put "$A" "$cm[i]  "
      if [[ -n $dim[i] ]]; then put "$C" "$lab[i]"; else put "$B$T" "$lab[i]"; line+=$UB; fi
      ;;
    more)
      put "" "  "
      if [[ $err[i] != t ]]; then line+=$lab[i]; vw "$lab[i]"; (( used += REPLY ))
      elif [[ -n $dim[i] ]]; then put "$C" "$lab[i]"
      else put "$B$T" "$lab[i]"; line+=$UB; fi
      ;;
    *)
      (( wt )) && { [[ $typ[i] == sym ]] && cells $i || put "" "   "; }
      line+=$F$gd[i]; (( used += gdw[i] ))
      case $fold[i] in
        open) put "$A" "▾ " ;; closed) put "$A" "▸ " ;; quiet) put "$C" "▸ " ;; *) put "" "  " ;;
      esac
      # What the change did to it, a glyph; a caller, whether it breaks.
      case $typ[i]:$chg[i]:$err[i] in
        caller:*:x) put "$X" "✗ " ;; caller:*:fixed) put "$G" "✓ " ;; ref:*) put "$C" "↑ " ;;
        *:signature:*) put "$B$A" "~ "; line+=$UB ;; *:added:*) put "$G" "+ " ;; *:removed:*) put "$RM" "− " ;;
        sym:*|file:*) put "$F" "· " ;; *) put "" "  " ;;
      esac
      (( rz = 1 + (wa + wd + 4) + 6 + (mr ? 10 : 0) ))
      # Callers elsewhere have none of the right's cells: their words run on.
      [[ $typ[i] == (callers|package|caller) ]] && rz=0
      # The blank columns its right cells open with, short of the lines, it
      # lends to its name, one kept apart: a long name goes on along the row.
      if (( rz )); then
        rcells $i; rs=$REPLY t=${rs%%[^ ]*}
        (( lent = rz - 1 - (wa + wd + 4) ))
        (( $#t < lent )) && (( lent = $#t ? $#t - 1 : 0 ))
      fi
      lc=$lab[i]
      case $typ[i] in
        sym) if [[ -n $dim[i] || $chg[i] == removed ]]; then lcs=$C$lc; else lcs=$lc; fi ;;
        file)
          # Its folder dim, its name lit; a long path breaks after a /.
          local nm=${lc:t} dir=${lc:h}/
          [[ $lc == */* ]] || dir=
          lcs=$C$dir$R${${dim[i]:+$C}:-$T}$nm ;;
        callers) lcs=$lc ;;
        package) lcs=$EL$lc ;;
        caller|ref) lcs=$C$lc ;;
      esac
      # Whole, on as many lines as it takes, each under where it starts, the
      # tree's lines carried down beside it; the right's cells are on the
      # first, so the lines after it have the list's whole width.
      (( room = w - rz + lent - used ))
      [[ $fold[i] == (closed|quiet) && -n $kids[i] && $typ[i] == sym ]] && (( room -= 1 + ${#kids[i]} ))
      (( room < 12 )) && room=12
      vw "$lcs"
      if (( REPLY <= room )); then line+=$lcs$R; (( used += REPLY ))
      else
        wrapc "$lcs" $room $(( w - used ))
        line+=$reply[1]$R; vw "$reply[1]"; (( used += REPLY ))
        plain "$gd[i]"; t=${${${${REPLY//├/│}//└/ }//─/ }//⇢/ }
        # Under an open row its own line goes on down to what it opens to.
        if [[ $fold[i] == open ]]; then t+="│ "; else t+="  "; fi
        cont=${${wt:#0}:+   }$F$t$R"  "
        wrapon 0 $w "${(@)reply[2,-1]/#/$cont}"
      fi
      # How much is under a closed row, after its name.
      [[ $fold[i] == (closed|quiet) && -n $kids[i] && $typ[i] == sym ]] && put "$F" " ${kids[i]}"
      # The width so far is added up piece by piece (put, and the label and
      # the guide measured on their own), so the right's columns stand where
      # every other row has them without measuring the whole line again.
      (( used > w - rz + lent )) && { cut "$line" $(( w - rz + lent )); line=$REPLY; vw "$line"; used=$REPLY; }
      pad $(( w - rz + lent ))
      (( rz )) || { pad $w; RL[i]=$line$R RU[i]=$used; return; }
      line+=${rs[lent+1,-1]}; vw "${rs[lent+1,-1]}"; (( used += REPLY ))
      ;;
  esac
  pad $w
  RL[i]=$line$R RU[i]=$used
}

# --- the list --------------------------------------------------------------------
# L: its lines, LI the row each is (0 for none); vis the rows the cursor
# may land on, in order, the search applied.
typeset -a L LI vis
integer dirty=1 cur=0 top=0 rlw=0 npin=0
query=
integer hayok=0
buildhay() {
  local i
  local -a f
  hay=()
  for (( i = 1; i <= $#raw; i++ )); do
    f=("${(@ps:\t:)raw[i]}")
    plain "${f[25]:-$f[1]}"; hay+=("${(L)REPLY} ${(L)f[2]}")
  done
  hayok=1
}
matches() {
  local w
  [[ -z $query ]] && return 0
  (( hayok )) || buildhay
  [[ $typ[$1] == (head|more) ]] && return 1
  for w in ${=${(L)query}}; do [[ $hay[$1] == *"$w"* ]] || return 1; done
  return 0
}
# The headline: what this is, Claude's sentence on the change, how much of
# it is viewed, and what the rows' list said (the counts, what is still
# coming in).
headline() {
  local w=$1 t s hint=
  local -a words segs
  integer d=0 n=0 k bw
  L+=("") LI+=(0)
  line= used=0; put "" "  "
  # The MR, and how it is read: by symbol, or (a review's f) by file.
  t=$title
  if [[ $t == !* ]]; then put "$A" "${t%% *}"; put "" "  "; t=${${t#${t%% *}}# }; fi
  [[ $view == files ]] && t="by file"
  if [[ -n $GMR_IID ]]; then
    # A review's three tabs, the change's cases, its symbols and its files: the one shown lit, tab for the next.
    local tb
    for tb in cases symbols files; do
      [[ $tb == $view ]] && { put "$B$T" "$tb"; line+=$UB; } || put "$C" "$tb"
      [[ $tb != files ]] && put "" "  "
    done
    # What tab does, beside them where it fits, else on the line under them.
    hint="tab next · shift-tab back"
    if (( used + 3 + ${(m)#hint} <= w - 3 )); then put "$F" "   $hint"; hint=; fi
  else
    put "$B$T" "${t:-by symbol}"; line+=$UB
  fi
  (( rslow )) && { pad $(( w - 3 )); put "$F" "↻"; }
  L+=("$line") LI+=(0)
  [[ -n $hint ]] && L+=("  $F$hint$R") LI+=(0)
  L+=("") LI+=(0)
  # The title and the line under it stay put while the list scrolls (draw).
  npin=$#L
  if (( ! loaded )); then spin_frame; L+=("  $A$REPLY$R ${C}reading the change…$R") LI+=(0); return; fi
  # Claude's sentence, the list's header, wrapped to the list.
  if [[ -n $hhead ]]; then
    plain "$hhead"; words=(${=REPLY}); s=
    for t in $words; do
      if [[ -n $s ]] && (( ${(m)#s} + 1 + ${(m)#t} > w - 4 )); then L+=("  $T$s$R") LI+=(0); s=; fi
      s+=${s:+ }$t
    done
    [[ -n $s ]] && L+=("  $T$s$R") LI+=(0)
    L+=("") LI+=(0)
  fi
  # Viewed, as a bar, when there is something to view.
  d=$hdone n=$hall
  if (( n > 0 )); then
    (( bw = w / 3, bw > 30 ? (bw = 30) : 0, k = d * bw / n ))
    line="  "$G${(l:k::━:)}$F${(l:bw-k::─:)}$R"  "
    if (( d == n )); then line+=$G"all $n viewed"$R; else line+=$T"$d"$C" of $n viewed"$R; fi
    L+=("$line") LI+=(0)
  fi
  # What the list said, a piece a line as they fit, a piece too long for a
  # line wrapped under itself.
  if [[ -n $hfoot ]]; then
    segs=("${(@s: · :)${(j: · :)${(f)hfoot}}}") s=
    segs+=("")
    for t in "${segs[@]}"; do
      vw "$s · $t"
      if [[ -n $s ]] && { [[ -z $t ]] || (( REPLY > w - 4 )) }; then
        wrapc "$s" $(( w - 4 )) $(( w - 4 ))
        for s in "$reply[@]"; do L+=("  $s$R") LI+=(0); done
        s=
      fi
      s+=${s:+$C · $R}$t
    done
  fi
  local stale=($st/stale.*(N))
  (( $#stale )) && L+=("  ${X}could not refresh from GitLab: this is what it said last$R") LI+=(0)
  # One blank line before the rows, whatever the list had to say over them.
  [[ -n $L[-1] ]] && L+=("") LI+=(0)
}
# A row drawn once is kept by all it is drawn from (the list's width and
# columns, its guide, its line), so a reload that changed a few rows (v, l,
# h, a landing) draws those few, not the thousands around them.
typeset -A rlc ruc rxc
# MO, MP: for a line of the list that carries on a sentence (more), its row and the sentence's.
typeset -A MO MP LT
list() {
  local i first=1 ctx key sentrow=0 x
  if (( rlw != lw )); then
    RL=() RU=() RX=()
    ctx="$lw $wa $wd $wt $mr"
    (( $#rlc > 3 * $#raw + 200 )) && rlc=() ruc=() rxc=()
    for (( i = 1; i <= $#raw; i++ )); do
      key=$ctx$'\1'$gd[i]$'\1'$raw[i]
      if (( ${+rlc[$key]} )); then RL[i]=$rlc[$key] RU[i]=$ruc[$key] RX[i]=$rxc[$key]
      else rowline $i; rlc[$key]=$RL[i] ruc[$key]=$RU[i] rxc[$key]=$RX[i]; fi
    done
    rlw=$lw
  fi
  L=() LI=() vis=() MO=() MP=() LT=()
  headline $lw
  (( loaded )) || return
  if [[ -n $query ]] || (( searching )); then
    line="  "$A"/"$R" "$T$query$R
    (( searching )) && line+=$A"▏"$R
    L+=("$line") LI+=(0) L+=("") LI+=(0)
  fi
  for (( i = 1; i <= $#raw; i++ )); do
    matches $i || continue
    # The tree's own heading, over its first root: where to start, or,
    # turned over (b), the sinks.
    if [[ $typ[i] == more ]]; then L+=("  ${RL[i]}") LI+=(0); [[ -n $lab[i] ]] && MO[$#L]=$i MP[$#L]=$sentrow; continue; fi
    [[ $typ[i] == sent ]] && sentrow=$i first=0
    if (( first )) && [[ $typ[i] != (head|plain|file) ]]; then
      if [[ -e $st/up ]]; then L+=("  ${C}SINKS FIRST$R  ${F}what uses them under each · b turns it back$R")
      elif [[ -e $st/by-claude ]]; then L+=("  ${C}START HERE$R  ${F}in Claude's order · b for the sinks first$R")
      else L+=("  ${C}START HERE$R  ${F}by file and line · b for the sinks first$R"); fi
      LI+=(0); first=0
    fi
    if [[ $typ[i] == head ]]; then
      (( $#L > 0 )) && [[ -n $L[-1] ]] && { L+=("") LI+=(0); }
      L+=("  ${RL[i]}") LI+=(0)
      continue
    fi
    L+=("$i") LI+=($i)
    vis+=($i)
    # The lines it goes on to, lit with it.
    if [[ -n $RX[i] ]]; then
      for x in "${(@f)RX[i]}"; do L+=("  $x") LI+=(0); MP[$#L]=$i LT[$#L]=$x; done
    fi
  done
  (( $#raw )) || L+=("  ${C}nothing in it to read by symbol$R") LI+=(0)
  dirty=0
}
# The cursor onto a row it may land on: the one it was on if it still can,
# else the nearest after it.
settle_cur() {
  local i
  (( $#vis )) || return
  (( ${vis[(Ie)$cur]} )) && return
  for i in $vis; do (( i >= cur )) && { cur=$i; return; }; done
  cur=$vis[-1]
}
# unviewed <1|-1>: the next or the previous symbol not yet viewed, from the
# cursor; none left, the footer says so.
unviewed() {
  local at=${vis[(Ie)$cur]} i n
  (( $#vis )) || return
  for (( n = 1; n < $#vis; n++ )); do
    (( i = ((at - 1 + $1 * n) % $#vis + $#vis) % $#vis + 1 ))
    i=$vis[i]
    [[ $typ[i] == sym && $vwd[i] != all ]] && { go $i; return; }
  done
  flash="every symbol is viewed"
}
step() {
  local at=${vis[(Ie)$cur]}
  (( $#vis )) || return
  (( at += $1, at < 1 ? (at = 1) : 0, at > $#vis ? (at = $#vis) : 0 ))
  go $vis[at]
}
# go <row>: the cursor there, the preview's scroll put aside for the row it
# leaves and taken up for the one it lands on.
typeset -A offs
go() {
  (( $1 == cur )) && return
  (( pwant >= 0 )) && { poff=$pwant; pwant=-1; }
  (( cur )) && { offs[$rid[cur]]=$poff; }
  # The lit row slides there from wherever it has got to (litrow).
  cur=$1 sel=0
  poff=${offs[$rid[cur]]:-0}
}
# litrow: the list's rows lit now (LITI, indices into L) and how much
# (LITA): the cursor's, or, for 0.3s after it moves, the light on its way
# there from where it was, shared by the two rows it is between. lpos is
# where it is, for a move that starts before this one ends.
integer lon=0
float lt0=0 lfrom=0 lpos=0
typeset -a LITI LITA
litrow() {
  integer to=${LI[(ie)$cur]} a
  (( to <= $#LI )) || to=0
  LITI=($to) LITA=(1) lpos=$to
  (( lon && to && lfrom )) || { lon=0; return; }
  float t=$(( (EPOCHREALTIME - lt0) / 0.3 )) f
  (( t >= 1 )) && { lon=0; return; }
  (( t = t < 0.5 ? 4 * t * t * t : 1 - (-2 * t + 2) ** 3 / 2 ))
  (( lpos = lfrom + (to - lfrom) * t, a = int(lpos), f = lpos - a ))
  LITI=($a $(( a + 1 ))) LITA=($(( 1 - f )) $f)
}
# litline <row> <a>: a row of the list lit a of the way (REPLY).
integer ATr=250 ATg=189 ATb=47
[[ $OTIS_T_ATTENTION == (#b)*38\;2\;([0-9]##)\;([0-9]##)\;([0-9]##)* ]] && ATr=$match[1] ATg=$match[2] ATb=$match[3]
litline() {
  float a=$2
  if (( a >= 0.98 )); then REPLY=$A"▌ "$R$BG${RL[$1]//$R/$R$BG}$R; return; fi
  if (( a <= 0.02 )); then REPLY="  "$RL[$1]; return; fi
  local m g
  xmix $ATr $ATg $ATb $a; m=$e"[38;2;${REPLY}m"
  xmix $LBr $LBg $LBb $a; g=$e"[48;2;${REPLY}m"
  REPLY=$m"▌ "$R$g${RL[$1]//$R/$R$g}$R
}

# --- the preview ------------------------------------------------------------------
# Drawn per row and width in the background and kept; a render is running
# while its .tmp is there. gen goes up whenever what a preview is drawn from
# may have changed (refresh-preview, rows landing, background work landing);
# the pane shows the newest there is for the row until this gen's lands.
integer gen=0
lastpv= pfile= crumbfor= crumbline=
key() { local k=${1//\//%}; (( ${#k} > 200 )) && k=${k[-200,-1]}; REPLY=$k; }
# pvname <row> <width>: where its preview is kept, by its id and what it is:
# a file has the same id by symbol and by file, and a preview of each.
pvname() { key "$rid[$1]"; REPLY=$st/pv/$typ[$1].${REPLY:-none}.$2; }
shown() {
  pvname $cur $pw
  # This gen's, when it is there, whatever landed after it: a render of an
  # older gen that finished later is newer on disk, and stale.
  [[ -e $REPLY.$gen ]] && { REPLY=$REPLY.$gen; return }
  local -a have=($REPLY.<->(Nom))
  (( $#have )) || have=(${REPLY%.*}.<->.<->(Nom))
  REPLY=${have[1]}
}

# --- fading ------------------------------------------------------------------------
# The light on its way between two rows (litline) is mixed toward the
# terminal's background, which the screen asks the terminal for as it opens.
integer PBr=29 PBg=32 PBb=33 LBr=60 LBg=56 LBb=54
[[ $OTIS_T_CODEBG == (#b)*48\;2\;([0-9]##)\;([0-9]##)\;([0-9]##)* ]] && LBr=$match[1] LBg=$match[2] LBb=$match[3]
# pbask: the terminal's background (OSC 11), for fading into; kept as it
# was when the terminal does not say within a moment. Not asked in a frame:
# nvim's terminal answers late, and an answer after the moment came in as
# keys (its / opened a search with 0000/0000 typed in it).
pbask() {
  (( framed )) && return
  local r= c
  print -rnu $tty -- $'\e]11;?\e\\'
  while sysread -t 0.08 -s 1 -i $tty c; do
    r+=$c
    [[ $r == *($'\a'|$'\e\\') ]] && break
  done
  [[ $r == (#b)*rgb:([0-9a-fA-F]##)/([0-9a-fA-F]##)/([0-9a-fA-F]##)* ]] || return 0
  PBr=$(( 16#${match[1][1,2]} )) PBg=$(( 16#${match[2][1,2]} )) PBb=$(( 16#${match[3][1,2]} ))
}
# xmix <r> <g> <b> <a>: that color a of the way from the background (REPLY "r;g;b").
xmix() {
  REPLY="$(( int(PBr + ($1 - PBr) * $4 + 0.5) ));$(( int(PBg + ($2 - PBg) * $4 + 0.5) ));$(( int(PBb + ($3 - PBb) * $4 + 0.5) ))"
}

# --- a pinned head ----------------------------------------------------------------
# headroom: the rows a pinned head may take: two fifths of the pane, so the
# code under it always has the rest to itself (a head that took all but six
# rows left three lines of code, and cut its own end off).
headroom() { REPLY=$(( (ph - 2) * 2 / 5 )); (( REPLY < 6 )) && REPLY=6; }
# headview <room> <rows...>: the rows the pane shows of a head: all of them
# when they fit, else a window of them from hoff and a last row that says
# how much more there is and how to see it.
headview() {
  integer room=$1; shift
  if (( $# <= room )); then reply=("$@"); return; fi
  (( hoff > $# - room + 1 )) && hoff=$(( $# - room + 1 ))
  (( hoff < 0 )) && hoff=0
  local -a v=("${(@)argv[hoff+1,hoff+room-1]}")
  integer below=$(( $# - hoff - room + 1 ))
  # A rule across the pane, the note set in it: where this part ends and
  # the code begins.
  local note
  if (( below > 0 )); then note=" ↓ $below more line$( (( below == 1 )) || print s) · J scrolls this part, K back "
  else note=" end of this part · K back to its top "; fi
  v+=("${F}──${note}${(l:pw - 4 - ${(m)#note}::─:)}$R")
  reply=("${(@)v}")
}
# headscroll <rows>: J and K on a head taller than its room.
headscroll() {
  (( $#HB > hroom )) || return 1
  (( hoff += $1 ))
  headview $hroom "${(@)HB}"; PH=("${(@)reply}")
  return 0
}
# subst <text> <row>: fzf's {n} as the row's nth field, quoted; {q} the query.
subst() {
  local s=$1 n
  local -a f
  (( $2 )) && f=("${(@ps:\t:)raw[$2]}")
  while [[ $s == (#b)(*)\{([0-9]##|q)\}(*) ]]; do
    n=$match[2]
    if [[ $n == q ]]; then s=$match[1]${(qq)query}$match[3]; else s=$match[1]${(qq)f[n]}$match[3]; fi
  done
  REPLY=$s
}
render() {
  local w=$1 file=$2 i=$3
  subst "$preview" $i
  OTIS_PANE_MAP=1 FZF_PREVIEW_COLUMNS=$w zsh -fc "$REPLY" 2>/dev/null </dev/null > $file.raw
  wrapin $w $file
  rm -f $file.raw
}
# wrapin <width> <file>: a preview as it came (<file>.raw), wrapped to the
# pane, written through <file>.tmp into <file>, and where each line wrapped
# into <file>.cont (for a selection's copy). A preview that says what its lines
# are ("\036map N" and N lines: a case's, share/story-pane.mjs) has that
# beside it as <file>.map, each numbered as the line of the pane it is.
wrapin() {
  local w=$1 file=$2 raw=$2.raw tmp=$2.tmp first
  IFS= read -r first < $raw
  rm -f $tmp.map
  if [[ $first == $'\036'map\ <-> ]]; then
    integer n=${first#*map }
    sed -n "2,$(( n + 1 ))p" $raw > $tmp.map
    sed "1,$(( n + 1 ))d" $raw > $raw.body && mv -f $raw.body $raw
    IFS= read -r first < $raw
  fi
  if [[ $first == $'\036'pin\ <->* ]]; then
    # Pinned lines ("\036pin N" and N lines, draw): wrapped apart from the
    # rest, and the marker written after, with how many lines they wrapped
    # to, since the wrap drops the control character that marks it.
    integer n=${first#*pin }
    sed -n "2,$(( n + 1 ))p" $raw | LC_ALL=C awk -v w=$w -v cont=/dev/null "$wrap_awk" > $tmp.pin
    { print -r -- $'\036'"pin ${$(wc -l < $tmp.pin)// /}"
      cat $tmp.pin
      sed -n "$(( n + 2 )),\$p" $raw | LC_ALL=C awk -v w=$w -v cont=$tmp.cont "$wrap_awk"; } > $tmp
    rm -f $tmp.pin
  else
    LC_ALL=C awk -v w=$w -v cont=$tmp.cont "$wrap_awk" < $raw > $tmp
  fi
  # The map's lines are the preview's as it came: each onto every line of
  # the pane its line wrapped to (the wrap's pieces, in .cont).
  if [[ -s $tmp.map ]]; then
    LC_ALL=C awk -F'\t' 'BEGIN { OFS = "\t"; at = 1 }
      FILENAME == ARGV[1] { split($0, c, " "); piece[c[1]] = 1; next }
      { while (r < $1) { r++; s = at; at++; while (at in piece) at++ }
        for (o = s; o < at; o++) { $1 = o; print } }' $tmp.cont $tmp.map > $file.map
  else rm -f $file.map; fi
  rm -f $tmp.map
  mv -f $tmp.cont $file.cont 2>/dev/null
  mv -f $tmp $file
}
# want: the row you are on, drawn if it is not kept yet. One at a time: a
# row changed under you again and again (a key held) waits for the render
# out to finish, then draws the newest, rather than starting one each time.
integer wpid=0
want() {
  local f
  (( cur && pw > 0 )) && [[ -n $preview && $typ[cur] != head ]] || return 1
  (( framed )) && coderow $cur && return 1
  (( wpid )) && kill -0 $wpid 2>/dev/null && return 1
  pvname $cur $pw; f=$REPLY.$gen
  [[ -e $f || -e $f.tmp ]] && return 1
  : > $f.tmp
  render $pw $f $cur >/dev/null &!
  wpid=$!
}
# quick: how long work out may take before the screen says it is waiting
# (↻ by the title), and a view that landed waits for its row's preview.
float quick=0.3
# holding: a view has just landed (hold, quick after it did) and its row's
# preview is still being drawn. The view before stays up meanwhile, so a
# tab goes from the one to the other whole, never by way of a pane that
# says … while it draws; a preview slower than that is waited for no longer.
float hold=0
holding() {
  (( EPOCHREALTIME < hold && ! help && ${vis[(Ie)$cur]} )) && [[ -n $preview ]] || return 1
  shown; [[ -z $REPLY ]]
}
# warm: the rows around the cursor, a few either side, one after another,
# so j and k find them drawn. It stops at a gen or a width that is not the
# one it was started for.
warm() {
  (( pw > 0 && $#vis && ! framed )) && [[ -n $preview ]] || return
  print -r -- "$gen $pw" > $st/pv/gen
  local -a near
  local at=${vis[(Ie)$cur]} j
  for (( j = 1; j <= 6; j++ )); do
    (( at + j <= $#vis )) && near+=($vis[at+j])
    (( at - j >= 1 )) && near+=($vis[at-j])
  done
  {
    local i f g="$gen $pw"
    for i in $near; do
      [[ $(<$st/pv/gen) == $g ]] || break
      pvname $i $pw; f=$REPLY.$gen
      [[ -e $f || -e $f.tmp ]] && continue
      : > $f.tmp
      render $pw $f $i
    done
  } >/dev/null &!
}
# Where the row is, over its preview: its file and line, and the rows it is
# under, by name.
crumb() {
  local i=$cur p s n
  local -a steps names
  (( cur )) || { REPLY=; return }
  fields $i
  line= used=0
  case $typ[i] in
    sym|ref|caller|file|plain)
      p=$fld[2]
      if [[ -n $p ]]; then
        [[ $p == */* ]] && put "$C" "${p:h}/"
        put "$T" "${p:t}"; [[ -n $fld[3] && $fld[3] != 1 || $typ[i] == (sym|ref) ]] && put "$C" ":$fld[3]"
      fi
      case $chg[i] in
        signature) put "$C" "  ·  "; put "$A" "signature changed" ;;
        added) put "$C" "  ·  "; put "$G" "added" ;;
        removed) put "$C" "  ·  "; put "$RM" "removed" ;;
        body) [[ $typ[i] == (sym|ref) ]] && { put "$C" "  ·  "; put "$C" "body changed"; } ;;
      esac
      [[ $typ[i] == caller ]] && { put "$C" "  ·  "; put "$C" "not in the change"; }
      ;;
    callers) put "$C" "callers elsewhere, which the change did not touch" ;;
    package) put "$C" "package "; put "$EL" "$lab[i]" ;;
    sent)
      case $err[i] in
        story) put "$T" "change ${cm[i]// /}" ;;
        case) put "$T" "route ${cm[i]// /}" ;;
        also) put "$T" "route ${cm[i]// /}, which the author never mentions" ;;
        support) put "$T" "also changed, to support it" ;;
        *) (( bycase )) && put "$T" "changed lines no case runs" || put "$T" "in the change, in no part" ;;
      esac ;;
  esac
  # The way down to it: each step's name, a member's with its class. A ↑
  # row's is the way down to where its symbol is drawn whole.
  local under="under "
  if [[ $typ[i] == ref ]]; then steps=("${(@s:>:)fld[28]}") under="drawn whole under "
  else steps=("${(@s:>:)rid[i]}"); fi
  if (( $#steps > 1 )); then
    for s in $steps[1,-2]; do
      [[ $s == callers ]] && { names+=("callers"); continue; }
      [[ $s == sentence:* ]] && { (( bycase )) && names+=("case ${s#sentence:}") || names+=("part ${s#sentence:}"); continue; }
      n=${s#*\#}; n=${n#type }; n=${n//+/.}
      names+=("$n")
    done
    put "$C" "  ·  $under"; put "$T" "${(j: › :)names}"
  fi
  cut "$line" $(( pw - 1 )); REPLY=$REPLY
}

# --- what the keys mean on this row ------------------------------------------------------
# symkeys: for the row under the cursor, what a key does there, in rkl (key
# → label; an empty label is a key that does nothing on it, which the footer
# leaves out). A key not named keeps its label. From what the row already
# says, so it costs the footer nothing.
typeset -A rkl
symkeys() {
  local i=$cur
  rkl=()
  (( i )) || return
  case $typ[i] in
    head|plain) rkl=(l "" h "" v "" i "" c "" F "" space "" y "") ; return ;;
    sent)
      rkl=(i "" c "" F "" space "" y "")
      if [[ $fold[i] == open ]]; then rkl[l]="" rkl[h]="close it" rkl[enter]="close it"
      else rkl[h]="" rkl[l]="its symbols: ${kids[i]}" rkl[enter]="its symbols: ${kids[i]}"; fi
      if [[ $vwd[i] == all ]]; then rkl[v]="mark all under it not viewed"; else rkl[v]="mark all under it viewed"; fi
      return ;;
    # A ↑ row points at its symbol, drawn whole above: going there is what it
    # does, and a key left with no label here does nothing on it (handle).
    ref) rkl=(l "go to it" enter "go to it" v "" i "" F "" space ""); [[ -n $GMR_IID ]] && rkl[c]=""; return ;;
  esac
  case $fold[i] in
    closed|quiet) if (( kids[i] > 0 )); then rkl[l]="open it: ${kids[i]} under it"; else rkl[l]="open it"; fi; rkl[h]="" ;;
    open) rkl[l]=""; rkl[h]="close it" ;;
    *) rkl[l]=""; rkl[h]="" ;;
  esac
  if [[ $typ[i] == (sym|file) ]]; then
    if [[ $vwd[i] == all ]]; then rkl[v]="mark it not viewed"
    elif (( kids[i] > 0 )); then rkl[v]="mark it and all under it viewed"
    else rkl[v]="mark it viewed"; fi
  else rkl[v]=""; fi
  [[ $typ[i] == sym ]] || rkl[i]=""
  # c comments on a row's lines in a review; in ga it commits, whatever the row.
  [[ -n $GMR_IID && $typ[i] != (sym|file) ]] && rkl[c]=""
  # A caller the change breaks: Claude's fix is the thing to do.
  if [[ $typ[i] == caller && $err[i] == x ]]; then rkl[F]="make the proposed fix"; rkl[enter]="open the broken call"
  else rkl[F]=""; fi
  [[ $typ[i] == (callers|package) ]] && rkl[y]=""
  # The worktree's: staged, not staged, or some of each.
  if [[ -n ${bind[space]} ]]; then
    fields $i
    if [[ $fld[9] == 1 && $fld[10] != 1 ]]; then rkl[space]="unstage it"
    elif [[ $fld[9] == 1 ]]; then rkl[space]="stage the rest of it"
    elif [[ $typ[i] == (sym|file) ]]; then rkl[space]="stage it"
    else rkl[space]=""; fi
  fi
}

# --- the frame -------------------------------------------------------------------
integer help=0 poff=0 plen=0
flash=
typeset -a shown_rows shown_pane
# scroll <lines>: the preview moved, in one frame. A glide sent a frame of
# the whole pane every 10ms, which under a multiplexer stuttered and lagged
# rather than glided.
scroll() {
  local max
  (( max = plen - (ph - phd), max < 0 ? (max = 0) : 0 ))
  (( poff += $1, poff > max ? (poff = max) : 0, poff < 0 ? (poff = 0) : 0 ))
}
helplines() {
  local k v n
  P=()
  for (( n = 1; n <= $#hk; n++ )); do P+=("  ${A}${(r:9:: :)hk[n]}$R ${C}$hv[n]$R"); done
  P+=("")
  for k v in j/k move g/G "top, bottom (unless the list takes them)" / "search the rows" ctrl-d/u "scroll the preview" \
    ctrl-e/y "the preview a line" J/K "the part above the code, when it has more than fits (the wheel over it too)" \
    "]/[" "next, previous change in the preview" "./," "next, previous symbol not yet viewed" \
    drag "in the preview: text, copied, a diff's lines without the gutter; a asks Claude about them; a word: y you know it, n you don't, and Claude reads up on it, a say what it is yourself" \
    numbers "in a review, drag down a diff's line numbers, or tap one: those lines; c opens a box under them to write in, a flag's line with its comment typed in" \
    comment "in a case's pane, click one: c replies and e edits yours in a box under it, d deletes yours, r resolves it or opens it again" \
    ctrl-a "show or hide Claude's panel, where a asks it" \
    "?" "these keys" "q/esc" "back"; do
    P+=("  ${A}${(r:9:: :)k}$R ${C}$v$R")
  done
  P+=("" "  ${B}${T}a row$R" ""
    "  ${B}${A}~$R$C its signature changed   $G+$R$C added   $RM−$R$C removed   $F·$R$C its body alone$R"
    "  ${A}▸$R$C closed, the count after its name what is under it   ${A}▾$R$C open   $C▸ dim: nothing under it not drawn above already, or all viewed$R"
    "  $C↑$R$C drawn whole above: l goes to it   ${A}⇢$R$C a call new to this change   $G✓$R$C viewed   ${C}3/5$R$C of what is under it   ${X}✗$R$C a caller the change breaks$R"
    "  ${G}●$R$C in a review, the agent's review opened it in the file   ${EL}◐$R$C searched for it   neither: read in the diff alone$R")
  [[ -s $st/legend ]] && P+=("" "  ${B}${T}in full$R" "" "${(@f)$(<$st/legend)}")
  panewrap $(( pw - 2 ))
}
# --- the frame ---------------------------------------------------------------------
# In a frame (otis-frame) the pane is nvim: the row the cursor settles on
# shows there, a row with a file by --show (the open enter runs, which in a
# frame shows it beside the list) and any other its preview, or ? the keys.
# One at a time: a row passed while one is out is skipped, and the newest
# shows once it lands.
integer fpid=0
fshown=
coderow() { [[ -n $show ]] && fields $1 && [[ -n $fld[2] ]]; }
framepush() {
  (( framed && cur )) || return
  (( fpid )) && kill -0 $fpid 2>/dev/null && return
  local what cmd key="$typ[cur] $rid[cur]"
  if (( help )); then what="text $st/help.txt" key='?'
  elif coderow $cur; then what="row $rid[cur]"
  else shown; [[ -n $REPLY ]] || return; what="text $REPLY"; fi
  [[ $what == $fshown ]] && return
  fshown=$what
  if [[ $what == row\ * ]]; then subst "$show" $cur; cmd=$REPLY
  else
    (( help )) && print -rl -- "${(@)P}" > $st/help.txt
    # A row drawn again as something lands keeps nvim's scroll, by its key.
    cmd="otis-frame --text ${(qq)${what#text }} ${(qq)key}"
  fi
  { unlisten; zsh -fc "$cmd" </dev/null >/dev/null 2>&1 } &!
  fpid=$!
  print -r -- "$EPOCHREALTIME frame $what" >> $trace
}
draw() {
  local t0=$EPOCHREALTIME
  local y i f s lo=0 hi=0 body foot rows lrows
  (( dirty )) && list
  settle_cur
  # The panel, over the list's lower part, the rows above it, the diff
  # left in full.
  chh=0
  if (( chat )); then
    (( chh = lh * 55 / 100, chh < 9 ? (chh = 9) : 0, chh > lh - 3 ? (chh = lh - 3) : 0 ))
    (( lw != ccw )) && chat_load
    chat_frame
  fi
  # While music plays or is paused, the foot of the list on a wide screen is
  # the music's, a place of its own the rows scroll above, as the panel's is
  # the panel's. A cliamp left stopped has nothing to draw there.
  mh=0
  (( side && ! chh && $#mlab && lh >= 24 )) && mh=9
  # The cursor's row in view, the headline kept when it fits. Its title
  # (npin lines) stays put over the rows, which scroll under it by top.
  (( rows = lh, lrows = lh - chh - mh ))
  for (( y = 1; y <= $#LI; y++ )); do (( LI[y] == cur && cur )) && { lo=$y; hi=$y; break; }; done
  while (( hi && ${MP[$(( hi + 1 ))]:-0} == cur )); do (( hi++ )); done
  (( hi > top + lrows )) && (( top = hi - lrows ))
  (( lo > 0 && lo <= top + npin )) && (( top = lo - 1 - npin ))
  (( lo > 0 && hi <= lrows )) && top=0
  # The pane: the preview, or ? its keys.
  local head=
  if (( help )); then helplines; pfile=; PH=() HB=() phd=2; head="  ${B}${T}keys, and what the glyphs say$R"
  elif (( cur )) && [[ -n $preview ]]; then
    # The preview read and split once when it lands, not every frame: a
    # frame of a scroll is then the lines it shows and nothing else.
    shown; lastpv=$REPLY
    if [[ $REPLY != $pfile || -z $pfile ]]; then
      pfile=$REPLY
      if [[ -n $REPLY ]]; then P=("${(@f)$(<$REPLY)}"); else P=("${F}…$R"); fi
      # One kept from another width, until this width's lands: cut to the pane.
      [[ ${pfile:t} == *.(#b)(<->).<-> && $match[1] != $pw ]] && clip $pw
      # A preview's first lines can be pinned (a case's head: "\036pin N"
      # and N lines): held under where the row is while the rest scrolls,
      # the pane's head that much taller. All but six rows of the pane at
      # most, so there is always some code to scroll; what does not fit
      # scrolls.
      PH=() HB=() hoff=0 phd=2
      if [[ $P[1] == (#b)$'\036'pin\ (<->) ]]; then
        integer np=$match[1]
        headroom; hroom=$REPLY
        HB=("${(@)P[2,np+1]}")
        headview $hroom "${(@)HB}"
        PH=("${(@)reply}") P=("${(@)P[np+2,-1]}") phd=$(( 2 + $#reply ))
      fi
      # A preview can say where it opens (off.<row>), which a row not
      # scrolled yet takes.
      if [[ -n $REPLY ]] && (( ! ${+offs[$rid[cur]]} && poff == 0 )); then
        key "$rid[cur]"
        [[ -r $st/off.$REPLY ]] && { poff=$(( $(<$st/off.$REPLY) - 1 )); (( poff < 0 )) && poff=0; offs[$rid[cur]]=$poff; }
      fi
    fi
    # The preview a key asked for has landed: its scroll with it.
    (( pwant >= 0 )) && [[ -n $pfile ]] && (( ${pfile##*.} >= pgen )) && { poff=$pwant; pwant=-1; }
    if [[ $rid[cur] != $crumbfor ]]; then crumb; crumbline=$REPLY crumbfor=$rid[cur]; fi
    head=$crumbline
  else P=() pfile= PH=() HB=() phd=2
  fi
  (( box )) && box_frame
  (( plen = $#P + bshown ))
  local -a fr pr
  litrow
  for (( y = 1; y <= rows; y++ )); do
    i=$(( y > npin ? y + top : y ))
    s=
    if (( y > lrows )); then (( chh )) && s="  ${CF[y - lrows]}"
    elif (( i <= $#L )); then
      if (( LI[i] )); then
        f=$LI[i]
        if (( ${LITI[(Ie)$i]} )); then litline $f $LITA[${LITI[(Ie)$i]}]; s=$REPLY
        else s="  "$RL[f]; fi
      elif (( cur && ${MP[$i]:-0} == cur )); then
        if (( ${+LT[$i]} )); then s=$LT[$i]; else s=$RL[$MO[$i]]; fi
        s=$A"▌ "$R$BG${s//$R/$R$BG}$R
      else s=$L[i]$R; fi
    fi
    # Beside the pane, the list's side cleared first (ECH, which leaves the
    # pane be), then the rule between them.
    (( beside )) && s=$e"[${lw}X"$s$e"[$(( lw + 1 ))G"$R"  "$F"│"$R
    fr+=("$s")
  done
  if (( ! side )); then
    fr+=("$F${(l:W::─:)}$R")
  fi
  for (( y = 1; y <= ph && ! framed; y++ )); do
    if (( y == 1 )); then pr+=("$head")
    elif (( y < phd + 1 )); then pr+=("${PH[y-2]}")
    else
      f=$(( y - phd + poff )) s=
      if (( bshown && f > bline )); then
        (( f <= bline + bshown )) && { pr+=("$BXS[f - bline]"); continue }
        (( f -= bshown ))
      fi
      if (( f <= $#P )); then
        if (( sel && f >= s1 && f <= s2 )); then selected $f; s=$REPLY; else s=$P[f]; fi
      fi
      pr+=("$s")
    fi
  done
  # The blank rows under the list, beside the pane, and under the pane:
  # where the music's background may move.
  local -a sp
  integer lb=$(( lrows - $#L + top ))
  (( lb < 0 )) && lb=0
  (( side && ! chh && lb + mh > 0 )) && sp+=("1 $lw $(( lrows + mh )) $(( lb + mh ))")
  (( ! framed && ph - phd > plen - poff )) && sp+=("$(( side ? px : 2 )) $(( side ? W - px + 1 : W - 1 )) $(( py + ph - 1 )) $(( ph - phd - plen + poff ))")
  music_space $sp
  # The footer: a note a key left, or what enter does and the keys to reach
  # for first, as many as fit.
  music_rule; fr+=("$REPLY")
  foot="  "
  if [[ -s $st/note ]]; then foot+=$A$(<$st/note)$R; rm -f $st/note
  elif [[ -n $flash ]]; then
    foot+=$A$flash$R; flash=
  elif (( bfocus )); then
    foot+=$Y"$btitle"$R$C" $bwhere"$R
    [[ $GMR_KIND == mine ]] || foot+=$C"   ·   S submits your drafts"$R
    foot+=$C"   ·   "$A"ctrl-u"$R$C" clears it  "$A"esc"$R$C" puts it away, c on the lines brings it back"$R
    cut "$foot" $(( W - 1 )); foot=$REPLY
  elif spinning; then spin_foot
  elif (( sel == 1 && selgut )) && [[ -n $selr && -n $GMR_IID ]]; then
    local sd=${selr%% *} sw=${selr#* }
    if [[ $sd == *,* ]]; then sw="lines ${${sd%,*}/old/-}${${sd%,*}/new/+}${sw% *}–${${sd#*,}/old/-}${${sd#*,}/new/+}${sw#* }"
    elif [[ ${sw% *} == ${sw#* } ]]; then sw="line ${sw% *}"; else sw="lines ${sw/ /–}"; fi
    [[ $sd == old ]] && sw+=" (removed)"
    [[ -n $selpath ]] && sw="${selpath:t} $sw"
    foot+=$B$A"c"$R$B$T" comment on $sw"$UB$R$C"   ·   esc lets go"$R
  elif (( sel == 1 )) && [[ -n $selthread && -n $GMR_IID ]]; then
    # A thread taken in a case's pane: what can be done to it. A draft is
    # yours, and has no thread to reply to or resolve yet.
    local -a tf=(${=selthread})
    if [[ $tf[4] == true ]]; then foot+=$B$A"e"$R$B$T" edit"$UB$R"  "$A"d"$R$T" delete"$R$C" this draft"$R
    else
      foot+=$B$A"c"$R$B$T" reply"$UB$R"  "$A"e"$R$T" edit"$R"  "$A"d"$R$T" delete"$R$C" your comment in it"$R
      [[ $tf[2] == true ]] && { foot+="  "$A"r"$R$T; [[ $tf[3] == true ]] && foot+=" reopen it"$R || foot+=" resolve it"$R; }
    fi
    foot+=$C"   ·   esc lets go"$R
  elif (( noting )); then foot+=$A"what is "$R$B$T"$nword"$UB$R$A"? "$R$T"$ntext"$R$A"▏"$R$C"   ⏎ saves it  ·  esc drops it"$R
  elif (( searching )); then foot+=$A"/"$R$T" type to search the rows · enter or esc to stop · esc again clears it"$R
  elif (( cfocus )); then
    chat_busy && foot+=$B$A"ctrl-c"$R$B$T" stops it"$UB$R$C"   ·   "$R
    foot+=$A"⏎"$R$C" asks  "$A"⇧⏎"$R$C" newline  "$A"tab"$R$C" an idea  "$A"↑↓"$R$C" scroll  "$A"ctrl-f"$R$C" in Claude Code  "$A"/new"$R$C" starts over  "$A"esc"$R$C" back to the rows  "$R$A"ctrl-a"$R$C" hides it"$R
    cut "$foot" $(( W - 1 )); foot=$REPLY
  else
    local n v used_=2 room
    (( room = W - 14 ))
    (( chat )) && { foot+=$A"a"$R$C" asks Claude  "$A"ctrl-a"$R$C" hides it   ·   "$R; (( used_ += 34 )); }
    symkeys
    for (( n = 1; n <= $#hk; n++ )); do
      [[ $hk[n] == enter ]] || continue
      v=$hv[n]; (( ${+rkl[enter]} )) && v=$rkl[enter]
      [[ -n $v ]] && { foot+=$B$A"⏎ "$v$UB$R$C"   ·   "$R; (( used_ += ${(m)#v} + 8 )); }
    done
    foot_keys
  fi
  fr+=("$foot")
  # Only the rows that changed go out, the list's and the pane's apart, so
  # a move sends the two rows it lit and unlit and the pane.
  body=
  (( $#shown_rows )) || { body+=$e'[2J'; shown_pane=(); }
  local srow
  for (( y = 1; y <= $#fr; y++ )); do
    [[ $fr[y] == "$shown_rows[y]" ]] && continue
    (( y <= rows )) && srow=$y || { (( side )) && srow=$y || srow=$(( y <= rows + 1 ? y : y + ph )); }
    body+=$e"[$srow;1H"$fr[y]$R
    (( ! beside || y > rows )) && body+=$e'[K'
  done
  for (( y = 1; y <= $#pr; y++ )); do
    [[ $pr[y] == "$shown_pane[y]" ]] && continue
    if (( side )); then body+=$e"[$(( py + y - 1 ));$(( px - 2 ))H  "$pr[y]$R$e'[K'
    else body+=$e"[$(( py + y - 1 ));1H "$pr[y]$R$e'[K'; fi
  done
  shown_rows=("${fr[@]}") shown_pane=("${pr[@]}")
  local t1=$EPOCHREALTIME
  print -rnu $tty -- $body
  framepush
  print -r -- "$EPOCHREALTIME frame cur=$cur build=$(( int((t1 - t0) * 1000) )) write=$(( int((EPOCHREALTIME - t1) * 1000) )) bytes=${#body} key=${kt:+$(( int((EPOCHREALTIME - kt) * 1000) ))} keys=$nk" >> $trace
  kt= nk=0
}

# --- what the keys do ----------------------------------------------------------------
# The list, reloaded in the background: the newest asked for wins, and the
# keys keep working on the rows there are meanwhile. lastlist is the last
# one asked for, the list a resize and a landing reload with.
typeset -a rpid
integer rgen=0 rgot=0 gotogen=0 rslow=0
float rt0=0
lastlist= fulllist= goto=
reload() {
  local cmd=$1
  lastlist=$cmd
  # Another view, kept from when it last showed, lands at once as it was,
  # and its list over it when that comes.
  viewnow
  if [[ $REPLY != $view && -e $st/view.$REPLY ]]; then
    (( rgen++ )); rview[$rgen]=$REPLY
    local -a said=($st/view.$REPLY.d/*(N))
    mkdir $st/list.$rgen.d; (( $#said )) && ln -f $said $st/list.$rgen.d/
    ln -f $st/view.$REPLY $st/list.$rgen
  fi
  (( rgen++ )); rview[$rgen]=$REPLY
  mkdir $st/list.$rgen.d
  (( $#rpid )) || rt0=$EPOCHREALTIME
  # l on a ↑ row (git-symbols --open) names the row its symbol is drawn whole
  # at, for this reload to land on: a list asked for before it has not opened
  # the rows above that one.
  if [[ -r $st/goto ]]; then goto=$(<$st/goto) gotogen=$rgen; rm -f $st/goto; fi
  { OTIS_SAID=$st/list.$rgen.d OTIS_LIST_WRAPS=1 zsh -fc "$cmd" > $st/list.$rgen.tmp 2>/dev/null </dev/null; mv -f $st/list.$rgen.tmp $st/list.$rgen } >/dev/null &!
  rpid+=($!)
}
landed() {
  local p f
  integer n newest=0
  for p in $rpid; do kill -0 $p 2>/dev/null || rpid=(${rpid:#$p}); done
  local -a got=($st/list.<->(N))
  for f in $got; do n=${f##*.}; (( n > newest )) && newest=n; done
  (( newest > rgot )) || return 1
  rgot=$newest
  for f in $got; do (( ${f##*.} < newest )) && rm -rf $f $f.d; done
  for n in ${(k)rview}; do (( n < newest )) && unset "rview[$n]"; done
  local was=$rid[cur] old=${(j:\n:)raw} i infile=
  integer fall=$pcur turn=0
  # Another view: where you were in this one put aside, and where you were
  # in that one taken up; the first time, the row of the file you are on,
  # else its first row. Its frame waits for that row's preview (holding).
  if [[ $rview[$newest] != $view ]]; then
    turn=1 fall=1
    if (( cur )); then offs[$was]=$poff; fields; infile=$fld[2]; fi
    vat[$view]=$was vtop[$view]=$top vofs[$view]=${(pj:\0:)${(@kv)offs}}
    view=$rview[$newest]
    offs=(${(ps:\0:)vofs[$view]}) was=$vat[$view] top=${vtop[$view]:-0}
    (( hold = EPOCHREALTIME + quick ))
  fi
  unset "rview[$newest]"
  load $st/list.$newest
  rm -rf $st/view.$view.d; mv $st/list.$newest.d $st/view.$view.d; mv -f $st/list.$newest $st/view.$view
  # The cursor stays on the row it was on, by its id (fzf's --track).
  cur=0
  if [[ -n $was ]]; then for (( i = 1; i <= $#rid; i++ )); do [[ $rid[i] == $was ]] && { cur=$i; break; }; done; fi
  if (( ! cur )) && [[ -n $infile ]]; then
    for (( i = 1; i <= $#raw; i++ )); do [[ $typ[i] != head && ${raw[i]#*$'\t'} == $infile$'\t'* ]] && { cur=$i; break; }; done
  fi
  (( cur )) || cur=$fall
  (( cur > $#raw )) && cur=$#raw
  list; settle_cur
  # Still on the row it was on: its scroll as you left it a moment ago, not
  # as it was when you came onto it (offs is kept when you leave a row), or
  # every landing in the background sent the preview back to the top.
  if (( cur && ! turn )) && [[ $rid[cur] == $was ]]; then offs[$was]=$poff
  elif (( cur )); then poff=${offs[$rid[cur]]:-0}; fi
  # The previews again once the rows are not the rows they were drawn for.
  [[ ${(j:\n:)raw} != $old ]] && { (( gen++ )); warm; }
  if (( gotogen && rgot >= gotogen )); then
    for (( i = 1; i <= $#rid; i++ )); do [[ $rid[i] == $goto ]] && { go $i; break; }; done
    gotogen=0
  fi
  return 0
}
integer pcur=1
# Before a command runs: the scroll of the row it is about where git-symbols
# reads it (off.<row>, git-fzf-scroll's). After: read back, since --peeks and
# --uses move it.
offout() {
  (( cur )) || return
  key "$rid[cur]"
  if (( poff > 0 )); then print -r -- $(( poff + 1 )) > $st/off.$REPLY; else rm -f $st/off.$REPLY; fi
}
offin() {
  (( cur )) || return
  key "$rid[cur]"
  local o=1
  [[ -r $st/off.$REPLY ]] && o=$(<$st/off.$REPLY)
  (( poff = o - 1, poff < 0 ? (poff = 0) : 0 ))
  offs[$rid[cur]]=$poff
}
# run <actions> <row> [then...]: fzf's actions, as a binding or a transform
# gives them, then the chains after them; a command that answers runs in the
# background (share/screen.zsh's spawn), and what comes after it waits there.
run() {
  local s=$1 name arg i c q depth open close out
  integer row=$2
  local -a then_=("${@[3,-1]}")
  while [[ -n $s ]]; do
    if [[ $s == (#b)([a-z-]##)([\(\[])* ]]; then
      name=$match[1] open=$match[2] s=${s#$name$open} depth=1 q=0
      [[ $open == '(' ]] && close=')' || close=']'
      for (( i = 1; i <= $#s; i++ )); do
        c=$s[i]
        if (( q )); then [[ $c == "'" ]] && q=0; continue; fi
        if [[ $c == "'" ]]; then q=1
        elif [[ $c == $open ]]; then (( depth++ ))
        elif [[ $c == $close ]]; then (( --depth == 0 )) && break; fi
      done
      arg=${s[1,i-1]} s=${s[i+1,-1]}
    elif [[ $s == (#b)([a-z-]##):(*) ]]; then name=$match[1] arg=$match[2] s=
    else name=${s%%+*} arg= s=${s#$name}; fi
    s=${s#+}
    subst "$arg" $row; arg=$REPLY
    case $name in
      execute)
        # The frame stays up while the command gets going: it says so.
        flash="${bykey:-…}${bykey:+…}"; draw
        offout; run_tty "$arg"; offin; resize ;;
      execute-silent|transform)
        spawn $name "$arg" $row "$s" "${then_[@]}"; return ;;
      reload) pcur=$cur; reload "$arg" ;;
      refresh-preview) (( gen++ )) ;;
      pos) (( arg > 0 && arg <= $#raw )) && go $arg ;;
      first|top) (( $#vis )) && go $vis[1] ;;
      abort) quit 130 ;;
      accept) (( cur )) && outq+=("$raw[cur]"); quit 0 ;;
      print) outq+=("$arg") ;;
      # The footer, the prompt, binding and unbinding: this screen's own.
    esac
  done
  (( $#then_ )) && run "$then_[1]" $row "${then_[@]:1}"
}
# act <key>: its binding, for the row under the cursor, or, while another
# key's command is out, once that lands (uq). A binding that
# redraws the preview and moves its scroll (p keeps the line at the top
# where it is, with notes above it now) holds the scroll it had until the
# new preview lands, then takes both in one frame, rather than the old
# preview jumping to the new place and then changing under it.
integer pwant=-1 pgen=0
typeset -A held
lastn=
act() {
  busy && { (( ${uq[(Ie)$1]} )) || uq+=($1); return }
  local was=$poff g=$gen
  symkeys
  local bykey=${${rkl[$1]:-${hv[${hk[(ie)$1]}]}}:-$1}
  run "$bind[$1]" $cur
  if (( gen != g && poff != was )); then pwant=$poff pgen=$gen poff=$was; fi
  dirty=1
}
# --- the mouse -------------------------------------------------------------------
# The selection is share/screen.zsh's (sel, s1..s2 over P, the pane's lines).
# selrange: the file lines the selection covers, as "side first last" for
# git-mr-say, in selr. Its ends are the first and the last line of the
# diff in it, each on its own side: a line the change kept or added by its
# new number, one it removed by its old, and "old,new" when the two ends
# differ, as GitLab numbers a range that starts on a removed line. Nothing
# in i's view, whose diffs are other symbols', some in other files.
# A case's pane says what its lines are (its map, pmap): there the ends are
# the lines of code of the one place the first is in (a function of the
# route, or a line a thread is on), selpath their file, and code in a file
# the change does not touch is none. A selection on one thread's lines and
# no code is that thread, in selthread: its id, resolvable, resolved, draft.
selr= selpath= selthread= selsay=
selrange() {
  local n t g o nw one fs ls fl ll at= th=
  local -a f
  selr= selpath= selthread= selsay=
  [[ -r $st/uses-for && $(<$st/uses-for) == $rid[cur] ]] && return
  pmap
  if (( $#PMAP )); then
    for (( n = s1; n <= s2; n++ )); do
      f=("${(@ps:\t:)PMAP[$n]}")
      case $f[1] in
        line)
          if [[ -z $at ]]; then
            [[ $f[6] == 1 ]] || { (( selgut )) && flash="that code is not in this change, so GitLab takes no comment on it"; return; }
            at=$f[9] selpath=$f[2] fs=$f[3] fl=$f[4] selsay=$f[10]
          fi
          [[ $f[9] == $at ]] && ls=$f[3] ll=$f[5] ;;
        thread) one="$f[2] $f[3] $f[4] $f[5]"; [[ -z $th ]] && th=$one; [[ $th == $one ]] || th=- ;;
      esac
    done
    if [[ -n $fs ]]; then
      if [[ $fs == $ls ]]; then selr="$fs $fl $ll"; else selr="$fs,$ls $fl $ll"; fi
    elif [[ -n $th && $th != - ]]; then selthread=$th; fi
    return
  fi
  for (( n = s1; n <= s2; n++ )); do
    plain "$P[n]"; t=$REPLY; g=${t%%│*}
    [[ $t == *│* && $g == *⋮* ]] || continue
    o=${${g%%⋮*}// /} nw=${${g#*⋮}// /}
    if [[ $nw == <-> ]]; then one="new $nw"
    elif [[ $o == <-> ]]; then one="old $o"
    else continue; fi
    [[ -z $fs ]] && { fs=${one% *} fl=${one#* }; }
    ls=${one% *} ll=${one#* }
  done
  [[ -n $fs ]] || return
  if [[ $fs == $ls ]]; then selr="$fs $fl $ll"; else selr="$fs,$ls $fl $ll"; fi
}
# ongutter <line> <column>: whether that is on a diff's line numbers, before
# its code: the columns a case's pane puts before it (PCOL), or delta's
# "old ⋮ new │".
ongutter() {
  local -a pc
  pmap
  if [[ $PMAP[$1] == line$'\t'* ]]; then pc=(${=PCOL[$1]}); (( $2 < pc[1] )); return; fi
  (( $#PMAP )) && return 1
  plain "$P[$1]"; gut "$REPLY"
  (( REPLY > 0 && $2 < REPLY ))
}
# pmap: what the pane's lines are, when its preview says (wrapin's .map), as
# PMAP, a line of P to what it is, and PCOL, a line of code or of a
# paragraph to the columns its code or words are in, with + after for a
# piece of the line above it, and _ for one that goes on from it after a
# space (a copy takes the code or words alone, and the pieces as one line).
typeset -A PMAP
pmapof=
pmap() {
  [[ $pmapof == $pfile ]] && return
  local l n what
  local -a f
  pmapof=$pfile PMAP=() PCOL=()
  [[ -n $pfile && -s $pfile.map ]] || return
  for l in ${(f)"$(<$pfile.map)"}; do
    n=${l%%$'\t'*} what=${l#*$'\t'}
    PMAP[$n]=$what
    f=("${(@ps:\t:)what}")
    case $f[1] in
      line)
        PCOL[$n]="$f[7] $f[8]"
        [[ $PMAP[$(( n - 1 ))] == $what ]] && PCOL[$n]+=" +" ;;
      text)
        PCOL[$n]="$f[2] $f[3]"
        case $f[4] in cut) PCOL[$n]+=" +" ;; word) PCOL[$n]+=" _" ;; esac ;;
    esac
  done
}
inpane() { (( y >= py + phd && y < py + ph && (side ? x >= px : 1) )); }
mouse() {
  local r=${1#$e\[<} b up
  integer x y l c
  [[ ${r[-1]} == m ]] && up=1
  r=${r[1,-2]}; b=${r%%;*}; r=${r#*;}; x=${r%%;*}; y=${r#*;}
  (( y > H - 2 )) && return
  (( l = y - py - phd + 1 + poff, c = x - (side ? px : 2) + 1, c < 1 ? (c = 1) : 0 ))
  # While you type in the box a click is not taken, though the wheel
  # scrolls; its rows sit in the pane between the pane's own lines.
  (( bfocus && b != 64 && b != 65 )) && return
  (( bshown && l > bline )) && (( l = l > bline + bshown ? l - bshown : bline ))
  # The panel's: the wheel scrolls what Claude said, a click types in it,
  # and on what you typed puts the cursor there (from column 5: layout).
  if (( chat && y > lh - chh && y <= lh && (side ? x < lw : 1) )); then
    if (( b == 64 )); then (( coff += 3 ))
    elif (( b == 65 )); then (( coff -= 3, coff < 0 ? (coff = 0) : 0 ))
    elif (( b == 0 && ! up )); then
      if (( cfocus && y > lh - cin )); then
        textrows "$ctext" $cat_ $ctw
        (( l = cfirst + y - (lh - cin + 1), c = x - 5, c < 0 ? (c = 0) : 0 ))
        (( c > $#TR[l] ? (c = $#TR[l]) : 0, cat_ = TS[l] - 1 + c ))
      fi
      cfocus=1
    fi
    return
  fi
  if (( b == 64 || b == 65 )); then
    # Over a pinned head taller than its room: that head.
    if (( y > py && y < py + phd && (side ? x >= px : 1) )) && headscroll $(( b == 64 ? -3 : 3 )); then :
    elif inpane || (( ! side && y >= py )); then scroll $(( b == 64 ? -3 : 3 ))
    else step $(( b == 64 ? -1 : 1 )); fi
    return
  fi
  if inpane || (( sel == 2 )); then
    if (( b == 0 && ! up )); then
      sel=2 sa=$l ca=$c sb=$l cb=$c seltxt= selgut=0
      ongutter $l $c && selgut=1
    elif (( b == 32 && sel )); then sb=$l cb=$c
    elif (( up && sel == 2 )); then
      sb=$l cb=$c sel=1
      pmap
      # Pressed on the line numbers: a tap is that line, a drag down them
      # those lines, to comment on (c) or ask about (a); nothing is copied.
      if (( selgut )); then
        ends; selrange
        [[ -n $selr ]] || sel=0 selgut=0
      elif (( sa == sb && ca == cb )); then
        sel=0 selr= selpath= selthread=
        # A click on a thread in a case's pane takes the whole thread: c, e,
        # d and r act on it (handle).
        if [[ $PMAP[$l] == thread$'\t'* ]]; then
          integer t0=$l t1=$l
          while [[ $PMAP[$(( t0 - 1 ))] == $PMAP[$l] ]]; do (( t0-- )); done
          while [[ $PMAP[$(( t1 + 1 ))] == $PMAP[$l] ]]; do (( t1++ )); done
          sel=1 sa=$t0 ca=1 sb=$t1 cb=$pw
          ends; selrange
        fi
      else
        # Anywhere else it is text: copied, the lines it covers kept for a.
        ends; shown; copy $REPLY.cont 0; selrange; selthread=
        # A word or a few on one line: y says you know it, n that you don't (otis-words).
        [[ -n $seltxt && $seltxt != *$'\n'* ]] && (( ${#seltxt} <= 80 )) && flash+="  ·  y you know it, n you don't, a say what it is"
      fi
    fi
    (( sel )) && ends
    return
  fi
  # A click on the music under the rows (mh) is on no row.
  if (( b == 0 && ! up && y <= lh - mh )) && (( side ? x < lw : 1 )); then
    local at=$(( y > npin ? y + top : y ))
    # A row's own line, or one it goes on to.
    (( at <= $#LI && LI[at] > 0 )) && go $LI[at]
    (( at <= $#LI && LI[at] == 0 && ${MP[$at]:-0} > 0 )) && go $MP[$at]
  fi
}
# ]/[: the next or the last change in the preview, a run of lines on a diff's
# background (the peeks' code background aside), put in the pane's middle.
hunk() {
  local -a runs
  integer i on=0 s want=-1 mid
  for (( i = 1; i <= $#P; i++ )); do
    if [[ $P[i] == *$e'[48;'* && ( $CODEBG == $e'[m' || $P[i] != *$CODEBG* ) ]]; then
      (( on )) || { s=$i; on=1; }
    elif (( on )); then runs+=("$s $(( i - 1 ))"); on=0; fi
  done
  (( on )) && runs+=("$s $#P")
  local r a z
  if (( $1 > 0 )); then
    for r in $runs; do a=${r% *} z=${r#* }; (( mid = (a + z) / 2 - (ph - phd) / 2, (z - a) > ph - phd ? (mid = a - 3) : 0 )); (( mid > poff )) && { want=$mid; break; }; done
  else
    for r in ${(Oa)runs}; do a=${r% *} z=${r#* }; (( mid = (a + z) / 2 - (ph - phd) / 2, (z - a) > ph - phd ? (mid = a - 3) : 0 )); (( mid < poff )) && { want=$mid; break; }; done
  fi
  (( want >= 0 )) || return
  scroll $(( want - poff ))
}

# --- Claude, beside it -------------------------------------------------------------
# a types into the panel; enter sends the question in the background
# (git-symbols-ask --send), with the row you are on then, or the lines
# selected in the preview, and the answer streams into the conversation's
# chat file, which the panel draws, over the lower part of the list. esc
# gives the keys back to the tree, the panel still up, so you move about
# between questions; a types in it again, and esc once more closes it.
# What you type wraps, the rows growing to half the panel; shift-enter
# starts a new line and a paste goes in whole, its lines with it.
# ctrl-a shows or hides it from anywhere, the conversation kept. tab puts in a question that fits the row
# (--starters), ctrl-c stops an answer, /new starts over, and ctrl-f opens
# the conversation in Claude Code, full screen, for what the panel's Claude
# cannot do: edit, or ask a permission. ctpl is the picker's a, the row's
# fields still {n}; cafter what the binding does after it (a reload), run
# when Claude has drafted a comment.
integer chat=0 cfocus=0 cat_=0 coff=0 cstn=0 chh=0 ccw=0 cwas=0 cdrafted=0 cin=0 cfirst=1
float csent=0
ctext= cdir= caskl= ctpl= cafter= csig=
typeset -a CL cst CF
[[ ${bind[a]} == (#b)execute\((git-symbols-ask [^\)]##)\)(*) ]] && ctpl=$match[1] cafter=${match[2]#+}
# askcmd <mode>: the picker's git-symbols-ask in that mode, for the row.
askcmd() { subst "${ctpl/git-symbols-ask/git-symbols-ask $1}" $cur; }
chat_open() {
  if [[ -z $cdir ]]; then askcmd --dir; cdir=$(zsh -fc "$REPLY" 2>/dev/null </dev/null); fi
  [[ -n $cdir ]] || { flash="could not work out where this change's conversation goes"; return }
  chat=1 cfocus=1 caskl=$1 cstn=0
  askcmd --starters
  cst=("${(@f)$(OTIS_ASK_LINES=$1 zsh -fc "$REPLY" 2>/dev/null </dev/null)}")
  cst=(${cst:#})
}
# chat_busy: an answer is coming (or was just asked for, and its script has
# not said so yet).
chat_busy() {
  local p
  (( EPOCHREALTIME - csent < 2 )) && return 0
  [[ -r $cdir/busy ]] || return 1
  p=$(<$cdir/busy)
  kill -0 ${p:-0} 2>/dev/null
}
# chat_where: what the next question is about, for the panel's top line.
chat_where() {
  local n
  REPLY=
  (( cur )) || return
  fields $cur
  if [[ -n $caskl ]]; then
    n=${caskl#* }
    REPLY=${fld[2]:t}:${n% *}
    [[ ${n% *} != ${n#* } ]] && REPLY+=-${n#* }
    return
  fi
  case $typ[cur] in
    sym|caller) n=${rid[cur]##*>}; n=${n#*\#}; n=${n#type }; REPLY=${n//+/.} ;;
    file) REPLY=$fld[2] ;;
  esac
}
chat_send() {
  local q=${${ctext##[[:space:]]#}%%[[:space:]]#}
  [[ -n $q ]] || return
  if [[ $q == /(new|clear) ]]; then
    chat_busy && { flash="Claude is still answering: ctrl-c stops it first"; return }
    rm -f $cdir/{session,head,chat}
    ctext= cat_=0 coff=0 csig= CL=()
    flash="a new conversation"
    return
  fi
  chat_busy && { flash="Claude is still answering: ctrl-c stops it"; return }
  askcmd --send
  OTIS_ASK_QUESTION=$q OTIS_ASK_LINES=$caskl zsh -fc "$REPLY" </dev/null >/dev/null 2>&1 &!
  csent=$EPOCHREALTIME ctext= cat_=0 coff=0 caskl= cstn=0 cwas=1
}
chat_stop() {
  local p
  [[ -r $cdir/busy ]] && p=$(<$cdir/busy)
  [[ -n $p ]] && kill $p 2>/dev/null
  csent=0
}
chat_full() {
  chat_busy && { flash="Claude is still answering: wait, or ctrl-c stops it"; return }
  run "execute($ctpl)${cafter:++$cafter}" $cur
  csig=
}
chat_key() {
  local k=$1 n
  keyname "$k"; n=$REPLY
  case $k in
    $'\t') n=tab ;; $'\x06') n=ctrl-f ;; $'\x01') n=ctrl-a ;;
  esac
  case $n in
    enter) chat_send ;;
    esc) cfocus=0 ;;
    ctrl-a) chat=0 cfocus=0 ;;
    ctrl-c) if chat_busy; then chat_stop; else cfocus=0; fi ;;
    ctrl-f) chat_full ;;
    tab)
      # The next idea, while what is typed is none of your own.
      (( $#cst )) && [[ -z $ctext || $ctext == $cst[cstn] ]] && { (( cstn = cstn % $#cst + 1 )); ctext=$cst[cstn] cat_=$#cst[cstn]; } ;;
    # A row up or down in what you type, and past its first or last, what was said.
    up) lineedit ctext cat_ "$k" $ctw || (( coff += 3 )) ;;
    down) lineedit ctext cat_ "$k" $ctw || (( coff -= 3, coff < 0 ? (coff = 0) : 0 )) ;;
    page-up) (( coff += chh / 2 )) ;;
    page-down) (( coff -= chh / 2, coff < 0 ? (coff = 0) : 0 )) ;;
    *) lineedit ctext cat_ "$k" $ctw ;;
  esac
}
# inline <line>: a line of Claude's markdown as the panel shows it, **bold**
# and `code` lit; a pair the wrap broke in two loses its marks.
inline() {
  local s=$1
  [[ $s == *'**'* ]] && { s=${(S)s//(#b)\*\*(*)\*\*/$B$match[1]$UB}; s=${s//\*\*/}; }
  [[ $s == *'`'* ]] && s=${(S)s//(#b)\`([^\`]##)\`/$A$match[1]$T}
  REPLY=$s
}
# chat_load: the chat file (git-symbols-ask's: Claude's words, and lines of
# its own after \001 and a letter) as the panel's lines, wrapped to it, in CL.
chat_load() {
  local l t pre ind lk= f=$cdir/chat
  integer w=$(( lw - 5 )) code=0 inq=0
  CL=() cdrafted=0 ccw=$lw
  [[ -s $f ]] || return
  local -a src=("${(@f)$(<$f)}")
  (( $#src > 800 )) && src=($src[-800,-1])
  for l in "${src[@]}"; do
    [[ $l == $'\x01U '* ]] || inq=0
    case $l in
      $'\x01U '*)
        # A question's lines after its first go on under it.
        if (( inq )); then pre="  "
        else pre="$A› $R"; [[ -n $CL[-1] ]] && CL+=(""); fi
        code=0 cdrafted=0 lk=U inq=1
        wrap "${l:3}" $(( w - 2 ))
        (( $#reply )) || CL+=("")
        for t in $reply; do CL+=("$pre$B$T$t$R"); pre="  "; done ;;
      $'\x01O '*) fit "${l:3}" $(( w - 2 )); CL+=("  $F$REPLY$R" ""); lk=O ;;
      $'\x01T '*)
        [[ $l == *'drafting a comment' ]] && cdrafted=1
        # A note says what Claude does next, so it sits on what came before.
        [[ $lk != O && -z $CL[-1] ]] && (( $#CL )) && CL[-1]=()
        lk=T
        fit "${l:3}" $(( w - 2 )); CL+=("$F· $REPLY$R") ;;
      $'\x01E '*) wrap "${l:3}" $w; for t in $reply; do CL+=("$X$t$R"); done ;;
      $'\x01S '*) CL+=("$F${l:3}$R") ;;
      '```'*) code=$(( !code )) ;;
      *)
        if (( code )); then fit "$l" $(( w - 2 )); CL+=("  $C$REPLY$R"); continue; fi
        if [[ -z ${l//[[:space:]]/} ]]; then [[ -n $CL[-1] ]] && CL+=(""); continue; fi
        pre= ind= lk=x
        if [[ $l == (#b)([[:space:]]#)([-*]|[0-9]##.)[[:space:]]##(*) ]]; then
          pre="$match[1]$match[2] " l=$match[3]; ind=${(l:${#pre}:: :)}
          pre=${pre/[-*] /• }
        elif [[ $l == (#b)\#\##[[:space:]]##(*) ]]; then l="**$match[1]**"; fi
        wrap "$l" $(( w - ${#pre} ))
        for t in $reply; do inline "$t"; CL+=("$T$pre$REPLY$R"); pre=$ind; done ;;
    esac
  done
  while (( $#CL )) && [[ -z $CL[1] ]]; do shift CL; done
}
# chat_tick: the chat file grew, or the answer ended; true when the panel
# wants drawing again. Once an answer that drafted a comment ends, the
# picker's reload after a runs, so the draft shows on its row.
chat_tick() {
  local sig= r=1
  local -a cs
  zstat -A cs +size -- $cdir/chat 2>/dev/null && sig=$cs[1]
  zstat -A cs +mtime -- $cdir/chat 2>/dev/null && sig+=.$cs[1]
  [[ $sig != $csig ]] && { csig=$sig; chat_load; r=0; }
  if (( cwas )) && ! chat_busy; then
    cwas=0 r=0
    (( cdrafted )) && [[ -n $cafter ]] && run "$cafter" $cur
  fi
  return $r
}
# chat_frame: the panel's chh lines, in CF: its top line (whether Claude is
# answering, and what a question now would be about), what was said, the
# newest at the bottom unless scrolled, and the rows you type on (cin of
# them, from row cfirst of what you typed, ctw wide: layout).
chat_frame() {
  local s where ch
  integer rows last first max i
  local -a rc IN
  CF=()
  chat_where; where=$REPLY
  line= used=0
  put "$F" "── "; put "$B$A" "Claude"; line+=$UB
  if chat_busy; then put "$A" "  ✦ answering"; (( csent > 0 )) && put "$C" " $(( int(EPOCHREALTIME - csent) ))s"; fi
  [[ -n $where ]] && { put "$C" "  · asking about "; put "$T" "$where"; }
  put "" " "
  cut "$line" $(( lw - 4 )); line=$REPLY; vw "$line"
  CF+=("$line$F${(l:lw - 2 - REPLY::─:)}$R")
  # What you type, wrapped: as many rows as it takes up to half the panel,
  # the cursor a lit cell on the last of them shown when there are more.
  if (( cfocus )); then
    textrows "$ctext" $cat_ $ctw; rc=(${=REPLY})
    (( cin = (chh - 1) / 2, cin > $#TR ? (cin = $#TR) : 0, cfirst = rc[1] - cin + 1, cfirst < 1 ? (cfirst = 1) : 0 ))
    for (( i = cfirst; i < cfirst + cin; i++ )); do
      s=$TR[i]
      (( i == rc[1] )) && { ch=${s[rc[2]+1]:- }; s=${s[1,rc[2]]}$e"[7m$ch"$e"[27m${s[rc[2]+2,-1]}"; }
      if (( i == 1 )); then IN+=("$A› $R$T$s$R"); else IN+=("  $T$s$R"); fi
    done
    [[ -z $ctext ]] && IN[1]+=$F" ask Claude"${cst:+ · tab for ideas}$R
  else
    IN=("$F› a to ask$R") cin=1
  fi
  (( rows = chh - 1 - cin ))
  if (( ! $#CL )) && (( cfocus )); then
    CF+=("")
    wrap "Each question goes with the row you are on when you send it." $(( lw - 4 ))
    for s in $reply; do CF+=("$C$s$R"); done
    CF+=("" "${C}tab puts in one of these:$R")
    for s in $cst; do fit "$s" $(( lw - 6 )); CF+=("  $T$REPLY$R"); done
    if [[ -s $cdir/session ]]; then
      CF+=("")
      wrap "the conversation so far is in Claude Code: ctrl-f" $(( lw - 4 ))
      for s in $reply; do CF+=("$F$s$R"); done
    fi
  else
    (( max = $#CL - rows, max < 0 ? (max = 0) : 0, coff > max ? (coff = max) : 0 ))
    (( last = $#CL - coff, first = last - rows + 1, first < 1 ? (first = 1) : 0 ))
    (( $#CL )) && CF+=("${(@)CL[first,last]}")
  fi
  while (( $#CF < chh - cin )); do CF+=(""); done
  CF=("${(@)CF[1,chh-cin]}" "${(@)IN}")
}

# --- a comment, typed under its lines -------------------------------------------------
# c on lines taken in the pane, or on a thread to reply in it, opens a box
# right under them, the code and whatever is above it still in sight. What
# you type wraps in it; enter saves it behind the screen (git-mr-say, the
# text given), a draft until S submits them all, or on your own MR sent at
# once, and the box stays, saying so, until the pane comes back with the
# comment drawn where it was. A flag's lines come with what to say to the
# author typed in (story-pane.mjs, the map's tenth field). esc puts it away,
# kept: c on the same lines brings it back. It opens and closes as a push,
# the code under it moving down and back a row at a time. bstate is empty
# while you type, then sending, sent, and closing as it goes.
integer box=0 bfocus=0 bline=0 bat=0 bshown=0 btarget=0 bindent=2 bkeep=0
float bshow=0 bclock=0 bsent=0
btext= bargs= bpre= bwhere= btitle= bstate= bpf= brid= bspun= berr=
typeset -a BX BXS
typeset -A bkept
# box_open <under line> <where it goes> <git-mr-say's args> <text> [<before>]:
# the box under that line of the pane, for those args, with the text kept
# for them (esc) or else the one given, and a command to run before it is sent.
box_open() {
  local t
  local -a pc
  bline=$1 bwhere=$2 bargs=$3 bpre=$5
  btext=${bkept[$bargs]-$4}; bat=$#btext
  case $GMR_KIND:$bargs in
    *:--edit*) btitle=editing ;;
    mine:--reply*) btitle=reply ;; mine:*) btitle=comment ;;
    *:--reply*) btitle="draft reply" ;; *) btitle=draft ;;
  esac
  # Its left edge where the code starts, else the diff's gutter, else the line's own indent.
  pmap
  if [[ -n $PCOL[$bline] ]]; then pc=(${=PCOL[$bline]}); bindent=$(( pc[1] - 1 ))
  else
    plain "$P[bline]"; t=$REPLY; gut "$t"
    if (( REPLY > 0 )); then bindent=$REPLY; else t=${t%%[^ ]*}; bindent=$#t; fi
  fi
  box=1 bfocus=1 bkeep=1 bstate= berr= bshow=0 bshown=0 bsent=0 bclock=$EPOCHREALTIME brid=$rid[cur]
}
# box_key <key>: one key while you type in it.
box_key() {
  bkeep=1
  keyname "$1"
  # While what it says is read, only esc.
  [[ $bstate == reading ]] && { [[ $REPLY == (esc|ctrl-c) ]] && box_close; return }
  case $REPLY in
    enter) box_send ;;
    esc|ctrl-c) box_close ;;
    ctrl-e) box_editor ;;
    *) box_size; local -a sz=(${=REPLY}); lineedit btext bat "$1" $sz[3] && berr= ;;
  esac
}
box_close() {
  if [[ -n ${btext//[[:space:]]/} ]]; then bkept[$bargs]=$btext; else unset "bkept[$bargs]"; fi
  bstate=closing bfocus=0
  sel=0 selr= selpath= selthread= selgut=0
}
# box_send: what is written, saved behind the screen; nothing written is
# nothing sent. Its answer is box_tick's to take up, and the pane's refresh
# comes after it, as c's prompt had it.
box_send() {
  [[ -n ${btext//[[:space:]]/} ]] || { box_close; return }
  rm -f $st/box.rc $st/box.out
  bstate=sending bfocus=0 bpf=$pfile berr=
  sel=0 selr= selpath= selthread= selgut=0
  local bykey=
  spawn execute-silent "${bpre:+$bpre; }git-mr-say $bargs ${(qq)btext} > $st/box.out 2>&1; print -r -- \$? > $st/box.rc.tmp; mv -f $st/box.rc.tmp $st/box.rc" $cur \
    "execute-silent(git-mr-file-preview --refresh $GMR_IID $GMR_RANGE)+reload($fulllist)+refresh-preview"
}
# box_editor: what is written so far, in your git editor, for more than a line.
box_editor() {
  print -r -- $btext > $st/box.txt
  flash="your editor…"; draw
  offout; run_tty "eval \"\$(git var GIT_EDITOR)\" ${(qq)st}/box.txt"; offin; resize
  btext=$(<$st/box.txt) bat=$#btext
}
# box_size: where the box stands at the pane's width now, in REPLY: its
# indent, its width, and its text's width inside its borders.
box_size() {
  integer ind=$bindent bw
  (( bw = pw - ind - 1, bw > 96 ? (bw = 96) : 0 ))
  (( bw < 24 )) && (( ind = 2, bw = pw - 3 ))
  REPLY="$ind $bw $(( bw - 4 ))"
}
# box_frame: the box's rows at the pane's width (BX), what of them the push
# shows now (BXS, bshown), and where the push is going (btarget). The pane
# follows it while it opens or grows and when you type in it (bkeep), and is
# yours to scroll it out of sight otherwise.
box_frame() {
  local t=$btext line ttl keys pad_ ch
  integer w n ind bw
  local -a lines rc
  box_size; rc=(${=REPLY}); ind=$rc[1] bw=$rc[2] w=$rc[3]
  textrows "$t" $bat $w; lines=("${(@)TR}") rc=(${=REPLY})
  case $bstate in
    reading) spin_frame; bspun=$REPLY ttl="$REPLY reading your comment" ;;
    sending) spin_frame; bspun=$REPLY ttl="$REPLY saving" ;;
    sent) ttl="✓ saved" ;;
    closing) (( bsent )) && ttl="✓ saved" || ttl=$btitle ;;
    *) ttl=$btitle ;;
  esac
  pad_=${(l:ind:: :)}
  BX=("$pad_$Y┌ $B$ttl$UB ${(l:bw - 4 - ${(m)#ttl}::─:)}┐$R")
  for (( n = 1; n <= $#lines; n++ )); do
    line=$lines[n]
    if (( bfocus && n == rc[1] )) && [[ -z $bstate ]]; then
      ch=${line[rc[2]+1]:- }
      line="$T${line[1,rc[2]]}"$e"[7m$ch"$e"[27m${line[rc[2]+2,-1]}"
      [[ -z $t ]] && { [[ $bargs == --reply* ]] && line+=$F"write a reply" || line+=$F"write a comment" }
      vw "$line"
    else line="$T$line"; vw "$line"; fi
    BX+=("$pad_$Y│$R $line$R${(l:w - REPLY:: :)} $Y│$R")
  done
  # Why it was not saved, under what you wrote, until you change it or send it again.
  [[ -n $berr ]] && { fit "$berr" $w; BX+=("$pad_$Y│$R $X$REPLY$R${(l:w - ${(m)#REPLY}:: :)} $Y│$R") }
  keys=" enter saves · ctrl-e your editor · esc "
  (( ${#keys} > bw - 4 )) && keys=" enter saves · esc "
  (( bfocus )) || keys=
  BX+=("$pad_$Y└$C$keys$Y${(l:bw - 2 - ${#keys}::─:)}┘$R")
  # The push: all of it open, none of it closing, and what the clock has shown of it.
  if [[ $bstate == closing ]]; then btarget=0; else btarget=$#BX; fi
  (( bshown = int(bshow + 0.5), bshown > $#BX ? (bshown = $#BX) : 0 ))
  if (( bshown >= 2 )); then BXS=("${(@)BX[1,bshown-1]}" "$BX[-1]")
  elif (( bshown == 1 )); then BXS=("$BX[1]")
  else BXS=(); fi
  [[ $rid[cur] == $brid ]] || { bshown=0 BXS=() }
  if (( bfocus && bkeep )); then
    (( bline + bshown > poff + ph - phd )) && (( poff = bline + bshown - (ph - phd) ))
    (( bline <= poff )) && (( poff = bline > 2 ? bline - 2 : 0 ))
    (( bshown == btarget )) && bkeep=0
  fi
}
# box_tick: the saved answer taken up, and the push a step on, on the
# loop's clock; true when either changed the screen.
box_tick() {
  local rc
  integer was=$bshown
  # Your comment, read to be edited (e): in the box, or, none of the thread's being yours, the box gone.
  if [[ $bstate == reading ]]; then
    if [[ -e $st/box.was ]]; then btext=$(<$st/box.was) bat=$#btext bstate= bkeep=1; rm -f $st/box.was; return 0; fi
    if [[ -e $st/box.wasnt ]]; then flash=$(head -1 $st/box.wasnt); rm -f $st/box.wasnt; bstate=closing bfocus=0; return 0; fi
  fi
  if [[ $bstate == sending && -e $st/box.rc ]]; then
    rc=$(<$st/box.rc); rm -f $st/box.rc
    if [[ $rc == 0 ]]; then
      bstate=sent bsent=$EPOCHREALTIME; unset "bkept[$bargs]"
    else
      # Never lost: back in the box, saying why, to try again; or kept for c on those lines.
      berr="not saved: ${$(head -1 $st/box.out 2>/dev/null):-git-mr-say failed}"
      if [[ $rid[cur] == $brid ]]; then bstate= bfocus=1
      else bkept[$bargs]=$btext box=0 flash="$berr: c on those lines brings it back"; fi
    fi
    return 0
  fi
  # Saved: it goes once the pane comes back with the comment in it.
  [[ $bstate == sent ]] && { [[ $pfile != $bpf ]] || (( EPOCHREALTIME - bsent > 6 )) } && bstate=closing
  float dt=$(( EPOCHREALTIME - bclock ))
  bclock=$EPOCHREALTIME
  (( dt > 0.05 )) && dt=0.05
  (( bshow += (btarget - bshow) * (1 - exp(-dt / 0.22)) ))
  (( abs(btarget - bshow) < 0.3 )) && bshow=$btarget
  # Said in the footer once the box is gone, where nothing redraws it away.
  if [[ $bstate == closing ]] && (( bshow == 0 )); then
    if (( bsent )); then
      if [[ $bargs == --edit* ]]; then flash="saved"
      elif [[ $GMR_KIND == mine ]]; then flash="sent"
      else flash="saved as a draft: S submits them all"; fi
    fi
    box=0 bshown=0 BXS=() bsent=0
    return 0
  fi
  (( int(bshow + 0.5) != was )) && return 0
  [[ $bstate == (sending|reading) ]] && { spin_frame; [[ $REPLY != $bspun ]] } && return 0
  return 1
}

# What this screen's own keys are for, as the key log says it (keys_used);
# the keys a caller offers say so themselves.
typeset -A own=(']' 'next change' '[' 'previous change' . 'next one not viewed' , 'previous one not viewed'
  / 'search the rows' '?' 'these keys' ctrl-a "Claude's panel")
# handle <key>: one key. The picker's bindings come first, then this
# screen's own, as git-fzf's came under a caller's.
handle() {
  [[ $1 == $e'[<'* ]] && { mouse "$1"; return; }
  (( bfocus )) && { box_key "$1"; return; }
  (( cfocus )) && { chat_key "$1"; return; }
  local k=$1
  keyname "$k"; local n=$REPLY was=$lastn
  lastn=$n
  if (( noting )); then
    case $n in
      enter) noting=0 dirty=1; [[ -n ${ntext// /} ]] && flash=$(otis-words note "$nword" "$ntext" ${njson:+"$njson" "$ncase"} 2>/dev/null); return ;;
      esc) noting=0 dirty=1; return ;;
      bspace) ntext=${ntext[1,-2]} dirty=1; return ;;
      ctrl-u) ntext= dirty=1; return ;;
    esac
    typed "$k" && { ntext+=$REPLY dirty=1; }
    return
  fi
  if (( searching )); then
    case $n in
      enter) searching=0 dirty=1; [[ -n $bind[enter] ]] && act enter; return ;;
      esc) searching=0 dirty=1; return ;;
      bspace) query=${query[1,-2]} dirty=1; return ;;
      up|ctrl-k|ctrl-p) step -1; return ;;
      down|ctrl-j|ctrl-n) step 1; return ;;
      ctrl-u) query= dirty=1; return ;;
    esac
    typed "$k" && { query+=$REPLY dirty=1; }
    return
  fi
  # A word selected in the pane: y says you know it, n that you don't, and Claude reads up on it; in a
  # case's pane, a says what it is in your own words (otis-words). The pane draws again when the words
  # change (watched).
  local cs=${rid[cur]%%>*} json=
  if (( sel == 1 )) && [[ -n $seltxt && $seltxt != *$'\n'* ]] && (( ${#seltxt} <= 80 )) && [[ $n == (y|n) || ( $n == a && $cs == sentence:* ) ]]; then
    keys_used $n
    local w=$seltxt
    sel=0 selr= seltxt=
    # On a case, or under one: that case is told again for you.
    [[ $cs == sentence:* && -s $st/sentences ]] && json=${$(<$st/sentences)%.tsv}.json
    if [[ $n == a ]]; then noting=1 nword=$w ntext= njson=$json ncase=${cs#sentence:} flash=; dirty=1; return; fi
    if [[ $n == y ]]; then flash=$(otis-words know "$w" ${json:+"$json" "${cs#sentence:}"} 2>/dev/null)
    else flash=$(otis-words learn "$w" ${json:+"$json" "${cs#sentence:}"} 2>/dev/null); fi
    dirty=1; return
  fi
  # A thread taken in a case's pane (a click on it): c replies, e and d edit
  # and delete your comment in it (git-mr-say: the latest of yours, or the
  # draft), r resolves it or opens it again (git-mr-threads), as in the
  # threads picker; esc lets go. git-mr-say reads the threads where the
  # pickers keep them, so they are written there first.
  if (( sel == 1 )) && [[ -n $selthread && -n $GMR_IID ]]; then
    local tid tres tdone tdraft
    read -r tid tres tdone tdraft <<< $selthread
    local keep="git-mr-threads --json $GMR_IID $GMR_RANGE '' > \"\$GIT_FZF_STATE/threads.json\" 2>/dev/null"
    case $n in
      c)
        [[ $tdraft == true ]] && { flash="a draft has no thread to reply to yet: e edits it"; dirty=1; return; }
        keys_used c
        box_open $s2 "in the thread above" "--reply $GMR_IID $GMR_RANGE $tid" "" "$keep"
        dirty=1; return ;;
      e)
        # The box under the thread at once, your comment read into it behind the screen (box_tick).
        keys_used e
        local args="--edit $GMR_IID $GMR_RANGE $tid" whose="your comment above"
        [[ $tdraft == true ]] && whose="your draft above"
        box_open $s2 "$whose" "$args" "" "$keep"
        if (( ! ${+bkept[$args]} )); then
          rm -f $st/box.was $st/box.wasnt
          bstate=reading
          local bykey=
          spawn execute-silent "$keep; if git-mr-say --was $GMR_IID $GMR_RANGE $tid > $st/box.was.tmp 2>/dev/null; then mv -f $st/box.was.tmp $st/box.was; else mv -f $st/box.was.tmp $st/box.wasnt; fi" $cur
        fi
        dirty=1; return ;;
      d)
        keys_used d
        sel=0 selthread=
        run "execute($keep; git-mr-say --delete $GMR_IID $GMR_RANGE $tid)+execute-silent(git-mr-file-preview --refresh $GMR_IID $GMR_RANGE)+reload($fulllist)+refresh-preview" $cur
        dirty=1; return ;;
      r)
        keys_used r
        sel=0 selthread=
        run "execute-silent(git-mr-threads --resolve $GMR_IID $GMR_RANGE $tid $tres $tdone)+reload($fulllist)+refresh-preview" $cur
        dirty=1; return ;;
      esc) sel=0 selthread=; return ;;
    esac
  fi
  # Lines selected in a diff: a asks Claude about them, and, taken on the
  # line numbers in a review, c comments on them; esc lets go. In a case's
  # pane the lines' file is the route's (selpath), not the row's.
  if (( sel == 1 )) && [[ -n $selr ]]; then
    case $n in
      a) if [[ -n $ctpl && -z $selpath ]]; then
           keys_used a
           local l=$selr
           sel=0 selr= selgut=0
           chat_open "$l"
           return
         fi ;;
      c) if [[ -n $GMR_IID ]] && (( selgut )); then
           keys_used c
           local side first last cfile=$selpath on
           read -r side first last <<< $selr
           [[ -n $cfile ]] || { fields $cur; cfile=$fld[2]; }
           on="on ${cfile:t} line $first"; [[ $first != $last ]] && on="on ${cfile:t} lines $first–$last"
           box_open $s2 "$on" "--new $GMR_IID $GMR_RANGE ${(qq)cfile} $side $first $last" "$selsay"
           dirty=1; return
         fi ;;
      esc) sel=0 selr= selpath= selgut=0; return ;;
    esac
  fi
  sel=0 selr= selpath= selthread= selgut=0
  [[ $n == a && -n $ctpl ]] && { keys_used a; chat_open ""; return; }
  # ctrl-a shows or hides it, the conversation kept either way.
  [[ $k == $'\x01' && -n $ctpl ]] && { keys_used ctrl-a "$own[ctrl-a]"; if (( chat )); then chat=0 cfocus=0; else chat_open ""; fi; return; }
  [[ $n == esc ]] && (( chat )) && { chat=0; return; }
  # A picker's key held down is one press: its repeats, arriving while it
  # runs or within 0.3s of the last of them, are dropped. p held ran the
  # peeks and a preview for every repeat, and the renders piled up. A
  # repeat is the same key again with no other between: v, j, v quickly is
  # two files marked, and the second v was dropped as if v were held.
  # A sentence has no file to open: enter opens it, or closes it. A ↑ row's
  # enter goes where its l does, to its symbol drawn whole.
  [[ $n == enter ]] && (( cur )) && [[ $typ[cur] == sent ]] && { [[ $fold[cur] == open ]] && n=h || n=l; }
  [[ $n == enter ]] && (( cur )) && [[ $typ[cur] == ref ]] && n=l
  if (( cur )) && [[ $typ[cur] == ref ]]; then
    symkeys
    (( ${+rkl[$n]} )) && [[ -z $rkl[$n] ]] && { flash="a ↑ row: l goes to its symbol, drawn whole above"; return; }
  fi
  if [[ -n $bind[$n] ]]; then
    if [[ $n == $was ]] && (( EPOCHREALTIME - ${held[$n]:-0} < 0.3 )); then held[$n]=$EPOCHREALTIME; return; fi
    keys_used $n
    act $n; held[$n]=$EPOCHREALTIME
    return
  fi
  [[ $n == (/|\?|\]|\[|.|,) ]] && keys_used $n "$own[$n]"
  case $n in
    j|down) step 1 ;;
    k|up) step -1 ;;
    g) (( $#vis )) && go $vis[1] ;;
    G) (( $#vis )) && go $vis[-1] ;;
    # With ? up, q and esc close it, as its last line says, rather than the screen.
    q|esc) (( help )) && { help=0 poff=0; return; } ;|
    q) quit 130 ;;
    esc) if [[ -n $query ]]; then query= dirty=1; else quit 130; fi ;;
    /) searching=1 dirty=1 ;;
    '?') help=$(( !help )) poff=0 ;;
    J) headscroll 3 ;;
    K) headscroll -3 ;;
    # In a frame the pane is nvim's code window, which these keys move (otis-frame --key).
    ctrl-[duey]|'['|']') (( framed )) && { { unlisten; otis-frame --key $n } </dev/null >/dev/null 2>&1 &!; return } ;|
    ctrl-d) scroll $(( (ph - phd) / 2 )) ;;
    ctrl-u) scroll $(( - (ph - phd) / 2 )) ;;
    ctrl-e) scroll 1 ;;
    ctrl-y) scroll -1 ;;
    ']') hunk 1 ;;
    '[') hunk -1 ;;
    '.') unviewed 1 ;;
    ',') unviewed -1 ;;
    ctrl-c) quit 130 ;;
  esac
}

# --- landings --------------------------------------------------------------------
# What background work leaves in the cache: Claude's gloss, where the
# changed code broke before, tsgo's callers, Claude's fixes for them, the checkout's rechecked callers, and a review's
# threads. A change in any reloads the rows, and the previews with them.
wsig=
watched() {
  local croot sig= f
  local -a tm
  local -a watch=($watchfiles)
  if [[ -s $st/cache-root ]]; then
    croot=$(<$st/cache-root)
    watch+=($croot/{symbols-gloss,symbols-past,symbols-sentences,callers,callers-fix}(N/) $st/fixed(N))
  fi
  (( $#watch )) || return 1
  [[ -n $GMR_IID ]] && watch+=($croot/mr-$GMR_IID-{threads,drafts}.json(N))
  # Your words (otis-words): a meaning landing is drawn in the panes that use it.
  watch+=(${OTIS_WORDS:-${XDG_CONFIG_HOME:-$HOME/.config}/otis/words.tsv}(N))
  for f in $watch; do
    zstat -A tm +mtime -- $f 2>/dev/null && sig+=$f$tm[1]
  done
  [[ $sig == $wsig ]] && return 1
  local was=$wsig; wsig=$sig
  [[ -n $was ]]
}

# --- the loop ----------------------------------------------------------------------
screen_on
pbask
size
layout
draw
# The list's first rows, from the start binding (its reload is the list the
# landings reload with).
if [[ $startacts == (#b)(|*+)reload\((*) ]]; then
  fulllist=$match[2]; [[ $fulllist == *\)+* ]] && fulllist=${fulllist%%\)+*} || fulllist=${fulllist%\)}
fi
run "$startacts" 0
[[ -n $OTIS_SYMBOLS_ASK && -n $ctpl ]] && chat_open ""
[[ -n $OTIS_SYMBOLS_WATCH ]] && watchfiles+=($OTIS_SYMBOLS_WATCH)
unset OTIS_SYMBOLS_ASK OTIS_SYMBOLS_WATCH
integer tmo=5 stick=0 wtick=0 rewidth=0 mh=0 mwas=0
lspun=
while :; do
  reply=()
  # The light moving between rows draws a frame every 20ms (zselect counts
  # hundredths). A key's command or a reload out is looked for as often: v is
  # one after the other, and at the resting tick each sat landed for 25ms on
  # average.
  music_wait -t $(( lon || $#jobs || $#rpid || hold || (box && bshow != btarget) ? 2 : tmo )) -r $tty ${winch:+-r} $winch
  if [[ -n $winch ]] && (( ${reply[(I)$winch]} )); then
    sysread -s 64 -i $winch _
    resize
  fi
  if (( ${reply[(I)$tty]} )); then
    # A key is drawn at once, whatever a view landing waits for.
    kt=$EPOCHREALTIME nk=1 hold=0
    readkey; handle $REPLY
    while zselect -t 0 -r $tty; do readkey; handle $REPLY; (( nk++ )); done
    landed_jobs
    draw
  else
    float ti=$EPOCHREALTIME
    changed=0
    (( lon )) && changed=1
    landed_jobs && changed=1
    spun_on && changed=1
    (( ! loaded )) && { spin_frame; [[ $REPLY != $lspun ]] && { lspun=$REPLY; changed=1 dirty=1; }; }
    # Once a second: whatever opened this is still there (else it goes,
    # rather than read keys under a shell's prompt), and, without perl, the size.
    if (( EPOCHSECONDS != stick )); then
      stick=$EPOCHSECONDS
      orphaned && quit 1
      # In a frame, nvim's window beside this one changed width (a split, or
      # nvim resized) while this terminal kept its own: drawn for the new one.
      # A file shown there is no width's, and showing it again ended a diff split beside it.
      (( framed )) && [[ -r $OTIS_NVIM_FRAME/cols && $(<$OTIS_NVIM_FRAME/cols) != $pw ]] && { layout; (( gen++ )); [[ $fshown == row\ * ]] || fshown=; changed=1; }
      [[ -z $winch ]] && resize
      # The panel's clock, while Claude answers.
      (( chat )) && chat_busy && changed=1
    fi
    (( chat )) && chat_tick && changed=1
    (( box )) && box_tick && changed=1
    # Music started or stopped: the list's foot is the music's, or the list's again.
    (( ($#mlab > 0) != mwas )) && { (( mwas = $#mlab > 0 )); changed=1; }
    landed && changed=1
    # ↻ by the title once a reload has been out longer than quick; a quicker
    # one, as most are, says nothing, so a tab or an l never blinks it.
    (( ($#rpid && EPOCHREALTIME - rt0 >= quick) != rslow )) && { (( rslow = ! rslow )); dirty=1 changed=1; }
    # The row's preview landing: one test for the file this gen and width
    # draw, and none once it shows. A glob of every kept preview, twenty
    # times a second, was the loop's whole cost at rest.
    if (( cur && ! help )) && [[ -n $preview ]]; then
      pvname $cur $pw
      [[ $lastpv != $REPLY.$gen && -e $REPLY.$gen ]] && changed=1
    fi
    # The size has held: the rows cut to it, and the previews drawn at it.
    if (( settle && EPOCHREALTIME >= settle )); then
      settle=0
      (( rewidth )) && [[ -n $lastlist ]] && { rewidth=0; reload "$lastlist"; }
      (( gen++ )); warm
    fi
    # Background work landing, looked for twice a second, and not while a
    # reload is out.
    if (( EPOCHREALTIME * 2 > wtick )) && (( ! $#rpid )); then
      (( wtick = int(EPOCHREALTIME * 2) + 1 ))
      # What landed is in the previews too, whether or not the rows change.
      watched && [[ -n $fulllist ]] && { reload "$fulllist"; (( gen++ )); changed=1; }
    fi
    if (( hold )); then
      if holding; then changed=0; else hold=0 changed=1; fi
    fi
    (( changed )) && draw
    (( ! help && ! settle )) && want
    framepush
    (( EPOCHREALTIME - ti > 0.02 )) && print -r -- "$EPOCHREALTIME upkeep $(( int((EPOCHREALTIME - ti) * 1000) ))ms changed=$changed" >> $trace
  fi
done
