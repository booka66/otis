#!/usr/bin/env -S zsh -f
# otis-symbols <prompt> <keys> [fzf options...]
# A change by symbol, drawn by hand rather than as an fzf list: git-symbols'
# picker and a review's (git-mr-files) open here. It takes what git-fzf takes,
# the keys as "key=label" pairs and fzf's --bind, --preview and
# --header-from-state, and does what those bindings say: execute,
# execute-silent, reload, transform, refresh-preview, pos, first, abort,
# accept and print, with a row's fields for {n}. So every key of the two
# pickers works as it did, from the same bindings, and the pickers stay the
# ones that say what a key does.
#
# The screen is laid out for reading a change: Claude's one sentence on it
# first, then how much of it is viewed, as a bar, and what is still coming
# in (the gloss, tsgo's callers); then the tree, drawn as one, with guides
# from each row to what it opens to, what the change did to a symbol as a
# glyph before its signature (~ its signature changed, + added, - removed,
# · its body alone), and on the right a row's threads, viewed and lines in
# columns of their own. The row under the cursor is the only one lit. The
# rows' parts come from git-symbols --rows, which lays them out for this
# list's width (OTIS_SYMBOLS_WIDTH); a row with none (a review read by file)
# is drawn as fzf would have drawn it.
#
# On a wide terminal the row's preview sits to the right, under a line
# saying where the row is (its file and line, and the rows it is under); on
# a narrow one, under the list. Previews are drawn in the background, the
# cursor's first and then the rows around it, and kept per row and width,
# so moving onto a row finds its preview drawn; a preview being drawn again
# shows the one before until it lands, never a blank pane. Each row keeps
# where its preview was scrolled, in the files git-fzf keeps them in
# (off.<row>), so enter opens where you are reading, as it did.
#
# Background work lands by itself: Claude's gloss, tsgo's callers, Claude's
# fixes for them and a review's threads each leave a file in the cache, and
# a change in one reloads the rows (under fzf they posted a reload to its
# port, which this has none of).
#
# / searches the rows, as fzf did: each word of it in a row's name or path.
# ? puts the keys and what the glyphs mean in the pane. The mouse is this
# screen's: a click picks a row, the wheel scrolls the preview or moves
# through the rows, and a drag in the preview selects its text and copies
# it; a then asks Claude about the lines, and c in a review comments on
# them. Each frame's timing goes to ~/.cache/otis/symbols.log
# (OTIS_SYMBOLS_TRACE).
#
# Where the picker's a asks Claude (git-symbols-ask), a opens a panel over
# the lower part of the list rather than leaving the screen: the row you are
# on and the diff stay in sight, and Claude's answers stream into the panel
# as they come.
setopt extendedglob no_nomatch

[[ -n $OTIS_T_NAME && $OTIS_THEME == "$OTIS_T_WANT" ]] || eval "$(otis-theme --env)"
. ${0:A:h:h}/share/in-root.sh
in_root || eval "$(otis-config --env)"
export OTIS_ROWFMT=$(<${0:A:h:h}/share/rowfmt.awk)
wrap_awk=$(<${0:A:h:h}/share/pane-wrap.awk)
# Not under a picker: a script that would post to one must not find the one
# this was opened from.
unset FZF_PORT FZF_API_KEY
export GIT_FZF_STATE=${TMPDIR:-/tmp}/git-fzf.$$.$RANDOM$RANDOM
mkdir -m 700 $GIT_FZF_STATE || exit 1
st=$GIT_FZF_STATE
: > $st/lock; : > $st/by-id
mkdir $st/pv
trace=${OTIS_SYMBOLS_TRACE:-${XDG_CACHE_HOME:-$HOME/.cache}/otis/symbols.log}
mkdir -p ${trace:h} 2>/dev/null; : > $trace

# --- what it was asked to be -------------------------------------------------
# The keys: labels for the footer and ?, those after a lone | for ? alone.
title=${1% } spec=$2; shift 2
typeset -a hk hv hm
typeset -A bind
integer more=0
for pair in ${(s:,:)spec}; do
  [[ -z $pair ]] && continue
  [[ $pair == '|' ]] && { more=1; continue }
  [[ -n ${pair#*=} ]] && { hk+=("${pair%%=*}"); hv+=("${pair#*=}"); hm+=($more); }
done
preview= startacts= hdr=0 searching=0 watchfiles=() stepscmd= panescmd=
# --repeat j,k: keys cheap enough to act on every repeat of a key held down
# (a debugger's step), which the rest do not (below).
typeset -A repeat
while (( $# )); do
  case $1 in
    --repeat) for k in ${(s:,:)2}; do repeat[$k]=1; done; shift 2 ;;
    --bind) if [[ $2 == start:* ]]; then startacts+=${startacts:++}${2#start:}; else bind[${2%%:*}]=${2#*:}; fi; shift 2 ;;
    --preview) preview=$2; shift 2 ;;
    --header-from-state) hdr=1; shift ;;
    # A file whose change reloads the rows and previews, as the cache's do.
    --watch) watchfiles+=($2); shift 2 ;;
    --search) searching=1; shift ;;
    # A walk's steps, stepped through here (steps_load, below).
    --steps) stepscmd=$2; shift 2 ;;
    # Every row's preview drawn ahead, one file a row (panes_load, below).
    --panes) panescmd=$2; shift 2 ;;
    *) shift ;;
  esac
done

. ${0:A:h:h}/share/screen.zsh
keys_caller; keys_open "${REPLY:-${${title//\!<-> /}%% *}}" "$spec"
screen_start
# What an accept hands back, printed once the screen is given back.
typeset -a outq
at_quit() { (( $#outq )) && print -rl -- $outq; }

# --- the layout ------------------------------------------------------------------
# Side by side from 120 columns, as git-fzf had them (the preview's 55% at 66
# or more), the list 42% of it; under that the preview under the list. lw
# the list's width, lh its height; the pane at column px, row py, pw wide
# and ph high, its first two rows where the row is (phd).
integer lw lh px py pw ph side phd=2
typeset -a PH HB
# The pinned head whole (HB) when it is taller than its share of the pane
# (hroom rows), and how far it is scrolled (hoff): J and K, or the wheel
# over it, scroll it; the code under it keeps the rest of the pane.
integer hoff=0 hroom=0
layout() {
  if (( W >= 120 )); then
    side=1; (( lw = W * 42 / 100, lw < 48 ? (lw = 48) : 0 ))
    (( lh = H - 2, px = lw + 6, py = 1, pw = W - px, ph = H - 2 ))
  else
    side=0 lw=$W; (( lh = (H - 2) * 45 / 100, py = lh + 2, ph = H - 2 - lh - 1, px = 1, pw = W - 1 ))
  fi
  # What the rows and the previews are drawn for, for every command run
  # from here: --rows fits the signatures to the list, and a preview's
  # position (git-symbols --at, --peeks) is worked out at the pane's width.
  export OTIS_SYMBOLS_WIDTH=$lw FZF_COLUMNS=$W FZF_LINES=$H FZF_PREVIEW_COLUMNS=$pw FZF_PREVIEW_LINES=$(( ph - phd ))
  print -rn -- $pw > $st/cols; print -rn -- $(( ph - phd )) > $st/plines
}
float settle=0
resize() {
  local oh=$H ow=$W olw=$lw
  size
  (( H != oh || W != ow )) || return 1
  print -r -- "$EPOCHREALTIME resize ${ow}x$oh -> ${W}x$H" >> $trace
  layout; dirty=1 shown_rows=(); draw
  # The rows are cut to the list's width by --rows, so a new width reloads
  # them, once the size has held for 0.3s: a drag reloads once, not at
  # every width it passes through. The previews at the new width with them.
  (( settle = EPOCHREALTIME + 0.3 ))
  (( lw != olw )) && rewidth=1
}

# --- the rows --------------------------------------------------------------------
# raw: each row as the list printed it; rid its id (field 12, or a heading's
# last field); typ what it is (sym, callers, package, caller, file from
# --rows' parts; head for a heading; plain for a row with no parts); the
# parts, dep through err; hay what / searches in.
typeset -a raw rid typ dep fold kids chg add del vwd nop ndr nedge dim lab err cm hay gd gdw
integer loaded=0 wa=1 wd=1 wt=0 mr=0
load() {
  local line i
  local -a f
  raw=() rid=() typ=() dep=() fold=() kids=() chg=() add=() del=() vwd=() nop=() ndr=() nedge=() dim=() lab=() err=() cm=() hay=()
  for line in ${(f)"$(<$1)"}; do
    f=("${(@ps:\t:)line}")
    raw+=("$line")
    rid+=("${f[12]:-$f[-1]}")
    if [[ -n $f[13] ]]; then typ+=("$f[13]")
    elif [[ -z $f[2] && ( -z $f[12] || $f[12] == gk-* ) ]]; then typ+=(head)
    else typ+=(plain); fi
    dep+=("${f[14]:-0}") fold+=("$f[15]") kids+=("$f[16]") chg+=("$f[17]") add+=("$f[18]") del+=("$f[19]")
    vwd+=("$f[20]") nop+=("$f[21]") ndr+=("$f[22]") nedge+=("$f[23]") dim+=("$f[24]") lab+=("$f[25]") err+=("$f[26]") cm+=("$f[27]")
  done
  # What / searches is worked out on the first search, not on every load:
  # it was a third of what a reload of a big change cost.
  hayok=0
  [[ -s $st/layout ]] && read -r wa wd wt mr < $st/layout
  guides
  loaded=1 dirty=1 rlw=0
}
# The row's fields as fzf numbers them, for {n}.
typeset -a fld
fields() { fld=("${(@ps:\t:)raw[${1:-$cur}]}"); }

# guides: the tree's lines, for each row at a depth, from the rows after it:
# whether a sibling comes after it (├ or └), and for each level above, whether
# the row it is under at that level has one (│ or nothing).
guides() {
  local -A seen
  local i d k s
  gd=() gdw=()
  for (( i = $#raw; i >= 1; i-- )); do
    if [[ $typ[i] == (head|plain|file) ]]; then seen=(); gd[i]= gdw[i]=0; continue; fi
    d=$dep[i] s=
    for (( k = 1; k < d; k++ )); do [[ -n $seen[$k] ]] && s+="│  " || s+="   "; done
    if (( d > 0 )); then
      if [[ -n $seen[$d] ]]; then s+="├"; else s+="└"; fi
      # A call new to the change: ⇢ where the branch meets the row.
      if [[ -n $nedge[i] ]]; then s+=$A"⇢"$R$F" "; else s+="─ "; fi
    fi
    # Its width, three columns a level, kept: the colors in it would
    # otherwise have to be measured out of it on every row drawn.
    gd[i]=$s gdw[i]=$(( d > 0 ? 3 * d : 0 ))
    seen[$d]=1
    for k in ${(k)seen}; do (( k > d )) && unset "seen[$k]"; done
  done
}

# --- a row ---------------------------------------------------------------------
# RL: each row's line as drawn without the cursor, RU its width, both for
# the list's width; built once a load (or a resize), since a frame is then
# the lines in view and the cursor's lit.
typeset -a RL RU
cells() {
  local x=M
  [[ $chg[$1] == added ]] && x=A; [[ $chg[$1] == removed ]] && x=D
  fields $1
  if [[ $fld[9] == 1 ]]; then put "$G" $x; else put "$F" .; fi
  if [[ $fld[10] == 1 ]]; then [[ $fld[9] == 1 ]] && put "$A" $x || put "$X" $x; else put "$F" .; fi
  put "" " "
}
rowline() {
  local i=$1 t lc
  integer w=$(( lw - 2 )) rz
  line= used=0
  case $typ[i] in
    head)
      # A heading of the list's own, or git-test-files': its words, the rule
      # it was drawn in dropped, the count first and what t does after it.
      fields $i; plain "$fld[1]"; t=${${REPLY//─/}## #}; t=${t%% #}
      if [[ $t == *' · '* ]]; then put "$C" "${(U)${t%% · *}}"; put "$F" "  ${t#* · }"
      else put "$C" "${(U)t}"; fi
      ;;
    plain)
      fields $i; cut "$fld[1]" $w; line=$REPLY; vw "$line"; used=$REPLY
      ;;
    *)
      (( wt )) && { [[ $typ[i] == sym ]] && cells $i || put "" "   "; }
      line+=$F$gd[i]; (( used += gdw[i] ))
      case $fold[i] in
        open) put "$A" "▾ " ;; closed) put "$A" "▸ " ;; quiet) put "$C" "▸ " ;; *) put "" "  " ;;
      esac
      # What the change did to it, a glyph; a caller, whether it breaks.
      case $typ[i]:$chg[i]:$err[i] in
        caller:*:x) put "$X" "✗ " ;; caller:*:fixed) put "$G" "✓ " ;;
        *:signature:*) put "$B$A" "~ "; line+=$UB ;; *:added:*) put "$G" "+ " ;; *:removed:*) put "$X" "- " ;;
        sym:*|file:*) put "$F" "· " ;; *) put "" "  " ;;
      esac
      (( rz = 1 + (wa + wd + 4) + 6 + (mr ? 10 : 0) ))
      # Callers elsewhere have none of the right's cells: their words run on.
      [[ $typ[i] == (callers|package|caller) ]] && rz=0
      lc=$lab[i]
      case $typ[i] in
        sym) if [[ -n $dim[i] || $chg[i] == removed ]]; then put "$C" "$lc"; else line+=$lc; vw "$lc"; (( used += REPLY )); fi ;;
        file)
          # Too long for the room left: its folder gives way from the left,
          # never its name, which a cut at the end would take.
          local nm=${lc:t} dir=${lc:h}/
          [[ $lc == */* ]] || dir=
          integer room=$(( w - rz - used )) k
          if (( ${(m)#dir} + ${(m)#nm} > room )); then
            if (( ${(m)#nm} + 2 > room )); then dir=; fit "$nm" $room; nm=$REPLY
            else
              (( k = room - ${(m)#nm} - 1 )); dir="…"${dir[-k,-1]}
              while (( ${(m)#dir} + ${(m)#nm} > room )); do dir="…"${dir[3,-1]}; done
            fi
          fi
          put "$C" "$dir"; put "${${dim[i]:+$C}:-$T}" "$nm" ;;
        callers) line+=$lc; vw "$lc"; (( used += REPLY )) ;;
        package) put "$EL" "$lc" ;;
        caller) put "$C" "$lc" ;;
      esac
      # How much is under a closed row, after its name.
      [[ $fold[i] == (closed|quiet) && -n $kids[i] && $typ[i] == sym ]] && put "$F" " ${kids[i]}"
      # The width so far is added up piece by piece (put, and the label and
      # the guide measured on their own), so the right's columns stand where
      # every other row has them without measuring the whole line again.
      (( used > w - rz )) && { cut "$line" $(( w - rz )); line=$REPLY; vw "$line"; used=$REPLY; }
      pad $(( w - rz ))
      (( rz )) || { pad $w; RL[i]=$line$R RU[i]=$used; return; }
      # The right: threads, viewed, the lines. Each a cell, so they stay in
      # their columns down the list.
      if (( mr )); then
        # What Claude's review did with it, beyond the diff: opened its file, searched for it.
        case $cm[i] in read) put "$G" "● " ;; grep) put "$EL" "◐ " ;; *) put "" "  " ;; esac
        put "" "  "
        if (( nop[i] > 0 )); then put "$EL" "${(r:3:: :)${:-${nop[i]}}}"; else put "" "   "; fi
        if (( ndr[i] > 0 )); then put "$Y" "✎${(r:2:: :)ndr[i]}"; else put "" "   "; fi
      fi
      case $vwd[i] in
        all) put "" "    "; put "$G" "✓ " ;;
        */*) put "$C" "${(l:6:: :)vwd[i]}" ;;
        *) put "" "      " ;;
      esac
      put "" " "
      local dm=${dim[i]:+$C}
      if (( add[i] > 0 )); then put "${dm:-$G}" "+${(l:wa:: :)add[i]}"; else put "" "${(l:wa+1:: :)}"; fi
      put "" " "
      if (( del[i] > 0 )); then put "${dm:-$X}" "-${(l:wd:: :)del[i]}"; else put "" "${(l:wd+1:: :)}"; fi
      ;;
  esac
  pad $w
  RL[i]=$line$R RU[i]=$used
}

# --- the list --------------------------------------------------------------------
# L: its lines, LI the row each is (0 for none); vis the rows the cursor
# may land on, in order, the search applied.
typeset -a L LI vis
integer dirty=1 cur=0 top=0 rlw=0
query=
integer hayok=0
buildhay() {
  local i
  local -a f
  hay=()
  for (( i = 1; i <= $#raw; i++ )); do
    f=("${(@ps:\t:)raw[i]}")
    plain "${f[25]:-$f[1]}"; hay+=("${(L)REPLY} ${(L)f[2]}")
  done
  hayok=1
}
matches() {
  local w
  [[ -z $query ]] && return 0
  (( hayok )) || buildhay
  [[ $typ[$1] == head ]] && return 1
  for w in ${=${(L)query}}; do [[ $hay[$1] == *"$w"* ]] || return 1; done
  return 0
}
# The headline: what this is, Claude's sentence on the change, how much of
# it is viewed, and what the rows' list said (the counts, what is still
# coming in).
headline() {
  local w=$1 t s
  local -a words segs
  integer d=0 n=0 k bw
  L+=("") LI+=(0)
  line= used=0; put "" "  "
  # The MR, and how it is read: by symbol, or (a review's f) by file.
  t=$title
  if [[ $t == !* ]]; then put "$A" "${t%% *}"; put "" "  "; t=${${t#${t%% *}}# }; fi
  [[ -e $st/by-file || -e $st/since ]] && t="by file"
  put "$B$T" "${t:-by symbol}"; line+=$UB
  (( $#rpid )) && { pad $(( w - 3 )); put "$F" "↻"; }
  L+=("$line") LI+=(0)
  L+=("") LI+=(0)
  if (( ! loaded )); then L+=("  ${C}reading the change…$R") LI+=(0); return; fi
  # Claude's sentence, the list's header, wrapped to the list.
  if (( hdr )) && [[ -s $st/header ]]; then
    plain "$(<$st/header)"; words=(${=REPLY}); s=
    for t in $words; do
      if [[ -n $s ]] && (( ${(m)#s} + 1 + ${(m)#t} > w - 4 )); then L+=("  $T$s$R") LI+=(0); s=; fi
      s+=${s:+ }$t
    done
    [[ -n $s ]] && L+=("  $T$s$R") LI+=(0)
    L+=("") LI+=(0)
  fi
  # Viewed, as a bar, when there is something to view.
  [[ -s $st/progress ]] && read -r d n < $st/progress
  if (( n > 0 )); then
    (( bw = w / 3, bw > 30 ? (bw = 30) : 0, k = d * bw / n ))
    line="  "$G${(l:k::━:)}$F${(l:bw-k::─:)}$R"  "
    if (( d == n )); then line+=$G"all $n viewed"$R; else line+=$T"$d"$C" of $n viewed"$R; fi
    L+=("$line") LI+=(0)
  fi
  # What the list said, a piece a line as they fit.
  if [[ -s $st/footer ]]; then
    segs=("${(@s: · :)${(j: · :)${(f)$(<$st/footer)}}}") s=
    for t in $segs; do
      vw "$s · $t"
      if [[ -n $s ]] && (( REPLY > w - 4 )); then cut "$s" $(( w - 4 )); L+=("  $REPLY$R") LI+=(0); s=; fi
      s+=${s:+$C · $R}$t
    done
    [[ -n $s ]] && { cut "$s" $(( w - 4 )); L+=("  $REPLY$R") LI+=(0); }
  fi
  local stale=($st/stale.*(N))
  (( $#stale )) && L+=("  ${X}could not refresh from GitLab: this is what it said last$R") LI+=(0)
  L+=("") LI+=(0)
}
# A row drawn once is kept by all it is drawn from (the list's width and
# columns, its guide, its line), so a reload that changed a few rows (v, l,
# h, a landing) draws those few, not the thousands around them.
typeset -A rlc ruc
list() {
  local i first=1 ctx key
  if (( rlw != lw )); then
    RL=() RU=()
    ctx="$lw $wa $wd $wt $mr"
    (( $#rlc > 3 * $#raw + 200 )) && rlc=() ruc=()
    for (( i = 1; i <= $#raw; i++ )); do
      key=$ctx$'\1'$gd[i]$'\1'$raw[i]
      if (( ${+rlc[$key]} )); then RL[i]=$rlc[$key] RU[i]=$ruc[$key]
      else rowline $i; rlc[$key]=$RL[i] ruc[$key]=$RU[i]; fi
    done
    rlw=$lw
  fi
  L=() LI=() vis=()
  headline $lw
  (( loaded )) || return
  if [[ -n $query ]] || (( searching )); then
    line="  "$A"/"$R" "$T$query$R
    (( searching )) && line+=$A"▏"$R
    L+=("$line") LI+=(0) L+=("") LI+=(0)
  fi
  for (( i = 1; i <= $#raw; i++ )); do
    matches $i || continue
    # The tree's own heading, over its first root: where to start, or,
    # turned over (b), the sinks.
    if (( first )) && [[ $typ[i] != (head|plain|file) ]]; then
      if [[ -e $st/up ]]; then L+=("  ${C}SINKS FIRST$R  ${F}what uses them under each · b turns it back$R")
      else L+=("  ${C}START HERE$R  ${F}in reading order · b for the sinks first$R"); fi
      LI+=(0); first=0
    fi
    if [[ $typ[i] == head ]]; then
      (( $#L > 0 )) && [[ -n $L[-1] ]] && { L+=("") LI+=(0); }
      L+=("  ${RL[i]}") LI+=(0)
      continue
    fi
    L+=("$i") LI+=($i)
    vis+=($i)
  done
  (( $#raw )) || L+=("  ${C}nothing in it to read by symbol$R") LI+=(0)
  dirty=0
}
# The cursor onto a row it may land on: the one it was on if it still can,
# else the nearest after it.
settle_cur() {
  local i
  (( $#vis )) || return
  (( ${vis[(Ie)$cur]} )) && return
  for i in $vis; do (( i >= cur )) && { cur=$i; return; }; done
  cur=$vis[-1]
}
# unviewed <1|-1>: the next or the previous symbol not yet viewed, from the
# cursor; none left, the footer says so.
unviewed() {
  local at=${vis[(Ie)$cur]} i n
  (( $#vis )) || return
  for (( n = 1; n < $#vis; n++ )); do
    (( i = ((at - 1 + $1 * n) % $#vis + $#vis) % $#vis + 1 ))
    i=$vis[i]
    [[ $typ[i] == sym && $vwd[i] != all ]] && { go $i; return; }
  done
  flash="every symbol is viewed"
}
step() {
  local at=${vis[(Ie)$cur]}
  (( $#vis )) || return
  (( at += $1, at < 1 ? (at = 1) : 0, at > $#vis ? (at = $#vis) : 0 ))
  go $vis[at]
}
# go <row>: the cursor there, the preview's scroll put aside for the row it
# leaves and taken up for the one it lands on.
typeset -A offs
go() {
  (( $1 == cur )) && return
  (( pwant >= 0 )) && { poff=$pwant; pwant=-1; }
  (( cur )) && { offs[$rid[cur]]=$poff; }
  # The lit row slides there from wherever it has got to (litrow).
  cur=$1 sel=0
  poff=${offs[$rid[cur]]:-0}
}
# litrow: the list's rows lit now (LITI, indices into L) and how much
# (LITA): the cursor's, or, for 0.3s after it moves, the light on its way
# there from where it was, shared by the two rows it is between. lpos is
# where it is, for a move that starts before this one ends.
integer lon=0
float lt0=0 lfrom=0 lpos=0
typeset -a LITI LITA
litrow() {
  integer to=${LI[(ie)$cur]} a
  (( to <= $#LI )) || to=0
  LITI=($to) LITA=(1) lpos=$to
  (( lon && to && lfrom )) || { lon=0; return; }
  float t=$(( (EPOCHREALTIME - lt0) / 0.3 )) f
  (( t >= 1 )) && { lon=0; return; }
  (( t = t < 0.5 ? 4 * t * t * t : 1 - (-2 * t + 2) ** 3 / 2 ))
  (( lpos = lfrom + (to - lfrom) * t, a = int(lpos), f = lpos - a ))
  LITI=($a $(( a + 1 ))) LITA=($(( 1 - f )) $f)
}
# litline <row> <a>: a row of the list lit a of the way (REPLY).
integer ATr=250 ATg=189 ATb=47
[[ $OTIS_T_ATTENTION == (#b)*38\;2\;([0-9]##)\;([0-9]##)\;([0-9]##)* ]] && ATr=$match[1] ATg=$match[2] ATb=$match[3]
litline() {
  float a=$2
  if (( a >= 0.98 )); then REPLY=$A"▌ "$R$BG${RL[$1]//$R/$R$BG}$R; return; fi
  if (( a <= 0.02 )); then REPLY="  "$RL[$1]; return; fi
  local m g
  xmix $ATr $ATg $ATb $a; m=$e"[38;2;${REPLY}m"
  xmix $LBr $LBg $LBb $a; g=$e"[48;2;${REPLY}m"
  REPLY=$m"▌ "$R$g${RL[$1]//$R/$R$g}$R
}

# --- the preview ------------------------------------------------------------------
# Drawn per row and width in the background and kept; a render is running
# while its .tmp is there. gen goes up whenever what a preview is drawn from
# may have changed (refresh-preview, rows landing, background work landing);
# the pane shows the newest there is for the row until this gen's lands.
integer gen=0
lastpv= pfile= crumbfor= crumbline=
key() { local k=${1//\//%}; (( ${#k} > 200 )) && k=${k[-200,-1]}; REPLY=$k; }
pvname() { key "$1"; REPLY=$st/pv/${REPLY:-none}.$2; }
shown() {
  if [[ -n $pdir ]]; then
    local n=${rid[cur]#*:}
    if (( cur )) && [[ -n $n && -e $pdir/$n ]]; then wrapped $pdir $pwdir $pw $n; else REPLY=/dev/null; fi
    return
  fi
  if [[ -n $sbase ]]; then
    if steps_at; then steps_file $REPLY; else REPLY=; fi
    return
  fi
  pvname "$rid[cur]" $pw
  # This gen's, when it is there, whatever landed after it: a render of an
  # older gen that finished later is newer on disk, and stale.
  [[ -e $REPLY.$gen ]] && { REPLY=$REPLY.$gen; return }
  local -a have=($REPLY.<->(Nom))
  (( $#have )) || have=(${REPLY%.*}.<->.<->(Nom))
  REPLY=${have[1]}
}

# --- a walk's steps ---------------------------------------------------------------
# --steps <command>: a walk (git-trace --walk), stepped through here rather
# than by a script a key: the command says where walk-prep put the walk for
# this pane's width (its nav and a preview a step, git-trace --steps-base),
# and it runs when the screen opens, when the rows are reloaded (b, the other
# side) and when the width settles, never on a key. j, l and h go over, into
# and out, k back, each one frame: the step's preview was drawn and wrapped
# ahead (steps_warm), so a key moves the cursor and the pane together. A
# step to another line of the same file scrolls there through the file
# (xcode), under its head held in place, and lands on its preview.
typeset -a nvi nover ninto nout nfi nline shist
typeset -A sfirst frow
integer kcur=-1 sw=0
sbase= sdir=
steps_load() {
  local was=$sbase line
  local -a f
  subst "$stepscmd" 0
  sbase=$(FZF_PREVIEW_COLUMNS=$pw zsh -fc "$REPLY" 2>/dev/null </dev/null)
  [[ -n $sbase && -s $sbase.nav ]] || { sbase=$was; return 1; }
  # Where the walk is: a tour's stop opens on its step (git-trace --walk-at).
  kcur=-1
  [[ -r $st/cur ]] && { read -r kcur < $st/cur; [[ $kcur == <-> ]] || kcur=-1; }
  if [[ $sbase != $was ]] || (( pw != sw )); then
    nvi=() nover=() ninto=() nout=() nfi=() nline=() sfirst=() frow=()
    for line in ${(f)"$(<$sbase.nav)"}; do
      f=(${=line})
      nvi+=($f[2]) nover+=($f[3]) ninto+=($f[4]) nout+=($f[5]) nfi+=($f[6]) nline+=($f[7])
      (( ${+sfirst[$f[2]]} )) || sfirst[$f[2]]=$f[1]
    done
    sw=$pw sdir=$st/steps/${sbase:t}-$pw
    mkdir -p $sdir
    [[ $sbase != $was ]] && shist=()
    steps_warm
  fi
  return 0
}
# steps_at: the step the row under the cursor shows: the walk's own when it
# is in this row's call, else the call's first. -1 on a row that is no call.
steps_at() {
  REPLY=-1
  (( cur )) && [[ $rid[cur] == v:<-> ]] || return 1
  local vi=${rid[cur]#v:}
  if (( kcur >= 0 && nvi[kcur+1] == vi )); then REPLY=$kcur; else REPLY=${sfirst[$vi]:--1}; fi
  (( REPLY >= 0 ))
}
# wrapped <raw dir> <wrapped dir> <width> <name>: a preview drawn ahead,
# wrapped to the pane, wrapping it now if wrapall has not got to it yet.
wrapped() {
  REPLY=$2/$4
  [[ -e $REPLY ]] || wrapin $3 $1/$4 $REPLY $REPLY.tmp.$sysparams[pid]
}
# wrapall <raw dir> <wrapped dir> <width> <names...>: those wrapped in the
# background, in that order, so none is wrapped on a key.
wrapall() {
  local raw=$1 d=$2 w=$3; shift 3
  {
    local f
    for f in "$@"; do
      [[ -d $d ]] || break
      [[ -e $d/$f ]] || wrapin $w $raw/$f $d/$f $d/$f.tmp.$sysparams[pid]
    done
  } &!
}
steps_file() { wrapped ${sbase}-$sw $sdir $sw $1; }
# steps_warm: the files first, which every scroll in them needs and which are
# the biggest, then the steps from the one you are on outward.
steps_warm() {
  local -a names=(${sbase}-$sw/file-<->(N:t))
  integer at=$(( kcur >= 0 ? kcur : 0 )) n=$#nvi i
  for (( i = 0; i < n; i++ )); do
    (( at + i < n )) && names+=($(( at + i )))
    (( i && at - i >= 0 )) && names+=($(( at - i )))
  done
  hfixof ${sbase}-$sw $names
  wrapall ${sbase}-$sw $sdir $sw $names
}

# --- panes drawn ahead --------------------------------------------------------------
# --panes <command>: every row's preview drawn ahead, in the directory the
# command names for this pane's width, a file a row named by the row's id
# after its first colon (a tour's: git-trace --tour-panes). All wrapped in
# the background as it opens, so j and k move the cursor and the pane in
# one frame, with no preview drawn behind them. The command runs when it
# opens, when the rows reload and when the width settles. A row's preview
# can say where it is (<name>.at: its path and line first), and the
# directory can hold each such file whole (files/<path, / as %>): j or k
# from one to another line of the same file scrolls there (xcode).
pdir= pwdir=
panes_load() {
  local d
  subst "$panescmd" 0
  d=$(FZF_PREVIEW_COLUMNS=$pw zsh -fc "$REPLY" 2>/dev/null </dev/null)
  [[ -n $d && -d $d ]] || return 1
  # Drawn again (the rows reloaded because they changed): wrapped again.
  pdir=$d pwdir=$st/panes/$pw
  rm -rf $pwdir; mkdir -p $pwdir/files
  local -a names
  local n
  integer at=$(( cur ? cur : 1 )) i
  for (( i = 0; i < $#rid; i++ )); do
    (( at + i <= $#rid )) && n=${rid[at+i]#*:} && [[ -e $pdir/$n ]] && names+=($n)
    (( i && at - i >= 1 )) && n=${rid[at-i]#*:} && [[ -e $pdir/$n ]] && names+=($n)
  done
  # The files whole first, the biggest and what every scroll needs.
  local -a files=($pdir/files/*(N))
  hfixof $pdir $names
  wrapall $pdir $pwdir $pw ${files#$pdir/} $names
  return 0
}
# --- fading ------------------------------------------------------------------------
# A row comes and goes by fading, not at once: xfade draws it that much of
# the way from the pane's own ground (its colors mixed toward the terminal's
# background, which the screen asks the terminal for as it opens).
integer PBr=29 PBg=32 PBb=33 TXr=235 TXg=219 TXb=178 HBr=0 HBg=0 HBb=0 LBr=60 LBg=56 LBb=54
[[ $OTIS_T_TEXT == (#b)*38\;2\;([0-9]##)\;([0-9]##)\;([0-9]##)* ]] && TXr=$match[1] TXg=$match[2] TXb=$match[3]
[[ $OTIS_T_CODEBG == (#b)*48\;2\;([0-9]##)\;([0-9]##)\;([0-9]##)* ]] && LBr=$match[1] LBg=$match[2] LBb=$match[3]
# pbask: the terminal's background (OSC 11), for fading into; kept as it
# was when the terminal does not say within a moment.
pbask() {
  local r= c
  print -rnu $tty -- $'\e]11;?\e\\'
  while sysread -t 0.08 -s 1 -i $tty c; do
    r+=$c
    [[ $r == *($'\a'|$'\e\\') ]] && break
  done
  [[ $r == (#b)*rgb:([0-9a-fA-F]##)/([0-9a-fA-F]##)/([0-9a-fA-F]##)* ]] || return 0
  PBr=$(( 16#${match[1][1,2]} )) PBg=$(( 16#${match[2][1,2]} )) PBb=$(( 16#${match[3][1,2]} ))
}
# xmix <r> <g> <b> <a>: that color a of the way from the background (REPLY "r;g;b").
xmix() {
  REPLY="$(( int(PBr + ($1 - PBr) * $4 + 0.5) ));$(( int(PBg + ($2 - PBg) * $4 + 0.5) ));$(( int(PBb + ($3 - PBb) * $4 + 0.5) ))"
}
# xfade <row> <a>: the row a of the way from nothing to itself (REPLY): every
# color it sets mixed toward the background, and its plain text too.
xfade() {
  float a=$2
  (( a >= 0.999 )) && { REPLY=$1; return; }
  (( a < 0 )) && a=0
  local s=$1 out p ft
  local -a f o
  integer i
  xmix $TXr $TXg $TXb $a; ft="38;2;$REPLY"
  out=$e"[${ft}m"
  while [[ $s == (#b)([^$e]#)$e\[([0-9\;]#)m(*) ]]; do
    out+=$match[1] p=$match[2] s=$match[3]
    f=("${(@s:;:)p}") o=()
    (( $#f )) || f=(0)
    for (( i = 1; i <= $#f; i++ )); do
      if [[ $f[i] == (38|48) && $f[i+1] == 2 ]]; then
        xmix $f[i+2] $f[i+3] $f[i+4] $a; o+=("$f[i];2;$REPLY"); (( i += 4 ))
      elif [[ -z $f[i] || $f[i] == 0 ]]; then o+=("0;$ft")
      else o+=("$f[i]"); fi
    done
    out+=$e"[${(j:;:)o}m"
  done
  REPLY=$out$s
}
# xbarbg <a>: the ground of the line you are on, a of the way in.
xbarbg() {
  (( HBr + HBg + HBb )) || [[ $HEREbg != (#b)*48\;2\;([0-9]##)\;([0-9]##)\;([0-9]##)* ]] || HBr=$match[1] HBg=$match[2] HBb=$match[3]
  xmix $HBr $HBg $HBb $1; REPLY=$e"[48;2;${REPLY}m"
}

# --- transitions ------------------------------------------------------------------
# Nothing in the pane changes at once. A key that changes what the pane
# shows starts a transition from what is on the screen to what will be, a
# frame every 20ms, and the pane lands on the real preview when it is done.
# The head (a stop's words, a step's) holds where it is, as tall as every
# head of the walk or tour (headpad), and its words change in place, a row
# at a time; under it the code:
#   scrolls, to another line of the same file, as an editor would: what
#     hangs under the old lines folds, the lines move together to the new
#     one, and what hangs under the new lines unfolds (xcode);
#   pushes, to another file or a page with no code: the old code goes up
#     and away and the new follows it in (down and away with k).
# The key that starts one is handled at once; any key or the mouse lands
# the one going first (xstop).
typeset -a XK XO XN XF XT XOLD XOLDK XNEW XNEWK XHO XHN XHF
integer xfh=0 xfk=0
xmode=anchor
integer xon=0 xa0=0 xa1=0 xy0=0 xy1=0 xland=0 syncing=0
float xt0=0 xdur=0.2
xnext= afile=
float xe=0 xh=0
# The ground of the line you are on, as walk.mjs draws it.
if [[ $OTIS_T_ATTENTION == (#b)*38\;2\;([0-9]##)\;([0-9]##)\;([0-9]##)* ]]; then
  HEREbg=$e"[48;2;$(( int(match[1] * 0.28 + 0.5) ));$(( int(match[2] * 0.28 + 0.5) ));$(( int(match[3] * 0.28 + 0.5) ))m"
else HEREbg=$e'[48;5;58m'; fi
# xkeys <rows...>: a key a row (reply): L<n> a line of code, R<n> a line
# the change removed, <key>+<row> what hangs under one (its values, its
# box, a piece of it wrapped), h:<row> a row over the code (a stop's words).
xkeys() {
  local r last= k pat="(#b)(#s)($e\\[[0-9;]#m)#( #)([0-9]##)$e\\[0m($e\\[[0-9;]#m)# (*)"
  local -A seen
  reply=()
  for r in "$@"; do
    if [[ $r == ${~pat} ]]; then
      if [[ $match[5] == ($e\[[0-9\;]#m)#-* ]]; then k=R$match[3]; else k=L$match[3]; fi
      last=$k
    elif [[ -n $last ]]; then k=$last+$r
    else k=h:$r; fi
    (( seen[$k]++ )) && k+="#$seen[$k]"
    reply+=("$k")
  done
}
# xfile <file>: a preview drawn ahead, whole, head and all (reply), as the
# pane shows it scrolled to its top.
xfile() {
  local -a p=("${(@f)$(<$1)}")
  xfh=0 xfk=0
  [[ $p[1] == (#b)$'\036'pin\ (<->)(\ at\ (<->))# ]] && { xfh=$match[1] xfk=${match[3]:-0}; p=("${(@)p[2,-1]}"); }
  reply=("${(@)p}")
}
# xshown: what the pane shows now, as one list from its top (XOLD, XOLDK):
# the head and the code from where it is scrolled.
xcr0=
integer xpo=0
xshown() {
  # What is shown now, before the key moves the cursor (go sets the scroll
  # for the row it lands on): the head line, the scroll, the rows.
  xcr0=$crumbline xpo=$poff
  XOLD=("${(@)PH}" "${(@)P[poff+1,-1]}")
  xkeys "${(@)XOLD}"; XOLDK=("${(@)reply}")
}
# xnew <file>: the preview it goes to (XNEW, XNEWK).
xnew() {
  xfile $1; XNEW=("${(@)reply}")
  xkeys "${(@)XNEW}"; XNEWK=("${(@)reply}")
}
# xmerge: XOLD and XNEW as one list: XK the keys, XO and XN each one's row,
# XF 0 both, 1 the old alone, 2 the new alone.
xmerge() {
  local -A inN
  integer i n=$#XOLDK m=$#XNEWK j
  for (( j = 1; j <= m; j++ )); do inN[$XNEWK[j]]=$j; done
  XK=() XO=() XN=() XF=()
  i=1 j=1
  while (( i <= n || j <= m )); do
    if (( i <= n && j <= m )) && [[ $XOLDK[i] == $XNEWK[j] ]]; then
      XK+=("$XOLDK[i]") XO+=("$XOLD[i]") XN+=("$XNEW[j]") XF+=(0); (( i++, j++ ))
    elif (( i <= n )) && { (( j > m )) || (( ! ${+inN[$XOLDK[i]]} )) || (( inN[$XOLDK[i]] < j )); }; then
      XK+=("$XOLDK[i]") XO+=("$XOLD[i]") XN+=("") XF+=(1); (( i++ ))
    else
      XK+=("$XNEWK[j]") XO+=("") XN+=("$XNEW[j]") XF+=(2); (( j++ ))
    fi
  done
  # A line of code only one has is the same file around it, drawn the same
  # (walk.mjs's codeRows): it stays, so only what hangs under lines folds,
  # and nothing out of sight folds at once and jerks the scroll.
  for (( i = 1; i <= $#XK; i++ )); do
    [[ $XF[i] != 0 && $XK[i] == [LR]<->(\#<->)# ]] || continue
    if (( XF[i] == 1 )); then XN[i]=$XO[i]; else XO[i]=$XN[i]; fi
    XF[i]=0
  done
}
# xsame <rows...>: every row in both, for a scroll (XK XO XN XF).
xsame() {
  local r
  XO=("$@") XN=("$@") XF=()
  for r in "$@"; do XF+=(0); done
}
# xwhen: when each row folds (the old alone) or unfolds (the new alone):
# a wave out from the anchor, a row going and a row coming at the same
# distance at the same moment, so the pane never opens a gap. The rows that
# change within a pane's height of the anchor are spread evenly over the
# whole of it by their order out from the anchor, however many or few, so
# thirteen rows of a box fold one by one rather than in a blink; those
# farther off, out of sight, change at the end. None on the first frame.
xwhen() {
  integer i d H=$(( ph - 2 )) n=0 k
  local -a near
  XT=()
  for (( i = 1; i <= $#XK; i++ )); do
    XT+=(0)
    (( XF[i] )) || continue
    (( d = i > xa1 ? i - xa1 : xa1 - i ))
    if (( d <= H )); then near+=("${(l:6::0:)d} $i"); (( n++ )); else XT[i]=$(( 1 - XFW )); fi
  done
  (( n )) || return 0
  # A row going starts fading at once (it is gone by XT), a row coming
  # starts showing at once (it is in by XT + XFW): the first frame after
  # the key already moves.
  k=0
  float r
  for d i in ${=${(on)near}}; do
    (( r = n > 1 ? 1.0 * k / (n - 1) : 0 ))
    if (( XF[i] == 1 )); then XT[i]=$(( XFW + (1 - XFW) * r )); else XT[i]=$(( (1 - XFW) * r )); fi
    (( k++ ))
  done
}
# xstart <seconds> <next phase>: go.
xstart() {
  xdur=$1 xnext=$2 xt0=$EPOCHREALTIME xon=1 syncing=1
}
# xindex <key>: its place in XK, else 0.
xindex() { REPLY=${XK[(ie)$1]}; (( REPLY <= $#XK )) || REPLY=0; }
# xvis <i>: shown at this moment: in both, or not folded yet, or unfolded already.
xvis() { (( XF[$1] == 0 || (XF[$1] == 1 && xe < XT[$1]) || (XF[$1] == 2 && xe >= XT[$1]) )); }
# xease: how far the phase has come, eased in and out (xe).
xease() {
  float t=$(( (EPOCHREALTIME - xt0) / xdur ))
  (( t > 1 )) && t=1
  # Sine in and out: it gets going at once and settles gently, where a
  # cubic sat still for its first fifth, which read as the key lagging.
  (( xe = (1 - cos(3.14159265 * t)) / 2 ))
}
# xrow <i>: the merged row i at this moment of a push (REPLY): every row is
# in both there, so as it is.
float XFW=0.22
xrow() { REPLY=$XN[$1]; }
# xswap <old> <new>: a row changing in place, crossfaded (REPLY): the
# old dims a quarter and the new comes up from there, never through nothing,
# which read as a blink, nor far, which read as a flicker.
xswap() {
  if [[ $1 == "$2" ]]; then REPLY=$2
  elif (( xe < 0.5 )); then xfade "$1" $(( 1 - 0.25 * (xe < 0.25 ? 0 : (xe - 0.25) / 0.25) ))
  else xfade "$2" $(( 0.75 + 0.25 * (xe > 0.75 ? 1 : (xe - 0.5) / 0.25) )); fi
}
# xbar <row> <a>: the bar of the line you are on over the row, a of the
# way in (REPLY), carried past every reset in it.
xbar() {
  local c=${1//${~${(b)HEREbg}}/} g
  integer padn
  xbarbg $2; g=$REPLY
  vw "$c"; (( padn = pw - REPLY, padn < 0 ? (padn = 0) : 0 ))
  REPLY=$g${c//(#m)$e\[0(\;[0-9\;]#)#m/$MATCH$g}${(l:padn:: :)}$R
}
# xframe: the pane at this moment of it (P, drawn from the pane's top, the
# head first, held in place, changing in place).
xframe() {
  xease
  P=()
  integer i
  # The head's words change over the whole of a scroll, not each step of it.
  xh=$xe
  if [[ $xmode == code ]]; then
    # Done in the first 0.6s at most: a head half one stop and half the
    # next for long reads as noise.
    (( xh = (EPOCHREALTIME - xg0) / (xgdur < 0.6 ? (xgdur > 0 ? xgdur : 1) : 0.6), xh > 1 ? (xh = 1) : 0 ))
    (( xh = (1 - cos(3.14159265 * xh)) / 2 ))
  fi
  # The head's words change a row at a time, top down, each row out and its
  # new words in (a wave, so the head is never all gone at once), and it
  # grows before the new words come or shrinks after the old have gone, a
  # row at a time, so the code under it never jumps.
  integer ho=$#XHO hn=$#XHN hr n=$#XHF
  float tl
  if (( hn < ho )); then (( hr = xh < 0.8 ? ho : int(ho + (hn - ho) * (xh - 0.8) * 5 + 0.5) ))
  else (( hr = xh >= 0.2 ? hn : int(ho + (hn - ho) * xh * 5 + 0.5) )); fi
  for (( i = 1; i <= hr; i++ )); do
    (( tl = (xh - 0.5 * (i - 1) / (n > 1 ? n - 1 : 1)) / 0.3, tl < 0 ? (tl = 0) : (tl > 1 ? (tl = 1) : 0) ))
    if (( XHF[i] == 0 )) && [[ $XHO[i] == "$XHN[i]" ]]; then REPLY=$XHN[i]
    elif (( tl < 0.5 )); then
      if (( XHF[i] == 2 )); then REPLY=; else xfade "$XHO[i]" $(( 1 - tl * 2 )); fi
    elif (( XHF[i] == 1 )); then REPLY=
    else xfade "$XHN[i]" $(( tl * 2 - 1 )); fi
    P+=("$REPLY")
  done
  if [[ $xmode == code ]]; then xcodeat; xframe_code; else xframe_anchor; fi
  PH=() HB=() hoff=0 phd=2 poff=0 pfile=
}
# xframe_anchor: the code under the head around the anchor row, which goes
# from xa0 to xa1 and from row xy0 to xy1 of the code.
xframe_anchor() {
  integer H=$(( ph - 2 - $#P )) A y i n
  (( A = int(xa0 + (xa1 - xa0) * xe + 0.5), y = int(xy0 + (xy1 - xy0) * xe + 0.5) ))
  while (( A > 1 )) && ! xvis $A; do (( A-- )); done
  local -a up down
  for (( i = A - 1; i >= 1 && $#up < y; i-- )); do xvis $i && up=($i $up); done
  for (( i = A + 1; i <= $#XK && $#down < H - y - 1; i++ )); do xvis $i && down+=($i); done
  for (( n = $#up; n < y; n++ )); do P+=(""); done
  for i in $up $A $down; do xrow $i; P+=("$REPLY"); done
}
# xtick: a frame on; a phase done goes on to the next, the last lands.
xtick() {
  (( EPOCHREALTIME - xt0 >= xdur )) || return 0
  if [[ -n $xnext ]]; then local f=$xnext; xnext=; $f; return 0; fi
  xon=0 pfile= poff=$xland
  (( cur )) && offs[$rid[cur]]=$poff
  return 0
}
# xstop: land the one going now, drawn, so a key goes on from there.
xstop() {
  (( xon )) || return 0
  while (( xon )); do xt0=0; xtick; done
  draw
}

# headpad <rows...>: a pinned head as tall as most heads of the walk or
# tour (hfix, the median), blank rows over its rule, so the code under most
# of them starts on the same row and only their words change (reply). A
# taller head is its own height: padding every head to the tallest left a
# short one a gap of a dozen rows where code could be.
integer hfix=0
# headroom: the rows a pinned head may take: two fifths of the pane, so the
# code under it always has the rest to itself (a head that took all but six
# rows left three lines of code, and cut its own end off).
headroom() { REPLY=$(( (ph - 2) * 2 / 5 )); (( REPLY < 6 )) && REPLY=6; }
# headview <room> <rows...>: the rows the pane shows of a head: all of them
# (padded, headpad) when they fit, else a window of them from hoff and a
# last row that says how much more there is and how to see it.
headview() {
  integer room=$1; shift
  if (( $# <= room )); then headpad "$@"; return; fi
  (( hoff > $# - room + 1 )) && hoff=$(( $# - room + 1 ))
  (( hoff < 0 )) && hoff=0
  local -a v=("${(@)argv[hoff+1,hoff+room-1]}")
  integer below=$(( $# - hoff - room + 1 ))
  # A rule across the pane, the note set in it: where this part ends and
  # the code begins.
  local note
  if (( below > 0 )); then note=" ↓ $below more line$( (( below == 1 )) || print s) · J scrolls this part, K back "
  else note=" end of this part · K back to its top "; fi
  v+=("${F}──${note}${(l:pw - 4 - ${(m)#note}::─:)}$R")
  reply=("${(@)v}")
}
# headscroll <rows>: J and K on a head taller than its room.
headscroll() {
  (( $#HB > hroom )) || return 1
  (( hoff += $1 ))
  headview $hroom "${(@)HB}"; PH=("${(@)reply}")
  return 0
}
headpad() {
  reply=("$@")
  integer want=$hfix room=$(( ph - 2 - 6 )) i
  (( want > room )) && want=room
  (( $#reply >= want )) && return 0
  local -a pad
  for (( i = $#reply; i < want; i++ )); do pad+=(""); done
  if [[ $reply[-1] == *─* ]]; then reply=("${(@)reply[1,-2]}" "${(@)pad}" "$reply[-1]")
  else reply+=("${(@)pad}"); fi
}
# hfixof <dir> <names...>: hfix, the median head of those previews.
hfixof() {
  local d=$1 f l; shift
  local -a hs
  hfix=0
  for f in "$@"; do
    [[ -r $d/$f ]] || continue
    IFS= read -r l < $d/$f
    [[ $l == (#b)$'\036'pin\ (<->)* ]] && hs+=($match[1])
  done
  (( $#hs )) && { hs=(${(on)hs}); hfix=$hs[$(( ($#hs + 1) / 2 ))]; }
}
# xsplit <file>: a preview drawn ahead as the pane will show it: its head
# (NH, as many rows as the pane pins, padded as every head is: headpad) and
# its code (NB), the row of the code its line is on (NK), and the scroll it
# lands at (NL), that line a third of the way down.
typeset -a NH NB NBK
integer NK=0 NL=0
xsplit() {
  xfile $1
  local -a all=("${(@)reply}")
  integer np=$xfh room
  headroom; room=$REPLY
  # As the pane will show it once landed (headview, from its top).
  hoff=0; headview $room "${(@)all[1,np]}"; NH=("${(@)reply}")
  NB=("${(@)all[np+1,-1]}")
  xkeys "${(@)NB}"; NBK=("${(@)reply}")
  (( NK = xfk ? xfk : 0 ))
  xlanding $#NH
  NL=$REPLY
}
# xlanding <head rows>: where a preview lands scrolled: its line (NK) a third
# of the way down the code under a head that tall.
xlanding() {
  integer F=$(( (ph - 2 - $1) / 3 ))
  REPLY=$(( NK - 1 - F > 0 ? NK - 1 - F : 0 ))
}
# xhead <old rows> -- <new rows>: the head crossfading in place (XHO XHN XHF).
xhead() {
  integer i n
  XHF=()
  (( n = $#XHO > $#XHN ? $#XHO : $#XHN ))
  for (( i = 1; i <= n; i++ )); do
    if (( i <= $#XHO && i <= $#XHN )); then XHF+=(0); elif (( i <= $#XHO )); then XHF+=(1); else XHF+=(2); fi
  done
}
# xpush <1 forward, -1 back>: to another file or a page with no code. When
# both have a head it holds and its words change in place while the code
# under it goes up and away and the new code follows it in (down with k);
# else the old pane goes whole and the new one follows it, head and all.
xpush() {
  integer H=$(( ph - 2 ))
  local -a old new
  if (( $#PH && $#NH )); then
    XHO=("${(@)PH}") XHN=("${(@)NH}"); xhead
    (( H -= $#NH ))
    old=("${(@)P[xpo+1,-1]}") new=("${(@)NB[NL+1,-1]}")
  else
    XHO=() XHN=() XHF=()
    old=("${(@)PH}" "${(@)P[xpo+1,-1]}") new=("${(@)NH}" "${(@)NB[NL+1,-1]}")
  fi
  old=("${(@)old[1,H]}") new=("${(@)new[1,H]}")
  # Between them a rule, so where one file ends and the next begins reads
  # as that, not as lines of one skipped.
  local seam="  $F${(l:pw-4::─:)}$R"
  if (( $1 > 0 )); then
    XK=("${(@)old}" "$seam" "${(@)new}")
    xa0=1 xa1=$(( $#old + 2 ))
  else
    XK=("${(@)new}" "$seam" "${(@)old}")
    xa0=$(( $#new + 2 )) xa1=1
  fi
  xsame "${(@)XK}"; XT=()
  xy0=0 xy1=0 xland=$NL xmode=anchor
  xstart 0.6 ""
}
# The scroll, to another line of the same file, as an editor would: the file
# is one list of its lines (the file whole, GFR, with each preview's own
# rows in place of its lines: xspread), and it goes in three steps, one
# thing at a time:
#   fold: what hangs under the old lines (values, boxes) fades and folds
#     away, the old line held where it is;
#   scroll: the lines, and only the lines, move together from where the old
#     line is to where the new one lands, its bar going off the old line and
#     on to the new as they pass;
#   unfold: the new lines' marks come in, and what hangs under them unfolds,
#     the new line held where it lands.
typeset -a GFR GFK XTA XTC XV
integer xfa=0 xfb=0 xA0=0 xY0=0 xA1=0 xY1=0 xtop0=0 xtop1=0
float xg0=0 xgdur=0 xdA=0 xdB=0 xdC=0
xphase=
# xspread <rows> <keys> <g0> <g1>: the file whole from its row g0 to g1 with
# those rows (a preview's code) in place of its lines there (reply).
xspread() {
  local -a R=("${(@P)1}") K=("${(@P)2}")
  local -A at
  integer i n=$#K g own=0
  for (( i = 1; i <= n; i++ )); do [[ $K[i] == [LR]<->(\#<->)# ]] && at[$K[i]]=$i; done
  reply=()
  for (( g = $3; g <= $4; g++ )); do
    if [[ $GFK[g] == [LR]<->(\#<->)# ]]; then
      if (( ${+at[$GFK[g]]} )); then
        own=1 i=$at[$GFK[g]]
        reply+=("$R[i]")
        for (( i++; i <= n && ! ${+at[$K[i]]}; i++ )); do reply+=("$R[i]"); done
      else own=0 reply+=("$GFR[g]"); fi
    elif (( ! own )); then reply+=("$GFR[g]"); fi
  done
}
# xcode <from line> <to line>: the scroll, set going (see above).
xcode() {
  integer la=$1 lb=$2 H=$(( ph - 2 - $#NH )) g0 g1 i
  local -a ok nk
  XOLD=("${(@)P}"); xkeys "${(@)XOLD}"; XOLDK=("${(@)reply}")
  (( ${XOLDK[(ie)L$la]} <= $#XOLDK && ${NBK[(ie)L$lb]} <= $#NBK && ${GFK[(ie)L$la]} <= $#GFK && ${GFK[(ie)L$lb]} <= $#GFK )) || return 1
  # Only the stretch of the file both previews cover and what lies between.
  ok=(${(M)XOLDK:#[LR]<->}) nk=(${(M)NBK:#[LR]<->})
  (( $#ok && $#nk )) || return 1
  g0=${GFK[(ie)$ok[1]]} g1=${GFK[(ie)$ok[-1]]}
  i=${GFK[(ie)$nk[1]]}; (( i < g0 )) && g0=i
  i=${GFK[(ie)$nk[-1]]}; (( i > g1 && i <= $#GFK )) && g1=i
  (( g1 > $#GFK )) && g1=$#GFK
  xspread XOLD XOLDK $g0 $g1; XOLD=("${(@)reply}"); xkeys "${(@)XOLD}"; XOLDK=("${(@)reply}")
  xspread NB NBK $g0 $g1; XNEW=("${(@)reply}"); xkeys "${(@)XNEW}"; XNEWK=("${(@)reply}")
  xmerge
  xindex L$la; xfa=$REPLY; xindex L$lb; xfb=$REPLY
  (( xfa && xfb )) || return 1
  # The bars off the two lines: drawn over them as the steps go (xcrow).
  local strip=${~${(b)HEREbg}}
  XO[xfa]=${XO[xfa]//$strip/} XN[xfa]=${XN[xfa]//$strip/}
  XO[xfb]=${XO[xfb]//$strip/} XN[xfb]=${XN[xfb]//$strip/}
  # Held rows: the old line where it is shown (else the top row, at the
  # top), the new line where it lands.
  xkeys "${(@)P}"
  integer oi=${reply[(ie)L$la]}
  (( xY0 = oi - 1 - xpo ))
  if (( xY0 >= 0 && xY0 < H )); then xA0=$xfa
  else xindex "$reply[xpo+1]"; xA0=$REPLY xY0=0; fi
  (( xY1 = ${NBK[(ie)L$lb]} - 1 - NL ))
  if (( xY1 >= 0 && xY1 < H )); then xA1=$xfb
  else xindex "$NBK[NL+1]"; xA1=$REPLY xY1=0; fi
  (( xA0 && xA1 )) || return 1
  # When each row folds (ranked out from the old line) and unfolds (from the new).
  xa1=$xA0; xwhen; XTA=("${(@)XT}")
  xa1=$xA1; xwhen; XTC=("${(@)XT}")
  # The lines alone, in order: what the scroll moves through.
  XV=()
  for (( i = 1; i <= $#XK; i++ )); do (( XF[i] )) || XV+=($i); done
  (( xtop0 = ${XV[(ie)$xA0]} - 1 - xY0, xtop1 = ${XV[(ie)$xA1]} - 1 - xY1 ))
  integer nold=${#${(M)XF:#1}} nnew=${#${(M)XF:#2}} dist=$(( xtop1 > xtop0 ? xtop1 - xtop0 : xtop0 - xtop1 ))
  # Folding and unfolding as long as there is to fold: a row or three
  # quickly, a box of a dozen at a pace to follow.
  (( xdA = nold ? 0.2 + (nold > 12 ? 12 : nold) * 0.025 : 0 ))
  # A few rows go quickly, row after row at an even beat; a terminal moves
  # whole rows, so a short scroll drawn out reads as steps, not motion.
  (( xdB = 0.5 + (dist > 900 ? 900 : dist) / 700.0, dist && 0.1 + 0.06 * dist < xdB ? (xdB = 0.1 + 0.06 * dist) : 0 ))
  (( dist == 0 )) && (( xdB = xfa != xfb ? 0.3 : 0 ))
  (( xdC = 0.3 + (nnew > 12 ? 12 : nnew) * 0.02 ))
  XHO=("${(@)PH}") XHN=("${(@)NH}"); xhead
  xland=$NL xmode=code
  xg0=$EPOCHREALTIME xgdur=$(( xdA + xdB + xdC ))
  xstart $xgdur ""
}
# xcodeat: which of the three this moment is in (xphase), and how far
# through it, eased (xe): each starts and settles gently, one straight
# after another.
xcodeat() {
  float t=$(( EPOCHREALTIME - xt0 ))
  (( t > xgdur )) && t=$xgdur
  if (( t < xdA )); then xphase=A; (( xe = t / xdA ))
  elif (( t < xdA + xdB )); then xphase=B; (( xe = (t - xdA) / xdB ))
  else xphase=C; (( xe = (t - xdA - xdB) / xdC )); fi
  (( xe = (1 - cos(3.14159265 * xe)) / 2 ))
}
# xcrow <i>: merged row i at this moment of the scroll (REPLY).
xcrow() {
  integer n=$1
  float a
  case $XF[n] in
    1) xfade "$XO[n]" $(( (XTA[n] - xe) / XFW )); return ;;
    2) xfade "$XN[n]" $(( (xe - XTC[n]) / XFW )); return ;;
  esac
  if [[ $xphase == C ]]; then xswap "$XO[n]" "$XN[n]"; else REPLY=$XO[n]; fi
  if (( n == xfa && n == xfb )); then a=1
  elif (( n == xfa )); then
    case $xphase in A) a=1 ;; B) (( a = 1 - 2 * xe )) ;; C) a=0 ;; esac
  elif (( n == xfb )); then
    case $xphase in A) a=0 ;; B) (( a = 2 * xe - 1 )) ;; C) a=1 ;; esac
  else return 0; fi
  (( a > 0.02 )) && { xbar "$REPLY" $a; }
  return 0
}
# xframe_code: the code under the head at this moment of the scroll.
xframe_code() {
  integer H=$(( ph - 2 - $#P )) i top A y
  local -a up down
  if [[ $xphase == B ]]; then
    (( top = int(xtop0 + (xtop1 - xtop0) * xe + (xtop1 > xtop0 ? 0.5 : -0.5)) ))
    for (( i = top + 1; i <= top + H; i++ )); do
      if (( i < 1 || i > $#XV )); then P+=(""); else xcrow $XV[i]; P+=("$REPLY"); fi
    done
    return 0
  fi
  if [[ $xphase == A ]]; then A=$xA0 y=$xY0; else A=$xA1 y=$xY1; fi
  for (( i = A - 1; i >= 1 && $#up < y; i-- )); do xcvis $i && up=($i $up); done
  for (( i = A + 1; i <= $#XK && $#down < H - y - 1; i++ )); do xcvis $i && down+=($i); done
  for (( i = $#up; i < y; i++ )); do P+=(""); done
  for i in $up $A $down; do xcrow $i; P+=("$REPLY"); done
}
# xcvis <i>: shown at this moment of the scroll: a line always, what hangs
# under the old ones until it folds, under the new once it unfolds.
xcvis() {
  case $XF[$1] in
    0) return 0 ;;
    1) [[ $xphase == A ]] && (( xe < XTA[$1] )) ;;
    2) [[ $xphase == C ]] && (( xe >= XTC[$1] )) ;;
  esac
}
# xgo <new preview> <file whole or ""> <from line> <to line> <1|-1>: the
# transition from what is shown to that preview: the scroll within a file,
# else the push.
typeset -A xkcache
xgo() {
  local np=$1 fv=$2
  integer la=$3 lb=$4 dir=$5
  xsplit $np
  if [[ -n $fv ]] && (( la && lb )); then
    [[ $afile == $fv ]] || { GFR=("${(@f)$(<$fv)}") afile=$fv; }
    if [[ -n $xkcache[$fv] ]]; then GFK=("${(@ps:\x1f:)xkcache[$fv]}")
    else xkeys "${(@)GFR}"; GFK=("${(@)reply}"); xkcache[$fv]=${(pj:\x1f:)GFK}; fi
    xcode $la $lb && return
  fi
  xpush $dir
}
# panes_go <row it was on> <1|-1>: from that row's preview to this one's: a
# scroll when both say where they are (<name>.at) in the same file, within
# 300 lines, and the directory has it whole (files/), else a push.
panes_go() {
  local a=${rid[$1]#*:} b=${rid[cur]#*:} pa pb fv= np=/dev/null
  integer la=0 lb=0
  [[ -e $pdir/$b ]] && { wrapped $pdir $pwdir $pw $b; np=$REPLY; }
  if [[ -r $pdir/$a.at && -r $pdir/$b.at ]]; then
    read -r pa la _ < $pdir/$a.at; read -r pb lb _ < $pdir/$b.at
    # A stop far down the same file is pushed to like one in another: the
    # scroll lays out every line between first, and 1,500 of them held j a
    # third of a second before anything moved.
    [[ $pa == $pb && -e $pdir/files/${pa//\//%} ]] && (( la - lb < 300 && lb - la < 300 )) && { wrapped $pdir $pwdir $pw files/${pa//\//%}; fv=$REPLY; }
  fi
  xgo $np "$fv" $la $lb $2
}

# steps_key <j|l|h|k>: over, into, out, or back.
steps_key() {
  steps_at || return
  local k=$REPLY j
  case $1 in
    j) j=$nover[k+1] ;;
    # Nothing to step into: over, as a debugger's step does.
    l) j=$ninto[k+1]; (( j < 0 )) && j=$nover[k+1] ;;
    h) j=$nout[k+1] ;;
    k) j=${shist[-1]:--1} ;;
  esac
  if (( j < 0 )); then
    case $1 in
      j) flash="that was its last line in this call; h goes out" ;;
      l) flash="that was its last line in this call; h goes out" ;;
      h) flash="the test called this one" ;;
      k) flash="nowhere to go back to" ;;
    esac
    return
  fi
  if [[ $1 == k ]]; then shist[-1]=(); else shist+=($k); fi
  xshown
  kcur=$j
  print -r -- $j > $st/cur
  local row=${rid[(ie)v:$nvi[j+1]]}
  (( row <= $#rid )) && go $row
  # From what is shown to the step's preview: in the same file a scroll,
  # else a push (xgo).
  local fv=
  (( nfi[k+1] == nfi[j+1] )) && { steps_file file-$nfi[j+1]; fv=$REPLY; }
  steps_file $j
  local dir=-1; [[ $1 == [jl] ]] && dir=1
  xgo $REPLY "$fv" $nline[k+1] $nline[j+1] $dir
}
# subst <text> <row>: fzf's {n} as the row's nth field, quoted; {q} the query.
subst() {
  local s=$1 n
  local -a f
  (( $2 )) && f=("${(@ps:\t:)raw[$2]}")
  while [[ $s == (#b)(*)\{([0-9]##|q)\}(*) ]]; do
    n=$match[2]
    if [[ $n == q ]]; then s=$match[1]${(qq)query}$match[3]; else s=$match[1]${(qq)f[n]}$match[3]; fi
  done
  REPLY=$s
}
render() {
  local w=$1 file=$2 i=$3
  subst "$preview" $i
  FZF_PREVIEW_COLUMNS=$w zsh -fc "$REPLY" 2>/dev/null </dev/null > $file.raw
  wrapin $w $file.raw $file $file.tmp
  rm -f $file.raw
}
# wrapin <width> <raw> <file> <tmp>: a preview as it came, wrapped to the
# pane, written through <tmp> into <file>, and where each line wrapped into
# <file>.cont (for a selection's copy).
wrapin() {
  local w=$1 raw=$2 file=$3 tmp=$4 first
  IFS= read -r first < $raw
  if [[ $first == $'\036'pin\ <->* ]]; then
    # Pinned lines ("\036pin N" and N lines, draw): wrapped apart from the
    # rest, and the marker written after, with how many lines they wrapped
    # to, since the wrap drops the control character that marks it, and
    # whatever it says after the count (" at K", the row of the code the
    # preview's line is on).
    local rest=${first#*pin }
    integer n=${rest%% *}
    local suf=${rest#$n}
    sed -n "2,$(( n + 1 ))p" $raw | LC_ALL=C awk -v w=$w -v cont=/dev/null "$wrap_awk" > $tmp.pin
    { print -r -- $'\036'"pin ${$(wc -l < $tmp.pin)// /}$suf"
      cat $tmp.pin
      sed -n "$(( n + 2 )),\$p" $raw | LC_ALL=C awk -v w=$w -v cont=$tmp.cont "$wrap_awk"; } > $tmp
    rm -f $tmp.pin
  else
    LC_ALL=C awk -v w=$w -v cont=$tmp.cont "$wrap_awk" < $raw > $tmp
  fi
  mv -f $tmp.cont $file.cont 2>/dev/null
  mv -f $tmp $file
}
# want: the row you are on, drawn if it is not kept yet. One at a time: a
# row changed under you again and again (a key held) waits for the render
# out to finish, then draws the newest, rather than starting one each time.
integer wpid=0
want() {
  local f
  (( cur && pw > 0 )) && [[ -n $preview && -z $stepscmd$panescmd && $typ[cur] != head ]] || return 1
  (( wpid )) && kill -0 $wpid 2>/dev/null && return 1
  pvname "$rid[cur]" $pw; f=$REPLY.$gen
  [[ -e $f || -e $f.tmp ]] && return 1
  : > $f.tmp
  render $pw $f $cur &!
  wpid=$!
}
# warm: the rows around the cursor, a few either side, one after another,
# so j and k find them drawn. It stops at a gen or a width that is not the
# one it was started for.
warm() {
  (( pw > 0 && $#vis )) && [[ -n $preview && -z $stepscmd$panescmd ]] || return
  print -r -- "$gen $pw" > $st/pv/gen
  local -a near
  local at=${vis[(Ie)$cur]} j
  for (( j = 1; j <= 6; j++ )); do
    (( at + j <= $#vis )) && near+=($vis[at+j])
    (( at - j >= 1 )) && near+=($vis[at-j])
  done
  {
    local i f g="$gen $pw"
    for i in $near; do
      [[ $(<$st/pv/gen) == $g ]] || break
      pvname "$rid[i]" $pw; f=$REPLY.$gen
      [[ -e $f || -e $f.tmp ]] && continue
      : > $f.tmp
      render $pw $f $i
    done
  } &!
}
# Where the row is, over its preview: its file and line, and the rows it is
# under, by name.
crumb() {
  local i=$cur p s n
  local -a steps names
  (( cur )) || { REPLY=; return }
  fields $i
  line= used=0
  case $typ[i] in
    sym|caller|file|plain)
      p=$fld[2]
      if [[ -n $p ]]; then
        [[ $p == */* ]] && put "$C" "${p:h}/"
        put "$T" "${p:t}"; [[ -n $fld[3] && $fld[3] != 1 || $typ[i] == sym ]] && put "$C" ":$fld[3]"
      fi
      case $chg[i] in
        signature) put "$C" "  ·  "; put "$A" "signature changed" ;;
        added) put "$C" "  ·  "; put "$G" "added" ;;
        removed) put "$C" "  ·  "; put "$X" "removed" ;;
        body) [[ $typ[i] == sym ]] && { put "$C" "  ·  "; put "$C" "body changed"; } ;;
      esac
      [[ $typ[i] == caller ]] && { put "$C" "  ·  "; put "$C" "not in the change"; }
      ;;
    callers) put "$C" "callers elsewhere, which the change did not touch" ;;
    package) put "$C" "package "; put "$EL" "$lab[i]" ;;
  esac
  # The way down to it: each step's name, a member's with its class.
  steps=("${(@s:>:)rid[i]}")
  if (( $#steps > 1 )); then
    for s in $steps[1,-2]; do
      [[ $s == callers ]] && { names+=("callers"); continue; }
      n=${s#*\#}; n=${n#type }; n=${n//+/.}
      names+=("$n")
    done
    put "$C" "  ·  under "; put "$T" "${(j: › :)names}"
  fi
  cut "$line" $(( pw - 1 )); REPLY=$REPLY
}

# --- what the keys mean on this row ------------------------------------------------------
# symkeys: for the row under the cursor, what a key does there, in rkl (key
# → label; an empty label is a key that does nothing on it, which the footer
# leaves out). A key not named keeps its label. From what the row already
# says, so it costs the footer nothing.
typeset -A rkl
symkeys() {
  local i=$cur
  rkl=()
  (( i )) || return
  case $typ[i] in
    head|plain) rkl=(l "" h "" v "" i "" c "" F "" space "" y "") ; return ;;
  esac
  case $fold[i] in
    closed|quiet) if (( kids[i] > 0 )); then rkl[l]="open it: ${kids[i]} under it"; else rkl[l]="open it"; fi; rkl[h]="" ;;
    open) rkl[l]=""; rkl[h]="close it" ;;
    *) rkl[l]=""; rkl[h]="" ;;
  esac
  if [[ $typ[i] == (sym|file) ]]; then
    if [[ $vwd[i] == all ]]; then rkl[v]="mark it not viewed"
    elif (( kids[i] > 0 )); then rkl[v]="mark it and all under it viewed"
    else rkl[v]="mark it viewed"; fi
  else rkl[v]=""; fi
  [[ $typ[i] == sym ]] || rkl[i]=""
  # c comments on a row's lines in a review; in ga it commits, whatever the row.
  [[ -n $GMR_IID && $typ[i] != (sym|file) ]] && rkl[c]=""
  # A caller the change breaks: Claude's fix is the thing to do.
  if [[ $typ[i] == caller && $err[i] == x ]]; then rkl[F]="make the proposed fix"; rkl[enter]="open the broken call"
  else rkl[F]=""; fi
  [[ $typ[i] == (callers|package) ]] && rkl[y]=""
  # The worktree's: staged, not staged, or some of each.
  if [[ -n ${bind[space]} ]]; then
    fields $i
    if [[ $fld[9] == 1 && $fld[10] != 1 ]]; then rkl[space]="unstage it"
    elif [[ $fld[9] == 1 ]]; then rkl[space]="stage the rest of it"
    elif [[ $typ[i] == (sym|file) ]]; then rkl[space]="stage it"
    else rkl[space]=""; fi
  fi
}

# --- the frame -------------------------------------------------------------------
integer help=0 poff=0 plen=0
flash=
typeset -a shown_rows shown_pane
# scroll <lines>: the preview moved, in one frame. A glide sent a frame of
# the whole pane every 10ms, which under a multiplexer stuttered and lagged
# rather than glided.
scroll() {
  local max
  (( max = plen - (ph - phd), max < 0 ? (max = 0) : 0 ))
  (( poff += $1, poff > max ? (poff = max) : 0, poff < 0 ? (poff = 0) : 0 ))
}
helplines() {
  local k v n
  P=()
  for (( n = 1; n <= $#hk; n++ )); do P+=("  ${A}${(r:9:: :)hk[n]}$R ${C}$hv[n]$R"); done
  P+=("")
  for k v in j/k move g/G "top, bottom (unless the list takes them)" / "search the rows" ctrl-d/u "scroll the preview" \
    ctrl-e/y "the preview a line" J/K "the part above the code, when it has more than fits (the wheel over it too)" \
    "]/[" "next, previous change in the preview" "./," "next, previous symbol not yet viewed" \
    drag "in the preview: lines of the diff, copied without the gutter; a asks Claude about them; in a review, c comments on them" \
    ctrl-a "show or hide Claude's panel, where a asks it" \
    "?" "this, and back" "q/esc" "back"; do
    P+=("  ${A}${(r:9:: :)k}$R ${C}$v$R")
  done
  P+=("" "  ${B}${T}a row$R" ""
    "  ${B}${A}~$R$C its signature changed   $G+$R$C added   $X-$R$C removed   $F·$R$C its body alone$R"
    "  ${A}▸$R$C closed, the count after its name what is under it   ${A}▾$R$C open   $C▸ dim: open above already, or all viewed$R"
    "  ${A}⇢$R$C a call new to this change   $G✓$R$C viewed   ${C}3/5$R$C of what is under it   ${X}✗$R$C a caller the change breaks$R"
    "  ${G}●$R$C in a review, the agent's review opened it in the file   ${EL}◐$R$C searched for it   neither: read in the diff alone$R")
  [[ -s $st/legend ]] && P+=("" "  ${B}${T}in full$R" "" "${(@f)$(<$st/legend)}")
  # Each line in the pane's width, not cut at its edge: broken at spaces,
  # colors kept, what runs on under the line's own text (a key's, under its
  # words; the rest, two in from where it starts).
  local -a out words
  local l cur wd
  integer w=$(( pw - 2 )) n ind wl lead first
  for l in "${P[@]}"; do
    vw "$l"; (( REPLY <= w )) && { out+=("$l"); continue; }
    plain "$l"
    if [[ $REPLY == (#b)([[:space:]]#[^[:space:]]##[[:space:]][[:space:]]##)[^[:space:]]* ]]; then ind=${#match[1]}; else ind=$(( ${#${REPLY%%[^ ]*}} + 2 )); fi
    lead=${#${REPLY%%[^[:space:]]*}}
    cur=${(l:lead:: :)} n=$lead first=1 words=("${(@s: :)${l#${(l:lead:: :)}}}")
    for wd in "${words[@]}"; do
      vw "$wd"; wl=$REPLY
      if (( ! first && n + 1 + wl > w )); then out+=("$cur$R"); cur=${(l:ind:: :)}$wd; n=$(( ind + wl ))
      else (( first )) || { cur+=" "; (( n++ )); }; cur+=$wd; (( n += wl )); fi
      first=0
    done
    out+=("$cur")
  done
  P=("${out[@]}")
}
draw() {
  local t0=$EPOCHREALTIME
  local y i f s lo=0 hi=0 body foot rows lrows
  (( dirty )) && list
  settle_cur
  # The panel, over the list's lower part, the rows above it, the diff
  # left in full.
  chh=0
  if (( chat )); then
    (( chh = lh * 55 / 100, chh < 9 ? (chh = 9) : 0, chh > lh - 3 ? (chh = lh - 3) : 0 ))
    (( lw != ccw )) && chat_load
    chat_frame
  fi
  # The cursor's row in view, the headline kept when it fits.
  (( rows = lh, lrows = lh - chh ))
  for (( y = 1; y <= $#LI; y++ )); do (( LI[y] == cur && cur )) && { lo=$y; hi=$y; break; }; done
  (( hi > top + lrows )) && (( top = hi - lrows ))
  (( lo > 0 && lo <= top )) && (( top = lo - 1 ))
  (( lo > 0 && hi <= lrows )) && top=0
  # The pane: the preview, or ? its keys.
  local head=
  if (( help )); then helplines; pfile=; PH=() HB=() phd=2; head="  ${B}${T}keys, and what the glyphs say$R"
  elif (( cur )) && [[ -n $preview$stepscmd$panescmd ]] && (( xon )); then
    # A transition's frame (xframe), under the row's own head line, which
    # crossfades from the old one.
    xframe
    if [[ $rid[cur] != $crumbfor ]]; then crumb; crumbline=$REPLY crumbfor=$rid[cur]; fi
    # On the whole transition's clock (xh), as the head's words are.
    local xe=$xh
    xswap "$xcr0" "$crumbline"; head=$REPLY
  elif (( cur )) && [[ -n $preview$stepscmd$panescmd ]]; then
    # The preview read and split once when it lands, not every frame: a
    # frame of a scroll is then the lines it shows and nothing else.
    shown; lastpv=$REPLY
    if [[ $REPLY != $pfile || -z $pfile ]]; then
      pfile=$REPLY
      if [[ -n $REPLY ]]; then P=("${(@f)$(<$REPLY)}"); else P=("${F}…$R"); fi
      # A preview's first lines can be pinned (a walk's step: "\036pin N"
      # and N lines): held under where the row is while the rest scrolls,
      # the pane's head that much taller. All but six rows of the pane at
      # most, so there is always some code to scroll; what does not fit
      # scrolls.
      PH=() HB=() hoff=0 phd=2
      integer pover=0
      integer pat=0
      if [[ $P[1] == (#b)$'\036'pin\ (<->)(\ at\ (<->))# ]]; then
        integer np=$match[1]
        pat=${match[3]:-0}
        headroom; hroom=$REPLY
        HB=("${(@)P[2,np+1]}")
        headview $hroom "${(@)HB}"
        PH=("${(@)reply}") P=("${(@)P[np+2,-1]}") phd=$(( 2 + $#reply ))
        # A preview that says which row of its code is its line opens with
        # that line a third of the way down, the code around it in sight.
        if (( pat && ! ${+offs[$rid[cur]]} )); then
          (( poff = pat + pover - 1 - (ph - phd) / 3, poff < 0 ? (poff = 0) : 0 ))
          offs[$rid[cur]]=$poff
        fi
      fi
      # A preview can say where it opens (off.<row>: a walk's step), which a
      # row not scrolled yet takes.
      if [[ -n $REPLY ]] && (( ! ${+offs[$rid[cur]]} && poff == 0 )); then
        key "$rid[cur]"
        [[ -r $st/off.$REPLY ]] && { poff=$(( $(<$st/off.$REPLY) - 1 + pover )); (( poff < 0 )) && poff=0; offs[$rid[cur]]=$poff; }
      fi
    fi
    # The preview a key asked for has landed: its scroll with it.
    (( pwant >= 0 )) && [[ -n $pfile && -z $sbase$pdir ]] && (( ${pfile##*.} >= pgen )) && { poff=$pwant; pwant=-1; }
    if [[ $rid[cur] != $crumbfor ]]; then crumb; crumbline=$REPLY crumbfor=$rid[cur]; fi
    head=$crumbline
  else P=() pfile= PH=() HB=() phd=2
  fi
  plen=$#P
  local -a fr pr
  litrow
  for (( y = 1; y <= rows; y++ )); do
    i=$(( y + top ))
    s=
    if (( y > lrows )); then s="  ${CF[y - lrows]}"
    elif (( i <= $#L )); then
      if (( LI[i] )); then
        f=$LI[i]
        if (( ${LITI[(Ie)$i]} )); then litline $f $LITA[${LITI[(Ie)$i]}]; s=$REPLY
        else s="  "$RL[f]; fi
      else s=$L[i]$R; fi
    fi
    # Beside the pane, the list's side cleared first (ECH, which leaves the
    # pane be), then the rule between them.
    (( side )) && s=$e"[${lw}X"$s$e"[$(( lw + 1 ))G"$R"  "$F"│"$R
    fr+=("$s")
  done
  if (( ! side )); then
    fr+=("$F${(l:W::─:)}$R")
  fi
  for (( y = 1; y <= ph; y++ )); do
    if (( y == 1 )); then pr+=("$head")
    elif (( y < phd + 1 )); then pr+=("${PH[y-2]}")
    else
      f=$(( y - phd + poff )) s=
      if (( f <= $#P )); then
        if (( sel && f >= s1 && f <= s2 )); then selected $f; s=$REPLY; else s=$P[f]; fi
      fi
      pr+=("$s")
    fi
  done
  # The footer: a note a key left, or what enter does and the keys to reach
  # for first, as many as fit.
  fr+=("$F${(l:W::─:)}$R")
  foot="  "
  if [[ -s $st/note ]]; then foot+=$A$(<$st/note)$R; rm -f $st/note
  elif [[ -n $flash ]]; then
    foot+=$A$flash$R; flash=
    (( sel == 1 )) && [[ -n $selr && -n $GMR_IID ]] && foot+=$C"   ·   "$R$A"c"$R$C" comments on them"$R
  elif (( sel == 1 )) && [[ -n $selr && -n $GMR_IID ]]; then
    local sd=${selr%% *} sw=${selr#* }
    if [[ $sd == *,* ]]; then sw="lines ${${sd%,*}/old/-}${${sd%,*}/new/+}${sw% *}–${${sd#*,}/old/-}${${sd#*,}/new/+}${sw#* }"
    elif [[ ${sw% *} == ${sw#* } ]]; then sw="line ${sw% *}"; else sw="lines ${sw/ /–}"; fi
    [[ $sd == old ]] && sw+=" (removed)"
    foot+=$B$A"c"$R$B$T" comment on $sw"$UB$R$C"   ·   esc lets go"$R
  elif (( searching )); then foot+=$A"/"$R$T" type to search the rows · enter or esc to stop · esc again clears it"$R
  elif (( cfocus )); then
    chat_busy && foot+=$B$A"ctrl-c"$R$B$T" stops it"$UB$R$C"   ·   "$R
    foot+=$A"⏎"$R$C" asks  "$A"tab"$R$C" an idea  "$A"↑↓"$R$C" scroll  "$A"ctrl-f"$R$C" in Claude Code  "$A"/new"$R$C" starts over  "$A"esc"$R$C" back to the rows  "$R$A"ctrl-a"$R$C" hides it"$R
    cut "$foot" $(( W - 1 )); foot=$REPLY
  else
    local n k v used_=2 room
    (( room = W - 14 ))
    (( chat )) && { foot+=$A"a"$R$C" asks Claude  "$A"ctrl-a"$R$C" hides it   ·   "$R; (( used_ += 34 )); }
    symkeys
    for (( n = 1; n <= $#hk; n++ )); do
      [[ $hk[n] == enter ]] || continue
      v=$hv[n]; (( ${+rkl[enter]} )) && v=$rkl[enter]
      [[ -n $v ]] && { foot+=$B$A"⏎ "$v$UB$R$C"   ·   "$R; (( used_ += ${(m)#v} + 8 )); }
    done
    for (( n = 1; n <= $#hk; n++ )); do
      [[ $hk[n] == enter ]] && continue
      (( hm[n] )) && ! (( ${+rkl[$hk[n]]} )) && continue
      v=$hv[n]; (( ${+rkl[$hk[n]]} )) && v=$rkl[$hk[n]]
      [[ -n $v ]] || continue
      k="$hk[n] $v"
      (( used_ + ${(m)#k} + 2 > room )) && break
      foot+=$A$hk[n]$R$C" $v  "$R; (( used_ += ${(m)#k} + 2 ))
    done
    foot+=$A"?"$R$C" keys"$R
  fi
  fr+=("$foot")
  # Only the rows that changed go out, the list's and the pane's apart, so
  # a move sends the two rows it lit and unlit and the pane.
  body=
  (( $#shown_rows )) || { body+=$e'[2J'; shown_pane=(); }
  local srow
  for (( y = 1; y <= $#fr; y++ )); do
    [[ $fr[y] == "$shown_rows[y]" ]] && continue
    (( y <= rows )) && srow=$y || { (( side )) && srow=$y || srow=$(( y <= rows + 1 ? y : y + ph )); }
    body+=$e"[$srow;1H"$fr[y]$R
    (( ! side || y > rows )) && body+=$e'[K'
  done
  for (( y = 1; y <= $#pr; y++ )); do
    [[ $pr[y] == "$shown_pane[y]" ]] && continue
    if (( side )); then body+=$e"[$(( py + y - 1 ));$(( px - 2 ))H  "$pr[y]$R$e'[K'
    else body+=$e"[$(( py + y - 1 ));1H "$pr[y]$R$e'[K'; fi
  done
  shown_rows=("${fr[@]}") shown_pane=("${pr[@]}")
  local t1=$EPOCHREALTIME
  # A transition's frames, and the one it lands on, as synchronized output (mode
  # 2026): each changes every row of the pane, and a terminal (or a
  # multiplexer between) that drew one half written showed the new rows over
  # the old. Only those: under herdr it held every frame back a moment,
  # which on a key was lag (otis-dash says), and a transition can spare it.
  (( syncing )) && body=$e'[?2026h'$body$e'[?2026l'
  (( xon )) || syncing=0
  print -rnu $tty -- $body
  print -r -- "$EPOCHREALTIME frame cur=$cur build=$(( int((t1 - t0) * 1000) )) write=$(( int((EPOCHREALTIME - t1) * 1000) )) bytes=${#body} key=${kt:+$(( int((EPOCHREALTIME - kt) * 1000) ))} keys=$nk" >> $trace
  kt= nk=0
}

# --- what the keys do ----------------------------------------------------------------
# The list, reloaded in the background: the newest asked for wins, and the
# keys keep working on the rows there are meanwhile. lastlist is the last
# one asked for, the list a resize and a landing reload with.
typeset -a rpid
integer rgen=0 rgot=0
lastlist= fulllist=
reload() {
  local cmd=$1
  lastlist=$cmd
  (( rgen++ ))
  { zsh -fc "$cmd" > $st/list.$rgen.tmp 2>/dev/null </dev/null; mv -f $st/list.$rgen.tmp $st/list.$rgen } &!
  rpid+=($!)
}
landed() {
  local p f
  integer n newest=0
  for p in $rpid; do kill -0 $p 2>/dev/null || rpid=(${rpid:#$p}); done
  local -a got=($st/list.<->(N))
  for f in $got; do n=${f##*.}; (( n > newest )) && newest=n; done
  (( newest > rgot )) || return 1
  rgot=$newest
  for f in $got; do (( ${f##*.} < newest )) && rm -f $f; done
  local was=$rid[cur] old=${(j:\n:)raw} i
  load $st/list.$newest
  rm -f $st/list.$newest
  # The cursor stays on the row it was on, by its id (fzf's --track).
  cur=0
  if [[ -n $was ]]; then for (( i = 1; i <= $#rid; i++ )); do [[ $rid[i] == $was ]] && { cur=$i; break; }; done; fi
  (( cur )) || cur=$pcur
  (( cur > $#raw )) && cur=$#raw
  list; settle_cur
  # Rows reloaded after it opened (b, the other side): the steps with them.
  [[ -n $stepscmd ]] && (( opened )) && steps_load
  [[ -n $panescmd ]] && (( opened )) && panes_load
  # Still on the row it was on: its scroll as you left it a moment ago, not
  # as it was when you came onto it (offs is kept when you leave a row), or
  # every landing in the background sent the preview back to the top.
  if (( cur )) && [[ $rid[cur] == $was ]]; then offs[$was]=$poff
  elif (( cur )); then poff=${offs[$rid[cur]]:-0}; fi
  # The previews again once the rows are not the rows they were drawn for.
  [[ ${(j:\n:)raw} != $old ]] && { (( gen++ )); warm; }
  return 0
}
integer pcur=1
# Before a command runs: the scroll of the row it is about where git-symbols
# reads it (off.<row>, git-fzf-scroll's). After: read back, since --peeks and
# --uses move it.
offout() {
  (( cur )) || return
  key "$rid[cur]"
  if (( poff > 0 )); then print -r -- $(( poff + 1 )) > $st/off.$REPLY; else rm -f $st/off.$REPLY; fi
}
offin() {
  (( cur )) || return
  key "$rid[cur]"
  local o=1
  [[ -r $st/off.$REPLY ]] && o=$(<$st/off.$REPLY)
  (( poff = o - 1, poff < 0 ? (poff = 0) : 0 ))
  offs[$rid[cur]]=$poff
}
# run <actions> <row>: fzf's actions, as a binding or a transform gives them.
run() {
  local s=$1 name arg i c q depth open close out
  integer row=$2
  while [[ -n $s ]]; do
    if [[ $s == (#b)([a-z-]##)([\(\[])* ]]; then
      name=$match[1] open=$match[2] s=${s#$name$open} depth=1 q=0
      [[ $open == '(' ]] && close=')' || close=']'
      for (( i = 1; i <= $#s; i++ )); do
        c=$s[i]
        if (( q )); then [[ $c == "'" ]] && q=0; continue; fi
        if [[ $c == "'" ]]; then q=1
        elif [[ $c == $open ]]; then (( depth++ ))
        elif [[ $c == $close ]]; then (( --depth == 0 )) && break; fi
      done
      arg=${s[1,i-1]} s=${s[i+1,-1]}
    elif [[ $s == (#b)([a-z-]##):(*) ]]; then name=$match[1] arg=$match[2] s=
    else name=${s%%+*} arg= s=${s#$name}; fi
    s=${s#+}
    subst "$arg" $row; arg=$REPLY
    case $name in
      execute)
        offout; run_tty "$arg"; offin; resize ;;
      execute-silent)
        offout; zsh -fc "$arg" </dev/null >/dev/null 2>&1; offin ;;
      transform)
        offout; out=$(zsh -fc "$arg" </dev/null 2>/dev/null); offin
        [[ -n $out ]] && run "$out" $row ;;
      reload) pcur=$cur; reload "$arg" ;;
      # Landed before the next action runs, for one that moves on the rows.
      reload-sync) pcur=$cur; lastlist=$arg; zsh -fc "$arg" > $st/list.$(( ++rgen )) 2>/dev/null </dev/null; landed ;;
      refresh-preview) (( gen++ )) ;;
      pos) (( arg > 0 && arg <= $#raw )) && go $arg ;;
      first|top) (( $#vis )) && go $vis[1] ;;
      last) (( $#vis )) && go $vis[-1] ;;
      abort) quit 130 ;;
      accept) (( cur )) && outq+=("$raw[cur]"); quit 0 ;;
      print) outq+=("$arg") ;;
      # The footer, the prompt, binding and unbinding: this screen's own.
    esac
  done
}
# act <key>: its binding, for the row under the cursor. The footer says it
# is on it first, since some (p's peeks, i) take a moment. A binding that
# redraws the preview and moves its scroll (p keeps the line at the top
# where it is, with notes above it now) holds the scroll it had until the
# new preview lands, then takes both in one frame, rather than the old
# preview jumping to the new place and then changing under it.
integer pwant=-1 pgen=0
typeset -A held
act() {
  local was=$poff g=$gen
  flash="…"; draw
  run "$bind[$1]" $cur
  if (( gen != g && poff != was )); then pwant=$poff pgen=$gen poff=$was; fi
  dirty=1
}
# --- the mouse -------------------------------------------------------------------
# The selection is share/screen.zsh's (sel, s1..s2 over P, the pane's lines).
# selrange: the file lines the selection covers, as "side first last" for
# git-mr-say, in selr. Its ends are the first and the last line of the
# diff in it, each on its own side: a line the change kept or added by its
# new number, one it removed by its old, and "old,new" when the two ends
# differ, as GitLab numbers a range that starts on a removed line. Nothing
# in i's view, whose diffs are other symbols', some in other files.
selr=
selrange() {
  local n t g o nw one fs ls fl ll
  selr=
  [[ -r $st/uses-for && $(<$st/uses-for) == $rid[cur] ]] && return
  for (( n = s1; n <= s2; n++ )); do
    plain "$P[n]"; t=$REPLY; g=${t%%│*}
    [[ $t == *│* && $g == *⋮* ]] || continue
    o=${${g%%⋮*}// /} nw=${${g#*⋮}// /}
    if [[ $nw == <-> ]]; then one="new $nw"
    elif [[ $o == <-> ]]; then one="old $o"
    else continue; fi
    [[ -z $fs ]] && { fs=${one% *} fl=${one#* }; }
    ls=${one% *} ll=${one#* }
  done
  [[ -n $fs ]] || return
  if [[ $fs == $ls ]]; then selr="$fs $fl $ll"; else selr="$fs,$ls $fl $ll"; fi
}
inpane() { (( y >= py + phd && y < py + ph && (side ? x >= px : 1) )); }
mouse() {
  local r=${1#$e\[<} b up
  integer x y l c
  [[ ${r[-1]} == m ]] && up=1
  r=${r[1,-2]}; b=${r%%;*}; r=${r#*;}; x=${r%%;*}; y=${r#*;}
  (( y > H - 2 )) && return
  (( l = y - py - phd + 1 + poff, c = x - (side ? px : 2) + 1, c < 1 ? (c = 1) : 0 ))
  # The panel's: the wheel scrolls what Claude said, a click types in it.
  if (( chat && y > lh - chh && y <= lh && (side ? x < lw : 1) )); then
    if (( b == 64 )); then (( coff += 3 ))
    elif (( b == 65 )); then (( coff -= 3, coff < 0 ? (coff = 0) : 0 ))
    elif (( b == 0 && ! up )); then cfocus=1; fi
    return
  fi
  if (( b == 64 || b == 65 )); then
    # Over a pinned head taller than its room: that head.
    if (( y > py && y < py + phd && (side ? x >= px : 1) )) && headscroll $(( b == 64 ? -3 : 3 )); then :
    elif inpane || (( ! side && y >= py )); then scroll $(( b == 64 ? -3 : 3 ))
    else step $(( b == 64 ? -1 : 1 )); fi
    return
  fi
  if inpane || (( sel == 2 )); then
    if (( b == 0 && ! up )); then sel=2 sa=$l ca=$c sb=$l cb=$c
    elif (( b == 32 && sel )); then sb=$l cb=$c
    elif (( up && sel == 2 )); then
      sb=$l cb=$c sel=1
      if (( sa == sb && ca == cb )); then sel=0; else ends; shown; copy $REPLY.cont 0 && selrange; fi
    fi
    (( sel )) && ends
    return
  fi
  if (( b == 0 && ! up && y <= lh )) && (( side ? x < lw : 1 )); then
    local at=$(( y + top ))
    (( at <= $#LI && LI[at] > 0 )) && go $LI[at]
  fi
}
# ]/[: the next or the last change in the preview, a run of lines on a diff's
# background (the peeks' code background aside), put in the pane's middle.
hunk() {
  local -a runs
  integer i on=0 s want=-1 mid
  for (( i = 1; i <= $#P; i++ )); do
    if [[ $P[i] == *$e'[48;'* && ( $CODEBG == $e'[m' || $P[i] != *$CODEBG* ) ]]; then
      (( on )) || { s=$i; on=1; }
    elif (( on )); then runs+=("$s $(( i - 1 ))"); on=0; fi
  done
  (( on )) && runs+=("$s $#P")
  local r a z
  if (( $1 > 0 )); then
    for r in $runs; do a=${r% *} z=${r#* }; (( mid = (a + z) / 2 - (ph - phd) / 2, (z - a) > ph - phd ? (mid = a - 3) : 0 )); (( mid > poff )) && { want=$mid; break; }; done
  else
    for r in ${(Oa)runs}; do a=${r% *} z=${r#* }; (( mid = (a + z) / 2 - (ph - phd) / 2, (z - a) > ph - phd ? (mid = a - 3) : 0 )); (( mid < poff )) && { want=$mid; break; }; done
  fi
  (( want >= 0 )) || return
  scroll $(( want - poff ))
}

# --- Claude, beside it -------------------------------------------------------------
# a types into the panel; enter sends the question in the background
# (git-symbols-ask --send), with the row you are on then, or the lines
# selected in the preview, and the answer streams into the conversation's
# chat file, which the panel draws, over the lower part of the list. esc
# gives the keys back to the tree, the panel still up, so you move about
# between questions; a types in it again, and esc once more closes it.
# ctrl-a shows or hides it from anywhere, the conversation kept. tab puts in a question that fits the row
# (--starters), ctrl-c stops an answer, /new starts over, and ctrl-f opens
# the conversation in Claude Code, full screen, for what the panel's Claude
# cannot do: edit, or ask a permission. ctpl is the picker's a, the row's
# fields still {n}; cafter what the binding does after it (a reload), run
# when Claude has drafted a comment.
integer chat=0 cfocus=0 cat_=0 coff=0 cstn=0 chh=0 ccw=0 cwas=0 cdrafted=0
float csent=0
ctext= cdir= caskl= ctpl= cafter= csig=
typeset -a CL cst CF
[[ ${bind[a]} == (#b)execute\((git-symbols-ask [^\)]##)\)(*) ]] && ctpl=$match[1] cafter=${match[2]#+}
# askcmd <mode>: the picker's git-symbols-ask in that mode, for the row.
askcmd() { subst "${ctpl/git-symbols-ask/git-symbols-ask $1}" $cur; }
chat_open() {
  if [[ -z $cdir ]]; then askcmd --dir; cdir=$(zsh -fc "$REPLY" 2>/dev/null </dev/null); fi
  [[ -n $cdir ]] || { flash="could not work out where this change's conversation goes"; return }
  chat=1 cfocus=1 caskl=$1 cstn=0
  askcmd --starters
  cst=("${(@f)$(OTIS_ASK_LINES=$1 zsh -fc "$REPLY" 2>/dev/null </dev/null)}")
  cst=(${cst:#})
}
# chat_busy: an answer is coming (or was just asked for, and its script has
# not said so yet).
chat_busy() {
  local p
  (( EPOCHREALTIME - csent < 2 )) && return 0
  [[ -r $cdir/busy ]] || return 1
  p=$(<$cdir/busy)
  kill -0 ${p:-0} 2>/dev/null
}
# chat_where: what the next question is about, for the panel's top line.
chat_where() {
  local n
  REPLY=
  (( cur )) || return
  fields $cur
  if [[ -n $caskl ]]; then
    n=${caskl#* }
    REPLY=${fld[2]:t}:${n% *}
    [[ ${n% *} != ${n#* } ]] && REPLY+=-${n#* }
    return
  fi
  case $typ[cur] in
    sym|caller) n=${rid[cur]##*>}; n=${n#*\#}; n=${n#type }; REPLY=${n//+/.} ;;
    file) REPLY=$fld[2] ;;
  esac
}
chat_send() {
  local q=${${ctext##[[:space:]]#}%%[[:space:]]#}
  [[ -n $q ]] || return
  if [[ $q == /(new|clear) ]]; then
    chat_busy && { flash="Claude is still answering: ctrl-c stops it first"; return }
    rm -f $cdir/{session,head,chat}
    ctext= cat_=0 coff=0 csig= CL=()
    flash="a new conversation"
    return
  fi
  chat_busy && { flash="Claude is still answering: ctrl-c stops it"; return }
  askcmd --send
  OTIS_ASK_QUESTION=$q OTIS_ASK_LINES=$caskl zsh -fc "$REPLY" </dev/null >/dev/null 2>&1 &!
  csent=$EPOCHREALTIME ctext= cat_=0 coff=0 caskl= cstn=0 cwas=1
}
chat_stop() {
  local p
  [[ -r $cdir/busy ]] && p=$(<$cdir/busy)
  [[ -n $p ]] && kill $p 2>/dev/null
  csent=0
}
chat_full() {
  chat_busy && { flash="Claude is still answering: wait, or ctrl-c stops it"; return }
  run "execute($ctpl)${cafter:++$cafter}" $cur
  csig=
}
chat_key() {
  local k=$1 n h
  keyname "$k"; n=$REPLY
  case $k in
    $'\t') n=tab ;; $e'[C'|$e'OC') n=right ;; $e'[D'|$e'OD') n=left ;;
    $e'[H'|$e'[1~') n=home ;; $e'[F'|$e'[4~') n=end ;;
    $'\x17') n=ctrl-w ;; $'\x06') n=ctrl-f ;; $'\x01') n=ctrl-a ;;
  esac
  case $n in
    enter) chat_send ;;
    esc) cfocus=0 ;;
    ctrl-a) chat=0 cfocus=0 ;;
    ctrl-c) if chat_busy; then chat_stop; else cfocus=0; fi ;;
    ctrl-f) chat_full ;;
    tab)
      # The next idea, while what is typed is none of your own.
      (( $#cst )) && [[ -z $ctext || $ctext == $cst[cstn] ]] && { (( cstn = cstn % $#cst + 1 )); ctext=$cst[cstn] cat_=$#cst[cstn]; } ;;
    up) (( coff += 3 )) ;;
    down) (( coff -= 3, coff < 0 ? (coff = 0) : 0 )) ;;
    page-up) (( coff += chh / 2 )) ;;
    page-down) (( coff -= chh / 2, coff < 0 ? (coff = 0) : 0 )) ;;
    left) (( cat_ > 0 )) && (( cat_-- )) ;;
    right) (( cat_ < $#ctext )) && (( cat_++ )) ;;
    home) cat_=0 ;;
    end|ctrl-e) cat_=$#ctext ;;
    bspace) (( cat_ > 0 )) && { ctext=${ctext[1,cat_-1]}${ctext[cat_+1,-1]}; (( cat_-- )); } ;;
    ctrl-u) ctext=${ctext[cat_+1,-1]} cat_=0 ;;
    ctrl-w)
      h=${ctext[1,cat_]}; h=${h%%[[:space:]]#}; h=${h%%[^[:space:]]#}
      ctext=$h${ctext[cat_+1,-1]} cat_=$#h ;;
    *) [[ $k == [[:print:]]* && $k != $e* ]] && { ctext=${ctext[1,cat_]}$k${ctext[cat_+1,-1]}; (( cat_ += $#k )); } ;;
  esac
}
# inline <line>: a line of Claude's markdown as the panel shows it, **bold**
# and `code` lit; a pair the wrap broke in two loses its marks.
inline() {
  local s=$1
  [[ $s == *'**'* ]] && { s=${(S)s//(#b)\*\*(*)\*\*/$B$match[1]$UB}; s=${s//\*\*/}; }
  [[ $s == *'`'* ]] && s=${(S)s//(#b)\`([^\`]##)\`/$A$match[1]$T}
  REPLY=$s
}
# chat_load: the chat file (git-symbols-ask's: Claude's words, and lines of
# its own after \001 and a letter) as the panel's lines, wrapped to it, in CL.
chat_load() {
  local l t pre ind lk= f=$cdir/chat
  integer w=$(( lw - 5 )) code=0
  CL=() cdrafted=0 ccw=$lw
  [[ -s $f ]] || return
  local -a src=("${(@f)$(<$f)}")
  (( $#src > 800 )) && src=($src[-800,-1])
  for l in "${src[@]}"; do
    case $l in
      $'\x01U '*)
        code=0 cdrafted=0 pre="$A› $R" lk=U
        [[ -n $CL[-1] ]] && CL+=("")
        wrap "${l:3}" $(( w - 2 ))
        for t in $reply; do CL+=("$pre$B$T$t$R"); pre="  "; done ;;
      $'\x01O '*) fit "${l:3}" $(( w - 2 )); CL+=("  $F$REPLY$R" ""); lk=O ;;
      $'\x01T '*)
        [[ $l == *'drafting a comment' ]] && cdrafted=1
        # A note says what Claude does next, so it sits on what came before.
        [[ $lk != O && -z $CL[-1] ]] && (( $#CL )) && CL[-1]=()
        lk=T
        fit "${l:3}" $(( w - 2 )); CL+=("$F· $REPLY$R") ;;
      $'\x01E '*) wrap "${l:3}" $w; for t in $reply; do CL+=("$X$t$R"); done ;;
      $'\x01S '*) CL+=("$F${l:3}$R") ;;
      '```'*) code=$(( !code )) ;;
      *)
        if (( code )); then fit "$l" $(( w - 2 )); CL+=("  $C$REPLY$R"); continue; fi
        if [[ -z ${l//[[:space:]]/} ]]; then [[ -n $CL[-1] ]] && CL+=(""); continue; fi
        pre= ind= lk=x
        if [[ $l == (#b)([[:space:]]#)([-*]|[0-9]##.)[[:space:]]##(*) ]]; then
          pre="$match[1]$match[2] " l=$match[3]; ind=${(l:${#pre}:: :)}
          pre=${pre/[-*] /• }
        elif [[ $l == (#b)\#\##[[:space:]]##(*) ]]; then l="**$match[1]**"; fi
        wrap "$l" $(( w - ${#pre} ))
        for t in $reply; do inline "$t"; CL+=("$T$pre$REPLY$R"); pre=$ind; done ;;
    esac
  done
  while (( $#CL )) && [[ -z $CL[1] ]]; do shift CL; done
}
# chat_tick: the chat file grew, or the answer ended; true when the panel
# wants drawing again. Once an answer that drafted a comment ends, the
# picker's reload after a runs, so the draft shows on its row.
chat_tick() {
  local sig= r=1
  local -a cs
  zstat -A cs +size -- $cdir/chat 2>/dev/null && sig=$cs[1]
  zstat -A cs +mtime -- $cdir/chat 2>/dev/null && sig+=.$cs[1]
  [[ $sig != $csig ]] && { csig=$sig; chat_load; r=0; }
  if (( cwas )) && ! chat_busy; then
    cwas=0 r=0
    (( cdrafted )) && [[ -n $cafter ]] && run "$cafter" $cur
  fi
  return $r
}
# chat_frame: the panel's chh lines, in CF: its top line (whether Claude is
# answering, and what a question now would be about), what was said, the
# newest at the bottom unless scrolled, and the line you type on.
chat_frame() {
  local s where before ch after
  integer rows=$(( chh - 2 )) last first room from max
  CF=()
  chat_where; where=$REPLY
  line= used=0
  put "$F" "── "; put "$B$A" "Claude"; line+=$UB
  if chat_busy; then put "$A" "  ✦ answering"; (( csent > 0 )) && put "$C" " $(( int(EPOCHREALTIME - csent) ))s"; fi
  [[ -n $where ]] && { put "$C" "  · asking about "; put "$T" "$where"; }
  put "" " "
  cut "$line" $(( lw - 4 )); line=$REPLY; vw "$line"
  CF+=("$line$F${(l:lw - 2 - REPLY::─:)}$R")
  if (( ! $#CL )) && (( cfocus )); then
    CF+=("" "${C}Each question goes with the row you are on when you send it.$R" "" "${C}tab puts in one of these:$R")
    for s in $cst; do fit "$s" $(( lw - 6 )); CF+=("  $T$REPLY$R"); done
    [[ -s $cdir/session ]] && CF+=("" "${F}the conversation so far is in Claude Code: ctrl-f$R")
  else
    (( max = $#CL - rows, max < 0 ? (max = 0) : 0, coff > max ? (coff = max) : 0 ))
    (( last = $#CL - coff, first = last - rows + 1, first < 1 ? (first = 1) : 0 ))
    (( $#CL )) && CF+=("${(@)CL[first,last]}")
  fi
  while (( $#CF < chh - 1 )); do CF+=(""); done
  CF=("${(@)CF[1,chh-1]}")
  # The line you type on: the cursor a lit cell, the text scrolled to keep it in sight.
  if (( cfocus )); then
    (( room = lw - 6, from = 1 ))
    while (( ${(m)#${ctext[from,cat_]}} > room - 1 )); do (( from++ )); done
    before=${ctext[from,cat_]} ch=${ctext[cat_+1]:- } after=${ctext[cat_+2,-1]}
    fit "$after" $(( room - ${(m)#before} - 1 )); after=$REPLY
    s="$A› $R$T$before${e}[7m$ch${e}[27m$after$R"
    [[ -z $ctext ]] && s+=$F" ask Claude"${cst:+ · tab for ideas}$R
  else
    s="$F› a to ask$R"
  fi
  CF+=("$s")
}

# handle <key>: one key. The picker's bindings come first, then this
# screen's own, as git-fzf's came under a caller's.
# used <key>: a line in the key log (keys_used), with what this picker says
# the key is for.
used() { keys_used $1 "${hv[${hk[(ie)$1]}]}"; }
handle() {
  # Any key or the mouse lands a transition at once, and goes on from there.
  xstop
  [[ $1 == $e'[<'* ]] && { mouse "$1"; return; }
  (( cfocus )) && { chat_key "$1"; return; }
  local k=$1
  keyname "$k"; local n=$REPLY
  if (( searching )); then
    case $n in
      enter) searching=0 dirty=1; [[ -n $bind[enter] ]] && act enter; return ;;
      esc) searching=0 dirty=1; return ;;
      bspace) query=${query[1,-2]} dirty=1; return ;;
      up|ctrl-k|ctrl-p) step -1; return ;;
      down|ctrl-j|ctrl-n) step 1; return ;;
      ctrl-u) query= dirty=1; return ;;
    esac
    [[ $k == [[:print:]]* && $k != $e* ]] && { query+=$k dirty=1; }
    return
  fi
  # Lines selected in a diff: a asks Claude about them, c comments on them
  # in a review, esc lets go.
  if (( sel == 1 )) && [[ -n $selr ]]; then
    case $n in
      a) if [[ -n $ctpl ]]; then
           used a
           local l=$selr
           sel=0 selr=
           chat_open "$l"
           return
         fi ;;
      c) if [[ -n $GMR_IID ]]; then
           used c
           local side first last; read -r side first last <<< $selr
           sel=0 selr=
           run "execute(git-mr-say --new $GMR_IID $GMR_RANGE {2} $side $first $last)+execute-silent(git-mr-file-preview --refresh $GMR_IID $GMR_RANGE)+reload($fulllist)+refresh-preview" $cur
           dirty=1; return
         fi ;;
      esc) sel=0 selr=; return ;;
    esac
  fi
  sel=0 selr=
  [[ $n == a && -n $ctpl ]] && { used a; chat_open ""; return; }
  # ctrl-a shows or hides it, the conversation kept either way.
  [[ $k == $'\x01' && -n $ctpl ]] && { used ctrl-a; if (( chat )); then chat=0 cfocus=0; else chat_open ""; fi; return; }
  [[ $n == esc ]] && (( chat )) && { chat=0; return; }
  # A walk's steps are this screen's own (steps_key).
  if [[ -n $sbase && $n == [jlhk] ]]; then used $n; steps_key $n; return; fi
  # Drawn-ahead panes: a move to another row is a transition (panes_go).
  if [[ -n $pdir && $n == (j|k|down|up) && -z $bind[$n] ]]; then
    integer was=$cur dir=1
    [[ $n == (k|up) ]] && dir=-1
    xshown
    step $dir
    (( cur != was )) && panes_go $was $dir
    return
  fi
  # A picker's key held down is one press: its repeats, arriving while it
  # runs or within 0.3s of the last of them, are dropped. p held ran the
  # peeks and a preview for every repeat, and the renders piled up. Keys the
  # picker says are cheap (--repeat) act on every repeat.
  if [[ -n $bind[$n] ]]; then
    if [[ -z $repeat[$n] ]] && (( EPOCHREALTIME - ${held[$n]:-0} < 0.3 )); then held[$n]=$EPOCHREALTIME; return; fi
    used $n
    act $n; held[$n]=$EPOCHREALTIME
    return
  fi
  [[ $n == (/|\?|\]|\[|.|,) ]] && used $n
  case $n in
    j|down) step 1 ;;
    k|up) step -1 ;;
    g) (( $#vis )) && go $vis[1] ;;
    G) (( $#vis )) && go $vis[-1] ;;
    q) quit 130 ;;
    esc) if [[ -n $query ]]; then query= dirty=1; else quit 130; fi ;;
    /) searching=1 dirty=1 ;;
    '?') help=$(( !help )) poff=0 ;;
    J) headscroll 3 ;;
    K) headscroll -3 ;;
    ctrl-d) scroll $(( (ph - phd) / 2 )) ;;
    ctrl-u) scroll $(( - (ph - phd) / 2 )) ;;
    ctrl-e) scroll 1 ;;
    ctrl-y) scroll -1 ;;
    ']') hunk 1 ;;
    '[') hunk -1 ;;
    '.') unviewed 1 ;;
    ',') unviewed -1 ;;
    ctrl-c) quit 130 ;;
  esac
}

# --- landings --------------------------------------------------------------------
# What background work leaves in the cache: Claude's gloss and walk, where the
# changed code broke before, tsgo's callers, Claude's fixes for them, the checkout's rechecked callers, and a review's
# threads. A change in any reloads the rows, and the previews with them.
wsig=
watched() {
  local croot sig= f
  local -a tm
  local -a watch=($watchfiles)
  if [[ -s $st/cache-root ]]; then
    croot=$(<$st/cache-root)
    watch+=($croot/{symbols-gloss,symbols-walk,symbols-past,callers,callers-fix}(N/) $st/fixed(N))
  fi
  (( $#watch )) || return 1
  [[ -n $GMR_IID ]] && watch+=($croot/mr-$GMR_IID-{threads,drafts}.json(N))
  for f in $watch; do
    zstat -A tm +mtime -- $f 2>/dev/null && sig+=$f$tm[1]
  done
  [[ $sig == $wsig ]] && return 1
  local was=$wsig; wsig=$sig
  [[ -n $was ]]
}

# --- the loop ----------------------------------------------------------------------
screen_on
pbask
size
layout
draw
# The list's first rows, from the start binding (its reload is the list the
# landings reload with).
if [[ $startacts == (#b)(|*+)reload(|-sync)\((*) ]]; then
  fulllist=$match[3]; [[ $fulllist == *\)+* ]] && fulllist=${fulllist%%\)+*} || fulllist=${fulllist%\)}
fi
integer opened=0
run "$startacts" 0
opened=1
# A walk's steps come up now, drawn, from the step the start put it on:
# nothing lands later to draw them.
[[ -n $stepscmd ]] && steps_load && draw
[[ -n $panescmd ]] && panes_load && draw
integer tmo=5 stick=0 wtick=0 rewidth=0
while :; do
  reply=()
  # A transition draws a frame every 20ms (zselect counts hundredths): at
  # 10ms a frame of the whole pane, under a multiplexer, came out in bursts.
  zselect -t $(( xon || lon ? 2 : tmo )) -r $tty ${winch:+-r} $winch
  if [[ -n $winch ]] && (( ${reply[(I)$winch]} )); then
    sysread -s 64 -i $winch _
    resize
  fi
  if (( ${reply[(I)$tty]} )); then
    kt=$EPOCHREALTIME nk=1
    readkey; handle $REPLY
    while zselect -t 0 -r $tty; do readkey; handle $REPLY; (( nk++ )); done
    draw
  else
    float ti=$EPOCHREALTIME
    changed=0
    (( xon )) && xtick && changed=1
    (( lon )) && changed=1
    # Once a second: whatever opened this is still there (else it goes,
    # rather than read keys under a shell's prompt), and, without perl, the size.
    if (( EPOCHSECONDS != stick )); then
      stick=$EPOCHSECONDS
      orphaned && quit 1
      [[ -z $winch ]] && resize
      # The panel's clock, while Claude answers.
      (( chat )) && chat_busy && changed=1
      # The walk's bar, while Claude walks (git-symbols-walk --show).
      [[ -e $st/walk.pending && -e $st/walk ]] && { (( gen++ )); changed=1; }
    fi
    (( chat )) && chat_tick && changed=1
    # The list landing is the drawn panes being there too: the screen
    # opened without them rather than wait (panes_load, before the loop).
    landed && { changed=1; [[ -n $panescmd && -z $pdir ]] && panes_load; }
    # The row's preview landing: one test for the file this gen and width
    # draw, and none once it shows. A glob of every kept preview, twenty
    # times a second, was the loop's whole cost at rest.
    if (( cur && ! help )) && [[ -n $preview && -z $stepscmd$panescmd ]]; then
      pvname "$rid[cur]" $pw
      [[ $lastpv != $REPLY.$gen && -e $REPLY.$gen ]] && changed=1
    fi
    # The size has held: the rows cut to it, and the previews drawn at it.
    if (( settle && EPOCHREALTIME >= settle )); then
      settle=0
      (( rewidth )) && [[ -n $lastlist ]] && { rewidth=0; reload "$lastlist"; }
      (( gen++ )); warm
      [[ -n $stepscmd ]] && (( pw != sw )) && steps_load
      [[ -n $panescmd && $pwdir != */$pw ]] && panes_load
    fi
    # Background work landing, looked for twice a second, and not while a
    # reload is out.
    if (( EPOCHREALTIME * 2 > wtick )) && (( ! $#rpid )); then
      (( wtick = int(EPOCHREALTIME * 2) + 1 ))
      # What landed is in the previews too, whether or not the rows change.
      watched && [[ -n $fulllist ]] && { reload "$fulllist"; (( gen++ )); changed=1; }
    fi
    (( changed )) && draw
    (( ! help && ! settle )) && want
    (( EPOCHREALTIME - ti > 0.02 )) && print -r -- "$EPOCHREALTIME upkeep $(( int((EPOCHREALTIME - ti) * 1000) ))ms changed=$changed" >> $trace
  fi
done
