#!/bin/sh
# git-deploy-preview <deployment id>: one deploy, for gd's preview: what
# happened and when, who set it off, the merge requests and commits it carried
# (yours highlighted), and for a failed one the end of the job's log. A
# rollback says which build it restored (the job's version input, as
# git-ci-merged reads it). Logs and rollback lookups are kept in the cache
# dir, since a finished job's log never changes.
share=$(cd "$(dirname "$0")/../share" && pwd)
. "$share/palette.sh"
. "$share/repo.sh" || exit 0
dir="$OTIS_GITDIR/git-alias-cache"
nl='
'

# once <file> <what it is doing> <function that writes it>: the file, fetched
# the first time it is wanted and kept for good, since a finished job's log
# and a rollback's inputs never change.
#
# The first look at one used to hold the pane empty for as long as GitLab
# took. So it says what it is fetching and fetches behind the pane instead,
# then asks fzf to draw the preview again, which is the moment there is
# something to draw. A preview does not block fzf the way a list or a key
# does, so its port is free to be told; returns 1 while there is nothing yet.
#
# A fetch that fails is not retried for a minute, so sitting on a failing row
# does not ask GitLab once a keypress.
once() {
  f=$1 doing=$2 fn=$3
  [ -s "$f" ] && return 0
  if [ -z "$FZF_PORT" ]; then
    "$fn" > "$f" 2>/dev/null || rm -f "$f"
    [ -s "$f" ]
    return
  fi
  if [ -z "$(find "$f.tried" -mmin -1 2>/dev/null)" ]; then
    : > "$f.tried"
    (
      "$fn" > "$f.new" 2>/dev/null && [ -s "$f.new" ] && mv "$f.new" "$f" || rm -f "$f.new"
      curl -s -XPOST "127.0.0.1:$FZF_PORT" -H "x-api-key: $FZF_API_KEY" -d refresh-preview >/dev/null 2>&1
    ) >/dev/null 2>&1 &
  fi
  printf "\n${GK_CONTEXT}%s\342\200\246${GK_R}\n" "$doing"
  return 1
}
cache=$dir/deploys.json
[ -s "$cache" ] || exit 0
# The deploy's header, and after it, on a line of its own, the fields the
# rest of this needs, in one jq rather than one a field. | between them,
# since read keeps an empty field between two of those and drops one
# between two tabs.
out=$(jq -r -L "$share" --arg id "$1" 'include "otis";
  .deploys[] | select((.id | tostring) == $id) |
  def took: "\(.duration / 60 | floor)m\(.duration % 60 | tostring | if length < 2 then "0" + . else . end)s";
  (if .kind == "rollback" then bad + "↺ rollback" + r
   elif .status == "success" then good + "✓ deployed" + r
   elif .status == "failed" then (if .duration == 0 then bad + "✗ failed at once" + r + context + ", refused: production was already past this commit" + r else bad + "✗ failed" + r end)
   elif .status == "running" then attention + "◐ deploying now" + r
   elif .status == "canceled" then context + "⊘ canceled" + r
   else attention + "○ waiting for the deploy lock" + r end)
  + context + " · " + (.at | when) + (if .duration > 0 then " · took " + took else "" end) + " · by " + .user + r,
  context + "pipeline " + .pipeline + " · " + .sha[0:8] + (if .prev != "" then " · since " + .prev[0:8] else "" end) + r,
  context + .url + r,
  ([.kind, .prev, .sha, .job, .status, .commits] | map(tostring) | join("|"))' "$cache")
[ -n "$out" ] || exit 0
printf '%s\n' "${out%"$nl"*}"
IFS='|' read -r kind prev sha jobid status n <<EOF
${out##*"$nl"}
EOF

rollback_inputs() {
  glab api graphql -f repo="$repo" -f id="gid://gitlab/Ci::Build/$jobid" -f query='query($repo: ID!, $id: JobID!) {
    project(fullPath: $repo) { job(id: $id) { inputs { name value } } } }' 2>/dev/null |
    jq -e '{version: (.data.project.job.inputs[] | select(.name == "version") | .value | tostring)}'
}
if [ "$kind" = rollback ]; then
  repo=$(otis-config project)
  f=$dir/rollback-$jobid.json
  if once "$f" "asking GitLab which build it restored" rollback_inputs; then
    v=$(jq -r .version "$f")
    printf "\n${GK_TEXT}restored the build of pipeline %s${GK_R}\n" "$v"
  fi
  exit 0
fi

if [ -n "$prev" ]; then
  printf "\n${GK_TEXT}carried${GK_R} ${GK_CONTEXT}%s commits since the last deploy that went live${GK_R}\n" "$n"
  # Main's own commits: a merge commit per MR, whose body GitLab writes as
  # the MR's title, a blank line, then the "See merge request" trailer; or a
  # commit pushed straight to main. One line each.
  git log --first-parent --format='%h%x09%s%x09%b%x00' "$prev..$sha" 2>/dev/null | tr '\n\0' '\001\n' | head -60 |
    awk -F'\t' -v mine="$(jq -r '[.mrs[]?.iid | tostring] | join(" ")' "$dir/ci-merged.json" 2>/dev/null)" -v Y="$GK_YOURS" -v T="$GK_TEXT" -v C="$GK_CONTEXT" -v R="$GK_R" '
      BEGIN { n = split(mine, m, " "); for (i = 1; i <= n; i++) own[m[i]] = 1 }
      { iid = ""; if (match($3, /merge request [^ ]*![0-9]+/)) { iid = substr($3, RSTART, RLENGTH); sub(/.*!/, "", iid) }
        title = $3; sub(/\001.*/, "", title); if (title == "") title = $2
        if (iid != "") printf "  %s!%-6s%s  %s%s%s\n", (iid in own ? Y : T), iid, R, T, title, R
        else printf "  %s%s%s  %s%s%s\n", C, $1, R, C, $2, R }'
else
  printf "\n${GK_CONTEXT}what it carried is not known: no earlier deploy in the list went live${GK_R}\n"
fi

job_trace() {
  glab api "projects/:fullpath/jobs/$jobid/trace" 2>/dev/null | sed 's/\x1b\[[0-9;]*[a-zA-Z]//g' | tr -d '\r'
}
if [ "$status" = failed ] || [ "$status" = canceled ]; then
  f=$dir/job-trace-$jobid.log
  if once "$f" "reading the end of its log from GitLab" job_trace; then
    printf "\n${GK_TEXT}the end of its log${GK_R}\n"
    grep -v '^\s*$' "$f" | tail -25 | sed "s/^/  $(printf "${GK_CONTEXT}")/; s/\$/$(printf "${GK_R}")/"
  fi
fi
