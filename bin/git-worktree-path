#!/bin/sh
# git-worktree-path main          the main checkout; every other worktree lives under it
# git-worktree-path of <branch>   where <branch> is checked out, if anywhere
# git-worktree-path named <name>  where the worktree called <name> goes: <otis-config worktrees>/<name>
#                                 under the main checkout (gwn, and gmr's review and mine)
# git-worktree-path roots         the main checkout, then review, then mine, a line each: the
#                                 three every worktree list and preview wants, in one run
#                                 rather than three, each of which asks git where the
#                                 worktrees are all over again
#
# The main checkout is the one whose git dir is the common dir, so under a
# picker it is a string away: git-fzf exported that dir (otis-config --env),
# and its parent is the answer whenever it is a plain <checkout>/.git. Every
# preview and list here used to start git and awk to be told the same thing.
# A common dir called anything else (a repo made with --separate-git-dir)
# still asks git. The worktrees setting comes from the same environment.
main() {
  case $OTIS_C_GITDIR in
    */.git) [ -d "$OTIS_C_GITDIR" ] && { printf '%s\n' "${OTIS_C_GITDIR%/.git}"; return; } ;;
  esac
  git worktree list --porcelain | awk '/^worktree /{ print substr($0, 10); exit }'
}
where() {
  [ -n "$OTIS_C_ROOT" ] && [ -n "$OTIS_C_worktrees" ] && { printf '%s\n' "$OTIS_C_worktrees"; return; }
  otis-config worktrees
}
case $1 in
  main)  main ;;
  of)    git worktree list --porcelain | awk -v want="branch refs/heads/$2" '/^worktree /{ p = substr($0, 10) } $0 == want { print p }' ;;
  named) printf '%s/%s/%s\n' "$(main)" "$(where)" "$2" ;;
  roots) m=$(main) w=$(where)
         printf '%s\n%s/%s/review\n%s/%s/mine\n' "$m" "$m" "$w" "$m" "$w" ;;
  *)     echo "usage: git-worktree-path main | of <branch> | named <name> | roots" >&2; exit 2 ;;
esac
