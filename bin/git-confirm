#!/bin/sh
# git-confirm <question>: ask [y/N] and take one keypress, no enter. Exit 0 only
# for y.
# git-confirm --note <question>: the same, but a is yes with a note: a line
# of your own for the agent being started, printed to stdout, so the question
# goes to the terminal instead.
# Over one of otis's screens (OTIS_FRAME), either is asked in a box on it
# instead (otis-popup).
note=
[ "$1" = --note ] && { note=1; shift; }
[ -n "$OTIS_FRAME" ] && [ -e "$OTIS_FRAME" ] && exec otis-popup "$([ -n "$note" ] && echo note || echo confirm)" "$1"
if [ -n "$note" ]; then printf '%s [y/N, a=add a note] ' "$1" >/dev/tty; else printf '%s [y/N] ' "$1"; fi
# Switch off line mode and echo for one key, then switch them back on. Under
# fzf, macOS stty can warn that "stdout appears redirected" while still
# applying the change, so its stderr is dropped.
# stty names the terminal with -f on macOS and -F on Linux.
tty_mode() { stty -f /dev/tty "$@" </dev/null 2>/dev/null || stty -F /dev/tty "$@" </dev/null 2>/dev/null; }
tty_mode -icanon -echo min 1
answer=$(dd bs=1 count=1 </dev/tty 2>/dev/null)
tty_mode icanon echo
if [ -n "$note" ]; then
  printf '%s\n' "$answer" >/dev/tty
  [ "$answer" = a ] || { [ "$answer" = y ]; exit; }
  # One line, as the terminal edits it; an empty one is a plain yes.
  printf 'note: ' >/dev/tty
  IFS= read -r line </dev/tty || exit 1
  printf '%s' "$line"
  exit 0
fi
printf '%s\n' "$answer"
[ "$answer" = y ]
