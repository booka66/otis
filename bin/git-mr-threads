#!/bin/sh
# git-mr-threads <iid> <range>                    picker of the threads no line shows
# git-mr-threads --list <iid> <range>             its rows
# git-mr-threads --drafts <iid> <range>           picker of your unpublished drafts, Claude's first
# git-mr-threads --drafts-list <iid> <range>      its rows
# git-mr-threads --show <id> [range]              one thread in full, its preview
# git-mr-threads --overview <iid>                 unresolved threads on the MR, for gmr
# git-mr-threads --open <id>                      reply in nvim, edit or delete there
# git-mr-threads --resolve <iid> <range> <id> <resolvable> <resolved>
# git-mr-threads --json <iid> <range> <reload>    every thread, placed, from the cache
# git-mr-threads --kick <iid> <range> <reload>    refetch in the background if old
# git-mr-threads --refresh <iid> <reload>         refetch the cache now
# git-mr-threads --fetch <iid> <range>            every thread, placed, fetched now
#
# An MR's comment threads with your unpublished drafts, as one list for the
# file picker's preview (git-mr-file-preview), nvim (share/mr-comments.lua) and
# this picker. Each thread gets .where, where it sits in the diff of <range>:
#   line      on a line: side (new, or old for a removed line), path, line, and
#             from, the first line of a multi-line comment
#   outdated  on a line of a file that has changed since. GitLab leaves such a
#             thread at the diff it was made on, and its line number there says
#             nothing about the file now
#   file      on a whole file
#   overview  on the MR itself
# A thread stays on its line while its side of the file is exactly the file it
# was made on (the same blob), which also holds in your own checkout with
# commits GitLab has not seen yet. Drafts of new threads are threads with
# draft: true; a draft reply is a note with draft: true at the end of its thread.
# A draft Claude wrote (git-mr-claude) has claude: true, on the thread and the
# note, Claude for its author, and why, Claude's reasons for you, which stay on
# this machine and are never part of the draft.
#
# The picker lists every thread but those on a line: the MR's overview, whole
# files, and outdated ones. c replies at a prompt (git-mr-say), e and d edit
# and delete your own there, r resolves, and enter opens the thread in nvim. They come from per-MR caches (git-cached-json)
# shared with the file picker, refetched when over 15 seconds old.
share=$(cd "$(dirname "$0")/../share" && pwd)
. "$share/palette.sh"
# Each file's mtime to the nanosecond, one a line: stat says it differently
# on Linux (-c %.9Y) and macOS (-f %Fm). Whole seconds would key a cache on
# a file that changed within the second it was read (F, then its preview).
if stat -c %Y / >/dev/null 2>&1; then mtimes() { stat -c %.9Y "$@"; }; else mtimes() { stat -f %Fm "$@"; }; fi
st=$GIT_FZF_STATE
mode=$1
[ "${mode#--}" != "$mode" ] && shift
iid=$1 range=$2
api="projects/:fullpath/merge_requests/$iid"

# Lines marked with \002 are a comment's markdown, its lines \037 apart: drawn
# in the theme's colors (share/markdown.awk), wrapped and indented.
markdown() {
  LC_ALL=C awk -v width="$(( ${FZF_PREVIEW_COLUMNS:-100} - 2 ))" "$(cat "$share/markdown.awk")"'
    /^\002/ { md(substr($0, 2), width - 2, "  "); next }
    { print }'
}
# Lines marked with \001 are comment text: wrapped to the preview and indented.
wrap() {
  awk -v width="$(( ${FZF_PREVIEW_COLUMNS:-100} - 4 ))" '
    !/^\001/ { print; next }
    {
      # Comment text is what someone typed: no control characters of its
      # own. The lines around it are ours, and their colors are escapes.
      gsub(/[\002-\010\013-\036\177]/, "")
      n = split(substr($0, 2), words, " "); out = ""
      for (i = 1; i <= n; i++) {
        if (out != "" && length(out) + 1 + length(words[i]) > width) { print "  " out; out = words[i] }
        else out = out (out == "" ? "" : " ") words[i]
      }
      print "  " out
    }'
}

# place <discussions.json> <drafts.json>: the placed list.
place() {
  head=$(git rev-parse -q --verify "${range#*..}^{commit}")
  base=$(git rev-parse -q --verify "${range%%..*}^{commit}")
  # The blob each thread's file had where it was made, and has in <range>, in one git call.
  specs=$(jq -r --arg h "$head" --arg b "$base" '.[]? | (.notes[0].position // .position) // empty
    | if .new_line then "\(.head_sha):\(.new_path)", "\($h):\(.new_path)"
      elif .old_line then "\(.base_sha):\(.old_path)", "\($b):\(.old_path)" else empty end' "$1" "$2" | sort -u)
  objects=$(printf '%s\n' "$specs" | git cat-file --batch-check='%(objectname)')
  # A missing object prints as "<spec> missing".
  blobs=$(jq -n --arg s "$specs" --arg o "$objects" \
    '[$s, $o | split("\n")] | transpose | map(select(.[1] | test(" ") | not) | {(.[0]): .[1]}) | add // {}')
  claude=$(git-mr-claude --drafts "$iid" | jq -sc .)
  jq --slurpfile drafts "$2" --argjson blobs "$blobs" --argjson claude "$claude" --argjson why "$(git-mr-claude --why "$iid")" \
    --arg h "$head" --arg b "$base" '
    def same($made; $now): $blobs[$made] as $x | $x != null and $x == $blobs[$now];
    def draft_note: {id, draft: true, claude: (.id | IN($claude[])), why: $why[.id | tostring], body: .note, created_at: "", position}
      | .author = {username: (if .claude then "Claude" else "you" end)};
    ($drafts[0] // []) as $dr |
    [ (.[] | select(.notes[0].system | not) | .id as $id
        | .notes += [$dr[] | select(.discussion_id == $id) | draft_note]),
      ($dr[] | select((.discussion_id // "") == "")
        | {id: "draft-\(.id)", draft: true, claude: (.id | IN($claude[])), resolvable: false, resolved: false, notes: [draft_note]}) ]
    | map(.notes[0].position as $p | .where =
        if $p == null or ($p.new_path // $p.old_path) == null then {state: "overview"}
        elif $p.new_line then
          {state: (if same("\($p.head_sha):\($p.new_path)"; "\($h):\($p.new_path)") then "line" else "outdated" end),
           side: "new", path: $p.new_path, line: $p.new_line, from: ($p.line_range.start.new_line // $p.new_line)}
        elif $p.old_line then
          {state: (if same("\($p.base_sha):\($p.old_path)"; "\($b):\($p.old_path)") then "line" else "outdated" end),
           side: "old", path: $p.old_path, line: $p.old_line, from: ($p.line_range.start.old_line // $p.old_line)}
        else {state: "file", path: ($p.new_path // $p.old_path)} end)' "$1"
}

case $mode in
  --json)
    reload=$3
    threads=$(git-cached-json --no-wait "mr-$iid-threads" 15 "$reload" -- \
      git-mr-pages "$api/discussions?per_page=100" 2>/dev/null) || exit 1
    # Drafts not cached yet are only missing for a moment.
    drafts=$(git-cached-json --no-wait "mr-$iid-drafts" 15 "$reload" -- \
      git-mr-pages "$api/draft_notes?per_page=100" 2>/dev/null) || drafts=/dev/null
    # Placing is a dozen processes, and the preview asks on every move, so a
    # picker keeps the placed list for as long as what it was placed from
    # (the two caches, Claude's drafts and reasons, the range) stays the same.
    # Those name the file, spelled out rather than hashed: one stat and one
    # awk, where the hash was three processes more on every move.
    if [ -n "$GIT_FZF_STATE" ] && [ -d "$GIT_FZF_STATE" ]; then
      . "$share/repo.sh"
      claude="$OTIS_GITDIR/gmr-claude"
      placed=$GIT_FZF_STATE/placed.$(mtimes "$threads" "$drafts" "$claude/$iid.drafts" "$claude/$iid.why.jsonl" 2>/dev/null |
        awk -v k="$iid|$range" '{ key = key "," $0 } END { gsub("/", "%", k); print k key }')
      if [ ! -s "$placed" ]; then place "$threads" "$drafts" > "$placed.new" && mv -f "$placed.new" "$placed"; fi
      cat "$placed"
    else
      place "$threads" "$drafts"
    fi
    ;;
  --kick)
    # The two caches asked only whether they are old, a fetch started in the
    # background if so: a preview that kept its threads (git-symbols) reads
    # neither, and would otherwise never notice a thread made elsewhere.
    git-cached-json --no-wait "mr-$iid-threads" 15 "$3" -- git-mr-pages "$api/discussions?per_page=100" >/dev/null 2>&1
    git-cached-json --no-wait "mr-$iid-drafts" 15 "$3" -- git-mr-pages "$api/draft_notes?per_page=100" >/dev/null 2>&1
    ;;
  --refresh)
    reload=$2
    git-cached-json --refresh "mr-$iid-threads" "$reload" -- git-mr-pages "$api/discussions?per_page=100" >/dev/null 2>&1
    git-cached-json --refresh "mr-$iid-drafts" "$reload" -- git-mr-pages "$api/draft_notes?per_page=100" >/dev/null 2>&1
    ;;
  --fetch)
    tmp=$(mktemp -d) || exit 1
    trap 'rm -rf "$tmp"' EXIT
    git-mr-pages "$api/discussions?per_page=100" > "$tmp/threads" &&
      git-mr-pages "$api/draft_notes?per_page=100" > "$tmp/drafts" &&
      place "$tmp/threads" "$tmp/drafts"
    ;;
  --list)
    if ! git-mr-threads --json "$iid" "$range" "reload(git-mr-threads --list $iid $range)" > "$st/threads.json"; then
      printf "${GK_CONTEXT}loading the threads ...${GK_R}\n" > "$st/footer"
      exit 0
    fi
    if [ -s "$st/footer.error" ]; then
      mv "$st/footer.error" "$st/footer"
    else
      jq -r -L "$share" 'include "otis"; map(select(.where.state != "line")) | context + "\(length) not on a line of the diff, "
        + "\(map(select(.resolvable and (.resolved | not))) | length) unresolved" + r' "$st/threads.json" > "$st/footer"
    fi
    # Unresolved first, then drafts, comments that cannot be resolved, and resolved.
    jq -r -L "$share" '
      include "otis";
      map(select(.where.state != "line"))
      | sort_by(if .draft then 1 elif .resolvable | not then 2 elif .resolved then 3 else 0 end)[]
      | .notes[0] as $n |
      [ (if .draft then yours + "✎ draft   "
         elif .resolvable | not then "          "
         elif .resolved then context + "✓ resolved"
         else elsewhere + " open    " end) + r + "  "
          + (if .where.state == "overview" then context + "overview"
             elif .where.state == "file" then elsewhere + .where.path
             else attention + "outdated " + elsewhere + "\(.where.path):\(.where.line)" end) + r + "  "
          + attention + $n.author.username + r + "  "
          + text + ($n.body | gsub("[\t\n]+"; " ") | .[0:120]) + r
          + (if (.notes | length) > 1 then context + "  +\(.notes | length - 1)" + r else "" end),
        .id, (.resolvable | tostring), (.resolved | tostring), ($n.id | tostring)
      ] | join("\t")' "$st/threads.json"
    ;;
  --drafts-list)
    if ! git-mr-threads --json "$iid" "$range" "reload(git-mr-threads --drafts-list $iid $range)" > "$st/threads.json"; then
      printf "${GK_CONTEXT}loading the drafts ...${GK_R}\n" > "$st/footer"
      exit 0
    fi
    # Every draft, where it sits: a new thread that is one, or a reply
    # waiting at the end of a thread. Claude's first, in the order of the
    # file and line they are on.
    jq -r -L "$share" '
      include "otis";
      [ .[] | . as $t | .notes[] | select(.draft) | {t: $t, n: .} ]
      | (map(select(.n.claude)) | length) as $c | (length) as $all
      | ("\($all) \(if $all == 1 then "draft" else "drafts" end), \($c) of them Claude" + (if $c == 1 then "\u0027s" else "\u0027s" end) + ": none is published until you submit") as $foot
      | $foot, (sort_by([(if .n.claude then 0 else 1 end), .t.where.path // "", .t.where.line // 0])[]
        | .t.where as $w |
        [ (if .n.claude then yours + "✎ Claude  " else attention + "✎ yours   " end) + r
            + (if $w.state == "line" then elsewhere + "\($w.path | split("/") | .[-1]):\(if ($w.from // $w.line) != $w.line then "\($w.from)-" else "" end)\($w.line)"
               elif $w.state == "file" then elsewhere + $w.path elif $w.state == "overview" then context + "on the MR"
               else attention + "outdated " + elsewhere + "\($w.path):\($w.line)" end) + r + "  "
            + text + (.n.body | gsub("[\t\n]+"; " ") | .[0:120]) + r,
          .t.id, ($w.path // ""), (($w.line // "") | tostring), ($w.side // ""), (.n.id | tostring)
        ] | join("\t"))' "$st/threads.json" | { IFS= read -r foot; printf '%s\n' "$foot" > "$st/footer"; cat; }
    ;;
  --show)
    range=${2:-$GMR_RANGE}
    jq -r -L "$share" --arg id "$1" '
      include "otis";
      .[] | select(.id == $id) |
      context + (if .where.state == "overview" then "on the MR"
        elif .where.state == "file" then "on the file " + .where.path
        elif .where.state == "line" then
          (if (.where.from // .where.line) != .where.line then "lines \(.where.from)–\(.where.line)" else "line \(.where.line)" end)
          + (if .where.side == "old" then ", removed," else "" end) + " of "
          + (.where.path | split("/") | if length > 2 then "…/" + (.[-2:] | join("/")) else join("/") end)
        else "outdated: was \(if .where.side == "old" then "removed line" else "line" end) \(.where.line) of \(.where.path)" end)
        + (if .draft then " · draft, published when you submit"
           elif .resolved then " · resolved" elif .resolvable then " · unresolved" else "" end) + r,
      (.notes[] | "", attention + .author.username + r
        + context + (if .draft then " · draft" else " · " + .created_at[0:10] end) + r,
        "\u0002" + (.body | gsub("\n"; "\u001f")))' "$st/threads.json" | markdown | wrap
    # The code it is on, a few lines either side, colored as the preview's
    # diffs are (bat, in the theme's colors), the lines it is on marked.
    jq -r --arg id "$1" '.[] | select(.id == $id) | select(.where.state == "line") | "\(.where.side) \(.where.from // .where.line) \(.where.line) \(.where.path)"' "$st/threads.json" |
      while read -r side from line path; do
        [ -n "$range" ] || break
        rev=${range#*..}; [ "$side" = old ] && rev=${range%%..*}
        printf "\n${GK_CONTEXT}THE CODE${GK_R}\n\n"
        lo=$(( from > 3 ? from - 3 : 1 )) hi=$(( line + 3 ))
        git show "$rev:$path" 2>/dev/null | sed -n "${lo},${hi}p" | expand -t 2 |
          { if command -v bat >/dev/null 2>&1; then
              BAT_THEME=${OTIS_T_BAT:-ansi} bat --color=always --style=plain --paging=never --wrap=never --file-name "$path" 2>/dev/null
            else cat; fi; } |
          awk -v n="$lo" -v from="$from" -v at="$line" -v lit="$(printf "$GK_ATTENTION")" -v dim="$(printf "$GK_FAINT")" -v r="$(printf "$GK_R")" '
            { printf "%s%5d%s %s%s%s\n", dim, n, r, (n >= from && n <= at ? lit "▌" r : " "), $0, r; n++ }'
      done
    # Why Claude wrote it, its gist: the first paragraph that says it, past
    # the heading line and before the lessons, to about five lines; the
    # rest is in the review.
    jq -r -L "$share" --arg id "$1" --argjson w "$(( ${FZF_PREVIEW_COLUMNS:-100} - 4 ))" '
      include "otis";
      .[] | select(.id == $id) | [.notes[] | select(.why)][0] // empty | .why |
      (split("\n\n") | map(select(test("\\S") and (test("^\\s*(\\*\\*|##)") | not)))) as $ps |
      "", yours + "WHY CLAUDE WROTE IT" + context + "  for you alone, never posted" + r, "",
      # About five lines of it, ended on a word.
      ($ps[0] // "" | gsub("\n"; " ") | if length > ($w * 5) then .[0:$w * 5] | sub(" [^ ]*$"; "") + " …" else . end | "\u0002" + .),
      (if ($ps | length) > 1 then "  " + faint + "+ \($ps | length - 1) more in the review" + r else empty end)' "$st/threads.json" | markdown
    ;;
  --overview)
    # gmr's preview of an MR: its unresolved threads on the MR itself, which
    # no file shows. A first look fetches them and redraws the preview.
    json=$(git-cached-json --no-wait "mr-$iid-threads" 15 refresh-preview -- \
      git-mr-pages "$api/discussions?per_page=100" 2>/dev/null) || exit 0
    jq -r -L "$share" '
      include "otis";
      map(select(.resolvable and (.resolved | not) and .notes[0].position == null))
      | select(length > 0)
      | "", yours + " \(length) unresolved on the MR itself" + r,
        (.[] | "", attention + .notes[0].author.username + r + context + " · " + .notes[0].created_at[0:10]
            + (if (.notes | length) > 1 then " · \(.notes | length - 1) repl\(if (.notes | length) == 2 then "y" else "ies" end)" else "" end) + r,
          (.notes[0].body | split("\n")[] | "\u0001" + .))' "$json" | wrap
    ;;
  --open)
    # nvim for its compose window: replying there is a draft or not the same as
    # on a line, and your own comments can be edited and deleted. Without
    # nvim, your latest comment in it, at a prompt (git-mr-say).
    command -v nvim >/dev/null 2>&1 || exec git-mr-say --edit "$GMR_IID" "$GMR_RANGE" "$1"
    env -u NVIM_DIFF_BASE GMR_THREAD="$1" nvim -c "luafile $share/mr-comments.lua"
    ;;
  --resolve)
    id=$3 resolvable=$4 resolved=$5
    [ "$resolvable" = true ] || exec git-fzf-note "only a thread can be resolved, and this is a single comment or a draft"
    if [ "$resolved" = true ]; then to=false; else to=true; fi
    if response=$(glab api -X PUT "$api/discussions/$id?resolved=$to" 2>&1); then
      git-mr-threads --refresh "$iid" "reload(git-mr-threads --list $iid $range)"
    else
      git-fzf-error "resolve the thread" "$response"
    fi
    echo "reload(git-mr-threads --list $iid $range)"
    ;;
  --drafts)
    # Your drafts, Claude's among them, to go through before you submit:
    # each with the code it is on and, for Claude's, why it wrote it. e
    # rewrites one, d drops it, enter opens its line in your editor, S
    # publishes them all as your review.
    list="git-mr-threads --drafts-list $iid $range"
    GMR_RANGE=$range git-fzf "!$iid drafts " 'e=edit it,d=drop it,enter=open its line in your editor,S=submit them all as your review,|,w=web,u=refresh' \
      --ansi --delimiter='\t' --with-nth=1 --track --id-nth=2 \
      --bind "start:reload($list)" \
      --bind "e:execute(git-mr-say --edit $iid $range {2})+execute-silent[git-mr-threads --refresh $iid 'reload($list)']+reload($list)" \
      --bind "d:execute(git-mr-say --delete $iid $range {2})+execute-silent[git-mr-threads --refresh $iid 'reload($list)']+reload($list)" \
      --bind "enter:execute(if [ -n {3} ]; then git-commit-open $range {3} {4}; fi)" \
      --bind "S:execute(git-mr-submit $iid $range ${GMR_KIND:-review})+execute-silent[git-mr-threads --refresh $iid 'reload($list)']+reload($list)" \
      --bind "w:execute-silent(otis-open \"\$(git-mr-url $iid)\")" \
      --bind "u:execute-silent[git-mr-threads --refresh $iid 'reload($list)']+reload($list)" \
      --preview "git-mr-threads --show {2} $range" </dev/null >/dev/null
    exit 0
    ;;
  *)
    list="git-mr-threads --list $iid $range"
    git-fzf "!$iid threads " 'c=reply,e=edit yours,d=delete yours,r=resolve or unresolve,|,enter=open in nvim,w=web,u=refresh' \
      --ansi --delimiter='\t' --with-nth=1 --track --id-nth=2 \
      --bind "start:reload($list)" \
      --keys-from 'otis-keys threads {3} {4}' \
      --bind "enter:execute(git-mr-threads --open {2})+execute-silent[git-mr-threads --refresh $iid 'reload($list)']+reload($list)" \
      --bind "c:execute(git-mr-say --reply $iid $range {2})+reload($list)" \
      --bind "e:execute(git-mr-say --edit $iid $range {2})+reload($list)" \
      --bind "d:execute(git-mr-say --delete $iid $range {2})+reload($list)" \
      --bind "r:transform(git-mr-threads --resolve $iid $range {2} {3} {4})" \
      --bind "w:execute-silent(otis-open \"\$(git-mr-url $iid)\"#note_{5})" \
      --bind "u:execute-silent[git-mr-threads --refresh $iid 'reload($list)']+reload($list)" \
      --preview "git-mr-threads --show {2}" </dev/null >/dev/null
    exit 0
    ;;
esac
