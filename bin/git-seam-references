#!/bin/sh
# git-seam-references: a seam references provider (seam's references/<name>),
# for TypeScript imports.
#
# seam's own edges are names it found inside a changed definition. An import
# specifier is not inside one, so a file whose whole change is "this moved
# package" has no edge to what moved, falls to the last slice, and --split
# writes a stack whose earlier commits name something that is not there —
# which seam then refuses to write, correctly and unhelpfully.
#
# This says what seam cannot: for every file the change has no definitions in,
# which changed definition its changed import lines name. seam then puts the
# file in that definition's slice and the sweep reads as the one thing it is.
#
# The table on stdin, `from<tab>to<tab>facet<tab>note` out. The two trees come
# from seam in the environment.
#
# It reads each changed file as the base had it and matches on two things at
# once: the imported name is a changed definition's, and the module
# specifier's last segment is that definition's file. Both, because a bare name match ties every file that says `run` to
# whatever `run` changed. Being wrong here only ever makes a split coarser —
# a file lands with something it did not need — so it errs towards saying so.
# A compiler would do better, and that is what the extension point is for.
[ -n "$SEAM_HEAD" ] || exit 0
tmp=$(mktemp -d) || exit 0
trap 'rm -rf "$tmp"' EXIT
cat > "$tmp/table"

# The changed definitions, by the bare name a user writes and the file they
# live in. A TypeScript type sharing a name with a const is "type X" here.
awk -F'\t' '$2 != "file" && $3 != "" {
    nm = $3; sub(/^type /, "", nm)
    if (nm ~ /^[A-Za-z_$][A-Za-z0-9_$]*$/) {
      id = $1 "#" ($4 == "" ? $3 : $4 "." $3)
      base = $1; sub(/^.*\//, "", base); sub(/\.[^.]*$/, "", base)
      print nm "\t" id "\t" base "\t" $1
    }
  }' "$tmp/table" | sort -u > "$tmp/defs"
[ -s "$tmp/defs" ] || exit 0

awk -F'\t' '$2 == "file" && $1 ~ /\.(ts|tsx|mts|cts)$/ { print $1 }' "$tmp/table" | sort -u > "$tmp/files"
[ -s "$tmp/files" ] || exit 0

# Each file as the base had it, in one stream, the path on the header. The
# base and not the head, because what is being asked is what this file used to
# reach for: a definition that moved is gone from the head's imports, which is
# exactly the change being placed.
#
# The base text rather than the diff, because an import is not always one
# line. A long one is a brace block with a name to a line and the module at
# the end, so the removed line is a bare identifier and says nothing about
# where it came from; joined back up it says both.
while read -r p; do printf '%s:%s %s\n' "$SEAM_BASE" "$p" "$p"; done < "$tmp/files" |
  git cat-file --batch='%(objectsize) %(rest)' 2>/dev/null |
awk -F'\t' '
  function flush(   spec, sb, n, names, j, nm, k) {
    if (stmt == "") return
    if (stmt ~ /from[ \t]*["'"'"']/) {
      spec = stmt; sub(/^.*from[ \t]*["'"'"']/, "", spec); sub(/["'"'"'].*$/, "", spec)
      sb = spec; sub(/^.*\//, "", sb)
      if (sb != "") {
        n = split(stmt, names, /[^A-Za-z0-9_$]+/)
        for (j = 1; j <= n; j++) {
          nm = names[j]
          if (nm == "" || !(nm in ID) || BASE[nm] != sb || HOME_[nm] == f) continue
          k = f SUBSEP ID[nm]
          if (k in said) continue
          said[k] = 1
          print f "\t" ID[nm] "\tiface\timports it from " spec
        }
      }
    }
    stmt = ""
  }
  FILENAME == ARGV[1] { ID[$1] = $2; BASE[$1] = $3; HOME_[$1] = $4; next }
  # The header cat-file writes before each blob: its size, then the path.
  left <= 0 && /^[0-9]+ / { flush(); left = $0 + 0; f = $0; sub(/^[0-9]+ /, "", f); stmt = ""; next }
  {
    left -= length($0) + 1
    line = $0
    if (stmt != "") { stmt = stmt " " line; if (line ~ /from[ \t]*["'"'"']/ || line ~ /;[ \t]*$/) flush() }
    else if (line ~ /^[ \t]*(import|export)[ \t]/) {
      stmt = line
      if (line ~ /from[ \t]*["'"'"']/) flush()
    }
  }
  END { flush() }
' "$tmp/defs" -
