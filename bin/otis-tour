#!/usr/bin/env -S zsh -f
# otis-tour                a menu of guided tours of what otis does, the
#                          most useful first; enter takes one, and q in a
#                          tour comes back to the menu
# otis-tour <tour|part>    that tour, or a tour from that part on
# otis-tour --list         the tours and their parts
# otis-tour --about <tour> what a tour covers (the menu's preview)
#
# The hands-on tours (reading by symbol, bad changes, committing, branches)
# run on changes made up for them, in a throwaway repo under $TMPDIR
# (otis-tour) with an origin of its own, so nothing touches your repos or
# GitLab. The rest are
# about what needs GitLab, Claude or Cursor Cloud, and offer to open the real
# thing in the repo you ran the tour from. The one thing that leaves your
# machine is what otis always sends: with Claude Code installed, the symbol
# view has Haiku gloss the made-up change and Sonnet propose a fix for the
# caller it breaks.
root=${0:A:h:h}
path=($root/bin $path)
# The theme, for the tour's own words and every picker it opens; loaded again
# at the menu, so one picked in the settings tour takes from there on.
theme() {
  eval "$(otis-theme --env)"
  a=$'\e['$OTIS_T_ATTENTION'm' k=$'\e['$OTIS_T_ELSEWHERE'm' m=$'\e['$OTIS_T_CONTEXT'm'
  g=$'\e['$OTIS_T_GOOD'm' b=$'\e['$OTIS_T_BAD'm' y=$'\e['$OTIS_T_YOURS'm' r=$'\e[0m'
}
theme
tour=${${TMPDIR:-/tmp}%/}/otis-tour repo=${${TMPDIR:-/tmp}%/}/otis-tour/repo
seen=${XDG_CACHE_HOME:-$HOME/.cache}/git-alias/tour-seen
here=$PWD
cols=$(tput cols 2>/dev/null || print 80)
(( w = cols > 82 ? 78 : cols - 4 ))

# The tours, in the order worth taking them: name, title, what kind, its
# parts, and a few sentences for the menu's preview.
tours=(symbols shapes mr claude verify ship dashboard commits branches settings cheatsheet)
typeset -A ttitle tkind tparts tabout ptitle
ttitle=(
  symbols    "Reviewing by symbol"
  shapes     "Bad changes, and how symbols show them"
  mr         "Reviewing a merge request in gmr"
  claude     "Claude reviews and fixes (C)"
  verify     "Verifying in Cursor Cloud (V)"
  ship       "Merging, deploys and watching production (D)"
  dashboard  "The dashboard: otis and gag"
  commits    "Committing and fixing history"
  branches   "Branches, stacks and worktrees"
  settings   "Settings worth turning on"
  cheatsheet "Cheat sheet"
)
tkind=(
  symbols    "hands-on · 15 min"
  shapes     "hands-on · 15 min"
  mr         "your repo · 5 min"
  claude     "your repo · 5 min"
  verify     "your repo · 5 min"
  ship       "your repo · 5 min"
  dashboard  "your repo · 3 min"
  commits    "hands-on · 10 min"
  branches   "hands-on · 5 min"
  settings   "your setup · 3 min"
  cheatsheet "one page"
)
tparts=(
  symbols    "why gitlab side files reading radius more seam staging log recap"
  shapes     "score sweep tangle split chain carry knot heavy gallery"
  mr         "mr"
  claude     "claude_review claude_fix"
  verify     "verify_how verify_run verify_setup"
  ship       "ship_merge ship_prod"
  dashboard  "dashboard"
  commits    "commits"
  branches   "branches_gb branches_more"
  settings   "settings"
  cheatsheet "cheatsheet"
)
tabout=(
  symbols    "Why otis reads a change by symbol rather than by file, shown rather than told: one made-up change as GitLab shows it, as files, and by symbol. Then every key the symbol view has, the callers elsewhere that a change breaks without touching, Claude's fix for them, seam's graph page, and staging one function at a time. Start here."
  shapes     "Six made-up changes that each go wrong a different way: a sweep, a branch of unrelated stories, a parameter threaded nine layers deep, a type change that breaks code it never touched, a cycle, and a 300-line function. Each as files first, so you can guess what is wrong, then as seam's score and the symbol tree, and what to ask the author for. One of them gets cut into eight commits that each build, to show what asking for it looks like when seam does it. Take Reviewing by symbol first."
  mr         "The review loop in gmr: an MR opens by symbol with its threads beside each symbol, comments from the picker or inline in nvim, drafts until you submit, viewed marks, what changed since your last review, catching up when the author pushes."
  claude     "C has Claude Code review an MR in the background, reading it by symbol with tsgo's callers elsewhere, as you do, and leave drafts on the symbols they are about. You edit them before anything posts, and each says where its symbol sits in the tree, why Claude wrote it and how sure it is. On your own MR it proposes fixes for the threads instead, and folds the ones you accept into the right commits."
  verify     "V finds out whether a change actually works: Claude writes the claims that would prove it, a Cursor Cloud agent uses the app in a VM and records a video per claim, and Claude judges the evidence, claim by claim. With what you need set up to run one."
  ship       "From an open MR to production without the browser: CI jobs and logs, merge when the pipeline passes, rebase, whether your merged MR is live yet, gd's deploys, and D, where Claude watches Datadog after your deploy and tells you whether a problem is yours."
  dashboard  "otis, where a morning starts: everything that wants you in one list, ordered by what a delay costs, one row a thing. And gag, everything Claude is doing in the background."
  commits    "ga, gcm, gam, gfx, gl, gundo and gwip on a made-up branch: stage one function, fold a fix into the commit it belongs in, reword, and undo any of it."
  branches   "gb with each branch's MR and drift, worktrees for what runs beside your checkout (gw, gwn), gup, and glab stacks (gstack)."
  settings   "What is set in your repo now, and the settings that change the most: a remote workspace for checks, what Claude may run, lint before folding fixes, Claude's lessons, your editor and theme."
  cheatsheet "Every key worth knowing, on one page."
)
ptitle=(
  why "Why read a change by symbol"  gitlab "The change as GitLab shows it"
  side "The same change, side by side"  recap "What symbols gave you"
  files "The file picker"  reading "The symbol view: reading"
  radius "The symbol view: what it breaks"  more "The symbol view: other ways in"
  seam "seam's page"  staging "Staging by symbol"  log "The log"
  score "Reading the score"  sweep "The sweep: big by file, safe by symbol"
  tangle "The tangle: eight stories in one branch"  split "Splitting it: one branch, eight commits"
  chain "The chain: nine layers for one line"
  carry "The carry: one file that breaks three"  knot "The knot: a circle, and a bug"
  heavy "The heavy one: 300 lines in one function"  gallery "Side by side"
  mr "The review loop"
  claude_review "Claude reviews an MR"  claude_fix "Claude fixes your MR"
  verify_how "How a verification works"  verify_run "Reading one"  verify_setup "What it needs"
  ship_merge "Pipelines and merging"  ship_prod "Deploys and production"
  dashboard "otis and gag"
  commits "Committing and fixing history"
  branches_gb "Branches"  branches_more "Worktrees, rebasing and stacks"
  settings "Settings worth turning on"
  cheatsheet "Cheat sheet"
)

# --- output

# wrap <width> <indent> <text>: the text in lines of at most <width>
# visible columns (colors take none), the first as it is and the rest after
# <indent> spaces.
wrap() {
  setopt localoptions extendedglob
  local line= word pad=${(l:$2:: :)}
  integer n=0 wl
  for word in ${=3}; do
    wl=${#${word//$'\e'\[[0-9;]#m/}}
    if (( n && n + 1 + wl > $1 )); then
      print -r -- "$line"; line=$pad$word; n=wl
    else
      line+=${line:+ }$word; (( n += (n ? 1 : 0) + wl ))
    fi
  done
  print -r -- "$line"
}
# say <text>: a paragraph, wrapped and indented.
say() { print -n "  "; wrap $w 2 "$*"; print; }
# heading <n>: the part's title, and where it sits in its tour.
heading() {
  clear
  if (( $#cur > 1 )); then print -r -- "${m}otis tour · ${ttitle[$cur_tour]} · $1 of $#cur${r}"
  else print -r -- "${m}otis tour${r}"; fi
  print -r -- "${a}${ptitle[${cur[$1]}]}${r}"
  print
}
# hang <indent> <text>: wrapped to the page, every line after the first
# indented to line up under the first's text.
hang() { wrap $(( w - $1 )) $1 "$2"; }
# key <keys> <what>: one line of a list of keys, the keys $kw wide.
kw=12
key() { printf "    ${k}%-${kw}s${r} " "$1"; hang $(( kw + 5 )) "$2"; }
# look <n> <what>: one numbered thing to find.
look() { printf "    ${a}%s${r}  " "$1"; hang 7 "$2"; }

# One keypress: enter goes on (0), s skips the rest of this part (1), q
# leaves the tour for the menu (each tour runs in a subshell of its own).
pause() {
  local c
  printf "\n  ${m}enter${r} ${1:-go on}   ${m}s${r} skip   ${m}q${r} back to the menu "
  read -rsk1 c </dev/tty
  print; print
  case $c in
    q|Q) exit 0 ;;
    s|S) return 1 ;;
  esac
  return 0
}
# ask <question>: y/N, one keypress.
ask() { git-confirm "  $1"; }

# launch <command...>: the real thing, in the demo repo; q comes back.
launch() {
  pause "open it (${a}q${r} in it comes back here)" || return 1
  (cd $repo && "$@")
  return 0
}
# shell: your own shell in the demo repo, for commands rather than pickers.
shell() {
  pause "open a shell in the demo (${a}exit${r} comes back here)" || return 1
  (cd $repo && ${SHELL:-zsh} -i)
  return 0
}
# mine: a GitLab repo to open the real thing in, the one the tour ran from.
mine() { (cd $here && git rev-parse --git-dir >/dev/null 2>&1 && otis-config gitlab); }
# offer <question> <command...>: run it in your repo, if the tour ran from
# one; else say where to run it.
offer() {
  local q=$1; shift
  if mine; then
    print
    ask "$q in $(cd $here && basename "$(git rev-parse --show-toplevel)")?" || return 0
    (cd $here && "$@")
  else
    say "${a}Run $1 in your repo to try it.${r} Run otis-tour from there and this offers to open it."
    pause
  fi
}
# status <ok|need|note> <name> <what>: one line of a setup check.
status() {
  local c=$g; [[ $1 == need ]] && c=$b; [[ $1 == note ]] && c=$m
  printf "    ${c}%-4s${r}  ${k}%-18s${r} " "$1" "$2"; hang 29 "$3"
}

# --- the demo repo

# A returns service that starts charging a restocking fee on late returns.
# Small, but with what makes real MRs hard to read: a generated file and a
# migration that sort first, a test before the code it tests, the entry point
# in the middle, a helper several calls down, a function whose signature
# changed, and a caller the change never touched that no longer type checks.
build() {
  rm -rf $tour && mkdir -p $tour || exit 1
  git init -q --bare $tour/origin.git
  git init -q -b main $repo && cd $repo || exit 1
  git config user.email tour@otis.invalid; git config user.name "otis tour"
  mkdir -p src/api src/__generated__ migrations
  print '{ "name": "@tour/returns", "private": true, "type": "module" }' > package.json
  print '{ "compilerOptions": { "strict": true, "target": "es2022", "module": "esnext", "moduleResolution": "bundler", "noEmit": true }, "include": ["src"] }' > tsconfig.json
  print 'src/__generated__/** linguist-generated' > .gitattributes
  gen() {
    print '// generated from schema.graphql: do not edit'; print 'export type ReturnRecord = {'
    for f; do print "  $f: string | null;"; done; print '};'
  }
  gen id orderId customerId sku quantity currency status reason createdAt updatedAt > src/__generated__/schema.ts
  cat > src/order.ts <<'EOF'
export interface Order {
  id: string;
  total: number;
  deliveredAt: Date;
}
EOF
  cat > src/policy.ts <<'EOF'
import type { Order } from "./order";

// What the customer gets back for a return.
export function refundAmount(order: Order): number {
  return order.total;
}
EOF
  cat > src/email.ts <<'EOF'
export function receiptLine(amount: number): string {
  return `Refund: $${amount.toFixed(2)}`;
}
EOF
  cat > src/api/returns.ts <<'EOF'
import type { Order } from "../order";
import { refundAmount } from "../policy";
import { receiptLine } from "../email";

export async function handleReturn(order: Order): Promise<string> {
  const amount = refundAmount(order);
  return receiptLine(amount);
}
EOF
  cat > src/api/exchanges.ts <<'EOF'
import type { Order } from "../order";
import { refundAmount } from "../policy";

export interface Exchange {
  order: Order;
  requestedAt: Date;
}

// An exchange is store credit worth what a refund would have been.
export function exchangeCredit(exchange: Exchange): number {
  return refundAmount(exchange.order);
}
EOF
  git add -A && git commit -qm "Refund the order total on a return"
  gallery_base
  git add -A && git commit -qm "Add the jobs, checkout, billing and shipping rates"
  git remote add origin $tour/origin.git
  git push -q origin main && git remote set-head origin main >/dev/null

  git switch -qc tour/restocking-fee
  gen id orderId customerId sku quantity currency status reason returnedAt restockingFee restockingFeeCurrency restockingWaivedBy restockingWaivedAt createdAt updatedAt > src/__generated__/schema.ts
  print 'ALTER TABLE returns ADD COLUMN restocking_fee numeric(10, 2);' > migrations/0042_restocking_fee.sql
  cat > src/fees.ts <<'EOF'
import type { Order } from "./order";

export const RESTOCKING_WINDOW_DAYS = 30;
const FEE_RATE = 0.15;

export function daysSince(from: Date, to: Date): number {
  return Math.floor((to.getTime() - from.getTime()) / 86_400_000);
}

// Returns inside the window are free; after it, a share of the total.
export function restockingFee(order: Order, returnedAt: Date): number {
  if (daysSince(order.deliveredAt, returnedAt) <= RESTOCKING_WINDOW_DAYS) return 0;
  return Math.round(order.total * FEE_RATE * 100) / 100;
}
EOF
  cat > src/fees.test.ts <<'EOF'
import { restockingFee } from "./fees";

const order = { id: "o1", total: 100, deliveredAt: new Date("2026-01-01") };

export function testInsideWindowIsFree() {
  if (restockingFee(order, new Date("2026-01-20")) !== 0) throw new Error("charged inside the window");
}

export function testAfterWindowCharges() {
  if (restockingFee(order, new Date("2026-03-01")) !== 15) throw new Error("wrong fee");
}
EOF
  cat > src/policy.ts <<'EOF'
import type { Order } from "./order";
import { restockingFee } from "./fees";

// What the customer gets back for a return, less any restocking fee.
export function refundAmount(order: Order, returnedAt: Date): number {
  return order.total - restockingFee(order, returnedAt);
}
EOF
  cat > src/email.ts <<'EOF'
export function receiptLine(amount: number, fee = 0): string {
  const line = `Refund: $${amount.toFixed(2)}`;
  return fee > 0 ? `${line} (after a $${fee.toFixed(2)} restocking fee)` : line;
}
EOF
  cat > src/api/returns.ts <<'EOF'
import type { Order } from "../order";
import { refundAmount } from "../policy";
import { receiptLine } from "../email";
import { restockingFee } from "../fees";

export async function handleReturn(order: Order, returnedAt = new Date()): Promise<string> {
  const amount = refundAmount(order, returnedAt);
  return receiptLine(amount, restockingFee(order, returnedAt));
}
EOF
  git add -A && git commit -qm "Charge a restocking fee on late returns"
  git config otis-tour.head "$(git rev-parse HEAD)"
  gallery
  git switch -q tour/restocking-fee
  cd $here
}

# The bad changes tour's gallery: code on main for them to change, then one
# branch each off main, every one going wrong in a way seam's score names.
jobs=(nightlyExport retryWebhooks expireLabels syncCarriers pruneDrafts reconcileRefunds sendDigests archiveOrders rotateKeys warmCaches)
steps=(checkoutRoute startCheckout buildQuote quoteCart cartTotal lineTotal unitPrice applyTax roundCents)
gallery_base() {
  local j i
  mkdir -p src/jobs src/checkout src/billing src/reports
  print 'export const log = { info: (m: string) => console.info(new Date().toISOString(), m) };' > src/log.ts
  for j in $jobs; do
    print "export async function $j(): Promise<number> {\n  console.log(\"$j: start\");\n  const n = 0;\n  console.log(\"$j: done\");\n  return n;\n}" > src/jobs/$j.ts
  done
  for (( i = 1; i < $#steps; i++ )); do
    print "import { $steps[i+1] } from \"./$steps[i+1]\";\n\nexport function $steps[i](amount: number): number {\n  return $steps[i+1](amount);\n}" > src/checkout/$steps[i].ts
  done
  print "export function $steps[-1](amount: number): number {\n  return Math.round(amount * 100) / 100;\n}" > src/checkout/$steps[-1].ts
  cat > src/billing/money.ts <<'EOF'
export type Money = number;

export type LineItem = { sku: string; price: Money };

export type Invoice = { id: string; items: LineItem[] };

export type Refund = { invoice: Invoice; amount: Money };

export function invoiceTotal(invoice: Invoice): Money {
  return invoice.items.reduce((sum, item) => sum + item.price, 0);
}

export function refundFor(invoice: Invoice): Refund {
  return { invoice, amount: invoiceTotal(invoice) };
}
EOF
  cat > src/reports/revenue.ts <<'EOF'
import { invoiceTotal, type Invoice } from "../billing/money";

export function revenue(invoices: Invoice[]): number {
  return invoices.reduce((sum, invoice) => sum + invoiceTotal(invoice), 0);
}
EOF
  cat > src/reports/refunds.ts <<'EOF'
import { refundFor, type Invoice } from "../billing/money";

export function refundedShare(invoices: Invoice[], refunded: Invoice[]): number {
  const out = refunded.reduce((sum, invoice) => sum + refundFor(invoice).amount, 0);
  return out / invoices.length;
}
EOF
  cat > src/api/invoices.ts <<'EOF'
import { invoiceTotal, type Invoice } from "../billing/money";

export function invoiceLine(invoice: Invoice): string {
  return `Invoice ${invoice.id}: $${invoiceTotal(invoice).toFixed(2)}`;
}
EOF
  print "export function zoneRate(zone: string, weight: number): number {\n  switch (zone) {" > src/rates.ts
  for (( i = 1; i <= 100; i++ )); do
    printf '    case "Z%03d": return %d.%02d * weight;\n' $i $(( 3 + i % 7 )) $(( i * 37 % 100 )) >> src/rates.ts
  done
  print "    default: throw new Error(\`no rate for \${zone}\`);\n  }\n}" >> src/rates.ts
}
gallery() {
  local j i
  typeset -A helper=(nightlyExport csvRow retryWebhooks backoff expireLabels labelAge syncCarriers carrierIds
    pruneDrafts isStale reconcileRefunds unmatched sendDigests digestFor archiveOrders archiveCutoff)
  # A sweep: the same edit to ten bodies.
  git switch -qc tour/sweep main
  for j in $jobs; do perl -0pi -e 's/console\.log/log.info/g; s/^/import { log } from "..\/log";\n\n/' src/jobs/$j.ts; done
  git commit -qam "Log through log.info, not console.log"
  # A tangle: eight jobs, each calling a new helper, nothing in common.
  git switch -qc tour/tangle main
  for j in ${(k)helper}; do
    perl -0pi -e "s/const n = 0;/const n = $helper[$j]();/; \$_ .= qq{\nexport function $helper[$j](): number {\n  return 1;\n}\n}" src/jobs/$j.ts
  done
  git commit -qam "Friday fixes"
  # A chain: one parameter threaded down nine layers for the last one's sake.
  git switch -qc tour/chain main
  for j in $steps; do
    perl -pi -e 's/\(amount: number\)/(amount: number, currency: string)/; s/\((amount)\);/($1, currency);/' src/checkout/$j.ts
  done
  perl -pi -e 's/return Math.round/if (currency === "JPY") return Math.round(amount);\n  return Math.round/' src/checkout/$steps[-1].ts
  git commit -qam "Round yen to whole units"
  # Carry: a type change that travels through every signature naming it,
  # and past the diff, into callers it never touched.
  git switch -qc tour/carry main
  cat > src/billing/money.ts <<'EOF'
export type Money = { cents: number; currency: string };

export type LineItem = { sku: string; price: Money; quantity: number };

export type Invoice = { id: string; currency: string; items: LineItem[] };

export type Refund = { invoice: Invoice; amount: Money; reason: string };

export function invoiceTotal(invoice: Invoice): Money {
  const cents = invoice.items.reduce((sum, item) => sum + item.price.cents * item.quantity, 0);
  return { cents, currency: invoice.currency };
}

export function refundFor(invoice: Invoice, reason: string): Refund {
  return { invoice, amount: invoiceTotal(invoice), reason };
}
EOF
  git commit -qam "Keep money in cents with its currency"
  # A knot: the refund asks the discount, which asks the refund.
  git switch -qc tour/knot main
  cat > src/policy.ts <<'EOF'
import type { Order } from "./order";
import { isFinalSale } from "./sale";

// What the customer gets back for a return: nothing on a final sale.
export function refundAmount(order: Order): number {
  if (isFinalSale(order)) return 0;
  return order.total;
}
EOF
  cat > src/sale.ts <<'EOF'
import type { Order } from "./order";
import { refundAmount } from "./policy";

// Anything discounted by more than half is a final sale.
export function isFinalSale(order: Order): boolean {
  return discountRate(order) > 0.5;
}

export function discountRate(order: Order): number {
  return 1 - refundAmount(order) / order.total;
}
EOF
  git add -A && git commit -qm "Make heavily discounted orders final sale"
  # Heavy: three hundred lines of one function.
  git switch -qc tour/heavy main
  perl -pi -e 's/^(\s+case "Z\d+":) return ([\d.]+) \* weight;/sprintf("%s\n      return %.2f * weight + surcharge(weight);", $1, $2 * 1.06)/e' src/rates.ts
  print "\n// Parcels over 20kg pay by the kilo on top.\nexport function surcharge(weight: number): number {\n  return weight > 20 ? (weight - 20) * 0.4 : 0;\n}" >> src/rates.ts
  git commit -qam "Raise rates 6% and add a surcharge on heavy parcels"
}

# Back to the change as built: a part may have staged, committed, or taken
# Claude's fix into the checkout.
demo_reset() {
  [[ -e $tour/built.$$ ]] || { build; : > $tour/built.$$; }
  git -C $repo switch -qf tour/restocking-fee 2>/dev/null
  git -C $repo reset -q --hard "$(git -C $repo config otis-tour.head)"
  git -C $repo clean -qfd
}

# --- the parts

part_why() {
  heading $1
  say "A diff is sorted by path. A change is not. GitLab hands you files in alphabetical order, so you meet generated code and migrations first, tests before the code they test, a helper before you know who calls it, and the entry point wherever its filename happens to land."
  say "So the reading order is yours to rebuild, in your head, while you also judge the code: who calls this, did its signature change, where was I. And the question a review most exists to answer, what this breaks, is often not in the diff at all: the code that breaks is the code the author did not touch."
  say "otis reads a change by symbol instead. seam parses both sides of every changed file (ast-grep, no model, under a second), and the symbol view lays the change out as a tree: the entry points first, each opening to what it uses, each row a signature saying whether its interface changed or only its body. Under anything exported, tsgo finds the callers the change did not touch and type checks them before and after, so what it breaks is a row with a ${b}✗${r} on it."
  say "This tour shows the same small change three ways, so you can feel the difference rather than take it on trust: as GitLab shows it, as files, and by symbol. Then everything else the symbol view does. About fifteen minutes."
  pause
}

part_gitlab() {
  heading $1
  demo_reset
  say "The change: a returns service starts charging a restocking fee on late returns. Here it is the way GitLab's Changes tab shows it: every file, by path, one long scroll. Read it and try to answer:"
  look 1 "Where does the change start? What would you read first?"
  look 2 "Which function's contract changed, so every caller has to change too?"
  look 3 "What does it break?"
  pause "show the diff (${a}q${r} leaves it)" || return
  (cd $repo && { git diff --stat origin/main...HEAD; print; git diff origin/main...HEAD | FZF_PREVIEW_COLUMNS=$cols git-delta; } | less -R)
  heading $1
  say "The answers:"
  look 1 "handleReturn, in src/api/returns.ts: the third of seven files, after a generated type and a migration."
  look 2 "refundAmount gained a required argument. It is in the last file, src/policy.ts, and nothing marks it as different from an edit to a function body."
  look 3 "exchangeCredit, in src/api/exchanges.ts, still calls refundAmount(order) with one argument, so it no longer type checks. It is in no file of the diff. CI would tell you eventually; the diff never will."
  say "None of that is hard in a 40-line change. In a 1,500-line one it is the whole job, and it is where the time goes."
  pause
}

# The same change both ways on one screen: GitLab's order beside the symbol
# tree as gdm opens it (abridged: tests, generated code and the SQL sit under
# their own headings below it), with the three answers pointed at.
part_side() {
  heading $1
  setopt localoptions extendedglob
  local -a left right
  left=(
    "${m}1 migrations/0042_restocking_fee.sql${r}"
    "${m}2 src/__generated__/schema.ts${r}"
    "${a}3 src/api/returns.ts${r}"
    "${m}4 src/email.ts${r}"
    "${m}5 src/fees.test.ts${r}"
    "${m}6 src/fees.ts${r}"
    "${a}7 src/policy.ts${r}"
    ""
    "${b}  src/api/exchanges.ts: not here${r}"
  )
  right=(
    "${a}~${r} handleReturn          ${y}← start here${r}"
    "  ${a}~${r} refundAmount        ${y}← contract${r}"
    "      restockingFee"
    "        daysSince"
    "    ${k}▸ callers elsewhere${r}"
    "      exchangeCredit ${b}✗${r}  ${y}← breaks${r}"
    "  ${a}~${r} receiptLine"
    "    restockingFee"
    "${m}── tests, generated, SQL${r}"
  )
  say "The same change, the two ways, on one screen:"
  local i pad
  if (( w >= 76 )); then
    printf "  ${k}%-38s${r}${k}%s${r}\n" "by file, as GitLab orders it" "by symbol, as gdm opens it"
    for (( i = 1; i <= $#left; i++ )); do
      # Pad by what shows, since the colors take no columns.
      pad=${left[i]//$'\e'\[[0-9;]#m/}
      print -r -- "  $left[i]${(l:38 - $#pad:: :)}$right[i]"
    done
  else
    print -r -- "  ${k}by file, as GitLab orders it${r}"; for i in $left; do print -r -- "  $i"; done; print
    print -r -- "  ${k}by symbol, as gdm opens it${r}"; for i in $right; do print -r -- "  $i"; done
  fi
  print
  say "Three questions, three rows, all on the first screen. By file you read seven files in the filesystem's order and still never met the third answer, since exchanges.ts is not in the diff. By symbol, where to start is the top row, a changed contract is a ${a}~${r}, and what breaks is a ${b}✗${r} with the caller under it."
  say "And what the file list cannot say at all: restockingFee is used in two places, and the tree shows it under both; daysSince is three calls down, and you meet it there, after the code that needs it; the tests and the generated type are there, but under their own headings, out of the way."
  pause
}

