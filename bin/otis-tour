  demo_reset
  launch gl
}

part_recap() {
  heading $1
  say "What reading by symbol gave you, against what the file list could:"
  local q f s
  printf "  ${k}%-22s %-22s %s${r}\n" "" "by file" "by symbol"
  for q f s in \
    "where to start" "wherever it sorts" "the top row" \
    "a changed contract" "read every function" "${a}~${r} on its row" \
    "what it breaks" "nothing, until CI" "${b}✗${r} on the caller, a fix under it" \
    "what is safe to skim" "nothing says" "no ${a}~${r}: only the body changed" \
    "rewiring" "nothing says" "${k}⇢${r}: a mention the change added" \
    "committing a part" "hunks, if they split" "${k}space${r} on the function" \
    "how hard it is" "the line count" "${k}s${r}: the shape, and what to ask for"
  do
    printf "  %-22s ${m}%-22s${r} %s\n" "$q" "$f" "$s"
  done
  print
  say "None of it needs a model or a guess: seam parses both sides, tsgo type checks the callers, and the answer is the same every time. Claude comes on top of that, not instead of it."
  say "Next, ${k}Bad changes, and how symbols show them${r}: six branches that go wrong in six ways, and how the tree and the score catch each."
}

# The bad changes: each a branch of the demo off main. demo_on <name> checks
# one out as it was built; byfile <name> is what GitLab would give you;
# score <name> is seam's score of it.
demo_on() { demo_reset; git -C $repo switch -q tour/$1; }
byfile() {
  print -r -- "  ${m}by file${r}"
  (cd $repo && git diff --stat=$(( w - 2 )) --stat-graph-width=20 origin/main...tour/$1) | sed 's/^/  /'
  print
}
score() { (cd $repo && COLUMNS=$(( w + 4 )) SEAM_COLOR=1 seam origin/main...tour/$1 --score) | sed 's/^/  /'; }
# guess <n> <name> <question...>: the change as files and what to wonder
# about it, then the score on part <n>'s next page.
guess() {
  local n=$1 b=$2; shift 2
  byfile $b
  local q; for q; do look "?" "$q"; done
  pause "show seam's score" || return 1
  heading $n
  score $b
}

part_score() {
  heading $1
  demo_reset
  say "seam scores a change on what makes it hard to read: not whether the code is good, but whether a reviewer can hold it in their head. Here is the restocking fee change from the last tour, by symbol, scored:"
  score restocking-fee
  pause "what each line means" || return
  heading $1
  say "Each line is a count, with a bar: ${g}green${r}, ${a}amber${r} or ${b}red${r}. Anything not green says what to do about it, underneath. There is no total, since one number hides which of the problems you have; the verdict is the worst line, because a change with one terrible dimension is hard however tidy the rest is."
  local kw=10
  key stories "threads that nothing makes you read together. Four is four reviews in one branch"
  key loose "changed definitions nothing else in the change touches. All loose is a sweep"
  key knots "a circle: no end of it can be read first"
  key chain "how many layers you follow down from one entry point"
  key carry "changed interfaces named in other changed signatures, so the change travels on"
  key heaviest "the most changed lines in one definition"
  key spread "files and directories: each one a context switch"
  key safe "definitions whose body alone changed, which nothing outside them can break. The good news, never rated"
  print
  say "No model: the same change scores the same every time, and each line names the definition to blame, so it can be argued with. ${k}s${r} in any symbol view shows it in the preview; ${k}seam <range> --score${r} prints it."
  say "Each part after this is a made-up branch that goes wrong one way. You get it as files first, the way GitLab would show it. Guess what is wrong, then see what the score and the tree say."
  pause
}

part_sweep() {
  heading $1
  demo_on sweep
  say "Someone swapped console.log for the new log.info in every job. Ten files, sixty lines: the kind of MR that sits in the queue because nobody has half an hour."
  guess $1 sweep "How long would you give it? What could it break?" || return
  say "${b}Red${r}, and the easiest review in the tour. ${k}loose${r}: ten of ten definitions touch nothing else in the change. ${k}safe${r}: ten of ten changed only their bodies. No signature moved, so nothing outside them can break."
  say "It is red because it is not one change but one edit made ten times, and wants reading as a list, not as a story. Which is fast, once you know."
  look 1 "In the tree every row is flat: no ${a}~${r}, no ${k}▸${r}, nothing to open. j down the rows with the preview on; a glance each."
  look 2 "What to ask for: nothing, as it stands. The mistake is a sweep inside a feature branch, where these ten rows bury the three that matter. By symbol they are easy to tell apart: the three have a ${a}~${r} or something under them."
  launch gdm
}

part_tangle() {
  heading $1
  demo_on tangle
  say "A branch called Friday fixes. Eight jobs each got a small change. Eight files, 48 lines, all in one directory: it looks like one thing."
  guess $1 tangle "Is this one review, or several?" || return
  say "${k}stories${r}: eight threads, and nothing makes you read any two of them together. The tree says it before the score does: eight top-level rows, each opening to the one helper it now calls, marked ${k}⇢${r} as a new mention. No row reaches into another."
  look 1 "Each top-level row is an MR that could ship on its own. Reviewed together, each gets an eighth of your attention and you pay eight context switches for it."
  look 2 "By file you would find that out a file at a time. By symbol it is the first screen: count the top-level rows."
  look 3 "What to ask for: split the branch at the top-level rows. Or review it as a list of eight small things, knowing that is what you are doing."
  launch gdm
}

part_split() {
  heading $1
  demo_on tangle
  say "The same Friday fixes branch. ${k}stories${r} said eight, and what to ask for was to split it — so ask seam to. ${k}S${r} in the symbol view is the plan: which definition and which file goes in which commit, and in what order."
  guess $1 split "If you cut this into eight, what has to be true of each piece?" || return
  say "Each has to build on its own. A slice is closed under what it mentions: everything it names is either in it or in a slice before it, so nothing in the middle of the stack is missing a name. Here that is easy — the eight stories touch nothing in common. It is the branches where they do that seam has something to say."
  look 1 "${k}S${r}: eight slices, one a story, each named after the definition it is about, each one file and five lines. This branch comes apart cleanly because nothing in it is shared; the count matches ${k}stories${r} because they are the same count."
  look 2 "${k}P${r} writes them as commits on a branch named for the moment, opens the log over it, and deletes the branch when you leave. ${k}enter${r} on a commit reads it by symbol like any other. Nothing is checked out and nothing is left behind."
  look 3 "${k}C${r} keeps one, on a branch beside the one you are on. Your branch is not touched — every commit is built from the base tree in an index of its own — so going back is standing still, and throwing it away is deleting one ref."
  say "Your own branches will not be this tidy. A file the change has no definitions in — a lockfile, a migration, a schema — has nothing to place it by and falls to the last slice, which is the wrong end when the code waits on it: ${k}.seam/first${r} names the paths that lead. Files whose changed lines are all the same edit are one slice, since a rename read once is read everywhere."
  say "With a command in ${k}.seam/check${r}, seam runs it on every commit as it makes it and writes nothing unless all of them pass. When one fails it fuses that slice with the slices it was waiting for and builds the whole thing again: the check is the only thing that knows whether a stack stands up, so it is the thing allowed to correct the plan. A branch that ends up one commit was one commit, and that is an answer, and a proved one."
  launch gdm
}

part_chain() {
  heading $1
  demo_on chain
  say "Yen has no cents, so the checkout should round yen to whole units. Nine files, each +2 -2, and the diff reads the same nine times."
  guess $1 chain "Which line changes what the checkout does?" "How many functions' contracts changed?" || return
  say "${k}chain${r}: one entry point, nine layers down, and every row has ${a}~${r}: its signature changed, because currency is threaded through all nine. That is why nine functions changed, and why they all look alike."
  look 1 "${k}L${r} opens the whole chain: eight rows of plumbing, then roundCents at the bottom, the only one with a line that does anything. ${k}b${r} turns the tree over and puts it first."
  look 2 "The preview of each plumbing row shows the ${a}~${r} is the new parameter and nothing else: skim them. Read roundCents."
  look 3 "What to ask for: currency on something the chain already carries, like the cart, so the next thing that needs threading through does not change nine signatures again."
  launch gdm
}

part_carry() {
  heading $1
  demo_on carry
  say "Money was a number. Now it is cents with a currency, so no amount is ever read in the wrong one. One file, fifteen lines: the smallest diff in the tour."
  guess $1 carry "Is a one-file change safe to approve quickly?" || return
  say "${k}carry${r}: four changed interfaces named in other changed signatures. Money is in LineItem's, Refund's and invoiceTotal's; LineItem in Invoice's; Invoice in Refund's. A type change travels through every signature that names it, and none of them stops it."
  say "Nor does the edge of the diff. The score measures what is in the change; what it breaks outside is the symbol view's callers row:"
  look 1 "${k}L${r}, and give tsgo a moment. Under Invoice, invoiceTotal and refundFor, a callers elsewhere row: revenue, refundedShare and invoiceLine, code the change never touched, each with ${b}✗${r}. None of their files is in the diff."
  (( $+commands[claude] )) &&
    look 2 "Sonnet proposes a fix under each ${b}✗${r}; ${k}F${r} makes it here, and tsgo checks it again."
  look 3 "What to ask for: those callers, in this MR. They are what breaks the build, and the one-file diff was never going to show them."
  (( $+commands[tsgo] && $+commands[node] )) ||
    say "${a}tsgo or node is not installed here, so there is no callers row.${r} brew install tsgo (and node) to see it."
  launch gdm
}

part_knot() {
  heading $1
  demo_on knot
  say "Heavily discounted orders become final sale: no refund. Two files, fifteen lines, and each reads fine: refundAmount asks isFinalSale, isFinalSale asks the discount."
  guess $1 knot "What happens when you call refundAmount?" || return
  say "${k}knots${r}: refundAmount asks isFinalSale, which asks discountRate, which works the discount out from refundAmount. It recurses until the stack runs out. ${k}chain${r} says 13+ for the same reason: a circle has no bottom."
  look 1 "The tree opens refundAmount to isFinalSale to discountRate and stops there: discountRate uses refundAmount, which is already above it. seam cut the circle at refundAmount, where the score says."
  look 2 "seam runs nothing. It flags a circle because a change that brings one is worth a look every time. By path, the two halves are in two files, and you have to hold both at once to see it."
  look 3 "What to ask for: the discount from the order's list price, not from the refund. Untangle it before anyone reviews the rest."
  launch gdm
}

