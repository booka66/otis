  say "${k}heaviest${r}: 300 changed lines in zoneRate. The tree is two rows, zoneRate and the new surcharge under it, and that is all symbols can do here: one definition is one row, however big."
  look 1 "The score is honest about it. Where the others said where to look, this one says the definition is the problem: a hundred cases each changed the same way, and nobody checks a hundred rates by eye."
  look 2 "What to ask for: the rates as data, a table the code reads, checked against the carrier's sheet; and the surcharge as its own small change, where it is five lines."
  launch gdm
}

part_gallery() {
  heading $1
  demo_reset
  say "All of them, as ${k}seam --score --brief${r} says them: one line each, for a footer or a comment on an MR."
  local b
  for b in restocking-fee sweep tangle chain carry knot heavy; do
    printf "    ${k}%-15s${r} " $b
    hang 20 "$(cd $repo && seam origin/main...tour/$b --score --brief)"
  done
  print
  say "By file, the line counts pointed the wrong way: the sixty-line sweep was the safest thing here, the fifteen-line carry broke the build, and the fifteen-line knot never returns. A file list says how big a change is. The symbol tree says what shape it is, and the shape is what the review costs."
  local kw=24
  key "s" "in any symbol view: the score of what you are reading"
  key "seam <range> --score" "a branch or range, from the command line"
  key "seam --mr 1234 --score" "any GitLab MR, through glab: worth a look before you say yes to a review"
  if mine; then
    print
    ask "Score the branch you are on, in $(cd $here && basename "$(git rev-parse --show-toplevel)")?" &&
      (cd $here && seam "$(otis-config base)...HEAD" --score)
  fi
}

part_mr() {
  heading $1
  say "A review in gmr is the symbol view with GitLab's threads laid over it. The loop:"
  key gmr "every MR: to review, yours, merged this week; ? names every glyph"
  key enter "review one, by symbol, each symbol with its open threads and drafts beside it and the threads under their lines in the preview. It opens in a shared review worktree, never your checkout"
  key f "by file and back: each file with its viewed mark, unresolved threads and waiting drafts"
  key c "comment without nvim: the file's diff as lines with the threads under them. c on a line comments (J marks several), c on a thread replies, r resolves; ctrl-e at the prompt takes it to your editor"
  key "then enter" "your editor at the line; nvim opens side by side against the MR's base, comments inline"
  print
  print -r -- "  ${m}in nvim${r}"
  key "<leader>mc" "comment on the line, or reply to its thread; a visual selection starts a new one"
  key "<leader>mr" "resolve or unresolve"
  key "<leader>me md" "edit or delete your comment"
  key "<leader>ml" "every thread in the quickfix list"
  key "<leader>mo" "threads on no line: overview, whole-file, outdated"
  key "]r [r" "next or previous file in the MR"
  key "<leader>ms" "submit your drafts"
  print
  print -r -- "  ${m}back in the picker${r}"
  key "] [" "the next or previous change in the preview, centered; in c's lines, the next or previous hunk"
  key v "mark a file viewed"
  key o "threads on no line, to reply or resolve"
  key n "only what changed since your last review"
  key u "catch up when the author pushes"
  key S "submit your drafts, optionally approving"
  key A "approve the commit you are looking at"
  key m "the commits view"
  print
  say "Comments are drafts until you submit them, as with GitLab's Start a review; on your own MR they go at once (${k}<leader>mt${r} switches). Enter on one of your own MRs in gmr opens its comments to address, where its branch is checked out."
  offer "Open gmr" gmr
}

part_claude_review() {
  heading $1
  say "${k}C${r} on an MR you are reviewing, in gmr or from inside the review, has Claude Code read it in the background and propose comments. Everything it writes is a draft of yours: nothing reaches GitLab until you submit."
  look 1 "It runs on its own. ${k}q${r} goes back to the picker while it works; ${k}C${r} again opens its view, every step it reads and says, following the newest. ${k}v${r} adds its thinking and what each tool returned, ${k}/${r} searches, ${k}x${r} stops it, ${k}r${r} runs it again."
  look 2 "It reads the change the way you do and knows what the symbol view already shows you: seam's symbols and what each newly uses, Haiku's gloss, tsgo's callers elsewhere with their errors, and Sonnet's fix under each. It adds to that rather than repeat it. It spends its time where the tree says a change can break things, a ${a}~${r} signature or a ${k}⇢${r} new mention, and most of all on the callers with no ${b}✗${r}, which nothing else checks. If tsgo has not found the callers yet, C asks whether to wait for them. Say ${k}y${r}: without them Claude has to hunt for callers with grep."
  look 3 "Its drafts sit on their symbols in the tree, ${y}✎${r} on the row, and are marked as Claude's in the preview, in nvim and in S's prompt. A comment about a caller the MR does not touch goes on the signature that breaks it, beside its callers row."
  look 4 "Under each draft, for you alone and never posted: first where its symbol sits (what happened to it, the entry point it is reached from, which callers break), then why Claude wrote it, where in the tree to look, and how sure it is. Edit or delete drafts in nvim, then ${k}S${r} posts what is left, under your name."
  look 5 "It cannot publish anything: it gets read-only file tools, no MCP servers and none of your settings, and answers in JSON. otis's one write is creating drafts, and if the MR moves while Claude reads, nothing is drafted."
  look 6 "With otis.remote and otis.claudeCommand set (the settings tour), it can run the checks you named, a type check or a test, in your workspace when a comment rests on one, and says what it ran. A hook blocks any other command."
  look 7 "Up to four run at once, each in a worktree of its own. Start one on every MR in your queue and read them as they land; the row in gmr shows each one's drafts waiting."
  say "${k}git config --global otis.lessons true${r} has every comment also name the principle behind it and teach it, with where to read more. Also for you alone."
  pause
}

part_claude_fix() {
  heading $1
  say "On your own MR, ${k}C${r} proposes fixes instead: for the unresolved threads that want a code change, and for anything it finds itself. ${k}C${r} in gb does the same for a branch with no MR yet."
  look 1 "It plans, then makes each change in a worktree of its own, never your checkout. Start one, leave, start another: gmr and gb show ${k}◌${r} while it works and ${k}✎N${r} when N fixes are waiting for you."
  look 2 "Enter shows the proposals, each a diff beside the thread it answers, with why. Take them one of three ways:"
  key space "accept it, or take it back; h keeps only some of its hunks"
  key F "fold what you accepted: checks each patch still applies, lints (otis.lintCommand), shows which of your commits each goes into, folds them in with one rebase, then offers to push and to reply \"Fixed in <commit>\" and resolve the threads"
  key "a A" "put one, or every accepted one, in your checkout uncommitted, when a proposal is a starting point"
  key B "every accepted one on a branch of its own off origin/main, one commit a fix, for what belongs in a separate MR"
  key d "discard one you do not want"
  key "l r" "Claude's run, or run it again"
  print
  say "Runs survive a closed laptop. Sleep pauses them; a run killed outright picks up where it left off the next time gmr or gb draws, keeping every fix it had already made."
  offer "Open gmr" gmr
}

part_verify_how() {
  heading $1
  say "${k}V${r} on an open MR in gmr, or a pushed branch in gb, finds out whether the change actually works by using it. Two agents, and the one that grades never does the work:"
  look 1 "The judge, Claude on your machine and read-only, reads the change and writes the few observable claims that would prove it works."
  look 2 "The tester, a Cursor Cloud agent in a VM with the repo's .cursor environment, starts the sandbox, uses the app in a real browser, records a video per claim, runs what needs running, and reports."
  look 3 "The judge looks at the evidence itself: screenshots, frames from the videos, command output. Then it sends the tester back with what is still unproven, or gives a verdict, pass, fail or inconclusive, claim by claim. Up to three rounds."
  look 4 "Every five minutes the judge looks in. A tester that is merely slow is left alone; one stuck on the same error, off doing what no claim needs, or about to give up on a claim it could check is interrupted with a note, and carries on in the same VM."
  look 5 "After the verdict, a fresh Claude looks the whole exchange over as an outside eye: what cost either agent time or a round, and what to change, in the repo's verify-env brief, the sandbox or the criteria."
  say "It takes 15 to 30 minutes, mostly the VM's boot and the sandbox's, billed by Cursor. Verifying again while the last VM is up sends it the new commit instead of booting another."
  pause
}

part_verify_run() {
  heading $1
  say "A verification's row in gmr or gb shows where it has got to, and then its verdict. Its view (${k}V${r} again, or enter in gag) works like Claude's other runs, plus the evidence:"
  key enter "the step under the cursor in full; G follows the newest"
  key "v l /" "more detail, all of it in less, search"
  key "x r c" "stop it (asks; the tester goes too), run it again, pick up a failed run"
  key o "the tester in Cursor"
  key a "the artifacts: recordings, screenshots, output; enter opens each"
  key h "the report in your browser: the verdict, the concerns, and each claim with the recordings that show it. One file, videos inside, so it can be sent on as it is"
  key p "after a confirm, upload the report to the MR and link it at the end of its description"
  key i "act on the retrospective: a fix run whose proposals edit the verify-env brief; B puts them on a branch of their own"
  print
  say "Nothing else is posted to GitLab. The tester is told not to commit or push; that is a prompt, not a guarantee."
  say "What the tester knows about your repo, how to run the environment, how to get into the app and where secrets come from, is the repo's .agents/skills/verify-env/SKILL.md. Whatever else the tester may use there, a real phone standing in for the customer among them, the brief is where it says so."
  pause
}

part_verify_setup() {
  heading $1
  say "What a verification needs, as it stands here:"
  if [[ -n $CURSOR_API_KEY ]]; then status ok CURSOR_API_KEY "exported"
  else status need CURSOR_API_KEY "export it in your shell: Cursor's dashboard, Integrations"; fi
  if (( $+commands[claude] )); then status ok claude "the judge"; else status need claude "Claude Code, which is the judge"; fi
  if (( $+commands[ffmpeg] )); then status ok ffmpeg "for the judge to see the videos"; else status need ffmpeg "brew install ffmpeg, for the judge to see the videos"; fi
  if mine; then
    local top=$(cd $here && git worktree list --porcelain | sed -n '1s/^worktree //p') v
    if [[ -e $top/.agents/skills/verify-env/SKILL.md || -e $top/.claude/skills/verify-env/SKILL.md ]]; then
      status ok verify-env "the repo's brief for the tester"
    else
      status note verify-env "no .agents/skills/verify-env/SKILL.md here, so the tester has only AGENTS.md or the README"
    fi
    for v in cursorEnv cursorModel checkInModel verifyCheckIn verifyRetro; do
      status note otis.$v "${$(cd $here && git config --get otis.$v):-not set}"
    done
  else
    status note "your repo" "run otis-tour from your repo to check its verify-env brief and settings"
  fi
  print
  say "The branch has to be pushed as it is. otis.cursorEnv runs the tester in a saved Cursor environment (a snapshot with the sandbox ready) rather than a plain checkout; otis.checkInModel sonnet makes the judge's look-ins cheaper."
  offer "Open gmr" gmr
}

part_ship_merge() {
  heading $1
  say "From gmr, an MR goes from open to merged without the browser. Each row leads with glyph columns that are never cut off: the pipeline, where review stands, unresolved threads, and what Claude has waiting. A pipeline failing only on approval gates shows as waiting, not broken."
  key c "CI jobs and logs: r retries a job, P plays a manual one, X cancels, ctrl-x cancels the pipeline"
  key "R N" "retry what failed, start a new pipeline"
  key v "the pipeline's stage graph; p opens it in the browser"
  key m "merge, or merge when the pipeline succeeds; with no pipeline yet (the next layer of a stack), starts one first"
  key r "have GitLab rebase it onto its target, after a confirm; on a glab stack, the whole stack"
  key d "draft or ready, on yours"
  key "A l a" "approve, labels, reviewers"
  key "s W" "switch to its branch, or open it in its own worktree"
  key "w y" "open it in the browser, copy its link"
  pause
}

part_ship_prod() {
  heading $1
  say "Merged is not shipped. gmr's merged section says for each of yours this week whether it is live in production, and its heading carries the last 40 deploys as one glyph each. ${k}enter${r} on a merged MR opens gd on the deploy that carried it."
  key gd "production deploys, newest first: when, how long, whether it went live, and the MRs it carried; a failed one's preview ends with its log. enter is its jobs"
  print
  say "${k}D${r} on one of your merged MRs has Claude watch production for it. It waits for the deploy, then checks Datadog ten minutes after and every ten minutes for 30 or 60 minutes by the change's risk, comparing with the hour before and with what else shipped in the same deploy."
  look 1 "The row says ${k}◌ watching prod${r}, then ${g}✓ prod: not this MR${r}, ${a}⚠ possibly${r} or ${b}✗ likely${r}, the moment a check finds something worrying."
  look 2 "The preview has the evidence, the reasoning and what to do. An alert comes the first time a check finds trouble, and again when the watch ends."
  look 3 "It only reads, through your Datadog MCP server's query tools, following the repo's watch-prod skill."
  say "Desktop alerts, in Ghostty, need no setup: a review requested of you, a mention, a comment or an approval on yours, your pipeline failing, your MR no longer mergeable or going live, and production rolled back."
  offer "Open gd" gd
}

part_dashboard() {
  heading $1
  say "${k}otis${r} is where a morning starts: everything that wants you, ordered by what a delay costs. The headline says how many; the one that wants you most sits in a card under it, with what enter does about it."
  look 1 "Production trouble first, a watch that found something. Then what is broken: a rollback, a failed verification, a pipeline. Then what a person is waiting on: threads on yours, a review asked of you. Then what Claude has left you, then what you can finish: a verdict in, one ready to merge, one nobody is reviewing."
  look 2 "One row a thing, never one a fact. An MR with a failed pipeline and three unresolved threads is one row, the pipeline, because that is what you would do next."
  look 3 "Under that, what is moving without you: Claude's runs, your pipelines, and your merged MRs production has not taken yet, each saying where it has got to. Last, the branch you are on: uncommitted, unpushed, behind."
  look 4 "${k}enter${r} does what the row says. ${k}m b d a w${r} open gmr, gb, gd, gag and gw, and q there comes back. ${k}D${r} discards otis's own note, never the MR's state. ${k}space${r} reads the row's preview in a pager, where the terminal is too narrow to show it beside the list. It reloads every 10 seconds."
  say "Nothing waiting is the point: a section with nothing in it is simply gone."
  key gag "everything Claude is doing or has done here in the background, reviews, fixes, watches and verifications, running ones first. enter is every step; d forgets a finished run"
  offer "Open otis" otis
}

part_commits() {
  heading $1
  demo_reset
  (cd $repo
    cat >> src/fees.ts <<'EOF'

// Orders over $500 never pay a restocking fee.
export function feeWaived(order: Order): boolean {
  return order.total > 500;
}
EOF
    git commit -qam "Waive the restocking fee on large orders"
    perl -pi -e 's|^export function daysSince|// Whole days, rounded down.\nexport function daysSince|; s/order.total > 500/order.total >= 500/' src/fees.ts)
  say "The demo branch now has two commits, and two uncommitted edits in src/fees.ts: a comment on daysSince, which belongs in the first commit, and >= in feeWaived, which belongs in the second. Put each where it belongs:"
  look 1 "${k}ga${r}, then ${k}space${r} on feeWaived only, and ${k}q${r}. ${k}gam${r} folds what is staged into the last commit (on a stack, it restacks the branches above)."
  look 2 "${k}ga${r} again, stage daysSince, ${k}q${r}. ${k}gfx${r} lists the branch's commits: pick \"Charge a restocking fee\". The edit goes into the commit that made daysSince, and the one above it is replayed on top."
  look 3 "${k}gl${r} is the log: ${k}r${r} rewords a commit, ${k}f${r} folds what is staged into the one under the cursor. Try a subject like \"feat: stuff\" to meet the message rules: no type prefix, 72 characters, no em dash."
  look 4 "${k}gundo${r} lists every state HEAD has been in. Pick one from before the folds and it is all taken back."
  look 5 "${k}gwip${r} sets everything aside as a commit, not a stash, which every worktree shares; ${k}gunwip${r} brings it back."
  say "Also: ${k}gcm${r} commits in your editor with the diff below, ${k}gcp \"subject\"${r} stages, commits and pushes, ${k}gdd${r} discards (asks first), ${k}gpark${r} stashes a selection instead, ${k}gp${r} pushes, refusing to overwrite commits you have not seen."
  shell
  demo_reset
}

part_branches_gb() {
  heading $1
  demo_reset
  (cd $repo
    git branch -qf tour/old-idea main
    git switch -qC tour/receipt-copy main
    perl -pi -e 's/Refund: /Your refund: /' src/email.ts
    git commit -qam "Say whose refund it is"
    git switch -q tour/restocking-fee)
  say "${k}gb${r} lists branches laid out as gmr is, main first. The demo has three besides main: the restocking fee, a receipt tweak, and tour/old-idea, which you are done with."
  look 1 "Each row: whether Claude is working there or has fixes waiting, the MR's state (none here, with no GitLab), how far it has drifted from origin/main, then the name, its prefix dimmed. ${k}?${r} names every glyph."
  look 2 "${k}enter${r} switches to it; a branch checked out in a worktree takes you there instead. ${k}c${r} is its commits in gl. ${k}W${r} opens it in a worktree of its own."
  look 3 "${k}d${r} on tour/old-idea deletes it, or every branch marked with ${k}space${r}, leaving anything checked out. In your repo ${k}M${r} marks the ones safe to delete: their MR merged or closed, with nothing committed since."
  look 4 "In your repo: ${k}n${r} opens an MR for it, ${k}C${r} has Claude propose fixes before there is one, ${k}V${r} verifies it in Cursor Cloud, pushing it first if origin is behind."
  launch gb
}

part_branches_more() {
  heading $1
  demo_reset
  say "A worktree is a second checkout of the same repo, for what runs beside yours: a review, Claude's runs, a branch you are waiting on. otis keeps its own under .claude/worktrees."
  key "gwn <name>" "a new branch, <prefix>/<name> off origin/main, in a worktree of its own, and takes you there"
  key gw "worktrees and what each holds: enter goes there, d removes (to the Trash, ignored files and all), M marks the safe ones"
  key "gbn <name>" "a new branch here"
  key gup "rebase onto a fresh origin/main, and print how to undo it"
  key grb "interactive rebase from a commit you pick"
  key gstack "the branch's commits as a glab stack: one branch and MR a commit, pushed bottom first, synced"
  print
  say "Worktrees on merged or closed branches go by themselves once an hour, unless a shell has been in one in the last half hour or anything there is uncommitted, and each sends an alert with the line that brings it back."
  [[ -n $(git config --get otis.branchPrefix) ]] ||
    say "${a}gwn and gbn need a branch prefix:${r} git config --global otis.branchPrefix <your name>."
  say "Try ${k}gwn receipts${r} then ${k}gw${r} in the demo. gw and gwn change your shell's directory only where otis is sourced in it, as otis-setup does."
  shell
  demo_reset
}

part_settings() {
  heading $1
  local v src=$here
  mine || src=$HOME
  say "The settings that change the most, and what each is set to $( [[ $src == $here ]] && print "in $(basename $(cd $here && git rev-parse --show-toplevel))" || print "globally"):"
  setting() {
    v=$(cd $src && git config --get-all otis.$1 2>/dev/null | paste -sd, -)
    [[ -n $v ]] && v=$g$v$r || v="${m}not set${r}"
    printf "    ${k}%-18s${r} %s\n" otis.$1 "$v"
    printf "    %-18s " ""; hang 23 "$2"
  }
  setting remote "an ssh host (a Coder workspace) where heavy commands run, with otis.remotePath its checkout; git-remote-run sends your checkout there as it stands and brings back what changed"
  setting claudeCommand "what Claude may run there, one prefix each (bazel test), targets named outright or with :all, never a glob. Without it Claude's runs have no shell at all"
  setting lintCommand "lint run before F folds Claude's fixes in"
  setting lessons "true: each of Claude's comments and fixes also teaches the principle behind it, for you alone"
  setting editor "what opens files from the pickers: cursor, code, zed, nvim"
  setting theme "otis-theme shows each theme on otis's own rows and keeps the one you pick"
  setting sideBySide "always, or auto from 120 columns: diffs side by side"
  setting branchPrefix "the <prefix>/ that gbn and gwn put on a branch"
  print
  say "${k}otis-setup --check${r} says what is installed and what is missing, and which optional features are set up in the repo you run it in."
  ask "Pick a theme now?" && otis-theme
  pause
}

part_cheatsheet() {
  heading $1
  local kw=14
  print -r -- "  ${m}anywhere${r}"
  key "j k / esc q" "move, search, stop searching, quit"
  key "?" "every key this picker has, and what its glyphs mean"
  key "otis gg" "the dashboard; every command"
  print
  print -r -- "  ${m}by symbol${r}   gdm, ga, enter in gl, an MR in gmr"
  key "l h L H" "open, close, open all, close all"
  key "~ ⇢ ✗" "signature changed; a new mention; a caller it breaks"
  key "i b s t" "what it uses; bottom up; the shape; hide tests"
  key "F f enter" "Claude's fix for a broken caller; by file; nvim"
  key "space c" "in ga: stage one symbol, commit"
  print
  print -r -- "  ${m}gmr${r}"
  key "enter" "review, or address comments on yours"
  key "c" "in a review: comment on lines, reply, resolve, no nvim"
  key "v o n u" "viewed, threads on no line, since last review, catch up"
  key "S A" "submit drafts, approve"
  key "C" "Claude drafts comments, or proposes fixes on yours"
  key "V D" "verify in Cursor Cloud; watch production (merged)"
  key "c m r" "CI jobs, merge, rebase"
  key "<leader>m…" "in nvim: c comment, r resolve, l list, s submit"
  print
  print -r -- "  ${m}fixes${r}      enter on a fix run"
  key "space h" "accept, keep some hunks"
  key "F a B d" "fold in, apply uncommitted, own branch, discard"
  print
  print -r -- "  ${m}history${r}"
  key "gam gfx" "fold staged into the last commit, into an earlier one"
  key "gundo gwip" "undo from the reflog; set work aside"
}

# --- run

# run <tour> [part]: a tour in a subshell of its own, so q anywhere in it
# comes back to the menu.
run() {
  (
    cur_tour=$1 cur=(${=tparts[$1]})
    integer i from=1
    [[ -n $2 ]] && from=${cur[(i)$2]}
    for (( i = from; i <= $#cur; i++ )); do part_${cur[$i]} $i; done
    [[ $#cur -gt 1 || $1 == cheatsheet ]] && pause "back to the menu"
  )
  mkdir -p ${seen:h} && { grep -qxF $1 $seen 2>/dev/null || print $1 >> $seen; }
}

menu() {
  local sel t rows
  while :; do
    theme
    rows=
    for t in $tours; do
      rows+="$(grep -qxF $t $seen 2>/dev/null && print "${g}✓${r}" || print " ") ${ttitle[$t]}${(l:$(( 46 - ${#ttitle[$t]} )):: :)}${m}${tkind[$t]}${r}"$'\t'"$t"$'\n'
    done
    sel=$(print -rn -- $rows | git-fzf 'tour ' 'enter=take this tour' --ansi --no-sort \
      --delimiter=$'\t' --with-nth=1 --preview 'otis-tour --about {2}' --preview-window 'right,45%,wrap') || return
    [[ -n $sel ]] || return
    run ${sel##*$'\t'}
  done
}

case $1 in
  --about)
    [[ -n ${ttitle[$2]} ]] || exit 0
    print -r -- "${a}${ttitle[$2]}${r}"
    print -r -- "${m}${tkind[$2]}${r}"
    print
    wrap $(( ${FZF_PREVIEW_COLUMNS:-80} - 2 )) 0 "${tabout[$2]}"
    ps=(${=tparts[$2]})
    if (( $#ps > 1 )); then
      print
      for t in $ps; do print -r -- "  ${m}·${r} ${ptitle[$t]}"; done
    fi
    exit 0 ;;
  --list)
    for t in $tours; do
      printf "  ${k}%-11s${r} %s\n" $t "${ttitle[$t]}"
      ps=(${=tparts[$t]})
      (( $#ps > 1 )) && for p in $ps; do printf "      ${m}%-14s${r} %s\n" $p "${ptitle[$p]}"; done
    done
    exit 0 ;;
esac

missing=()
for c in git fzf delta ast-grep seam; do (( $+commands[$c] )) || missing+=($c); done
if (( $#missing )); then
  print -u2 "otis-tour needs ${(j:, :)missing}. otis-setup offers to install them; seam is brew install booka66/seam/seam."
  exit 1
fi
trap 'rm -f $tour/built.$$' EXIT

if [[ -n $1 ]]; then
  if [[ -n ${ttitle[$1]} ]]; then run $1
  else
    for t in $tours; do
      ps=(${=tparts[$t]})
      (( $ps[(Ie)$1] )) && { run $t $1; exit 0; }
    done
    print -u2 "otis-tour: no tour or part called $1 (otis-tour --list)"; exit 2
  fi
  exit 0
fi
menu
