#!/bin/sh
# otis-test [area...]: run otis's tests, every area in test/ at once, or the
# ones named and the areas named after them (otis-test symbols runs symbols
# and symbols-cases). An area runs scripts or shared functions on a throwaway
# repo of its own and compares what comes out; a failure prints what was
# expected and what came out, under its area, as soon as that area ends. No
# real repo is touched and no GitLab is asked. Exit 1 if anything failed.
root=$(cd "$(dirname "$0")/.." && pwd)
all=$(cd "$root/test" && ls *.sh | sed -n 's/\.sh$//p' | grep -vx lib)
[ $# -gt 0 ] || set -- $all
areas=
for a; do
  these=$(printf '%s\n' $all | grep -e "^$a\$" -e "^$a-")
  [ -n "$these" ] || { printf 'otis-test: no area %s; there are %s\n' "$a" "$(echo $all)" >&2; exit 2; }
  areas="$areas $these"
done
out=$(mktemp -d) && trap 'rm -rf "$out"' EXIT
start=$(date +%s)
for a in $(printf '%s\n' $areas | awk '!seen[$0]++'); do
  (
    s=$(date +%s)
    sh "$root/test/$a.sh" > "$out/$a" 2>&1
    t=$(( $(date +%s) - s ))
    # An area's count is its last line (test/lib.sh); one that has none was
    # killed before it could say.
    count=$(tail -1 "$out/$a")
    case $count in
      *' passed, '*' failed') said=$(sed '$d' "$out/$a") ;;
      *) count='0 passed, 1 failed' said="$(cat "$out/$a")
FAIL $a ended before its count" ;;
    esac
    # In one write, so areas ending together do not interleave.
    [ -n "$said" ] && { printf '── %s\n%s\n' "$a" "$said" > "$out/$a.said"; cat "$out/$a.said"; }
    printf '%s\t%s\t%s\n' "$a" "$t" "$count" > "$out/$a.count"
  ) &
done
wait
cat "$out"/*.count | awk -F'\t' -v wall=$(( $(date +%s) - start )) '
  { split($3, n, " "); p += n[1]; f += n[3]; if (NR == 1 || $2 > slow) { slow = $2; who = $1 } }
  END { printf "\n%d passed, %d failed in %ds (slowest: %s, %ds)\n", p, f, wall, who, slow; exit f > 0 }'
