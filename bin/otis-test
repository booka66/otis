expect forge/draft-into-review "$(sed 1d "$tmp/gh.posted" | jq -c '.variables.input | [.pullRequestReviewId, .path, .line, .side]')" '["PRR_9","f.ts",1,"LEFT"]'
rm -f "$tmp/gh.posted"
PATH=$ghp git-forge api -X PUT "projects/:fullpath/merge_requests/5/discussions/PRRT_1?resolved=true" >/dev/null
expect forge/resolve "$(grep -c 'resolveReviewThread.*t=PRRT_1' "$tmp/gh.posted")" "1"
expect forge/head-ref "$(git-forge head-ref 5)" "refs/pull/5/head"
expect forge/mr-url "$(git-mr-url 5)" "https://github.com/o/r/pull/5"
expect forge/lacks "$(git-forge can stack; echo $?)" "1"
expect forge/says-what-it-lacks "$(PATH=$ghp git-forge api -X POST 'projects/:fullpath/merge_requests/5/pipelines' 2>&1; echo $?)" "not on GitHub: POST projects/:fullpath/merge_requests/5/pipelines
1"
# CI: a pipeline is the head commit's checks, a job a check run.
expect forge/jobs "$(PATH=$ghp git-mr-pages "projects/:fullpath/pipelines/900/jobs?per_page=100" | jq -c 'map([.id, .name, .status, .duration])')" \
  '[[11,"test","failed",300],[12,"lint","running",null]]'
# The REST MR says why it cannot merge in GitLab's words, and merging it sends
# the head you read.
expect forge/merge-status "$(PATH=$ghp git-forge api "projects/:fullpath/merge_requests/5" | jq -r .detailed_merge_status)" "need_rebase"
rm -f "$tmp/gh.posted"
expect forge/merge "$(PATH=$ghp git-forge api -X PUT "projects/:fullpath/merge_requests/5/merge?sha=$h" | jq -r .state)" "merged"
expect forge/merge-sent "$(sed 1d "$tmp/gh.posted" | jq -c '[.sha == "'$h'", .merge_method]')" '[true,"merge"]'
rm -f "$tmp/gh.posted"
PATH=$ghp git-forge api -X PUT "projects/:fullpath/merge_requests/5" -f "labels=bug,ready" >/dev/null
expect forge/labels "$(head -1 "$tmp/gh.posted"; sed 1d "$tmp/gh.posted" | jq -c .labels)" "api -X PUT repos/o/r/issues/5/labels --input -
[\"bug\",\"ready\"]"
rm -f "$tmp/gh.posted"
PATH=$ghp git-forge mr-update 5 --ready --label ready
expect forge/mr-update "$(cat "$tmp/gh.posted")" "pr ready 5 -R o/r
pr edit 5 -R o/r --add-label ready"
expect forge/lacks-all "$(git-forge lacks)" "stack run-pipeline stage-graph upload"
# The board lists the pull request as yours, from the same JSON (otis-list,
# then otis-board). The prefetch is held off (its lock taken), so nothing is
# left running behind the test. The rows never wait for the forge, not even
# the first time in a repo: the first list is what is here alone, the forge
# asked behind it, and the list made again once it has answered has the
# pull request.
gst=$tmp/forge-state && mkdir -p "$gst" "$(git rev-parse --git-common-dir)/gmr-prefetch.lock"
PATH=$ghp GIT_FZF_STATE=$gst otis-list > "$gst/rows"
expect forge/board-first-is-local "$(PATH=$ghp GIT_FZF_STATE=$gst otis-board | awk -F'\t' '$18 == "mine" { print $9, $12 }')" ""
for _ in $(seq 1 40); do [ -s "$(git rev-parse --git-common-dir)/git-alias-cache/ci-mine.json" ] && break; sleep 0.25; done
expect forge/board-row "$(PATH=$ghp GIT_FZF_STATE=$gst otis-list > "$gst/rows"; PATH=$ghp GIT_FZF_STATE=$gst otis-board | awk -F'\t' '$18 == "mine" { print $9, $12 }')" "5 feat"
cd "$here"

# --- git-walk --settle: a walk goes on while its MR is still yours to decide.
# Someone else's you approved, and any that merged, are stopped, saying why;
# one you review and have not approved, one of yours others approved, and a
# branch's walk go on. The board's lists say it for open MRs; GitLab, a
# stub, is asked about the rest, once. Each walk is a run that ends as a
# walk does when it sees it is stopping (share/claude-run.sh).
here=$PWD ws=$tmp/settle
mkdir -p "$ws/stub" && git init -q "$ws/repo" && cd "$ws/repo" && git remote add origin git@gitlab.com:t/t.git
wr=$(git rev-parse --path-format=absolute --git-common-dir)/otis-walk
cat > "$ws/stub/glab" <<'STUB'
#!/bin/sh
echo "$2" >> "$WS/asked"
case $2 in
  */merge_requests/14) echo '{"state":"merged","author":{"username":"ann"}}' ;;
  */merge_requests/15) echo '{"state":"merged","author":{"username":"me"}}' ;;
  */merge_requests/1[67]) echo '{"state":"opened","author":{"username":"ann"}}' ;;
  */merge_requests/16/approvals) echo '{"approved_by":[{"user":{"username":"bob"}}]}' ;;
  */merge_requests/17/approvals) echo '{"approved_by":[{"user":{"username":"me"}}]}' ;;
esac
STUB
cat > "$ws/run" <<RUN
#!/bin/sh
d=\$1
finish() { echo "\$1" > "\$d/status"; echo "\$2" > "\$d/said"; exit 0; }
. "$share/claude-run.sh"
while :; do stopping; sleep 0.1; done
RUN
chmod +x "$ws/stub/glab" "$ws/run"
echo '{"data":{"currentUser":{"username":"me","reviewRequestedMergeRequests":{"nodes":[
  {"iid":"11","author":{"username":"ann"},"approvedBy":{"nodes":[{"username":"me"}]}},
  {"iid":"12","author":{"username":"ann"},"approvedBy":{"nodes":[{"username":"bob"}]}}]}}}}' > "$ws/review.json"
echo '{"data":{"currentUser":{"username":"me","authoredMergeRequests":{"nodes":[{"iid":"13","approved":true}]}}}}' > "$ws/mine.json"
for k in 11 12 13 14 15 16 17 b-x; do
  mkdir -p "$wr/$k"
  case $k in b-*) ;; *) echo "$k" > "$wr/$k/iid" ;; esac
  "$ws/run" "$wr/$k" 2>/dev/null & echo $! > "$wr/$k/pid"
done
settle() { PATH=$ws/stub:$PATH WS=$ws git-walk --settle "$ws/review.json" "$ws/mine.json"; }
settle
for _ in $(seq 1 40); do [ -s "$wr/11/said" ] && [ -s "$wr/14/said" ] && [ -s "$wr/15/said" ] && [ -s "$wr/17/said" ] && break; sleep 0.1; done
ended() { for k in "$@"; do printf '%s %s|' "$k" "$(cat "$wr/$k/said" 2>/dev/null || { kill -0 "$(cat "$wr/$k/pid")" && echo going; })"; done; }
expect settle/approved-review-stopped "$(ended 11)" "11 stopped: you approved !11|"
expect settle/merged-stopped "$(ended 14 15)" "14 stopped: !14 merged|15 stopped: !15 merged|"
expect settle/still-to-decide-goes-on "$(ended 12 13 16 b-x)" "12 going|13 going|16 going|b-x going|"
expect settle/unlisted-approved-stopped "$(ended 17)" "17 stopped: you approved !17|"
settle
expect settle/asks-once "$(grep -c 'merge_requests/16$' "$ws/asked")" "1"
# x leaves no word of its own: the run says stopped.
touch "$wr/12/stopping"
for _ in $(seq 1 40); do [ -s "$wr/12/said" ] && break; sleep 0.1; done
expect settle/x-says-stopped "$(ended 12)" "12 stopped|"
for k in 11 12 13 14 15 16 17 b-x; do kill "$(cat "$wr/$k/pid")" 2>/dev/null; wait "$(cat "$wr/$k/pid")" 2>/dev/null; done
cd "$here"

# --- git-symbols-past: where the changed code broke before, from git alone.
# A change, a fix to its lines five days on (laid at it), a fix that only
# adds (laid at no one) and a fix of the types (not a fix of what it does).
ps=$tmp/past && git init -q "$ps" && (
  cd "$ps" && git config user.email t@t && git config user.name t
  at() { d=$(( $(date +%s) - $1 * 86400 )); export GIT_AUTHOR_DATE="@$d" GIT_COMMITTER_DATE="@$d"; }
  printf 'export function send() {\n  const a = 1;\n  return a;\n}\n' > s.ts; at 200; git add s.ts; git commit -qm "Add send"
  sed -i.b 's/const a = 1/const a = retry(1)/' s.ts; at 100; git commit -qam "Retry the send"
  sed -i.b 's/retry(1)/retry(1, once)/' s.ts; at 95; git commit -qam "fix: the retry sent twice"
  sed -i.b 's/  return a;/  log(a);\n  return a;/' s.ts; at 50; git commit -qam "Fix the missing log"
  sed -i.b 's/once)/once as N)/' s.ts; at 40; git commit -qam "fix types"
  rm -f s.ts.b
  printf 's.ts\tfn\tsend\t\t1\tbody\tnew\t1\t5\t1\t1\t1\t\t1\t5\n' > t.tsv
  node "$share/past.mjs" "$(git rev-parse HEAD)" t.tsv
) > "$tmp/past.out" 2>&1
expect past/fixes "$(cut -f1-3 "$tmp/past.out")" "s.ts#send	5	2"
expect past/laid "$(cut -f4 "$tmp/past.out" | tr '\036\037' '\n|' | cut -d'|' -f3,6,7)" "Fix the missing log
fix: the retry sent twice|Retry the send|5"

# --- completion: one list of candidates for all three shells
expect complete/refs "$(otis-complete gl | grep -cx main)" "1"
expect complete/paths "$(otis-complete ga | sed -n 1p)" "@files"
expect complete/no-paths-for-a-ref "$(otis-complete gl | grep -c '@files')" "0"
expect complete/help-everywhere "$(otis-complete gp)" "--help"
expect complete/settings "$(otis-complete otis-config | grep -cx deployJob)" "1"
expect complete/settings-tb "$(otis-complete otis-config | grep -cx terminalBrowser)" "1"
expect complete/themes "$(otis-complete otis-theme | grep -cx gruvbox)" "1"
expect complete/unknown "$(otis-complete nope)" ""

# --- the theme is loaded once, by the shell, and a run asking for another one
# notices by comparing two strings rather than starting anything
expect theme/want-carries-the-override "$(OTIS_THEME=nord otis-theme --env | grep WANT)" "export OTIS_T_WANT='nord'"
expect theme/inherited-is-kept "$( (eval "$(otis-theme --env gruvbox)"; sh -c '. "$0/palette.sh"; printf %s "$OTIS_T_NAME"' "$share") )" "gruvbox"
expect theme/override-wins "$( (eval "$(otis-theme --env gruvbox)"; OTIS_THEME=nord sh -c '. "$0/palette.sh"; printf %s "$OTIS_T_NAME"' "$share") )" "nord"
expect theme/fish-syntax "$(otis-theme --env-fish gruvbox | grep NAME)" "set -gx OTIS_T_NAME 'gruvbox'"


printf '\n%s passed, %s failed\n' "$passed" "$failed"
[ "$failed" -eq 0 ]
