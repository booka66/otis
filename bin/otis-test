# A setting of a few values is picked, not typed.
if picker_open "otis-config --prompt local agent"; then
  expect config/choices "$(picker_rows)" "3"
  picker_key j; picker_key "$(printf '\r')"
  exec 7>&-; wait "$driver" 2>/dev/null
