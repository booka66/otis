  {"id":"PRRT_1","isResolved":false,"isOutdated":false,"path":"f.ts","subjectType":"LINE","diffSide":"RIGHT","startDiffSide":null,"line":1,"startLine":null,"originalLine":1,"originalStartLine":null,
