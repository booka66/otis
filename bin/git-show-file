#!/bin/sh
# git-show-file <rev>:<path> <path> [line]: a file as a commit (or the index,
# ":path") had it, in your editor, read only and unmodifiable, at <line>. For a
# deleted file, which has nothing in the working tree to open: enter on one in
# ga (git-file-open) and in a commit's or a branch's file picker
# (git-commit-open). In nvim the buffer is named after the path, so it is
# colored as the file it was, and nothing is written anywhere.
spec=$1 p=$2 line=${3:-1}
[ -n "$spec" ] && [ -n "$p" ] || exit 2
git cat-file -e "$spec" 2>/dev/null || { printf '%s has no %s. press enter\n' "${spec%%:*}" "$p"; read -r _; exit 0; }
name=$(otis-edit --name)
case $name in
  nvim|vim|vi) git show "$spec" | exec "$name" -M -R "+$line" -c "silent file $p" -c 'filetype detect' - ;;
esac
# Any other editor opens files, not stdin: a read-only copy under $TMPDIR, by
# its blob so a second look reuses it, named as the file so it is colored
# as one.
blob=$(git rev-parse "$spec") || exit 1
f=${TMPDIR:-/tmp}/otis-show/$blob/$p
if [ ! -e "$f" ]; then
  mkdir -p "$(dirname "$f")" && git show "$spec" > "$f" && chmod a-w "$f" || exit 1
fi
exec otis-edit -R "+$line" -- "$f"
