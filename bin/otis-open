#!/bin/sh
# otis-open <url>: open a link in the browser, on macOS (open) or Linux
# (xdg-open), for the pickers' w and p keys.
[ -n "$1" ] || exit 0
if command -v open >/dev/null 2>&1 && [ "$(uname)" = Darwin ]; then
  exec open "$1"
elif command -v xdg-open >/dev/null 2>&1; then
  exec xdg-open "$1" >/dev/null 2>&1
fi
printf '%s\n' "$1"
