#!/bin/sh
# git-claude-worktree take <fix | review> <run dir> <commit>   a worktree for the run, at <commit>
# git-claude-worktree release <path>                          give it back
# git-claude-worktree trim                                    delete the slots no run took for a week
#
# Each of Claude's runs gets a worktree of its own for as long as it runs,
# from a pool under the main checkout: claude-fix, claude-fix-2, ... for fix
# runs (git-mr-fix) and claude-review, claude-review-2, ... for reviews
# (git-mr-claude). One is made the first time it is needed and kept after,
# since moving a worktree to a commit rewrites only the files that differ,
# where a fresh checkout of a big repo takes a minute. So runs go in parallel,
# each in its own, and the pool never grows past what has run at once, up to
# four of a kind: a fifth run is told to wait. A slot is held by a lock naming
# its run; a lock whose run is over, or gone, was left by a crash and is taken
# over, and a lock naming the run that is asking is that run's own, from
# before it was killed.
#
# take prints the worktree's path, clean and detached at <commit>, or says
# why not on stderr and exits 1. release frees the slot; the worktree stays.
# trim deletes the worktree of each slot no run has taken for a week, and
# says which went, so the pool shrinks back to what runs use rather than
# staying the size of its busiest hour (git-worktree-sweep runs it hourly).
share=$(cd "$(dirname "$0")/../share" && pwd)
. "$share/claude-run.sh"
slots=$(git rev-parse --path-format=absolute --git-common-dir)/otis-claude-slots

# claim <name> <run>: the slot's lock, for <run>, when it is free, when it is
# <run>'s own already, or when the run that left it is over or gone. A lock
# naming no run yet is a take this very moment, unless it is old.
claim() {
  mkdir "$slots/$1" 2>/dev/null && return 0
  other=$(cat "$slots/$1/run" 2>/dev/null)
  # Its own it simply takes: only one process is ever alive for a run (r
  # and c in git-claude-view both refuse while it is going, and resume
  # starts only an orphan), so there is no one to take it from.
  [ "$other" = "$2" ] && return 0
  [ -n "$other" ] && running "$other" && return 1
  [ -z "$other" ] && [ -z "$(find "$slots/$1" -maxdepth 0 -mmin +1 2>/dev/null)" ] && return 1
  rm -rf "$slots/$1"
  mkdir "$slots/$1" 2>/dev/null
}

case $1 in
  take)
    kind=$2 run=$3 commit=$4
    mkdir -p "$slots"
    # The pool in the order to try it. A lock naming the run that is asking is
    # that run's own, held since before it was killed, so it goes first: a run
    # picking up takes back the slot it already has, wherever in the pool that
    # is, rather than a second one. Without this a run killed four times holds
    # the whole pool and its fifth life is turned away by its own corpses.
    n=1 names=
    while [ "$n" -le 4 ]; do
      name=claude-$kind
      [ "$n" -gt 1 ] && name=$name-$n
      n=$((n + 1))
      if [ "$(cat "$slots/$name/run" 2>/dev/null)" = "$run" ]; then names="$name $names"; else names="$names $name"; fi
    done
    for name in $names; do
      claim "$name" "$run" || continue
      lock=$slots/$name
      printf '%s\n' "$run" > "$lock/run"
      # When a run last took it, which trim goes by.
      touch "$slots/$name.used"
      wt=$(git-worktree-path named "$name")
      if [ ! -e "$wt" ]; then
        out=$(git-worktree-add "$name" --quiet --detach "$commit" 2>&1) ||
          { rm -rf "$lock"; printf 'could not create %s: %s\n' "$wt" "$(oneline "$out")" >&2; exit 1; }
      else
        git worktree list --porcelain | grep -qxF "worktree $wt" ||
          { rm -rf "$lock"; printf '%s exists but is not a git worktree, so it was left alone\n' "$wt" >&2; exit 1; }
        # Only Claude writes there; what an earlier run left goes.
        out=$({ git -C "$wt" reset -q --hard && git -C "$wt" clean -fdq && git -C "$wt" switch --quiet --detach "$commit"; } 2>&1) ||
          { rm -rf "$lock"; printf 'could not move %s to %.8s: %s\n' "$wt" "$commit" "$(oneline "$out")" >&2; exit 1; }
      fi
      printf '%s\n' "$wt"
      exit 0
    done
    printf 'four %s runs are going already; wait for one to finish\n' "$kind" >&2
    exit 1 ;;
  release)
    rm -rf "$slots/${2##*/}" ;;
  trim)
    mkdir -p "$slots"
    # The worktree is moved aside under the slot's lock, which takes a moment,
    # and deleted once the lock is let go, which takes a while: a take waits
    # out a lock naming no run for a minute only. One a trim was stopped in
    # the middle of is deleted by the next.
    for gone in "$slots"/.gone-*; do
      [ -e "$gone" ] && git worktree remove --force "$gone" 2>/dev/null
    done
    for kind in fix review; do
      n=0
      while [ "$n" -lt 4 ]; do
        n=$((n + 1))
        name=claude-$kind
        [ "$n" -gt 1 ] && name=$name-$n
        wt=$(git-worktree-path named "$name")
        [ -d "$wt" ] || continue
        # A slot from before takes left this has its week from now.
        [ -e "$slots/$name.used" ] || { touch "$slots/$name.used"; continue; }
        [ -n "$(find "$slots/$name.used" -mmin +10080)" ] || continue
        claim "$name" trim || continue
        if git worktree move "$wt" "$slots/.gone-$name" 2>/dev/null; then
          rm -f "$slots/$name.used"
          rm -rf "$slots/$name"
          git worktree remove --force "$slots/.gone-$name" 2>/dev/null
          printf "%s, Claude's, which no run took for a week\n" "$name"
        else
          rm -rf "$slots/$name"
        fi
      done
    done ;;
  *)
    echo 'usage: git-claude-worktree take <fix | review> <run dir> <commit> | release <path> | trim' >&2; exit 2 ;;
esac
