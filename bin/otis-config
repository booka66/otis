#!/bin/sh
# otis-config <key>: one setting, from git config otis.<key> where there is
# one, else from the repo's own .otis, else worked out from the repo. Every
# script asks here, so the GitLab host, the project, the default branch and
# the deploy jobs are decided in one place, and another project changes them
# with git config alone.
#
#   host         the GitLab host: otis.host, else the origin remote's host, else gitlab.com
#   url          https://<host>
#   project      the project's path on GitLab (group/repo): otis.project, else the origin remote's path
#   main         the default branch's name: otis.mainBranch, else what origin/HEAD names, else main
#   base         what a branch is measured against: origin/<main> if it exists, else <main>, else HEAD
#   gateJobs     JSON list of CI jobs that are approval gates rather than checks of the code,
#                so a pipeline failing only on them is waiting, not broken: every otis.gateJob
#   deployEnv    the GitLab environment production deploys go to: otis.deployEnv
#   deployJob    the job that deploys it: otis.deployJob
#   rollbackJob  the job that rolls it back: otis.rollbackJob
#   datadogEnv   the env tag production carries in Datadog: otis.datadogEnv
#   readyLabel   the label an MR gets when gmr's d marks it ready, and loses when d makes it a draft
#                again: otis.readyLabel, else ready-for-ci; git config otis.readyLabel "" for none
#   cursorEnv    the Cursor Cloud environment V's tester runs in, by its dashboard name: otis.cursorEnv, else the repo's own
#   verifyRetro  exit 0 when a verification ends with a retrospective by a fresh Claude on what slowed
#                either agent and what to change (git config otis.verifyRetro false turns it off); on by default
#   checkInModel  the model the judge's looks in run on (a claude --model value, e.g. sonnet), for cost: otis.checkInModel, else the judge's own
#   verifyCheckIn  minutes between the judge's looks at what V's tester is doing, 0 for never: otis.verifyCheckIn, else 5
#   cursorModel  the model V's Cursor Cloud tester runs, an id from Cursor's GET /v1/models with its parameters after a colon
#                (gpt-5.6-luna:reasoning=high): otis.cursorModel, else Cursor's default
#   claudeCommands  the commands Claude may run through git-remote-run in a review or fix run, one a line,
#                each a prefix ('bazel test' allows bazel test //x:y): every otis.claudeCommand; none means no shell
#   worktrees    where otis puts its worktrees, under the main checkout: otis.worktrees
#   editor       what opens a file (otis-edit): $OTIS_EDITOR, else otis.editor, else nvim
#   lessons      exit 0 when Claude's review comments and fixes should each come with a lesson on the
#                principle behind it, for you alone (git config --global otis.lessons true); off by default
#   gitlab       exit 0 when origin is on GitLab: its host is <host>, or has gitlab in its name (ends the run, so ask it alone)
#
# No key opens every one in a picker, with its value and where that came
# from: the git config scope that set it (local, global), $OTIS_EDITOR, or
# default for one worked out or left unset; there it is set and unset.
#
# Several keys at once print one value a line, in the order asked, which is one
# process where a list script used to spend five: otis-config project url base.
# Only keys that answer with a value; gitlab, lessons and verifyRetro answer
# with an exit status, so they are asked on their own.
#
# A team keeps what is true of its repo for everyone (its CI's gate and deploy
# jobs, its Datadog env, its Cursor environment) in .otis at the
# repo's top, in git config's format, committed:
#
#   [otis]
#     gateJob = approval-check
#     deployJob = deploy-production
#
# Your own git config wins over it. Only the settings named in shared() are
# read from it: a repo you clone must not be able to choose the commands
# Claude may run (claudeCommand), your editor, or where worktrees go.
names='host project mainBranch gateJob deployEnv deployJob rollbackJob datadogEnv readyLabel cursorEnv cursorModel verifyCheckIn checkInModel verifyRetro claudeCommand worktrees editor lessons'
sharednames='host project mainBranch gateJob deployEnv deployJob rollbackJob datadogEnv readyLabel cursorEnv cursorModel verifyCheckIn checkInModel verifyRetro'
nl='
'
shared() {
  case " $sharednames " in *" $1 "*) return 0 ;; *) return 1 ;; esac
}

# Every otis.* setting in one git call, and one more for the repo's .otis,
# rather than a git process for each name asked. A git process costs about
# 7ms whatever it is asked of it, and a picker asks for a dozen settings
# before it draws a row, so asking name by name was most of what a list
# script spent before anything appeared.
#
# awk turns each store into assignments: yours_<name> for your git config,
# repo_<name> for the repo's .otis. Every value of a name is kept, one a
# line, in the order git config listed them, so the last is what --get would
# have answered and all of them are what --get-all would. git config matches
# a name without regard to case and hands it back lowercased, so awk is given
# the spellings used here and answers in them; a name that is not one of them
# is dropped rather than turned into a variable, and .otis, which a repo you
# cloned wrote, is only ever read for the names shared() allows.
assign() {
  awk -v pfx="$1" -v names="$2" '
    BEGIN { n = split(names, N, " "); for (i = 1; i <= n; i++) canon[tolower(N[i])] = N[i]; q = sprintf("%c", 39) }
    {
      i = index($0, " ")
      k = (i ? substr($0, 1, i - 1) : $0); v = (i ? substr($0, i + 1) : "")
      sub(/^otis\./, "", k); k = tolower(k)
      if (!(k in canon)) next
      val[canon[k]] = (canon[k] in val ? val[canon[k]] "\n" : "") v
    }
    END {
      for (k in val) {
        s = val[k]; gsub(q, q "\\" q q, s)
        printf "%s%s=%s%s%s\n", pfx, k, q, s, q
      }
    }'
}
load_yours() {
  [ -n "$yours_done" ] && return 0
  yours_done=1
  eval "$(git config --get-regexp '^otis\.' 2>/dev/null | assign yours_ "$names")"
  return 0
}
# The repo's .otis, only once something shared is not yours to begin with:
# most repos have no .otis, and finding that out costs a git process of its
# own to learn where the repo starts.
load_repo() {
  [ -n "$repo_done" ] && return 0
  repo_done=1
  [ -z "$repofile" ] && repofile=$(git rev-parse --show-toplevel 2>/dev/null)/.otis
  [ -f "$repofile" ] || return 0
  repo_exists=1
  eval "$(git config --file "$repofile" --get-regexp '^otis\.' 2>/dev/null | assign repo_ "$sharednames")"
  return 0
}
# Whether the repo has a .otis that may speak for this name at all, which is
# what the picker's rows and its preview ask before naming it as the source.
from_repo() { shared "$1" && { load_repo; [ -n "$repo_exists" ]; }; }
# Whether otis.<name> is set at all, in either store, leaving its values in $v.
found() {
  load_yours
  eval "v=\${yours_$1-}; has=\${yours_$1+1}"
  [ -n "$has" ] && return 0
  shared "$1" || return 1
  load_repo
  eval "v=\${repo_$1-}; has=\${repo_$1+1}"
  [ -n "$has" ]
}
# otis.<name>: yours, else the repo's .otis where shared() lets it say. The
# last value, as git config --get answers, and nothing with a non-zero status
# where neither sets it.
cfg() { found "$1" || return 1; printf '%s\n' "${v##*$nl}"; }
# Every value instead, as --get-all answers.
cfg_all() { found "$1" || return 1; printf '%s\n' "$v"; }
# git config --type=bool, on a value this already has: what git calls true,
# and, for anything else it would have refused, unset, so each caller's own
# default stands.
cfg_bool() {
  found "$1" || return 1
  case ${v##*$nl} in
    true | yes | on | 1) echo true ;;
    false | no | off | 0 | '') echo false ;;
    *) return 1 ;;
  esac
}

keys='host url project main base gateJobs deployEnv deployJob rollbackJob datadogEnv readyLabel cursorEnv cursorModel verifyCheckIn checkInModel verifyRetro claudeCommands worktrees editor lessons gitlab'

# The origin remote's host and path, from either URL form:
# https://host/group/repo.git or git@host:group/repo.git. Worked out once:
# project and url both want it, and asking git twice for the same remote is
# most of what a multi-key call used to cost.
origin_parts() {
  if [ -z "$origin_done" ]; then
    origin_done=1 origin_rc=1 host= path=
    if url=$(git remote get-url origin 2>/dev/null); then
      rest=
      case $url in
        *://*) rest=${url#*://}; rest=${rest#*@} ;;
        *@*:*) rest=${url#*@}; rest=$(printf '%s' "$rest" | sed 's#:#/#') ;;
        [!/]*:*) rest=$(printf '%s' "$url" | sed 's#:#/#') ;;
      esac
      if [ -n "$rest" ]; then
        host=${rest%%/*}; host=${host%%:*}
        path=${rest#*/}; path=${path%.git}
        origin_rc=0
      fi
    fi
  fi
  return $origin_rc
}
host() { cfg host || { origin_parts && printf '%s\n' "$host"; } || echo gitlab.com; }
# Also worked out once: base asks for it, and so may the same call.
main() {
  if [ -z "$main_done" ]; then
    main_done=1 main_memo=main
    if m=$(cfg mainBranch); then main_memo=$m
    elif d=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null); then main_memo=${d#origin/}
    fi
  fi
  printf '%s\n' "$main_memo"
}

one() {
  case $1 in
    host) host ;;
    url) printf 'https://%s\n' "$(host)" ;;
    project) cfg project || { origin_parts && printf '%s\n' "$path"; } ;;
    main) main ;;
    base)
      m=$(main)
      for ref in "origin/$m" "$m"; do
        git rev-parse -q --verify "$ref^{commit}" >/dev/null 2>&1 && { printf '%s\n' "$ref"; return 0; }
      done
      echo HEAD ;;
    gateJobs)
      cfg_all gateJob | jq -R 'select(. != "")' | jq -sc . ;;
    deployEnv) cfg deployEnv || echo production ;;
    deployJob) cfg deployJob || echo deploy ;;
    rollbackJob) cfg rollbackJob || echo rollback ;;
    datadogEnv) cfg datadogEnv || echo production ;;
    readyLabel) cfg readyLabel || echo ready-for-ci ;;
    cursorEnv) cfg cursorEnv ;;
    cursorModel) cfg cursorModel ;;
    verifyCheckIn) cfg verifyCheckIn || echo 5 ;;
    checkInModel) cfg checkInModel ;;
    verifyRetro) [ "$(cfg_bool verifyRetro || echo true)" = true ] ;;
    claudeCommands) cfg_all claudeCommand | grep -v '^$' ;;
    worktrees) cfg worktrees || echo .claude/worktrees ;;
    editor) [ -n "$OTIS_EDITOR" ] && echo "$OTIS_EDITOR" || cfg editor || echo nvim ;;
    lessons) [ "$(cfg_bool lessons)" = true ] ;;
    gitlab)
      origin_parts || exit 1
      [ "$host" = "$(cfg host)" ] && exit 0
      case $host in *gitlab*) exit 0 ;; *) exit 1 ;; esac ;;
    *) echo "usage: otis-config [$(printf '%s' "$keys" | sed 's/ / | /g')]" >&2; exit 2 ;;
  esac
}

# ---------------------------------------------------------------- the cache
# A picker asks for settings constantly: once for its list, and again in every
# preview and binding, each of them a process of its own that knows nothing of
# the last. Worked out from scratch each time, a lookup is a git process or
# two, and a list script spent more of its time deciding what the default
# branch is called than it spent drawing rows.
#
# So every answer is worked out once and kept in the git dir, a value a line,
# and a lookup reads that file instead of asking git. A picker goes one
# further: git-fzf loads the file with --env before it opens, the way it
# already loads the theme, and every command under it answers from the
# environment, reading nothing at all.
#
# The file stands while it is newer than everything a setting can come from:
# this repo's config, your global one and the repo's .otis. So a git config
# from anywhere, otis's own settings picker included, is picked up by the next
# lookup without anything having to be told, and a cache that is merely the
# same age as what it was built from counts as out of date rather than
# current. The environment's copy is held to the same file, so a setting
# changed from the dashboard's c is what that picker's next reload reads.
#
# Two keys are left out of both and always looked up live. claudeCommands is
# the one setting that says what Claude may run, and what decides that should
# come from git config and nowhere else. editor answers with $OTIS_EDITOR
# where there is one, and an answer that follows the environment cannot be
# kept in a file that only watches git config. Worktrees under the checkout the
# environment was made in share its git config and count as inside it; a .otis
# that differs between branches checked out there is the one thing this would
# miss, and nothing here reads a worktree's .otis.
envkeys='host url project main base gateJobs deployEnv deployJob rollbackJob datadogEnv readyLabel cursorEnv cursorModel verifyCheckIn checkInModel verifyRetro worktrees lessons gitlab'
boolkeys='verifyRetro lessons gitlab'
cachename=otis-config-cache
tab='	'

# Where this checkout starts and where its git dir is, in one git call, since
# the cache is keyed by both. The git dir is the common one, so every worktree
# shares the cache, as they share the config it is built from.
repo_facts() {
  [ -n "$facts_done" ] && return $facts_rc
  facts_done=1 facts_rc=1
  p=$(git rev-parse --path-format=absolute --show-toplevel --git-common-dir 2>/dev/null) || return 1
  root=${p%%"$nl"*} gitdir=${p#*"$nl"}
  [ -n "$root" ] && [ -n "$gitdir" ] && [ "$root" != "$gitdir" ] && facts_rc=0
  return $facts_rc
}

# Whether a cache file is still newer than every file its answers came from.
# A global config can be in either of the two places git looks, or wherever
# GIT_CONFIG_GLOBAL names; git's system-wide one is not watched, since otis
# settings do not live there.
cache_fresh() {
  c=$1 r=$2 d=$3
  [ -f "$c" ] || return 1
  [ ! -e "$d/config" ] || [ "$c" -nt "$d/config" ] || return 1
  [ ! -e "$r/.otis" ] || [ "$c" -nt "$r/.otis" ] || return 1
  for g in "$GIT_CONFIG_GLOBAL" "${XDG_CONFIG_HOME:-$HOME/.config}/git/config" "$HOME/.gitconfig"; do
    [ -z "$g" ] || [ ! -e "$g" ] || [ "$c" -nt "$g" ] || return 1
  done
  return 0
}

# Every key worked out the long way, a key and its value a line, and last the
# keys that answered with nothing, which is not the same as answering empty.
# Everything the keys are worked out from is read here first, before any of
# them is asked: a subshell inherits what this one knows but hands nothing
# back, and a key asked cold would send it to git again.
build_cache() {
  load_yours
  load_repo
  origin_parts || :
  main >/dev/null
  unset_keys=
  for key in $envkeys; do
    # gitlab, lessons and verifyRetro answer with a status alone and end the
    # run they are in, so those are asked in a subshell; the rest are asked
    # here, where what they work out is kept for the ones after.
    case " $boolkeys " in
      *" $key "*) val=; (one "$key") >/dev/null 2>&1 || unset_keys="$unset_keys $key" ;;
      *) val=$(one "$key" 2>/dev/null) || { unset_keys="$unset_keys $key"; val=; } ;;
    esac
    # A value of more than one line cannot be carried a line a key like this,
    # so that key is left out and looked up the long way, as claudeCommands is.
    case $val in
      *"$nl"*) ;;
      *) printf '%s\t%s\n' "$key" "$val" ;;
    esac
  done
  printf 'UNSET\t%s\n' "${unset_keys# }"
}

# The cache for this checkout, built first where it is missing or out of date,
# read into the same variables --env exports. A repo whose git dir cannot be
# written to still answers, the long way, every time.
load_cache() {
  [ -n "$cache_tried" ] && return $cache_rc
  cache_tried=1 cache_rc=1
  repo_facts || return 1
  c=$gitdir/$cachename
  if ! cache_fresh "$c" "$root" "$gitdir"; then
    repofile=$root/.otis
    t=$c.$$
    if build_cache > "$t" 2>/dev/null; then mv -f "$t" "$c" 2>/dev/null || rm -f "$t"; else rm -f "$t"; fi
  fi
  [ -f "$c" ] || return 1
  # Read, never sourced: a line of it is a name this file knows and a value,
  # and nothing it says can run.
  while IFS="$tab" read -r k v; do
    if [ "$k" = UNSET ]; then OTIS_C_UNSET=$v; continue; fi
    case " $envkeys " in *" $k "*) eval "OTIS_C_$k=\$v" ;; esac
  done < "$c"
  OTIS_C_ROOT=$root OTIS_C_GITDIR=$gitdir cache_rc=0
  return 0
}

# Whether the answers the environment already carries are this checkout's, and
# still current: the same file, held to the same test, without asking git
# where anything is.
env_ok() {
  [ -n "$OTIS_C_ROOT" ] && [ -n "$OTIS_C_GITDIR" ] || return 1
  case $PWD in "$OTIS_C_ROOT" | "$OTIS_C_ROOT"/*) ;; *) return 1 ;; esac
  cache_fresh "$OTIS_C_GITDIR/$cachename" "$OTIS_C_ROOT" "$OTIS_C_GITDIR"
}

# One key from what is loaded: its value and its status, or status 2 for a key
# that is not carried, which is then looked up as it always was.
env_one() {
  # By name first: anything else is not a key at all, and must reach the usage
  # message rather than become a variable to expand.
  case " $envkeys " in *" $1 "*) ;; *) return 2 ;; esac
  eval "held=\${OTIS_C_$1+1}"
  [ -n "$held" ] || return 2
  case " $OTIS_C_UNSET " in *" $1 "*) return 1 ;; esac
  case " $boolkeys " in *" $1 "*) return 0 ;; esac
  eval "printf '%s\\n' \"\$OTIS_C_$1\""
}
# The cached answer where there is one, else the long way round.
answer() {
  if [ -z "$ready" ]; then
    ready=no
    { env_ok || load_cache; } && ready=yes
  fi
  if [ "$ready" = yes ]; then
    env_one "$1"
    case $? in 0) return 0 ;; 1) return 1 ;; esac
  fi
  one "$1"
}

# The git config name behind a key: url and base follow host and mainBranch,
# and gitlab, worked out from origin alone, has none.
gitname() {
  case $1 in
    url) echo host ;; main | base) echo mainBranch ;; gateJobs) echo gateJob ;;
    claudeCommands) echo claudeCommand ;; gitlab) ;; *) echo "$1" ;;
  esac
}

# The git config scope a key's value came from, or default.
source_of() {
  [ "$1" = editor ] && [ -n "$OTIS_EDITOR" ] && { echo OTIS_EDITOR; return; }
  n=$(gitname "$1") s=
  [ -n "$n" ] && s=$(git config --show-scope --get-all "otis.$n" 2>/dev/null | tail -1 | cut -f1)
  [ -z "$s" ] && [ -n "$n" ] && from_repo "$n" && git config --file "$repofile" --get-all "otis.$n" >/dev/null 2>&1 && s=.otis
  echo "${s:-default}"
}

case $1 in
  # Every setting worked out once, as exports for sh to eval, for git-fzf to
  # load before a picker so nothing under it has to ask git again. Outside a
  # repo there is nothing to say, and every command below carries on as it
  # would have.
  --env)
    load_cache || exit 0
    awk -F'\t' -v root="$root" -v gitdir="$gitdir" '
      BEGIN { q = sprintf("%c", 39)
        printf "export OTIS_C_ROOT=%s%s%s\n", q, root, q
        printf "export OTIS_C_GITDIR=%s%s%s\n", q, gitdir, q }
      { v = substr($0, index($0, "\t") + 1); gsub(q, q "\\" q q, v)
        printf "export OTIS_C_%s=%s%s%s\n", $1, q, v, q }' "$gitdir/$cachename"
    exit 0 ;;
  # Every key, its source and its value, a row a key with the key after a tab.
  --rows)
    . "$(dirname "$0")/../share/palette.sh"
    for key in $keys; do
      case $key in
        verifyRetro | lessons | gitlab) (one "$key") && v=yes || v=no ;;
        *) v=$(one "$key" | awk 'NR > 1 { printf ", " } { printf "%s", $0 }') ;;
      esac
      s=$(source_of "$key")
      if [ "$s" = default ]; then
        printf "${GK_TEXT}%-15s${GK_R} ${GK_FAINT}%-12s${GK_R} ${GK_CONTEXT}%s${GK_R}\t%s\n" "$key" "$s" "${v:-(unset)}" "$key"
      else
        printf "${GK_TEXT}%-15s${GK_R} ${GK_ELSEWHERE}%-12s${GK_R} ${GK_ATTENTION}%s${GK_R}\t%s\n" "$key" "$s" "$v" "$key"
      fi
    done
    exit 0 ;;
  --about)
    awk -v k="$2" '
      /^#   [A-Za-z]/ { on = ($2 == k); if (on) { sub(/^#   [A-Za-z]+ +/, ""); print }; next }
      /^#     / && on { sub(/^# +/, ""); print; next }
      /^[^#]/ { exit }
      { on = 0 }' "$0"
    n=$(gitname "$2")
    echo
    if [ -z "$n" ]; then
      echo "Worked out from origin; nothing to set."
    else
      o=$(git config --show-origin --get-all "otis.$n" 2>/dev/null)
      from_repo "$n" && o="$o
$(git config --file "$repofile" --show-origin --get-all "otis.$n" 2>/dev/null)"
      if [ -n "$(printf '%s' "$o" | tr -d '\n')" ]; then
        printf '%s\n' "$o" | awk -F'\t' -v n="otis.$n" 'NF { print $1 "   " n " = " $2 }'
      else
        echo "otis.$n is not set, so this is the default."
      fi
    fi
    exit 0 ;;
  # The fzf actions for enter and E: a note where there is nothing to set, else
  # the edit in the terminal, then the rows again. Set for every repo under a
  # value of this repo's own, the note says the repo's own still wins.
  --set)
    n=$(gitname "$3")
    [ -n "$n" ] || exec git-fzf-note "$3 is worked out from origin; set host instead"
    printf 'execute(otis-config --prompt %s %s)+reload(otis-config --rows)' "$2" "$3"
    if [ "$2" = global ] && git config --local --get "otis.$n" >/dev/null 2>&1; then
      printf '+%s' "$(git-fzf-note "set for every repo, but this repo's own otis.$n still wins here")"
    fi
    echo
    exit 0 ;;
  # Back to the default: unset in this repo and for every repo, since a
  # global value left behind would be what applies, not the default.
  --unset)
    n=$(gitname "$2") gone=
    [ -n "$n" ] || exec git-fzf-note "$2 is worked out from origin; nothing to unset"
    for s in local global; do
      git config "--$s" --unset-all "otis.$n" 2>/dev/null && gone="$gone $s"
    done
    now="back to the default"
    [ "$(source_of "$2")" = .otis ] && now="now the repo's .otis value, which is changed in that file"
    [ -n "$gone" ] || exec git-fzf-note "$2 is $now"
    printf 'reload(otis-config --rows)+%s\n' "$(git-fzf-note "otis.$n $now (unset:$gone)")"
    exit 0 ;;
  # One value in place, starting from what applies now, with zsh's line
  # editor: esc or ctrl-c keeps it, an empty one unsets it. Several in your
  # editor instead, one a line.
  --prompt)
    scope=$2 n=$(gitname "$3")
    case $n in
      gateJob | claudeCommand)
        f=$(mktemp) || exit 1
        { echo "# otis.$n ($scope), one a line; lines starting with # are dropped, and none at all unsets it"
          git config "--$scope" --get-all "otis.$n" 2>/dev/null; } > "$f"
        otis-edit "$f"
        git config "--$scope" --unset-all "otis.$n" 2>/dev/null
        grep -v -e '^#' -e '^$' "$f" | while IFS= read -r v; do git config "--$scope" --add "otis.$n" "$v"; done
        rm -f "$f" ;;
      *)
        cur=$(cfg "$n")
        v=$(zsh -fc 'bindkey -e; v=$1; vared -p "otis.$2 ($3, empty unsets)> " v </dev/tty >/dev/tty && print -r -- "$v"' _ "$cur" "$n" "$scope") || exit 0
        if [ -n "$v" ]; then git config "--$scope" "otis.$n" "$v"
        else git config "--$scope" --unset-all "otis.$n" 2>/dev/null
        fi ;;
    esac
    exit 0 ;;
esac

# No key: every setting in a picker (git-fzf), with where its value came from.
# The preview is what the key does, from the list at the top of this file, and
# every git config file that sets it. enter sets it in this repo, E for every
# repo (--global), x puts it back to the default. A setting with several values
# (gateJobs, claudeCommands) opens in your editor, one value a line.
if [ $# -eq 0 ]; then
  exec git-fzf 'otis config ' 'enter=set in this repo,E=set for every repo,x=back to the default (unsets here and globally)' --ansi \
    --delimiter='\t' --with-nth=1 --track --id-nth=2 \
    --bind 'start:reload(otis-config --rows)' \
    --bind 'enter:transform(otis-config --set local {2})' \
    --bind 'E:transform(otis-config --set global {2})' \
    --bind 'x:transform(otis-config --unset {2})' \
    --preview 'otis-config --about {2}' </dev/null >/dev/null
fi
# One key answers as it always has, exit status included, since gitlab,
# lessons and verifyRetro are asked that way. Several print one value a line,
# a blank one for a setting with no value, so the answers line up with the
# keys however many of them are unset.
#
# Asking is where the environment's answers are used, and only here: the rows,
# what a key is about and where its value came from are what you opened to
# read, so those ask git itself every time.
if [ $# -le 1 ]; then
  answer "$1"
  exit $?
fi
for key; do answer "$key" || echo; done
