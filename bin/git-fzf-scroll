#!/usr/bin/env -S zsh -f
# git-fzf-scroll reset
# Forget where every row's preview was scrolled (off.<row> in
# $GIT_FZF_STATE, which otis-pick keeps as fzf's picker did), for a reload
# that renumbers a list keyed by its rows' places. A picker keyed by
# --id-nth (otis-pick notes it in by-id) keeps them: its ids survive the
# reload, and so should where you were in each.
[[ $1 == reset ]] || exit 0
st=$GIT_FZF_STATE
[[ -d $st && ! -e $st/by-id ]] && rm -f $st/off.*(N)
exit 0
