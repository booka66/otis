#!/usr/bin/env -S zsh -f
# git-fzf-scroll <loaded | half | -half> <item> [lines already moved]
# git-fzf-scroll note <item> <lines>
# git-fzf-scroll reset
# Preview scrolling for git-fzf, remembered per item in $GIT_FZF_STATE. The item
# is its --id-nth field, or its index {n} in a picker without one.
#
# Every move is relative (preview-down, preview-up). fzf's absolute offset
# (change-preview-window +N) looked simpler but does nothing while the preview
# is stacked under the list, since that layout comes from the <66(...)
# alternative. off.<item> is the line at the top of the preview, kept in step with
# every move sent.
#
# The position comes back in loaded, which git-fzf's preview command runs once
# an item with a saved position has printed its preview: moves sent before then
# would scroll the old content and be lost. It replays the position as
# preview-top and that many preview-downs.
#
# half/-half glide: a binding applies all its actions in one redraw, so the glide runs in
# the background and drives the picker over its --listen API, one request per
# frame on an ease-in-out curve, time-based (about every 15ms) so a slow frame
# never stretches it. Raw HTTP over zsh's tcp module, since forking curl per
# frame costs more than a frame. A newer glide, or moving to another item,
# stops an older one, and a glide started mid-glide carries on from where the
# preview is toward the new goal.
# Each / in the item becomes %, as git-fzf's preview does, to name its files,
# and a long one is its last 200 characters, as there too.
mode=$1 n=${2//\//%}
(( ${#n} > 200 )) && n=${n[-200,-1]}
st=$GIT_FZF_STATE
# reset: forget every item, for a reload that renumbers a list keyed by {n}. A
# picker keyed by --id-nth (git-fzf notes it in by-id) keeps them: its ids
# survive the reload, and so should where you were in each.
if [[ $mode == reset ]]; then
  [[ -d $st && ! -e $st/by-id ]] && rm -f $st/(off|goal|lines).*(N) $st/glidefor(N)
  exit 0
fi
[[ -n $n && -d $st ]] || exit 0

# Every note, keypress and glide frame is its own process, and each reads a
# state file, changes it and writes it back. Holding a key starts them 30ms
# apart, so without a lock they overwrite each other's positions, two presses
# both find no glide and start two, and a read can catch a file mid-write,
# empty, and take the preview for line 0. Each read-change-write holds this.
zmodload zsh/system
integer lockfd
lock() { zsystem flock -f lockfd $st/lock }
unlock() { zsystem flock -u $lockfd }

# note DELTA: the preview already moved DELTA lines under fzf's own
# preview-down/up, so there is nothing to send -- only the remembered position
# to keep in step. The wheel and ctrl-e/y go this way so that a notch costs
# fzf nothing: it used to wait on this script starting before it would scroll
# at all, which is what made the wheel feel like treacle.
if [[ $1 == note ]]; then
  lock
  integer at=1 lines=0
  [[ -r $st/off.$n ]] && at=$(<$st/off.$n)
  [[ -r $st/lines.$n ]] && lines=$(<$st/lines.$n)
  (( at += $3, at < 1 ? (at = 1) : 0 ))
  (( lines > 0 && at > lines )) && at=lines
  print -r -- $at > $st/off.$n
  print -r -- $at > $st/goal.$n
  print -r -- '' > $st/glide
  exit 0
fi

zmodload zsh/net/tcp zsh/zselect zsh/datetime

# A frame is a write, never a round trip: connect, send, close, and never read
# the response. Nothing here needs it, and waiting up to 50ms on it per frame
# used to eat most of a 120ms glide.
#
# One connection per frame, because fzf's listen server answers one request and
# hangs up. Keeping a socket open across the glide looked cheaper but lost
# frames: the write after fzf hung up still succeeds locally and goes nowhere,
# so every other move vanished and off.<item> ran ahead of the real preview
# (four ctrl-d recorded line 45 with the preview at 29). A localhost connect is
# well under a millisecond. SIGPIPE is ignored so a write that races a hangup
# is a failed post rather than the death of the glide.
trap '' PIPE
post() {
  local req="POST / HTTP/1.1"$'\r\n'"Host: 127.0.0.1"$'\r\n'"x-api-key: $FZF_API_KEY"$'\r\n'"Content-Length: ${#1}"$'\r\n\r\n'"$1"
  ztcp 127.0.0.1 $FZF_PORT 2>/dev/null || return 1
  local fd=$REPLY
  print -rn -u $fd -- "$req" 2>/dev/null
  local ok=$?
  ztcp -c $fd 2>/dev/null
  return ok
}

# moves DELTA: the actions that scroll the preview by DELTA lines.
moves() {
  local -a acts
  if (( $1 > 0 )); then
    repeat $1 acts+=(preview-down)
  elif (( $1 < 0 )); then
    repeat $(( 0 - $1 )) acts+=(preview-up)
  fi
  print -r -- ${(j:+:)acts}
}

lock
integer cur=1 total=0 goal step
[[ -r $st/off.$n ]] && cur=$(<$st/off.$n)

if [[ $mode == loaded ]]; then
  [[ -r $st/focus && $(<$st/focus) == "$n" ]] || exit 0
  (( cur > 1 )) && post "preview-top+$(moves $(( cur - 1 )))"
  exit 0
fi

[[ -r $st/lines.$n ]] && total=$(<$st/lines.$n)

# The keypress itself already moved the preview by <lead> lines, natively,
# before this process existed -- the same trick the wheel uses. Without it the
# first press of a pause moved nothing until a shell had started, which is
# exactly the lag the wheel no longer has. So catch the record up to where the
# preview now is, and measure the half page from where it was.
integer lead=${3:-0} before=cur
if (( lead )); then
  (( cur += lead, cur < 1 ? (cur = 1) : 0 ))
  (( total > 0 && cur > total )) && cur=total
  print -r -- $cur > $st/off.$n
fi

(( step = FZF_PREVIEW_LINES / 2 ))
[[ $mode == -half ]] && (( step = -step ))

# A glide still running on this item is heading for goal.<item>; steps build on
# that, not on where the preview happens to be mid-glide.
integer base=before
running_glide() {
  [[ -r $st/glide && -r $st/glidefor && -r $st/goal.$n ]] &&
    [[ $(<$st/glidefor) == "$n" ]] && kill -0 $(<$st/glide) 2>/dev/null
}
running_glide && base=$(<$st/goal.$n)
(( goal = base + step, goal < 1 ? (goal = 1) : 0 ))
(( total > 0 && goal > total )) && goal=total

# A glide already running on this item picks the new goal up on its next frame.
# Holding ctrl-d then costs one file write rather than killing the animation and
# starting another process, which is what made a held key stutter.
print -r -- $goal > $st/goal.$n
running_glide && exit 0

print -r -- $$ > $st/glide
print -r -- $n > $st/glidefor
unlock

# Driven by the clock, not by a frame count. Every frame is one request that
# makes fzf redraw the whole preview pane, so a frame costs whatever that
# redraw costs -- on a big delta-rendered diff, more than the 10ms floor here.
# Reading the position off EPOCHREALTIME means a slow redraw eats frames rather
# than stretching the scroll: it always lands in `dur`, however many frames the
# machine managed. Counting frames instead turned a 120ms scroll into a 400ms
# one on exactly the previews where it hurts.
#
# Linear, not eased. Easing needs frames to read as easing, and there are only
# about a dozen here; a quadratic ease-in spends the first two or three of them
# moving zero lines, which is what read as a stutter before the scroll caught
# up in a burst. Linear starts moving on frame one and is even the whole way.
# 0.14s. Long enough to follow the text past rather than have it land already
# moved, short enough to stay out of the way. The keypress lead means this is
# what the scroll settles into, not what it waits through.
float dur=0.14 start=$EPOCHREALTIME t
integer from=cur last=cur written=cur pos target=goal fresh idle=0
while :; do
  lock
  [[ $(<$st/glide) == $$ ]] || exit 0
  [[ ! -r $st/focus || $(<$st/focus) == "$n" ]] || exit 0
  # Something moved the preview under us -- a wheel notch, or the lead of
  # another keypress. off.<item> is the record of where it actually is, so take
  # it as the new starting point rather than carrying on from a stale one and
  # sending moves that land in the wrong place.
  fresh=$(<$st/off.$n)
  if (( fresh != written )); then
    last=fresh written=fresh from=fresh start=$EPOCHREALTIME
  fi
  # A held or repeated key moves the goal; carry on from here toward the new
  # one rather than restarting.
  fresh=$(<$st/goal.$n)
  if (( fresh != target )); then
    target=fresh from=last start=$EPOCHREALTIME idle=0
  fi
  if (( last == target )); then
    # Arrived, but stay a moment. A second ctrl-d inside this window retargets
    # this glide, where exiting on arrival made every repeat press wait on a
    # new process starting before anything moved -- which is why holding them
    # could not keep up.
    (( ++idle > 30 )) && break
    unlock
    zselect -t 1
    continue
  fi
  idle=0
  (( t = (EPOCHREALTIME - start) / dur, t > 1 ? (t = 1) : 0 ))
  (( pos = from + (target - from) * t + 0.5 ))
  if (( pos != last )); then
    post "$(moves $(( pos - last )))" || exit 0
    last=pos written=pos
    print -r -- $pos > $st/off.$n
  fi
  unlock
  zselect -t 1
done
# No absolute snap at the end. Every move here is relative, so the preview is
# wherever fzf actually put it; correcting to what off.<item> claims would jump
# the view whenever the wheel had nudged that count while no glide was running.
# Only `loaded` positions absolutely, and only because fzf has just reset the
# preview to the top.
