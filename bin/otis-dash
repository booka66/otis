#!/usr/bin/env -S zsh -f
# otis-dash: the dashboard, drawn by hand rather than as an fzf list.
#
# The rows are otis-list's, and every key does what it did when this was a
# picker (otis-do, git-mr-do), but the screen is laid out for the eye rather
# than as one list of equal rows: a headline saying how many things want
# you, the one that wants you most in a card of its own under it, then the
# rest of what is waiting, what is going, and where you are, each a quiet
# heading and rows in columns. The row under the cursor is the only one lit,
# and the footer leads with what enter does on it. On a wide terminal the
# row's preview (otis-preview) sits to the right; on any, space reads it in
# a pager.
#
# The row keys hand back fzf actions (execute(...), a footer note), since
# they are shared with the pickers; run() below carries out the few that
# they use, with the row's fields for fzf's {n} placeholders. m, b, a, d, w
# and c print the command to open and exit, for the otis function to run
# (it may move you, which a script cannot), as the picker's accept did.
#
# It redraws the rows every 10s in the background (u: now, refetching), and
# keeps the cursor on the row it was on by the row's id.
#
# It keeps a line a frame (OTIS_DASH_TRACE, else ~/.cache/otis/dash.log): how
# long it took to build and to write, its size, and how long after the key
# that asked for it it was on the screen; and any upkeep between keys that
# took over 20ms. For when it feels slow: it says whether the time went here
# or in the terminal.
setopt extendedglob no_nomatch

[[ -n $OTIS_T_NAME && $OTIS_THEME == "$OTIS_T_WANT" ]] || eval "$(otis-theme --env)"
. ${0:A:h:h}/share/in-root.sh
in_root || eval "$(otis-config --env)"
export OTIS_ROWFMT=$(<${0:A:h:h}/share/rowfmt.awk)
wrap_awk=$(<${0:A:h:h}/share/pane-wrap.awk)
# Not under a picker: the scripts that would post to one must not find one.
unset FZF_PORT FZF_API_KEY
export GIT_FZF_STATE=${TMPDIR:-/tmp}/otis-dash.$$.$RANDOM
mkdir -m 700 $GIT_FZF_STATE || exit 1
st=$GIT_FZF_STATE
mkdir $st/pv
# The last run's, kept past its end: when it felt slow, it is still there
# to read.
trace=${OTIS_DASH_TRACE:-${XDG_CACHE_HOME:-$HOME/.cache}/otis/dash.log}
mkdir -p ${trace:h} 2>/dev/null; : > $trace

. ${0:A:h:h}/share/screen.zsh
screen_start
# A window being dragged is a resize a step: each is drawn at once, and the
# previews wait until the size has held for 0.3s (settle), so a drag draws
# them once rather than every row at every width it passed through.
float settle=0
resize() {
  local oh=$H ow=$W
  size
  print -r -- "$EPOCHREALTIME resize ${ow}x$oh -> ${W}x$H" >> $trace
  (( H != oh || W != ow )) || return 1
  shown_rows=(); draw
  (( settle = EPOCHREALTIME + 0.3 ))
}

# --- the rows -------------------------------------------------------------
# otis-list's fields, one array a field, an entry a row that is not a heading;
# sec is the heading it is under.
typeset -a kind iid id extra vkey glyph gc verb title who when note prog mark doing sub dots sec raw
loaded=0
load() {
  local line f s=
  kind=() iid=() id=() extra=() vkey=() glyph=() gc=() verb=() title=() who=() when=() note=() prog=() mark=() doing=() sub=() dots=() sec=() raw=()
  for line in ${(f)"$(<$st/rows)"}; do
    f=("${(@ps:\t:)line}")
    if [[ $f[6] == sep ]]; then s=${f[11]#sep-}; continue; fi
    raw+=("$line") sec+=($s) kind+=("$f[6]") iid+=("$f[2]") id+=("$f[11]") extra+=("$f[13]") vkey+=("$f[14]")
    glyph+=("$f[15]") gc+=("$f[16]") verb+=("$f[17]") title+=("$f[18]") who+=("$f[19]") when+=("$f[20]")
    note+=("$f[21]") prog+=("$f[22]") mark+=("$f[23]") doing+=("$f[24]") sub+=("$f[25]") dots+=("$f[26]")
  done
  loaded=1
}
# The row's fields as fzf numbers them, for {n}.
fields() { reply=("${(@ps:\t:)raw[cur]}"); }

lpid= ltick=$EPOCHSECONDS lastsig=
cache=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)/git-alias-cache
refresh() {
  [[ -n $lpid ]] && kill -0 $lpid 2>/dev/null && return
  { otis-list $1 > $st/rows.new 2>/dev/null && mv -f $st/rows.new $st/rows } &!
  lpid=$! ltick=$EPOCHSECONDS
}
landed() {
  [[ -n $lpid ]] && ! kill -0 $lpid 2>/dev/null || return 1
  lpid=
  # The refresh u asked for is done.
  [[ $flash == "refreshing from GitLab…" ]] && flash=
  [[ -s $st/rows ]] || return 1
  local was=$id[cur] i
  load
  cur=1
  for (( i = 1; i <= $#id; i++ )); do [[ $id[i] == $was ]] && { cur=$i; break }; done
  # The previews are drawn again only when what they are drawn from has
  # changed: the rows, less how long ago (which moves every minute), the
  # JSON otis-list left for them, and the threads. Most ticks it has not, and every kept
  # preview stands. When it has, the old ones are shown until the new are in.
  local sig= r
  local -a f
  for r in $raw; do f=("${(@ps:\t:)r}"); f[1]= f[20]=; sig+=${(pj:\t:)f}$'\n'; done
  sig+=$(cksum $st/{mrs,ci,ci-merged,deploys,marks,runs}.json(N) 2>/dev/null)
  # And each MR's threads, which a preview fetches when it draws and which
  # land after it (git-mr-threads --kick): their times, with no process.
  local -a tm; local tf
  for tf in $cache/mr-*-threads.json(N); do zstat -A tm +mtime -- $tf; sig+=$tf$tm[1]; done
  if [[ $sig != $lastsig ]]; then
    lastsig=$sig
    (( gen++ ))
    local -a old=($st/pv/*.$(( gen - 2 ))(N))
    (( $#old )) && rm -f -- $old
    warm
  fi
  return 0
}

# --- text ------------------------------------------------------------------
# A line is built from pieces whose widths are known (put, pad, share/screen.zsh),
# then kept with the row it is part of.
emit() { L+=("$line") LI+=($1) LU+=($used); line= used=0; }

# What enter does on the row, in the words the footer and the card say it
# in (otis-list works it out).
enter_says() { REPLY=$doing[cur]; }

# A pipeline's jobs done, as a bar.
bar() {
  local d=${1%/*} t=${1#*/} n=10 k
  (( t > 0 )) || { REPLY=; return }
  (( k = d * n / t ))
  REPLY=${(l:k::━:)}
  REPLY=$G$REPLY$F${(l:n-k::─:)}
}

# --- the left column ---------------------------------------------------------
# L: its lines; LI: the row each is part of (0 for none), to keep the cursor
# in view.
typeset -a L LI LU
row() {
  local i=$1 w=$2 on=0 vw=20 iw=7 tw rw=0 vb= t
  (( i == cur )) && on=1 vb=$B
  line= used=0
  # The cursor, else the branch you are on.
  if (( on )); then put "$A" "▌ "; elif [[ -n $mark[i] ]]; then put "$EL" "▸ "; else put "" "  "; fi
  put "${gc[i]:-$C}" "${(r:2:: :)glyph[i]}"; put "" " "
  if [[ $kind[i] == here ]]; then
    fit "${extra[i]:-${verb[i]}}" $(( w / 2 )); put "$B$EL" "$REPLY"; line+=$UB
    [[ -n $iid[i] ]] && { put "" "  "; put "$A" "!$iid[i]"; }
    put "" "    "
    if [[ -n $note[i] ]]; then fit "$note[i]" $(( w - used - 1 )); put "$Y" "$REPLY"
    else put "$G" "nothing to commit or push"; fi
  else
    # Columns, two apart: verb, MR, what it is about, then on the right a
    # pipeline's jobs and how long ago, both right-aligned to the edge.
    fit "$verb[i]" $vw; put "$vb$T" "${(r:vw:: :)REPLY}"; line+=$UB
    put "" "  "
    # A verification's criteria as glyphs, where an MR's number goes.
    if [[ -n $iid[i] ]]; then put "$A" "${(r:iw:: :)${:-!$iid[i]}}"
    elif [[ -n $dots[i] ]]; then fit "$dots[i]" $iw; put "$Y" "${(r:iw:: :)REPLY}"
    else put "" "${(l:iw:: :)}"; fi
    put "" "  "
    [[ -n $prog[i] ]] && (( rw += 18 ))
    [[ -n $when[i] ]] && (( rw += 5 ))
    (( tw = w - used - rw - 1 ))
    if (( tw > 8 )); then
      # Who, when it fits whole beside the title; else the title alone.
      t=$title[i]
      [[ -n $who[i] ]] && (( ${(m)#t} + 5 + ${(m)#who[i]} <= tw )) && t+="  ·  $who[i]"
      fit "$t" $tw; put "$C" "$REPLY"
    fi
    pad $(( w - rw - 1 ))
    if [[ -n $prog[i] ]]; then
      put "" "  "; bar "$prog[i]"; line+=$REPLY; (( used += 10 ))
      put "$C" " ${(l:5:: :)prog[i]}"
    fi
    [[ -n $when[i] ]] && { put "" "  "; put "$F" "${(l:3:: :)when[i]}"; }
  fi
  pad $w
  (( on )) && line=$BG${line//$R/$R$BG}
  line+=$R
  emit $i
  # A run of Claude's says what it is doing now, under its row.
  if [[ $kind[i] == run && -n $sub[i] ]]; then
    line= used=0
    put "" "      "; put "$F" "› "
    fit "$sub[i]" $(( w - used - 1 )); put "$T" "$REPLY"
    pad $w
    (( on )) && line=$BG${line//$R/$R$BG}
    line+=$R
    emit $i
  fi
}

# The card: the first thing waiting on you, alone at the top, boxed in its
# color: what it is, its MR, what it is about, and what enter does about it,
# so the eye goes from the headline to the one thing to do and the key for it.
# boxline: the card's left edge; boxend: its right, on the line so far.
boxline() { line=$lead$bc"│"$R used=3; }
boxend() { pad $(( w - 1 )); line+=$bc"│"$R; used=$w; emit $i; }
card() {
  local i=$1 w=$2 on=0 cw bc lead t roomy=0 does
  (( i == cur )) && on=1
  (( cw = w - 2 ))
  (( H >= 32 )) && roomy=1
  bc=${gc[i]:-$Y}
  lead="  "; (( on )) && lead=$A"▌ "$R
  line=$lead$bc"╭"${(l:cw-2::─:)}"╮"$R used=$w; emit $i
  (( roomy )) && { boxline; boxend; }
  boxline; put "" "  "; put "$bc" "${(r:2:: :)glyph[i]}"; put "" " "
  fit "$verb[i]" $(( cw - 20 )); put "$B$bc" "$REPLY"; line+=$UB
  [[ -n $iid[i] ]] && { pad $(( w - 5 - ${#iid[i]} - 1 )); put "$A" "!$iid[i]"; }
  boxend
  if [[ -n $title[i] ]]; then
    boxline; put "" "     "; fit "$title[i]" $(( cw - 10 )); put "$T" "$REPLY"; boxend
  fi
  t=$who[i]${who[i]:+${when[i]:+ · }}${when[i]:+$when[i] ago}
  local cur_=$cur; cur=$i; enter_says; does=$REPLY; cur=$cur_
  boxline; put "" "     "
  [[ -n $t ]] && { fit "$t" $(( cw - 30 )); put "$C" "$REPLY"; }
  [[ -n $does ]] && { pad $(( w - 5 - ${(m)#does} - 2 )); put "$B$A" "⏎ $does"; line+=$UB; }
  boxend
  (( roomy )) && { boxline; boxend; }
  line=$lead$bc"╰"${(l:cw-2::─:)}"╯"$R used=$w; emit $i
}

heading() {
  line= used=0
  put "" "  "; put "$C" "${(U)1}"
  [[ -n $2 ]] && { put "" "  "; put "$F" "$2"; }
  emit 0
}

typeset -a secn
left() {
  local w=$1 i n_wait=0 n_go=0 first=1 s
  L=() LI=() LU=()
  for s in $sec; do case $s in waiting) (( n_wait++ )) ;; going) (( n_go++ )) ;; esac; done
  # The headline: how much wants you, the one thing to read first.
  line= used=0; emit 0
  line= used=0
  put "" "  "; put "$B$T" "otis"; line+=$UB
  [[ -n $OTIS_C_project ]] && { put "" "  "; put "$F" "$OTIS_C_project"; }
  [[ -n $lpid ]] && { pad $(( w - 3 )); put "$F" "↻"; }
  emit 0
  line= used=0; emit 0
  if (( !loaded )); then
    line= used=0; put "" "  "; put "$C" "looking…"; emit 0
    return
  fi
  line= used=0; put "" "  "
  if (( n_wait == 0 )); then put "$B$G" "Nothing waiting on you"
  elif (( n_wait == 1 )); then put "$B$Y" "1 thing waiting on you"
  else put "$B$Y" "$n_wait things waiting on you"; fi
  line+=$UB
  (( n_go )) && { put "$C" "  ·  $n_go going"; }
  emit 0
  local stale=($st/stale.*(N))
  if (( $#stale )); then
    line= used=0; put "" "  "; put "$X" "could not refresh from GitLab: this is what it said last"; emit 0
  fi
  # Why there is no GitLab in it, when there is none (otis-list's footer).
  local foot=${(S)${:-$(<$st/footer)}//$e\[[0-9;]#m/}
  if [[ $foot == *alone ]]; then
    line= used=0; put "" "  "; put "$C" "${foot##* · }"; emit 0
  fi
  line= used=0; emit 0

  local lastsec= k=0
  for (( i = 1; i <= $#id; i++ )); do
    if [[ $sec[i] == waiting ]] && (( first )); then
      card $i $w; first=0
      line= used=0; emit 0
      continue
    fi
    if [[ $sec[i] != $lastsec ]]; then
      [[ -n $lastsec ]] && { line= used=0; emit 0; }
      case $sec[i] in
        waiting) heading "also waiting" "$(( n_wait - 1 ))" ;;
        going) heading "going" "$n_go" ;;
        here) heading "here" ;;
      esac
      lastsec=$sec[i]
    fi
    [[ $sec[i] == waiting ]] || lastsec=$sec[i]
    row $i $w
  done
}

# --- the preview pane ----------------------------------------------------------
# otis-preview for the row, cut to the pane, kept per row and width. One at
# a time in the background; the pane shows what is kept (even an old one)
# until it lands.
# A kept preview is named for the row, the width and the generation of what
# it was drawn from (gen, one more whenever that changes, in landed). The
# pane shows the newest there is for the row while the current one renders,
# so a reload never blanks it. warm draws every row's, the cursor's first,
# one after another in the background as soon as the rows are in, so moving
# to a row finds its preview kept; want draws the row you have stopped on if
# warm has not got to it. A render is running while its .tmp is there: made
# before it starts, moved into place when it is done, whatever it printed,
# so a preview that fails is not tried again and again.
gen=0 lastpv=
print "0 0" > $st/pv/gen
pvname() { REPLY=$st/pv/${${1//\//%}:-none}.$2; }
shown() {
  pvname "$id[cur]" $1
  local -a have=($REPLY.<->(Nom))
  # None at this width yet (a resize): the row's at the width it last had,
  # cut at the edge, rather than an empty pane until it is drawn again.
  (( $#have )) || have=(${REPLY%.*}.<->.<->(Nom))
  REPLY=${have[1]}
}
# render <width> <file> <kind> <iid> <row id> <extra>: otis-preview, wrapped
# to the pane (share/pane-wrap.awk), the pieces a line broke into beside it
# (.cont).
render() {
  FZF_PREVIEW_COLUMNS=$1 FZF_PREVIEW_LINES=$H otis-preview "$3" "$4" "$5" "$6" 2>/dev/null |
    LC_ALL=C awk -v w=$1 -v cont=$2.cont.tmp "$wrap_awk" > $2.tmp
  mv -f $2.cont.tmp $2.cont
  mv -f $2.tmp $2
}
want() {
  local w=$1 f
  (( w > 0 && $#id )) || return 1
  pvname "$id[cur]" $w; f=$REPLY.$gen
  [[ -e $f || -e $f.tmp ]] && return 1
  : > $f.tmp
  render $w $f "$kind[cur]" "$iid[cur]" "$id[cur]" "$extra[cur]" &!
}
# A warm for an older generation, or another width, stops at its next row
# (pv/gen), rather than being killed mid-render and leaving a .tmp that
# would keep that preview from ever being drawn.
warm() {
  (( pw > 0 && $#id )) || return
  print -r -- "$gen $pw" > $st/pv/gen
  {
    local i j f g="$gen $pw"
    for (( j = 0; j < $#id; j++ )); do
      [[ $(<$st/pv/gen) == $g ]] || break
      (( i = (cur - 1 + j) % $#id + 1 ))
      pvname "$id[i]" $pw; f=$REPLY.$gen
      [[ -e $f || -e $f.tmp ]] && continue
      : > $f.tmp
      render $pw $f "$kind[i]" "$iid[i]" "$id[i]" "$extra[i]"
    done
  } &!
}

# --- the frame -------------------------------------------------------------------
top=0 help=0 flash=
# The pane's scroll: poff where it is; plen its lines, for where it stops.
integer poff=0 plen=0
# scroll <lines>: the wheel, ctrl-d and ctrl-u, in one frame. A glide sent a
# frame of the whole pane every 10ms, which under a multiplexer stuttered
# rather than glided.
scroll() {
  local max
  (( max = plen - ph, max < 0 ? (max = 0) : 0 ))
  (( poff += $1, poff > max ? (poff = max) : 0, poff < 0 ? (poff = 0) : 0 ))
}
# What is on the screen now, a line a row; emptied when the screen may no
# longer be it (a resize, back from another program), which draws it whole.
typeset -a shown_rows shown_pane
shown_geom=
# The pane's lines as last drawn, for a selection to copy from.
# The layout: the pane beside the list from 130 columns (side), else under
# it on a screen tall enough for both, as in a split that is tall and
# narrow; else no pane, and space reads the preview in a pager. rows is the
# list's height; the pane is pw wide and ph high, from row py, column px.
integer pw=0 side=0 py=1 ph=0
pfile=
draw() {
  local t0=$EPOCHREALTIME
  local lw y i f lo=0 hi=0 body foot rows
  pw=0 side=0 py=1
  if (( W >= 130 )); then (( lw = W * 60 / 100, pw = W - lw - 5, side = 1 ))
  else lw=$W; fi
  left $lw
  if (( side )); then (( rows = H - 2, ph = rows, px = lw + 6 ))
  elif (( H >= 30 )); then
    # Under the list: the list as tall as it is, up to half the screen, and
    # never under ten rows; the pane has the rest, under a rule.
    (( rows = $#L + 1, rows > (H - 2) / 2 ? (rows = (H - 2) / 2) : 0, rows < 10 ? (rows = 10) : 0 ))
    (( py = rows + 2, ph = H - 2 - rows - 1, pw = W - 4, px = 3 ))
  else rows=$(( H - 2 )) ph=0; fi
  # The cursor's row in view, with the headline kept when it fits.
  for (( y = 1; y <= $#LI; y++ )); do
    (( LI[y] == cur )) && { (( lo == 0 )) && lo=$y; hi=$y; }
  done
  (( hi > top + rows )) && (( top = hi - rows ))
  (( lo > 0 && lo <= top )) && (( top = lo - 1 ))
  (( lo > 0 && hi <= rows )) && top=0
  if (( help )); then
      P=("" "  ${B}${T}keys${R}" "")
      local k v
      for k v in enter "do what the row says" space "read its preview in a pager" j/k "move" g/G "top, bottom" \
        m "every MR" b branches a "background runs" d deploys w worktrees c "otis settings" \
        D "stop showing it (Claude's fixes and verdicts)" o "open the MR" y "copy the MR link (a run: its folder, for Claude)" \
        u refresh "ctrl-d/u" "scroll the preview" "?" "this, and back" q quit; do
        P+=("  ${A}${(r:9:: :)k}${R} ${C}$v${R}")
      done
      [[ -s $st/legend ]] && P+=("" "  ${B}${T}glyphs${R}" "" "${(@f)$(<$st/legend)}")
      plen=$#P pfile=
      # No pane to put it in: it is the screen.
      (( pw > 0 )) || { L=("${(@)P[1+poff,-1]}") LU=("${(@)L/*/$lw}") top=0; }
  elif (( pw > 0 )); then
    if (( $#id )); then
      # Read and split once when it lands, not every frame: a frame of a
      # scroll is then the lines it shows and nothing else.
      shown $pw; lastpv=$REPLY
      if [[ $REPLY != $pfile || -z $pfile ]]; then
        pfile=$REPLY
        [[ -n $REPLY ]] && P=("" "${(@f)$(<$REPLY)}") || P=("" "${F}…${R}")
      fi
      plen=$#P
    else P=() pfile=; fi
  else P=() pfile=
  fi
  # The frame, a line a screen row, and then only the rows that differ from
  # the last frame go out: a move is the two rows it changes and the pane,
  # a reload the rows it changed, rather than the whole screen every time.
  # The list's side and the pane's are two frames, each diffed on its own:
  # a move rewrites the two rows it changed and the pane, not every row the
  # pane changed across the whole width, which on a big screen was most of
  # the bytes, and a terminal under a multiplexer (herdr, tmux) parses and
  # draws every one of them.
  # fr the list's lines and the rules and footer, fy the screen row of each;
  # pr the pane's.
  local -a fr fy pr
  local s
  for (( y = 1; y <= rows; y++ )); do
    i=$(( y + top ))
    if (( i <= $#L )); then s=$L[i]$R; (( LU[i] < lw )) && s+=${(l:lw-LU[i]:: :)}
    else s=${(l:lw:: :)}; fi
    (( side )) && s+=$R"  "$F"│"$R
    fr+=("$s") fy+=($y)
  done
  (( pw > 0 && ! side )) && { fr+=("$F${(l:W::─:)}$R") fy+=($(( rows + 1 ))); }
  for (( y = 1; y <= ph && pw > 0; y++ )); do
    f=$(( y + poff )) s=
    if (( f <= $#P )); then
      if (( sel && f >= s1 && f <= s2 )); then selected $f; s=$REPLY; else s=$P[f]; fi
    fi
    pr+=("$s")
  done
  fr+=("$F${(l:W::─:)}$R") fy+=($(( H - 1 )))
  # The footer: a note if a key left one, else what enter does, then the
  # keys that open the rest.
  foot="  "
  # A note or a flash stays until the next key: a preview landing redraws
  # the frame, and a note gone then was gone before it was read.
  if [[ -s $st/note ]]; then
    foot+=$A$(<$st/note)$R
  elif [[ -n $flash ]]; then foot+=$A$flash$R
  else
    enter_says
    [[ -n $REPLY ]] && foot+=$B$A"⏎ "$REPLY$UB$R$C"   ·   "$R
    foot+=$A"m"$R$C" MRs  "$A"b"$R$C" branches  "$A"d"$R$C" deploys  "$A"a"$R$C" runs  "$A"w"$R$C" worktrees  "$A"?"$R$C" keys"$R
  fi
  fr+=("$foot") fy+=($H)
  # No synchronized output (mode 2026) around it: a terminal under a
  # multiplexer (herdr) held every frame back behind it, which was a lag on
  # every key that nothing here could measure. Only the rows that changed go
  # out, so there is little to tear.
  # The diff is line for line, so a frame laid out differently (the list
  # grown or shrunk, the pane under it moved with it) is drawn whole: the
  # pane's lines kept where they were drawn repeated down the screen.
  local geom="$side $rows $py $ph $pw"
  [[ $geom == $shown_geom ]] || { shown_rows=(); shown_geom=$geom; }
  body=
  (( $#shown_rows )) || { body+=$e'[2J'; shown_pane=(); }
  for (( y = 1; y <= $#fr; y++ )); do
    [[ $fr[y] == "$shown_rows[y]" ]] && continue
    body+=$e"[$fy[y];1H"$fr[y]$R
    # A row with no pane beside it (the rules, the footer, a narrow screen)
    # clears to the edge; one with a pane leaves the pane's side be.
    (( y > rows || ! side )) && body+=$e'[K'
  done
  for (( y = 1; y <= $#pr; y++ )); do
    [[ $pr[y] == "$shown_pane[y]" ]] || body+=$e"[$(( py + y - 1 ));$(( px - 2 ))H  "$pr[y]$R$e'[K'
  done
  shown_rows=("${fr[@]}") shown_pane=("${pr[@]}")
  local t1=$EPOCHREALTIME
  print -rnu $tty -- $body
  print -r -- "$EPOCHREALTIME frame cur=$cur build=$(( int((t1 - t0) * 1000) )) write=$(( int((EPOCHREALTIME - t1) * 1000) )) bytes=${#body} key=${kt:+$(( int((EPOCHREALTIME - kt) * 1000) ))} keys=$nk last=${(q)lastkey}" >> $trace
  kt= nk=0
}

# --- keys ------------------------------------------------------------------
# run <fzf actions>: what a row key handed back, for the row in fld. execute
# takes the screen, execute-silent runs out of sight, and both mean the rows
# may have changed; a footer note is already in $st/note; the rest (reload,
# refresh-preview, rebind) are this loop's to do anyway.
typeset -a fld
run() {
  local s=$1 name arg i c q depth
  while [[ -n $s ]]; do
    if [[ $s == (#b)([a-z-]##)\(* ]]; then
      name=$match[1] s=${s#$name\(} depth=1 q=0
      for (( i = 1; i <= $#s; i++ )); do
        c=$s[i]
        if (( q )); then [[ $c == "'" ]] && q=0; continue; fi
        case $c in "'") q=1 ;; '(') (( depth++ )) ;; ')') (( --depth == 0 )) && break ;; esac
      done
      arg=${s[1,i-1]} s=${s[i+1,-1]}
    elif [[ $s == (#b)([a-z-]##):(*) ]]; then name=$match[1] arg=$match[2] s=
    else name=${s%%+*} arg= s=${s#$name}; fi
    s=${s#+}
    # {n}: the row's nth field, quoted, as fzf would; from the right, so
    # what a field says is never read for placeholders itself.
    local done_=
    while [[ $arg == (#b)(*)\{([0-9]##)\}(*) ]]; do done_=${(qq)fld[$match[2]]}$match[3]$done_ arg=$match[1]; done
    arg=$arg$done_
    case $name in
      execute) screen_off; sh -c "$arg" <&$tty >&$tty 2>&1; screen_on; refresh ;;
      execute-silent) sh -c "$arg" </dev/null >/dev/null 2>&1; refresh ;;
    esac
  done
}
# ask <command...>: a row key's command, in the background, since some ask
# GitLab first (merge checks the MR is ready): the footer says it is on it,
# the keys keep working, and what it hands back is run when it lands, for the
# row it was asked about. One at a time; a key meanwhile says so.
apid= afld=
ask() {
  if [[ -n $apid ]]; then flash="still on the last one…"; return; fi
  fields; afld=("${reply[@]}")
  { "$@" > $st/ask.new 2>/dev/null; mv -f $st/ask.new $st/ask } &!
  apid=$! flash="…"
}
answered() {
  [[ -n $apid ]] && ! kill -0 $apid 2>/dev/null || return 1
  apid= flash=
  fld=("${afld[@]}")
  [[ -s $st/ask ]] && run "$(<$st/ask)"
  rm -f $st/ask
  return 0
}
# The row, as otis-do takes it: kind, verb, extra, then gmr's fields.
act() {
  fields
  ask otis-do $1 "$reply[6]" "$reply[14]" "$reply[13]" "$reply[2]" "$reply[3]" "$reply[4]" "$reply[5]" "$reply[7]" "$reply[8]" "$reply[9]" "$reply[12]"
}
# --- the mouse -------------------------------------------------------------------
# The selection is share/screen.zsh's (sel, s1..s2 over P, the pane's lines,
# the preview with a blank line above it). px is the screen column the pane
# starts in.
integer px=0
# mouse <report>: a press, drag or release (the SGR form, \e[<b;x;yM, m on
# release). In the pane a press starts a selection, a drag carries it and
# the release copies it; a press in the list moves to the row. The wheel
# scrolls the pane over it, and moves through the rows over the list.
mouse() {
  local r=${1#$e\[<} b x y up
  [[ ${r[-1]} == m ]] && up=1
  r=${r[1,-2]}; b=${r%%;*}; r=${r#*;}; x=${r%%;*}; y=${r#*;}
  (( y > H - 2 )) && return
  # In the pane: beside the list, right of it; under it, below it.
  local inpane=0 l
  (( pw > 0 && (side ? x >= px : y >= py) )) && inpane=1
  (( l = y - py + 1 + poff ))
  if (( b == 64 || b == 65 )); then
    if (( inpane )); then scroll $(( b == 64 ? -3 : 3 ))
    elif (( b == 64 )); then (( cur > 1 )) && (( cur-- )); poff=0
    else (( cur < $#id )) && (( cur++ )); poff=0; fi
    return
  fi
  if (( inpane || (pw > 0 && sel == 2) )); then
    (( x < px )) && x=$px
    if (( b == 0 && ! up )); then sel=2 sa=$l ca=$(( x - px + 1 )) sb=$sa cb=$ca
    elif (( b == 32 && sel )); then sb=$l cb=$(( x - px + 1 ))
    elif (( up && sel == 2 )); then
      sb=$l cb=$(( x - px + 1 )); sel=1
      if (( sa == sb && ca == cb )); then sel=0; else ends; shown $pw; copy $REPLY.cont 1; fi
    fi
    (( sel )) && ends
    return
  fi
  if (( b == 0 && ! up && ! inpane )); then
    local at=$(( y + top ))
    (( at <= $#LI && LI[at] > 0 )) && { cur=$LI[at]; poff=0; sel=0; }
  fi
}

# handle: one key. 1 to quit.
handle() {
  [[ $1 == $e'[<'* ]] && { mouse "$1"; return; }
  [[ -n $apid ]] || flash=
  rm -f $st/note
  sel=0
  case $1 in
    j|$e'[B') (( cur < $#id )) && (( cur++ )); poff=0 ;;
    k|$e'[A') (( cur > 1 )) && (( cur-- )); poff=0 ;;
    g) cur=1 poff=0 ;;
    G) cur=$#id poff=0 ;;
    # ctrl-c is a key here (-isig), since a signal's trap would never run.
    q|$e|$'\x03') quit ;;
    $'\n'|$'\r') (( $#id )) && act enter ;;
    D) (( $#id )) && act dismiss ;;
    y) (( $#id )) && act copy ;;
    o) (( $#id )) && { fields; ask git-mr-do web "$reply[2]"; } ;;
    u) refresh --refresh; flash="refreshing from GitLab…" ;;
    m|b|a|d|w|c)
      screen_off
      case $1 in m) print gmr ;; b) print gb ;; a) print gag ;; d) print gd ;; w) print gw ;; c) print otis-config ;; esac
      rm -rf -- $st; exit 0 ;;
    '?') help=$(( !help )) poff=0 ;;
    $'\x04') scroll $(( ph / 2 )) ;;
    $'\x15') scroll $(( - ph / 2 )) ;;
    ' ') if (( $#id )); then
           screen_off
           otis-preview "$kind[cur]" "$iid[cur]" "$id[cur]" "$extra[cur]" 2>/dev/null | less -R
           screen_on
         fi ;;
  esac
}

screen_on
size
cur=1
refresh
draw
# Keys first: every key waiting is handled before the one draw after them,
# so a held j costs a frame per burst rather than per key. Between keys, a
# tick every 50ms takes in whatever landed: rows, previews, a key's answer.
integer tmo=5 stick=0
while :; do
  reply=()
  zselect -t $tmo -r $tty ${winch:+-r} $winch
  if [[ -n $winch ]] && (( ${reply[(I)$winch]} )); then
    sysread -s 64 -i $winch _
    resize
  fi
  if (( ${reply[(I)$tty]} )); then
    kt=$EPOCHREALTIME nk=1
    readkey; lastkey=$REPLY; handle $REPLY
    while zselect -t 0 -r $tty; do readkey; lastkey=$REPLY; handle $REPLY; (( nk++ )); done
    draw
  else
    float ti=$EPOCHREALTIME
    changed=0
    # Once a second: whatever opened this is still there (else it goes,
    # rather than read keys under a shell's prompt), and, without perl, the size.
    if (( EPOCHSECONDS != stick )); then
      stick=$EPOCHSECONDS
      orphaned && quit 1
      [[ -z $winch ]] && resize
    fi
    landed && changed=1
    answered && changed=1
    # A preview landed for the row on screen.
    (( pw > 0 && ! help )) && { shown $pw; [[ $REPLY != $lastpv ]] && changed=1; }
    (( EPOCHSECONDS - ltick >= 10 )) && { refresh; changed=1; }
    (( changed )) && draw
    # The size has held since the last resize: the previews at it.
    (( settle && EPOCHREALTIME >= settle )) && { settle=0; warm; }
    # The row you have stopped on, drawn if it is not kept yet; not while a
    # resize is still settling.
    (( ! help && ! settle )) && want $pw
    (( EPOCHREALTIME - ti > 0.02 )) && print -r -- "$EPOCHREALTIME upkeep $(( int((EPOCHREALTIME - ti) * 1000) ))ms changed=$changed" >> $trace
  fi
done
