#!/usr/bin/env -S zsh -f
# otis-dash: the dashboard, drawn by hand rather than as a picker's list.
#
# A board (otis-board): a change a row, and the row says the one move the
# change needs next, in words, before its title: review it, pipeline broke,
# answer 2 threads, merge it. The rows that want you come first, your drafts
# among them a step back, then what is moving without you and where you are.
# The MRs of a stack, each built on the one under it, are kept together,
# joined by a rail, the first to merge at the bottom. j and k pick the row;
# enter does what the row says (otis-do), and the footer says what that is.
#
# Beside the board on a wide screen, under it on a narrow one, the row the
# cursor is on in full (otis-preview): its merge request, how each gate it
# has to get through stands, in words (verify, pipeline, review, ship), and
# what the gate behind its move has to say. space reads all of the change in
# a pager.
#
# It is the one list of your work: under those rows, everything else there is
# (every other open MR, the branches with none, what shipped, what can be
# deleted, the worktrees, the deploys) sits in groups folded to a line each,
# which enter opens in place.
#
# What you do to a change is done here too, on its row: P walks it, V
# verifies it, c is its commits, m merges, b rebases, a asks reviewers, and
# so on. The keys are one table (KEYS): the footer, the ? help, the key log
# and what a key is called while it runs all read it, so they cannot
# disagree. The footer shows the same keys on every row.
#
# The row keys hand back fzf actions (execute(...), a footer note), since
# they are shared with the pickers; run() below carries out the few that
# they use, with the row's fields for fzf's {n} placeholders. Going to a
# branch or a worktree prints where and exits, for the otis function to do
# (it moves your shell, which a script cannot).
#
# Nothing a key starts holds the board (commands out, below): its command
# runs behind it, its row spinning with what is being done, and the keys go
# on working there and on every other row. A command that asks first (merge,
# rebase, push) asks in a box once it is ready and you are on its row, and
# the board is yours again the moment you answer, while it does the work.
# Only what is a screen of its own (a review, a pipeline's jobs, a pager)
# takes the terminal.
#
# It keeps itself fresh: the rows again every 10s from what is on this
# machine, and the forge asked behind it a minute apart while it is open
# (otis-list, git-cached-json), with when it last answered on the top line.
# u asks now, and waits for nothing: the rows are what is here at once, and
# each thing the forge answers changes them as it lands. The cursor stays on
# the row it was on.
#
# It keeps a line a frame (OTIS_DASH_TRACE, else ~/.cache/otis/dash.log): how
# long it took to build and to write, its size, and how long after the key
# that asked for it it was on the screen; and any upkeep between keys that
# took over 20ms. For when it feels slow: it says whether the time went here
# or in the terminal.
# typeset_silent: all this prints is what it hands the otis function to run
# (hub, leave), so a local named twice in a function must not print its value.
setopt extendedglob no_nomatch typeset_silent

[[ -n $OTIS_T_NAME && $OTIS_THEME == "$OTIS_T_WANT" ]] || eval "$(otis-theme --env)"
. ${0:A:h:h}/share/in-root.sh
in_root || eval "$(otis-config --env)"
# The forge by name, in what the screen says.
forge=GitLab
[[ $(otis-config forge) == github ]] && forge=GitHub
# The keys, in one table, four fields a key: the key; where ? lists it (move,
# change, mr or else); what the footer calls it, for the few the footer
# shows, the same on every row; and what it does in whole words, which is
# what ? says, what the key log calls it, and what the footer spins with
# while it runs. Nothing else in this file says what a key is for. (No
# commas in the words: the key log lists the keys with commas between.)
typeset -a KEYS=(
  'j k'    move   ''       'down and up'
  enter    move   ''       'do what the row says'
  space    move   ''       'read all of it in a pager'
  'g g  G' move   ''       'the top and the bottom'
  'h l'    move   ''       'fold a group or open it'
  '^d ^u'  move   ''       'scroll what the row says in full'
  '?'      move   ''       'show these keys'
  q        move   ''       'quit'
  V        change verify   'verify it in Cursor Cloud'
  P        change walk     'walk its tests line by line'
  c        change commits  'its commits'
  C        change ''       'Claude reviews or fixes it'
  f        change ''       'fold in a fix that is ready'
  p        change ''       'push it (asks first)'
  n        change ''       'open an MR for it'
  s        change ''       'switch to its branch'
  W        change ''       'its branch in its own worktree'
  w        change web      'open it in the browser'
  y        change link     'copy its link'
  x        change ''       'stop showing a verdict or a fix'
  d        change ''       'remove what can go (asks first)'
  o        mr     ''       'open it: review or its threads'
  J        mr     ''       'its pipeline: jobs and logs'
  a        mr     ''       'reviewers'
  A        mr     ''       'approve'
  L        mr     ''       'labels'
  m        mr     ''       'merge'
  b        mr     ''       'rebase, with any stack it is in'
  R        mr     ''       'draft or ready'
  X        mr     ''       'close'
  r        mr     ''       'retry the failed jobs'
  N        mr     ''       'a new pipeline'
  D        mr     ''       'Claude watches production'
  u        else   ''       "ask $forge now"
  'g b'    else   ''       'branches'
  'g c'    else   ''       'otis settings'
  'g s'    else   ''       'Slack'
  F        else   files    'find a file in your editor'
)
# KL: a key's whole words, by the key. The log is told every key the screen
# offers as it opens, less the ones that only move.
# KL: a key's whole words, by the key. keylist: every key the screen offers
# with its words, key=words with commas between, less the ones that only
# move: what the key log is told as the screen opens, and what --keys
# prints, for otis --help (otis-help).
typeset -A KL
keylist=
() {
  local k g f l
  for k g f l in "${KEYS[@]}"; do
    KL[$k]=$l
    [[ $g == move && $k != (enter|space|'?') ]] && continue
    keylist+=${keylist:+,}${k// /}=$l
  done
}
[[ $1 == --keys ]] && { print -r -- $keylist; exit 0; }
export OTIS_ROWFMT=$(<${0:A:h:h}/share/rowfmt.awk)
wrap_awk=$(<${0:A:h:h}/share/pane-wrap.awk)
# Not under a picker: the scripts that would post to one must not find one.
unset FZF_PORT FZF_API_KEY
export GIT_FZF_STATE=${TMPDIR:-/tmp}/otis-dash.$$.$RANDOM
mkdir -m 700 $GIT_FZF_STATE || exit 1
st=$GIT_FZF_STATE
mkdir $st/pv
# The last run's, kept past its end: when it felt slow, it is still there
# to read.
trace=${OTIS_DASH_TRACE:-${XDG_CACHE_HOME:-$HOME/.cache}/otis/dash.log}
mkdir -p ${trace:h} 2>/dev/null; : > $trace
# Opened once (tfd): a line a frame was the file opened and closed a frame,
# on a disk other work may be keeping busy.
exec {tfd}>>$trace

. ${0:A:h:h}/share/screen.zsh
keys_open otis $keylist
# The groups' names in one color that is not the grey of what is beside
# them, so the eye finds where each starts: the theme's yellow, the one its
# keys and ids are in.
SEC=$A
screen_start
# A window being dragged is a resize a step: each is drawn at once, and the
# previews wait until the size has held for 0.3s (settle), so a drag draws
# them once rather than every row at every width it passed through.
float settle=0
resize() {
  local oh=$H ow=$W
  size
  print -ru $tfd -- "$EPOCHREALTIME resize ${ow}x$oh -> ${W}x$H"
  (( H != oh || W != ow )) || return 1
  shown_rows=(); draw
  (( settle = EPOCHREALTIME + 0.3 ))
}

# --- the rows -------------------------------------------------------------
# otis-board's fields, one array a field, an entry a row. The lights are five
# to a row, the nth row's cth at (n-1)*5+c: its glyph and color, the kind,
# verb and directory otis-do takes, what enter does there in words, a mark
# beside it and the fix run the mark stands for, and how it stands in words
# (cw). None is drawn as a light: a row says its move (move, in the color
# tone), which is the light of it that wants you most (defc), and the words
# of all five are said under the board for the row the cursor is on.
typeset -a lane id type title who when mark defc iid target url source head base pipeline purl start mrkind draft verb note prog sub dots fold count say rail own gpos move tone
typeset -a cg cc ck cv ce cd cm cf cw
typeset -a gates=(local verify pipeline review ship)
# The groups that are open, by name: the rest are a line each.
typeset -A open
# How wide the moves are, so the titles after them start in one column: the
# board's own rows in mvw[-], a group's in mvw[<group>], each the longest
# move it has whether or not the group is open, so opening one moves nothing.
# And how wide their MR numbers are (iww, the same way), for a column of
# them at the right edge, the digits of one under the next's.
typeset -A mvw iww
integer n_need=0 n_draft=0 n_moving=0 col=1 fixkey=0
# A screen too short for the board as it is draws it tight: no blank lines
# between its parts. What the row says in full goes under the board, in a
# few lines only when that is all the room there is (brief, bs its mark in a
# kept preview's name).
integer tight=0 brief=0
bs=
loaded=0
load() {
  local line f c n=0 g
  lane=() id=() type=() title=() who=() when=() mark=() defc=() iid=() target=() url=() source=() head=() base=() pipeline=() purl=() start=() mrkind=() draft=() verb=() note=() prog=() sub=() dots=() fold=() count=() say=() rail=() own=() gpos=() move=() tone=()
  cg=() cc=() ck=() cv=() ce=() cd=() cm=() cf=() cw=()
  mvw=() iww=()
  for line in ${(f)"$(<$st/board)"}; do
    f=("${(@ps:\t:)line}")
    if [[ $f[1] == '#' ]]; then n_need=$f[2] n_draft=$f[3] n_moving=$f[4]; continue; fi
    lane+=("$f[1]") id+=("$f[2]") type+=("$f[3]") title+=("$f[4]") who+=("$f[5]") when+=("$f[6]") mark+=("$f[7]") defc+=("$f[8]")
    iid+=("$f[9]") target+=("$f[10]") url+=("$f[11]") source+=("$f[12]") head+=("$f[13]") base+=("$f[14]")
    pipeline+=("$f[15]") purl+=("$f[16]") start+=("$f[17]") mrkind+=("$f[18]") draft+=("$f[19]")
    for c in 0 8 16 24 32; do
      cg+=("$f[20+c]") cc+=("$f[21+c]") ck+=("$f[22+c]") cv+=("$f[23+c]") ce+=("$f[24+c]") cd+=("$f[25+c]") cm+=("$f[26+c]") cf+=("$f[27+c]")
    done
    verb+=("$f[60]") note+=("$f[61]") prog+=("$f[62]") sub+=("$f[63]") dots+=("$f[64]") fold+=("$f[65]") count+=("$f[66]") say+=("$f[67]")
    rail+=("$f[68]") own+=("$f[69]") move+=("$f[70]") tone+=("$f[71]")
    cw+=("$f[72]" "$f[73]" "$f[74]" "$f[75]" "$f[76]")
    # Where it is in its group, counted from the group's own row.
    if [[ -n $f[65] ]]; then gpos+=($(( ++n ))); else gpos+=(0); n=0; fi
    if [[ $f[3] != group ]]; then
      g=${f[65]:--}
      (( ${(m)#f[70]} > ${mvw[$g]:-0} )) && mvw[$g]=${(m)#f[70]}
      [[ -n $f[9] ]] && (( $#f[9] + 1 > ${iww[$g]:-0} )) && iww[$g]=$(( $#f[9] + 1 ))
    fi
  done
  loaded=1
}
# cell [row] [light]: in k, where that light is in the lights' arrays; with
# no arguments the cursor row's move (col, which go keeps as the row's defc).
integer k=0
cell() { (( k = (${1:-$cur} - 1) * 5 + ${2:-$col} )); }
# go <row>: the cursor there.
go() { cur=$1 col=${defc[$1]:-1} poff=0 reveal=; }
# The group just opened, until the cursor moves: its rows are brought into
# view under its line, which a move back onto that line later must not do.
reveal=
# A group opens and folds over 0.6s rather than at once, so the eye can
# follow what moved: its rows come out from its line down, and go back from
# the last up. foldg is the group on its way, foldn how many of its rows are
# out now, between foldfrom (when it started, at foldt) and foldto. Only the
# rows the board has room for (brows, its height as last drawn) are counted
# out over that time (to foldcap): the rest of a long group are off the
# screen, and counting them too had the ones you can see all out in the
# first fifth of a second.
foldg=
integer foldn=0 foldfrom=0 foldto=0 foldcap=0 brows=0
float foldt=0 folddur=0.6
# vis <row>: on the board now: not in a group that is folded, nor one of
# the rows still to come out of one that is opening.
vis() {
  local g=$fold[$1]
  [[ -z $g ]] && return 0
  [[ -n $open[$g] ]] || return 1
  [[ $g == $foldg ]] && (( gpos[$1] > foldn )) && return 1
  return 0
}
# folding: a fold is on its way, and where it has got to: 0 when none is.
# It eases out, quick at first and settling, and is done at foldto, where a
# group that was folding away is folded.
folding() {
  [[ -n $foldg ]] || return 1
  local -F p
  (( p = (EPOCHREALTIME - foldt) / folddur, p > 1 ? (p = 1) : 0 ))
  (( foldn = foldfrom + int((foldcap - foldfrom) * (1 - (1 - p) * (1 - p)) + (foldcap > foldfrom ? 0.999 : 0)) ))
  if (( p >= 1 )); then
    foldn=$foldto
    (( foldto == 0 )) && unset "open[$foldg]"
    foldg=
    warm
  fi
  return 0
}
# step <-1|1>: the cursor to the next row that way that is on the board.
step() {
  local i=$cur
  while (( i += $1, i >= 1 && i <= $#id )); do vis $i && { go $i; return; }; done
}
# parent <row>: in REPLY, the row of the group it is in.
parent() {
  local i
  for (( i = $1 - 1; i >= 1; i-- )); do [[ $type[i] == group && $lane[i] == $fold[$1] ]] && break; done
  REPLY=$i
}
# toggle <group>: open if it is folded, folded if it is open; the cursor on
# its line either way.
toggle() {
  local i n=0
  for (( i = 1; i <= $#id; i++ )); do [[ $type[i] == group && $lane[i] == $1 ]] && n=$count[i]; done
  # Another still on its way is where it was going, at once.
  [[ -n $foldg && $foldg != $1 ]] && { (( foldto == 0 )) && unset "open[$foldg]"; foldg=; }
  # One on its way already: it turns round from where it is.
  [[ $foldg == $1 ]] || foldn=$(( ${+open[$1]} ? n : 0 ))
  if [[ -n $open[$1] ]] && { [[ $foldg != $1 ]] || (( foldto > 0 )) }; then
    [[ -n $fold[cur] ]] && { parent $cur; go $REPLY; }
    foldto=0 foldcap=0 reveal=
    (( brows > 2 && foldn > brows - 2 )) && (( foldn = brows - 2 ))
  else
    open[$1]=1 foldto=$n reveal=$1 foldcap=$n
    (( brows > 2 && foldcap > foldn + brows - 2 )) && (( foldcap = foldn + brows - 2 ))
  fi
  foldg=$1 foldfrom=$foldn foldt=$EPOCHREALTIME
}
# The row the cursor is on and the light behind its move, as fzf numbers a
# gmr row's fields, for {n}. After f, the fix beside a light instead, as the
# run it is.
fields() {
  cell
  reply=("" "$iid[cur]" "$target[cur]" "$url[cur]" "$source[cur]" "$ck[k]" "$head[cur]" "$base[cur]" "$pipeline[cur]" "$purl[cur]" "$id[cur]" "$start[cur]" "$ce[k]" "$cv[k]")
  (( fixkey )) && reply[6]=run reply[13]=$cf[k] reply[14]=run
}

lpid= ltick=$EPOCHSECONDS lastsig=
# The branches and the worktrees, gb's and gw's own rows, for the local light
# and the groups. They are slower than the rest (a second or two), so they
# are on a clock of their own: as it opens, a minute apart, and on u. The
# worktrees are listed from the main checkout, as gw lists them.
bpid= btick=0
wmain=$(git-worktree-path main 2>/dev/null) whome=$(git rev-parse --show-toplevel 2>/dev/null)
relist() {
  [[ -n $bpid ]] && kill -0 $bpid 2>/dev/null && return
  { git-branch-list --switch $1 > $st/branches.new 2>/dev/null && mv -f $st/branches.new $st/branches.tsv
    ( cd ${wmain:-.} && GW_HERE=$whome GW_MAIN=$wmain git-worktree-list $1 ) > $st/worktrees.new 2>/dev/null && mv -f $st/worktrees.new $st/worktrees.tsv
  } >/dev/null &!
  bpid=$! btick=$EPOCHSECONDS
}
# They have landed: the board again with them, unless a refresh is on its
# way to make it anyway.
listed() {
  [[ -n $bpid ]] && ! kill -0 $bpid 2>/dev/null || return 1
  bpid=
  [[ -n $lpid ]] && kill -0 $lpid 2>/dev/null && return 1
  [[ -s $st/rows ]] || return 1
  { otis-board > $st/board.new 2>>$st/err && mv -f $st/board.new $st/board || : > $st/board.failed } >/dev/null &!
  lpid=$!
  return 1
}
cache=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)/git-alias-cache
# What the forge would not give the last time it was asked, for the line
# under the headline: why, in a line (git-forge why), and whether it is your
# login it no longer takes, which u then mends. From the marks
# git-cached-json leaves in the state (stale.<cache>, the cache's path in
# it), written again each time a cache whose last fetch failed is asked for,
# and taken down only when it is asked for again and has worked. A preview
# no longer on screen never asks again, so its mark stood after all was
# well: one whose error is gone goes here, and so does one nobody has asked
# for in a minute and a half once the forge has answered anything since its
# error, which is then about a time that has passed.
stale_why= again=0
integer stale_login=0
stale_read() {
  local f p
  local -a tm newest
  integer marked erred answered=-1
  stale_why= stale_login=0
  for f in $st/stale.*(N); do
    p=$(<$f)
    [[ -s $p.err ]] || { rm -f -- $f; continue; }
    if (( answered < 0 )); then
      answered=0 newest=($cache/*.json(Nom[1]))
      (( $#newest )) && { zstat -A tm +mtime -- $newest[1]; answered=$tm[1]; }
    fi
    zstat -A tm +mtime -- $f $p.err; marked=$tm[1] erred=$tm[2]
    (( EPOCHSECONDS - marked > 90 && answered > erred )) && { rm -f -- $f; continue; }
    [[ -n $stale_why ]] && continue
    stale_why=$(git-forge why $p.err 2>/dev/null); (( $? == 3 )) && stale_login=1
    [[ -n $stale_why ]] || stale_why="it did not say why"
  done
}
# What changes on this machine is seen as it happens, not at the next ten
# seconds' look: a run that finishes says so in its folder (status, ended),
# one that starts makes a folder, and a commit or a switch moves the
# checkout's HEAD. wpaths is those paths (not watch, which is zsh's own):
# the five folders runs are kept in, what a run a row is of writes when it
# ends or starts again, and the checkout's HEAD and its log. moved says
# they have changed since it last looked, five times a second. Not a run's
# folder itself, which one that is going writes into all the time, nor the
# index, which anything that so much as reads the checkout rewrites.
typeset -a wpaths
gdir=$(git rev-parse --absolute-git-dir 2>/dev/null)
watching() {
  local i c
  wpaths=(${cache:h}/(otis-verify|otis-walk|gmr-claude|gmr-fix|gmr-watch) $gdir/HEAD $gdir/logs/HEAD)
  for (( i = 1; i <= $#id; i++ )); do
    [[ -z $fold[i] ]] || continue
    for c in 1 2 3 4 5; do
      cell $i $c
      [[ $ce[k] == ${cache:h}/(otis-verify|otis-walk|gmr-claude|gmr-fix|gmr-watch)/* ]] && wpaths+=($ce[k]/status $ce[k]/ended $ce[k]/pid)
    done
  done
}
lastwatch= relook=0
float wtick=0
moved() {
  (( EPOCHREALTIME - wtick >= 0.2 )) || return 1
  wtick=$EPOCHREALTIME
  # Which of them are there, and when each last changed: one that appears
  # (a run's status, as it ends) is a change as much as one that moves.
  local -a tm have=(${^wpaths}(N))
  (( $#have )) || return 1
  zstat -A tm +mtime -- $have
  local sig="$have $tm"
  [[ $sig == $lastwatch ]] && return 1
  # The first look only notes them.
  [[ -n $lastwatch ]] || { lastwatch=$sig; return 1; }
  lastwatch=$sig
}
# The rows, then the board made of them. A board that could not be made
# says so (landed), rather than leave the screen looking for good.
refresh() {
  # u while one is on its way is not dropped: its refetch goes when that
  # one lands (landed), the footer spinning for it until then.
  if [[ -n $lpid ]] && kill -0 $lpid 2>/dev/null; then [[ $1 == --refresh ]] && again=1; return; fi
  { otis-list $1 > $st/rows.new 2>/dev/null && mv -f $st/rows.new $st/rows &&
    { otis-board > $st/board.new 2>>$st/err && mv -f $st/board.new $st/board || : > $st/board.failed } } >/dev/null &!
  lpid=$! ltick=$EPOCHSECONDS
}
# What it showed when it last closed (screen.zsh's memo): drawn at once, the
# dashboard early until otis-list's first rows land. Early, the previews and
# the row keys wait for them, since what they read under $st is otis-list's;
# a key pressed meanwhile (pend) runs when they land, on the row you are on.
memo=
integer early=0
typeset -a pend
[[ -n $OTIS_C_GITDIR ]] && { memo=$(print -rn -- "$PWD" | cksum); memo=$OTIS_C_GITDIR/git-alias-cache/screens/board7-${memo%% *}; }
at_leave() {
  [[ -n $memo && -s $st/board ]] && (( ! early )) || return
  local f n g
  local -A best
  mkdir -p ${memo:h} 2>/dev/null
  print -rn -- "$(<$st/board)" > $memo
  # Each light's newest preview at this width.
  for f in $st/pv/*.$pw.<->(N); do
    n=${f%.*} g=${f##*.}
    (( g > ${best[$n]:--1} )) && best[$n]=$g
  done
  local -a keep
  for n g in ${(kv)best}; do keep+=($n.$g); done
  memo_keep $keep
}
landed() {
  [[ -n $lpid ]] && ! kill -0 $lpid 2>/dev/null || return 1
  lpid=
  # The refresh u asked for is done; one asked for while this was on its
  # way starts now.
  stale_read
  if (( again )); then again=0; refresh --refresh; fi
  # Something moved here while these rows were being made: made again.
  (( relook )) && [[ -z $lpid ]] && { relook=0; refresh; }
  [[ -e $st/board.failed ]] && { rm -f $st/board.failed; flash="the board could not be made: $st/err says why"; }
  [[ -s $st/board ]] || return 1
  # The cursor stays on the row it was on, and what is under the board
  # where it was scrolled to.
  local was=$id[cur] wasoff=$poff i
  load
  watching
  go 1
  for (( i = 1; i <= $#id; i++ )); do
    [[ $id[i] == $was ]] || continue
    cur=$i col=$defc[i] poff=$wasoff
    break
  done
  vis $cur || { parent $cur; go $REPLY; }
  # The previews are drawn again only when what they are drawn from has
  # changed: the rows, less how long ago (which moves every minute), the
  # JSON otis-list left for them, and the threads. Most ticks it has not, and every kept
  # preview stands. When it has, the old ones are shown until the new are in.
  local sig= r
  local -a f
  for r in ${(f)"$(<$st/board)"}; do f=("${(@ps:\t:)r}"); f[6]=; sig+=${(pj:\t:)f}$'\n'; done
  sig+=$(cksum $st/{mrs,ci,ci-merged,deploys,marks,runs}.json(N) 2>/dev/null)
  # And each MR's threads, which a preview fetches when it draws and which
  # land after it (git-mr-threads --kick): their times, with no process.
  local -a tm; local tf
  for tf in $cache/mr-*-threads.json(N); do zstat -A tm +mtime -- $tf; sig+=$tf$tm[1]; done
  early=0
  if [[ $sig != $lastsig ]]; then
    lastsig=$sig
    (( gen++ ))
    local -a old=($st/pv/*.$(( gen - 2 ))(N))
    (( $#old )) && rm -f -- $old
    warm
  fi
  if (( $#pend )); then local -a p=($pend); pend=(); $p; fi
  return 0
}

# --- text ------------------------------------------------------------------
# A line is built from pieces whose widths are known (put, pad, share/screen.zsh),
# then kept with the row it is part of.
emit() { L+=("$line") LI+=($1) LU+=($used); line= used=0; }

# What enter does on the row, in the words the footer says it in
# (otis-board works it out): what its move opens. Where a fix is ready
# beside the move, folding that in, which is then what the row says.
enter_says() {
  cell; REPLY=$cd[k]
  [[ -n $cf[k] ]] && REPLY="fold in the fix"
  [[ $type[cur] == group ]] && REPLY=${${open[$lane[cur]]:+fold it}:-open it}
}

# A pipeline's jobs done, as a bar.
bar() {
  local d=${1%/*} t=${1#*/} n=10 k
  (( t > 0 )) || { REPLY=; return }
  (( k = d * n / t ))
  REPLY=${(l:k::━:)}
  REPLY=$G$REPLY$F${(l:n-k::─:)}
}

# --- the board -----------------------------------------------------------------
# L: its lines; LI: the row each is part of (0 for none), to keep the cursor
# in view; LU: how wide each is.
typeset -a L LI LU
# under <row> <width> <column> <color> <lines...>: what a row had more to say
# than its line held, whole, on lines of their own under where it began.
under() {
  local i=$1 w=$2 ind=$3 c=$4 s
  shift 4
  for s; do
    line= used=0
    # Under one of a stack the rail goes on down to the one it is built on.
    if [[ $type[i] == change && $rail[i] == (┌|├) ]]; then put "" "${(l:ind-2:: :)}"; put "$C" "│ "
    else put "" "${(l:ind:: :)}"; fi
    put "$c" "$s"; line+=$UB
    pad $w
    (( i == cur )) && line=$BG${line//$R/$R$BG}
    line+=$R
    emit $i
  done
}
# relkey <row>: the change a row is of, by both its names: ki its MR's
# number, kb its branch, which a run on a branch names in its note. The rows
# of the change the cursor is on (curi, curb) are marked, so a change and
# its runs, each a row of its own, are seen together. A run filed under the
# branch and its change's row under the MR are one change: the cursor's
# names are those of the change's own row when there is one, so either name
# finds the rest.
curi= curb= ki= kb=
relkey() {
  ki=${iid[$1]:+!$iid[$1]} kb=$source[$1]
  [[ -n $kb || $type[$1] != notice ]] || kb=$note[$1]
}
# related <row>: it is of the change the cursor is on.
related() {
  relkey $1
  [[ -n $curi && $ki == $curi ]] || [[ -n $curb && $kb == $curb ]]
}
row() {
  local i=$1 w=$2 on=0 s= t tc=$T nc=$C g=${fold[$1]:--}
  # What did not fit on the row's line, said under it from column mind: the
  # rest of its title (more), then what stands beside the title (more2).
  local -a more=() more2=()
  integer mind=0 rw=0 tx mw=${iww[$g]:-0} iw=0
  (( i == cur )) && on=1
  line= used=0
  # A command out for the row: its spinner where the row's mark is, and
  # what it is at where its move is, so nothing on the row moves aside for
  # it; the cursor's row is still the one with a ground. Else the cursor;
  # else another row of the change the cursor is on, with a thinner bar of
  # the cursor's color; else the branch you are on.
  local dw=
  integer at=0
  doing $i "$move[i]" && at=1 dw=$REPLY
  if (( at )); then put "$A" "$dglyph "
  elif (( on )); then put "$A" "▌ "
  elif [[ $type[i] != group ]] && related $i; then put "$A" "▎ "
  elif [[ -n $mark[i] ]]; then put "$EL" "▸ "; else put "" "  "; fi
  # A group's rows sit in from its line.
  [[ -n $fold[i] ]] && put "" "  "
  if [[ $type[i] == group ]]; then
    # A group folded to its line: how many are in it, and a word on them.
    put "$C" "${${open[$lane[i]]:+▾}:-▸} "
    tc=$SEC; (( on )) && tc=$B$SEC
    put "$tc" "${(r:18:: :)${(U)title[i]}}"; line+=$UB
    put "$T" "${(l:3:: :)count[i]}"
    if (( at )); then put "" "   "; put "$A" "$dw"
    elif [[ -n $say[i] ]]; then
      put "" "   "; mind=$used
      whole "$say[i]" $(( w - used - 1 )); put "$C" "$reply[1]"; more2=("${(@)reply[2,-1]}")
    fi
  else
    # Its move, in the color of how much it wants you. The titles start in
    # one column, after the longest move among the rows it sits with.
    (( tx = used + ${mvw[$g]:-0} + 2 ))
    (( on )) && line+=$B
    if (( at )); then put "$A" "$dw"; else put "${tone[i]:-$C}" "$move[i]"; fi
    line+=$UB
    # Words longer than the moves' column still stand clear of the title.
    (( used + 2 > tx )) && (( tx = used + 2 ))
    pad $tx
    # On the right: how long ago, where there is one to say, then its MR
    # number, in a column at the edge that every row it sits with keeps.
    [[ -n $when[i] ]] && rw=5
    (( mw )) && (( iw = mw + 2 ))
    case $type[i] in
      change)
        # One of a stack: its piece of the rail that joins the stack's rows,
        # each built on the one under it, the bottom one the first to merge.
        [[ -n $rail[i] ]] && put "$C" "$rail[i] "
        # A draft, one in review and what is only moving a step back, as is
        # one in a group or here only because its stack is; a branch with no merge request
        # in a branch's color.
        [[ ${own[i]:-$lane[i]} == (draft|sent|moving|waiting|unsent) || -n $fold[i] ]] && tc=$C
        [[ -z $iid[i] ]] && tc=$EL
        # A draft's title in the color of yours, under the cursor too.
        [[ -n $draft[i] ]] && tc=$Y
        (( on )) && tc=$B${${draft[i]:+$Y}:-$T}
        t=$title[i] ;;
      here)
        # The branch whole, then how it stands.
        cell $i 1
        tc=$B$EL t=${ce[k]:-$verb[i]}
        if [[ -n $note[i] ]]; then s=$note[i]; (( on )) && nc=$T
        else s="nothing to commit or push" nc=$G; fi ;;
      place)
        # A worktree: its name, then what is in it.
        (( on )) && tc=$B$T
        t=$title[i] s=$note[i] ;;
      *)
        # A run, a deploy, one that shipped: the MR it is of, what it is
        # about, and on the right a pipeline's jobs done.
        [[ $lane[i] == (move|prod) ]] || tc=$C
        (( on )) && tc=$B$T
        t=$title[i]
        # One of Claude's runs on a branch names the branch, then what it last said.
        [[ -n $note[i] ]] && t=$note[i]${t:+  ·  $t}
        # A verification's claims, a dot each, beside what it is running on.
        [[ -n $dots[i] ]] && s=$dots[i] nc=$Y
        [[ -n $prog[i] ]] && (( rw += 18 )) ;;
    esac
    mind=$used
    # A title that fits on its line only without what is on its right is
    # said without it: the title is what the row is. First how long ago
    # goes, then its number; under the board says both.
    if (( ${(m)#t} > w - used - iw - rw - 1 )); then
      if (( rw == 5 && ${(m)#t} <= w - used - iw - (iw ? 1 : 0) )); then rw=0
      elif (( rw <= 5 && ${(m)#t} <= w - used )); then rw=0 iw=0
      # Too long for a line whatever goes: with no number of its own, it
      # takes the numbers' column for its text.
      elif [[ -z $iid[i] ]]; then iw=0; fi
    fi
    # The title whole: what of it does not fit on the line goes on under
    # it. What stands beside it is on its line when both fit, else under.
    whole "$t" $(( w - used - iw - rw - (iw + rw ? 1 : 0) ))
    put "$tc" "$reply[1]"; line+=$UB; more=("${(@)reply[2,-1]}")
    if [[ -n $s ]]; then
      if (( ! $#more && used + 3 + ${(m)#s} <= w - iw - rw - 1 )); then put "" "   "; put "$nc" "$s"
      else whole "$s" $(( w - mind - 1 )); more2=("${reply[@]}"); fi
    fi
    if [[ -n $prog[i] ]]; then
      pad $(( w - iw - rw - 1 )); put "" "  "; bar "$prog[i]"; line+=$REPLY; (( used += 10 ))
      put "$C" " ${(l:5:: :)prog[i]}"
    fi
    (( rw )) && [[ -n $when[i] ]] && { pad $(( w - iw - 6 )); put "" "  "; put "$C" "${(l:3:: :)when[i]}"; }
    if (( iw )) && [[ -n $iid[i] ]]; then
      pad $(( w - 1 - mw ))
      (( on )) && put "$A" "${(l:mw:: :):-!$iid[i]}" || put "$C" "${(l:mw:: :):-!$iid[i]}"
    fi
  fi
  pad $w
  # The last rows out of a group on its way, faint: out, they come up to
  # their colors, and they go faint before they go.
  [[ -n $foldg && $fold[i] == $foldg ]] && (( gpos[i] > foldn - 2 )) && line=$F${line//$e\[[0-9;]#m/$F}
  (( on )) && line=$BG${line//$R/$R$BG}
  line+=$R
  emit $i
  # A run of Claude's says what it is doing now, under its row, when that
  # is more than its row said.
  if [[ $type[i] == notice && -n $sub[i] && $sub[i] != $title[i] ]]; then
    whole "› $sub[i]" $(( w - mind - 1 )); more2+=("${reply[@]}")
  fi
  # And so does a command out that takes a while (a push, under its hook):
  # the last thing it printed.
  if [[ -n $ojob[$id[i]] && -n $osaid[$ojob[$id[i]]] ]]; then
    whole "› $osaid[$ojob[$id[i]]]" $(( w - mind - 1 )); more2+=("${reply[@]}")
  fi
  (( $#more )) && under $i $w $mind "$tc" "${more[@]}"
  (( $#more2 )) && under $i $w $mind "$nc" "${more2[@]}"
}

# as_of: when the forge last answered for the merge requests (yours, and
# those asked of you: the older of the two), as HH:MM in REPLY, nothing
# where there is no forge. old is 1 once that is over five minutes ago, and
# fetching 1 while it is being asked now: an attempt begun in the last half
# minute that has neither landed nor failed.
integer fetching=0 old=0
as_of() {
  local f
  local -a tm
  integer at=0
  REPLY= fetching=0 old=0
  for f in $cache/ci-mine.json $cache/mrs-review.json; do
    [[ -s $f ]] || continue
    zstat -A tm +mtime -- $f
    (( at == 0 || tm[1] < at )) && at=$tm[1]
    if [[ -e $f.tried && $f.tried -nt $f && ! -s $f.err ]]; then
      zstat -A tm +mtime -- $f.tried
      (( EPOCHSECONDS - tm[1] < 30 )) && fetching=1
    fi
  done
  (( at )) || return 0
  (( EPOCHSECONDS - at > 300 )) && old=1
  strftime -s REPLY %H:%M $at
}
# headline: the right of the top line: how many moves are yours, and when the
# forge last answered, in the color for a thing to look at once that is long
# ago. In REPLY, its width in hw.
integer hw=0
headline() {
  local s t n=$(( n_need + n_draft ))
  if (( n == 0 )); then s=$B$G"nothing needs you"$UB$R hw=17
  elif (( n == 1 )); then s=$B$T"1 move"$UB$R hw=6
  else s=$B$T"$n moves"$UB$R hw=$(( $#n + 6 )); fi
  as_of
  if [[ -n $REPLY ]]; then
    t="as of $REPLY"
    (( fetching )) && t+=" ↻"
    s+=$C"  ·  "$R
    (( old )) && s+=$A$t$R || s+=$C$t$R
    (( hw += 5 + ${(m)#t} ))
  fi
  REPLY=$s
}

left() {
  local w=$1 i part last= sl
  L=() LI=() LU=()
  (( tight )) || { line= used=0; emit 0; }
  # The top line: the name, the project where there is room for it, and on
  # the right how many moves are yours and when the forge last answered.
  line= used=0
  put "" "  "; put "$B$T" "otis"; line+=$UB
  if (( loaded )); then
    headline
    [[ -n $OTIS_C_project ]] && (( 8 + ${(m)#OTIS_C_project} + 2 + hw + 2 <= w )) && { put "" "  "; put "$C" "$OTIS_C_project"; }
    pad $(( w - hw - 2 )); line+=$REPLY; (( used += hw ))
  elif [[ -n $OTIS_C_project ]]; then put "" "  "; put "$C" "$OTIS_C_project"; fi
  emit 0
  if (( ! loaded )); then
    line= used=0; emit 0
    line= used=0; put "" "  "; put "$C" "looking…"; emit 0
    return
  fi
  # The forge would not answer, so the board is what it said last: why, said
  # whole. A login it no longer takes is the one you can mend from here.
  if (( stale_login )); then
    line= used=0; put "" "  "; put "$B$X" "$forge login expired"; line+=$UB
    put "$C" "  ·  "; put "$A" "u"; put "$C" " logs in again"; emit 0
  elif [[ -n $stale_why ]]; then
    whole "could not refresh from $forge: $stale_why" $(( w - 4 ))
    for sl in $reply; do line= used=0; put "" "  "; put "$X" "$sl"; emit 0; done
  fi
  # What a command behind the board had to say (said), each whole, until
  # esc: red for what failed, the rest in the color of a thing to look at.
  local nt nc
  for nt in $notes; do
    nc=$A; [[ $nt == *(failed|could not|would not)* ]] && nc=$X
    whole "$nt" $(( w - 4 ))
    for sl in $reply; do line= used=0; put "" "  "; put "$nc" "$sl"; emit 0; done
  done
  (( $#notes )) && { line= used=0; put "" "  "; put "$A" "esc"; put "$C" " clears that"; emit 0; }
  # Why there is no forge in it, when there is none (otis-list's footer).
  local foot=${(S)${:-$(<$st/footer)}//$e\[[0-9;]#m/}
  if [[ $foot == *alone ]]; then
    line= used=0; put "" "  "; put "$C" "${foot##* · }"; emit 0
  fi
  (( tight )) || { line= used=0; emit 0; }
  # The rows, in three parts with a line between: what wants you, your
  # drafts among it, and under those yours that is in review; what is moving
  # without you, and where you are; then the groups, a line each, their rows
  # under it when open.
  curi= curb=
  if (( $#id )) && [[ $type[cur] != group ]]; then
    relkey $cur; curi=$ki curb=$kb
    for (( i = 1; i <= $#id; i++ )); do
      [[ $type[i] == change ]] && related $i || continue
      curi=$ki curb=$kb; break
    done
  fi
  for (( i = 1; i <= $#id; i++ )); do
    vis $i || continue
    if [[ $type[i] == group || -n $fold[i] ]]; then part=g
    elif [[ $lane[i] == (prod|review|move|draft|sent) ]]; then part=a
    else part=b; fi
    [[ -n $last && $part != $last ]] && (( ! tight )) && { line= used=0; emit 0; }
    row $i $w; last=$part
  done
}

# --- the preview pane ----------------------------------------------------------
# otis-preview for the row the cursor is on, cut to the pane, kept per row
# and width. One at a time in the background; the pane shows what is
# kept (even an old one) until it lands.
# A kept preview is named for the row and its light, the width and the
# generation of what it was drawn from (gen, one more whenever that changes,
# in landed). The pane shows the newest there is for the light while the
# current one renders, so a reload never blanks it. warm draws every row's,
# for the light the cursor would land on, the cursor's first, one after
# another in the background as soon as the rows are in, so moving to a row
# finds its preview kept; want draws the light you have stopped on if warm
# has not got to it. A render is running while its .tmp is there: made
# before it starts, moved into place when it is done, whatever it printed,
# so a preview that fails is not tried again and again.
gen=0 lastpv=
print "0 0" > $st/pv/gen
pvname() { REPLY=$st/pv/${${1//\//%}:-none}.$2; }
shown() {
  pvname "$id[cur]@$col$bs" $1
  local -a have=($REPLY.<->(Nom))
  # None at this width yet (a resize): the row's at the width it last had,
  # cut at the edge, rather than an empty pane until it is drawn again.
  (( $#have )) || have=(${REPLY%.*}.<->.<->(Nom))
  REPLY=${have[1]}
}
# states <row>: how each gate the row has to get through stands, in words, in
# a line, the one behind its move lit. In REPLY, for otis-preview to say
# under what the row is (OTIS_STATES).
states() {
  local c s= lc
  for c in 1 2 3 4 5; do
    cell $1 $c
    [[ -n $cw[k] ]] || continue
    lc=$cc[k]
    # A draft is not trying to go out: its pipeline is not news.
    [[ ${own[$1]:-$lane[$1]} == draft ]] && (( c == 3 )) && lc=$C
    [[ -n $s ]] && s+=$C"  ·  "$R
    if (( c == defc[$1] )); then s+=$lc$B$cw[k]$UB$R; else s+=$lc$cw[k]$R; fi
  done
  REPLY=$s
}
# render <width> <file> <row> <light>: otis-preview for a change, with what
# the light behind its move has to say, or for a row that is not a change as
# it ever was, wrapped to the pane (share/pane-wrap.awk), the pieces a line
# broke into beside it (.cont).
render() {
  local i=$3
  cell $3 $4
  if [[ $type[i] == change ]]; then
    states $3; cell $3 $4
    OTIS_BRANCH=$source[i] OTIS_BRIEF=${bs:+1} OTIS_STATES=$REPLY OTIS_FIX=${cf[k]:+$cm[k]} FZF_PREVIEW_COLUMNS=$1 FZF_PREVIEW_LINES=$H \
      otis-preview "$mrkind[i]" "$iid[i]" "$id[i]" "$ce[k]" $gates[$4] 2>/dev/null
  else
    FZF_PREVIEW_COLUMNS=$1 FZF_PREVIEW_LINES=$H otis-preview "$ck[k]" "$iid[i]" "$id[i]" "$ce[k]" 2>/dev/null
  fi | LC_ALL=C awk -v w=$1 -v cont=$2.cont.tmp "$wrap_awk" > $2.tmp
  mv -f $2.cont.tmp $2.cont
  mv -f $2.tmp $2
}
want() {
  local w=$1 f
  (( w > 0 && $#id && ! early )) || return 1
  [[ $type[cur] == group ]] && return 1
  pvname "$id[cur]@$col$bs" $w; f=$REPLY.$gen
  [[ -e $f || -e $f.tmp ]] && return 1
  : > $f.tmp
  render $w $f $cur $col >/dev/null &!
}
# A warm for an older generation, or another width, stops at its next row
# (pv/gen), rather than being killed mid-render and leaving a .tmp that
# would keep that preview from ever being drawn.
warm() {
  (( pw > 0 && $#id && ! early )) || return
  print -r -- "$gen $pw" > $st/pv/gen
  {
    local i j f g="$gen $pw"
    for (( j = 0; j < $#id; j++ )); do
      [[ $(<$st/pv/gen) == $g ]] || break
      (( i = (cur - 1 + j) % $#id + 1 ))
      [[ $type[i] != group ]] && vis $i || continue
      pvname "$id[i]@$defc[i]$bs" $pw; f=$REPLY.$gen
      [[ -e $f || -e $f.tmp ]] && continue
      : > $f.tmp
      render $pw $f $i $defc[i]
    done
  } >/dev/null &!
}

# --- the frame -------------------------------------------------------------------
top=0 help=0 flash= pre= notet=
# The pane's scroll: poff where it is; plen its lines, for where it stops.
integer poff=0 plen=0
# scroll <lines>: the wheel, ctrl-d and ctrl-u, in one frame. A glide sent a
# frame of the whole pane every 10ms, which under a multiplexer stuttered
# rather than glided.
scroll() {
  local max
  (( max = plen - ph, max < 0 ? (max = 0) : 0 ))
  (( poff += $1, poff > max ? (poff = max) : 0, poff < 0 ? (poff = 0) : 0 ))
}
# What is on the screen now, a line a row; emptied when the screen may no
# longer be it (back from another program), which draws it whole.
typeset -a shown_rows shown_pane
shown_geom=
# The layout: the board, and what the row the cursor is on says in full (the
# pane): beside the board from 160 columns (side), where a row and the pane
# both have the width; else under it, below a rule, on a screen tall enough
# for both; else the board alone, and space reads the row in a pager. rows
# is the board's height; the pane is pw wide and ph high, from row py,
# column px.
integer pw=0 side=0 py=1 ph=0 px=3
pfile=
# helpcell <key, a tab, its words | a tab, a heading | nothing>: one of them
# onto the line.
helpcell() {
  [[ -n $1 ]] || return 0
  if [[ $1 == $'\t'* ]]; then put "$C" "${(U)1#$'\t'}"
  else put "$A" "${(r:8:: :)${1%%$'\t'*}}"; put "$T" "${1#*$'\t'}"; fi
}
# helplines <width>: every key there is, from the table, in P: the keys that
# move and a merge request's on the left, a change's and the rest on the
# right, so ? is one screen and does not scroll. Too narrow for a key's
# words in half the screen, it is one column.
helplines() {
  local hk hg hf hl want e w=$1
  local -a lft rgt
  local -A head=(move moving mr "on a merge request" change "on a change" else elsewhere)
  integer half n i
  # A line between a column's two parts, where the screen has the lines.
  integer gap=$(( H >= 28 ))
  for want in move mr change else; do
    e=$'\t'$head[$want]
    if [[ $want == (move|mr) ]]; then (( gap && $#lft )) && lft+=(""); lft+=("$e")
    else (( gap && $#rgt )) && rgt+=(""); rgt+=("$e"); fi
    for hk hg hf hl in "${KEYS[@]}"; do
      [[ $hg == $want ]] || continue
      if [[ $want == (move|mr) ]]; then lft+=("$hk"$'\t'"$hl"); else rgt+=("$hk"$'\t'"$hl"); fi
    done
  done
  (( half = (w - 2) / 2 ))
  (( half < 39 )) && { lft+=("${rgt[@]}"); rgt=(); }
  (( n = $#lft > $#rgt ? $#lft : $#rgt ))
  P=()
  (( H > n + 3 )) && P=("")
  for (( i = 1; i <= n; i++ )); do
    line= used=0; put "" "  "
    helpcell "$lft[i]"
    (( $#rgt )) && { pad $(( 2 + half )); helpcell "$rgt[i]"; }
    P+=("$line$R")
  done
}
draw() {
  local t0=$EPOCHREALTIME
  local lw=$W y i f lo=0 hi=0 body foot rows avail hk hg hf hl
  pw=0 side=0 py=1 px=3 tight=0 brief=0 bs=
  (( avail = H - 2 ))
  # Beside it, the board is no wider than a row has words for (120): the
  # rest of a big screen is the pane's, which has lines that long.
  if (( W >= 160 && ! help )); then
    (( lw = W * 60 / 100, lw > 120 ? (lw = 120) : 0, pw = W - lw - 5, side = 1 ))
  fi
  left $lw
  if (( side )); then
    (( rows = avail, ph = rows, px = lw + 6 ))
    (( $#L > rows )) && { tight=1; left $lw; }
  else
    # No room beside the board: the pane goes under it. The board is as tall
    # as it is: drawn tight when that would leave what is under it less than
    # eight lines, and scrolling when even that leaves it under four. In
    # under ten lines the row says only its own part (brief). A screen under
    # 16 lines is all board, as is the ? help.
    (( $#L + 9 > avail )) && { tight=1; left $lw; }
    if (( avail >= 16 && ! help )); then
      (( ph = avail - $#L - 1, ph < 4 ? (ph = 4) : 0 ))
      (( rows = avail - ph - 1, py = rows + 2, pw = W - 4 ))
      (( ph < 10 )) && brief=1 bs=b
    else rows=$avail ph=0; fi
  fi
  brows=$rows
  # The cursor's row in view.
  local ghi=0
  for (( y = 1; y <= $#LI; y++ )); do
    (( LI[y] == cur )) && { (( lo == 0 )) && lo=$y; hi=$y; }
    # A group just opened: as many of its rows as fit come into view under
    # its line.
    [[ -n $reveal && $type[cur] == group && $lane[cur] == $reveal ]] && (( LI[y] > cur )) && [[ $fold[LI[y]] == $reveal ]] && ghi=$y
  done
  (( ghi > lo + rows - 2 )) && (( ghi = lo + rows - 2 ))
  (( ghi > hi )) && hi=$ghi
  # The board scrolls only as far as it takes to keep the cursor's row on
  # it, never back to its top because the row would fit there: a jump loses
  # your place. Going up, what is over the row comes with it (the line
  # between the board's parts, the top line over the first row).
  (( hi > top + rows )) && (( top = hi - rows ))
  if (( lo > 0 && lo <= top )); then
    y=$lo; while (( y > 1 && LI[y-1] == 0 )); do (( y-- )); done
    (( top = y - 1 ))
  fi
  (( top > $#L - rows )) && (( top = $#L - rows ))
  (( top < 0 )) && top=0
  if (( help )); then
    # The keys are the screen: no board under them, nothing beside them.
    helplines $lw
    plen=$#P pfile=
    L=("${(@)P[1+poff,-1]}") LU=("${(@)L/*/$lw}") LI=() top=0
  elif (( pw > 0 )); then
    if (( $#id )) && [[ $type[cur] == group ]]; then
      # A group has nothing to say but what it is.
      P=("${B}${SEC}${(U)title[cur]}${UB}${R}  ${T}$count[cur]${R}")
      [[ -n $say[cur] ]] && P+=("${C}$say[cur]${R}")
      P+=("" "${C}⏎ ${${open[$lane[cur]]:+folds it away}:-opens it here}${R}")
      d_says; [[ -n $REPLY ]] && P+=("${C}d $REPLY, asking first${R}")
      (( brief )) || P=("" "${P[@]}")
      panewrap $pw
      plen=$#P pfile= lastpv=
    elif (( $#id )); then
      # Read and split once when it lands, not every frame: a frame of a
      # scroll is then the lines it shows and nothing else.
      shown $pw; lastpv=$REPLY
      if [[ $REPLY != $pfile || -z $pfile ]]; then
        pfile=$REPLY
        if [[ -n $REPLY ]]; then P=("${(@f)$(<$REPLY)}"); else P=("${C}…${R}"); fi
        # A blank line over it, where there are lines to spare.
        (( brief )) || P=("" "${P[@]}")
        # One kept from another width, until this width's lands: cut to the pane.
        [[ ${pfile:t} == *.(#b)(<->).<-> && $match[1] != $pw ]] && clip $pw
      fi
      plen=$#P
    else P=() pfile=; fi
  else P=() pfile=
  fi
  # The frame, a line a screen row, and then only the rows that differ from
  # the last frame go out: a move is the two rows it changes and what is
  # under the board, a reload the rows it changed, rather than the whole
  # screen every time, which a terminal under a multiplexer (herdr, tmux)
  # parses and draws every byte of. fr the board's lines, the rules and the
  # footer, fy the screen row of each; pr the pane's.
  local -a fr fy pr
  local s
  for (( y = 1; y <= rows; y++ )); do
    i=$(( y + top ))
    if (( i <= $#L )); then s=$L[i]$R; (( LU[i] < lw )) && s+=${(l:lw-LU[i]:: :)}
    else s=${(l:lw:: :)}; fi
    (( side )) && s+=$R"  "$F"│"$R
    fr+=("$s") fy+=($y)
  done
  (( pw > 0 && ! side )) && { fr+=("$F${(l:W::─:)}$R"); fy+=($(( rows + 1 ))); }
  for (( y = 1; y <= ph && pw > 0; y++ )); do
    f=$(( y + poff )) s=
    if (( f <= $#P )); then
      if (( sel && f >= s1 && f <= s2 )); then selected $f; s=$REPLY; else s=$P[f]; fi
    fi
    pr+=("$s")
  done
  fr+=("$F${(l:W::─:)}$R") fy+=($(( H - 1 )))
  # The footer: a note if a key left one, else what enter does on the row
  # (and d, where it removes), then the same few keys on every row, the
  # ones used most; ? has them all.
  foot="  "
  # A note or a flash stays until the next key: a preview landing redraws
  # the frame, and a note gone then was gone before it was read.
  if [[ -s $st/note ]]; then
    [[ -n $notet ]] || notet=$EPOCHREALTIME
    foot+=$A$(<$st/note)$R
  elif working; then foot+=$A$REPLY$R" "$T${flash%…}$R$C"…"$R
  elif [[ -n $flash ]]; then foot+=$A$flash$R
  elif (( help )); then foot+=$A"?"$R$C" or "$R$A"q"$R$C" back to the board"$R
  else
    enter_says
    [[ -n $REPLY ]] && foot+=$B$A"⏎ "$REPLY$UB$R
    local lead=$REPLY
    d_says; [[ -n $REPLY ]] && foot+=${lead:+"   "}$A"d"$R$C" ${${REPLY/removes/remove}/forgets/forget}"$R
    [[ -n $lead$REPLY ]] && foot+="   "
    local -a hint
    for hk hg hf hl in "${KEYS[@]}"; do [[ -n $hf ]] && hint+=("${A}$hk$R$C $hf"); done
    # On a narrow screen the last of them go, never ?: it lists them all.
    while vw "$foot${(j:  :)hint}  ? all"; (( REPLY > W && $#hint > 0 )); do hint[-1]=(); done
    foot+=${(j:  :)hint}${hint:+"  "}"$A?$R$C all$R"
  fi
  fr+=("$foot") fy+=($H)
  # No synchronized output (mode 2026) around it: a terminal under a
  # multiplexer (herdr) held every frame back behind it, which was a lag on
  # every key that nothing here could measure. Only the rows that changed go
  # out, so there is little to tear.
  # The diff is line for line, so a frame laid out differently (the board
  # grown or shrunk, what is under it moved with it) is written whole, every
  # line over what is there: a clear first would blink, a frame of a fold.
  local geom="$side $rows $py $ph $pw"
  if [[ $geom != $shown_geom ]]; then
    shown_geom=$geom
    if (( $#shown_rows )); then shown_rows=(); repeat $H shown_rows+=($'\0'); shown_pane=("${shown_rows[@]}"); fi
  fi
  body=
  (( $#shown_rows )) || { body+=$e'[2J'; shown_pane=(); }
  for (( y = 1; y <= $#fr; y++ )); do
    [[ $fr[y] == "$shown_rows[y]" ]] && continue
    body+=$e"[$fy[y];1H"$fr[y]$R
    # A row with the pane beside it leaves the pane's side be; the rest (the
    # rules, the footer, a narrow screen's rows) clear to the edge.
    (( side && y <= rows )) || body+=$e'[K'
  done
  for (( y = 1; y <= $#pr; y++ )); do
    [[ $pr[y] == "$shown_pane[y]" ]] || body+=$e"[$(( py + y - 1 ));$(( px - 2 ))H  "$pr[y]$R$e'[K'
  done
  shown_rows=("${fr[@]}") shown_pane=("${pr[@]}")
  local t1=$EPOCHREALTIME
  print -rnu $tty -- $body
  print -ru $tfd -- "$EPOCHREALTIME frame cur=$cur build=$(( int((t1 - t0) * 1000) )) write=$(( int((EPOCHREALTIME - t1) * 1000) )) bytes=${#body} key=${kt:+$(( int((EPOCHREALTIME - kt) * 1000) ))} keys=$nk last=${(q)lastkey}"
  kt= nk=0
}

# --- commands out -------------------------------------------------------------
# A key's command never holds the board. It is out behind it (ask, behind):
# any number at once, each for the row its key was pressed on, which spins
# with what is being done to it (doing) until that is over, while the keys go
# on working, on that row and every other.
#
# What a command hands back is fzf's actions, the row keys being shared with
# the pickers, and run carries them out for the row they were asked about,
# execute and execute-silent each a command in its turn. One that only asks
# and then works (BEHIND) goes on behind the board, with no terminal: what it
# asks (git-confirm, otis-popup) it leaves in its folder (OTIS_ASK), and the
# board asks it in a box once you are on its row and have stopped typing
# (asked, serve). The answer given, the board is yours again while the
# command does the work. What it would have said in a box when something
# went wrong goes under the top line instead (said, notes), until esc. Only a
# command that is a screen of its own (a review, a pipeline's jobs, a pager)
# takes the terminal, as it must.
#
# BEHIND: the commands that only ask and then work, by how their line starts,
# and what a row says while one is at it.
typeset -a BEHIND=(
  'git-ci-merge *'                    merging
  'git-mr-rebase *'                   rebasing
  'git-stack --update *'              rebasing
  'git-ci-run *'                      'new pipeline'
  'git-ci-retry *'                    retrying
  'git-verify --start *'              starting
  'git-mr-approve *'                  approving
  'git-mr-close *'                    closing
  'git-mr-do flip *'                  marking
  'git-branch-push *'                 pushing
  'git-branch-delete *'               removing
  '(cd * && |)git-worktree-remove *'  removing
  'git-agent-list --forget *'         forgetting
  'otis-do confirm *'                 clearing
)
behindable() {
  local p w
  for p w in "${BEHIND[@]}"; do [[ $1 == ${~p} ]] && { REPLY=$w; return 0; }; done
  return 1
}
# The commands out, by number (outs, the folder of each $st/out/<n>): the row
# each is for (orow, and ojob the newest for a row), its key's words (owhat),
# the row's fields as they were when it was pressed (ofld), what it is at
# once it works behind the board (odo), the actions still to come after that
# (orest), since when (ot0), and the last thing a long one printed (osaid).
# oj is the one whose actions run is carrying out.
integer oj=0 outn=0
typeset -a outs notes
typeset -A orow ojob owhat ofld odo orest ot0 osaid
# When the last key came: a box asks nothing under your typing (asked).
float keyt=0
ospun=
# out_new <label>: a command out for the row the cursor is on, its number in
# REPLY. 1 when that key's is still out for that row.
out_new() {
  local n
  for n in $outs; do
    [[ $orow[$n] == $id[cur] && $owhat[$n] == $1 ]] && { flash="still at it: $1"; return 1; }
  done
  (( n = ++outn )); outs+=($n)
  fields
  orow[$n]=$id[cur] owhat[$n]=$1 ofld[$n]=${(pj:\0:)reply} ot0[$n]=$EPOCHREALTIME odo[$n]= orest[$n]= osaid[$n]=
  ojob[$id[cur]]=$n
  mkdir -p $st/out/$n
  REPLY=$n
}
# ask <label> <command...>: a row key's command, which hands back actions:
# some ask GitLab first (merge checks the MR is ready).
ask() {
  out_new "$1" || return
  local d=$st/out/$REPLY
  { "${@:2}" > $d/ask.new 2>/dev/null; mv -f $d/ask.new $d/ask } >/dev/null &!
}
# behind <label> <command line>: one that only asks and then works, straight
# from its key (p, d).
behind() {
  out_new "$1" || return
  oj=$REPLY; work "$2"
}
# work <command line>: the next command of that one (oj), behind the
# board: no terminal, what it prints kept (log), how it ended left when it
# has (rc).
work() {
  local d=$st/out/$oj
  behindable "$1" && odo[$oj]=$REPLY || odo[$oj]=$owhat[$oj]
  { OTIS_ASK=$d OTIS_FRAME= OTIS_LOADER= sh -c "$1" </dev/null >>$d/log 2>&1; print -r -- $? > $d/rc.new; mv -f $d/rc.new $d/rc } >/dev/null &!
}
# follow <n> <actions>: what its command handed back, or what was still to
# come after one that worked behind the board, carried out for the row it
# was asked about. With none of it out any more, it is over.
follow() {
  oj=$1 fld=("${(@ps:\0:)ofld[$1]}") odo[$1]= orest[$1]=
  run "$2"
  [[ -n $odo[$1] ]] || drop $1
}
drop() {
  local n r=$orow[$1]
  outs=(${outs:#$1})
  rm -rf -- $st/out/$1
  unset "orow[$1]" "owhat[$1]" "ofld[$1]" "odo[$1]" "orest[$1]" "ot0[$1]" "osaid[$1]"
  # Its row is another's still out for it, if one is.
  ojob[$r]=
  for n in $outs; do [[ $orow[$n] == $r ]] && ojob[$r]=$n; done
}
# said <n>: what it would have said in a box (otis-popup say), onto the lines
# under the top one: in a line, with the change it is about.
said() {
  local f t ref
  local -a fl=("${(@ps:\0:)ofld[$1]}") ls
  for f in $st/out/$1/said.<->(N); do
    ls=()
    for t in "${(@f)$(<$f)}"; do plain "$t"; t=${${REPLY##[[:space:]]#}%%[[:space:]]#}; [[ -n $t ]] && ls+=("$t"); done
    rm -f -- $f
    t=${(j: · :)ls}
    [[ -n $t ]] || continue
    ref=${fl[2]:+!$fl[2]}; ref=${ref:-$fl[5]}
    [[ -z $ref || $t == *$ref* ]] || t="$ref $t"
    (( ${notes[(Ie)$t]} )) || notes+=("$t")
  done
}
# outs_in: the commands out that have come back, each taken up. 0 when any
# has, or has said something.
outs_in() {
  local n d f
  integer any=1 was=$#notes
  for n in $outs; do
    d=$st/out/$n
    if [[ -e $d/ask ]]; then
      any=0; f=$(<$d/ask); rm -f $d/ask
      follow $n "$f"
    elif [[ -e $d/rc ]]; then
      any=0; rm -f $d/rc $d/busy
      said $n
      # What it did may have changed the rows, here and on the forge's side,
      # which is asked again (again, in landed); and what it removed, the
      # branches and the worktrees.
      refresh; again=1
      [[ $odo[$n] == removing ]] && relist --refresh
      follow $n "$orest[$n]"
    else said $n
    fi
  done
  (( $#notes != was )) && any=0
  return $any
}
# asked: one of them has a question, and you are there to be asked it: on its
# row, or its row has left the board, and no key in the last 0.4s, so its box
# never comes up under a key meant for the board. 0 when it was asked.
asked() {
  local n i
  (( $#outs )) && (( EPOCHREALTIME - keyt >= 0.4 )) || return 1
  for n in $outs; do
    [[ -e $st/out/$n/q ]] || continue
    if [[ $id[cur] != $orow[$n] ]]; then
      i=${id[(ie)$orow[$n]]}
      (( i <= $#id )) && vis $i && continue
    fi
    serve $n; return 0
  done
  return 1
}
# serve <n>: its question, in a box over the board (otis-popup, the frame
# held under it as run_tty does), and the answer left for it: how the box
# ended, and under that anything typed into it. The box takes no key typed
# before it was up, nor for a moment after (OTIS_GRACE).
serve() {
  local d=$st/out/$1 mode msg text a rc
  mode=$(<$d/q) msg=$(<$d/q.msg) text=$(<$d/q.text)
  rm -f $d/q
  while zselect -t 0 -r $tty; do readkey; done
  screen_hold $st/frame
  trap '' INT
  a=$(OTIS_ASK= OTIS_GRACE=1 OTIS_FRAME=$st/frame otis-popup $mode "$msg" "$text" 2>/dev/null); rc=$?
  trap 'quit 1' INT
  rm -f -- $st/frame
  screen_on over
  print -r -- $rc > $d/a.new; [[ -n $a ]] && print -r -- "$a" >> $d/a.new
  mv -f $d/a.new $d/a
  keyt=$EPOCHREALTIME
}
# doing <row> <its move>: what a command out for the row is at, in REPLY: its
# own word for the work (merging), and until it has got that far the row's
# move; and in dglyph the spinner's frame now. Once it has asked and is
# waiting for you to be there, "answer" and a ?. 1 with none out, or none
# for long enough (0.15s) to say so rather than blink.
dglyph=
doing() {
  local n=$ojob[$id[$1]]
  [[ -n $n ]] || return 1
  [[ -e $st/out/$n/q ]] && { REPLY=answer dglyph="?"; return 0; }
  (( EPOCHREALTIME - ot0[$n] >= 0.15 )) || return 1
  spin_frame; dglyph=$REPLY REPLY=${odo[$n]:-$2}
}
# busy_says: what each long one last printed (the log otis-popup busy named
# for it), and for how long it has been at it; once a second. 0 when one of
# them has something new to say.
busy_says() {
  local n l line took
  integer secs new=1
  for n in $outs; do
    [[ -s $st/out/$n/busy ]] || continue
    line=
    for l in ${(Oa)${(f)"$(tail -c 2048 -- "$(<$st/out/$n/busy)" 2>/dev/null)"}}; do
      l=${l%%$'\r'#}; plain "${l##*$'\r'}"; l=${REPLY//[[:cntrl:]]/ }
      l=${${l##[[:space:]]#}%%[[:space:]]#}
      [[ -n $l ]] && { line=$l; break; }
    done
    (( secs = EPOCHREALTIME - ot0[$n] ))
    took=${secs}s; (( secs >= 60 )) && took="$(( secs / 60 ))m ${(l:2::0:)$(( secs % 60 ))}s"
    line="$took${line:+  $line}"
    [[ $line != $osaid[$n] ]] && { osaid[$n]=$line; new=0; }
  done
  return $new
}

# --- keys ------------------------------------------------------------------
# run <fzf actions>: what a row key handed back, for the row in fld and the
# command out they came from (oj). execute takes the screen, unless its command only
# asks and then works (BEHIND); that one, and execute-silent, goes on behind
# the board, and the actions after it wait until it is back (orest). All mean
# the rows may have changed. A footer note is already in $st/note; the rest
# (reload, refresh-preview, rebind) are this loop's to do anyway.
typeset -a fld
run() {
  local s=$1 name arg i c q depth
  while [[ -n $s ]]; do
    if [[ $s == (#b)([a-z-]##)\(* ]]; then
      name=$match[1] s=${s#$name\(} depth=1 q=0
      for (( i = 1; i <= $#s; i++ )); do
        c=$s[i]
        if (( q )); then [[ $c == "'" ]] && q=0; continue; fi
        case $c in "'") q=1 ;; '(') (( depth++ )) ;; ')') (( --depth == 0 )) && break ;; esac
      done
      arg=${s[1,i-1]} s=${s[i+1,-1]}
    elif [[ $s == (#b)([a-z-]##):(*) ]]; then name=$match[1] arg=$match[2] s=
    else name=${s%%+*} arg= s=${s#$name}; fi
    s=${s#+}
    # {n}: the row's nth field, quoted, as fzf would; from the right, so
    # what a field says is never read for placeholders itself.
    local done_=
    while [[ $arg == (#b)(*)\{([0-9]##)\}(*) ]]; do done_=${(qq)fld[$match[2]]}$match[3]$done_ arg=$match[1]; done
    arg=$arg$done_
    case $name in
      execute|execute-silent)
        if [[ $name == execute ]] && ! behindable "$arg"; then
          # A screen of its own. What it did may have changed the forge's
          # side too: the rows at once from what is here, then the forge
          # asked (again, in landed).
          bykey=$owhat[$oj]; run_tty "$arg" sh; bykey=; refresh; again=1
        else orest[$oj]=$s; work "$arg"; return; fi ;;
    esac
  done
}
# working: a key pressed before the rows were in, or the refresh u asked
# for, has been out long enough (0.15s) for the footer to spin, rather than
# blink on every key; in REPLY the spinner's frame now, ten a second. A
# command out spins on its row instead (doing).
# uask: u has asked the forge, 1 until it is seen being asked and 2 from
# then until it has answered (as_of's fetching), which is when the footer
# stops saying so; ut when u was pressed, for a forge that is never asked.
float at0=0 ut=0
integer uask=0
working() {
  { (( $#pend )) || { (( uask )) && [[ $flash == "refreshing from $forge…" ]] }; } && (( EPOCHREALTIME - at0 >= 0.15 )) || return 1
  spin_frame
}
# The light, as otis-do takes it: kind, verb, extra, then gmr's fields.
act() {
  (( early )) && { pend=(act $1 "$2"); flash=$2… at0=$EPOCHREALTIME; return }
  fields
  ask "$2" otis-do $1 "$reply[6]" "$reply[14]" "$reply[13]" "$reply[2]" "$reply[3]" "$reply[4]" "$reply[5]" "$reply[7]" "$reply[8]" "$reply[9]" "$reply[12]"
}
# --- a change's keys ---------------------------------------------------------------
# rask <key> <command...>: a key whose command hands back fzf actions (its
# --check mode, written for a picker's transform), asked in the background, the
# footer spinning with the key's words (KL) meanwhile.
rask() { keys_used $1 "$KL[$1]"; ask "$KL[$1]" "${@:2}"; }
# rtty <key> <command line>: one that takes the terminal itself, as gb's
# execute did; the rows and the branches may have changed after it, here and
# on the forge, which is asked again.
rtty() { keys_used $1 "$KL[$1]"; bykey=$KL[$1]; run_tty "$2" sh; bykey=; refresh; again=1; relist --refresh; }
# rbehind <key> <command line>: one that only asks and then works, behind
# the board.
rbehind() { keys_used $1 "$KL[$1]"; behind "$KL[$1]" "$2"; }
# rowkey <key>: a key that acts on the change the row is, an open MR or a
# branch (what that key does in gb, by the same scripts). Where you are
# (the here row) is the branch you are on, and takes what gb's row for it
# took. 1 when it is not such a key, or the row is not one it acts on.
# Enter is the row's move; each of the gates behind it has a key of its own
# whatever the move is: s its branch, V its verification, J its pipeline's
# jobs, o the merge request, m merging it.
rowkey() {
  (( $#id )) || return 1
  # The rows are still the last screen's (early): a change's key waits for
  # the ones being made, as enter does, and is pressed then, on the row the
  # cursor is on. It was refused before, as a key the row had nothing for.
  if (( early )); then
    [[ $1 == (P|V|C|c|p|n|W|s|o|J|m|b|A|R|X|L|a|r|N|D) ]] || return 1
    pend=(handle $1); flash="$KL[$1]…" at0=$EPOCHREALTIME
    return 0
  fi
  local i=$iid[cur] br=$source[cur] kind=$mrkind[cur] mr= own= asb=
  # An open MR (mr), yours (own); a branch, with no MR or the one you are
  # on (asb); or one that shipped.
  [[ $type[cur] == change && -n $i && $kind != run ]] && mr=1
  [[ -n $mr && $kind == mine ]] && own=1
  [[ -z $mr && -n $br ]] && [[ $type[cur] == (change|here) ]] && asb=1
  [[ $type[cur] == change || $kind == merged || -n $asb ]] || return 1
  case $1 in
    # What either has to find out before it has anything to open or to ask
    # (whether the tests can be traced, whether a run is there already) is
    # found out behind the board.
    P) if [[ -n $mr ]]; then rask P git-walk --check $kind $i "$head[cur]" "$base[cur]"
       elif [[ -n $asb ]]; then rask P git-walk --check-branch "$br"
       else return 1; fi ;;
    V) if [[ -n $mr ]]; then rask V git-verify --ask $kind "$i" "$br"
       elif [[ -n $asb ]]; then rask V git-verify --ask "$kind" "$i" "$br" 1
       else return 1; fi ;;
    C) if [[ -n $mr ]]; then rask C git-mr-do claude $kind $i "$target[cur]" "$url[cur]" "$br" "$head[cur]" "$base[cur]" "$pipeline[cur]" "$start[cur]"
       elif [[ -n $asb ]]; then rtty C "git-branch-fix ${(q)br} ${(q)i}"
       else return 1; fi ;;
    c) [[ -n $br ]] && [[ $type[cur] == (change|here) ]] || return 1; rtty c "git-branch-log ${(q)br}" ;;
    p) [[ -n $br && $kind != review ]] && [[ $type[cur] == (change|here) ]] || return 1; rbehind p "git-branch-push ${(q)br}" ;;
    n) [[ -n $asb ]] && [[ -z $i || $type[cur] == here ]] || return 1; rask n git-mr-new --check $br "$i" ;;
    W) [[ $type[cur] == change && -n $br ]] || return 1; keys_used W "$KL[W]"; leave gotow "$br" ;;
    s) [[ $type[cur] == change && -n $br ]] || return 1
       [[ -n $mark[cur] ]] && { flash="you are on it"; return 0; }
       keys_used s "$KL[s]"; leave goto "$br" ;;
    o) [[ -n $mr ]] || return 1; rask o git-mr-do open $kind $i "$target[cur]" "$url[cur]" "$br" "$head[cur]" "$base[cur]" "$pipeline[cur]" "$start[cur]" ;;
    J) [[ -n $mr && -n $pipeline[cur] ]] || return 1; rask J git-ci-do jobs "$pipeline[cur]" $i ;;
    m) [[ -n $own ]] || return 1; rask m git-ci-merge --check $i ;;
    b) [[ -n $mr ]] || return 1; rask b git-mr-rebase --check $kind $i ;;
    A) [[ -n $mr ]] || return 1; rask A git-mr-do approve $kind $i "$head[cur]" "$base[cur]" ;;
    R) [[ -n $own ]] || return 1; rask R git-mr-do draft $kind $i ;;
    X) [[ -n $own ]] || return 1; rask X git-mr-do close $kind $i ;;
    L) [[ -n $mr ]] || return 1; rask L git-mr-do labels $i 'execute-silent(:)' ;;
    a) [[ -n $mr ]] || return 1; rask a git-mr-do reviewers $i 'execute-silent(:)' ;;
    r) [[ -n $mr ]] || return 1; rask r git-ci-do retry "$pipeline[cur]" $i ;;
    N) [[ -n $mr ]] || return 1; rask N git-ci-do new "$pipeline[cur]" $i ;;
    D) [[ $kind == merged && -n $i ]] || return 1; rask D git-mr-watch --check merged $i ;;
    *) return 1 ;;
  esac
  return 0
}

# --- the mouse -------------------------------------------------------------------
# The selection is share/screen.zsh's (sel, s1..s2 over P, the pane's lines,
# the preview with a blank line above it). px is the screen column the pane
# starts in.
# mouse <report>: a press, drag or release (the SGR form, \e[<b;x;yM, m on
# release). In the pane a press starts a selection, a drag carries it and
# the release copies it; a press on the board moves to the row, and opens or
# folds a group. The wheel scrolls the pane when over it, and moves through
# the rows over the board.
mouse() {
  local r=${1#$e\[<} b x y up
  [[ ${r[-1]} == m ]] && up=1
  r=${r[1,-2]}; b=${r%%;*}; r=${r#*;}; x=${r%%;*}; y=${r#*;}
  (( y > H - 2 )) && return
  # In the pane: beside the board, right of it; under it, below it.
  local inpane=0 l
  (( pw > 0 && (side ? x >= px : y >= py) )) && inpane=1
  (( l = y - py + 1 + poff ))
  if (( b == 64 || b == 65 )); then
    if (( inpane )); then scroll $(( b == 64 ? -3 : 3 ))
    elif (( b == 64 )); then step -1
    else step 1; fi
    return
  fi
  if (( inpane || (pw > 0 && sel == 2) )); then
    (( x < px )) && x=$px
    if (( b == 0 && ! up )); then sel=2 sa=$l ca=$(( x - px + 1 )) sb=$sa cb=$ca
    elif (( b == 32 && sel )); then sb=$l cb=$(( x - px + 1 ))
    elif (( up && sel == 2 )); then
      sb=$l cb=$(( x - px + 1 )); sel=1
      if (( sa == sb && ca == cb )); then sel=0; else ends; shown $pw; copy $REPLY.cont $(( ! brief )); fi
    fi
    (( sel )) && ends
    return
  fi
  if (( b == 0 && ! up )); then
    local at=$(( y + top ))
    (( at <= $#LI && LI[at] > 0 )) || return
    go $LI[at]; sel=0
    [[ $type[cur] == group ]] && toggle $lane[cur]
  fi
}

# hub: leave for a list of its own, which the otis function opens and comes
# back from: $1 the key as pressed (gb), $2 its letter.
hub() {
  keys_used $1 "$KL[g $2]"
  screen_off keep
  case $2 in b) print gb ;; c) print otis-config ;; esac
  at_leave; rm -rf -- $st; exit 0
}

# remove: d on a worktree or on something under clean up removes it, as d
# does in gb; on either group's line, all in it that can go: under
# clean up everything, of the worktrees the ones with nothing uncommitted.
# git-worktree-remove and git-branch-delete ask first, and say what they
# did in the footer: a worktree goes to the trash with what git would have
# deleted, and one with uncommitted work stays.
remove() {
  (( early )) && return
  local i
  local -a wts brs
  for (( i = 1; i <= $#id; i++ )); do
    if [[ $type[cur] == group ]]; then [[ $fold[i] == $lane[cur] ]] || continue
    else (( i == cur )) || continue; fi
    cell $i 1
    case $type[i]:$cv[k] in
      # One of Claude's runs that is over: forgotten, after asking.
      notice:run) [[ $fold[i] == runs ]] && { keys_used d "forget a finished run"; behind "forget it" "git-agent-list --forget ${(q)ce[k]}"; return; } ;;
      place:delwt) wts+=("$ce[k]") ;;
      place:cd) [[ $type[cur] != group || $verb[i] == clean ]] && wts+=("$ce[k]") ;;
      change:delbranch) brs+=("$ce[k]") ;;
    esac
  done
  (( $#wts + $#brs )) || { flash="nothing there can go as it is: what is left has uncommitted work"; return; }
  keys_used d "remove what can go"
  (( $#brs )) && behind "remove the branches" "git-branch-delete ${(j: :)${(@q)brs}}"
  (( $#wts )) && behind "remove the worktrees" "cd ${(q)wmain} && git-worktree-remove ${(j: :)${(@q)wts}}"
}
# removable: the cursor is on something d removes rather than on deploys.
removable() { (( $#id )) && [[ $type[cur] == place || $fold[cur] == (cleanup|runs) || ( $type[cur] == group && $lane[cur] == (places|cleanup) ) ]]; }
# d_says: what d would remove there, in words, for the footer; nothing where
# it is not for removing, or where enter already says it.
d_says() {
  REPLY=
  removable || return
  if [[ $type[cur] == group ]]; then
    local i n=0
    for (( i = 1; i <= $#id; i++ )); do
      [[ $fold[i] == $lane[cur] ]] && { [[ $lane[cur] == cleanup || $verb[i] == clean ]] && (( n++ )); }
    done
    (( n )) && REPLY="removes the $n that can go"
  elif [[ $type[cur] == place && $fold[cur] == places ]]; then REPLY="removes it"
  elif [[ $fold[cur] == runs ]]; then REPLY="forgets it"; fi
}

# leave <what> <where>: hand the otis function something only a shell can do,
# and go: goto a branch (switch to it, or to the worktree it is in), cd to a
# worktree. The terminal is given back first, since what it does may print.
leave() {
  screen_off
  print -r -- "$1"$'\t'"$2"
  at_leave; rm -rf -- $st; exit 0
}

# handle: one key. 1 to quit.
handle() {
  [[ $1 == $e'[<'* ]] && { pre=; mouse "$1"; return; }
  # A key while a group is still opening or folding: you are ahead of it,
  # so it is where it was going at once, and the key lands on what is there.
  if [[ -n $foldg ]]; then
    foldn=$foldto
    (( foldto == 0 )) && unset "open[$foldg]"
    foldg=
  fi
  flash=
  # A note is up for a second at least: one a command behind the board left
  # as it ended lands under your typing, and went with the next key.
  [[ -n $notet ]] && (( EPOCHREALTIME - notet < 1 )) || { rm -f $st/note; notet=; }
  sel=0
  # The second key of a g name, within 1.5s of the g; any other key is
  # itself, as if no g had come before it.
  if [[ -n $pre ]] && (( EPOCHREALTIME - pre < 1.5 )); then
    pre=
    [[ $flash == "g…" ]] && flash=
    case $1 in
      g) (( $#id )) && go 1; return ;;
      b|c) hub g$1 $1 ;;
      # Your workspace: git config otis.slackUrl, else Slack's own front door.
      s) keys_used gs "$KL[g s]"; u=$(git config --get otis.slackUrl || print https://app.slack.com)
         run_tty "otis-open --bare ${(q)u}" sh; refresh; return ;;
      # The lists these opened are groups on the board now.
      m|a|d|w) flash="that list is a group on the board now, under the rows"; return ;;
    esac
  fi
  pre=
  rowkey $1 && return
  case $1 in
    j|$e'[B') step 1 ;;
    k|$e'[A') step -1 ;;
    # On a group's line h folds it and l opens it; in a group, h is back to
    # its line.
    h|$e'[D') if [[ $type[cur] == group ]]; then [[ -n $open[$lane[cur]] ]] && toggle $lane[cur]
              elif [[ -n $fold[cur] ]]; then parent $cur; go $REPLY; fi ;;
    l|$e'[C') [[ $type[cur] == group && -z $open[$lane[cur]] ]] && toggle $lane[cur] ;;
    # g starts a two-key name: gg the top, gb branches, gc otis's settings,
    # gs Slack.
    g) pre=$EPOCHREALTIME flash="g…" ;;
    # On a worktree or under clean up, d removes, as it does in gb.
    d) removable && { remove; return; }
       flash="nothing on this row can be removed" ;;
    m|b|a|P|V|c|C|p|n|W|A|R|X|L|r|N|D|s|o|J) flash="nothing on this row for $1 ($KL[$1])" ;;
    G) (( $#id )) && { go $#id; vis $cur || step -1; } ;;
    # ctrl-c is a key here (-isig), since a signal's trap would never run.
    # With ? up, q and esc close it rather than the dashboard.
    q|$e) (( help )) && { help=0 poff=0; return; } ;|
    # And esc what a command behind the board had to say, once it is read.
    $e) (( $#notes )) && { notes=(); return; } ;|
    q|$e|$'\x03') quit ;;
    $'\n'|$'\r') keys_used enter "$KL[enter]"
       (( $#id )) || return
       cell
       # A fix ready beside the row's move: folding it in is what the row
       # says, so it is what enter does.
       if [[ $type[cur] != group && -n $cf[k] ]]; then fixkey=1; act enter "fold in the fix"; fixkey=0; return; fi
       # A group opens; going to a branch or a worktree is the otis
       # function's to do; deleting asks first, in the terminal, a worktree
       # from the main checkout so the ground is never under it; asking for a
       # review and a rebase are what a and b do; the rest are otis-do's.
       case $type[cur]:$cv[k] in
         group:*) toggle $lane[cur] ;;
         *:goto|*:cd) (( early )) || leave $cv[k] "$ce[k]" ;;
         *:delbranch) behind "remove it" "git-branch-delete ${(q)ce[k]}" ;;
         *:delwt) behind "remove it" "cd ${(q)wmain} && git-worktree-remove ${(q)ce[k]}" ;;
         *:deployjobs) run_tty "git-ci-jobs ${(q)pipeline[cur]} ''" sh; refresh ;;
         *:reviewers) (( early )) || ask "$KL[a]" git-mr-do reviewers "$iid[cur]" 'execute-silent(:)' ;;
         *:rebase) (( early )) || ask "$KL[b]" git-mr-rebase --check "$mrkind[cur]" "$iid[cur]" ;;
         change:) if [[ $cg[k] == "▸" ]]; then flash="you are on it"; else flash="nothing to open on this row yet"; fi ;;
         *:) flash="nothing to open there" ;;
         *) act enter "${cd[k]:-open it}" ;;
       esac ;;
    # A fix that is ready, wherever on the row it is: beside its
    # verification, or beside its review.
    f) (( $#id && ! early )) || return
       local c fc=0
       for c in 1 2 3 4 5; do cell $cur $c; [[ -n $cf[k] ]] && { fc=$c; break; }; done
       if (( fc )); then keys_used f "$KL[f]"; col=$fc fixkey=1; act enter "fold in the fix"; fixkey=0 col=$defc[cur]
       else flash="no fix is ready on this row"; fi ;;
    x) keys_used x "$KL[x]"; (( $#id )) && act dismiss "$KL[x]" ;;
    y) keys_used y "$KL[y]"; (( $#id )) && act copy "$KL[y]" ;;
    w) keys_used w "$KL[w]"; (( $#id )) && { fields; ask "$KL[w]" git-mr-do web "$reply[2]"; } ;;
    # With the login gone there is nothing to refetch until it is back: u
    # logs in first, in the terminal, as the line under the top one says.
    u) keys_used u "$KL[u]"
       (( stale_login )) && { bykey="log in to $forge"; run_tty "git-forge login" sh; bykey=; }
       refresh --refresh; relist --refresh; flash="refreshing from $forge…" at0=$EPOCHREALTIME ut=$EPOCHREALTIME uask=1 ;;
    # Your editor's own fuzzy finder, on the checkout you are in (otis-find).
    F) keys_used F "$KL[F]"; bykey=$KL[F]; run_tty "otis-find" sh; bykey=; refresh ;;
    '?') keys_used '?' "${KL[?]}"; help=$(( !help )) poff=0 ;;
    $'\x04') scroll $(( ph / 2 )) ;;
    $'\x15') scroll $(( - ph / 2 )) ;;
    # All of the change at once: every gate in turn, then what a
    # verification made of it and its branch.
    ' ') if (( early )); then pend=(handle ' '); flash="…"
         elif (( $#id )); then
           keys_used space "$KL[space]"
           flash="read all of it…"
           cell
           if [[ $type[cur] == change ]]; then
             run_tty "OTIS_BRANCH=${(q)source[cur]} otis-preview ${(q)mrkind[cur]} ${(q)iid[cur]} ${(q)id[cur]} '' all 2>/dev/null | less -R"
           else run_tty "otis-preview ${(q)ck[k]} ${(q)iid[cur]} ${(q)id[cur]} ${(q)ce[k]} 2>/dev/null | less -R"; fi
           flash=
         fi ;;
  esac
}

screen_on
size
cur=1
[[ -n $memo && -s $memo ]] && { print -rn -- "$(<$memo)" > $st/board; load; early=1; memo_restore; (( $#id )) && go 1; }
watching
refresh
relist
draw
# Keys first: every key waiting is handled before the one draw after them,
# so a held j costs a frame per burst rather than per key. Between keys, a
# tick every 50ms takes in whatever landed: rows, previews, a key's answer.
integer tmo=5 stick=0
wspun= lastasof=
# lap <step>: the upkeep's slowest step so far and how long it took, for the
# trace: which of them a slow tick was waiting on.
float lapt=0
integer slowms=0
slow=
lap() {
  integer ms=$(( (EPOCHREALTIME - lapt) * 1000 ))
  (( ms > slowms )) && slow=$1 slowms=$ms
  lapt=$EPOCHREALTIME
}
while :; do
  reply=()
  # A fold on its way is a frame every 30ms; else a tick every 50.
  zselect -t ${${foldg:+3}:-$tmo} -r $tty ${winch:+-r} $winch
  if [[ -n $winch ]] && (( ${reply[(I)$winch]} )); then
    sysread -s 64 -i $winch _
    resize
  fi
  if (( ${reply[(I)$tty]} )); then
    kt=$EPOCHREALTIME nk=1 keyt=$EPOCHREALTIME
    readkey; lastkey=$REPLY; handle $REPLY
    while zselect -t 0 -r $tty; do readkey; lastkey=$REPLY; handle $REPLY; (( nk++ )); done
    draw
    # A key that took long, whatever it was waiting on.
    (( EPOCHREALTIME - keyt > 0.05 )) && print -ru $tfd -- "$EPOCHREALTIME key ${(q)lastkey} $(( int((EPOCHREALTIME - keyt) * 1000) ))ms"
  else
    float ti=$EPOCHREALTIME
    changed=0 slow= slowms=0
    (( lapt = ti ))
    # Once a second: whatever opened this is still there (else it goes,
    # rather than read keys under a shell's prompt); without perl, the size;
    # and when the forge last answered and whether it is being asked now,
    # which the top line says.
    if (( EPOCHSECONDS != stick )); then
      stick=$EPOCHSECONDS
      orphaned && quit 1
      [[ -z $winch ]] && resize
      as_of
      [[ "$REPLY $fetching $old" == $lastasof ]] || { lastasof="$REPLY $fetching $old"; changed=1; }
      busy_says && changed=1
    fi
    # u's refresh is over when the forge has answered, not when the rows
    # were made again from what was here: until then the footer says so.
    if (( uask )); then
      as_of
      (( fetching )) && uask=2
      if (( uask == 2 && ! fetching )) || (( uask == 1 && EPOCHREALTIME - ut > 3 )); then
        uask=0 changed=1
        [[ $flash == "refreshing from $forge…" ]] && flash=
      fi
    fi
    lap second
    folding && changed=1
    landed && changed=1
    lap landed
    # Something moved on this machine (a run finished or started, a commit,
    # a switch): the rows again now, or once the ones being made have landed.
    if moved; then
      if [[ -n $lpid ]] && kill -0 $lpid 2>/dev/null; then relook=1; else refresh; fi
    fi
    # A fetch landed behind the board (the file otis-list names for
    # git-cached-json to write): the rows again, from what it brought.
    if [[ -e $st/fetched ]] && ! { [[ -n $lpid ]] && kill -0 $lpid 2>/dev/null }; then rm -f $st/fetched; refresh; fi
    lap moved
    listed
    (( EPOCHSECONDS - btick >= 60 )) && relist
    lap listed
    outs_in && changed=1
    (( help )) || { asked && changed=1; }
    lap outs
    # A row with a command out spins, ten frames a second.
    if (( $#outs )); then spin_frame; [[ $REPLY != $ospun ]] && { ospun=$REPLY; changed=1; }; fi
    working && [[ $REPLY != $wspun ]] && { wspun=$REPLY; changed=1; }
    # What the row says in full has landed.
    (( pw > 0 && ! help )) && { shown $pw; [[ $REPLY != $lastpv ]] && changed=1; }
    (( EPOCHSECONDS - ltick >= 10 )) && { refresh; changed=1; }
    lap refresh
    (( changed )) && draw
    lap draw
    # The size has held since the last resize: the previews at it.
    (( settle && EPOCHREALTIME >= settle )) && { settle=0; warm; }
    # The row you have stopped on, drawn if it is not kept yet; not while a
    # resize is still settling.
    (( ! help && ! settle )) && want $pw
    lap want
    (( EPOCHREALTIME - ti > 0.02 )) && print -ru $tfd -- "$EPOCHREALTIME upkeep $(( int((EPOCHREALTIME - ti) * 1000) ))ms changed=$changed slowest=$slow:$slowms"
  fi
done
