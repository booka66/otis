#!/bin/sh
# otis-words know <word>     a word otis need not explain to you again
# otis-words learn <word>    a word you do not know: Claude reads the repository for what it means here
# otis-words --defs          each word you are learning and what it means, tab between, a line each
# otis-words --reader        the words as a prompt gives them to Claude: those you know, those you are learning
#
# Your words, kept for you alone (OTIS_WORDS, else ~/.config/otis/words.tsv), so what otis writes for you is
# told the way you need it: in a case's pane, select a word and press y for one you know, n for one you
# don't. A case that uses a word you are learning says what it means at the top of its pane, and the cases
# told after that explain it where it comes up and leave the ones you know alone. A line a word: known or
# learning, the word, and for one you are learning what it means, once Claude has read it up.
words=${OTIS_WORDS:-${XDG_CONFIG_HOME:-$HOME/.config}/otis/words.tsv}
mkdir -p "$(dirname "$words")" && touch "$words" || exit 1

# put <known|learning> <word> [meaning]: the word's line, in place of any it had (case aside).
put() {
  awk -F'\t' -v w="$2" 'tolower($2) != tolower(w)' "$words" > "$words.$$"
  printf '%s\t%s\t%s\n' "$1" "$2" "$3" >> "$words.$$"
  mv -f "$words.$$" "$words"
}
# What was selected, as a word: one line, its spaces single, the punctuation around it off.
clean() { printf '%s' "$*" | tr '\n\t' '  ' | sed -E 's/  +/ /g; s/^[[:space:][:punct:]]+//; s/[[:space:].,:;!?)]+$//' | cut -c1-80; }

case $1 in
  know)
    shift; w=$(clean "$@"); [ -n "$w" ] || exit 1
    put known "$w"
    printf 'you know "%s": otis will not explain it again\n' "$w" ;;
  learn)
    shift; w=$(clean "$@"); [ -n "$w" ] || exit 1
    put learning "$w"
    printf 'looking up "%s"\n' "$w"
    root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
    model=$(git config --get otis.wordsModel || echo claude-haiku-4-5)
    # Read up behind the screen: what it means here, from the code, in a sentence or two.
    (
      empty=$(mktemp -d) || exit 1
      cd "$empty" || exit 1
      prompt="A teammate reviewing code in the repository at $root does not know what \"$w\" means. Find out from the code (git grep and git show, a few commands at most) what it is here and what it is for, and say so in one or two plain sentences someone new to this code understands. Plain words, no markdown, no line numbers or file paths."
      out=$(printf '%s' "$prompt" | "${SEAM_CLAUDE:-claude}" -p --model "$model" --restricted --tools Bash --add-dir "$root" \
        --allowedTools "Bash(git -C $root grep:*)" "Bash(git -C $root show:*)" \
        --strict-mcp-config --disable-slash-commands --no-session-persistence --permission-prompts none \
        --max-budget-usd 0.3 --output-format json 2>/dev/null | jq -r '.result // empty' 2>/dev/null | tr '\n\t' '  ' | sed -E 's/  +/ /g; s/ $//')
      cd / && rm -rf "$empty"
      # Still learning it (y may have come since): the meaning goes on its line.
      [ -n "$out" ] && awk -F'\t' -v w="$w" 'tolower($2) == tolower(w) && $1 == "learning" { found = 1 } END { exit !found }' "$words" && put learning "$w" "$out"
    ) </dev/null >/dev/null 2>&1 &
    ;;
  --defs) awk -F'\t' '$1 == "learning" { print $2 "\t" $3 }' "$words" ;;
  --reader)
    known=$(awk -F'\t' '$1 == "known" { printf "%s%s", (n++ ? ", " : ""), $2 }' "$words")
    learning=$(awk -F'\t' '$1 == "learning" { printf "%s%s", (n++ ? "; " : ""), $2 ($3 != "" ? " (" $3 ")" : "") }' "$words")
    [ -n "$known" ] && printf 'Words the reader already knows: use them as they are and never explain them: %s.\n' "$known"
    [ -n "$learning" ] && printf 'Words the reader is learning: say what each one is, in plain words, the first time it comes up in a case: %s.\n' "$learning"
    exit 0 ;;
  *) sed -n '2,5s/^# //p' "$0"; exit 2 ;;
esac
