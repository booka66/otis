#!/bin/sh
# otis-words know <word> [<outline.json> <n>]          a word you know: never explained to you
# otis-words learn <word> [<outline.json> <n>]         a word you don't: always explained, from the code
# otis-words note <word> <note> [<outline.json> <n>]   what a word is, in your own words
# otis-words --reader        the words as a prompt gives them to Claude
#
# What you know and don't, kept for you alone (OTIS_WORDS, else ~/.config/otis/words.tsv), so what otis
# writes is written for you: in a case's pane, select a word and press y for one you know, n for one you
# don't, a to say what it is yourself. Only that is kept, never what a word means: a word means what the
# code in front of you makes it (one queue is not another), so each case says it from its own code. The case
# you are on is told again for you (share/reword.mjs), and every case told after is told that way from the
# start. A line a word: known, learning or noted, the word, and for one you noted, your note.
words=${OTIS_WORDS:-${XDG_CONFIG_HOME:-$HOME/.config}/otis/words.tsv}
mkdir -p "$(dirname "$words")" && touch "$words" || exit 1

# put <known|learning|noted> <word> [note]: the word's line, in place of any it had (case aside).
put() {
  awk -F'\t' -v w="$2" 'tolower($2) != tolower(w)' "$words" > "$words.$$"
  printf '%s\t%s\t%s\n' "$1" "$2" "$3" >> "$words.$$"
  mv -f "$words.$$" "$words"
}
# What was selected, as a word: one line, its spaces single, the punctuation around it off.
# A selection that runs on into the explanation after a word (" (the ...") is the word before it.
clean() { printf '%s' "$*" | tr '\n\t' '  ' | sed -E 's/  +/ /g; s/ \(.*$//; s/^[[:space:][:punct:]]+//; s/[[:space:].,:;!?)]+$//' | cut -c1-80; }

# reword <outline.json> <n>: that case told again for you, behind the screen.
reword() {
  [ -s "$1" ] && [ -n "$2" ] || return 1
  [ "$(git config --get otis.symbolsModel)" = off ] && return 1
  node "$(dirname "$0")/../share/reword.mjs" "$1" "$2" </dev/null >/dev/null 2>&1 &
}

case $1 in
  know)
    w=$(clean "$2"); [ -n "$w" ] || exit 1
    put known "$w"
    if reword "$3" "$4"; then printf 'you know "%s": case %s is being told again without explaining it\n' "$w" "$4"
    else printf 'you know "%s": otis will not explain it again\n' "$w"; fi ;;
  learn)
    w=$(clean "$2"); [ -n "$w" ] || exit 1
    put learning "$w"
    if reword "$3" "$4"; then printf 'case %s is being told again, explaining "%s" from its code\n' "$4" "$w"
    else printf 'otis will explain "%s" from the code wherever it comes up\n' "$w"; fi ;;
  note)
    w=$(clean "$2"); n=$(printf '%s' "$3" | tr '\n\t' '  '); [ -n "$w" ] && [ -n "$n" ] || exit 1
    put noted "$w" "$n"
    if reword "$4" "$5"; then printf 'noted "%s": case %s is being told again with it\n' "$w" "$5"
    else printf 'noted "%s"\n' "$w"; fi ;;
  --reader)
    known=$(awk -F'\t' '$1 == "known" { printf "%s%s", (n++ ? ", " : ""), $2 }' "$words")
    learning=$(awk -F'\t' '$1 == "learning" { printf "%s%s", (n++ ? ", " : ""), $2 }' "$words")
    noted=$(awk -F'\t' '$1 == "noted" { printf "%s%s", (n++ ? "; " : ""), $2 " (" $3 ")" }' "$words")
    [ -n "$known" ] && printf 'Words the reader already knows: use them as they are and never explain them: %s.\n' "$known"
    [ -n "$learning" ] && printf 'Words the reader does not know: the first time each comes up in a case, say what it is there, from the code the case runs through (what it is built on, its name in that code, what puts things in or reads them), in plain words; never a general definition, and never one from somewhere else in the codebase: the same word can be a different thing in different code: %s.\n' "$learning"
    [ -n "$noted" ] && printf 'Words the reader has said what they are, in their own words; take what they say as true, and say it in their terms: %s.\n' "$noted"
    exit 0 ;;
  *) sed -n '2,5s/^# //p' "$0"; exit 2 ;;
esac
