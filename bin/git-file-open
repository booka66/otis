#!/bin/sh
# git-file-open [--at <line>] <status> <path> [rename source]: open a changed
# file from ga in your editor (otis-edit), at <line> when the caller knows it (git-symbols), else
# at the line its preview is scrolled to, or at its first changed line against
# HEAD. A deleted file opens as it was, read only (git-show-file), at
# the line the preview shows; an untracked or added one, whose preview is the
# file itself, at that line too. The path is relative
# to the repo root, so the editor runs from there. ga reloads its list and
# preview after the editor returns, so the edits show at once.
at=
[ "$1" = --at ] && { at=$2; shift 2; }
st=$1 p=$2
[ -n "$p" ] || exit 0
cd "$(git rev-parse --show-toplevel)" || exit 1
# The line the preview is scrolled to, if it has been (git-commit-open explains
# the trick); otherwise the file's first change.
line=$at off=
if [ -z "$at" ] && [ -n "$GIT_FZF_STATE" ]; then
  key=$(printf '%s' "$p" | tr '/' '%')
  off=$(cat "$GIT_FZF_STATE/off.$key" 2>/dev/null)
  [ "${off:-1}" -gt 1 ] 2>/dev/null || off=
fi
# A file view (git-preview-file) is two header lines, then the file.
case $st in
  *D*)
    [ -z "$at" ] && [ -n "$off" ] && [ "$off" -gt 2 ] && line=$((off - 2))
    exec git-show-file "$(git rev-parse -q --verify ":$p" >/dev/null 2>&1 && echo ":$p" || echo "HEAD:$p")" "$p" "${line:-1}"
    ;;
  '??'|A*)
    [ -z "$at" ] && [ -n "$off" ] && [ "$off" -gt 2 ] && line=$((off - 2))
    [ -e "$p" ] && exec otis-edit "+${line:-1}" -- "$p"
    ;;
esac
if [ ! -e "$p" ]; then
  printf '%s is gone from the working tree now. press enter\n' "$p"
  read -r _
  exit 0
fi
if [ -n "$off" ]; then
  FZF_PREVIEW_COLUMNS=$(cat "$GIT_FZF_STATE/cols" 2>/dev/null)
  export FZF_PREVIEW_COLUMNS
  line=$(git-preview-file "$st" "$p" "$3" 2>/dev/null | git-preview-at "$off")
fi
if [ -z "$line" ]; then
  case $st in
    '??') ;;
    *) line=$(git diff HEAD -U0 -- "$p" | awk '/^@@/ { split($3, a, ","); n = substr(a[1], 2) + 0; print (n > 0 ? n : 1); exit }') ;;
  esac
fi
exec otis-edit "+${line:-1}" -- "$p"
