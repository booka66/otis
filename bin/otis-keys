#!/bin/sh
# otis-keys <picker> <row's fields...>: what each key does on this row, for
# a picker's footer (otis-pick --keys-from). A line "key<TAB>label" each; an
# empty label is a key that does nothing on this row, which the footer then
# leaves out. A key not named keeps the label the picker declared.
#
# The footer is the one place that says what a key does, so it says it for
# the row you are on: on a branch, w needs an MR; on a file, space stages
# or unstages by how it stands.
# Only what the row and the picker's state already hold is read: this runs
# on every move, behind the picker.
st=$GIT_FZF_STATE
k() { printf '%s\t%s\n' "$1" "$2"; }
none() { for x in "$@"; do k "$x" ""; done; }
picker=$1; shift
case $picker in
  # gb: branch, kind, worktree, MR iid, place.
  branch)
    b=$1 kind=$2 wt=$3 mr=$4 place=$5
    case $place in
      here) none enter W; k d "" ;;
      worktree) k enter "switch to it (brings it from its worktree)"; k W "go to its worktree" ;;
    esac
    case $kind in
      main) none d C n ;;
      merged|merged-diff|closed|closed-diff) [ "$place" = here ] || k d "delete it: it is $kind" ;;
    esac
    if [ -n "$mr" ]; then none n; else none w l a; fi ;;

  # ga's file panel: path, status (XY, . for blank).
  file)
    st2=$2 x=${2%?} y=${2#?}
    if [ "$st2" = '??' ]; then k space "stage it (new)"; none p; k d "delete it"
    elif [ "$y" = . ]; then k space "unstage it"; none p
    elif [ "$x" != . ]; then k space "stage the rest of it"
    else k space "stage it"; fi ;;

  # A review's lines (git-mr-lines): kind, resolvable, resolved.
  lines)
    case $1 in
      thread)
        k enter "open the thread"; k c "reply"
        if [ "$2" = true ]; then if [ "$3" = true ]; then k r "open it again"; else k r "resolve it"; fi; else none r; fi ;;
      line) k c "comment on it"; none r e d ;;
      *) none enter c r e d J K ;;
    esac ;;

  # The threads picker: resolvable, resolved.
  threads)
    if [ "$1" = true ]; then if [ "$2" = true ]; then k r "open it again"; else k r "resolve it"; fi; else none r; fi ;;
esac
exit 0
