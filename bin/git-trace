#!/bin/sh
# git-trace --can <base> <head>   exit 0 when P can trace the change: a runner, and a spec file among
#                                 what it changed
# git-trace --ci <base> <head> <dir> [title] [url]   the run and its page with nobody there: a CI job
# git-trace --run <dir>           the run, in the background: the change's spec files, each through
#                                 the runner with the tracer on, at its head, in a slot
# git-trace --view <dir>          P's screen: what runs the change, and what nothing runs
# git-trace --list <dir>          that screen's list; --show <dir> <row id> its preview
# git-trace --walk <dir> <test>   enter on a test: its walk, on a screen of its own
# git-trace --walk-list <dir> <test>, --walk-show <dir> <test> <row id>   that screen's list (a row a
#                                 call the test made) and preview (the line you are on in it)
# git-trace --steps-base <dir> <test>   where that screen's steps are drawn for its width (otis-symbols --steps)
# git-trace --side <dir> <test>   b there: the same test before the change, or back
# git-trace --write <dir> <gap>   i on a gap: Claude writes an input that reaches it, and it is traced
# git-trace --base <dir>          b on P's screen: the spec files again at the base, for before and after
# git-trace --phase <dir> <what> [arg]   the background half of --run, --write and --base
#
# P in gmr and gb (git-walk) shows what the change does. When its own tests
# can run, it runs them rather than asking a model: each spec file the change
# touched goes through the runner with share/walk-trace.js preloaded, which
# stops at every line of every changed definition and writes down the Jest
# test, the calls it is in and the values there. That is the walk: what
# actually ran, with what, in the order it ran. Claude's words are a caption
# at most (the gloss, when there is one), marked as such.
#
# P's screen puts first the changed functions no test runs, each with why
# (mocked in the spec that reaches it, a call in a caller that never runs,
# nothing traced reaching it), and i has Claude write an input that reaches
# one: a test that only has to run, added to a spec that already sets up
# around it, in the slot and nowhere else. Then the tests, by how much of the
# change each runs; enter walks one line by line, j the next line in the same
# call, l into the call the line makes, h out to the caller, k back where you
# were, and b the same test before the change (after b on P's screen, which
# runs the head's spec files at the base).
#
# Once the tour is written, the same spec files run at the base and at the
# head once more, and what the tests do differently while still passing is
# at the top of that screen (behave, below).
#
# The runner is git config otis.walkRunner, a command given a spec file's
# path from the repo's top, in the slot, with the tracer's environment:
# OTIS_TRACE_REQUIRE (to go in the test's NODE_OPTIONS as --require),
# OTIS_TRACE_TARGETS and OTIS_TRACE_OUT, which it hands the test's node. It
# exits 0 when the spec passed; OTIS_WALK_AHEAD is set when nobody is waiting
# on it (git-walk --ahead), for a runner to take less of the machine. Without
# one, share/walk-run-jest runs Jest
# from the slot's node_modules, or share/walk-run-vitest Vitest. git config
# otis.walkTrace off leaves P to Claude's walk.
#
# Slots are worktrees kept between runs so their builds stay warm: walk-1
# and on (otis.walkSlotCount, else 2) under otis.walkSlots, else
# ~/.cache/otis/slots/<repo>. A run takes a free one, checks out the head
# (and puts back the inputs Claude wrote), and gives it back.
#
# The run's state is git-walk's (<git dir>/otis-walk/<key>), with engine
# trace in it, so gag, the dashboard and gmr's marks read it as they read a
# walk. Here: shas, table, specs, targets.json, trace/<i>.jsonl and ran/<i>
# (the head's), before/ (the base's), again/ (the head's once more),
# inputs.json and inputs.patch (i's), cover.json (share/walk.mjs cover),
# about (what the change says it does) and diff.json (share/walk.mjs diff).
share=$(cd "$(dirname "$0")/../share" && pwd)
. "$share/claude-run.sh"
. "$share/cursor.sh"
. "$share/palette.sh"
walk="node $share/walk.mjs"
note() { git-fzf-note "$1" >/dev/null; }

# runner: the command that runs a spec, or nothing.
runner() {
  r=$(git config --get otis.walkRunner) && { printf '%s\n' "$r"; return 0; }
  top=$(git rev-parse --show-toplevel)
  if [ -x "$top/node_modules/.bin/jest" ]; then printf '%s\n' "$share/walk-run-jest"
  elif [ -x "$top/node_modules/.bin/vitest" ]; then printf '%s\n' "$share/walk-run-vitest"; fi
}
# specs_of <base> <head>: the specs the change touched, the spec beside each
# source file it touched (foo.ts's foo.spec.ts): a change that leaves a
# file's tests alone is still tested by them; and specs that import one.
specs_of() { { own_specs "$1" "$2"; callers_of "$1" "$2"; } | awk '!seen[$0]++'; }
# own_specs <base> <head>: the change's own spec files and those beside what
# it changed, without searching the repository: what --can asks first.
own_specs() {
  git diff --name-only --no-renames --diff-filter=d "$1" "$2" | git-test-files kinds | awk -F'\t' '$1 ~ /\.[cm]?[jt]sx?$/ && ($2 == "tests" || $2 == "")' |
    while IFS=$(printf '\t') read -r f k; do
      if [ "$k" = tests ]; then echo "$f"; continue; fi
      for s in "${f%.*}".spec."${f##*.}" "${f%.*}".test."${f##*.}"; do git cat-file -e "$2:$s" 2>/dev/null && echo "$s"; done
    done
}
# callers_of <base> <head>: up to 8 spec files the change leaves alone that
# import a file it changed, nearest the file first: the tests that were
# passing before it and still are, whose behavior the diff compares. An
# import is not a call (one caller's spec imported the file and none of its
# 23 tests reached the change), so P's list says which traced nothing.
callers_of() {
  git diff --name-only --no-renames --diff-filter=d "$1" "$2" | git-test-files kinds | awk -F'\t' '$1 ~ /\.[cm]?[jt]sx?$/ && $2 == ""' | cut -f1 |
    while read -r f; do
      stem=$(basename "$f"); stem=${stem%.*}
      [ "$stem" = index ] && continue
      git grep -l -F -e "/$stem'" -e "/$stem\"" "$2" -- '*.spec.*' '*.test.*' 2>/dev/null | sed "s|^$2:||" |
        awk -v f="$f" '{ n = split(f, a, "/"); m = split($0, b, "/"); k = 0; while (k < n && k < m && a[k + 1] == b[k + 1]) k++; print k "\t" $0 }'
    done | sort -t'	' -k1,1nr | cut -f2 | awk '!seen[$0]++' |
    while read -r s; do git diff --quiet "$1" "$2" -- "$s" && echo "$s"; done | head -8
}

case $1 in
  --can)
    [ "$(git config --get otis.walkTrace)" != off ] && [ -n "$(runner)" ] || exit 1
    git cat-file -e "$3^{commit}" 2>/dev/null || exit 0
    # Its own specs first, which is instant; searching the repository for
    # specs that import what it changed (callers_of) took P eleven seconds
    # before anything showed, and is needed only when it has none.
    [ -n "$(own_specs "$2" "$3" | head -1)" ] || [ -n "$(callers_of "$2" "$3")" ]; exit ;;
  --list) exec $walk rows "$2" ;;
  --walk-list) exec $walk walk-rows "$2" "$3" "$(cat "$GIT_FZF_STATE/side" 2>/dev/null || echo head)" ;;
esac

# --- the walk's screen, fast ------------------------------------------------------
# Everything a key or a preview needs is rendered once, by walk-prep, for the
# pane's width: here it is looked up and printed, never worked out again.
# prepared <dir> <test> <side>: $b the walk's files, rendered for this width.
# drawn: what a walk or a tour drawn for a width is marked with once it is.
# Its number goes up whenever what walk.mjs draws does (the steps' files and
# lines, the files whole for the glide, lines as wide as the pane, the code
# around a step's own, added lines always on their ground), so one
# drawn before is drawn again rather than shown as it was.
drawn=v9
prepared() {
  w=${FZF_PREVIEW_COLUMNS:-100}
  b=$1/walks/$2-$3
  [ -e "$b-$w.$drawn" ] && return 0
  mkdir -p "$1/walks"
  # The pane draws the rows around the cursor at once: one renders, the rest wait.
  if mkdir "$b-$w.lock" 2>/dev/null; then
    $walk walk-prep "$1" "$2" "$3" "$w" && : > "$b-$w.$drawn"
    rmdir "$b-$w.lock"
  else
    i=0; while [ ! -e "$b-$w.$drawn" ] && [ "$i" -lt 100 ]; do sleep 0.05; i=$((i + 1)); done
  fi
}
# shown <row id>: the step the row's preview shows: the one you are on, when
# it is in this call, else the call's first.
shown() {
  cur=$(cat "$GIT_FZF_STATE/cur" 2>/dev/null)
  awk -v vi="${1#v:}" -v k="$cur" '$2 == vi { if ($1 == k) { f = k; exit } if (first == "") first = $1 } END { print (f != "" ? f : first) }' "$b.nav"
}
side() { cat "$GIT_FZF_STATE/side" 2>/dev/null || echo head; }
# toured <dir>: the tour drawn for this width (walk.mjs tour-prep). A tour
# that changed (a chapter landed, its values came in) is drawn again over
# the old drawing, marked stale meanwhile (restale), which the pane keeps
# showing: cleared first, the pane went blank until the new one was drawn.
# A drawing the tour changed under is left stale, to be drawn once more.
toured() {
  w=${FZF_PREVIEW_COLUMNS:-100}
  [ -e "$1/tour-$w.$drawn" ] && return 0
  [ -s "$1/tour.json" ] || return 1
  if mkdir "$1/tour-$w.lock" 2>/dev/null; then
    was=$(cksum < "$1/tour.json")
    $walk tour-prep "$1" "$w" 2>>"$1/log" && [ "$(cksum < "$1/tour.json")" = "$was" ] && : > "$1/tour-$w.$drawn" && rm -f "$1/tour-$w.stale"
    rmdir "$1/tour-$w.lock"
  else
    i=0; while [ ! -e "$1/tour-$w.$drawn" ] && [ "$i" -lt 200 ]; do sleep 0.05; i=$((i + 1)); done
  fi
  [ -e "$1/tour-$w.$drawn" ]
}
case $1 in
  --walk-show)
    case $4 in v:*) ;; *) exit 0 ;; esac
    prepared "$2" "$3" "$(side)"
    k=$(shown "$4")
    [ -n "$k" ] && cat "$b-$w/$k"
    exit 0 ;;
  --walk-line)
    # enter: the line the preview is on, as path and line.
    prepared "$2" "$3" "$(side)"
    k=$(shown "$4")
    jq -r --argjson k "$k" '.steps[$k] | "\(.path) \(.line)"' "$b.json" 2>/dev/null || jq -r --argjson k "$k" '.steps[$k] | "\(.path) \(.line)"' "$2/walks/$3-$(side).json"
    exit 0 ;;
  --show)
    # P's screen: the previews rendered once a width, as the walk's are.
    w=${FZF_PREVIEW_COLUMNS:-100} e=$2/entry-$w
    if [ ! -e "$e.done" ]; then
      if mkdir "$e.lock" 2>/dev/null; then
        FZF_PREVIEW_COLUMNS=$w $walk previews "$2" "$e" && : > "$e.done"; rmdir "$e.lock"
      else i=0; while [ ! -e "$e.done" ] && [ "$i" -lt 200 ]; do sleep 0.05; i=$((i + 1)); done; fi
    fi
    f=$e/$(printf '%s' "$3" | tr ':' '_')
    if [ -e "$f" ]; then cat "$f"; else exec $walk preview "$2" "$3"; fi
    exit 0 ;;
  # The tour's screen, drawn the same way: once a width, then looked up.
  --tour-list) toured "$2" && cat "$2/tour.rows"; $walk legend 2>/dev/null; exit 0 ;;
  --tour-show) toured "$2" && cat "$2/tour-$w/${3#tour:}" 2>/dev/null; exit 0 ;;
  # Where the tour's previews are drawn for this width, for its screen (otis-symbols --panes).
  # Only once drawn: drawing is the list's (--tour-list, in the background),
  # and doing it here held the screen before its loader could move.
  --tour-panes) w=${FZF_PREVIEW_COLUMNS:-100}; { [ -e "$2/tour-$w.$drawn" ] || [ -e "$2/tour-$w.stale" ]; } && printf '%s\n' "$2/tour-$w"; exit 0 ;;
  # --tour-open <dir> <row> [comment]: enter, or c, on a stop's line.
  --tour-open)
    v=${4:-open}
    toured "$2" && read -r p l ti k < "$2/tour-$w/${3#tour:}.at" 2>/dev/null || { note "$([ "$v" = open ] && echo "enter opens" || echo "c comments on") a stop's line; this one is the overview"; exit 0; }
    echo "execute(git-walk --$v '$2' head '$p' $l)"; exit 0 ;;
  --tour-step)
    toured "$2" && read -r p l ti k < "$2/tour-$w/${3#tour:}.at" 2>/dev/null || { note "s steps through a stop's test; this one is the overview"; exit 0; }
    [ "$ti" -ge 0 ] || { note "no test stops here, so there is nothing to step through"; exit 0; }
    echo "execute(git-trace --walk '$2' $ti $k)"; exit 0 ;;
esac

# --- slots ------------------------------------------------------------------------
# Worktrees kept warm between runs (walk-1 and on), each locked by the run
# using it (a directory with its pid). A run takes as many as are free, one
# less when it is ahead of your review, and runs a package's spec files in
# each at once: a package's tests start its databases once, not once a file.
#
# With git config otis.walkRemote <ssh host>, the slots are on that host
# instead (a Coder workspace after coder config-ssh), worktrees of its
# checkout of the repo (otis.remotePath) under otis.walkRemoteSlots, else
# /var/tmp/otis-walk/<repo>: the change's commits are pushed there (never to
# origin), the runner and the tracer go with each run, and the trace comes back;
# the rest is done here. Their locks stay here, since this is what takes them.
# The runner is told OTIS_WALK_SCRATCH, a directory beside the slots for what a
# build keeps, since a workspace's home is often small. Claude's inputs (w)
# are written in a slot here, which only needs the files. Before a push, a
# checkout with under 5G free has its build caches (otis.walkRemoteCaches,
# else ~/.cache/bazel-disk) trimmed, the least used first: a Bazel disk
# cache grows until the disk is full, and the push there failed with it.
# Only a cache that can lose any one file goes there, which Bazel's disk
# cache can and its repo cache (~/.cache/bazel/_bazel_*/cache/repos) cannot.
#
# With git config otis.walkRemote cursor, a slot is a Cursor Cloud VM instead
# (cursor_trace), one kept a slot and booted in otis.cursorEnv as V's tester
# is: only the tests run there, and the rest is done here as before. Nothing
# runs in one of those but what its agent runs, so every run is a prompt to
# it, on otis.walkCursorModel (else otis.cursorModel): a small model does,
# since all it is asked is to run one command until it says it is done.
# Each VM has databases of its own, so there a package's spec files are dealt
# across the slots instead of kept in one: otis.walkSlotCount VMs at once.
remote=$(git config --get otis.walkRemote)
# OTIS_WALK_HERE (git-trace --ci): no slots and no workspace. The checkout the
# run is in is at the head already and is the one place there is to run.
[ -n "${OTIS_WALK_HERE:-}" ] && remote=
rpath=$(git config --get otis.remotePath)
slots_dir() {
  repo=$(basename "$(git rev-parse --show-toplevel)")
  if [ -n "$remote" ]; then
    sd=$HOME/.cache/otis/slots/$remote/$repo
    rsd=$(git config --get otis.walkRemoteSlots || echo "/var/tmp/otis-walk/$repo")
  else
    sd=$(git config --get otis.walkSlots) || sd=$HOME/.cache/otis/slots/$repo
    sd=$(eval echo "$sd")
  fi
  mkdir -p "$sd"
  sn=$(git config --get otis.walkSlotCount || echo 2)
}
q() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }
# kit <dir> <spec...>: what goes with a run somewhere else: the tracer, its
# targets, the inputs Claude wrote, the runner and the spec files' names.
kit() {
  k=$1; shift
  cp "$share/walk-trace.js" "$k/"; cp "$tg" "$k/targets.json"
  [ -s "${patch:-$d/inputs.patch}" ] && cp "${patch:-$d/inputs.patch}" "$k/inputs.patch"
  r=$(runner); f=$(eval printf '%s' "$r")
  if [ -f "$f" ]; then cp "$f" "$k/runner"; else printf '%s "$@"\n' "$r" > "$k/runner"; fi
  printf '%s\n' "$@" > "$k/specs"
}
# remote_trace <slot> <sha> <side> <out> <spec...>: a slot's spec files run on
# otis.walkRemote, as a slot here runs them; its trace in <out>.jsonl.
remote_trace() {
  [ "$remote" = cursor ] && { cursor_trace "$@"; return; }
  rs=$rsd/$(basename "$1") sha=$2 rside=$3 o=$4; shift 4
  t=$(mktemp -d) || return 2
  # A stopped workspace starts on the first ssh, which times out before its
  # agent is up (255): again until it answers, or two minutes.
  n=0
  while room; rc=$?; [ "$rc" -eq 255 ] && [ "$n" -lt 8 ]; do n=$((n + 1)); sleep 15; done
  [ "$rc" -eq 0 ] || { [ "$rc" -eq 255 ] && echo "could not reach $remote (is the workspace running?)"; rm -rf "$t"; return 2; }
  n=0
  until out=$(GIT_SSH_COMMAND="ssh $keep" git push -q -f "ssh://$remote$rpath" "$sha:refs/otis/walk/$(basename "$rs")" "$head:refs/otis/walk/$(basename "$rs")-head" 2>&1); do
    printf '%s\n' "$out"
    # A full disk stays full: again only took the walk two minutes to say so.
    case $out in *"No space left on device"*) rm -rf "$t"; return 2 ;; esac
    n=$((n + 1)); [ "$n" -ge 4 ] && { echo "could not push the change to $remote:$rpath (is the workspace running?)"; rm -rf "$t"; return 2; }
    sleep 15
  done
  kit "$t" "$@"
  {
    printf 'slot=%s repo=%s sha=%s head=%s side=%s scratch=%s\n' "$(q "$rs")" "$(q "$rpath")" "$sha" "$head" "$rside" "$(q "$(dirname "$rs")/scratch")"
    [ -n "${OTIS_TEST_NAME:-}" ] && printf 'OTIS_TEST_NAME=%s; export OTIS_TEST_NAME\n' "$(q "$OTIS_TEST_NAME")"
    cat <<'REMOTE'
here=$(cd "$(dirname "$0")" && pwd)
set --; while read -r f; do set -- "$@" "$f"; done < "$here/specs"
mkdir -p "$(dirname "$slot")" "$scratch"
if [ ! -e "$slot/.git" ]; then
  echo "making a slot for the walks: $slot (its first build is cold)"
  git -C "$repo" worktree prune
  git -C "$repo" worktree add -q --detach -f "$slot" "$sha" || exit 2
fi
git -C "$slot" reset -q --hard
git -C "$slot" checkout -q --detach -f "$sha" || exit 2
[ "$side" = base ] && git -C "$slot" checkout -q "$head" -- "$@"
[ -s "$here/inputs.patch" ] && { git -C "$slot" apply "$here/inputs.patch" || echo "the inputs Claude wrote no longer apply; running without them"; }
cd "$slot" && OTIS_WALK_SCRATCH=$scratch OTIS_TRACE_REQUIRE=$here/walk-trace.js OTIS_TRACE_TARGETS=$here/targets.json OTIS_TRACE_OUT=$here/out.jsonl sh "$here/runner" "$@"
REMOTE
  } > "$t/run.sh"
  rd=/var/tmp/otis-walk/run-$(basename "$rs")-$$
  # Started detached there, so a connection that drops (a laptop asleep, the
  # workspace's proxy) leaves the tests going; again until it has started. A
  # run whose tests passed came back with nothing, and hung an hour first,
  # when the connection it ran in and read its trace through went away.
  n=0
  until tar -czf - -C "$t" . | rsh "mkdir -p $rd && tar -xzf - -C $rd && (setsid nohup sh -c 'sh $rd/run.sh > $rd/log 2>&1; echo \$? > $rd/done' < /dev/null > /dev/null 2>&1 &)" &&
    rsh "test -e $rd/log"; do
    n=$((n + 1)); [ "$n" -ge 4 ] && { echo "could not start the run on $remote"; rm -rf "$t"; return 2; }
    sleep 15
  done
  # Its output as it comes (said shows its otis: lines), read on from where
  # the last look left off, until it is done; ten minutes unreachable ends it.
  seen=0 miss=0 st=
  while [ -z "$st" ]; do
    sleep 10
    if rsh "tail -c +$((seen + 1)) $rd/log" > "$t/chunk" 2>/dev/null; then
      miss=0; cat "$t/chunk"; seen=$((seen + $(wc -c < "$t/chunk")))
      st=$(rsh "cat $rd/done 2>/dev/null")
    else
      miss=$((miss + 1)); [ "$miss" -ge 60 ] && { echo "lost $remote for ten minutes; its run is left in $rd"; rm -rf "$t"; return 2; }
    fi
  done
  rsh "tail -c +$((seen + 1)) $rd/log" 2>/dev/null
  n=0
  until rsh "cat $rd/out.jsonl" > "$o.jsonl" 2>/dev/null; do
    n=$((n + 1)); [ "$n" -ge 6 ] && { echo "could not bring the trace back from $remote:$rd"; rm -rf "$t"; return 2; }
    sleep 10
  done
  rsh "rm -rf $rd" 2>/dev/null
  rm -rf "$t"
  return "$st"
}
# rsh: a command on otis.walkRemote, given up on within a minute of it going
# quiet rather than waiting on a dead connection.
keep="-o BatchMode=yes -o ConnectTimeout=20 -o ServerAliveInterval=15 -o ServerAliveCountMax=4"
rsh() { ssh $keep "$remote" "$@"; }
# cursor_trace <slot> <sha> <side> <out> <spec...>: the same in the slot's
# Cursor Cloud VM. Cursor's API runs nothing in a VM and puts no file in one:
# code reaches it from origin alone, what happens there is what its agent
# does, and files come back as artifacts. So the kit is a commit, its parents
# the commits the run needs, pushed to a ref of the slot's own under
# refs/otis/walk (no branch, so no pipeline; written over by the next run and
# deleted after this one), and the agent is asked for one command, again
# until it says it is done: it fetches and unpacks the kit the first time,
# then go.sh starts the run detached and waits on it three minutes a call,
# since an agent's shell call is not one to hold for half an hour. One
# command, because asked for two a model ran them at once, the second before
# the first had unpacked it. The run is in the VM's own checkout, where the image's
# build is warm, and its output, status and trace come back gzipped.
# A VM that ended its turn without finishing is not asked again: the next run
# boots another.
cursor_trace() {
  slot=$1 sha=$2 cside=$3 o=$4; shift 4
  [ -n "$CURSOR_API_KEY" ] || { echo "Cursor needs CURSOR_API_KEY (Cursor dashboard, Integrations, API keys) exported in your shell"; return 2; }
  t=$(mktemp -d) || return 2
  kit "$t" "$@"
  n=kit-$(basename "$slot")-$$-$(date +%s)
  ref=refs/otis/walk/$(id -un)/$(basename "$slot")
  {
    printf 'sha=%s head=%s side=%s\n' "$sha" "$head" "$cside"
    [ -n "${OTIS_TEST_NAME:-}" ] && printf 'OTIS_TEST_NAME=%s; export OTIS_TEST_NAME\n' "$(q "$OTIS_TEST_NAME")"
    cat <<'VM'
here=$(cd "$(dirname "$0")" && pwd)
set --; while read -r f; do set -- "$@" "$f"; done < "$here/specs"
cd "$(cat "$here/repo")" || exit 2
git reset -q --hard
git checkout -q --detach -f "$sha" || exit 2
[ "$side" = base ] && git checkout -q "$head" -- "$@"
[ -s "$here/inputs.patch" ] && { git apply "$here/inputs.patch" || echo "the inputs Claude wrote no longer apply; running without them"; }
OTIS_TRACE_REQUIRE=$here/walk-trace.js OTIS_TRACE_TARGETS=$here/targets.json OTIS_TRACE_OUT=$here/out.jsonl sh "$here/runner" "$@"
VM
  } > "$t/run.sh"
  cat > "$t/go.sh" <<'VM'
k=$(cd "$(dirname "$0")" && pwd)
a=/opt/cursor/artifacts/otis-walk n=$(basename "$k")
if [ ! -e "$k/pid" ]; then
  # One run a VM: one still going is a walk that was stopped on your side.
  old=$(cat /var/tmp/otis-walk/pid 2>/dev/null); [ -n "$old" ] && kill -- "-$old" 2>/dev/null
  for other in /var/tmp/otis-walk/kit-*; do [ "$other" = "$k" ] || rm -rf "$other"; done
  rm -rf "$a"; mkdir -p "$a"
  setsid nohup sh -c "sh $k/run.sh > $k/log 2>&1; echo \$? > $k/done" < /dev/null > /dev/null 2>&1 &
  echo $! > "$k/pid"; cp "$k/pid" /var/tmp/otis-walk/pid
fi
# What the runner says for P's progress (its "otis: " lines), saved as it grows.
i=0; while [ ! -e "$k/done" ] && [ "$i" -lt 36 ]; do
  sleep 5; i=$((i + 1))
  grep '^otis: ' "$k/log" > "$k/said" 2>/dev/null
  [ -s "$k/said" ] && ! cmp -s "$k/said" "$a/$n.said" && cp "$k/said" "$a/$n.said"
done
[ -e "$k/done" ] || { echo "otis-walk: still running"; exit 0; }
gzip -c "$k/log" > "$a/$n.log.gz"
[ -e "$k/out.jsonl" ] && gzip -c "$k/out.jsonl" > "$a/$n.out.jsonl.gz"
# Last, and saying whether a trace goes with it: with this one there, all of it is.
echo "$(cat "$k/done") $([ -e "$k/out.jsonl" ] && echo trace)" > "$a/$n.done"
echo "otis-walk: finished"
VM
  tree=$(for f in "$t"/*; do printf '100644 blob %s\t%s\n' "$(git hash-object -w "$f")" "$(basename "$f")"; done | git mktree) &&
    kc=$(git commit-tree "$tree" -p "$sha" $([ "$head" = "$sha" ] || echo "-p $head") -m "otis walk kit") &&
    out=$(git push -q -f --no-verify origin "$kc:$ref" 2>&1) || { echo "could not push the run's kit to origin as $ref: $(oneline "$out")"; rm -rf "$t"; return 2; }
  rm -rf "$t"
  cat > "$slot.prompt" <<EOF
Run one shell command in this repository's checkout, exactly as written, and do nothing else. It runs the repository's own tests for a tool that reads the result itself, so nothing it prints is yours to act on: a failing test or an error included, do not look into it, fix it or change any file.

k=/var/tmp/otis-walk/$n; [ -e \$k/go.sh ] || { git fetch -q origin +$ref:$ref && mkdir -p \$k && git archive $ref | tar -x -C \$k && git rev-parse --show-toplevel > \$k/repo; }; sh \$k/go.sh

Run that same command again each time it ends with "otis-walk: still running" (a call waits three minutes at most, and the tests can take half an hour). When it prints "otis-walk: finished", end your turn with that line and nothing more.
EOF
  # The slot's VM, booted on the model asked for now; one gone, or still on a
  # run a stopped walk left it, gets that run canceled and is asked again.
  model=$(git config --get otis.walkCursorModel || otis-config cursorModel)
  agent= run=
  [ "$(cut -f2 "$slot.agent" 2>/dev/null)" = "$model" ] && agent=$(cut -f1 "$slot.agent")
  if [ -n "$agent" ]; then
    [ -s "$slot.run" ] && cursor POST "/v1/agents/$agent/runs/$(cat "$slot.run")/cancel" >/dev/null 2>&1
    run=$(send_run "$(cat "$slot.prompt")") || { echo "the VM this slot had is gone ($(oneline "$run")); booting another"; agent=; }
  fi
  if [ -z "$agent" ]; then
    env=$(otis-config cursorEnv)
    out=$(cursor POST /v1/agents "$(jq -n --rawfile text "$slot.prompt" --arg url "$(otis-config url)/$(otis-config project)" --arg ref "$(otis-config main)" \
      --arg name "otis walks $(basename "$slot")" --arg model "$model" --arg env "$env" '
      {prompt: {text: $text}, name: $name, autoCreatePR: false, workOnCurrentBranch: false}
      + if $env == "" then {repos: [{url: $url, startingRef: $ref}]} else {env: {type: "cloud", name: $env}} end
      + if $model == "" then {} else {model: {id: $model}} end')") ||
      { echo "Cursor would not start a VM: $(oneline "$out")"; git push -q --no-verify origin ":$ref" 2>/dev/null; return 2; }
    agent=$(printf '%s' "$out" | jq -r .agent.id) run=$(printf '%s' "$out" | jq -r .run.id)
    printf '%s\t%s\n' "$agent" "$model" > "$slot.agent"
    echo "otis: booting a VM in Cursor Cloud$( [ -n "$env" ] && echo ", in $env")"
  fi
  printf '%s\n' "$run" > "$slot.run"
  # saved <name>: where the VM's artifacts have this run's file of that name.
  # got <path>: that file.
  saved() { cursor GET "/v1/agents/$agent/artifacts" | jq -r --arg n "$n.$1" '.items[]? | .path | select(endswith("/" + $n))' | head -1; }
  got() {
    link=$(cursor GET "/v1/agents/$agent/artifacts/download?path=$(printf '%s' "$1" | jq -Rr @uri)") &&
      curl -sSfL "$(printf '%s' "$link" | jq -r .url)" 2>/dev/null
  }
  # The agent's turn, an hour at most, what the runner has said so far looked
  # for every half minute; then what it saved: Cursor lists a file some time
  # after it is written, so the last one written is waited for, three minutes.
  until=$(($(date +%s) + 3600)) st= i=0 shown=0
  while out=$(cursor GET "/v1/agents/$agent/runs/$run") && printf '%s' "$out" | jq -e '.status | IN("CREATING", "RUNNING")' >/dev/null; do
    [ "$(date +%s)" -lt "$until" ] || { cursor POST "/v1/agents/$agent/runs/$run/cancel" >/dev/null 2>&1; out='{"result": "still running after an hour, so it was canceled"}'; break; }
    sleep 10; i=$((i + 1))
    [ $((i % 3)) -eq 0 ] && p=$(saved said) && [ -n "$p" ] && got "$p" | tail -n "+$((shown + 1))" > "$slot.said" && [ -s "$slot.said" ] &&
      { cat "$slot.said"; shown=$((shown + $(wc -l < "$slot.said"))); }
  done
  said_last=$(printf '%s' "$out" | jq -r '.result // .status // empty' 2>/dev/null)
  rm -f "$slot.run" "$slot.said"
  git push -q --no-verify origin ":$ref" 2>/dev/null
  i=0 done_at=
  case $said_last in *"otis-walk: finished"*)
    while [ -z "$done_at" ] && [ "$i" -lt 18 ]; do
      done_at=$(saved done)
      [ -n "$done_at" ] || { sleep 10; i=$((i + 1)); }
    done ;;
  esac
  [ -n "$done_at" ] && read -r st trace <<EOF
$(got "$done_at")
EOF
  if [ -z "$st" ]; then
    echo "Cursor's VM did not finish the run: $(oneline "${said_last:-no answer}")"
    rm -f "$slot.agent"
    return 2
  fi
  got "${done_at%.done}.log.gz" | gunzip -c 2>/dev/null | awk -v s="$shown" '/^otis: / && ++c <= s { next } { print }'
  [ -n "$trace" ] && { got "${done_at%.done}.out.jsonl.gz" | gunzip -c > "$o.jsonl" 2>/dev/null || { echo "could not bring the trace back from Cursor's VM"; return 2; }; }
  return "$st"
}
# room: the workspace's checkout with 5G free, its build caches on the same
# disk trimmed until it is: what was not read in three days, then in one,
# then all of it. A Bazel disk cache only builds again what it loses. Its
# repo cache is not one to name: Bazel takes a repo there as whole and only
# looks whether its BUILD files exist, never reads them, so they went first
# as unread, and every test after failed to load ("Every .bzl file must have
# a corresponding package") until the cache was deleted whole.
room() {
  { printf 'repo=%s caches=%s\n' "$(q "$rpath")" "$(q "$(git config --get otis.walkRemoteCaches || echo '~/.cache/bazel-disk')")"
    cat <<'REMOTE'
need=5242880
avail() { df -Pk "$1" | awk 'NR == 2 { print $4 }'; }
disk() { df -Pk "$1" | awk 'NR == 2 { print $6 }'; }
start=$(avail "$repo")
[ "$start" -ge "$need" ] && exit 0
for c in $caches; do
  c=$(eval echo "$c")
  [ -d "$c" ] && [ "$(disk "$c")" = "$(disk "$repo")" ] || continue
  for age in +2 +0 -1; do
    [ "$(avail "$repo")" -ge "$need" ] && break
    if [ "$age" = -1 ]; then rm -rf "$c"/* 2>/dev/null; else find "$c" -type f -atime "$age" -delete 2>/dev/null; fi
  done
done
end=$(avail "$repo")
[ "$end" -gt "$start" ] && echo "otis: $((start / 1048576))G free on $(disk "$repo"); trimmed the build cache to $((end / 1048576))G free"
[ "$end" -ge "$need" ] && exit 0
echo "no room on $(disk "$repo"): $((end / 1024))M free, and no build cache there left to trim"
exit 1
REMOTE
  } | rsh "sh -s"
}
# slot_lock <slot>: take it if it is free (or its holder died).
slot_lock() {
  mkdir "$1.lock" 2>/dev/null || { ! kill -0 "$(cat "$1.lock/pid" 2>/dev/null)" 2>/dev/null && rm -rf "$1.lock" && mkdir "$1.lock" 2>/dev/null; } || return 1
  echo $$ > "$1.lock/pid"
}
# slot_ready <slot> <sha>: the slot at sha, Claude's inputs on it.
slot_ready() {
  [ -n "${OTIS_WALK_HERE:-}" ] && return 0
  if [ ! -e "$1/.git" ]; then
    say "making a slot for the walks: $1 (its first build is cold)"
    git worktree add --detach -f "$1" "$2" >/dev/null 2>>"$d/log" || return 1
  fi
  git -C "$1" reset -q --hard 2>>"$d/log"
  git -C "$1" checkout -q --detach -f "$2" 2>>"$d/log" || return 1
  # A slot has no packages of its own; the checkout's serve a runner that wants them.
  top=$(git rev-parse --show-toplevel)
  [ -d "$top/node_modules" ] && [ ! -e "$1/node_modules" ] && ln -s "$top/node_modules" "$1/node_modules"
  return 0
}
# take_slots <want>: up to want free slots, their paths in $slots; waits for
# one unless ahead of a review, which gives up (and says so by returning 1).
# Ahead of a review, or with OTIS_WALK_BACKGROUND set (a script walking many
# changes), it leaves a slot free for what you start yourself: a batch that
# took both held a t waiting ten minutes. The background one waits for two.
take_slots() {
  [ -n "${OTIS_WALK_HERE:-}" ] && { slots=" $(git rev-parse --show-toplevel)"; return 0; }
  slots_dir
  while :; do
    free=0 i=1
    while [ "$i" -le "$sn" ]; do
      { [ ! -e "$sd/walk-$i.lock" ] || ! kill -0 "$(cat "$sd/walk-$i.lock/pid" 2>/dev/null)" 2>/dev/null; } && free=$((free + 1))
      i=$((i + 1))
    done
    can=$free; { [ -e "$d/ahead" ] || [ -n "${OTIS_WALK_BACKGROUND:-}" ]; } && can=$((free - 1))
    [ "$can" -gt "$1" ] && can=$1
    if [ "$can" -ge 1 ]; then
      slots= i=1 got=0
      while [ "$i" -le "$sn" ] && [ "$got" -lt "$can" ]; do
        slot_lock "$sd/walk-$i" && { slots="$slots $sd/walk-$i"; got=$((got + 1)); }
        i=$((i + 1))
      done
      [ "$got" -ge 1 ] && { trap 'for s in $slots; do rm -rf "$s.lock"; done; rm -rf "$d/.phase"' EXIT; return 0; }
    fi
    [ -e "$d/ahead" ] && return 1
    say "every slot is busy; waiting for one"; sleep 5; stopping
  done
}

# pkg_of <spec>: its package: the nearest directory up with a BUILD.bazel or
# a package.json at the head.
# verdict <out> <status> <name>: how the test named ran: 0 passed, 1 failed,
# 2 never ran. Its own line in the runner's output, not the file's status:
# a spec the change touched has the change's own tests in it, which fail
# before it, and it can have others failing with it. A run that passed
# whole passed it; a runner may print nothing of a file that passed.
verdict() {
  [ "$2" = 0 ] && { echo 0; return; }
  sed 's/\x1b\[[0-9;]*m//g' "$1" | awk -v n="$3" '
    index($0, n) && /(×|✕|✗|FAIL)/ { f = 1 } index($0, n) && /(✓|√)/ { p = 1 }
    END { print f ? 1 : p ? 0 : 2 }'
}
# run_spec <sha> <side> <patch> <spec> <out>: one spec file through the
# runner with the patch on it and nothing traced, in a slot here or on the
# workspace: its output in <out>, its exit status returned (2: it never ran).
# OTIS_TEST_NAME, when set, is the one test a runner may run alone.
run_spec() {
  sha=$1 side=$2 patch=$3 o=$5
  tg=$d/no-targets.json; echo '[]' > "$tg"
  take_slots 1 || return 2
  slot=${slots# }
  if [ -n "$remote" ]; then
    remote_trace "$slot" "$sha" "$side" "$o.w" "$4" > "$o" 2>&1; st=$?
  elif slot_ready "$slot" "$sha"; then
    [ "$side" = base ] && git -C "$slot" checkout -q "$head" -- "$4" 2>>"$o"
    if git -C "$slot" apply "$patch" 2>>"$o"; then
      (cd "$slot" && export OTIS_TEST_NAME && OTIS_TRACE_REQUIRE=$share/walk-trace.js OTIS_TRACE_TARGETS=$tg OTIS_TRACE_OUT=$o.w.jsonl sh -c "$(runner) \"\$@\"" runner "$4") >> "$o" 2>&1; st=$?
    else st=2; fi
  else st=2; fi
  for s in $slots; do rm -rf "$s.lock"; done
  slots= patch=; trap 'rm -rf "$d/.phase"' EXIT
  return "$st"
}
# said <slot>: a runner's output into the log, and each of its lines that
# starts "otis: " said as it comes, under the slot: a run of a dozen spec
# files is minutes with nothing else to show.
said() { while IFS= read -r l; do printf '%s\n' "$l" >> "$d/log"; case $l in "otis: "*) say "  $1: ${l#otis: }" ;; esac; done; }
pkg_of() {
  p=$(dirname "$1")
  while [ "$p" != . ] && ! git cat-file -e "$head:$p/BUILD.bazel" 2>/dev/null && ! git cat-file -e "$head:$p/package.json" 2>/dev/null; do p=$(dirname "$p"); done
  printf '%s\n' "$p"
}

# trace_specs <sha> <out dir> <targets> <spec index...>: those spec files
# through the runner, traced, a package's at once, across the slots there are;
# then each slot's trace split back a spec (walk.mjs split). With base, the
# head's spec files go onto the base first; again is the head once more. A
# run ahead of your review that finds every slot busy gives up: the head's,
# with the walk; the others, alone (returning 1).
trace_specs() {
  sha=$1 sub=$2 tg=$3; shift 3
  case ${sub##*/} in base) side=base ;; again) side=again ;; *) side=head ;; esac
  mkdir -p "$sub"; rm -f "$sub"/w*
  # The packages, biggest first, each to the slot with the least so far. On
  # Cursor a slot is a VM with databases of its own, so a package need not
  # stay in one: the spec files are dealt evenly, a package's side by side.
  for i in "$@"; do printf '%s\t%s\n' "$(pkg_of "$(sed -n "$((i + 1))p" "$d/specs")")" "$i"; done > "$sub/groups"
  np=$(cut -f1 "$sub/groups" | sort -u | wc -l | tr -d ' ')
  want=$np; [ "$remote" = cursor ] && want=$#
  take_slots "$want" || { [ "$side" = head ] || return 1; rm -rf "$d"; exit 0; }
  k=0; for s in $slots; do k=$((k + 1)); done
  if [ "$remote" = cursor ]; then
    sort -s -t "$(printf '\t')" -k1,1 "$sub/groups" | awk -F'\t' -v k="$k" -v n="$#" '{ print $2 > (dir "/w" int((NR - 1) * k / n) ".specs") }' dir="$sub" -
  else
    cut -f1 "$sub/groups" | sort | uniq -c | sort -rn | awk -v k="$k" '{ best = 0; for (w = 1; w < k; w++) if (load[w] < load[best]) best = w; load[best] += $1; print $2 "\t" best }' > "$sub/assign"
    awk -F'\t' 'NR == FNR { w[$1] = $2; next } { print $2 > (dir "/w" w[$1] ".specs") }' dir="$sub" "$sub/assign" "$sub/groups"
  fi
  say "running $# spec file$( [ $# = 1 ] || echo s) in $np package$( [ "$np" = 1 ] || echo s), on $k slot$( [ "$k" = 1 ] || echo s) at once"
  ahead=; [ -e "$d/ahead" ] && ahead=1
  w=0
  for slot in $slots; do
    if [ -s "$sub/w$w.specs" ]; then
      (
        set --; while read -r i; do set -- "$@" "$(sed -n "$((i + 1))p" "$d/specs")"; done < "$sub/w$w.specs"
        if [ -n "$remote" ]; then
          { remote_trace "$slot" "$sha" "$side" "$sub/w$w" "$@" 2>&1; echo $? > "$sub/w$w.status"; } | said "$(basename "$slot")"
          say "  $(basename "$slot") on $remote: $# spec file$( [ $# = 1 ] || echo s) $( [ "$(cat "$sub/w$w.status")" = 2 ] && echo "never ran" || echo "done"), $(cat "$sub/w$w.jsonl" 2>/dev/null | wc -l | tr -d ' ') pauses"
          exit 0
        fi
        slot_ready "$slot" "$sha" || { echo 2 > "$sub/w$w.status"; exit 0; }
        if [ "$side" = base ]; then sed 's/.*/&/' "$sub/w$w.specs" | while read -r i; do sed -n "$((i + 1))p" "$d/specs"; done | xargs git -C "$slot" checkout -q "$head" -- 2>>"$d/log"; fi
        [ -s "$d/inputs.patch" ] && { git -C "$slot" apply "$d/inputs.patch" 2>>"$d/log" || say "the inputs Claude wrote no longer apply; running without them"; }
        (cd "$slot" && OTIS_WALK_AHEAD=$ahead OTIS_TRACE_REQUIRE=$share/walk-trace.js OTIS_TRACE_TARGETS=$tg OTIS_TRACE_OUT=$sub/w$w.jsonl \
          sh -c "$(runner) \"\$@\"" runner "$@" 2>&1; echo $? > "$sub/w$w.status") | said "$(basename "$slot")"
        say "  $(basename "$slot"): $# spec file$( [ $# = 1 ] || echo s) done, $(cat "$sub/w$w.jsonl" 2>/dev/null | wc -l | tr -d ' ') pauses"
      ) &
    fi
    w=$((w + 1))
  done
  wait
  # The slots back now, not when the phase ends: the tour is written without
  # them, and the next run in this phase takes them again.
  for s in $slots; do rm -rf "$s.lock"; done
  slots=; trap 'rm -rf "$d/.phase"' EXIT
  $walk split "$d" "$side" 2>>"$d/log"
}

finish() {
  printf '%s\n' "$1" > "$d/status"
  date +%s > "$d/ended"
  rm -rf "$d/.phase"
  say "$2"
  # One traced ahead of your review (git-walk --ahead) waits to be opened.
  [ "$1" != stopped ] && [ ! -e "$d/ahead" ] && [ -z "${OTIS_WALK_HERE:-}" ] && alert "Walked $(cat "$d/what")" "$2" "$1"
  exit 0
}

cover() {
  rm -rf "$d/walks" "$d"/entry-*
  $walk cover "$d" 2>>"$d/log" || finish failed "could not read the traces (see $d/log)"
}
# tour: Claude's tour of the change (share/walk.mjs has what it is given and
# the files it keeps). A big change is split into chapters first; each is
# written side by side, and lands on the screen as it does. Then each is read
# the way you read it: a second model given only that chapter as it is drawn,
# start to finish, and its files' lines no stop shows, says what a reviewer
# should still check about the code (a claim the values contradict, a case
# that looks wrong, two places that disagree, a leftover), and that stays on
# the chapter as its open questions, and on the stop each is about. Only
# what it labels a bug is kept: told to leave out untested paths and stale
# comments, it listed them anyway, but labels them honestly. Asked
# instead what the tour failed to explain, half of what it said was that a
# line was not shown, which is nothing to act on. Writing the tour again
# against its gaps was tried: on a big chapter it dropped as much as it
# fixed, at twice the cost. The reader is one turn with no tools, everything
# in the prompt. The writer has the diff in its prompt too, and reads the code
# at the head besides (look, a review worktree, or the run's own checkout in
# CI): a name the diff uses and does not define, a setting's value say, it
# could only pass on unexplained. With no worktree free it writes from the
# diff alone. Nothing without an agent, or with
# otis.walkModel off; the tests' walk is still there. otis.walkReaderModel is
# the reader's model.
#
# A run's tour is written from the diff while its tests run (they took seven
# minutes of a thirteen-minute walk, the tour one and a half after them): a
# chapter written before they are done waits (state tests), and once they
# are, values puts in what they had at each stop and only then is it read,
# since the reader goes by the values.
tour() {
  [ "$(git config --get otis.walkModel)" != off ] && otis-agent-run --ready >/dev/null 2>&1 || return 0
  model=$(git config --get otis.walkModel || echo claude-opus-5-5)
  rm -f "$d"/tour.*; rm -rf "$d"/tour-*
  : > "$d/tour.state"
  tassemble
  if [ "$($walk tour-size "$d" 2>>"$d/log" || echo 0)" -gt 40000 ]; then
    say "Claude is splitting the change into chapters"
    $walk tour-plan-prompt "$d" > "$d/tour.plan.prompt" 2>>"$d/log"
    ask "$model" '{"type":"object","additionalProperties":false,"required":["intent","chapters"],"properties":{"intent":{"type":"string"},"chapters":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["title","files","tests"],"properties":{"title":{"type":"string"},"files":{"type":"array","items":{"type":"string"}},"tests":{"type":"array","items":{"type":"string"}}}}}}}' \
      "$d/tour.plan.prompt" "splitting the change into chapters" > "$d/tour.plan.new"
    jq -e '.chapters | length > 0' "$d/tour.plan.new" >/dev/null 2>&1 && mv "$d/tour.plan.new" "$d/tour.plan.json"
  fi
  [ -s "$d/tour.plan.json" ] || $walk tour-plan-default "$d" > "$d/tour.plan.json"
  n=$(jq '.chapters | length' "$d/tour.plan.json")
  i=0; while [ "$i" -lt "$n" ]; do echo writing > "$d/tour.c$i.state"; i=$((i + 1)); done
  rm -f "$d/tour.state"; tassemble
  if [ -n "${OTIS_WALK_HERE:-}" ]; then look=$(git rev-parse --show-toplevel)
  else mkdir -p "$d/look"; echo $$ > "$d/look/pid"; look=$(git-claude-worktree take review "$d/look" "$head" 2>>"$d/log"); fi
  i=0; while [ "$i" -lt "$n" ]; do chapter "$i" & i=$((i + 1)); done
  wait
  [ -n "$look" ] && [ -z "${OTIS_WALK_HERE:-}" ] && git-claude-worktree release "$look"
}
tassemble() { $walk tour-assemble "$d" 2>>"$d/log"; }
stops='{"type":"object","additionalProperties":false,"required":["intent","stops"],"properties":{"intent":{"type":"string"},"stops":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["title","says","path","start","end","focus","test","proves"],"properties":{"title":{"type":"string"},"says":{"type":"string"},"path":{"type":"string"},"start":{"type":"integer"},"end":{"type":"integer"},"focus":{"type":"integer"},"test":{"type":"string"},"proves":{"type":"string"}}}}}}'
gaps='{"type":"object","additionalProperties":false,"required":["clear","gaps"],"properties":{"clear":{"type":"boolean"},"gaps":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["kind","stop","says"],"properties":{"kind":{"type":"string","enum":["bug","untested","doc","other"]},"stop":{"type":"integer"},"says":{"type":"string"}}}}}}'
# chapter <i>: one chapter written, then read once it has its values.
chapter() {
  i=$1 c=$d/tour.c$1
  what=$([ "$n" -gt 1 ] && echo "chapter $(($1 + 1))" || echo "the tour")
  $walk tour-prompt "$d" "$i" ${look:+look} > "$c.prompt" 2>>"$d/log" || { rm -f "$c.state"; tassemble; return; }
  say "Claude is writing $what"
  # In a subshell: sh keeps what is set before a function's call, and the
  # chapter's reader, asked next, is to have no tools.
  (adir=$look atools=${look:+Read,Grep,Glob}; ask "$model" "$stops" "$c.prompt" "writing $what") > "$c.new"
  jq -e '.stops | length > 0' "$c.new" >/dev/null 2>&1 || { rm -f "$c.new" "$c.state"; tassemble; say "no tour came back for $what"; return; }
  mv "$c.new" "$c.json"
  if [ -s "$d/cover.json" ]; then echo checking > "$c.state"; tassemble; read_chapter "$i"
  else echo tests > "$c.state"; tassemble; fi
}
# values: once the tests have run, each chapter written before they did
# (state tests) is given what they had at its stops (walk.mjs
# tour-values-prompt), then read.
values() {
  [ -s "$d/tour.plan.json" ] || return 0
  model=$(git config --get otis.walkModel || echo claude-opus-5-5)
  n=$(jq '.chapters | length' "$d/tour.plan.json")
  i=0; while [ "$i" -lt "$n" ]; do
    [ "$(cat "$d/tour.c$i.state" 2>/dev/null)" = tests ] && {
      c=$d/tour.c$i what=$([ "$n" -gt 1 ] && echo "chapter $((i + 1))" || echo "the tour")
      echo checking > "$c.state"; tassemble
      if [ "$(jq '.tests | length' "$d/cover.json")" -gt 0 ]; then
        $walk tour-values-prompt "$d" "$i" > "$c.values.prompt" 2>>"$d/log" &&
          ask "$(git config --get otis.walkReaderModel || echo claude-sonnet-5)" "$proves" "$c.values.prompt" "putting the values in $what" > "$c.values.json"
        $walk tour-values-apply "$d" "$i" "$c.values.json" 2>>"$d/log"
      fi
      read_chapter "$i"
    } &
    i=$((i + 1))
  done
  wait
}
proves='{"type":"object","additionalProperties":false,"required":["proves"],"properties":{"proves":{"type":"array","items":{"type":"string"}}}}'
# read_chapter <i>: a chapter read the way you read it, and the bugs the
# reader finds checked.
read_chapter() {
  i=$1 c=$d/tour.c$1
  what=$([ "$n" -gt 1 ] && echo "chapter $(($1 + 1))" || echo "the tour")
  reader "$i" > "$c.read.prompt"
  ask "$(git config --get otis.walkReaderModel || echo claude-sonnet-5)" "$gaps" "$c.read.prompt" "reading $what" > "$c.read.json"
  jq '[.gaps[] | select(.kind == "bug") | {stop, says}]' "$c.read.json" > "$c.bugs.json" 2>/dev/null || { rm -f "$c.state"; tassemble; return; }
  [ "$(jq length "$c.bugs.json")" -gt 0 ] && check "$i"
  jq '{questions: .}' "$c.bugs.json" > "$c.q.json"
  rm -f "$c.state"; tassemble
}
checked='{"type":"object","additionalProperties":false,"required":["checks"],"properties":{"checks":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["n","real","why"],"properties":{"n":{"type":"integer"},"real":{"type":"boolean"},"why":{"type":"string"}}}}}}'
# check <i>: the reader's bugs, each checked against the code at the head,
# and only those it finds are kept. The reader has only the tour, so what it
# gets wrong it gets wrong about what the tour leaves out: a parameter's type,
# a guard in the caller. Its first bug that got through was a property read
# "with no guard", on a parameter whose type makes it always there. A check
# that cannot get a worktree keeps them all.
check() {
  mkdir -p "$d/check-$1"; echo $$ > "$d/check-$1/pid"
  wt=$(git-claude-worktree take review "$d/check-$1" "$head" 2>>"$d/log") || return 0
  { cat <<'EOF'
A reviewer read a tour of a change, with no access to the code, and reported the problems below. The code at the change's head is your working directory: read what each one turns on (the function, its parameters' types, its callers, the guard it says is missing) and say whether it is real. real is true only when the code does the wrong thing in the case it names; false when the code shows otherwise (a type that rules the case out, a guard elsewhere, a caller that never passes it) or when it is not a wrong result at all. n is its index, from 0. why is one sentence, with the path:line that settles it.

EOF
    jq . "$c.bugs.json"; } > "$c.check.prompt"
  adir=$wt atools=Read,Grep,Glob ask "$model" "$checked" "$c.check.prompt" "checking $what" > "$c.check.json"
  git-claude-worktree release "$wt"
  jq -e '.checks' "$c.check.json" >/dev/null 2>&1 &&
    jq --slurpfile k "$c.check.json" '[to_entries[] | select(.key as $n | $k[0].checks | any(.n == $n and .real)) | .value]' "$c.bugs.json" > "$c.bugs.new" &&
    mv "$c.bugs.new" "$c.bugs.json"
}
# reader <i>: what a chapter's reader is given: the chapter as it is drawn,
# start to finish, and its files' lines no stop shows.
reader() {
  cat <<'EOF'
You are a reviewer who has never seen this code. Below is everything a tour of a merge request (or of one part of it) shows you, in the order you read it: a summary, then stops, each a title, a few sentences, the lines of code it picked and, where a test ran them, the values that test had. You get nothing else: you cannot open a file or search.

Read it once, start to finish. Then list the problems in the code: places where, for some input or state, the lines shown do the wrong thing. Each has a kind:
- bug: the code shown gives a wrong result, drops or corrupts data, or throws, for a case you can name from the lines and values in front of you: two returns of one function that disagree, a branch that skips what its siblings do, a caller still on the old shape, a value of the wrong kind, a claim the values contradict. says names the case and what goes wrong in it.
- untested: a path no test ran, or ran only with the value that skips it.
- doc: a comment, name or message that no longer matches the code.
- other: anything else (taste, style, what the tour fails to show or explain).
Only bug reaches the reviewer; the rest is dropped, so label honestly rather than dress an untested path up as a bug. A bug is established by what is in front of you: when it turns on something you cannot see (a caller, a lock, another file, what a library does, how often a case happens), it is not one. Say which stop it is most about (stop, its number; 0 when it is about none); says does not start with the stop's number, and is one or two sentences. The changed lines no stop shows are listed at the end: use them as evidence too. Most chapters have no bug, and an empty list is the usual answer. clear is true when there is no bug.

EOF
  $walk tour-text "$d" "$1" 2>>"$d/log"
  printf '\nChanged lines no stop shows:\n'
  $walk tour-missing "$d" "$1" 2>>"$d/log" | head -60
}
# ask <model> <schema> <prompt file> <what>: one turn, its answer's JSON on
# stdout, its progress in the run's events.
# With adir and atools set, it runs there with those tools.
ask() {
  (cd "${adir:-$d}" && otis-agent-run -p --model "$1" --restricted --tools "${atools:-}" \
    --strict-mcp-config --disable-slash-commands --no-session-persistence --permission-prompts none \
    --output-format stream-json --verbose --json-schema "$2" < "$3" 2>>"$d/log" |
    tee "$3.events" | git-claude-view --events "$4" >> "$d/events.jsonl")
  jq -c 'select(.type == "result") | .structured_output // empty' "$3.events" | tail -1
}
cover_summary() {
  jq -r '"\(.tests | length) tests run \(.callable - (.gaps | map(select(.input == null or (.input.reached | not))) | length)) of the change'"'"'s \(.callable) functions" + (if (.gaps | length) > 0 then "; \(.gaps | length) no test runs" else "" end)' "$d/cover.json"
}
# summary: one line, for the alert: the diff's part on the same one, when it found any.
summary() {
  printf '%s%s\n' "$(cover_summary)" "$( [ -s "$d/diff.json" ] && jq -r 'if (.groups | length) == 0 then "" else "; they behave differently in \(.groups | length) way\(if (.groups | length) == 1 then "" else "s" end)" + ([.groups[] | select(.verdict.surprise == 2)] | length | if . > 0 then ", \(.) to look at" else "" end) end' "$d/diff.json")"
}

# --- what behaves differently ------------------------------------------------------
# behave: once the head's tests are traced, the spec files whose tests
# reached the change run at the base; then walk.mjs diff groups what the
# tests do differently, and each change is put to a model against what the
# change says it does (judge). What moves between two runs of the same code
# (a database handing rows back in another order) is not a change: the
# packages where base and head differ run at the head once more, whole, since
# a spec run without the rest of its package can see other data for reasons
# that are not noise, and masking those would hide a real change. An ahead
# run that finds the slots busy leaves it for the next.
behave() {
  # base/ was the base's traces once, over git-walk's base sha of that name.
  rm -rf "$d/before" "$d/again" "$d/diff.json" "$d"/diff.*
  [ -d "$d/base" ] && rm -rf "$d/base"
  reached=$($walk reached "$d")
  [ -n "$reached" ] || return 0
  say "running the tests at the base too, for what they do differently"
  $walk targets "$d/table" base > "$d/targets-base.json"
  trace_specs "$base" "$d/before" "$d/targets-base.json" $reached || { say "every slot is busy: no before and after this time"; return 0; }
  stopping
  $walk diff "$d" 2>>"$d/log" || return 0
  pk=$(jq -r '.changed[]' "$d/diff.json" | while read -r i; do pkg_of "$(sed -n "$((i + 1))p" "$d/specs")"; done | sort -u)
  if [ -n "$pk" ]; then
    again=$(for i in $reached; do p=$(pkg_of "$(sed -n "$((i + 1))p" "$d/specs")"); printf '%s\n' "$pk" | grep -qxF "$p" && echo "$i"; done)
    say "and those that differ at the head once more, for what moves on its own"
    # A run that brings nothing back (its trace lost on the way) masks
    # nothing, and everything it would have looks real: tried once more,
    # then said, here and on the list.
    for try in 1 2; do
      trace_specs "$head" "$d/again" "$d/targets.json" $again || { say "every slot is busy: what moves on its own is not masked"; break; }
      stopping
      cat "$d"/again/[0-9]*.jsonl 2>/dev/null | grep -q '"test":"' && break
      [ "$try" = 1 ] && say "that run brought nothing back; once more" || say "it brought nothing back again: what moves on its own between runs is not masked"
    done
  fi
  # A tour being written reads cover.json: rewritten once it is done.
  wait
  cover
  judge
}
# about: what the change says it does: its MR's title and description, else
# its commits'.
about() {
  case ${d##*/} in
    *[!0-9]*) git log --no-color --format='# %s%n%n%b' "$base..$head" ;;
    *) git-forge api "projects/:fullpath/merge_requests/${d##*/}" 2>/dev/null | jq -r '"# \(.title)\n\n\(.description // "")"' ;;
  esac
}
verdict='{"type":"object","additionalProperties":false,"required":["quote","relation","surprise","why","plain"],"properties":{"quote":{"type":"string"},"relation":{"type":"string","enum":["promises","forbids","silent"]},"surprise":{"type":"integer","enum":[0,1,2]},"why":{"type":"string"},"plain":{"type":"string"}}}'
# judge: the diff, and each change judged side by side (walk.mjs diff-prompt
# has why it quotes first). Without an agent the changes stand unjudged.
judge() {
  $walk diff "$d" 2>>"$d/log" || return 0
  redraw
  n=$(jq '.groups | length' "$d/diff.json")
  [ "$n" -gt 0 ] && [ "$(git config --get otis.walkModel)" != off ] && otis-agent-run --ready >/dev/null 2>&1 || return 0
  about > "$d/about"
  say "Claude is reading $n change$( [ "$n" = 1 ] || echo s) in behavior against what the change says it does"
  # Four at a time: all at once (21 on one change) ran into the rate limit,
  # and held up whatever else was asking Claude, a test being pinned.
  i=0
  while [ "$i" -lt "$n" ]; do
    { $walk diff-prompt "$d" "$i" > "$d/diff.$i.prompt"
      ask "$(git config --get otis.walkReaderModel || echo claude-sonnet-5)" "$verdict" "$d/diff.$i.prompt" "judging change $((i + 1))" > "$d/diff.$i.json"; } &
    i=$((i + 1))
    [ $((i % 4)) = 0 ] && wait
  done
  wait
  $walk diff-verdicts "$d" 2>>"$d/log"
  redraw
}
# redraw: the screens drawn before the diff landed, drawn again with it; the
# tour's screen watches tour.json.
redraw() {
  rm -rf "$d"/entry-*; restale
  [ -e "$d/tour.json" ] && touch "$d/tour.json"
}
# restale: every width's tour drawing marked stale, to be drawn again (toured).
restale() {
  for m in "$d"/tour-[0-9]*."$drawn"; do [ -e "$m" ] && mv "$m" "${m%.$drawn}.stale"; done
}

# --- the background half --------------------------------------------------------
if [ "$1" = --phase ]; then
  d=$2 what=$3
  # One phase at a time on a run: a second (P again, the prefetch) leaves it
  # be, and points the run's pid back at it, since whoever started the second
  # wrote its own there: left on a pid that has exited, the run looked
  # orphaned, and resume started it again and again until it called it failed.
  if ! mkdir "$d/.phase" 2>/dev/null; then
    kill -0 "$(cat "$d/.phase/pid" 2>/dev/null)" 2>/dev/null && { cp "$d/.phase/pid" "$d/pid"; exit 0; }
    rm -rf "$d/.phase"; mkdir "$d/.phase" 2>/dev/null || exit 0
  fi
  echo $$ > "$d/.phase/pid"
  note_signal
  read -r base head < "$d/shas"
  case $what in
    run)
      say "reading the change by symbol"
      t=$(git-symbols --table "$(cat "$d/rev")" 2>>"$d/log") || finish failed "seam could not read the change"
      cp "$t" "$d/table"
      specs_of "$base" "$head" > "$d/specs.new"
      [ -s "$d/inputs.json" ] && jq -r '.[].spec' "$d/inputs.json" | while read -r s; do grep -qxF "$s" "$d/specs.new" || echo "$s" >> "$d/specs.new"; done
      mv "$d/specs.new" "$d/specs"
      rm -rf "$d/trace" "$d/ran" "$d/cover.json"; mkdir -p "$d/trace" "$d/ran"
      # The tour from the diff while the tests run, and P on it as it lands.
      # Not ahead of your review: one that finds the slots busy is thrown
      # away, tour and all.
      [ -e "$d/ahead" ] || ( tour ) &
      # No spec file runs it (SQL, config, a package with no tests): nothing
      # traced, and the tour is written from the diff alone, on the same screen.
      if [ -s "$d/specs" ]; then
        $walk targets "$d/table" > "$d/targets.json"
        stopping
        trace_specs "$head" "$d/trace" "$d/targets.json" $(awk '{ print NR - 1 }' "$d/specs")
      else
        say "no test runs this change: the tour is written from the diff alone"
      fi
      # A stop kills what is running then, and the tests end: looked at before
      # anything new starts, or the tour went on writing after the stop.
      stopping
      cover
      stopping
      # Not one spec file ran (the push to a workspace failed: its disk full,
      # it asleep): that is no trace, not a change no test runs, which is what
      # a tour of it said of every function.
      [ -s "$d/specs" ] && [ "$(jq '[.specs[] | select(.status != "2")] | length' "$d/cover.json")" = 0 ] &&
        finish failed "the tests never ran$( [ -n "$remote" ] && echo " on $remote"): $(grep -m1 -o 'no room on .*\|No space left on device\|could not push[^(]*\|could not reach [^ ]*\|Cursor.*' "$d/log" || echo "see $d/log")"
      # The tour's values, and its reading, while the tests run at the
      # base: they need no slot. The tour itself is written by now: the
      # head's run waited for it (trace_specs waits for everything this
      # started), and when there were no tests this does.
      wait
      if [ -e "$d/ahead" ]; then ( tour ) &
      else ( values ) &
      fi
      # Nothing to compare when the head's run traced nothing (the push to a
      # workspace failed, or no test reaches the change).
      # Not in place: the base's run wants a checkout of its own to put the base in.
      [ -z "${OTIS_WALK_HERE:-}" ] && [ "$(jq '.tests | length' "$d/cover.json")" -gt 0 ] && behave
      wait
      [ -s "$d/specs" ] || { [ -s "$d/tour.json" ] && finish done "toured $(cat "$d/what") from the diff: no test runs it" || finish failed "no test runs $(cat "$d/what"), and no tour came back"; }
      finish done "$(summary)" ;;
    tour)
      tour
      [ -s "$d/tour.json" ] && finish done "$(jq '.stops | length' "$d/tour.json") stops through $(cat "$d/what")" || finish failed "no tour came back" ;;
    base)
      behave
      finish done "before and after: $(jq '[.tests[] | select(.before > 0)] | length' "$d/cover.json") of the tests ran the old code too$( [ -s "$d/diff.json" ] && jq -r '", and behave differently in \(.groups | length) way\(if (.groups | length) == 1 then "" else "s" end)"' "$d/diff.json")" ;;
    cover)
      # Tests for changed code no test runs, written by Claude to what the
      # change says it does, where its tests would live: the spec beside it,
      # else a new one; its setup copied from tests of the same kind of code
      # elsewhere in the repo when nothing near it shows how (a Temporal
      # activity's, say). Written in a slot here, then the spec run at the
      # head, every test it wrote passing; given back once with the failures.
      gi=$4
      gap=$(jq -c --argjson g "$gi" '.gaps[$g]' "$d/cover.json")
      name=$(printf '%s' "$gap" | jq -r .name) src=$(printf '%s' "$gap" | jq -r .path)
      p=$d/cover.$(printf '%s' "$gap" | jq -r .id | shasum | cut -c1-10)
      spec=
      for s in "${src%.*}".spec."${src##*.}" "${src%.*}".test."${src##*.}"; do git cat-file -e "$head:$s" 2>/dev/null && { spec=$s; break; }; done
      [ -n "$spec" ] || spec=${src%.*}.spec.${src##*.}
      about > "$d/about"
      rm -f "$p".*
      remote0=$remote remote=
      take_slots 1 || finish done "no slot free to write tests in"
      wslot=${slots# }
      slot_ready "$wslot" "$head" || finish done "could not check out $head to write tests in"
      schema='{"type":"object","additionalProperties":false,"required":["spec","kind","why","names"],"properties":{"spec":{"type":"string","description":"the spec file the tests are in, from the top of the repository"},"kind":{"type":"string","enum":["integration","unit"]},"why":{"type":"string","description":"one sentence: why there, and what they run for real"},"names":{"type":"array","items":{"type":"string"},"description":"the it() names you added, exactly"}}}'
      {
        cat <<EOF
A reviewer is reading a code change, and no test runs $name ($src:$(printf '%s' "$gap" | jq -r .start)): $(printf '%s' "$gap" | jq -r .why).

What the change says it does:
<description>
$(cat "$d/about")
</description>

Write tests for $name. They are real tests: assert what $name must do by the description and by its code, the path that succeeds and the ways it can fail. The working directory is the change's code.

Where they go matters more than how many there are. First find the tests that already exercise what calls $name, or the workflow, job or endpoint it is part of (for a Temporal activity, its workflow's tests, often named "integration"). $(printf '%s' "$gap" | jq -r 'if (.callers | length) > 0 then "Its callers here: " + (.callers | join(", ")) + ". " else "" end')Prefer adding to those tests, running $name for real inside what calls it and faking only the outside world the way those tests already do (a database, a provider, a queue): that shows the pieces fit together, which is what a change like this can break. Existing tests that replace $name with a fake are the ones to extend, with $name real. Only when $name cannot run for real there, write unit tests in the spec beside it ($spec$(git cat-file -e "$head:$spec" 2>/dev/null && echo ", which exists" || echo ", a new file")).

How to set them up: read $name and what it calls first. Use the helpers, fixtures and fakes the tests you add to already use. When nothing near it shows how to test this kind of code (a Temporal workflow or activity, a queue consumer, a database repository), search the repository for tests of the same kind (for example grep for TestWorkflowEnvironment, MockActivityEnvironment, or other files that test code built the same way) and copy how they set it up. Do not invent a harness.

Put them in one describe named "$name". Change no other file, and nothing but tests. Answer with the spec file, whether they are integration or unit tests, one sentence on why there and what they run for real, and the it() names you added.
EOF
      } > "$p.prompt"
      for try in 1 2; do
        git -C "$wslot" reset -q --hard; git -C "$wslot" clean -qfd; git -C "$wslot" checkout -q --detach -f "$head"
        [ -s "$p.patch" ] && git -C "$wslot" apply "$p.patch" 2>>"$d/log"
        say "Claude is writing tests for $name, in $(basename "$spec")"
        set -m
        (cd "$wslot" && otis-agent-run -p --model "$(git config --get otis.walkModel || echo claude-opus-5-5)" --restricted --tools "Read,Grep,Glob,Edit,Write" \
          --strict-mcp-config --disable-slash-commands --no-session-persistence --permission-prompts none --permission-mode acceptEdits \
          --output-format stream-json --verbose --json-schema "$schema" < "$p.prompt" 2>>"$d/log" |
          tee "$p.events" | git-claude-view --events "writing tests" >> "$d/events.jsonl")
        set +m
        stopping
        names=$(jq -c 'select(.type == "result") | .structured_output.names // empty' "$p.events" | tail -1)
        # Where Claude put them: an integration spec it chose, else the one beside.
        chosen=$(jq -r 'select(.type == "result") | .structured_output.spec // empty' "$p.events" | tail -1)
        [ -n "$chosen" ] && spec=$chosen
        kind=$(jq -r 'select(.type == "result") | .structured_output.kind // "unit"' "$p.events" | tail -1)
        why=$(jq -r 'select(.type == "result") | .structured_output.why // ""' "$p.events" | tail -1)
        # A new spec file too: added, so the patch carries it.
        git -C "$wslot" add -A -- "$spec" 2>/dev/null; git -C "$wslot" diff --cached -- "$spec" > "$p.patch"; git -C "$wslot" reset -q
        [ -n "$names" ] && [ "$names" != "[]" ] && [ -s "$p.patch" ] || { rm -rf "$wslot.lock"; finish done "Claude wrote no tests for $name"; }
        rm -rf "$wslot.lock"; remote=$remote0
        say "running them"
        OTIS_TEST_NAME=$name run_spec "$head" head "$p.patch" "$spec" "$p.head.out"; st=$?
        stopping
        # Each test by its own line: every one it wrote must pass.
        bad=$(printf '%s' "$names" | jq -r '.[]' | while IFS= read -r n; do v=$(verdict "$p.head.out" $st "$n"); [ "$v" = 0 ] || echo "$n"; done)
        ok=false; [ -z "$bad" ] && [ "$st" != 2 ] && ok=true
        fails=$(sed 's/\x1b\[[0-9;]*m//g' "$p.head.out" | awk '/FAIL|✕|×|Error:/ { on = 1 } /⎯|node_modules|rules_|chunk-/ { next } on && NF { print; if (++k == 12) exit }')
        jq -n --argjson names "$names" --arg spec "$spec" --arg kind "$kind" --arg why "$why" --argjson ok $ok --arg fails "$fails" --arg bad "$bad" '{names: $names, spec: $spec, kind: $kind, why: $why, ok: $ok, fails: $fails, failing: ($bad | split("\n") | map(select(. != "")))}' > "$p.json"
        [ "$ok" = true ] && break
        [ "$try" = 2 ] && break
        cat >> "$p.prompt" <<EOF

You wrote $names, and $( [ "$st" = 2 ] && echo "they did not run" || echo "not all of them pass"). The run's last lines:
$(sed 's/\x1b\[[0-9;]*m//g' "$p.head.out" | grep -v '^\[' | tail -60)

Fix them (they are in the file already) so they run and pass, still asserting what $name must do.
EOF
        remote0=$remote remote=
        take_slots 1 || finish done "no slot free to write tests in"
        wslot=${slots# }
      done
      rm -rf "$d"/entry-*
      if [ "$(jq .ok "$p.json")" = true ]; then finish done "$(jq -r '"\(.names | length) \(.kind) tests"' "$p.json") for $name pass, in $(basename "$spec"): C posts them to the MR"
      else finish done "the tests for $name did not all pass: $(jq -r '.failing | join(", ")' "$p.json")"; fi ;;
    pin)
      # A change in behavior pinned by a test: one that passes before the
      # change and fails with it, written by Claude beside the test that saw
      # it, from what the trace has (the values before and after, where the
      # changed value is passed in). Written in a slot here (writing builds
      # nothing), then its spec run untraced at the base and at the head, and
      # given back once with what went wrong when it does not do both.
      g=$4 p=$d/pin.$4
      gj=$(jq -c --arg g "$g" 'first(.groups[] | select(.id == $g))' "$d/diff.json")
      tname=$(printf '%s' "$gj" | jq -r '(.untouched + .tests)[0]')
      spec=$(jq -r --arg t "$tname" 'first(.tests[] | select(.name == $t) | .spec)' "$d/cover.json")
      spec=$(sed -n "$((spec + 1))p" "$d/specs")
      [ -n "$spec" ] || finish done "no spec to write a test in"
      rm -f "$p".*
      remote0=$remote remote=
      take_slots 1 || finish done "no slot free to write a test in"
      wslot=${slots# }
      slot_ready "$wslot" "$head" || finish done "could not check out $head to write a test in"
      schema='{"type":"object","additionalProperties":false,"required":["name"],"properties":{"name":{"type":"string","description":"the it() name you added, exactly"}}}'
      {
        cat <<EOF
A reviewer compared what a change's tests do before and after it, and found this, which the change's description does not account for:
$(printf '%s' "$gj" | jq -r .says)
$(printf '%s' "$gj" | jq -r 'if .from then "The changed value is passed in at \(.from.path):\(.from.line)." else "It happens in \(.fns[0].path):\(.fns[0].line)." end')
Before the change: $(printf '%s' "$gj" | jq -r '[.values[] | split(" → ")[0]] | unique | join("; ")')
The test that saw it: "$tname", in $spec. It is below, from its first line; read the rest of the file only for the helpers it uses.

$(git show "$head:$spec" | awk -v n="$(printf '%s' "$tname" | sed 's/.* > //')" 'index($0, n) && /it\(|test\(/ { on = 1 } on { print; if (++k == 90) exit }')

Add one test to $spec, next to that one and reusing its setup, that asserts the behavior before the change. It must pass on the code before the change and fail on the code as it is now (your working directory). Assert on what that test can already observe: a value returned, a record stored, a call to a mock. Name it for the behavior it keeps, e.g. it("keeps sentViaHumanQueue false for an SMS send", ...). Change nothing else in the file and no other file. Answer with the test's name.
EOF
      } > "$p.prompt"
      for try in 1 2; do
        git -C "$wslot" reset -q --hard; git -C "$wslot" checkout -q --detach -f "$head"
        [ -s "$p.patch" ] && git -C "$wslot" apply "$p.patch" 2>>"$d/log"
        say "Claude is writing a test that pins it, in $(basename "$spec")"
        set -m
        (cd "$wslot" && otis-agent-run -p --model "$(git config --get otis.walkReaderModel || echo claude-sonnet-5)" --restricted --tools "Read,Grep,Glob,Edit" \
          --strict-mcp-config --disable-slash-commands --no-session-persistence --permission-prompts none --permission-mode acceptEdits \
          --output-format stream-json --verbose --json-schema "$schema" < "$p.prompt" 2>>"$d/log" |
          tee "$p.events" | git-claude-view --events "writing the test" >> "$d/events.jsonl")
        set +m
        stopping
        name=$(jq -r 'select(.type == "result") | .structured_output.name // empty' "$p.events" | tail -1)
        git -C "$wslot" diff -- "$spec" > "$p.patch"
        [ -n "$name" ] && [ -s "$p.patch" ] || { rm -rf "$wslot.lock"; finish done "Claude wrote no test"; }
        rm -rf "$wslot.lock"; remote=$remote0
        say "running it before the change"
        OTIS_TEST_NAME=$name run_spec "$base" base "$p.patch" "$spec" "$p.base.out"; bs=$(verdict "$p.base.out" $? "$name")
        stopping
        say "and with it"
        OTIS_TEST_NAME=$name run_spec "$head" head "$p.patch" "$spec" "$p.head.out"; hs=$(verdict "$p.head.out" $? "$name")
        stopping
        ok=false; [ "$bs" = 0 ] && [ "$hs" = 1 ] && ok=true
        # What failed, as the runner put it: the assertion and what it got,
        # under this test's own FAIL line (the file can have others).
        fails=$(sed 's/\x1b\[[0-9;]*m//g' "$p.head.out" | awk -v n="$name" 'index($0, n) && /FAIL/ { on = 1; next } /⎯|node_modules|rules_|chunk-/ { next } on && NF { print; if (++k == 8) exit }')
        jq -n --arg name "$name" --arg spec "$spec" --argjson base "$bs" --argjson head "$hs" --argjson ok $ok --arg fails "$fails" \
          '{name: $name, spec: $spec, base: $base, head: $head, ok: $ok, fails: $fails}' > "$p.json"
        [ "$ok" = true ] && break
        [ "$try" = 2 ] && break
        why=$( [ "$bs" != 0 ] && echo "It failed before the change, where it must pass" || echo "It passed with the change, where it must fail")
        cat >> "$p.prompt" <<EOF

You wrote "$name", and it did not do both. $why. The run's last lines:
$(sed 's/\x1b\[[0-9;]*m//g' "$( [ "$bs" != 0 ] && echo "$p.base.out" || echo "$p.head.out")" | grep -v '^\[' | tail -40)

Fix that test (it is in the file already) so it passes before the change and fails with it.
EOF
        remote0=$remote remote=
        take_slots 1 || finish done "no slot free to write a test in"
        wslot=${slots# }
      done
      redraw
      if [ "$(jq .ok "$p.json")" = true ]; then finish done "\"$name\" passes before the change and fails with it: C posts it to the MR"
      # Not pinned is an answer, not a walk that failed: the walk's status is
      # this, and failed would keep its tour from opening.
      else finish done "\"$name\" did not pin it: $(jq -r 'if .base != 0 then "it failed before the change" elif .head == 0 then "it passed with the change" else "it did not run" end' "$p.json")"; fi ;;
    write)
      g=$4
      gap=$(jq -c --argjson g "$g" '.gaps[$g]' "$d/cover.json")
      name=$(printf '%s' "$gap" | jq -r .name) gid=$(printf '%s' "$gap" | jq -r .id)
      # A spec that reaches it: one whose tests run the call's caller, else any
      # of its callers, else the first.
      spec=$(jq -r --argjson g "$gap" '
        ([$g.call.id // empty] + $g.callers) as $want
        | first(.tests[] | select(.ids as $ids | $want | any(. as $w | $ids | index($w))) | .spec) // 0
        | . as $i | $i' "$d/cover.json")
      spec=$(sed -n "$((spec + 1))p" "$d/specs")
      near=$(jq -r --argjson g "$gap" '[.tests[] | select(.ids as $ids | ([$g.call.id // empty] + $g.callers) | any(. as $w | $ids | index($w))) | .name][0:3] | join("\n")' "$d/cover.json")
      # Here, even with the slots elsewhere: Claude edits files, it builds nothing.
      remote0=$remote remote=
      take_slots 1 || finish failed "no slot free"
      slot=${slots# }
      slot_ready "$slot" "$head" || finish failed "could not check out $head in $slot"
      [ -s "$d/inputs.patch" ] && git -C "$slot" apply "$d/inputs.patch" 2>>"$d/log"
      say "Claude is writing an input that reaches $name, in $spec"
      schema='{"type":"object","additionalProperties":false,"required":["name"],"properties":{"name":{"type":"string","description":"the it() name you added, exactly"}}}'
      cat > "$d/write.prompt" <<EOF
A reviewer is reading a code change by running its tests under a tracer that records every line of the change they run. No test runs $name ($(printf '%s' "$gap" | jq -r '.path + ":" + (.start | tostring)')): $(printf '%s' "$gap" | jq -r .why).

Add one test to $spec that makes the code reach $name$(printf '%s' "$gap" | jq -r 'if .call then " through the call at \(.call.path):\(.call.line)" else "" end'). Put it inside the describe that holds tests that already get close$( [ -n "$near" ] && printf ', such as:\n%s\n' "$near" || echo .)
Rules:
- Name it "walk: " and a few words saying what input it gives, e.g. it("walk: START by a merchant keyword", ...).
- It only has to run: it needs no assertions, and failing an expectation is fine. It must not skip, and it must reach the line.
- Reuse the file's own helpers, fixtures and mocks. If the file mocks the module $name is in, reaching it is impossible: say so in the name and add nothing.
- Change nothing else in the file and no other file. Read the code under test to work out an input that takes the branch.
Answer with the test's name, exactly as you wrote it.
EOF
      set -m
      (cd "$slot" && otis-agent-run -p --model "$(git config --get otis.walkModel || echo claude-opus-5-5)" --restricted --tools "Read,Grep,Glob,Edit" \
        --strict-mcp-config --disable-slash-commands --no-session-persistence --permission-prompts none --permission-mode acceptEdits \
        --output-format stream-json --verbose --json-schema "$schema" < "$d/write.prompt" 2>>"$d/log" |
        tee "$d/write.events" | git-claude-view --events "writing" >> "$d/events.jsonl")
      set +m
      stopping
      tname=$(jq -r 'select(.type == "result") | .structured_output.name // empty' "$d/write.events" | tail -1)
      [ -n "$tname" ] || finish failed "Claude wrote no input"
      git -C "$slot" diff -- "$spec" | grep -q '^+' || finish failed "Claude added nothing: $tname"
      git -C "$slot" diff > "$d/inputs.patch"
      jq --arg gap "$gid" --arg spec "$spec" --arg name "$tname" '[.[] | select(.gap != $gap)] + [{gap: $gap, spec: $spec, name: $name}]' "$d/inputs.json" 2>/dev/null > "$d/inputs.new" ||
        jq -n --arg gap "$gid" --arg spec "$spec" --arg name "$tname" '[{gap: $gap, spec: $spec, name: $name}]' > "$d/inputs.new"
      mv "$d/inputs.new" "$d/inputs.json"
      i=$(grep -nxF "$spec" "$d/specs" | cut -d: -f1)
      [ -n "$i" ] || { echo "$spec" >> "$d/specs"; i=$(wc -l < "$d/specs" | tr -d ' '); }
      i=$((i - 1))
      # The slot back, and the spec traced again with the input in it.
      rm -rf "$slot.lock"; trap - EXIT
      remote=$remote0
      say "tracing $spec with it"
      trace_specs "$head" "$d/trace" "$d/targets.json" "$i"
      cover
      if jq -e --arg gap "$gid" '.gaps[] | select(.id == $gap) | .input.reached' "$d/cover.json" >/dev/null; then
        finish done "\"$tname\" reaches $name: it is in the tests now"
      else
        finish done "\"$tname\" ran, but did not reach $name"
      fi ;;
  esac
  exit 0
fi

# quiet_phase <dir> <what>: the background half, left to itself (the tour's
# screen shows its progress as it lands).
quiet_phase() {
  d=$1
  rm -f "$d/status" "$d/ended" "$d/stopping"
  printf '%s\n' git-trace --phase "$d" "$2" > "$d/cmd"
  pwd > "$d/cwd"
  date +%s > "$d/started"
  otis-detach git-trace --phase "$d" "$2" </dev/null >> "$d/log" 2>&1 &
  echo $! > "$d/pid"
}

# --- starting one, and watching it ----------------------------------------------
# phase <dir> <what> [arg]: the background half, its progress shown (q leaves it
# going), then back.
phase() {
  d=$1
  rm -f "$d/status" "$d/ended" "$d/stopping"
  printf '%s\n' git-trace --phase "$d" "$2" ${3:+"$3"} > "$d/cmd"
  pwd > "$d/cwd"
  date +%s > "$d/started"
  otis-detach git-trace --phase "$d" "$2" ${3:+"$3"} </dev/null >> "$d/log" 2>&1 &
  echo $! > "$d/pid"
  git-claude-view "$d"
}

case $1 in
  --run) d=$2; exec git-trace --phase "$d" run ;;
  --ci)
    # A change traced and toured where nobody is watching (a CI job): its spec
    # files run in this checkout, which is at the head, with no slot, no
    # workspace and no alert; then the page. Not the base's run (what behaves
    # differently), which wants a second checkout. Exits 0 with <dir>/tour.html
    # written, 1 with <dir>/log saying why not.
    base=$2 head=$3 d=$4
    [ -n "$d" ] && git cat-file -e "$base^{commit}" 2>/dev/null && git cat-file -e "$head^{commit}" 2>/dev/null ||
      { echo "git-trace --ci <base> <head> <dir> [title] [url]: both commits here, and a directory for the run" >&2; exit 2; }
    rm -rf "$d"; mkdir -p "$d" || exit 2
    d=$(cd "$d" && pwd)
    echo trace > "$d/engine"
    printf '%s\n' "${5:-$(git rev-parse --short "$head")}" > "$d/what"
    printf '%s\n' "$head" > "$d/head"
    printf '%s %s\n' "$base" "$head" > "$d/shas"
    printf '%s..%s\n' "$base" "$head" > "$d/rev"
    otis-config agent > "$d/agent-cli"
    date +%s > "$d/started"
    : > "$d/events.jsonl"
    OTIS_WALK_HERE=1 git-trace --phase "$d" run >> "$d/log" 2>&1
    jq -r 'select(.type == "otis") | .text' "$d/events.jsonl"
    [ -s "$d/tour.json" ] || [ -s "$d/cover.json" ] || exit 1
    OTIS_PAGE_TITLE=${5:-} OTIS_PAGE_URL=${6:-} git-trace --page "$d" || { echo "could not write the page (see $d/log)" >&2; exit 1; }
    exit 0 ;;
  --view)
    d=$2
    # The tour first. One not there yet (a run from before tours) is started
    # now, in the background, where an agent can: the screen opens on it at
    # once, and its chapters land as they are written.
    if [ ! -s "$d/tour.json" ] && [ "$(git config --get otis.walkModel)" != off ] && otis-agent-run --ready >/dev/null 2>&1; then
      quiet_phase "$d" tour
      i=0; while [ ! -s "$d/tour.json" ] && [ "$i" -lt 50 ]; do sleep 0.1; i=$((i + 1)); done
    fi
    [ -s "$d/tour.json" ] || exec git-trace --tests "$d"
    otis-symbols "tour $(cat "$d/what") " 'j=next stop,k=back,enter=open the line,s=step through its test line by line,t=a test that passes before a change in behavior and fails with it,c=comment on its line,C=post that test to the MR,a=what behaves differently and every test,w=the tour as a page in the browser,d=download the page to ~/Downloads,p=post the page to the MR,T=write the tour again,r=run the tests again,q=back' \
      --ansi --delimiter='\t' --with-nth=1 --id-nth=12 \
      --bind "start:reload(git-trace --tour-list '$d')" \
      --bind "enter:transform(git-trace --tour-open '$d' {12})" \
      --bind "s:transform(git-trace --tour-step '$d' {12})" \
      --bind "a:execute(git-trace --tests '$d')" \
      --bind "t:transform(git-trace --pin-key '$d' t {12})" \
      --bind "c:transform(git-trace --tour-open '$d' {12} comment)" \
      --bind "C:transform(git-trace --pin-key '$d' c {12})" \
      --bind "T:execute-silent(git-trace --retour '$d')" \
      --bind "w:execute-silent(git-trace --browse '$d')" \
      --bind "d:execute-silent(git-trace --download '$d')" \
      --bind "p:execute(git-trace --attach '$d')" \
      --bind "r:execute(git-trace --again '$d')+reload(git-trace --tour-list '$d')" \
      --watch "$d/tour.json" --panes "git-trace --tour-panes '$d'" \
      </dev/null >/dev/null
    exit 0 ;;
  --tests)
    d=$2 st=${GIT_FZF_STATE:-}
    # The tour opens while the tests still run: until they are done, a is their progress.
    [ -s "$d/cover.json" ] || exec git-claude-view "$d"
    otis-symbols "walk $(cat "$d/what") " 'enter=open it (a folded line: show or hide what is under it),c=comment on its line,t=write tests for this row,C=post them to the MR,i=Claude writes an input for a gap,b=run it at the base too and compare,r=run the tests again,q=back' \
      --ansi --delimiter='\t' --with-nth=1 --id-nth=12 \
      --bind "start:reload(git-trace --list '$d')" \
      --bind "enter:transform(git-trace --open '$d' {12})" \
      --bind "i:transform(git-trace --gap-key '$d' {12})" \
      --bind "t:transform(git-trace --pin-key '$d' t {12})+reload(git-trace --list '$d')" \
      --bind "c:transform(git-trace --open '$d' {12} comment)" \
      --bind "C:transform(git-trace --pin-key '$d' c {12})" \
      --bind "b:execute(git-trace --base '$d')+reload(git-trace --list '$d')" \
      --bind "r:execute(git-trace --again '$d')+reload(git-trace --list '$d')" \
      --preview "git-trace --show '$d' {12}" </dev/null >/dev/null
    exit 0 ;;
  # --open <dir> <row> [comment]: enter, or c, on a row of P's list.
  --open)
    v=${4:-open}
    case $v:$3 in
      comment:[dg]:*) ;;
      comment:*) note "c comments on a line: a change's, a function's no test runs, or one in a test's walk"; exit 0 ;;
    esac
    case $3 in
      t:*) echo "execute(git-trace --walk '$2' ${3#t:})" ;;
      open:*)
        # A folded line: what is under it shown, or hidden again.
        o=${GIT_FZF_STATE:-/tmp}/open k=${3#open:}
        if grep -qxF "$k" "$o" 2>/dev/null; then grep -vxF "$k" "$o" > "$o.new"; mv "$o.new" "$o"; else echo "$k" >> "$o"; fi
        echo "reload(git-trace --list '$2')" ;;
      d:*) f=$(jq -r --argjson g "${3#d:}" '.groups[$g] | (.from // .fns[0]) | "\(.path) \(.line)"' "$2/diff.json"); read -r p l <<EOF
$f
EOF
           echo "execute(git-walk --$v '$2' head '$p' $l)" ;;
      g:*) f=$(jq -r --argjson g "${3#g:}" '.gaps[$g] | "\(.path) \(.start)"' "$2/cover.json"); read -r p l <<EOF
$f
EOF
           echo "execute(git-walk --$v '$2' head '$p' $l)" ;;
    esac
    exit 0 ;;
  --gap-key)
    case $3 in
      g:*) if jq -e --argjson g "${3#g:}" '.gaps[$g].mocked' "$2/cover.json" >/dev/null; then note "that one is mocked out: no input can reach it"
           else echo "execute(git-trace --write '$2' ${3#g:})+reload(git-trace --list '$2')"; fi ;;
      *) note "i is for the changed code no test runs, at the top" ;;
    esac
    exit 0 ;;
  --write)
    d=$2
    git-confirm "Claude writes a test input that reaches $(jq -r --argjson g "$3" '.gaps[$g].name' "$d/cover.json"), in a spec in the slot, and P traces it (a minute or two)?" || exit 0
    phase "$d" write "$3"; exit 0 ;;
  --base) d=$2; phase "$d" base; exit 0 ;;
  --pin-key)
    # t and c on a change in behavior, from a's list (d:<i>) or the tour's
    # stop (tour:d<n>, the nth of those the tour shows): the change's id.
    d=$2 key=$3 row=$4
    case $row in
      g:*)
        # On changed code no test runs: t writes tests for it; C posts them.
        gi=${row#g:} gid=$(jq -r --argjson g "$gi" '.gaps[$g].id' "$d/cover.json" | shasum | cut -c1-10)
        if [ "$key" = t ]; then echo "execute(git-trace --cover '$d' $gi)"
        elif [ "$(jq .ok "$d/cover.$gid.json" 2>/dev/null)" = true ]; then echo "execute(git-trace --cover-post '$d' $gi)"
        else note "no tests for it yet: t writes them"; fi
        exit 0 ;;
      d:*) g=${row#d:} ;;
      tour:d[0-9]*) g=$(jq -r --argjson n "${row#tour:d}" '[.groups | to_entries[] | select((.value.verdict == null or .value.verdict.surprise > 0) and .value.kind != "count" and (.value.testsChanged | not)) | .key][$n - 1] // empty' "$d/diff.json") ;;
      *) note "$key is for a change in behavior: the list's first rows, or the tour's first stops"; exit 0 ;;
    esac
    [ -n "$g" ] || exit 0
    g=$(jq -r --argjson g "$g" '.groups[$g].id' "$d/diff.json")
    if [ "$key" = t ]; then echo "execute(git-trace --pin '$d' $g)"
    elif [ "$(jq .ok "$d/pin.$g.json" 2>/dev/null)" = true ]; then echo "execute(git-trace --pin-post '$d' $g)"
    else note "no test pins it yet: t writes one"; fi
    exit 0 ;;
  --pin) d=$2; phase "$d" pin "$3"; exit 0 ;;
  --cover) d=$2; phase "$d" cover "$3"; exit 0 ;;
  --cover-post)
    # c on a function t wrote tests for: them, as a comment, after a confirm.
    d=$2 gi=$3 iid=${2##*/}
    gid=$(jq -r --argjson g "$gi" '.gaps[$g].id' "$d/cover.json" | shasum | cut -c1-10) p=$d/cover.$gid
    case $iid in
      b-*)
        b=$(printf '%s' "${iid#b-}" | tr '%' '/')
        iid=$(git-forge api "projects/:fullpath/merge_requests?state=opened&source_branch=$(printf '%s' "$b" | sed 's|/|%2F|g')" 2>/dev/null | jq -r '.[0].iid // empty')
        [ -n "$iid" ] || { note "$b has no open MR to post them to"; exit 0; } ;;
    esac
    git-confirm "Comment on !$iid with the tests written for $(jq -r --argjson g "$gi" '.gaps[$g].name' "$d/cover.json")?" || exit 0
    jq -n --arg name "$(jq -r --argjson g "$gi" '.gaps[$g].name' "$d/cover.json")" --arg spec "$(jq -r .spec "$p.json")" --arg kind "$(jq -r '.kind // "unit"' "$p.json")" --arg why "$(jq -r '.why // ""' "$p.json")" --arg code "$(grep '^+' "$p.patch" | grep -v '^+++' | sed 's/^+//')" \
      '{body: "No test runs `\($name)`. These \($kind) tests, in `\($spec)`, pass on this branch. \($why)\n\n```ts\n\($code)\n```\n"}' > "$p.post"
    git-forge api -X POST "projects/:fullpath/merge_requests/$iid/notes" -H 'Content-Type: application/json' --input "$p.post" >/dev/null 2>"$p.err" ||
      { note "the comment was not posted: $(head -c 200 "$p.err")"; exit 0; }
    note "posted to !$iid"; exit 0 ;;
  --pin-post)
    # c: the test posted to the MR as a comment, after a confirm: the lines
    # it adds, and what it says on the branch.
    d=$2 p=$2/pin.$3 iid=${2##*/}
    case $iid in
      b-*)
        b=$(printf '%s' "${iid#b-}" | tr '%' '/')
        iid=$(git-forge api "projects/:fullpath/merge_requests?state=opened&source_branch=$(printf '%s' "$b" | sed 's|/|%2F|g')" 2>/dev/null | jq -r '.[0].iid // empty')
        [ -n "$iid" ] || { note "$b has no open MR to post it to"; exit 0; } ;;
    esac
    git-confirm "Comment on !$iid with the test that passes before this change and fails with it?" || exit 0
    jq -n --arg spec "$(jq -r .spec "$p.json")" --arg code "$(grep '^+' "$p.patch" | grep -v '^+++' | sed 's/^+//')" --arg fails "$(jq -r .fails "$p.json")" \
      --arg says "$(jq -r --arg g "$3" 'first(.groups[] | select(.id == $g)) | .says' "$d/diff.json")" \
      '{body: "Running this change'"'"'s tests before and after it: \($says)\n\nThis test, added to `\($spec)`, passes on the target branch and fails on this one:\n\n```ts\n\($code)\n```\n" + (if $fails != "" then "\nOn this branch:\n\n```\n\($fails)\n```\n" else "" end)}' > "$p.post"
    git-forge api -X POST "projects/:fullpath/merge_requests/$iid/notes" -H 'Content-Type: application/json' --input "$p.post" >/dev/null 2>"$p.err" ||
      { note "the comment was not posted: $(head -c 200 "$p.err")"; exit 0; }
    note "posted to !$iid"; exit 0 ;;
  --again) d=$2; phase "$d" run; exit 0 ;;
  --retour) d=$2; quiet_phase "$d" tour; exit 0 ;;
  --page)
    # The tour as one HTML page, <dir>/tour.html (walk.mjs tour-html), its MR's
    # title and link at the top when it has one, and the change by symbol
    # beside it (tab), as git-symbols's screen draws it. The theme's colors become
    # marker codes the page turns into its own, then page-css lays the
    # theme's colors over them, its code in its bat theme, in Ghostty's font
    # when there is one, carried in the page for readers without it. The theme is loaded afresh: a shell that loaded it
    # before themes had a ground has none.
    d=$2 key=${2##*/} title=${OTIS_PAGE_TITLE:-} url=${OTIS_PAGE_URL:-}
    eval "$(otis-theme --env)"
    font=$(ghostty +show-config 2>/dev/null | sed -n 's/^font-family = //p' | head -1)
    css=$($walk page-css "$font") bat=$OTIS_T_BAT
    [ -n "$title" ] || case $key in
      *[!0-9]*) title=$(printf '%s' "${key#b-}" | tr '%' '/') ;;
      *) mr=$(git-forge api "projects/:fullpath/merge_requests/$key" 2>/dev/null) && title=$(printf '%s' "$mr" | jq -r .title) url=$(printf '%s' "$mr" | jq -r .web_url) ;;
    esac
    OTIS_T_ATTENTION="38;5;201" OTIS_T_GOOD="38;5;202" OTIS_T_BAD="38;5;203" OTIS_T_YOURS="38;5;204" OTIS_T_TEXT="38;5;205" \
      OTIS_T_CONTEXT="38;5;206" OTIS_T_FAINT="38;5;207" OTIS_T_ELSEWHERE="38;5;208" OTIS_T_PLUS="#010203" OTIS_T_MINUS="#040506" OTIS_T_PLUS_EMPH="#070809" OTIS_T_MINUS_EMPH="#0a0b0c" OTIS_T_PLUS_WORD="#070809" OTIS_T_MINUS_WORD="#0a0b0c" OTIS_T_BAT=$bat \
      $walk tour-html "$d" "$title" "$url" "$css" > "$d/tour.html.$$" 2>>"$d/log" && mv "$d/tour.html.$$" "$d/tour.html"
    s=$?; rm -f "$d/tour.html.$$"; exit $s ;;
  --download|--browse)
    # d: the page, as p would post it, in ~/Downloads; w: opened in the
    # browser. Written in the background, since its previews by symbol take
    # seconds on a big change (a half minute on the biggest): the screen
    # stays yours, and an alert says when it is there.
    d=$2 name=${2##*/} how=$1
    name=walkthrough-$(printf '%s' "${name#b-}" | tr '%/' '--').html
    if [ "$how" = --download ]; then note "writing ~/Downloads/${name}…"; else note "writing the page…"; fi
    (
      if ! git-trace --page "$d"; then note "could not write the page"; otis-notify --sound Basso "✗ The walkthrough" "could not write the page"; exit 0; fi
      if [ "$how" = --browse ]; then otis-open "$d/tour.html"; exit 0; fi
      cp "$d/tour.html" "$HOME/Downloads/$name" || { note "could not write ~/Downloads/$name"; exit 0; }
      note "saved ~/Downloads/$name"; otis-notify "Saved the walkthrough" "~/Downloads/$name"
    ) </dev/null >/dev/null 2>&1 &
    exit 0 ;;
  --attach)
    # p: the page posted to the MR, after a confirm, as a verification's
    # report is: uploaded to the project (GitLab offers HTML as a download,
    # which opens in the browser), then linked at the end of the description
    # of an MR of yours, in place of the one a last post left there, or in a
    # comment on someone else's, whose description is theirs. A branch's
    # tour links from the MR the branch has since opened.
    d=$2 iid=${2##*/}
    case $iid in
      b-*)
        b=$(printf '%s' "${iid#b-}" | tr '%' '/')
        iid=$(git-forge api "projects/:fullpath/merge_requests?state=opened&source_branch=$(printf '%s' "$b" | sed 's|/|%2F|g')" 2>/dev/null | jq -r '.[0].iid // empty')
        [ -n "$iid" ] || { note "$b has no open MR to post it to; gb's n opens one"; exit 0; } ;;
    esac
    [ -s "$d/tour.json" ] || { note "no tour yet"; exit 0; }
    git-forge can upload || { note "GitHub takes no uploads to link a page from; w opens it to share"; exit 0; }
    mr=$(git-forge api "projects/:fullpath/merge_requests/$iid") || { note "could not read !$iid from GitLab"; exit 0; }
    me=$(git-forge api user 2>/dev/null | jq -r .username)
    mine=; [ "$(printf '%s' "$mr" | jq -r .author.username)" = "$me" ] && mine=1
    ask="Upload the walkthrough to !$iid and $([ -n "$mine" ] && echo "link it at the end of its description" || echo "link it in a comment")?"
    [ "$(printf '%s' "$mr" | jq -r .diff_refs.head_sha)" = "$(cut -d' ' -f2 "$d/shas")" ] ||
      ask="!$iid has moved on since this tour was written. $ask"
    git-confirm "$ask" || exit 0
    git-trace --page "$d" || { note "could not write the page"; exit 0; }
    tmp=$(mktemp -d) && cp "$d/tour.html" "$tmp/walkthrough-$iid.html" || exit 1
    up=$(git-forge api "projects/:fullpath/uploads" --form "file=@$tmp/walkthrough-$iid.html" 2>&1)
    rm -rf "$tmp"
    link=$(printf '%s' "$up" | jq -r '.url // empty' 2>/dev/null)
    [ -n "$link" ] || { note "the upload failed: $(printf '%s' "$up" | head -c 200)"; exit 0; }
    if [ -n "$mine" ]; then
      printf '%s' "$mr" | jq --arg url "$link" '{description: ((.description // "")
        | sub("\\s*\\[walkthrough\\]\\(/uploads/[^)]*\\)\\s*$"; "")
        | if . == "" then "" else . + "\n\n" end + "[walkthrough](\($url))")}' > "$d/attach.json"
      git-forge api -X PUT "projects/:fullpath/merge_requests/$iid" -H 'Content-Type: application/json' --input "$d/attach.json" >/dev/null 2>"$d/attach.err" ||
        { note "uploaded, but the description was not changed: $(head -c 200 "$d/attach.err")"; exit 0; }
    else
      jq -n --arg url "$link" '{body: "A walkthrough of this change, stop by stop, with the values its tests really had: [walkthrough](\($url))"}' > "$d/attach.json"
      git-forge api -X POST "projects/:fullpath/merge_requests/$iid/notes" -H 'Content-Type: application/json' --input "$d/attach.json" >/dev/null 2>"$d/attach.err" ||
        { note "uploaded, but the comment was not posted: $(head -c 200 "$d/attach.err")"; exit 0; }
    fi
    rm -f "$d/attach.json" "$d/attach.err"
    note "posted to !$iid"; exit 0 ;;
  --walk)
    d=$2 ti=$3 at=${4:-}
    name=$(jq -r --argjson t "$ti" '.tests[$t].name' "$d/cover.json")
    # The name as a title, cut to fit: a long one ran into the preview.
    [ ${#name} -gt 56 ] && name="$(printf '%s' "$name" | cut -c1-55)…"
    # j, l, h and k step through it on the screen itself (--steps).
    otis-symbols "$name " 'j=next line,l=step into,h=step out,k=back,b=before the change,enter=open the line,c=comment on it,q=back' \
      --ansi --delimiter='\t' --with-nth=1 --id-nth=12 --steps "git-trace --steps-base '$d' $ti" \
      --bind "start:reload${at:+-sync}(git-trace --walk-list '$d' $ti)${at:++transform(git-trace --walk-at '$d' $ti $at)}" \
      --bind "b:execute-silent(git-trace --side '$d' $ti)+reload(git-trace --walk-list '$d' $ti)+first" \
      --bind "enter:execute(git-walk --open '$d' \$(git-trace --side-now) \$(git-trace --walk-line '$d' $ti {12}))" \
      --bind "c:execute(git-walk --comment '$d' \$(git-trace --side-now) \$(git-trace --walk-line '$d' $ti {12}))" \
      </dev/null >/dev/null
    exit 0 ;;
  --steps-base)
    prepared "$2" "$3" "$(side)"
    printf '%s\n' "$b"
    exit 0 ;;
  --walk-at)
    # From a tour's stop: its step, and the row of its call.
    prepared "$2" "$3" head
    echo "$4" > "$GIT_FZF_STATE/cur"
    vi=$(awk -v k="$4" '$1 == k { print $2; exit }' "$b.nav")
    [ -n "$vi" ] && echo "pos($((vi + 1)))+refresh-preview"
    exit 0 ;;
  --side-now) side; exit 0 ;;
  --side)
    d=$2 st=$GIT_FZF_STATE
    if [ "$(cat "$st/side" 2>/dev/null)" = base ]; then echo head > "$st/side"; : > "$st/hist"; rm -f "$st/cur"
    elif [ "$(jq -r '.based' "$d/cover.json")" = true ]; then echo base > "$st/side"; : > "$st/hist"; rm -f "$st/cur"
    else note "no run at the base yet: b on P's screen runs the tests there"; fi
    exit 0 ;;
esac
echo "git-trace: see its head for what it takes" >&2
exit 2
