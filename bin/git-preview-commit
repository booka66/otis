#!/bin/sh
# Preview one commit through delta (git-delta): message, stat and patch. Paths
# after the sha narrow it to just those files' diff, with no message or stat,
# for the file picker in git-commit-open. The sha may also be a range
# (base..head, or main...branch): with paths that file's diff, without them the
# whole range's patch. One path the sha added or deleted shows as the file
# itself, as the sha has it or as it was before (bat, headed added or deleted,
# two header lines then one row a line, unwrapped, which git-commit-open
# counts on to open it where the preview is scrolled), unless --diff (git-mr-file-preview, which prints comment threads under
# delta's line numbers). --tests-toggle (gl, gb) leaves test files
# out of the stat and patch while git-test-files has them hidden, with a note saying
# how many. --as added|deleted|changed says what the sha did to the one path
# given, for a caller whose rows already know (git-commit-open), so the preview
# does not ask git on every cursor move; empty means changed.
#
# A merge commit shows what it brought in, its diff against its first parent:
# git show's default for a merge is only the lines both sides touched, which is
# usually nothing, and on origin/main nearly every commit is a GitLab merge.
# Paths as they are, not quoted: git writes a name with é in it as
# "\303\251" otherwise, and the pane showed that.
git() { command git -c core.quotePath=false "$@"; }
share=$(cd "$(dirname "$0")/../share" && pwd)
. "$share/delta.sh"
filter=0 diff=0 as=
while :; do
  case $1 in
    --tests-toggle) filter=1; shift ;;
    --diff) diff=1; shift ;;
    --as) as=${2:-changed}; shift 2 ;;
    *) break ;;
  esac
done
sha=$1
[ -n "$sha" ] || exit 0
shift
# before: where a deleted file still is, a commit's first parent or a range's
# base (its merge base with three dots); git-commit-open's, the same.
before() {
  case $sha in
    *...*) git merge-base "${sha%%...*}" "${sha##*...}" ;;
    *..*)  printf '%s\n' "${sha%%..*}" ;;
    *)     printf '%s^\n' "$sha" ;;
  esac
}
after() { printf '%s\n' "${sha##*..}"; }
# status <path>: A, D, M... as the sha changed it.
status() {
  case $sha in
    *..*) git diff --name-status --no-renames "$sha" -- "$1" ;;
    *)    git show --format= --name-status --no-renames --diff-merges=first-parent "$sha" -- "$1" ;;
  esac | cut -c1
}
plain() {
  . "$share/palette.sh"
  printf "$1%s${GK_R}\n\n" "$2"
  git show "$3" 2>/dev/null |
    BAT_THEME=${OTIS_T_BAT:-ansi} bat --color=always --style=numbers --line-range=:400 --wrap=never --file-name "$4" 2>/dev/null
}
# summary [-- <pathspec>...]: one commit as the preview leads with it: its
# subject, who and when and whether it is pushed, the start of its message,
# then its shape: what it did to how many files, a bar of what it added
# against what it removed, its files by what happened to them (new, gone,
# grew, shrunk, the rest touched) and the biggest of them as bars; then a
# heading over the patch. Drawn in one awk from git show's numstat and
# summary (share/pane.sh's vocabulary, in awk).
summary() {
  . "$share/palette.sh"
  . "$share/pane.sh"
  pushed=
  up=$(git rev-parse -q --verify '@{upstream}' 2>/dev/null) || up=${OTIS_C_base:-origin/main}
  git merge-base --is-ancestor "$sha" "$up" 2>/dev/null && pushed=1
  git show -s --format='%h%x1f%an%x1f%ar%x1f%s%x1f%b%x1f%P' "$sha" > "${TMPDIR:-/tmp}/otis-commit.$$" 2>/dev/null
  git show --format= --numstat --summary --no-renames --diff-merges=first-parent "$sha" "$@" 2>/dev/null |
    LC_ALL=C awk -v w="$PANE_W" -v pushed="$pushed" -v hidden="$hidden" -v meta="${TMPDIR:-/tmp}/otis-commit.$$" \
      -v T="$(printf "$GK_TEXT")" -v C="$(printf "$GK_CONTEXT")" -v F="$(printf "$GK_FAINT")" -v G="$(printf "$GK_GOOD")" \
      -v X="$(printf "$GK_BAD")" -v Y="$(printf "$GK_YOURS")" -v A="$(printf "$GK_ATTENTION")" -v E="$(printf "$GK_ELSEWHERE")" \
      -v R="$(printf "$GK_R")" '
    # Characters, not bytes, for a width (LC_ALL=C counts bytes).
    function len(s) { gsub(/[\200-\277]/, "", s); return length(s) }
    function fit(s, n,   out, i, c) {
      if (len(s) <= n) return s
      out = ""; for (i = 1; len(out) < n - 1 && i <= length(s); i++) { c = substr(s, i, 1); out = out c
        while (i < length(s) && substr(s, i + 1, 1) ~ /[\200-\277]/) { i++; out = out substr(s, i, 1) } }
      return out "\342\200\246"
    }
    function num(n,   s) { s = n ""; if (n >= 1000) s = substr(s, 1, length(s) - 3) " " substr(s, length(s) - 2); return s }
    function rep(c, n,   o) { o = ""; while (n-- > 0) o = o c; return o }
    function base(p) { sub(/.*\//, "", p); return p }
    BEGIN {
      RS = "\037"; getline h < meta; getline an < meta; getline ago < meta; getline subj < meta; getline body < meta; getline parents < meta
      RS = "\n"; close(meta); system("rm -f \"" meta "\"")
      sub(/\n+$/, "", body)
    }
    $1 ~ /^[0-9-]+$/ && NF >= 3 { p = $3; for (i = 4; i <= NF; i++) p = p " " $i
      bin = ($1 == "-"); a = bin ? 0 : $1 + 0; d = bin ? 0 : $2 + 0
      n++; path[n] = p; isbin[n] = bin; add[n] = a; del[n] = d; ta += a; td += d; at[p] = n; next }
    $1 == "create" && $2 == "mode" { p = $4; for (i = 5; i <= NF; i++) p = p " " $i; made[p] = 1; next }
    $1 == "delete" && $2 == "mode" { p = $4; for (i = 5; i <= NF; i++) p = p " " $i; gone[p] = 1; next }
    END {
      print T "\033[1m" fit(subj, w) R
      # Who goes first when the pane is narrow, then when.
      dot = "  \302\267  "; mg = (split(parents, ps, " ") > 1) ? dot "merge" : ""; np_ = pushed ? "" : dot "not pushed"
      if (len(h dot an dot ago mg np_) > w) an = ""
      if (len(h (an != "" ? dot an : "") dot ago mg np_) > w) ago = ""
      m = E h R C (an != "" ? dot an : "") (ago != "" ? dot ago : "") mg R (pushed ? "" : C dot R Y "not pushed")
      print m R
      # The start of the message: its first paragraph, three lines at most.
      np = split(body, paras, /\n[ \t]*\n/)
      if (np > 0 && paras[1] != "") {
        print ""
        nl = split(paras[1], ls, "\n"); shown = 0
        for (i = 1; i <= nl && shown < 3; i++) { if (ls[i] == "") continue; print C fit(ls[i], w) R; shown++ }
        if (np > 1) print F "+" (np - 1) " paragraph" (np > 2 ? "s" : "") R
        else if (nl > 3) print F "+" (nl - 3) " lines" R
      }
      if (!n) { print ""; print C "SHAPE" R "  " C "no changes" (hidden != "" ? "  \302\267  " hidden : "") R; print ""; exit }
      print ""
      print C "SHAPE" R "  " C n " file" (n > 1 ? "s" : "") "  " R G "+" num(ta) R X " \342\210\222" num(td) R (hidden != "" ? F "  " hidden R : "")
      print ""
      bw = w - 4; ga = (ta + td) ? int(ta * bw / (ta + td) + 0.5) : 0
      print "  " G rep("\342\224\201", ga) R X rep("\342\224\201", bw - ga) R
      print ""
      # Each file by what happened to it.
      for (i = 1; i <= n; i++) {
        p = path[i]; t = add[i] + del[i]
        k = (p in made) ? "new" : (p in gone) ? "gone" : (add[i] >= 2 * del[i] && t >= 20) ? "grew" : (del[i] >= 2 * add[i] && t >= 20) ? "shrunk" : "touched"
        kind[i] = k; cnt[k]++
      }
      # Biggest first, within each kind and in BIGGEST.
      # The 40 biggest in order, the rest after them as they came: a merge
      # of thousands of files is not sorted whole on every move.
      K = 0
      for (i = 1; i <= n; i++) {
        t = add[i] + del[i]
        if (K == 40 && t <= add[topk[K]] + del[topk[K]]) continue
        if (K < 40) K++
        for (j = K; j > 1 && add[topk[j - 1]] + del[topk[j - 1]] < t; j--) topk[j] = topk[j - 1]
        topk[j] = i
      }
      m_ = 0; for (j = 1; j <= K; j++) { idx[++m_] = topk[j]; intop[topk[j]] = 1 }
      for (i = 1; i <= n; i++) if (!(i in intop)) idx[++m_] = i
      split("new gone grew shrunk touched", order, " ")
      col["new"] = G; col["gone"] = X; col["grew"] = G; col["shrunk"] = Y; col["touched"] = C
      # What happened to them, counted: BIGGEST names them, one a line.
      glyph["new"] = "+"; glyph["gone"] = "\342\210\222"; glyph["grew"] = "\342\226\262"; glyph["shrunk"] = "\342\226\274"; glyph["touched"] = "\302\267"
      line = "  "; used = 2
      for (o = 1; o <= 5; o++) {
        k = order[o]; if (!cnt[k]) continue
        piece = cnt[k] " " k
        if (used + len(piece) + 3 > w) break
        line = line (used > 2 ? F " \302\267 " R : "") col[k] piece R; used += len(piece) + (used > 2 ? 3 : 0)
      }
      print line
      # The biggest, as bars against the biggest of them.
      if (n > 1) {
        top = n < 5 ? n : 5; big = add[idx[1]] + del[idx[1]]
        nw = 0; for (i = 1; i <= top; i++) if (len(path[idx[i]]) > nw) nw = len(path[idx[i]])
        if (nw > int(w * 0.4)) nw = int(w * 0.4)
        bw = w - nw - 18; if (bw < 6) bw = 6
        print ""; print C "BIGGEST" R; print ""
        for (i = 1; i <= top; i++) {
          k = idx[i]; t = add[k] + del[k]; p = path[k]
          # Its last characters, whole ones: a cut by bytes split an é.
          if (len(p) > nw) { q_ = 0; for (j = length(p); j > 0; j--) if (substr(p, j, 1) !~ /[\200-\277]/ && ++q_ >= nw - 1) break; p = "\342\200\246" substr(p, j) }
          ln = int(t * bw / (big ? big : 1) + 0.5); if (t && !ln) ln = 1
          g = t ? int(add[k] * ln / t + 0.5) : 0
          nums = (add[k] ? G "+" num(add[k]) R : "") (add[k] && del[k] ? " " : "") (del[k] ? X "\342\210\222" num(del[k]) R : "")
          if (isbin[k]) nums = C "binary" R
          # Padded by characters, not bytes, so a name with an é lines up.
          printf "  %s%s%s %s%s%s%s  %s%s%s%s%s  %s\n", col[kind[k]], glyph[kind[k]], R, T, p, R, rep(" ", nw - len(p)), G, rep("\342\224\201", g), X, rep("\342\224\201", ln - g), rep(" ", bw - ln), nums
        }
      }
      print ""
      print C "THE DIFF" R F "  ctrl-d scrolls into it" R
      print ""
    }'
}
if [ $# -eq 1 ] && [ $diff -eq 0 ]; then
  case $as in added) as=A ;; deleted) as=D ;; changed) as=M ;; '') as=$(status "$1") ;; esac
  case $as in
    D) plain "$GK_BAD" deleted "$(before):$1" "$1"; exit 0 ;;
    A) plain "$GK_GOOD" added "$(after):$1" "$1"; exit 0 ;;
  esac
fi
if [ $# -gt 0 ]; then
  case $sha in
    *..*) git diff "$sha" -- "$@" ;;
    *)    git show --format= --patch --diff-merges=first-parent "$sha" -- "$@" ;;
  esac
else
  case $sha in
    *..*) changes() { git diff --patch "$@"; } ; names() { git diff --name-only "$sha"; } ;;
    # One commit: what it is and its shape drawn first (summary), then the
    # patch alone, under a heading of its own.
    *)    changes() { git show --format= --patch --diff-merges=first-parent "$@"; } ; names() { git show --format= --name-only --diff-merges=first-parent "$sha"; } ;;
  esac
  # The flag git-test-files keeps (its hidden and toggle), tested rather than
  # asked: this runs on every cursor move, and asking is a shell of its own.
  hidden=
  if [ $filter -eq 1 ] && [ -e "${XDG_CACHE_HOME:-$HOME/.cache}/git-alias/hide-tests" ]; then
    n=$(names | git-test-files count)
    [ "$n" -eq 1 ] && hidden='1 test file hidden · t shows it'
    [ "$n" -gt 1 ] && hidden="$n test files hidden · t shows them"
    # The excludes are globs; keep the shell from expanding them.
    set -f
    set -- -- :/ $(git-test-files excludes)
    set +f
  fi
  case $sha in
    *..*) [ -n "$hidden" ] && printf '%s\n\n' "$hidden" ;;
    *) summary "$@" ;;
  esac
  set -f
  changes "$sha" "$@"
fi 2>/dev/null |
  gk_delta
