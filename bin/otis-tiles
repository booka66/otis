#!/usr/bin/env python3
# otis-tiles <command...>: the command on a terminal of its own, with every
# picture too big for herdr cut into strips on its way to this one.
# otis-tiles --cut <rows> <pixel height>: what stdin would become in a pane
# that size, for otis-test.
#
# herdr (0.9.2 on) draws a picture a program writes to its pane, by kitty's
# graphics protocol, but only one of up to about 22 MB: a bigger one is
# dropped and nothing says so. terminal-browser sends the whole pane as one
# picture, four bytes a pixel, so in a pane of more pixels than that (any
# wide one on a laptop screen) the page stayed blank. The picture is a file
# the terminal reads, and the protocol lets a command name a part of the file
# (S, its size, and O, where it starts): so one command for the whole becomes
# one for each strip of rows, each strip small enough (16 MB) that herdr
# hands it to Ghostty as a file as well, the fast way. Everything else the
# command writes, and everything typed, goes through untouched.
import fcntl, os, select, signal, struct, sys, termios, tty

LIMIT = 16 * 1024 * 1024
START, END = b'\x1b_G', b'\x1b\\'


def strip_id(image, k):
    # Ids of their own, high where no program's are, 256 strips to an image.
    return 0x70000000 + (image & 0xFFFFF) * 256 + k


class Tiles:
    def __init__(self, size):
        self.size = size    # () -> (rows, pixel height) of the pane
        self.carry = b''
        self.strips = {}    # image id -> how many strips it was last drawn as

    def feed(self, data):
        data = self.carry + data
        self.carry = b''
        out, i = [], 0
        while True:
            j = data.find(START, i)
            if j < 0:
                # A start cut off at the end waits for the rest of it.
                keep = next((k for k in (2, 1) if data.endswith(START[:k])), 0)
                out.append(data[i:len(data) - keep])
                self.carry = data[len(data) - keep:]
                break
            out.append(data[i:j])
            e = data.find(END, j, j + 2048)
            if e >= 0:
                out.append(self.command(data[j:e + 2]))
                i = e + 2
            elif len(data) - j < 2048:
                self.carry = data[j:]
                break
            else:
                # Longer than a command that names a file: pixels sent inline.
                out.append(START)
                i = j + 3
        return b''.join(out)

    def command(self, cmd):
        control, _, payload = cmd[3:-2].partition(b';')
        pairs = [kv.split(b'=', 1) for kv in control.split(b',') if b'=' in kv]
        keys = dict(pairs)
        # A whole picture, raw, from a file, put where the cursor is and the
        # cursor left there: what terminal-browser sends each frame.
        if not (keys.get(b'a') == b'T' and keys.get(b't') == b'f' and keys.get(b'f') == b'32'
                and keys.get(b'C') == b'1' and b's' in keys and b'v' in keys
                and not set(keys) & set(b'SOmcrxywhXY'[n:n + 1] for n in range(11))):
            return cmd
        image, w, h = int(keys.get(b'i', 0)), int(keys[b's']), int(keys[b'v'])
        rows, height = self.size()
        cell = height // rows if rows else 0
        before = self.strips.get(image)
        gone = lambda ids: b''.join(START + b'a=d,d=I,i=%d,q=2' % n + END for n in ids)
        if w * h * 4 <= LIMIT or not cell:
            # Small enough whole; the strips of a bigger frame before it go.
            self.strips[image] = 0
            return gone(strip_id(image, k) for k in range(before or 0)) + cmd
        per, total = max(1, LIMIT // (w * 4 * cell)), -(-h // cell)
        out, row, k, moved = [], 0, 0, 0
        # The whole one of a smaller frame before it goes.
        if before == 0:
            out.append(gone([image]))
        while row < total:
            n = min(per, total - row)
            px = min(n * cell, h - row * cell)
            new = {b'v': b'%d' % px, b'i': b'%d' % strip_id(image, k)}
            part = [(key, new.get(key, value)) for key, value in pairs if key != b'i']
            part += [(b'i', new[b'i']), (b'S', b'%d' % (px * w * 4)), (b'O', b'%d' % (row * cell * w * 4))]
            out.append(START + b','.join(key + b'=' + value for key, value in part) + b';' + payload + END)
            row, k = row + n, k + 1
            if row < total:
                # The next strip starts on the row under this one.
                out.append(b'\x1b[%dB' % n)
                moved += n
        if moved:
            out.append(b'\x1b[%dA' % moved)
        out.append(gone(strip_id(image, x) for x in range(k, before or 0)))
        self.strips[image] = k
        return b''.join(out)


def write(fd, data):
    while data:
        data = data[os.write(fd, data):]


if len(sys.argv) > 1 and sys.argv[1] == '--cut':
    rows, height = int(sys.argv[2]), int(sys.argv[3])
    write(1, Tiles(lambda: (rows, height)).feed(sys.stdin.buffer.read()))
    sys.exit(0)

argv = sys.argv[1:]
try:
    saved = termios.tcgetattr(0)
except termios.error:
    # No terminal to stand in front of.
    os.execvp(argv[0], argv)

winsize = lambda: fcntl.ioctl(0, termios.TIOCGWINSZ, b'\0' * 8)
# The size the command sees, pixels as well, set before it starts so the
# first thing it draws is the right size.
master, slave = os.openpty()
fcntl.ioctl(slave, termios.TIOCSWINSZ, winsize())
pid = os.fork()
if pid == 0:
    os.setsid()
    fcntl.ioctl(slave, termios.TIOCSCTTY, 0)
    for fd in (0, 1, 2):
        os.dup2(slave, fd)
    os.close(master)
    os.close(slave)
    try:
        os.execvp(argv[0], argv)
    except OSError as e:
        os.write(2, ('otis-tiles: %s: %s\r\n' % (argv[0], e.strerror)).encode())
        os._exit(127)
os.close(slave)

# A signal wakes the wait below: the command gone, or the pane a new size.
woke, wake = os.pipe()
os.set_blocking(wake, False)
signal.set_wakeup_fd(wake)
signal.signal(signal.SIGCHLD, lambda *_: None)
signal.signal(signal.SIGWINCH, lambda *_: fcntl.ioctl(master, termios.TIOCSWINSZ, winsize()))


def stop(*_):
    raise SystemExit(1)


signal.signal(signal.SIGTERM, stop)
signal.signal(signal.SIGHUP, stop)

tiles = Tiles(lambda: struct.unpack('HHHH', winsize())[0::3])
status = None
tty.setraw(0)
try:
    while status is None:
        ready, _, _ = select.select([0, master, woke], [], [])
        if 0 in ready:
            typed = os.read(0, 65536)
            if not typed:
                stop()
            write(master, typed)
        if master in ready:
            try:
                write(1, tiles.feed(os.read(master, 65536)))
            except OSError:
                pass
        if woke in ready:
            os.read(woke, 4096)
            done, st = os.waitpid(pid, os.WNOHANG)
            if done:
                status = os.WEXITSTATUS(st) if os.WIFEXITED(st) else 128 + os.WTERMSIG(st)
    # What it wrote last, as it left: terminal-browser's daemon keeps the
    # terminal open, so there is no end of file to wait for.
    while select.select([master], [], [], 0.05)[0]:
        try:
            data = os.read(master, 65536)
        except OSError:
            break
        if not data:
            break
        write(1, tiles.feed(data))
finally:
    termios.tcsetattr(0, termios.TCSANOW, saved)
sys.exit(status)
