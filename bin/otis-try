#!/bin/sh
# otis-try: set otis up the way a new engineer would, on a Mac that has never
# seen it: a fresh macOS virtual machine (Tart, on Apple silicon), with no
# Homebrew, no git config, no glab login and no dotfiles. This checkout is
# copied into it as it stands, so what is tried is what is here, uncommitted
# changes included, and otis-setup opens in its Terminal on its own. Closing
# the VM's window deletes it; --keep leaves it for next time (tart run <name>).
#
# otis-try --clean takes away everything it ever left: VMs kept or orphaned
# by a kill, the cached macOS image, and Tart itself where otis-try fetched it.
# In braces, so sh reads all of it before running any: it runs for as long
# as the VM does, and a script changed under a running sh is read from the
# middle.
{
root=$(cd "$(dirname "$0")/.." && pwd)
image=ghcr.io/cirruslabs/macos-tahoe-vanilla:latest
keep= clean=
case $1 in
  --keep) keep=1 ;;
  --clean) clean=1 ;;
esac

[ "$(uname)" = Darwin ] && [ "$(uname -m)" = arm64 ] || { echo "otis-try: needs a Mac with Apple silicon" >&2; exit 1; }
# Tart from its own release, signed by Cirrus Labs, kept here and nowhere
# else: its brew formula is refused by current Homebrew, and otis-try is the
# only thing that uses it. One on PATH is used instead where there is one.
tart_app=${XDG_DATA_HOME:-$HOME/.local/share}/otis-try/tart.app
if command -v tart >/dev/null 2>&1; then
  tart() { command tart "$@"; }
elif [ -x "$tart_app/Contents/MacOS/tart" ]; then
  tart() { "$tart_app/Contents/MacOS/tart" "$@"; }
elif [ -n "$clean" ]; then
  tart() { :; }
else
  printf 'otis-try runs a fresh Mac in Tart (tart.run), which is not here. Download it into %s? [y/N] ' "${tart_app%/*}"
  read -r a
  [ "$a" = y ] || [ "$a" = Y ] || exit 1
  mkdir -p "${tart_app%/*}" &&
    curl -fL --progress-bar https://github.com/cirruslabs/tart/releases/latest/download/tart.tar.gz |
    tar -xz -C "${tart_app%/*}" || exit 1
  [ -x "$tart_app/Contents/MacOS/tart" ] || { echo "otis-try: the download has no tart.app in it" >&2; exit 1; }
  tart() { "$tart_app/Contents/MacOS/tart" "$@"; }
fi

if [ -n "$clean" ]; then
  for vm in $(tart list --source local --quiet 2>/dev/null | grep '^otis-try-'); do
    tart stop "$vm" >/dev/null 2>&1
    tart delete "$vm" && echo "deleted the VM $vm"
  done
  for img in $(tart list --source oci --quiet 2>/dev/null | grep -F "${image%:*}"); do
    tart delete "$img" && echo "deleted the cached image $img"
  done
  if [ -d "${tart_app%/*}" ]; then
    rm -rf "${tart_app%/*}" && echo "deleted Tart from ${tart_app%/*}"
  fi
  [ -d "$(brew --repository 2>/dev/null)/Library/Taps/cirruslabs/homebrew-cli" ] &&
    echo "left: the cirruslabs/cli brew tap (brew untap cirruslabs/cli)"
  echo "left: any glab token a VM logged in with, on GitLab under Preferences, Access tokens"
  exit 0
fi

# The first run downloads the image, tens of GB, cached in ~/.tart after.
# Each VM is a copy-on-write clone of it, so later runs take little.
if ! tart list --source oci 2>/dev/null | grep -qF "${image%:*}"; then
  free=$(df -g "$HOME" | awk 'NR == 2 { print $4 }')
  if [ "$free" -lt 60 ]; then
    echo "otis-try: the first run downloads a macOS image of tens of GB, and $HOME has ${free}GB free; make room for about 60" >&2
    exit 1
  fi
  echo "first run: downloading a fresh macOS, which takes a while"
fi

name=otis-try-$(date +%Y%m%d-%H%M%S)
tart clone "$image" "$name" || exit 1
if [ -z "$keep" ]; then
  trap 'tart stop "$name" >/dev/null 2>&1; tart delete "$name" && echo "deleted $name"' EXIT
  trap 'exit 1' INT TERM
fi

cat <<EOF

A fresh Mac is starting in its own window, logged in as admin (password:
admin, which Homebrew's installer asks for). Once it is up, otis is copied in
and its Terminal opens on otis-setup by itself.

Everything in the VM is its own: installs, logins, git config. A glab login
in there makes a real token on GitLab, which outlives the VM.

$([ -n "$keep" ] && echo "Kept after you close it: tart run $name, and tart delete $name when done." || echo "Close the VM's window when you are done, and it is deleted.")

EOF
tart run --dir="otis:$root:ro" "$name" &
vm=$!

# Into the VM over ssh as admin, the vanilla image having no agent for tart
# exec. The password comes from an askpass that says it, so nothing is typed.
ask=$(mktemp -d)/askpass
printf '#!/bin/sh\necho admin\n' > "$ask" && chmod +x "$ask"
invm() {
  SSH_ASKPASS=$ask SSH_ASKPASS_REQUIRE=force ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
    -o LogLevel=ERROR -o ConnectTimeout=5 "admin@$ip" "$@" </dev/null
}
by_hand='in its Terminal: cp -RX "/Volumes/My Shared Files/otis" ~/otis; ~/otis/bin/otis-setup'
if ip=$(tart ip --wait 180 "$name" 2>/dev/null); then
  tries=0
  until invm true 2>/dev/null || [ $tries -ge 60 ]; do sleep 2; tries=$((tries + 1)); done
  # A copy of the checkout as a clone would be, then Terminal on otis-setup
  # in the VM's own window (open, as a .command, runs it there). cp -X, since
  # the share cannot carry extended attributes onto the command links.
  invm 'until [ -d "/Volumes/My Shared Files/otis" ]; do sleep 1; done
    rm -rf ~/otis; cp -RX "/Volumes/My Shared Files/otis" ~/otis 2>/dev/null
    printf "#!/bin/sh\ncd ~ && ~/otis/bin/otis-setup\n" > ~/otis-setup.command && chmod +x ~/otis-setup.command
    open ~/otis-setup.command' || echo "otis-try: could not get into the VM; $by_hand" >&2
else
  echo "otis-try: the VM has no address; $by_hand" >&2
fi
rm -rf "${ask%/*}"
wait $vm
exit
}
