#!/bin/sh
# git-split [--wait] <rev> [<check>] [<branch>]
#                             split this branch into a stack, and keep the branch
#
#   git-split main...                     split, checking with .seam/check
#   git-split main... git-seam-check      split, checking with that
#   git-split main... ""                  split, checking nothing
#
# With no check named, the repo's is used: a command a line in .seam/check,
# with .seam/check.local before it and this user's after, the way seam reads
# its own files. That is what lets the
# key in the picker mean the same thing in a repo that has a typechecker and
# one that has nothing to say.
#
# --wait holds the screen at the end, for a caller that is about to take the
# terminal back (fzf does, the moment the command returns).
#
# seam --split --branch writes the slices as commits on a new branch from the
# base. Nothing is checked out and the worktree is not touched, so the branch
# you are on is exactly where you left it: going back is standing still, and
# throwing the split away is deleting one ref.
#
# The check runs on every commit as it is made and the branch is written only
# if all of them pass, which takes long enough that a bare cursor is the wrong
# thing to look at. The plan is drawn first — it costs a jq pass — and each
# slice lights up as its commit lands.
share=$(cd "$(dirname "$0")/../share" && pwd)
. "$share/palette.sh"
wait=; [ "$1" = --wait ] && { wait=1; shift; }
rev=$1 check=$2
if [ $# -lt 2 ]; then
  # check.local before check, this repo before this user, the way seam reads
  # its own: a repo that comes to ship one should not take over yours, and a
  # .local is the one of these git is not meant to see.
  for d in ./.seam/check.local ./.seam/check \
           "${XDG_CONFIG_HOME:-$HOME/.config}/seam/check.local" "${XDG_CONFIG_HOME:-$HOME/.config}/seam/check"; do
    [ -f "$d" ] || continue
    check=$(sed 's/#.*//' "$d" | grep -v '^[[:space:]]*$' | head -1)
    break
  done
fi
[ -n "$rev" ] || { echo "git-split <rev> [<check command>]" >&2; exit 2; }
command -v seam >/dev/null 2>&1 || { echo "git-split: seam is not on your PATH" >&2; exit 2; }
here=$(git rev-parse --abbrev-ref HEAD 2>/dev/null) || exit 2
[ "$here" != HEAD ] || { echo "git-split: you are not on a branch" >&2; exit 2; }
branch=$4
[ -n "$branch" ] || branch=$here-split
git show-ref --verify -q "refs/heads/$branch" && { printf 'git-split: %s is already a branch. Delete it or name another.\n' "$branch" >&2; exit 2; }

tmp=$(mktemp -d) || exit 2
# Stopping has to leave nothing behind. seam writes the ref only after the
# last commit passes, so a run cut short has written none — but it may be
# inside a worktree it made to check in, and killing it leaves that
# registered. The whole job goes, not just seam: the check is its child and a
# typechecker will happily carry on alone.
stop() {
  printf '\033[?25h'
  [ -z "$pid" ] || { kill -TERM "-$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null; wait "$pid" 2>/dev/null; }
  git worktree prune 2>/dev/null
  git show-ref --verify -q "refs/heads/$branch" && git update-ref -d "refs/heads/$branch" 2>/dev/null
  rm -rf "$tmp"
}
cancelled() {
  stop
  printf '\n  %bStopped. Nothing was written, and you are still on %s.%b\n\n' "$GK_TEXT" "$here" "$GK_R"
  exit 130
}
pid=
trap 'stop' EXIT TERM
trap 'cancelled' INT

seam "$rev" --split --json > "$tmp/plan" 2>"$tmp/err" || {
  sed 's/^/  /' "$tmp/err" >&2; exit 1; }
n=$(jq '.slices | length' "$tmp/plan")
[ "$n" -gt 1 ] || { echo "git-split: one slice, which is the change as it is; nothing to split" >&2; exit 1; }
base=$(jq -r '.base' "$tmp/plan")
# The name you typed reads better than the sha it resolved to: main..<branch>
# is the same three commits and is a thing you would type again.
from=${rev%%.*}; [ -n "$from" ] || from=$(git rev-parse --short "$base" 2>/dev/null || echo "$base")
jq -r '.slices[] | [(.n|tostring),
     (.name + (if (.roots|length) > 1 then " +" + ((.roots|length) - 1 | tostring) + " more" else "" end)),
     ((.files|length)|tostring) + " file" + (if (.files|length) == 1 then "" else "s" end),
     ((.lines|tostring)) + " line" + (if .lines == 1 then "" else "s" end)] | @tsv' "$tmp/plan" > "$tmp/slices"

# The screen, redrawn in place: one row a slice, its mark in the first column.
# Nothing is cleared but the rows, so whatever was in the terminal before is
# still above it.
draw() {
  [ -z "$drawn" ] || printf '\033[%dA' "$rows"
  rows=0
  line() { printf '\033[2K%b\n' "$1"; rows=$((rows + 1)); }
  line ""
  line "  ${GK_MAIN}seam${GK_R}  ${GK_FAINT}$rev${GK_R}  ${GK_FAINT}→${GK_R}  ${GK_YOURS}$branch${GK_R}${passnote}"
  line ""
  # Until the first fuse the plan on screen is the plan seam is building. A
  # fuse changes it — slices merge and everything after renumbers — so from
  # then on the rows are what seam has actually reported this pass, and no
  # total is shown, because seam has not said what the new one is.
  if [ "$fused" -gt 0 ]; then
    n2=0
    while IFS= read -r l; do
      n2=$((n2 + 1))
      line "$(printf '%b ✓ %b%s%b %s' "$GK_GOOD" "$GK_R" "$n2" "$GK_R" "$l")"
    done < "$tmp/rows"
    if [ -n "$running" ]; then
      line "$(printf '%b %s %b%s%b %b%s%b' "$GK_ATTENTION" "$spin" "$GK_R" "$((n2 + 1))" "$GK_R" "$GK_CONTEXT" "$checking" "$GK_R")"
    elif [ -n "$failed" ]; then
      line "$(printf '%b ✗ %b%s%b %bdid not stand up%b' "$GK_BAD" "$GK_R" "$((n2 + 1))" "$GK_R" "$GK_BAD" "$GK_R")"
    fi
    line ""
    line "  ${GK_FAINT}${foot}${GK_R}"
    drawn=1
    return
  fi
  while IFS='	' read -r k name nf nl; do
    mark="   " ; tail=""
    if [ "$k" -lt "$at" ]; then mark="${GK_GOOD} ✓ ${GK_R}"
    elif [ "$k" -eq "$at" ] && [ -n "$running" ]; then
      mark="${GK_ATTENTION} $spin ${GK_R}"; tail="  ${GK_CONTEXT}${checking}${GK_R}"
    elif [ "$k" -eq "$at" ] && [ -n "$failed" ]; then
      mark="${GK_BAD} ✗ ${GK_R}"; tail="  ${GK_BAD}did not stand up${GK_R}"
    fi
    line "$(printf "%b%s%b %-${namew}.${namew}s %b%14s · %11s%b%b" \
      "$mark" "$k" "$GK_R" "$name" "$GK_FAINT" "$nf" "$nl" "$GK_R" "$tail")"
  done < "$tmp/slices"
  line ""
  line "  ${GK_FAINT}${foot}${GK_R}"
  drawn=1
}

# The name column takes what the window has left, so a long one is not cut
# to make room for a gap.
cols=$({ stty size < /dev/tty; } 2>/dev/null | cut -d' ' -f2)
[ "${cols:-0}" -ge 60 ] 2>/dev/null || cols=100
[ "$cols" -le 140 ] || cols=140
namew=$((cols - 46))
[ "$namew" -ge 20 ] || namew=20
at=1 spin='|' drawn= rows=0 running=1 pass=1 fused=0
checking=${check:+checking with $check}
foot=${check:+nothing is written unless every commit passes · ctrl-c to stop}
[ -n "$check" ] || foot="writing the commits"
printf '\033[?25l'
draw

# seam prints a line as each commit lands, so a line arriving means that slice
# is done and the next one is under way. Its own output is kept for the end.
set -m 2>/dev/null
( seam "$rev" --split --branch "$branch" ${check:+--check "$check"} > "$tmp/out" 2>"$tmp/err"; echo $? > "$tmp/rc" ) &
pid=$!
set +m 2>/dev/null
frames='|/-\'
i=0
# seam says "fused, and building it again" when the check sent it back to the
# plan, and every commit it makes is a line. Both are read from the same
# stream: the rows since the last fuse are this pass, and the count of fuses
# is which pass this is.
tally() {
  fused=$(grep -c 'fused, and building it again' "$tmp/out" 2>/dev/null) || :
  fused=${fused:-0}
  pass=$((fused + 1))
  passnote=""
  [ "$fused" -eq 0 ] || passnote="  ${GK_FAINT}· pass $pass, $fused fused${GK_R}"
  # A commit seam reported, and only one that stood up: a line ending "... no"
  # is the slice that failed, and ticking it is the lie this screen exists not
  # to tell. Without a check there is no "..." at all and the line is done.
  awk '/fused, and building it again/ { n = 0; next }
       /^  [0-9]/ {
         if ($0 ~ / \.\.\. no$/) next
         sub(/^  [0-9]+  /, ""); sub(/ \.\.\. ok$/, "")
         rows[++n] = $0
       }
       END { for (i = 1; i <= n; i++) print rows[i] }' "$tmp/out" > "$tmp/rows" 2>/dev/null
  done_n=$(grep -c . "$tmp/rows" 2>/dev/null) || :
  at=$(( ${done_n:-0} + 1 ))
}
while kill -0 "$pid" 2>/dev/null; do
  tally
  i=$(( (i + 1) % 4 ))
  spin=$(printf '%s' "$frames" | cut -c$((i + 1)))
  draw
  sleep 0.12
done
wait "$pid" 2>/dev/null
rc=$(cat "$tmp/rc" 2>/dev/null || echo 1)
running=
# Only the slices seam actually reported are done. Marking everything done
# because the run ended put nine ticks against a stack where one slice had
# run and failed, which is the single worst thing this screen could say.
tally
[ "$rc" -eq 0 ] && at=$((n + 1)) || at=$((done_n + 1))

if [ "$rc" -eq 0 ]; then
  foot="all $n stood up"
  draw
  printf '\033[?25h'
  printf '\n  %bYou are still on %s. The split is %s.%b\n\n' "$GK_TEXT" "$here" "$branch" "$GK_R"
  printf '    %bread it%b   gl %s..%s\n' "$GK_FAINT" "$GK_R" "$from" "$branch"
  printf '    %btake it%b   git checkout %s\n' "$GK_FAINT" "$GK_R" "$branch"
  printf '    %bdrop it%b   git branch -D %s\n\n' "$GK_FAINT" "$GK_R" "$branch"
  [ -z "$wait" ] || { printf '  %bpress enter%b' "$GK_FAINT" "$GK_R"; read -r _; }
else
  failed=1
  foot="nothing written"
  draw
  printf '\033[?25h'
  printf '\n'
  sed 's/^/  /' "$tmp/err" >&2
  printf '\n  %bYou are still on %s, exactly as you left it.%b\n\n' "$GK_TEXT" "$here" "$GK_R"
  [ -z "$wait" ] || { printf '  %bpress enter%b' "$GK_FAINT" "$GK_R"; read -r _; }
fi
exit "$rc"
