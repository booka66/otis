#!/bin/sh
# git-mr-new --check <branch> [<its MR's iid>]   gb's n, as fzf actions for a transform binding
# git-mr-new --ask <branch>                      the questions, in the terminal
# git-mr-new --said                              what that did, as a footer note
#
# An MR for a branch that has none, asked first: into the branch below it on
# a stack, else main, titled and described from its commits the way gp's
# first push offers one, with the project's defaults. A branch of several
# commits can go up as a glab stack instead (gstack), one MR a commit
# (_g_mr_new in share/otis.zsh).
root=$(cd "$(dirname "$0")/.." && pwd)
how=${1#--}; shift
exec zsh -fc 'source "$1/share/otis.zsh"; shift; _g_mr_new "$@"' - "$root" "$how" "$@"
