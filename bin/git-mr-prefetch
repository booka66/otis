#!/bin/sh
# git-mr-prefetch <mrs.json> [ci.json]: fetch the commits of the MRs requesting
# your review that are not here yet, from the JSON git-mr-list saved, so that
# opening one (git-mr-review) finds them and starts without the network; and,
# given the JSON of your own (ci.json), theirs, so git-mr-mine does too. One
# fetch for all of them: each missing MR's head ref (your branch, for yours),
# and its target branch when its base is missing too. The comment threads of
# those you review are cached too, for the file picker's counts and previews.
# Only one runs at a time; the list reloads often.
json=$1 mine=$2
story=$(dirname "$0")/../share/sentences.mjs
[ -r "$json" ] || exit 0
[ -r "$mine" ] || mine=/dev/null
common=$(git rev-parse --git-common-dir) || exit 0
lock="$common/gmr-prefetch.lock"
# A lock older than two minutes is from a fetch that died.
[ -n "$(find "$lock" -maxdepth 0 -mmin +2 2>/dev/null)" ] && rmdir "$lock" 2>/dev/null
mkdir "$lock" 2>/dev/null || exit 0
trap 'rmdir "$lock"' EXIT

have() { [ -n "$1" ] && git cat-file -e "$1^{commit}" 2>/dev/null; }
refspecs=$({ jq -r '.data.currentUser as $u | $u.reviewRequestedMergeRequests.nodes[]?
  | select(.author.username != $u.username)
  | [.iid, .targetBranch, (.diffRefs.headSha // ""), (.diffRefs.baseSha // ""), (.diffRefs.startSha // "")] | @tsv' "$json" |
  while IFS="$(printf '\t')" read -r iid target head base start; do
    have "$head" || printf '+%s:refs/mr/%s\n' "$(git-forge head-ref "$iid")" "$iid"
    { have "$base" && { [ -z "$start" ] || have "$start"; }; } || printf '+refs/heads/%s:refs/remotes/origin/%s\n' "$target" "$target"
  done
  jq -r '.data.currentUser.authoredMergeRequests.nodes[]?
    | [.sourceBranch, .targetBranch, (.diffRefs.headSha // ""), (.diffRefs.baseSha // ""), (.diffRefs.startSha // "")] | @tsv' "$mine" 2>/dev/null |
  while IFS="$(printf '\t')" read -r source target head base start; do
    have "$head" || printf '+refs/heads/%s:refs/remotes/origin/%s\n' "$source" "$source"
    { have "$base" && { [ -z "$start" ] || have "$start"; }; } || printf '+refs/heads/%s:refs/remotes/origin/%s\n' "$target" "$target"
  done; } | sort -u)
# Threads not cached yet; with no picker to reload, git-cached-json fetches them now.
jq -r '.data.currentUser as $u | $u.reviewRequestedMergeRequests.nodes[]? | select(.author.username != $u.username) | .iid' "$json" |
  while read -r iid; do
    FZF_PORT= git-cached-json "mr-$iid-threads" 15 true -- \
      git-mr-pages "projects/:fullpath/merge_requests/$iid/discussions?per_page=100" >/dev/null 2>&1 &
  done
[ -n "$refspecs" ] && GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND='ssh -o BatchMode=yes' git fetch --quiet --no-tags origin $refspecs
wait

# Their own tests, traced for P before you open them (git-walk --ahead), those
# you review first, then yours: once a push, one at a time, never while a build
# of yours runs, and only MRs opened since ahead tracing began here
# (git-walk --ahead-since), not every one already open then. Not one you have
# approved, whose walk git-walk --settle would stop.
since=$(git-walk --ahead-since)
new='def made: (.createdAt // "") | sub("\\.[0-9]+"; "") | (try fromdateiso8601 catch 0);'
{ jq -r --argjson since "${since:-0}" "$new"'.data.currentUser as $u | $u.reviewRequestedMergeRequests.nodes[]?
    | select(.author.username != $u.username and made >= $since and (any(.approvedBy.nodes[]?; .username == $u.username) | not))
    | [.iid, (.diffRefs.headSha // ""), (.diffRefs.baseSha // ""), (.diffRefs.startSha // "")] | @tsv' "$json"
  jq -r --argjson since "${since:-0}" "$new"'.data.currentUser.authoredMergeRequests.nodes[]? | select(made >= $since)
    | [.iid, (.diffRefs.headSha // ""), (.diffRefs.baseSha // ""), (.diffRefs.startSha // "")] | @tsv' "$mine" 2>/dev/null; } |
  while IFS="$(printf '\t')" read -r iid head base start; do
    have "$head" && have "$base" || continue
    git-walk --ahead "$iid" "$head" "$base" "$start" </dev/null >/dev/null 2>&1
  done

# Each one's symbol table (git-symbols --table), built now rather than when
# you open it, since seam was most of the first list; and Claude's gloss of
# it (git-symbols-gloss), so a review opens glossed and stays as it opened.
# Both keyed as git-mr-review's list keys them (git-mr-base's base, the
# head), and cached by those shas for good, so each MR is read once a push.
# Not the callers: tsgo is gigabytes a run, for when you are in the review.
# Each by whichever reads the change (otis.engine), whose name is in the
# table's: seam's is its mtime alone, dagger's starts with dagger.
command -v seam >/dev/null 2>&1 || exit 0
engine=$(otis-config engine)
command -v "$engine" >/dev/null 2>&1 || exit 0
case $engine in dagger) tabs=dagger ;; *) tabs='[0-9]' ;; esac
gloss=; command -v claude >/dev/null 2>&1 && [ "$(git config --get otis.symbolsModel)" != off ] && gloss=1
cache=$(git rev-parse --path-format=absolute --git-common-dir)/git-alias-cache
# Following a change case by case is a minute or two of Claude reading the code: two at a time, all told.
telling=0
for f in "$cache/symbols-sentences"/*.running; do [ -s "$f" ] && kill -0 "$(cat "$f")" 2>/dev/null && telling=$((telling + 1)); done
jq -r '.data.currentUser as $u | $u.reviewRequestedMergeRequests.nodes[]?
  | select(.author.username != $u.username)
  | [.targetBranch, (.diffRefs.headSha // ""), (.diffRefs.baseSha // ""), (.diffRefs.startSha // ""), .iid] | @tsv' "$json" |
  while IFS="$(printf '\t')" read -r target head base start iid; do
    have "$head" && have "$base" || continue
    # Read already at this head, the usual case: globs.
    glossed=$([ -z "$gloss" ] && echo 1)
    for f in "$cache/symbols-gloss"/*-"$head".json; do [ -s "$f" ] && glossed=1; done
    for f in "$cache/symbols-gloss"/*-"$head".running; do kill -0 "$(cat "$f" 2>/dev/null)" 2>/dev/null && glossed=1; done
    tabled=
    for f in "$cache/symbols"/*-"$head"-$tabs*.tsv; do [ -s "$f" ] && tabled=1; done
    # And told as a story (git-sentences), which is the list a review opens on: again once otis tells it another way.
    sentenced=$([ -z "$gloss" ] && echo 1)
    for f in "$cache/symbols-sentences"/*-"$head".tsv; do [ -s "$f" ] && [ ! "$story" -nt "$f" ] && sentenced=1; done
    [ -n "$glossed" ] && [ -n "$tabled" ] && [ -n "$sentenced" ] && continue
    have "$start" || start=$(git rev-parse -q --verify "origin/$target") || continue
    b=$(git rev-parse "$(git-mr-base "$base" "$head" "$start")") || continue
    t=$(git-symbols --table "$b..$head") || continue
    [ -n "$glossed" ] || OTIS_SYMBOLS_KEY=$b-$head git-symbols-gloss "$b..$head" "$t" >/dev/null 2>&1
    [ -n "$sentenced" ] || [ "$telling" -ge 2 ] || { GMR_IID=$iid git-sentences --warm "$b..$head" >/dev/null 2>&1; telling=$((telling + 1)); }
  done
# Your own too, at the head the MR has, which is where git-mr-mine opens once your branch is pushed.
# Two a run: the list reloads often, and each is a model call.
[ -n "$gloss" ] || exit 0
jq -r '.data.currentUser.authoredMergeRequests.nodes[]? | select(.iid and .diffRefs.headSha and .diffRefs.baseSha)
  | [.iid, .targetBranch, .diffRefs.headSha, .diffRefs.baseSha, (.diffRefs.startSha // "")] | @tsv' "$mine" 2>/dev/null |
  while IFS="$(printf '\t')" read -r iid target head base start; do
    have "$head" && have "$base" || continue
    sentenced=
    for f in "$cache/symbols-sentences"/*-"$head".tsv; do [ -s "$f" ] && [ ! "$story" -nt "$f" ] && sentenced=1; done
    for f in "$cache/symbols-sentences"/*-"$head".running; do [ -s "$f" ] && sentenced=1; done
    [ -n "$sentenced" ] && continue
    [ "$telling" -lt 2 ] || break
    have "$start" || start=$(git rev-parse -q --verify "origin/$target") || continue
    b=$(git rev-parse "$(git-mr-base "$base" "$head" "$start")") || continue
    GMR_IID=$iid git-sentences --warm "$b..$head" >/dev/null 2>&1
    telling=$((telling + 1))
  done
