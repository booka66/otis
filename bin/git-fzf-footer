#!/bin/sh
# git-fzf-footer: a picker's footer. First a one-time note if there is one, else
# the status line its list command left in $GIT_FZF_STATE/footer, if any; then the picker's keys and the shared ones,
# as many as fit the width, ending in "? more keys" when some are left out or
# "? help" when none are. Redrawn on load and on resize.
share=$(cd "$(dirname "$0")/../share" && pwd)
. "$share/palette.sh"
st=$GIT_FZF_STATE
# Data from GitLab that could not be refreshed (git-fzf-stale) says so first,
# with the time of the oldest fetch that worked, since the list may be wrong.
stale= oldest=
for f in "$st"/stale.*; do
  [ -e "$f" ] || continue
  stale=1 c=$(cat "$f")
  [ -e "$c" ] || { oldest=none; continue; }
  [ "$oldest" = none ] && continue
  { [ -z "$oldest" ] || [ "$c" -ot "$oldest" ]; } && oldest=$c
done
if [ -n "$stale" ]; then
  if [ "$oldest" = none ]; then
    since="so some of this is missing"
  elif [ "$(date -r "$oldest" +%F)" = "$(date +%F)" ]; then
    since="showing what it said at $(date -r "$oldest" +%H:%M)"
  else
    since="showing what it said $(date -r "$oldest" '+%b %e %H:%M')"
  fi
  printf "${GK_BAD}could not refresh from GitLab, %s · ? shows why${GK_R}\n" "$since"
fi
# A note (a key that had nothing to act on, say) shows once, then clears.
if [ -s "$st/note" ]; then
  printf "${GK_ATTENTION}%s${GK_R}\n" "$(cat "$st/note")"
  rm -f "$st/note"
elif [ -s "$st/footer" ]; then
  cat "$st/footer"
fi
# The footer spans the list's column, which is the whole width unless the
# preview sits to the right, where it starts at FZF_PREVIEW_LEFT.
cols=${FZF_COLUMNS:-0}
[ "$cols" -gt 0 ] || cols=$(stty size </dev/tty 2>/dev/null | cut -d' ' -f2)
[ -n "$cols" ] || cols=100
[ "${FZF_PREVIEW_LEFT:-0}" -gt 0 ] && cols=$FZF_PREVIEW_LEFT
awk -F'\t' -v width="$((cols - 4))" "$(cat "$share/rowfmt.awk")"'
  NF == 2 { key[++n] = $1; label[n] = $2 }
  END {
    sep = " · "; seplen = 3
    used = 0; out = ""; cut = 0
    for (i = 1; i <= n; i++) {
      tail = (i == n) ? 6 : 11
      need = used + (used ? seplen : 0) + length(key[i]) + 1 + length(label[i])
      if (need + seplen + tail > width) { cut = 1; break }
      out = out (used ? GK_CONTEXT sep GK_R : "") GK_ATTENTION key[i] GK_R " " GK_CONTEXT label[i] GK_R
      used = need
    }
    out = out (used ? GK_CONTEXT sep GK_R : "") GK_ATTENTION "?" GK_R " " GK_CONTEXT (cut ? "more keys" : "help") GK_R
    print out
  }' "$st/hints"
