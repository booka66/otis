#!/bin/sh
# git-fzf <prompt> <keys> [fzf options...]
# Every picker opens through here, and each is drawn by hand (otis-pick):
# the name is the one the pickers call, from when fzf drew them, and what
# they pass is still fzf's: the keys as "key=label" pairs, --bind, --preview
# and the rest. otis-pick says what it takes.
exec otis-pick "$@"
