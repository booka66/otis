#!/usr/bin/env -S zsh -f
# j/k navigate, / searches, esc goes back to navigating. Action keys are plain
# letters, so they get unbound while searching; leaving search keeps the query,
# so they act on what it found. A second esc clears the query, a third quits.
# Every picker goes through here, zsh functions and bin/ scripts alike, so
# navigation, search, preview scrolling, sizing, the footer and help are the
# same everywhere.
#
# The caller declares its own action keys as "key=label" pairs; that one list
# drives the footer's key hints, the ? help view and the unbind set, so they
# cannot drift apart. An empty label ("o=") keeps a key out of the hints but
# still unbinds it. enter and tab are never unbound, since fzf needs them to
# accept and to mark while searching. Keys after a lone "|" in the list are
# left out of the footer, which then ends in "? more keys": a picker shows
# the few keys you need first there, and ? shows them all.
#
# --search opens a picker already searching. A script, not a function, so bin/
# scripts launched from fzf bindings can open a picker with the same keys.
prompt=$1 spec=$2; shift 2
# The theme (otis-theme), for every list, preview and binding under this
# picker, where a command above has not loaded it already.
[[ -n $OTIS_T_NAME && $OTIS_THEME == "$OTIS_T_WANT" ]] || eval "$(otis-theme --env)"
# The settings (otis-config), the same way: worked out once here, and read
# from the environment by the list, every preview and every binding, each of
# which used to ask git for them again. Only while this is still the checkout
# they were worked out for: a picker opened in another repo from a shell that
# carries one's settings must not draw with them, nor a worktree nested in
# that checkout (share/in-root.sh).
. ${0:A:h:h}/share/in-root.sh
in_root || eval "$(otis-config --env)"
# The row library (share/rowfmt.awk), the same way: every list, preview and
# footer under this picker pastes it into its awk, and each used to cat it.
export OTIS_ROWFMT=$(<${0:A:h:h}/share/rowfmt.awk)
typeset -a keys hints
more=
for pair in ${(s:,:)spec}; do
  [[ -z $pair ]] && continue
  [[ $pair == '|' ]] && { more=$'\tmore'; continue }
  k=${pair%%=*}
  [[ -n ${pair#*=} ]] && hints+=("$k"$'\t'"${pair#*=}$more")
  [[ $k == (enter|tab) ]] || keys+=($k)
done

unbindable="j,k,g,G,q,/,?,],["
(( $#keys )) && unbindable="$unbindable,${(j:,:)keys}"

# ctrl-d/ctrl-u glide through git-fzf-scroll, which drives this picker over
# --listen. That port accepts any action, execute included, from anything that
# can reach localhost (a web page too), so each picker gets its own key, which
# fzf then demands on every request.
# Built from /dev/urandom with zsh builtins; od and tr cost a few ms per picker.
#
# Every scroll moves the preview through fzf's own actions first and only
# records where it went afterwards, in the background. A transform binding
# makes fzf wait for the command before it will move at all, so a wheel notch
# used to sit on a shell starting before it scrolled a line. ctrl-d and ctrl-u
# lead with three lines the same way and glide the rest, so they start moving
# on the keypress too.
zmodload zsh/system zsh/files
sysread -s 16 bytes </dev/urandom
FZF_API_KEY=
for c in ${(s::)bytes}; do FZF_API_KEY+=${(l:2::0:)$(( [##16] #c ))}; done
# otis-test drives a picker from outside through its port, so it names the
# port and the key; nothing else should.
[[ -n $OTIS_FZF_API_KEY ]] && FZF_API_KEY=$OTIS_FZF_API_KEY
export FZF_API_KEY
listen=--listen
[[ -n $OTIS_FZF_LISTEN ]] && listen=--listen=$OTIS_FZF_LISTEN

# Per-picker state. git-fzf-scroll keeps each item's preview offset here, since
# fzf resets the preview on every move, and on every reload too, and never
# reports where it was; so the mouse wheel over the preview goes through it as
# well, a line a notch. The caller's preview is wrapped to record its line
# count, which caps the offset at the last line, and to put the item's position
# back once it has printed. A list command that wants a status line in the
# footer writes it to footer here, and git-fzf-footer adds the key hints under
# it on load and resize, so a caller must not bind load or resize itself.
export GIT_FZF_STATE=${TMPDIR:-/tmp}/git-fzf.$$.$RANDOM$RANDOM
mkdir -m 700 $GIT_FZF_STATE || exit 1
st=$GIT_FZF_STATE
# git-fzf-scroll's lock; zsystem flock will not create it.
: > $st/lock
# Closing the terminal mid-picker skips the cleanup at the end; this covers it.
trap 'rm -rf -- "$st"; exit 1' HUP TERM
{
  print -rl -- $hints
  print -- "--"
  print -rl -- $'j/k\tmove' $'/\tsearch' $'esc\tstop searching, clear, quit' $'ctrl-d/u\tscroll preview' \
    $'ctrl-e/y\tpreview by a line' $'g/G\ttop, bottom' $'q\tquit'
} > $st/hints

# The ? help view lives in the preview pane: the preview shows help while
# help-on exists. A picker without a preview of its own gets one that is only
# help, hidden until ? opens it.
typeset -a args
preview= search= start_actions= header= id='{n}'
while (( $# )); do
  if [[ $1 == --id-nth=* ]]; then
    # Offsets are kept per item: by its --id-nth field when the caller gives
    # one, since a reload that reorders the list moves an item to another {n}.
    id="{${1#--id-nth=}}"
    : > $st/by-id
    args+=("$1")
    shift
  elif [[ $1 == --preview ]]; then
    preview=$2
    shift 2
  elif [[ $1 == --header-from-state ]]; then
    # The list command writes the header ($st/header: a line of text the
    # cursor never lands on, as git-symbols' summary of the change), and
    # each load shows what it wrote.
    header="+transform-header(cat $st/header 2>/dev/null)"
    shift
  elif [[ $1 == --search ]]; then
    # Open already searching, as if / had been pressed.
    search="+unbind($unbindable)+change-prompt(search> )"
    shift
  elif [[ $1 == --bind && $2 == start:* ]]; then
    # fzf keeps only the last start binding, so a caller's start actions are
    # chained after this picker's own instead of replacing them.
    start_actions+="+${2#start:}"
    shift 2
  else
    args+=("$1")
    shift
  fi
done
# A picker that sets no header of its own lends it to whatever is about to make
# you wait: git-cached-json puts what it is fetching there while a cold fetch
# holds the first list up, and rows landing take it back down. A caller with a
# header of its own keeps it, and is never lent out.
if [[ -z $header && ${args[(I)--header*]} -eq 0 ]]; then
  export OTIS_FZF_HEADER=1
  header='+change-header()'
fi

# The preview's rows, counted for the scroll's last line, and where each run
# of changed rows starts and ends, for ] and [ (git-fzf-scroll hunk): delta
# gives a changed row a background, a wrapped one too, and no other row has
# one but git-symbols' peeks, which are on the code background.
hunk_awk='BEGIN { printf "" > h; cb = "\033[" ENVIRON["OTIS_T_CODEBG"] "m" } { print; c = index($0, "\033[48;") && !(cb != "\033[m" && index($0, cb)) } c && !p { s = NR } !c && p { print s, NR - 1 > h } { p = c } END { if (p) print s, NR > h; print NR > f }'
if [[ -n $preview ]]; then
  : > $st/has-preview
  print -r -- $']/[\tnext, previous change' >> $st/hints
  # The preview runs on every move, so it also notes the focused item (a glide
  # stops when that changes) and, only for an item with a saved position, puts
  # that position back once it has printed. Nothing else runs per move. The
  # item's key names files, so each / in an id (a path) becomes %, with shell
  # builtins alone, and an id longer than a filename may be (a symbol three
  # deep in git-symbols' tree is three paths long) keeps its last 200
  # characters: the leaf symbol, so the same symbol under two roots shares a
  # position, and it has the same preview under both. git-fzf-scroll does the
  # same to the ids it is given. Rows a timer held back while you read
  # (git-fzf-bg --tick) go in on the move off it.
  args+=(--preview "k=$id i=; while :; do case \$k in */*) i=\$i\${k%%/*}%; k=\${k#*/} ;; *) i=\$i\$k; break ;; esac; done; while [ \${#i} -gt 200 ]; do i=\${i#?}; done
printf '%s\\n' \"\$i\" > '$st/focus'; if [ -e '$st/bg.pending' ]; then git-fzf-bg --pending >/dev/null 2>&1 & fi; printf '%s' \"\$FZF_PREVIEW_COLUMNS\" > '$st/cols'; printf '%s' \"\$FZF_PREVIEW_LINES\" > '$st/plines'; if [ -e '$st/help-on' ]; then git-fzf-help show; else { $preview
} | awk -v f=\"$st/lines.\$i\" -v h=\"$st/hunks.\$i\" '$hunk_awk'; [ -s \"$st/off.\$i\" ] && git-fzf-scroll loaded \"\$i\" >/dev/null 2>&1 & fi")
else
  # hidden twice: the narrow-terminal layout replaces the options, so it needs its own.
  args+=(--preview "git-fzf-help show" --preview-window 'hidden,<66(down,60%,border-top,wrap,hidden)')
fi

# fzf's own colors (the prompt, the pointer, the line under the cursor,
# matches, borders) from the theme, so a picked theme is the whole picker and
# not only its rows; on the terminal's ground, which is what a theme is made
# for, rather than a background from FZF_DEFAULT_OPTS. The terminal themes
# are your terminal's colors, so there your own fzf colors stay.
colors=()
if [[ $OTIS_T_NAME != terminal* ]]; then
  # A theme's SGR truecolor (38;2;r;g;b, 48;2;r;g;b) as fzf's #rrggbb; a
  # hex value (its rule) as it is. Into a variable, not printed: sixteen of
  # these in $(...) were sixteen forks, and most of what this script cost
  # before fzf appeared.
  hex() {
    local -a p=(${(s:;:)1})
    if (( $#p == 5 )); then printf -v REPLY '#%02x%02x%02x' $p[3] $p[4] $p[5]; else REPLY=$1; fi
  }
  typeset text elsewhere main rule
  hex $OTIS_T_TEXT; text=$REPLY
  hex $OTIS_T_ELSEWHERE; elsewhere=$REPLY
  hex $OTIS_T_MAIN; main=$REPLY
  hex $OTIS_T_RULE; rule=$REPLY
  typeset codebg attention context good
  hex $OTIS_T_CODEBG; codebg=$REPLY
  hex $OTIS_T_ATTENTION; attention=$REPLY
  hex $OTIS_T_CONTEXT; context=$REPLY
  hex $OTIS_T_GOOD; good=$REPLY
  # The gutter is a column of ▌ in the gutter color, which FZF_DEFAULT_OPTS
  # usually hides by matching its own background; on the terminal's ground
  # there is no color to match, so it is drawn with nothing at all.
  colors=(--gutter=' ' --color="fg:$text,fg+:$text,query:$text,bg:-1,preview-bg:-1,gutter:-1,bg+:$codebg,hl:$elsewhere,hl+:$elsewhere,prompt:$attention,info:$context,pointer:$main,marker:$good,spinner:$main,header:$elsewhere,border:$rule,separator:$rule,scrollbar:$rule")
fi

# esc steps back one level: out of searching with the query kept, then clearing
# the query, then out of the picker. The prompt tells searching apart, since
# the query can be live either way.
esc="if [ \"\$FZF_PROMPT\" = 'search> ' ]; then echo 'rebind($unbindable)+change-prompt($prompt)'; elif [ -n {q} ]; then echo clear-query; else echo abort; fi"

# Side by side, and stacked below only when the terminal is too narrow to hold
# both. fzf measures a "<N(...)" threshold against the PREVIEW window rather
# than the terminal (fzf(1): "the size of the preview window"), and the preview
# takes 55%, so <66 keeps the two side by side down to 120 columns, where the
# diff still has about 60, and stacks them only under that.
# share/rowfmt.awk's gk_list_width mirrors this rule for the rows.
# Full screen, not --height: fzf then uses the alternate screen, so the list
# never lands in scrollback and the terminal is restored cleanly on exit.
# Bindings and previews run in zsh whatever your login shell is: fzf would
# hand them to $SHELL, and fish cannot read them. -f skips your zsh startup
# files, which they do not need. The footer is sourced into that zsh rather
# than started from it: it is builtins alone, and it is drawn on every load.
fzf --prompt="$prompt" \
  --with-shell 'zsh -fc' \
  --reverse $listen \
  --preview-window='right,55%,border-left,wrap,<66(down,60%,border-top,wrap)' \
  --bind 'j:down,k:up,g:first,G:last,q:abort' \
  --bind 'focus:unbind(focus)+transform-footer(. git-fzf-footer)' \
  --bind "start:unbind(focus)+transform-footer(. git-fzf-footer)$search$start_actions" \
  --bind "load,resize:transform-footer(. git-fzf-footer)$header" \
  --bind '?:transform(git-fzf-help toggle)' \
  --bind "ctrl-e:preview-down+execute-silent(git-fzf-scroll note $id 1 >/dev/null 2>&1 &)" \
  --bind "ctrl-y:preview-up+execute-silent(git-fzf-scroll note $id -1 >/dev/null 2>&1 &)" \
  --bind "preview-scroll-down:preview-down+execute-silent(git-fzf-scroll note $id 1 >/dev/null 2>&1 &)" \
  --bind "preview-scroll-up:preview-up+execute-silent(git-fzf-scroll note $id -1 >/dev/null 2>&1 &)" \
  --bind "]:execute-silent(git-fzf-scroll hunk $id >/dev/null 2>&1 &)" \
  --bind "[:execute-silent(git-fzf-scroll -hunk $id >/dev/null 2>&1 &)" \
  --bind "ctrl-d:preview-down+preview-down+preview-down+execute-silent(git-fzf-scroll half $id 3 >/dev/null 2>&1 &)" \
  --bind "ctrl-u:preview-up+preview-up+preview-up+execute-silent(git-fzf-scroll -half $id -3 >/dev/null 2>&1 &)" \
  --bind "/:unbind($unbindable)+change-prompt(search> )" \
  --bind "esc:transform:$esc" \
  "${colors[@]}" "${args[@]}"
code=$?
rm -rf -- "$st"
exit $code
