#!/bin/sh
# git-mr-list [toggle | --refresh]
# Rows for gmr, the one picker for merge requests. Three sections:
#   review   MRs requesting your review; once you have reviewed one (approved,
#            commented as a review, or requested changes) it moves to the very
#            bottom, out of the way, until GitLab asks you again
#   yours    your open MRs, with their pipelines 
#   merged   yours merged in the last week, and whether each is live
#            (git-ci-merged: merged, queued, deploying, live, rolled back),
#            and Claude's production watch of it, if any (git-mr-watch)
#
# A row also says, in a word, what AI is doing on it or has left for it:
# reviewing, fixing, verifying or tracing while it goes; its notes or fixes
# waiting on you; a verification or trace that failed; and, at the MR's current
# head, verified, a tour to walk (P), or clean when a review found nothing to
# say (git-mr-claude, git-mr-fix, git-verify, git-walk).
# $GMR_FIRST=mine opens it with yours first. toggle switches to
# every open MR in the project and back, the 100 most recently updated, since
# a big project has thousands; --refresh (u) refetches now.
#
# A row is what you see, then tab-separated iid, target branch, MR url, source
# branch, kind (review, mine or merged), the MR's head and base commits as
# GitLab reports them, a pipeline id and a url for it (for merged rows, the
# deploy that shipped or will ship it).
#
# Stacks read as stacks, growing up: within a section an MR targeting another
# listed MR's branch sits above it, indented, top of the stack first. The base
# of a stack that targets a branch other than main with no open MR of its own
# here says which. On an MR you review, approval means you approved it; on
# yours, whether it has the approvals it needs. A pipeline failing only on
# approval gates (otis-config gateJobs) is waiting, not broken. ▶ marks the MR for the
# branch you are on; one checked out in another worktree names it in blue after
# the title ("in mine"), as gb does.
#
# Each source is its own cache (git-cached-json), drawn at once and refreshed
# in the background: MRs to review, every open MR, and yours with their
# pipelines after 15s; merged ones after a minute, and never waited for. The
# JSON is saved in the picker's $GIT_FZF_STATE for the previews
# (git-mr-preview), and the commits of MRs to review are fetched ahead of time
# (git-mr-prefetch), so opening one rarely waits on the network.
st=$GIT_FZF_STATE
share=$(cd "$(dirname "$0")/../share" && pwd)
. "$share/palette.sh"
# Claude's runs that a closed laptop killed go on from where they stopped
# (share/claude-run.sh), in a subshell so its helpers stay out of this script.
( . "$share/claude-run.sh" && resume_all )
git remote get-url origin >/dev/null 2>&1 || {
  printf "${GK_BAD}gmr needs an origin remote on GitLab or GitHub, and this repo has none${GK_R}\t\t\t\t\t\t\t\t\t\terr-origin\n"
  exit 0
}
scope=$(cat "$st/mr-scope" 2>/dev/null || echo sections)
if [ "$1" = toggle ]; then
  if [ "$scope" = sections ]; then scope=all; else scope=sections; fi
  echo "$scope" > "$st/mr-scope"
  git-fzf-scroll reset
fi
age=15 merged_age=60 now=
[ "$1" = --refresh ] && age=0 merged_age=0 now=--now
reload="execute-silent(git-fzf-bg --then refresh-preview git-mr-list)"
# What Claude is doing and what is waiting on you, and where the branches are
# checked out: none of it needs GitLab or a setting, so it all starts first
# and runs while the caches are read, each writing a file of its own for the
# one jq at the end. Worked out once here and saved for the previews
# (git-mr-preview, git-ci-preview), which run on every cursor move and used to
# ask the same four scripts each time.
git-mr-watch --marks  > "$st/m.watch"  2>/dev/null &
git-mr-claude --marks > "$st/m.claude" 2>/dev/null &
git-mr-fix --marks    > "$st/m.fixes"  2>/dev/null &
git-verify --marks    > "$st/m.verify" 2>/dev/null &
git-walk --marks > "$st/m.walk" 2>/dev/null &
git branch --show-current > "$st/current" 2>/dev/null &
git worktree list --porcelain | awk '
  /^worktree / { n = split(substr($0, 10), parts, "/"); name = seen++ ? parts[n] : "main checkout" }
  /^branch /   { print substr($0, 19) "\t" name }' |
  jq -Rc '[inputs | split("\t") | {(.[0]): .[1]}] | add // {}' > "$st/elsewhere.json" 2>/dev/null &
# Every setting this draw needs in one process rather than one each.
{ read -r repo; read -r gates; read -r main; read -r url; } <<EOF
$(otis-config project gateJobs main url)
EOF

# fetch <cache name> <stale seconds> <saved as> <review|mine|all>: the JSON into the
# picker's state, or an error row and a nonzero exit.
fetch() {
  if json=$(git-cached-json $now "$1" "$2" "$reload" -- git-forge mrs "$4" 2> "$st/$1.err"); then
    cp "$json" "$st/$3"
  else
    forge=GitLab; [ "$(otis-config forge)" = github ] && forge=GitHub
    printf "${GK_BAD}$forge lookup failed: %s${GK_R}\t\t\t\t\t\t\t\t\t\terr-%s\n" "$(head -1 "$st/$1.err")" "$1"
    echo '{}' > "$st/$3"
    return 1
  fi
}

echo '{}' > "$st/ci.json"
echo '{"mrs": []}' > "$st/ci-merged.json"
if [ "$scope" = sections ]; then
  printf "${GK_CONTEXT}to review, yours, merged this week${GK_R}\n" > "$st/footer"
  # Two GitLab queries that know nothing of each other, asked at the same time
  # rather than one after the other: with no cache yet both are waited for, and
  # in a big project that was two round trips of an empty screen instead of one.
  # Each keeps its error row in a file of its own, so the rows still come out in
  # the order they always did rather than interleaved by whichever lands first.
  fetch mrs-review $age mrs.json review > "$st/fetch-review.row" &
  review_pid=$!
  fetch ci-mine $age ci.json mine > "$st/fetch-mine.row" &
  mine_pid=$!
  wait "$review_pid"
  wait "$mine_pid"
  cat "$st/fetch-review.row" "$st/fetch-mine.row" 2>/dev/null
  rm -f "$st/fetch-review.row" "$st/fetch-mine.row"
  # Merged and deployed are GitLab's environments; GitHub has none to follow.
  strip=
  if git-forge can deploys; then
    merged=$(git-cached-json --no-wait ci-merged $merged_age "$reload" -- git-forge merged 2>/dev/null) &&
      cp "$merged" "$st/ci-merged.json"
    # The deploy strip on the merged heading, from gd's cache; fetched in the
    # background when stale, and the reload draws it. The strip is drawn from
    # the cache this call names, so gd's own list, which would start a fetch
    # of its own while that one runs, is never asked.
    deploys=$(git-cached-json --no-wait deploys 60 "$reload" -- git-deploy-list --fetch 2>/dev/null) &&
      strip=$(git-deploy-list --from "$deploys" --strip 2>/dev/null)
  fi
else
  fetch mrs-all $age mrs.json all
  total=$(jq '.data.project.mergeRequests.count // 0' "$st/mrs.json")
  if [ "$total" -gt 100 ]; then
    printf "${GK_CONTEXT}100 of %s open MRs, most recently updated first${GK_R}\n" "$total" > "$st/footer"
  else
    printf "${GK_CONTEXT}all open MRs${GK_R}\n" > "$st/footer"
  fi
fi

# The marks, as the previews expect them. A script that answered with
# nothing (it broke, or was killed with the picker) counts as no marks.
wait
jq -nc --argjson gates "$gates" \
  --slurpfile watch "$st/m.watch" --slurpfile claude "$st/m.claude" \
  --slurpfile fixes "$st/m.fixes" --slurpfile verify "$st/m.verify" --slurpfile walk "$st/m.walk" \
  '{gates: $gates, watch: ($watch[0] // {}), claude: ($claude[0] // {}),
    fixes: ($fixes[0] // {}), verify: ($verify[0] // {}), walk: ($walk[0] // {})}' > "$st/marks.json"
current=
read -r current < "$st/current" 2>/dev/null

jq -nr -L "$share" --slurpfile review "$st/mrs.json" --slurpfile mine "$st/ci.json" --slurpfile merged "$st/ci-merged.json" \
  --arg scope "$scope" --arg first "${GMR_FIRST:-review}" --arg current "$current" --arg main "$main" --arg url "$url" \
  --arg strip "$strip" \
  --slurpfile elsewhere "$st/elsewhere.json" --slurpfile marks "$st/marks.json" '
  include "otis";
  ($elsewhere[0] // {}) as $elsewhere |
  $marks[0] as {gates: $gates, watch: $watch, claude: $claude, fixes: $fixes, verify: $verify, walk: $walk} |
  def mark:
    if . == $current then elsewhere + "▶ " + r
    else "  " end;
  def where:
    $elsewhere[.] as $w |
    if $w and . != $current then elsewhere + "in " + (if ($w | length) > 28 then $w[0:27] + "…" else $w end) + r + "  " else "" end;
  # One column a level, capped: a seven-deep stack was spending fourteen columns
  # saying what the order already says.
  def indent:
    if (.depth // 0) > 0 then
      context + (if .depth > 1 then " " * ([.depth - 1, 4] | min) else "" end) + "┌ " + r
    else "" end;
  # A section in stack order, each MR with its depth: the bases (targeting no
  # branch another MR here comes from) in the order GitLab gave, each preceded
  # by what stacks on it, top first.
  def stacked:
    . as $all | ($all | map(.sourceBranch)) as $sources |
    def up($d): . as $m |
      (if $d < 30 then [$all[] | select(.targetBranch == $m.sourceBranch and .iid != $m.iid)] | reverse[] | up($d + 1) else empty end),
      (.depth = $d);
    $all[] | select(.targetBranch | IN($sources[]) | not) | up(0);
  def base_note:
    if (.depth // 0) == 0 and .targetBranch != $main then attention + "on " + .targetBranch + r + "  " else "" end;
  # A section heading. Every field but the first is empty, so the keys that act
  # on an MR see no iid and say so rather than acting on the wrong row.
  def sep($text):
    ([ faint + "── " + $text + " "
         + (if (56 - ($text | length)) > 0 then "─" * (56 - ($text | length)) else "" end) + r,
       "", "", "", "", "sep", "", "", "", "",
       "sep-" + ($text | gsub("[^a-z]+"; "-")) ] | join("\t"));
  # The merged heading carries the last deploys as glyphs, oldest left (gd).
  def sep_strip($text; $strip):
    sep($text) | if $strip == "" then . else sub("\t"; "  " + $strip + "\t") end;

  ($review[0].data.currentUser.username // $mine[0].data.currentUser.username) as $me |
  ($mine[0].data.currentUser.authoredMergeRequests.nodes // []) as $mine_mrs |
  ($merged[0].mrs // []) as $merged_mrs |

  # Where your review of an MR stands, as GitLab keeps it per reviewer.
  def my_review: [.reviewers.nodes[]? | select(.username == $me) | .mergeRequestInteraction.reviewState][0] // "UNREVIEWED";
  def reviewed: my_review | IN("APPROVED", "REVIEWED", "REQUESTED_CHANGES");
  # The state of a row in one word, the one that most wants you: what an agent is
  # doing on it or has left for you, then what is broken, then what waits
  # on someone, then what is fine. Its colour says which of those it is, and
  # what is as it should be (live, nobody asked yet) is left quiet; the
  # preview says the rest in sentences.
  def word($kind):
    ($fixes[.iid] // {}) as $f | ($claude[.iid] // {}) as $cl |
    $verify[.iid] as $v | .iid as $iid | (.sourceBranch // "") as $src | (($walk // {}) | .[$iid] // .[$src]) as $w |
    (.headPipeline | effective($gates)) as $p |
    ((.resolvableDiscussionsCount // 0) - (.resolvedDiscussionsCount // 0)) as $open |
    def n($c; $one; $many): "\($c) " + (if $c == 1 then $one else $many end);
    if $kind == "mine" and $f.fixing then attention + "fixing"
    elif $cl.reviewing then attention + "reviewing"
    elif $v.verifying then attention + "verifying"
    elif $w.walking then attention + "tracing"
    elif $kind == "mine" and ($f.fixes // 0) > 0 then yours + n($f.fixes; "fix"; "fixes")
    elif ($cl.drafts // 0) > 0 then yours + n($cl.drafts; "note"; "notes")
    elif $kind == "mine" and $p == "FAILED" then bad + "failed"
    elif $kind == "mine" and $open > 0 then yours + n($open; "thread"; "threads")
    elif $kind == "mine" and .draft then context + "draft"
    elif $kind == "mine" and .reviewers and (.reviewers.nodes | length) == 0 then context + "ask review"
    elif $kind == "mine" and .autoMergeEnabled then good + "merging"
    elif $kind == "mine" and ($p | IN("RUNNING", "PENDING", "CREATED", "WAITING_FOR_RESOURCE", "PREPARING")) then attention + "running"
    elif $kind == "mine" and .approved then good + "approved"
    elif $kind == "mine" and (.approvalsLeft // 0) > 0 then context + "needs \(.approvalsLeft)"
    elif $kind == "mine" then context + "waiting"
    elif any(.approvedBy.nodes[]?; .username == $me) then good + "approved"
    elif my_review == "REQUESTED_CHANGES" then bad + "changes"
    elif my_review == "REVIEWED" then context + "reviewed"
    else attention + "review" end;
  # What there is to read on it, in a word, when there is something: a
  # verification of this push (V), else its tour (P). Nothing for an older
  # push: the preview says what that one found.
  def has:
    $verify[.iid] as $v | .iid as $iid | (.sourceBranch // "") as $src | (($walk // {}) | .[$iid] // .[$src]) as $w | .diffRefs.headSha as $h |
    ($claude[.iid] // {}) as $cl |
    if $v != null and ($v.status == "failed" or ($v.status == "done" and $v.head == $h and $v.verdict == "fail")) then bad + "✗ verify"
    elif $w != null and $w.status == "failed" then bad + "✗ tour"
    elif $v != null and $v.status == "done" and $v.head == $h and $v.verdict == "pass" then good + "verified"
    elif $w != null and $w.status == "done" and $w.head == $h then elsewhere + "tour"
    elif $cl.clean != null and $cl.clean == $h then good + "clean"
    else "" end;
  # A word in its column, eleven wide.
  def cell: . as $a | $a + r + (" " * ([11 - ($a | gsub("\u001b\\[[0-9;]*m"; "") | length), 1] | max));
  def tag: if . == "" then "" else . + r + "  " end;

  def open_row($kind):
    [ (.sourceBranch | mark)
        + (word($kind) | cell)
        + attention + ("!\(.iid)" | padr(6)) + r + " "
        + indent
        + (has | tag)
        + text + (.title | gsub("\t"; " ")) + r + "  " + (.sourceBranch | where) + base_note
        + (if $kind == "mine" and $scope != "all" then ""
           else context + (if .author.username == $me then "you" else (.author.username // "") end) + r end)
        ,
      .iid, .targetBranch, .webUrl, .sourceBranch, $kind,
      (.diffRefs.headSha // ""), (.diffRefs.baseSha // ""),
      (.headPipeline.id | gid),
      (if .headPipeline.path then $url + .headPipeline.path else .webUrl end),
      "mr-\(.iid)",
      (.diffRefs.startSha // "")
    ] | join("\t");

  def merged_row:
    [ (.sourceBranch | mark)
        # Watching production, else how far out it is.
        + ($watch[.iid] as $w |
           if $w.watching then attention + "watching"
           elif .state == "live" then context + "live"
           elif .state == "deploying" then attention + "deploying"
           elif .state == "queued" then attention + "queued"
           elif .state == "rolledback" then bad + "rolled back"
           else context + "merged" end | cell)
        + attention + ("!\(.iid)" | padr(6)) + r + " "
        # When it went live, started deploying, was rolled back, or merged.
        + context + (((if .state == "live" then .deploy.at // .mergedAt
             elif .state == "deploying" or .state == "rolledback" then .deploy.at else .mergedAt end) | ago) | padl(3)) + r + " "
        + context + (.title | gsub("\t"; " ")) + r + "  " + (.sourceBranch | where)
        # What the production watch found, spelled out only when it points here.
        + ($watch[.iid].verdict as $v |
           if $v == "likely" then bad + "  prod: likely this MR"
           elif $v == "possible" then yours + "  prod: possibly this MR"
           else "" end) + r,
      .iid, .targetBranch, .webUrl, .sourceBranch, "merged", "", "",
      (.deploy.pipeline // (.pipeline.id | gid)),
      (.deploy.url // (if .pipeline.job.webPath then $url + .pipeline.job.webPath else .webUrl end)),
      "mr-\(.iid)"
    ] | join("\t");

  # A heading only where there is something under it, so an empty section
  # never leaves an orphan rule behind.
  def open_section($label; $mrs; $kind):
    if ($mrs | length) == 0 then empty
    else sep($label), ($mrs | stacked | open_row($kind)) end;

  if $scope == "all" then
    $review[0].data.project.mergeRequests.nodes // [] | stacked
      | open_row(if .author.username == $me then "mine" else "review" end)
  else
    ($mine_mrs | map(.iid)) as $mine_iids |
    ($review[0].data.currentUser.reviewRequestedMergeRequests.nodes // [] | map(select(.iid | IN($mine_iids[]) | not))) as $asked |
    ($asked | map(select(reviewed | not))) as $to_review |
    ($asked | map(select(reviewed))) as $seen_already |
    [ if ($merged_mrs | length) == 0 then empty
      else sep_strip("merged this week"; $strip), ($merged_mrs[] | merged_row) end ] as $merged_rows |
    if $first == "mine" then
      open_section("yours"; $mine_mrs; "mine"), $merged_rows[],
      open_section("to review"; $to_review; "review"),
      open_section("reviewed, waiting on them"; $seen_already; "review")
    else
      open_section("to review"; $to_review; "review"),
      open_section("yours"; $mine_mrs; "mine"), $merged_rows[],
      open_section("reviewed, waiting on them"; $seen_already; "review")
    end
  end'
[ "$scope" = sections ] && git-mr-prefetch "$st/mrs.json" "$st/ci.json" </dev/null >/dev/null 2>&1 &
exit 0
