#!/bin/sh
# git-ci-merge --check <iid>          gmr's m, as fzf actions for a transform binding
# git-ci-merge <iid>                  confirm, then merge
# git-ci-merge --auto <iid> <status>  confirm, then merge when what is in the way (status) clears
# git-ci-merge --run <iid>            confirm, start its pipeline, then merge when it succeeds
#
# GitLab decides whether an MR is ready (approvals, pipeline, threads, conflicts,
# draft) and reports it as detailed_merge_status. It computes that lazily, so a
# list query mostly says "unchecked"; --check asks for a recheck and waits a few
# seconds for it. Mergeable opens the confirm, which says where it lands and
# whether GitLab squashes it and deletes the branch, as the MR is set to. The
# merge is pinned to the commit the confirm showed, so a push in between makes
# it fail instead.
# An MR that only has to wait (for approval, its pipeline, its threads) gets
# the same confirm to set auto-merge instead (auto_merge, which GitLab 17.11
# renamed from merge_when_pipeline_succeeds), pinned the same way: GitLab
# merges it once all of those have cleared. What waiting cannot clear (a
# conflict, a rebase) or you have not said is ready (a draft) becomes a footer
# note with the reason.
#
# An MR with no pipeline at all gets the same, after starting one (--run). That
# is where the next layer of a stack lands once the one below merges: GitLab
# points it at main and drops its pipeline, since it only ever ran against the
# branch below, and starts no new one. So a stack merges as m on its bottom MR,
# then m on the next, and so on, each merging itself when its pipeline passes.
mr() {
  git-forge api "projects/:fullpath/merge_requests/$iid$1"
}
# waits <status>: what is in the way, for a status auto-merge waits out;
# nothing for one it does not.
waits() {
  case $1 in
    not_approved)             echo "it still needs approval" ;;
    ci_must_pass)             echo "its pipeline has not passed" ;;
    ci_still_running)         echo "its pipeline is still running" ;;
    discussions_not_resolved) echo "it has unresolved threads" ;;
    requested_changes)        echo "a reviewer requested changes" ;;
  esac
}

if [ "$1" = --check ]; then
  iid=$2
  [ -n "$iid" ] || exit 0
  json=$(mr "?with_merge_status_recheck=true") || exec git-fzf-note "could not reach GitLab for !$iid"
  tries=0
  status=$(printf '%s' "$json" | jq -r .detailed_merge_status)
  while { [ "$status" = unchecked ] || [ "$status" = checking ] || [ "$status" = approvals_syncing ]; } && [ $tries -lt 8 ]; do
    sleep 0.5
    tries=$((tries + 1))
    json=$(mr "") || exec git-fzf-note "could not reach GitLab for !$iid"
    status=$(printf '%s' "$json" | jq -r .detailed_merge_status)
  done
  case $status in
    mergeable) exec echo "execute(git-ci-merge $iid)" ;;
    ci_must_pass)
      [ "$(printf '%s' "$json" | jq -r '.head_pipeline == null')" = true ] &&
        exec echo "execute(git-ci-merge --run $iid)" ;;
  esac
  why=$(waits "$status")
  if [ -n "$why" ]; then
    [ "$(printf '%s' "$json" | jq -r .merge_when_pipeline_succeeds)" = true ] &&
      exec git-fzf-note "!$iid is already set to merge itself: $why"
    exec echo "execute(git-ci-merge --auto $iid $status)"
  fi
  case $status in
    draft_status)       why="it is a draft; R marks it ready" ;;
    conflict)           why="it has conflicts; gup to rebase" ;;
    need_rebase)        why="it needs a rebase; b rebases it" ;;
    not_open)           why="it is not open" ;;
    unchecked|checking) why="GitLab is still checking it; try again in a moment" ;;
    *)                  why="GitLab says $status" ;;
  esac
  exec git-fzf-note "!$iid can't merge yet: $why"
fi

auto= run=
[ "$1" = --auto ] && { auto=1; shift; }
[ "$1" = --run ] && { auto=1 run=1; shift; }
iid=$1 status=$2
[ -n "$iid" ] || exit 0
pause() { otis-popup say "$1"; }
json=$(mr "") || { pause "could not load !$iid"; exit 1; }
sha=$(printf '%s' "$json" | jq -r .sha)
# What it is goes in the question, so a box over the screen shows it too.
forge=GitLab; [ "$(otis-config forge)" = github ] && forge=GitHub
about=$(printf '%s' "$json" | jq -r --arg main "$(otis-config main)" --arg forge "$forge" '
  "!\(.iid)  \(.title)",
  "  \(.source_branch) -> \(.target_branch)\(if .target_branch != $main then "   (not \($main))" else "" end)",
  "  \(if .merge_method == "rebase" then "rebased onto it, not squashed" elif .squash_on_merge then "squashed into one commit" else "merge commit, not squashed" end), " +
  "\(if .force_remove_source_branch or .should_remove_source_branch then "branch deleted on \($forge)" else "branch kept on \($forge)" end)",
  "  head \(.sha[0:8])"')
if [ -n "$run" ]; then
  git-confirm "$about
  it has no pipeline (a stacked MR loses its own when the one below merges)

start its pipeline, and merge it when that succeeds?" || exit 0
  out=$(git-forge api -X POST "projects/:fullpath/merge_requests/$iid/pipelines" 2>&1) || { pause "starting the pipeline failed
$(printf '%s\n' "$out" | head -3)"; exit 1; }
  # GitLab takes a moment to see the new pipeline as the one to wait for;
  # until then it has nothing to merge when.
  tries=0
  until [ "$(mr "" | jq -r .detailed_merge_status)" = ci_still_running ] || [ $tries -ge 20 ]; do
    sleep 1
    tries=$((tries + 1))
  done
elif [ -n "$auto" ]; then
  git-confirm "$about
  $(waits "$status")

merge it when it is approved and everything passes?" || exit 0
fi
if [ -n "$auto" ]; then
  out=$(git-forge api -X PUT "projects/:fullpath/merge_requests/$iid/merge?sha=$sha&auto_merge=true" 2>&1) || { pause "setting auto-merge failed; m again sets it
$(printf '%s\n' "$out" | head -3)"; exit 1; }
  [ "$(printf '%s' "$out" | jq -r .merge_when_pipeline_succeeds 2>/dev/null)" = true ] && exit 0
  pause "GitLab accepted it but did not set auto-merge (state $(printf '%s' "$out" | jq -r .state 2>/dev/null))"
  exit 1
fi
git-confirm "$about

merge it?" || exit 0
out=$(git-forge api -X PUT "projects/:fullpath/merge_requests/$iid/merge?sha=$sha" 2>&1) || { pause "merge failed
$(printf '%s\n' "$out" | head -3)"; exit 1; }
state=$(printf '%s' "$out" | jq -r .state 2>/dev/null)
[ "$state" = merged ] && exit 0
pause "GitLab accepted it but says $state"
